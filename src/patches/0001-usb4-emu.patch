+
+static char *h_get_faults(Object *obj, Error **errp)
+{
+    return g_strdup(h_of(obj)->rules_text);
+}
+
+static void h_set_faults(Object *obj, const char *value, Error **errp)
+{
+    h_set_rules(h_of(obj), value, errp);
+}
+
+static char *h_get_release(Object *obj, Error **errp)
+{
+    USB4Harness *h = h_of(obj);
+    GString *s = g_string_new("");
+
+    for (GList *l = h->held; l; l = l->next) {
+        HHeld *e = l->data;
+
+        g_string_append_printf(s, "%s%" PRIu64, s->len ? " " : "",
+                               e->token);
+    }
+    return g_string_free(s, false);
+}
+
+/* "all", "tag:<name>", "reopen", "rdy0-ack" or a token number. */
+static void h_set_release(Object *obj, const char *value, Error **errp)
+{
+    USB4Harness *h = h_of(obj);
+    uint64_t token;
+    int rel;
+
+    if (!strcmp(value, "all")) {
+        h_release_if(h, h_pred_all, NULL, "x-release");
+    } else if (g_str_has_prefix(value, "tag:")) {
+        h_release_if(h, h_pred_tag, (void *)(value + 4), "x-release");
+    } else if (!strcmp(value, "reopen") || !strcmp(value, "rdy0-ack")) {
+        rel = !strcmp(value, "reopen") ? H_REL_REOPEN : H_REL_RDY0_ACK;
+        h_release_if(h, h_pred_rel, &rel, "x-release");
+    } else if (!qemu_strtou64(value, NULL, 0, &token)) {
+        h_release_if(h, h_pred_token, &token, "x-release");
+    } else {
+        error_setg(errp, "x-release: all, tag:<name>, reopen, rdy0-ack or "
+                   "a token");
+    }
+}
+
+static char *h_get_gate(Object *obj, Error **errp)
+{
+    static const char *const names[] = {
+        [USB4_HGATE_NONE] = "normal",
+        [USB4_HGATE_CLOSED] = "closed",
+        [USB4_HGATE_READS_FAIL] = "reads-fail",
+    };
+
+    return g_strdup(names[usb4_tunnel_slot_from_object(obj)->hgate]);
+}
+
+static void h_set_gate(Object *obj, const char *value, Error **errp)
+{
+    USB4TunnelSlot *ts = usb4_tunnel_slot_from_object(obj);
+    USB4Harness *h = h_of(obj);
+
+    if (!strcmp(value, "normal") || !strcmp(value, "reopen")) {
+        if (ts->bh) {      /* realized, not torn down */
+            h_reopen(h);
+        } else {
+            ts->hgate = USB4_HGATE_NONE;
+        }
+    } else if (!strcmp(value, "closed")) {
+        if (ts->bh) {      /* realized, not torn down */
+            usb4_tunnel_slot_set_harness_gate(ts, USB4_HGATE_CLOSED);
+        } else {
+            ts->hgate = USB4_HGATE_CLOSED;
+        }
+    } else if (!strcmp(value, "reads-fail")) {
+        if (ts->bh) {      /* realized, not torn down */
+            usb4_tunnel_slot_set_harness_gate(ts, USB4_HGATE_READS_FAIL);
+        } else {
+            ts->hgate = USB4_HGATE_READS_FAIL;
+        }
+    } else {
+        error_setg(errp, "x-gate must be normal, closed or reads-fail");
+    }
+}
+
+static char *h_get_hang(Object *obj, Error **errp)
+{
+    return g_strdup(h_hang_names[h_of(obj)->hang]);
+}
+
+static void h_set_hang_prop(Object *obj, const char *value, Error **errp)
+{
+    for (int i = 0; i < ARRAY_SIZE(h_hang_names); i++) {
+        if (!strcmp(value, h_hang_names[i])) {
+            h_set_hang(h_of(obj), i);
+            return;
+        }
+    }
+    error_setg(errp, "x-hang must be off, stuck or ones");
+}
+
+static char *h_get_intx_range(Object *obj, Error **errp)
+{
+    USB4Harness *h = h_of(obj);
+
+    return h->intx_from ? g_strdup_printf("%u-%u", h->intx_from, h->intx_to)
+                        : g_strdup("");
+}
+
+static void h_set_intx_range(Object *obj, const char *value, Error **errp)
+{
+    USB4Harness *h = h_of(obj);
+    g_auto(GStrv) lh = g_strsplit(value, "-", 2);
+    uint64_t lo, hi;
+
+    if (!*value) {
+        h->intx_from = h->intx_to = 0;
+        return;
+    }
+    if (!h_num("x-intx-drop-range", lh[0], UINT32_MAX, &lo, errp) ||
+        !h_num("x-intx-drop-range", lh[1] ? lh[1] : lh[0], UINT32_MAX, &hi,
+               errp)) {
+        return;
+    }
+    if (!lo || hi < lo) {
+        error_setg(errp, "x-intx-drop-range: A-B with 1 <= A <= B");
+        return;
+    }
+    h->intx_from = lo;
+    h->intx_to = hi;
+}
+
+static char *h_get_state(Object *obj, Error **errp)
+{
+    USB4Harness *h = h_of(obj);
+    GString *s = g_string_new("");
+
+    g_string_append_printf(s, "nvme=%s held=%u", h->nvme ? "yes" : "no",
+                           g_list_length(h->held));
+    for (GList *l = h->held; l; l = l->next) {
+        HHeld *e = l->data;
+
+        g_string_append_printf(s, " [%" PRIu64 " %s%s%s]", e->token,
+                               e->by_hang ? "hang" :
+                               h_rel_names[e->release_on],
+                               e->tag ? " tag=" : "", e->tag ? e->tag : "");
+    }
+    g_string_append_printf(s, " intx-asserts=%" PRIu64 " intx-dropped=%"
+                           PRIu64 " stages=%" PRIu64 " markers=%" PRIu64
+                           " defer=%s hang=%s cfs=%d",
+                           h->intx_asserts, h->intx_dropped, h_stages,
+                           h->markers,
+                           h->defer ? (h->acked ? "acked" : "pending")
+                                    : "no",
+                           h_hang_names[h->hang], h->cfs);
+    for (unsigned i = 0; i < h->rules->len; i++) {
+        HRule *r = g_ptr_array_index(h->rules, i);
+
+        g_string_append_printf(s, " rule%u=%u/%u%s", i, r->matched, r->fired,
+                               r->armed ? "" : ":off");
+    }
+    return g_string_free(s, false);
+}
+
+static bool h_get_cfs(Object *obj, Error **errp)
+{
+    return h_of(obj)->cfs;
+}
+
+static void h_set_cfs(Object *obj, bool value, Error **errp)
+{
+    h_of(obj)->cfs = value;
+}
+
+/* int32 delay properties: offset into USB4Harness in @opaque. */
+static void h_get_i32(Object *obj, Visitor *v, const char *name,
+                      void *opaque, Error **errp)
+{
+    int32_t *p = (int32_t *)((char *)h_of(obj) + (uintptr_t)opaque);
+
+    visit_type_int32(v, name, p, errp);
+}
+
+static void h_set_i32(Object *obj, Visitor *v, const char *name,
+                      void *opaque, Error **errp)
+{
+    int32_t *p = (int32_t *)((char *)h_of(obj) + (uintptr_t)opaque);
+    int32_t val;
+
+    if (!visit_type_int32(v, name, &val, errp)) {
+        return;
+    }
+    if (val < -1) {
+        error_setg(errp, "%s: milliseconds, 0 for off or -1 for never",
+                   name);
+        return;
+    }
+    *p = val;
+}
+
+static void h_get_u32(Object *obj, Visitor *v, const char *name,
+                      void *opaque, Error **errp)
+{
+    uint32_t *p = (uint32_t *)((char *)h_of(obj) + (uintptr_t)opaque);
+
+    visit_type_uint32(v, name, p, errp);
+}
+
+static void h_set_u32(Object *obj, Visitor *v, const char *name,
+                      void *opaque, Error **errp)
+{
+    uint32_t *p = (uint32_t *)((char *)h_of(obj) + (uintptr_t)opaque);
+    uint32_t val;
+
+    if (visit_type_uint32(v, name, &val, errp)) {
+        *p = val;
+    }
+}
+
+static void h_add_i32(ObjectClass *klass, const char *name, size_t off,
+                      const char *desc)
+{
+    object_class_property_add(klass, name, "int32", h_get_i32, h_set_i32,
+                              NULL, (void *)(uintptr_t)off);
+    object_class_property_set_description(klass, name, desc);
+}
+
+static void h_add_u32(ObjectClass *klass, const char *name, size_t off,
+                      const char *desc)
+{
+    object_class_property_add(klass, name, "uint32", h_get_u32, h_set_u32,
+                              NULL, (void *)(uintptr_t)off);
+    object_class_property_set_description(klass, name, desc);
+}
+
+void usb4_harness_class_init(ObjectClass *klass)
+{
+    object_class_property_add_str(klass, "x-faults", h_get_faults,
+                                  h_set_faults);
+    object_class_property_set_description(klass, "x-faults",
+        "Test harness fault rules, separated by ';' (docs/HARNESS.md)");
+    object_class_property_add_str(klass, "x-release", h_get_release,
+                                  h_set_release);
+    object_class_property_set_description(klass, "x-release",
+        "Release held NVMe commands: all, tag:<name>, reopen, rdy0-ack or "
+        "a token; reads the held tokens");
+    object_class_property_add_str(klass, "x-gate", h_get_gate, h_set_gate);
+    object_class_property_set_description(klass, "x-gate",
+        "Harness gate override without endpoint reset: normal (reopen), "
+        "closed or reads-fail");
+    object_class_property_add_str(klass, "x-hang", h_get_hang,
+                                  h_set_hang_prop);
+    object_class_property_set_description(klass, "x-hang",
+        "Hung controller behind a live tunnel: off, stuck or ones");
+    object_class_property_add_bool(klass, "x-cfs", h_get_cfs, h_set_cfs);
+    object_class_property_set_description(klass, "x-cfs",
+        "Report CSTS.CFS (Controller Fatal Status)");
+    h_add_i32(klass, "x-rdy-set-delay-ms",
+              offsetof(USB4Harness, rdy_set_delay_ms),
+              "CSTS.RDY reads 0 for this long after CC.EN=1 (-1 never)");
+    h_add_i32(klass, "x-rdy-clear-delay-ms",
+              offsetof(USB4Harness, rdy_clear_delay_ms),
+              "CSTS.RDY reads 1 for this long after CC.EN=0 (-1 never)");
+    h_add_i32(klass, "x-shst-delay-ms",
+              offsetof(USB4Harness, shst_delay_ms),
+              "CSTS.SHST reads 'occurring' for this long after CC.SHN "
+              "(-1 never)");
+    h_add_u32(klass, "x-intx-drop-every", offsetof(USB4Harness, intx_every),
+              "Suppress every Nth INTx assertion of the endpoint");
+    object_class_property_add_str(klass, "x-intx-drop-range",
+                                  h_get_intx_range, h_set_intx_range);
+    object_class_property_set_description(klass, "x-intx-drop-range",
+        "Suppress INTx assertions A-B (1-based); empty for none");
+    h_add_u32(klass, "x-marker-doorbell", offsetof(USB4Harness, marker_db),
+              "BAR0 offset whose writes are traced as time markers and "
+              "dropped (0: off)");
+    object_class_property_add_str(klass, "x-harness-state", h_get_state,
+                                  NULL);
+}
diff --git a/hw/usb4/usb4-harness.h b/hw/usb4/usb4-harness.h
new file mode 100644
index 0000000000000000000000000000000000000000..3e94279e23d6a66baf8f359d4cb2577dd30e5306
--- /dev/null
+++ b/hw/usb4/usb4-harness.h
@@ -0,0 +1,46 @@
+/*
+ * USB4 tunnel test harness: deterministic fault injection for the NVMe
+ * endpoint behind a tunnel bridge (docs/HARNESS.md).
+ *
+ * Copyright (c) 2026 usb4-emu contributors
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Written from scratch for the usb4-emu project.
+ */
+
+#ifndef HW_USB4_HARNESS_H
+#define HW_USB4_HARNESS_H
+
+#include "usb4-tunnel-slot.h"
+
+/* Registers the x-* harness properties on a tunnel target class. */
+void usb4_harness_class_init(ObjectClass *klass);
+/*
+ * From the slot's realize, once it succeeded: the harness takes part in
+ * debug-port stages from now on.
+ */
+void usb4_harness_realize(USB4TunnelSlot *ts);
+/* Install the harness hook on the slot's (new) NVMe controller. */
+void usb4_harness_attach(USB4TunnelSlot *ts, PCIDevice *nvme);
+/* The slot's endpoint was removed. */
+void usb4_harness_endpoint_gone(USB4TunnelSlot *ts);
+/*
+ * From the slot's unrealize and again from the bridge's instance
+ * finalize (properties may have created a harness on a bridge that was
+ * never realized); idempotent.
+ */
+void usb4_harness_free(USB4TunnelSlot *ts);
+/*
+ * A stage code written to the debug port (usb4-debug-port): fires the
+ * "at=stage" rules of every slot synchronously, before returning.
+ */
+void usb4_harness_stage(uint32_t code, uint32_t arg);
+/*
+ * Deferred harness work (a reopen that releases held commands, the end of
+ * a deferred disable) for the slot's bottom half, which runs it with the
+ * lifecycle serialization held: it drains the endpoint's block I/O.
+ */
+bool usb4_harness_has_work(USB4TunnelSlot *ts);
+void usb4_harness_bh_work(USB4TunnelSlot *ts);
+
+#endif
diff --git a/hw/usb4/usb4-host.c b/hw/usb4/usb4-host.c
new file mode 100644
index 0000000000000000000000000000000000000000..d47b96848a9aa2a8fbdda22793ea3ae41cc30d5f
--- /dev/null
+++ b/hw/usb4/usb4-host.c
@@ -0,0 +1,3014 @@
+/*
+ * USB4 / Thunderbolt 3 host interface (the "NHI" PCI function)
+ *
+ * Copyright (c) 2026 usb4-emu contributors
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Written from scratch for the usb4-emu project from the USB4
+ * Specification 2.0 chapter 12 ("Host Interface Adapter Layer"). FreeBSD
+ * sys/dev/thunderbolt/nhi_reg.h was used only as a cross-check of the
+ * register offsets; no code was taken from it.
+ *
+ * What this file implements (docs/ARCHITECTURE.md section 4.1):
+ *  - the PCI function: identity per profile, BAR0, PM, MSI, MSI-X, PCIe
+ *    endpoint capability and the USB4 DVSEC when on a PCIe bus;
+ *  - the Spec 2.0 section 12.6 register file in BAR0;
+ *  - the transmit and receive descriptor ring engine (Spec 12.3, 12.4);
+ *  - interrupt status, mask, vector allocation (Spec 12.5, 12.6.3.4);
+ *  - host interface reset and host router reset;
+ *  - the usb4 bus that device routers (usb4-device) plug into.
+ *
+ * Ring 0 carries control packets between the guest connection manager and
+ * the fabric (usb4-fabric.c). Other rings can be programmed but carry no
+ * traffic: TX descriptors on them are consumed and completed, and nothing
+ * is ever received on them.
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/error-report.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "qemu/bswap.h"
+#include "qemu/range.h"
+#include "qemu/cutils.h"
+#include "hw/pci/pci.h"
+#include "hw/pci/pci_device.h"
+#include "hw/pci/pcie.h"
+#include "hw/pci/msi.h"
+#include "hw/pci/msix.h"
+#include "hw/pci/pci_bridge.h"
+#include "qemu/timer.h"
+#include "qemu/main-loop.h"
+#include "system/reset.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/core/qdev-properties-system.h"
+#include "hw/core/hotplug.h"
+#include "monitor/qdev.h"
+#include "system/system.h"
+#include "hw/usb/usb.h"
+#include "hw/usb/hcd-xhci-pci.h"
+#include "hw/usb/desc.h"
+#include "hw/scsi/scsi.h"
+#include "migration/vmstate.h"
+#include "system/dma.h"
+#include "system/block-backend.h"
+#include "block/block-io.h"
+#include "qom/object.h"
+#include "usb4-internal.h"
+#include "trace.h"
+
+OBJECT_DECLARE_SIMPLE_TYPE(USB4Host, USB4_HOST)
+
+/* ------------------------------------------------------------------ */
+/* Constants                                                            */
+/* ------------------------------------------------------------------ */
+
+/*
+ * Total Paths (Spec 12.6.3.1.1, Host Interface Capabilities). Rings
+ * 0..N-1 exist for TX and RX. It must agree with the Max HopID the
+ * fabric advertises for the host router's Host Interface adapter, so it
+ * comes from the shared header when the fabric defines it. 3N = 48
+ * interrupt causes fit in two status DWs.
+ */
+#ifdef USB4_HOST_IF_TOTAL_PATHS
+#define USB4_HI_PATHS           USB4_HOST_IF_TOTAL_PATHS
+#else
+#define USB4_HI_PATHS           16
+#endif
+#define USB4_HI_CAUSES          (3 * USB4_HI_PATHS)
+#define USB4_HI_ISR_DWORDS      DIV_ROUND_UP(USB4_HI_CAUSES, 32)
+#define USB4_HI_IVAR_DWORDS     DIV_ROUND_UP(USB4_HI_CAUSES, 8)
+#define USB4_HI_VAC_DWORDS      DIV_ROUND_UP(USB4_HI_PATHS, 8)
+#define USB4_HI_MSIX_VECTORS    16     /* Spec 12.5.3: up to 16 */
+#define USB4_HI_MAX_RING_SIZE   4096   /* Spec Table 12-20, 12-25 */
+#define USB4_HI_MAX_BUF         4096   /* Data Length 0 means 4096 */
+#define USB4_HI_RX_FIFO_DEPTH   128    /* ring 0 frames held for the guest */
+#define USB4_HI_MAX_PORTS       8
+
+/* BAR0 layout. Registers per Spec Table 12-10, MSI-X at the top. */
+#define USB4_HI_BAR_SIZE        0x40000
+#define USB4_HI_REGS_SIZE       0x3e000
+#define USB4_HI_MSIX_TABLE      0x3e000
+#define USB4_HI_MSIX_PBA        0x3f000
+
+/* Spec Table 12-10 offsets. n is the ring (HopID). */
+#define R_TX_BASE_LO            0x00000 /* + n * 0x10 */
+#define R_RX_BASE_LO            0x08000 /* + n * 0x10 */
+#define   R_RING_BASE_LO        0x0
+#define   R_RING_BASE_HI        0x4
+#define   R_RING_INDEX          0x8
+#define   R_RING_SIZE           0xc
+#define R_RX_VAC_CTRL           0x18c00 /* Spec 12.6.3.4.9 */
+#define R_RX_VAC_STATUS         0x19400 /* Spec 12.6.3.4.10 */
+#define R_TX_RING_CTRL          0x19800 /* + n * 0x20 */
+#define R_RX_RING_CTRL          0x29800 /* + n * 0x20 */
+#define R_RX_PDF_MASKS          0x29804 /* + n * 0x20 */
+#define R_ISR                   0x37800 /* Spec 12.6.3.4.1 */
+#define R_ISC                   0x37808 /* Spec 12.6.3.4.2 */
+#define R_ISS                   0x37810 /* Spec 12.6.3.4.3 */
+#define R_IMR                   0x38200 /* Spec 12.6.3.4.4 */
+#define R_IMC                   0x38208 /* Spec 12.6.3.4.5 */
+#define R_IMS                   0x38210 /* Spec 12.6.3.4.6 */
+#define R_ITR                   0x38c00 /* Spec 12.6.3.4.7, 16 DWs */
+#define R_IVAR                  0x38c40 /* Spec 12.6.3.4.8 */
+#define R_HI_CAPS               0x39640 /* Spec 12.6.3.1.1 */
+#define R_HI_RESET              0x39858 /* Spec 12.6.3.1.3 */
+#define R_HI_CONTROL            0x39864 /* Spec 12.6.3.1.4 */
+#define R_HI_CL1_ENABLE         0x39880 /* Spec 12.6.3.1.5 */
+#define R_HI_CL2_ENABLE         0x39884 /* Spec 12.6.3.1.6 */
+#define R_HR_RESET              0x39898 /* Spec 12.6.3.1.2 */
+/* Intel firmware CM registers, tb3-alpine-ridge only (ICM-PROTOCOL.md 2). */
+#define R_TB3_INMAIL_DATA       0x39900
+#define R_TB3_INMAIL_CMD        0x39904
+#define R_TB3_OUTMAIL_CMD       0x3990c
+#define R_TB3_FW_STS            0x39944
+
+/* Ring Control (Spec Tables 12-21 and 12-26). */
+#define RING_CTRL_E2E           (1u << 28)
+#define RING_CTRL_NS            (1u << 29)
+#define RING_CTRL_RAW           (1u << 30)
+#define RING_CTRL_VALID         (1u << 31)
+#define TX_RING_CTRL_WMASK      0xf0000000u
+#define RX_RING_CTRL_WMASK      0xf007f000u
+
+/* Host Interface Control (Spec Table 12-14). */
+#define HI_CONTROL_DISABLE_ISR_AUTO_CLEAR (1u << 17)
+
+/* Descriptor DW2 (Spec Tables 12-6, 12-7, 12-8). */
+#define DESC_LEN_MASK           0x00000fffu
+#define DESC_EOF_PDF_SHIFT      12
+#define DESC_SOF_PDF_SHIFT      16
+#define DESC_CRC_ERROR          (1u << 20)   /* RX write-back */
+#define DESC_DD                 (1u << 21)
+#define DESC_RS                 (1u << 22)   /* TX, RX as posted */
+#define DESC_BO                 (1u << 22)   /* RX write-back */
+#define DESC_IE                 (1u << 23)
+#define DESC_OFFSET_SHIFT       24
+
+/* Interrupt causes (Spec 12.6.3.4.1, Figure 12-8). */
+/*
+ * Causes are packed by the profile's ring count: 16 on usb4-generic, 12
+ * on tb3-alpine-ridge, where RX ring 0 is bit 12 (ICM-PROTOCOL.md 2.1).
+ */
+#define CAUSE_TX(s, n)          (n)
+#define CAUSE_RX(s, n)          ((s)->paths + (n))
+#define CAUSE_VACANCY(s, n)     (2 * (s)->paths + (n))
+
+/*
+ * Router identity handed to the fabric for the host router's ROUTER_CS_0.
+ * usb4-generic: emulator-specific, never Intel. 0x46f4 is the vendor ID
+ * QEMU's emulated USB devices already use; 0x4040 is picked here for the
+ * usb4-emu host router. tb3-alpine-ridge: Intel JHL6240 Alpine Ridge LP
+ * as captured on the P14s Gen 1 (ICM-PROTOCOL.md 1, 5.1; R1).
+ */
+#define USB4_GENERIC_ROUTER_VENDOR  0x46f4
+#define USB4_GENERIC_ROUTER_DEVICE  0x4040
+#define TB3_AR_ROUTER_VENDOR        0x8086
+#define TB3_AR_ROUTER_DEVICE        0x15c0   /* Alpine Ridge LP bridge */
+#define TB3_AR_NHI_DEVICE           0x15bf   /* Alpine Ridge LP NHI */
+#define TB3_AR_SUBSYS_VENDOR        0x17aa
+#define TB3_AR_SUBSYS_DEVICE        0x22b0
+#define TB3_AR_CLASS                0x0880   /* system peripheral, other */
+#define TB3_AR_PATHS                12       /* HI capabilities 0x0c */
+
+/*
+ * host-model=asm4242 (usb4-generic profile): ASMedia ASM4242 host
+ * interface as public lspci dumps show it (docs/research/AM5-USB4.md 2.1:
+ * 1b21:2425 rev 01, class 0C0340, subsystem 1b21:2425) and its USB4
+ * router identity 174c:2428 (2.3, [lkml]). Not an Intel ID, so guests
+ * still take the software-CM path (AGENTS.md).
+ */
+#define ASM_VENDOR                  0x1b21
+#define ASM_NHI_DEVICE              0x2425
+#define ASM_ROUTER_VENDOR           0x174c
+#define ASM_ROUTER_DEVICE           0x2428
+
+/*
+ * host-model=amd (usb4-generic profile, docs/USB4-HOSTS.md 7, inferred):
+ * AMD's USB4 router vendor ID 0x0438 and the four router device IDs
+ * 0x0208-0x020b that Linux lists for the Yellow Carp and Pink Sardine
+ * host routers (drivers/thunderbolt/quirks.c, CL states disabled);
+ * host-domain 0-3 picks one. Which ID belongs to which platform and NHI
+ * is not public. Only Router CS and the DROM carry it: the host
+ * interface keeps the emulator PCI identity, because no capture shows
+ * what else an AMD NHI's PCI identity (1022:162e etc.) would bring.
+ */
+#define AMD_ROUTER_VENDOR           0x0438
+#define AMD_ROUTER_DEVICE           0x0208
+#define AMD_ROUTER_DEVICES          4
+
+/*
+ * Controller variants of the TB3 firmware-CM profile: the thin profile
+ * layer of docs/ARCHITECTURE.md 2. Everything else (BAR0 register set,
+ * interrupt rules, mailbox, tb3 config dialect, ICM-programmed paths) is
+ * shared. Titan Ridge identities are those the Linux driver lists
+ * (docs/ICM-TITAN-RIDGE.md 1); revision 6 is not captured.
+ */
+typedef struct USB4Tb3Identity {
+    const char *name;           /* trace and error text */
+    uint16_t nhi_device;        /* NHI PCI device ID */
+    uint16_t router_device;     /* host router (bridge) ID, router dword 0 */
+    uint8_t revision;
+    USB4Tb3Host host;
+    USB4ICMDialect dialect;
+    uint32_t nvm_version;       /* TR driver-ready word 2 */
+} USB4Tb3Identity;
+
