diff --git a/hw/usb4/usb4-tb3-switch.c b/hw/usb4/usb4-tb3-switch.c
new file mode 100644
index 0000000000000000000000000000000000000000..14efdee05f44ad7c25e5cc2c619e6fbfc3848873
--- /dev/null
+++ b/hw/usb4/usb4-tb3-switch.c
@@ -0,0 +1,287 @@
+/*
+ * Alpine Ridge PCI topology: the controller's PCIe switch and xHCI
+ *
+ * Copyright (c) 2026 usb4-emu contributors
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Written from scratch for the usb4-emu project. The Alpine Ridge LP
+ * controller presents, below its PCH root port, a PCIe switch: upstream
+ * port 8086:15c0 with three downstream ports 8086:15c0, one each for the
+ * NHI, the Thunderbolt PCIe tunnel (a hot-plug slot) and the integrated
+ * xHCI 8086:15c1; all functions revision 1, subsystem 17aa:22b0 where
+ * the header has one (docs/ICM-PROTOCOL.md section 1, Windows 98
+ * PCIDUMP captures in tests/captures/p14s-gen1/win98/).
+ *
+ * These types only change identity. They are composed on the command
+ * line (scripts/run-linux.sh, scripts/run-win98.sh, TOPOLOGY=switch):
+ *
+ *   q35:    pcie-root-port -> usb4-tb3-usp -> usb4-tb3-dsp (usb4-host),
+ *           usb4-tb3-tunnel-dsp (tunnel slot), usb4-tb3-dsp (usb4-tb3-xhci)
+ *   i440FX: usb4-tb3-pci-bridge (upstream) -> usb4-tb3-pci-bridge
+ *           (usb4-host), usb4-tb3-tunnel-bridge (tunnel slot),
+ *           usb4-tb3-pci-bridge (usb4-tb3-xhci)
+ *
+ * The usb4-generic profile never uses them (no Intel IDs there).
+ *
+ * Titan Ridge 4C (JHL7540) gets the same set as usb4-tr-* types: switch
+ * ports 8086:15ea and xHCI 8086:15ec, revision 6 (docs/ICM-TITAN-RIDGE.md
+ * 1; the bridge ID is the one the Linux driver lists, the xHCI ID and
+ * the revision are public PCI ID data, not captured). The 2C part
+ * (bridge 15e7, xHCI 15e9) is not provided as a switch topology.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/module.h"
+#include "qapi/error.h"
+#include "hw/pci/pci.h"
+#include "hw/pci/pci_device.h"
+#include "hw/core/qdev.h"
+#include "hw/usb/xhci.h"
+#include "hw/usb/hcd-xhci-pci.h"
+#include "hw/pci-bridge/pci_bridge_dev.h"
+#include "hw/pci-bridge/xio3130_downstream.h"
+#include "usb4-internal.h"
+
+#define TB3_AR_VENDOR           0x8086
+#define TB3_AR_SWITCH_DEVICE    0x15c0  /* upstream and downstream ports */
+#define TB3_AR_XHCI_DEVICE      0x15c1
+#define TB3_AR_REVISION         0x01
+#define TB3_AR_SUBSYS_VENDOR    0x17aa
+#define TB3_AR_SUBSYS_DEVICE    0x22b0
+
+/* Identity of one controller generation's switch and xHCI functions */
+typedef struct Tb3SwitchIds {
+    uint16_t port_device;       /* upstream and downstream ports */
+    uint16_t xhci_device;
+    uint8_t revision;
+    const char *port_desc;
+    const char *xhci_desc;
+} Tb3SwitchIds;
+
+static const Tb3SwitchIds tb3_ar_ids = {
+    TB3_AR_SWITCH_DEVICE, TB3_AR_XHCI_DEVICE, TB3_AR_REVISION,
+    "Alpine Ridge PCIe switch port (8086:15c0)",
+    "Alpine Ridge integrated xHCI (8086:15c1)",
+};
+
+static const Tb3SwitchIds tb3_tr_ids = {
+    0x15ea, 0x15ec, 6,
+    "Titan Ridge 4C PCIe switch port (8086:15ea)",
+    "Titan Ridge 4C integrated xHCI (8086:15ec)",
+};
+
+static void tb3_switch_ids(ObjectClass *klass, uint16_t device,
+                           uint8_t revision)
+{
+    PCIDeviceClass *k = PCI_DEVICE_CLASS(klass);
+
+    k->vendor_id = TB3_AR_VENDOR;
+    k->device_id = device;
+    k->revision = revision;
+}
+
+static void tb3_port_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    const Tb3SwitchIds *ids = data;
+
+    tb3_switch_ids(klass, ids->port_device, ids->revision);
+    dc->desc = ids->port_desc;
+    dc->user_creatable = true;
+}
+
+/*
+ * Every Alpine Ridge switch port reports Interrupt Pin INTA#, including
+ * the ones without a hot-plug controller (Windows 98 PCIDUMP captures in
+ * tests/captures/p14s-gen1/win98/, register 0x3d of 03:00.0, 04:00.0,
+ * 04:01.0 and 04:02.0 is 01, and the P14s BIOS writes an Interrupt Line
+ * for each). QEMU's pci-bridge only sets the pin with SHPC on, so the
+ * i440FX stand-ins set it themselves. The pin is never asserted.
+ */
+static DeviceRealize tb3_pci_bridge_parent_realize;
+
+static void tb3_pci_bridge_realize(DeviceState *dev, Error **errp)
+{
+    ERRP_GUARD();
+
+    tb3_pci_bridge_parent_realize(dev, errp);
+    if (*errp) {
+        return;
+    }
+    PCI_DEVICE(dev)->config[PCI_INTERRUPT_PIN] = 1;
+}
+
+static void tb3_pci_bridge_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    tb3_port_class_init(klass, data);
+    device_class_set_parent_realize(dc, tb3_pci_bridge_realize,
+                                    &tb3_pci_bridge_parent_realize);
+}
+
+/*
+ * The integrated xHCI as the firmware presents it (usb4-host, R30, R33):
+ * normal; hidden (BIOS Assist with a Thunderbolt link or nothing: config
+ * space reads all-ones, ICM-PROTOCOL.md 12.3); or present without
+ * resources (BIOS Assist after a USB4 device fell back to USB during
+ * POST, 13.1: Windows 98 A1P0_OR reads command 0, BARs 0, line 0xff; Linux
+ * R3-D:1.148 cannot assign its BAR and the driver fails). Stand-in for the
+ * latter: the BARs read as unimplemented and memory, I/O and bus master
+ * enable cannot be set, so no OS can use the function, as on the P14s.
+ */
+typedef struct Tb3XhciState {
+    XHCIPciState parent_obj;
+    USB4XhciMode mode;
+} Tb3XhciState;
+
+static bool tb3_xhci_masked(uint32_t addr, int len, uint32_t lo,
+                            uint32_t hi)
+{
+    return addr < hi && addr + len > lo;
+}
+
+static uint32_t tb3_xhci_read_config(PCIDevice *d, uint32_t addr, int len)
+{
+    Tb3XhciState *s = (Tb3XhciState *)d;
+    uint32_t v;
+
+    if (s->mode == USB4_XHCI_HIDDEN) {
+        return len == 4 ? 0xffffffffu : (1u << (8 * len)) - 1;
+    }
+    v = pci_default_read_config(d, addr, len);
+    if (s->mode == USB4_XHCI_NO_RESOURCES) {
+        for (int i = 0; i < len; i++) {
+            uint32_t a = addr + i;
+
+            if (tb3_xhci_masked(a, 1, PCI_BASE_ADDRESS_0, PCI_CARDBUS_CIS) ||
+                tb3_xhci_masked(a, 1, PCI_ROM_ADDRESS, PCI_ROM_ADDRESS + 4) ||
+                a == PCI_COMMAND) {
+                v &= ~(0xffu << (8 * i));
+            } else if (a == PCI_INTERRUPT_LINE) {
+                v |= 0xffu << (8 * i);
+            }
+        }
+    }
+    return v;
+}
+
+static void tb3_xhci_write_config(PCIDevice *d, uint32_t addr, uint32_t val,
+                                  int len)
+{
+    Tb3XhciState *s = (Tb3XhciState *)d;
+
+    if (s->mode == USB4_XHCI_HIDDEN) {
+        return;
+    }
+    if (s->mode == USB4_XHCI_NO_RESOURCES &&
+        (tb3_xhci_masked(addr, len, PCI_BASE_ADDRESS_0, PCI_CARDBUS_CIS) ||
+         tb3_xhci_masked(addr, len, PCI_ROM_ADDRESS, PCI_ROM_ADDRESS + 4) ||
+         tb3_xhci_masked(addr, len, PCI_COMMAND, PCI_COMMAND + 1))) {
+        return;
+    }
+    pci_default_write_config(d, addr, val, len);
+}
+
+void usb4_tb3_xhci_set_mode(DeviceState *dev, USB4XhciMode mode)
+{
+    Tb3XhciState *s;
+
+    if (!dev || (!object_dynamic_cast(OBJECT(dev), "usb4-tb3-xhci") &&
+                 !object_dynamic_cast(OBJECT(dev), "usb4-tr-xhci"))) {
+        return;
+    }
+    s = (Tb3XhciState *)dev;
+    if (s->mode != mode) {
+        s->mode = mode;
+        if (mode != USB4_XHCI_NORMAL) {
+            /* no decoding, as after the reset that comes with it */
+            pci_set_word(PCI_DEVICE(dev)->config + PCI_COMMAND, 0);
+            pci_default_write_config(PCI_DEVICE(dev), PCI_COMMAND, 0, 2);
+        }
+    }
+}
+
+static void tb3_xhci_class_init(ObjectClass *klass, const void *data)
+{
+    PCIDeviceClass *k = PCI_DEVICE_CLASS(klass);
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    const Tb3SwitchIds *ids = data;
+
+    tb3_switch_ids(klass, ids->xhci_device, ids->revision);
+    k->subsystem_vendor_id = TB3_AR_SUBSYS_VENDOR;
+    k->subsystem_id = TB3_AR_SUBSYS_DEVICE;
+    k->config_read = tb3_xhci_read_config;
+    k->config_write = tb3_xhci_write_config;
+    dc->desc = ids->xhci_desc;
+}
+
+static const TypeInfo tb3_switch_types[] = {
+    {
+        .name = "usb4-tb3-usp",
+        .parent = "x3130-upstream",
+        .class_init = tb3_port_class_init,
+        .class_data = &tb3_ar_ids,
+    }, {
+        .name = "usb4-tb3-dsp",
+        .parent = TYPE_XIO3130_DOWNSTREAM,
+        .class_init = tb3_port_class_init,
+        .class_data = &tb3_ar_ids,
+    }, {
+        /* the gated hot-plug downstream port for the tunnel */
+        .name = "usb4-tb3-tunnel-dsp",
+        .parent = "usb4-tunnel-dsp",
+        .class_init = tb3_port_class_init,
+        .class_data = &tb3_ar_ids,
+    }, {
+        .name = "usb4-tb3-pci-bridge",
+        .parent = TYPE_PCI_BRIDGE_DEV,
+        .class_init = tb3_pci_bridge_class_init,
+        .class_data = &tb3_ar_ids,
+    }, {
+        .name = "usb4-tb3-tunnel-bridge",
+        .parent = "usb4-tunnel-bridge",
+        .class_init = tb3_port_class_init,
+        .class_data = &tb3_ar_ids,
+    }, {
+        .name = "usb4-tb3-xhci",
+        .parent = TYPE_QEMU_XHCI,
+        .instance_size = sizeof(Tb3XhciState),
+        .class_init = tb3_xhci_class_init,
+        .class_data = &tb3_ar_ids,
+    }, {
+        .name = "usb4-tr-usp",
+        .parent = "x3130-upstream",
+        .class_init = tb3_port_class_init,
+        .class_data = &tb3_tr_ids,
+    }, {
+        .name = "usb4-tr-dsp",
+        .parent = TYPE_XIO3130_DOWNSTREAM,
+        .class_init = tb3_port_class_init,
+        .class_data = &tb3_tr_ids,
+    }, {
+        /* the gated hot-plug downstream port for the tunnel */
+        .name = "usb4-tr-tunnel-dsp",
+        .parent = "usb4-tunnel-dsp",
+        .class_init = tb3_port_class_init,
+        .class_data = &tb3_tr_ids,
+    }, {
+        .name = "usb4-tr-pci-bridge",
+        .parent = TYPE_PCI_BRIDGE_DEV,
+        .class_init = tb3_pci_bridge_class_init,
+        .class_data = &tb3_tr_ids,
+    }, {
+        .name = "usb4-tr-tunnel-bridge",
+        .parent = "usb4-tunnel-bridge",
+        .class_init = tb3_port_class_init,
+        .class_data = &tb3_tr_ids,
+    }, {
+        .name = "usb4-tr-xhci",
+        .parent = TYPE_QEMU_XHCI,
+        .instance_size = sizeof(Tb3XhciState),
+        .class_init = tb3_xhci_class_init,
+        .class_data = &tb3_tr_ids,
+    },
+};
+
+DEFINE_TYPES(tb3_switch_types)
diff --git a/hw/usb4/usb4-timer.c b/hw/usb4/usb4-timer.c
new file mode 100644
index 0000000000000000000000000000000000000000..0e0917b755144229f6550fd8723f0506b46d0586
--- /dev/null
+++ b/hw/usb4/usb4-timer.c
@@ -0,0 +1,48 @@
+/*
+ * USB4 fabric timer and clock glue for QEMU
+ *
+ * Copyright (c) 2026 usb4-emu contributors
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Written from scratch for the usb4-emu project. The fabric core only
+ * sees the small USB4Timer interface from usb4-fabric-int.h so that the
+ * standalone test harness can replace this file with a fake clock.
+ */
+#include "qemu/osdep.h"
+#include "qemu/timer.h"
+#include "usb4-fabric-int.h"
+
+struct USB4Timer {
+    QEMUTimer *t;
+};
+
+USB4Timer *usb4_timer_new(USB4TimerCB *cb, void *opaque)
+{
+    USB4Timer *t = g_new0(USB4Timer, 1);
+
+    t->t = timer_new_ms(QEMU_CLOCK_VIRTUAL, cb, opaque);
+    return t;
+}
+
+void usb4_timer_mod_ms(USB4Timer *t, int64_t ms_from_now)
+{
+    timer_mod(t->t, qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) + ms_from_now);
+}
+
+void usb4_timer_del(USB4Timer *t)
+{
+    timer_del(t->t);
+}
+
+void usb4_timer_free(USB4Timer *t)
+{
+    if (t) {
+        timer_free(t->t);
+        g_free(t);
+    }
+}
+
+int64_t usb4_clock_ns(void)
+{
+    return qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+}
diff --git a/hw/usb4/usb4-tunnel-bridge.c b/hw/usb4/usb4-tunnel-bridge.c
new file mode 100644
index 0000000000000000000000000000000000000000..2972eca691d9b021d712ec3e1d2e22afb6f19895
--- /dev/null
+++ b/hw/usb4/usb4-tunnel-bridge.c
@@ -0,0 +1,1107 @@
+/*
+ * USB4 PCIe tunnel bridge: a gated pci-bridge subclass with SHPC, for
+ * the i440FX machine and legacy (PCI-only) guests.
+ *
+ * Copyright (c) 2026 usb4-emu contributors
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Written from scratch for the usb4-emu project. Design reference:
+ * docs/ARCHITECTURE.md sections 4.4 and 7 in the usb4-emu repository.
+ * The gate and the endpoint lifecycle are in usb4-tunnel-slot.c.
+ *
+ * Stock SHPC keeps slot state and indicators but does not enforce them
+ * on a newly plugged device. This subclass folds the slot state into
+ * the access gate: in the Disabled and Power-only states the gate is
+ * held closed (stage 1 only, no quiesce or removal); only Enabled lets
+ * it open. The endpoint sits in SHPC slot index 0 (PCI device 1).
+ *
+ * shpc-autoenable=on moves the slot to Enabled on insertion while the
+ * slot is unclaimed, i.e. the guest has written no slot-state command to
+ * it since the last bridge reset. Reads never claim; LED-only commands
+ * do not claim. Autoenable changes the slot state only, never the
+ * indicators.
+ *
+ * On the root bus, as the power domain of a Thunderbolt 3 controller
+ * (usb4_tunnel_port_power_domain()), the bridge stands in for the PCH
+ * root port and its whole tree can leave and come back
+ * (ARCHITECTURE.md 4.4a): when the controller powers off (R27, R32) or
+ * the user sets "present" off (surprise removal). The access gate closes
+ * synchronously; the rest runs from a bottom half or a timer, checked
+ * against the transition generation. root-hotplug selects what the
+ * guest sees:
+ *  - none: the tree reads all-ones; on power-on it comes back from
+ *    reset (the behaviour before 4.4a);
+ *  - restore: as none, but on power-on the configuration the tree had
+ *    when it left (bus numbers, windows, BARs, Command) is written back,
+ *    as platform firmware would, for guests without ACPI hot-plug;
+ *  - acpi: the guest also gets an ACPI Bus Check on the bridge's bus-0
+ *    slot through PIIX4 PCI hot-plug, finds the switch gone and removes
+ *    the tree; power-on is a fresh arrival below the bridge, again with
+ *    a Bus Check. The bridge itself stays, like a PCH root port, unless
+ *    the guest ejects it (_EJ0).
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qom/object.h"
+#include "hw/core/qdev.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/core/hotplug.h"
+#include "hw/pci/pci.h"
+#include "hw/pci/pci_bridge.h"
+#include "hw/pci/shpc.h"
+#include "hw/pci-bridge/pci_bridge_dev.h"
+#include "hw/acpi/pcihp.h"
+#include "hw/core/resettable.h"
+#include "qemu/error-report.h"
+#include "qemu/main-loop.h"
+#include "qemu/timer.h"
+#include "usb4-tunnel-slot.h"
+#include "trace.h"
+
+#define TYPE_USB4_TUNNEL_BRIDGE "usb4-tunnel-bridge"
+OBJECT_DECLARE_TYPE(USB4TunnelBridge, USB4TunnelBridgeClass,
+                    USB4_TUNNEL_BRIDGE)
+
+/* The endpoint's slot: PCI device 1 on the secondary bus, SHPC index 0. */
+#define TB_EP_DEVFN PCI_DEVFN(1, 0)
+#define TB_EP_SLOT  0
+
+struct USB4TunnelBridgeClass {
+    PCIDeviceClass parent_class;
+
+    void (*parent_pci_realize)(PCIDevice *d, Error **errp);
+    void (*parent_exit)(PCIDevice *d);
+    void (*parent_config_write)(PCIDevice *d, uint32_t addr, uint32_t val,
+                                int len);
+    uint32_t (*parent_config_read)(PCIDevice *d, uint32_t addr, int len);
+    hotplug_fn parent_plug;
+    hotplug_fn parent_unplug;
+    DeviceReset parent_reset;
+};
+
+typedef enum TbRootMode {
+    TB_ROOT_NONE,
+    TB_ROOT_RESTORE,
+    TB_ROOT_ACPI,
+} TbRootMode;
+
+/*
+ * One function as the tree left (root-hotplug=restore), keyed by its
+ * position below the root bridge (devfn per bus level) and its model.
+ */
+#define TB_PATH_MAX 8
+typedef struct TbSavedCfg {
+    uint8_t path[TB_PATH_MAX];
+    uint8_t depth;
+    char *type;             /* QOM type of the function */
+    char *ident;            /* the device behind its tunnel, or "" */
+    uint8_t hdr[PCI_CONFIG_HEADER_SIZE];
+    bool has_shpc;          /* a gated SHPC bridge: */
+    SHPCGuestState shpc;    /* its guest-programmed SHPC state */
+    bool claimed;           /* and its claim tracking */
+    bool applied;           /* written back (or stale): done */
+} TbSavedCfg;
+
+struct USB4TunnelBridge {
+    PCIBridgeDev parent_obj;
+
+    USB4TunnelSlot slot;
+    bool shpc_autoenable;
+    bool claimed;           /* guest issued a slot-state command */
+
+    /* Root-bus power domain (ARCHITECTURE.md 4.4a) */
+    char *root_mode_str;    /* property root-hotplug */
+    TbRootMode root_mode;
+    uint32_t removal_notify_ms;
+    bool on_root;           /* on the root bus */
+    bool domain;            /* a usb4-host uses this bridge as its domain */
+    bool present;           /* QOM "present": off = surprise-removed */
+    bool dom_powered;       /* the controller's power (usb4-host) */
+    bool up;                /* present && dom_powered, as applied */
+    bool hidden;            /* ejected by the guest: the slot reads empty */
+    uint64_t root_gen;      /* bumped on every up/down transition */
+    bool quiesce_pending;   /* reset the departed tree */
+    bool arrive_pending;    /* power-up of the tree */
+    bool notify_pending;    /* removal notification now */
+    QEMUBH *root_bh;
+    QEMUTimer *notify_timer;
+    QEMUTimer *retry_timer;
+    GArray *saved;          /* TbSavedCfg, root-hotplug=restore */
+};
+
+#define TB_OF(ts) container_of(ts, USB4TunnelBridge, slot)
+
+/* ------------------------------------------------------------------ */
+/* SHPC slot mechanics                                                  */
+/* ------------------------------------------------------------------ */
+
+static void tb_surprise_remove(USB4TunnelSlot *ts)
+{
+    /* Calls back into tb_unplug() for the endpoint. */
+    shpc_surprise_remove(ts->bridge, TB_EP_SLOT);
+}
+
+static void tb_request_eject(USB4TunnelSlot *ts, Error **errp)
+{
+    shpc_device_unplug_request_cb(HOTPLUG_HANDLER(ts->bridge),
+                                  DEVICE(ts->ep), errp);
+}
+
+static bool tb_slot_blocks_access(USB4TunnelSlot *ts)
+{
+    return shpc_slot_state(ts->bridge, TB_EP_SLOT) != SHPC_STATE_ENABLED;
+}
+
+static void tb_domain_power(USB4TunnelSlot *ts, bool powered);
+
+static const USB4TunnelSlotOps tb_slot_ops = {
+    .ep_devfn = TB_EP_DEVFN,
+    .surprise_remove = tb_surprise_remove,
+    .request_eject = tb_request_eject,
+    .slot_blocks_access = tb_slot_blocks_access,
+    .domain_power = tb_domain_power,
+};
+
+static void tb_shpc_slot_command(PCIDevice *d, int slot, uint8_t state)
+{
+    USB4TunnelBridge *s = USB4_TUNNEL_BRIDGE(d);
+
+    if (slot == TB_EP_SLOT && state != SHPC_STATE_NO && !s->claimed) {
+        trace_usb4_tb_claimed(usb4_tunnel_slot_name(&s->slot), state);
+        s->claimed = true;
+    }
+}
+
+static void tb_shpc_post_write(PCIDevice *d)
+{
+    USB4TunnelBridge *s = USB4_TUNNEL_BRIDGE(d);
+
+    usb4_tunnel_slot_update_gate(&s->slot);
+    /* The guest acknowledged the empty slot: presence event cleared. */
+    if (s->slot.awaiting_ack &&
+        !(shpc_slot_event_latch(d, TB_EP_SLOT) & 0x01 /* PRESENCE */)) {
+        usb4_tunnel_slot_empty_acked(&s->slot);
+    }
+}
+
+/*
+ * The guest turned the endpoint's slot off (Disabled, power indicator
+ * off): stock SHPC would unrealize it inside this register write. Gate
+ * now, remove from the bottom half (ARCHITECTURE.md 4.4); the slot
+ * status and events are updated as stock.
+ */
+static bool tb_shpc_defer_free(PCIDevice *d, int slot)
+{
+    USB4TunnelBridge *s = USB4_TUNNEL_BRIDGE(d);
+
+    if (slot != TB_EP_SLOT || !s->slot.ep) {
+        return false;
+    }
+    usb4_tunnel_slot_guest_unplug(&s->slot);
+    return true;
+}
+
+static const SHPCObserver tb_shpc_observer = {
+    .slot_command = tb_shpc_slot_command,
+    .post_write = tb_shpc_post_write,
+    .defer_free = tb_shpc_defer_free,
+};
+
+/* ------------------------------------------------------------------ */
+/* Root-bus power domain: the tree leaves and comes back (4.4a)         */
+/* ------------------------------------------------------------------ */
+
+static const char *const tb_root_mode_names[] = {
+    [TB_ROOT_NONE] = "none",
+    [TB_ROOT_RESTORE] = "restore",
+    [TB_ROOT_ACPI] = "acpi",
+};
+
+static const char *tb_name(USB4TunnelBridge *s)
+{
+    return usb4_tunnel_slot_name(&s->slot);
+}
+
+static void tb_root_event(USB4TunnelBridge *s, const char *stage)
+{
+    trace_usb4_tb_root(tb_name(s), stage, s->root_gen, s->present,
+                       s->dom_powered, s->hidden);
+    usb4_tunnel_slot_event(&s->slot, s->root_gen, stage);
+}
+
+/*
+ * The bus-0 slot reads empty: config reads return all-ones and writes
+ * are dropped (tb_read_config(), tb_write_config()), the bridge's own
+ * BAR (SHPC) stops decoding and its INTx is withdrawn. The forwarding
+ * windows are covered by the closed access gate, whose all-ones regions
+ * stay where the guest programmed the windows (a vanished root port
+ * master-aborts there too). Command is not touched, so they stay.
+ */
+static void tb_root_set_hidden(USB4TunnelBridge *s, bool hidden)
+{
+    PCIDevice *d = PCI_DEVICE(s);
+
+    if (s->hidden == hidden) {
+        return;
+    }
+    s->hidden = hidden;
+    memory_region_set_enabled(&PCI_BRIDGE_DEV(s)->bar, !hidden);
+    if (hidden) {
+        pci_irq_deassert(d);
+    }
+}
+
+/*
+ * The position of @dev below the root bridge @s: the devfn on each bus
+ * from the root bridge's secondary bus down. False if @dev is not below
+ * @s or the tree is deeper than TB_PATH_MAX.
+ */
+static bool tb_root_path(USB4TunnelBridge *s, PCIDevice *dev, uint8_t *path,
+                         uint8_t *depth)
+{
+    uint8_t rev[TB_PATH_MAX];
+    int n = 0;
+
+    for (PCIDevice *d = dev; d; ) {
+        PCIBus *b = pci_get_bus(d);
+
+        if (n == TB_PATH_MAX || pci_bus_is_root(b)) {
+            return false;
+        }
+        rev[n++] = d->devfn;
+        if (b->parent_dev == PCI_DEVICE(s)) {
+            break;
+        }
+        d = b->parent_dev;
+    }
+    for (int i = 0; i < n; i++) {
+        path[i] = rev[n - 1 - i];
+    }
+    *depth = n;
+    return true;
+}
+
+static void tb_root_saved_clear(USB4TunnelBridge *s)
+{
+    if (!s->saved) {
+        return;
+    }
+    for (guint i = 0; i < s->saved->len; i++) {
+        g_free(g_array_index(s->saved, TbSavedCfg, i).type);
+        g_free(g_array_index(s->saved, TbSavedCfg, i).ident);
+    }
+    g_array_set_size(s->saved, 0);
+}
+
+/*
+ * The innermost tunnel slot below the root bridge @s whose secondary
+ * side holds @dev, or NULL (the controller's own functions).
+ */
+static USB4TunnelSlot *tb_root_tunnel_of(USB4TunnelBridge *s,
+                                         PCIDevice *dev)
+{
+    for (PCIDevice *d = dev; d; ) {
+        PCIDevice *br = pci_get_bus(d)->parent_dev;
+        USB4TunnelSlot *ts;
+
+        if (!br || br == PCI_DEVICE(s)) {
+            return NULL;
+        }
+        ts = usb4_tunnel_slot_from_object(OBJECT(br));
+        if (ts) {
+            return ts;
+        }
+        d = br;
+    }
+    return NULL;
+}
+
+/*
+ * What a function behind a tunnel belongs to: everything the tunnel slot
+ * builds its endpoint from (usb4_tunnel_slot_identity(): the device
+ * router, drive, serial, namespace backends and count, switch and dock
+ * parameters; reviews N2 and 3). A different device in the same place
+ * must start from reset, as it would after a real firmware restore.
+ */
+static char *tb_root_ident(USB4TunnelBridge *s, PCIDevice *dev)
+{
+    USB4TunnelSlot *ts = tb_root_tunnel_of(s, dev);
+
+    return ts ? usb4_tunnel_slot_identity(ts) : g_strdup("");
+}
+
+/*
+ * @dev is on its way out (review N1): at some tunnel slot level it is
+ * not that slot's live occupant (a removal is pending, or held), so it
+ * neither gives nor consumes a record.
+ */
+static bool tb_root_departing(USB4TunnelBridge *s, PCIDevice *dev)
+{
+    for (PCIDevice *d = dev; d; ) {
+        PCIDevice *br = pci_get_bus(d)->parent_dev;
+        USB4TunnelSlot *ts;
+
+        if (!br || br == PCI_DEVICE(s)) {
+            return false;
+        }
+        ts = usb4_tunnel_slot_from_object(OBJECT(br));
+        if (ts && ts->ep && (ts->ep != d || ts->ep_state != EP_LIVE)) {
+            return true;
+        }
+        d = br;
+    }
+    return false;
+}
+
+static void tb_root_save_dev(PCIBus *bus, PCIDevice *dev, void *opaque)
+{
+    USB4TunnelBridge *s = opaque;
+    TbSavedCfg c = { 0 };
+
+    if (!tb_root_path(s, dev, c.path, &c.depth) ||
+        tb_root_departing(s, dev)) {
+        return;
+    }
+    c.type = g_strdup(object_get_typename(OBJECT(dev)));
+    c.ident = tb_root_ident(s, dev);
+    memcpy(c.hdr, dev->config, sizeof(c.hdr));
+    /* A gated SHPC bridge below: the guest's slot programming (fix 2) */
+    if (object_dynamic_cast(OBJECT(dev), TYPE_USB4_TUNNEL_BRIDGE) &&
+        shpc_present(dev)) {
+        c.has_shpc = true;
+        shpc_save_guest_state(dev, &c.shpc);
+        c.claimed = USB4_TUNNEL_BRIDGE(dev)->claimed;
+    }
+    g_array_append_val(s->saved, c);
+}
+
+static void *tb_root_save_bus(PCIBus *bus, void *opaque)
+{
+    pci_for_each_device_under_bus(bus, tb_root_save_dev, opaque);
+    return opaque;
+}
+
+/*
+ * root-hotplug=restore: what platform firmware would put back after the
+ * power cycle, for every function below, in bus order from the top (a
+ * bridge before what is behind it). Each record is keyed by the
+ * function's position below the root bridge and its device model, not
+ * by the object: a tunnelled endpoint removed while the tree was down
+ * is recreated as a new object, and gets its configuration when it is
+ * inserted (usb4_tunnel_bridge_restore_inserted()).
+ */
+static void tb_root_save(USB4TunnelBridge *s)
+{
+    tb_root_saved_clear(s);
+    pci_for_each_bus_depth_first(pci_bridge_get_sec_bus(PCI_BRIDGE(s)),
+                                 tb_root_save_bus, NULL, s);
+}
+
+static void tb_root_restore_one(PCIDevice *dev, const uint8_t *h,
+                                uint32_t addr, int len)
+{
+    uint32_t v = 0;
+
+    memcpy(&v, h + addr, len);
+    dev->config_write(dev, addr, le32_to_cpu(v), len);
+}
+
+/*
+ * Write back one record, as platform firmware would after powering the
+ * controller up: bus numbers, windows, BARs, cache line, latency timer,
+ * interrupt line, bridge control, then Command. Status and other RW1C
+ * registers are not written. For a gated SHPC bridge, its slot state,
+ * indicators, event masks and claim tracking too, so a slot the guest
+ * disabled stays disabled and shpc-autoenable does not re-arm.
+ */
+static void tb_root_apply(USB4TunnelBridge *s, TbSavedCfg *c, PCIDevice *dev)
+{
+    const uint8_t *h = c->hdr;
+    bool type1 = (h[PCI_HEADER_TYPE] & 0x7f) == PCI_HEADER_TYPE_BRIDGE;
+    uint32_t a;
+
+    if (type1) {
+        tb_root_restore_one(dev, h, PCI_PRIMARY_BUS, 4);
+        tb_root_restore_one(dev, h, PCI_IO_BASE, 2);
+        for (a = PCI_MEMORY_BASE; a <= PCI_IO_BASE_UPPER16; a += 4) {
+            tb_root_restore_one(dev, h, a, 4);
+        }
+        tb_root_restore_one(dev, h, PCI_BASE_ADDRESS_0, 4);
+        tb_root_restore_one(dev, h, PCI_BASE_ADDRESS_1, 4);
+        tb_root_restore_one(dev, h, PCI_BRIDGE_CONTROL, 2);
+    } else {
+        for (a = PCI_BASE_ADDRESS_0; a <= PCI_BASE_ADDRESS_5; a += 4) {
+            tb_root_restore_one(dev, h, a, 4);
+        }
+        tb_root_restore_one(dev, h, PCI_ROM_ADDRESS, 4);
+    }
+    tb_root_restore_one(dev, h, PCI_CACHE_LINE_SIZE, 1);
+    tb_root_restore_one(dev, h, PCI_LATENCY_TIMER, 1);
+    tb_root_restore_one(dev, h, PCI_INTERRUPT_LINE, 1);
+    if (c->has_shpc && shpc_present(dev)) {
+        USB4TunnelBridge *tb = USB4_TUNNEL_BRIDGE(dev);
+
+        shpc_restore_guest_state(dev, &c->shpc);
+        tb->claimed = c->claimed;
+        usb4_tunnel_slot_update_gate(&tb->slot);
+    }
+    tb_root_restore_one(dev, h, PCI_COMMAND, 2);
+    c->applied = true;
+    trace_usb4_tb_root_restored(tb_name(s),
+                                DEVICE(dev)->id ? DEVICE(dev)->id : c->type);
+}
+
+/*
+ * The record for the function at @dev's position, same model and same
+ * device behind its tunnel; with @any also one already used.
+ */
+static TbSavedCfg *tb_root_find(USB4TunnelBridge *s, PCIDevice *dev,
+                                bool any)
+{
+    uint8_t path[TB_PATH_MAX], depth;
+    g_autofree char *ident = NULL;
+
+    if (!s->saved || !tb_root_path(s, dev, path, &depth)) {
+        return NULL;
+    }
+    ident = tb_root_ident(s, dev);
+    for (guint i = 0; i < s->saved->len; i++) {
+        TbSavedCfg *c = &g_array_index(s->saved, TbSavedCfg, i);
+
+        if ((any || !c->applied) && c->depth == depth &&
+            !memcmp(c->path, path, depth) &&
+            !strcmp(c->type, object_get_typename(OBJECT(dev))) &&
+            !strcmp(c->ident, ident)) {
+            return c;
+        }
+    }
+    return NULL;
+}
+
+/* The unused record for @dev, unless @dev is on its way out. */
+static TbSavedCfg *tb_root_record(USB4TunnelBridge *s, PCIDevice *dev)
+{
+    return tb_root_departing(s, dev) ? NULL : tb_root_find(s, dev, false);
+}
+
+static void tb_root_apply_dev(PCIBus *bus, PCIDevice *dev, void *opaque)
+{
+    USB4TunnelBridge *s = opaque;
+    TbSavedCfg *c = tb_root_record(s, dev);
+
+    if (c) {
+        tb_root_apply(s, c, dev);
+    }
+}
+
+static void *tb_root_apply_bus(PCIBus *bus, void *opaque)
+{
+    pci_for_each_device_under_bus(bus, tb_root_apply_dev, opaque);
+    return opaque;
+}
+
+/*
+ * At the arrival: every function that is there again gets its record.
+ * Records of tunnelled endpoints not back yet stay pending for their
+ * insertion.
+ */
+static void tb_root_restore(USB4TunnelBridge *s)
+{
+    pci_for_each_bus_depth_first(pci_bridge_get_sec_bus(PCI_BRIDGE(s)),
+                                 tb_root_apply_bus, NULL, s);
+}
+
+/* The root-bus usb4-tunnel-bridge above @dev in restore mode, if any. */
+static USB4TunnelBridge *tb_restore_root_of(PCIDevice *dev)
+{
+    PCIDevice *top = NULL;
+    USB4TunnelBridge *s;
+
+    for (PCIBus *b = pci_get_bus(dev); !pci_bus_is_root(b);
+         b = pci_get_bus(b->parent_dev)) {
+        top = b->parent_dev;
+    }
+    if (!top || !object_dynamic_cast(OBJECT(top), TYPE_USB4_TUNNEL_BRIDGE)) {
+        return NULL;
+    }
+    s = USB4_TUNNEL_BRIDGE(top);
+    return s->root_mode == TB_ROOT_RESTORE && s->domain ? s : NULL;
+}
+
+/*
+ * A tunnel slot below inserted @ep (an endpoint or a dock's switch),
+ * before its gate opens: if the tree came back in restore mode and @ep
+ * stands where a function stood when the tree left, give it that
+ * function's configuration, and the same for everything behind it.
+ */
+void usb4_tunnel_bridge_restore_inserted(PCIDevice *ep)
+{
+    USB4TunnelBridge *s = tb_restore_root_of(ep);
+    TbSavedCfg *c;
+
+    if (!s || !s->up || s->arrive_pending) {
+        return;
+    }
+    c = tb_root_record(s, ep);
+    if (c) {
+        tb_root_apply(s, c, ep);
+    }
+    if (object_dynamic_cast(OBJECT(ep), TYPE_PCI_BRIDGE)) {
+        pci_for_each_bus_depth_first(pci_bridge_get_sec_bus(PCI_BRIDGE(ep)),
+                                     tb_root_apply_bus, NULL, s);
+    }
+}
+
+/*
+ * A tunnel slot below lost its occupant @ep after the arrival (the
+ * guest's CM took the tunnel down, or the device left). If @ep had been
+ * restored, the records behind that slot are spent and are dropped, so a
+ * later endpoint there starts from reset as on real hardware. If @ep was
+ * a leftover from before the departure whose removal was still pending
+ * (its record unused), the records stay for its replacement (review N1).
+ */
+static void tb_root_drop_behind(PCIDevice *slot_bridge, PCIDevice *ep)
+{
+    USB4TunnelBridge *s = tb_restore_root_of(slot_bridge);
+    uint8_t path[TB_PATH_MAX], depth;
+    TbSavedCfg *own;
+
+    if (!s || !s->up || s->arrive_pending ||
+        !tb_root_path(s, slot_bridge, path, &depth)) {
+        return;
+    }
+    own = tb_root_find(s, ep, true);
+    if (own && !own->applied) {
+        return;
+    }
+    for (guint i = 0; i < s->saved->len; i++) {
+        TbSavedCfg *c = &g_array_index(s->saved, TbSavedCfg, i);
+
+        if (c->depth > depth && !memcmp(c->path, path, depth)) {
+            c->applied = true;
+        }
+    }
+}
+
+static void tb_root_notify(USB4TunnelBridge *s, const char *stage)
+{
+    Error *err = NULL;
+
+    if (!acpi_pcihp_slot_owner_notify(PCI_DEVICE(s),
+                                      ACPI_PCIHP_NOTIFY_BUS_CHECK, &err)) {
+        warn_report_err_once(err);
+        return;
+    }
+    tb_root_event(s, stage);
+}
+
+static void tb_root_notify_timer(void *opaque)
+{
+    USB4TunnelBridge *s = opaque;
+
+    if (!s->up) {
+        s->notify_pending = true;
+        qemu_bh_schedule(s->root_bh);
+    }
+}
+
+/*
+ * Stage 1, synchronous, in the call that changed the state: close the
+ * gate (config below, windows, DMA and MSI, INTx). For restore, record
+ * the configuration first. For acpi, the guest gets a Bus Check on the
+ * slot after @delay_ms (0: from the bottom half), so it re-enumerates
+ * below the root bridge, finds the switch gone and removes the tree, as
+ * after the P14s's platform hot-plug event on its root port
+ * (ICM-PROTOCOL.md 11.1). A guest eject (@ejected) is not notified; the
+ * slot itself reads empty, as the guest expects after _EJ0.
+ */
+static void tb_root_depart(USB4TunnelBridge *s, uint32_t delay_ms,
+                           bool ejected)
+{
+    s->arrive_pending = false;
+    s->notify_pending = false;
+    timer_del(s->notify_timer);
+    if (s->root_mode == TB_ROOT_RESTORE) {
+        tb_root_save(s);
+    }
+    usb4_tunnel_slot_domain_gate(&s->slot, true);
+    s->quiesce_pending = true;
+    if (ejected) {
+        tb_root_set_hidden(s, true);
+    } else if (s->root_mode == TB_ROOT_ACPI) {
+        if (delay_ms) {
+            timer_mod(s->notify_timer,
+                      qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) + delay_ms);
+        } else {
+            s->notify_pending = true;
+        }
+    }
+    tb_root_event(s, "root-gated");
+    qemu_bh_schedule(s->root_bh);
+}
+
+/* Re-evaluate after "present" or the controller's power changed. */
+static void tb_root_eval(USB4TunnelBridge *s, uint32_t delay_ms,
+                         bool ejected)
+{
+    bool up = s->present && s->dom_powered;
+
+    if (up == s->up) {
+        return;
+    }
+    s->up = up;
+    s->root_gen++;
+    if (!up) {
+        tb_root_depart(s, delay_ms, ejected);
+    } else {
+        s->quiesce_pending = false;
+        s->notify_pending = false;
+        timer_del(s->notify_timer);
+        s->arrive_pending = true;
+        qemu_bh_schedule(s->root_bh);
+    }
+}
+
+/*
+ * Machine reset: the tree is as the inputs say, with no notification,
+ * no restore and nothing pending. Firmware enumerates what is visible.
+ */
+static void tb_root_static(USB4TunnelBridge *s)
+{
+    if (!s->domain || s->slot.power_cycling) {
+        return;
+    }
+    s->up = s->present && s->dom_powered;
+    s->quiesce_pending = false;
+    s->arrive_pending = false;
+    s->notify_pending = false;
+    timer_del(s->notify_timer);
+    timer_del(s->retry_timer);
+    tb_root_saved_clear(s);
+    usb4_tunnel_slot_domain_gate(&s->slot, !s->up);
+    tb_root_set_hidden(s, false);
+}
+
+/*
+ * Reset the tree as a controller power cycle, under the lifecycle
+ * serialization (the reset drains NVMe I/O and may run other bottom
+ * halves). False if it must be retried later, or if a transition
+ * happened meanwhile (its own pending work takes over).
+ */
+static bool tb_root_power_cycle(USB4TunnelBridge *s, bool whole)
+{
+    uint64_t gen = s->root_gen;
+    bool alive;
+
+    if (!usb4_tunnel_slot_lifecycle_begin(&s->slot)) {
+        timer_mod(s->retry_timer,
+                  qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + 10);
+        return false;
+    }
+    object_ref(OBJECT(s));
+    s->slot.power_cycling = true;
+    if (whole) {
+        /* acpi: the bridge itself arrives fresh too */
+        pci_device_reset(PCI_DEVICE(s));
+    } else {
+        bus_cold_reset(BUS(pci_bridge_get_sec_bus(PCI_BRIDGE(s))));
+    }
+    s->slot.power_cycling = false;
+    usb4_tunnel_slot_lifecycle_end(&s->slot);
+    alive = s->root_bh != NULL;
+    object_unref(OBJECT(s));
+    return alive && gen == s->root_gen;
+}
+
+static void tb_root_bh(void *opaque)
+{
+    USB4TunnelBridge *s = opaque;
+
+    if (s->quiesce_pending && !s->up) {
+        /*
+         * Stage 2: everything below is reset (block I/O drained). After
+         * this, guest memory no longer changes on the tree's behalf.
+         */
+        if (!tb_root_power_cycle(s, false)) {
+            return;
+        }
+        s->quiesce_pending = false;
+        tb_root_event(s, "root-quiesced");
+    }
+    if (s->notify_pending && !s->up) {
+        s->notify_pending = false;
+        tb_root_notify(s, "root-removal-notified");
+    }
+    if (s->arrive_pending && s->up) {
+        /*
+         * Controller power-up: everything below starts from reset; after
+         * a guest eject the root bridge too (the guest freed it).
+         */
+        if (!tb_root_power_cycle(s, s->hidden)) {
+            return;
+        }
+        s->arrive_pending = false;
+        if (s->root_mode == TB_ROOT_RESTORE && s->saved->len) {
+            tb_root_restore(s);
+        }
+        tb_root_set_hidden(s, false);
+        usb4_tunnel_slot_domain_gate(&s->slot, false);
+        tb_root_event(s, "root-arrived");
+        if (s->root_mode == TB_ROOT_ACPI) {
+            tb_root_notify(s, "root-arrival-notified");
+        }
+    }
+}
+
+static void tb_root_retry(void *opaque)
+{
+    USB4TunnelBridge *s = opaque;
+
+    qemu_bh_schedule(s->root_bh);
+}
+
+/* usb4_tunnel_port_power_domain(): the controller below powers on/off. */
+static void tb_domain_power(USB4TunnelSlot *ts, bool powered)
+{
+    USB4TunnelBridge *s = TB_OF(ts);
+
+    s->domain = true;
+    s->dom_powered = powered;
+    if (!s->root_bh || resettable_is_in_reset(OBJECT(s))) {
+        /* machine reset: applied now and again by this bridge's reset */
+        tb_root_static(s);
+        return;
+    }
+    /*
+     * R32 (ICM-PROTOCOL.md 13.4): the registers read all-ones from the
+     * power-off, the platform removes the controller removal-notify-ms
+     * later.
+     */
+    tb_root_eval(s, s->removal_notify_ms, false);
+}
+
+/* AcpiPciHpSlotOwner: the slot is hot-pluggable with root-hotplug=acpi. */
+static bool tb_acpi_hotpluggable(PCIDevice *d)
+{
+    USB4TunnelBridge *s = USB4_TUNNEL_BRIDGE(d);
+
+    return s->on_root && s->root_mode == TB_ROOT_ACPI;
+}
+
+/*
+ * The guest ejected the slot (_EJ0): the slot reads empty from now on,
+ * whatever state the tree is in. If it is up, it leaves (gate, quiesce)
+ * unnotified. If it is already down (an Assist power-off, or present
+ * off), the eject still empties the slot, and a removal notification
+ * still pending is cancelled: the guest already gave the slot up. The
+ * generation moves on, so a timer or bottom half issued before acts on
+ * nothing. The next arrival resets the root bridge too.
+ */
+static void tb_acpi_ejected(PCIDevice *d)
+{
+    USB4TunnelBridge *s = USB4_TUNNEL_BRIDGE(d);
+
+    trace_usb4_tb_root(tb_name(s), "guest-eject", s->root_gen, s->present,
+                       s->dom_powered, s->hidden);
+    if (!s->domain || !s->root_bh) {
+        return;
+    }
+    s->present = false;
+    if (s->up) {
+        tb_root_eval(s, 0, true);
+        return;
+    }
+    s->root_gen++;
+    timer_del(s->notify_timer);
+    s->notify_pending = false;
+    s->arrive_pending = false;
+    tb_root_set_hidden(s, true);
+    tb_root_event(s, "root-ejected");
+}
+
+static bool tb_get_present(Object *obj, Error **errp)
+{
+    return USB4_TUNNEL_BRIDGE(obj)->present;
+}
+
+/* qom-set present false: surprise removal; true: the tree arrives. */
+static void tb_set_present(Object *obj, bool v, Error **errp)
+{
+    USB4TunnelBridge *s = USB4_TUNNEL_BRIDGE(obj);
+
+    if (!s->domain || !s->root_bh) {
+        error_setg(errp, "%s: not the power domain of a usb4-host",
+                   tb_name(s));
+        return;
+    }
+    s->present = v;
+    tb_root_eval(s, 0, false);
+}
+
+static char *tb_get_root_slot(Object *obj, Error **errp)
+{
+    USB4TunnelBridge *s = USB4_TUNNEL_BRIDGE(obj);
+
+    return g_strdup_printf("mode=%s domain=%d present=%d powered=%d up=%d "
+                           "hidden=%d gen=%" PRIu64 " saved=%u "
+                           "pending=%s%s%s%s",
+                           tb_root_mode_names[s->root_mode], s->domain,
+                           s->present, s->dom_powered, s->up, s->hidden,
+                           s->root_gen, s->saved ? s->saved->len : 0,
+                           s->quiesce_pending ? "q" : "",
+                           s->notify_pending ? "n" : "",
+                           s->notify_timer &&
+                           timer_pending(s->notify_timer) ? "t" : "",
+                           s->arrive_pending ? "a" : "");
+}
+
+/* ------------------------------------------------------------------ */
+/* Hooks into the stock pci-bridge                                      */
+/* ------------------------------------------------------------------ */
+
+static void tb_plug(HotplugHandler *hh, DeviceState *dev, Error **errp)
+{
+    USB4TunnelBridge *s = USB4_TUNNEL_BRIDGE(hh);
+    Error *local_err = NULL;
+
+    USB4_TUNNEL_BRIDGE_GET_CLASS(s)->parent_plug(hh, dev, &local_err);
+    if (local_err) {
+        error_propagate(errp, local_err);
+        return;
+    }
+    if (usb4_tunnel_slot_is_endpoint(&s->slot, dev) && dev->hotplugged &&
+        s->shpc_autoenable && !s->claimed) {
+        trace_usb4_tb_autoenable(usb4_tunnel_slot_name(&s->slot));
+        shpc_slot_set_state(PCI_DEVICE(s), TB_EP_SLOT, SHPC_STATE_ENABLED);
+    }
+    usb4_tunnel_slot_update_gate(&s->slot);
+}
+
+static void tb_unplug(HotplugHandler *hh, DeviceState *dev, Error **errp)
+{
+    USB4TunnelBridge *s = USB4_TUNNEL_BRIDGE(hh);
+    bool ours = usb4_tunnel_slot_is_endpoint(&s->slot, dev);
+
+    /* before the unplug: the endpoint's position is still known */
+    if (ours) {
+        tb_root_drop_behind(PCI_DEVICE(s), PCI_DEVICE(dev));
+    }
+    USB4_TUNNEL_BRIDGE_GET_CLASS(s)->parent_unplug(hh, dev, errp);
+    usb4_tunnel_slot_unplugged(&s->slot, dev, ours);
+}
+
+static uint32_t tb_read_config(PCIDevice *d, uint32_t addr, int len)
+{
+    USB4TunnelBridge *s = USB4_TUNNEL_BRIDGE(d);
+
+    if (s->hidden) {
+        /* an empty bus-0 slot: master abort */
+        return len >= 4 ? 0xffffffffu : (1u << (len * 8)) - 1;
+    }
+    if (USB4_TUNNEL_BRIDGE_GET_CLASS(s)->parent_config_read) {
+        return USB4_TUNNEL_BRIDGE_GET_CLASS(s)->parent_config_read(d, addr,
+                                                                   len);
+    }
+    return pci_default_read_config(d, addr, len);
+}
+
+static void tb_write_config(PCIDevice *d, uint32_t addr, uint32_t val,
+                            int len)
+{
+    USB4TunnelBridge *s = USB4_TUNNEL_BRIDGE(d);
+
+    if (s->hidden) {
+        return;
+    }
+    /* One transaction so a rebuilt window is never visible ungated. */
+    memory_region_transaction_begin();
+    USB4_TUNNEL_BRIDGE_GET_CLASS(s)->parent_config_write(d, addr, val, len);
+    usb4_tunnel_slot_apply_window_gate(&s->slot);
+    memory_region_transaction_commit();
+}
+
+static void tb_reset(DeviceState *dev)
+{
+    USB4TunnelBridge *s = USB4_TUNNEL_BRIDGE(dev);
+
+    USB4_TUNNEL_BRIDGE_GET_CLASS(s)->parent_reset(dev);
+    /* Bridge reset: every slot is unclaimed again (SHPC state reset). */
+    s->claimed = false;
+    if (s->slot.bridge) {
+        usb4_tunnel_slot_update_gate(&s->slot);
+    }
+    /* Machine reset of a power domain: no transition is pending. */
+    if (s->root_bh && !s->slot.power_cycling) {
+        tb_root_static(s);
+    }
+}
+
+static void tb_realize(PCIDevice *d, Error **errp)
+{
+    USB4TunnelBridge *s = USB4_TUNNEL_BRIDGE(d);
+    Error *local_err = NULL;
+
+    USB4_TUNNEL_BRIDGE_GET_CLASS(s)->parent_pci_realize(d, &local_err);
+    if (local_err) {
+        error_propagate(errp, local_err);
+        return;
+    }
+    if (!shpc_present(d)) {
+        error_setg(errp, "usb4-tunnel-bridge needs shpc=on");
+        USB4_TUNNEL_BRIDGE_GET_CLASS(s)->parent_exit(d);
+        return;
+    }
+    s->root_mode = TB_ROOT_NONE;
+    if (s->root_mode_str) {
+        int i;
+
+        for (i = 0; i < ARRAY_SIZE(tb_root_mode_names); i++) {
+            if (!strcmp(s->root_mode_str, tb_root_mode_names[i])) {
+                break;
+            }
+        }
+        if (i == ARRAY_SIZE(tb_root_mode_names)) {
+            error_setg(errp, "usb4-tunnel-bridge: root-hotplug must be "
+                       "none, restore or acpi");
+            USB4_TUNNEL_BRIDGE_GET_CLASS(s)->parent_exit(d);
+            return;
+        }
+        s->root_mode = i;
+    }
+    s->on_root = pci_bus_is_root(pci_get_bus(d));
+    if (s->root_mode != TB_ROOT_NONE && !s->on_root) {
+        error_setg(errp, "usb4-tunnel-bridge: root-hotplug needs the "
+                   "bridge on the root bus");
+        USB4_TUNNEL_BRIDGE_GET_CLASS(s)->parent_exit(d);
+        return;
+    }
+    d->shpc->observer = &tb_shpc_observer;
+    if (!usb4_tunnel_slot_realize(&s->slot, d, &tb_slot_ops, errp)) {
+        d->shpc->observer = NULL;
+        USB4_TUNNEL_BRIDGE_GET_CLASS(s)->parent_exit(d);
+        return;
+    }
+    s->present = true;
+    s->dom_powered = true;
+    s->up = true;
+    s->saved = g_array_new(false, true, sizeof(TbSavedCfg));
+    s->root_bh = qemu_bh_new_guarded(tb_root_bh, s,
+                                     &DEVICE(d)->mem_reentrancy_guard);
+    s->notify_timer = timer_new_ms(QEMU_CLOCK_VIRTUAL, tb_root_notify_timer,
+                                   s);
+    s->retry_timer = timer_new_ms(QEMU_CLOCK_REALTIME, tb_root_retry, s);
+}
+
+/* Release the slot's BH, timers, notifier and gate before the bridge. */
+static void tb_exit(PCIDevice *d)
+{
+    USB4TunnelBridge *s = USB4_TUNNEL_BRIDGE(d);
+
+    if (s->root_bh) {
+        qemu_bh_delete(s->root_bh);
+        s->root_bh = NULL;
+        timer_free(s->notify_timer);
+        timer_free(s->retry_timer);
+        tb_root_saved_clear(s);
+        g_array_free(s->saved, true);
+        s->saved = NULL;
+    }
+    usb4_tunnel_slot_unrealize(&s->slot);
+    d->shpc->observer = NULL;
+    USB4_TUNNEL_BRIDGE_GET_CLASS(s)->parent_exit(d);
+}
+
+static void tb_finalize(Object *obj)
+{
+    usb4_tunnel_slot_finalize(&USB4_TUNNEL_BRIDGE(obj)->slot);
+}
+
+static USB4TunnelSlot *tb_get_slot(Object *obj)
+{
+    return &USB4_TUNNEL_BRIDGE(obj)->slot;
+}
+
+static const Property tb_props[] = {
+    DEFINE_PROP_STRING("nvme-drive", USB4TunnelBridge, slot.nvme_drive),
+    DEFINE_PROP_STRING("nvme-serial", USB4TunnelBridge, slot.nvme_serial),
+    DEFINE_PROP_STRING("nvme-namespaces", USB4TunnelBridge,
+                       slot.nvme_namespaces),
+    DEFINE_PROP_UINT32("nvme-nn", USB4TunnelBridge, slot.nvme_nn, 0),
+    DEFINE_PROP_BOOL("x-force-tunnel", USB4TunnelBridge, slot.force_tunnel,
+                     false),
+    DEFINE_PROP_UINT32("eject-timeout-ms", USB4TunnelBridge,
+                       slot.eject_timeout_ms, 10000),
+    DEFINE_PROP_UINT32("settle-ms", USB4TunnelBridge, slot.settle_ms, 2000),
+    DEFINE_PROP_BOOL("orderly-admin-down", USB4TunnelBridge,
+                     slot.orderly_admin_down, false),
+    DEFINE_PROP_BOOL("shpc-autoenable", USB4TunnelBridge, shpc_autoenable,
+                     false),
+    /* ARCHITECTURE.md 4.4a: none | restore | acpi */
+    DEFINE_PROP_STRING("root-hotplug", USB4TunnelBridge, root_mode_str),
+    /*
+     * From the controller's power-off (registers all-ones) to the
+     * platform's removal notification: 15.4 s - 11.0 s on the P14s
+     * with the ORICO (ICM-PROTOCOL.md 13.4, P14S-ORICO-2026-10-15.md 3.1).
+     */
+    DEFINE_PROP_UINT32("removal-notify-ms", USB4TunnelBridge,
+                       removal_notify_ms, 4400),
+};
+
+static void tb_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    PCIDeviceClass *k = PCI_DEVICE_CLASS(klass);
+    HotplugHandlerClass *hc = HOTPLUG_HANDLER_CLASS(klass);
+    USB4TunnelTargetClass *ttc = USB4_TUNNEL_TARGET_CLASS(klass);
+    USB4TunnelBridgeClass *tbc = USB4_TUNNEL_BRIDGE_CLASS(klass);
+    AcpiPciHpSlotOwnerClass *ohc = ACPI_PCIHP_SLOT_OWNER_CLASS(klass);
+
+    dc->desc = "USB4 PCIe tunnel bridge (gated PCI bridge with SHPC)";
+    dc->hotpluggable = false;
+    device_class_set_props(dc, tb_props);
+
+    tbc->parent_pci_realize = k->realize;
+    k->realize = tb_realize;
+    tbc->parent_exit = k->exit;
+    k->exit = tb_exit;
+    tbc->parent_config_write = k->config_write;
+    k->config_write = tb_write_config;
+    tbc->parent_config_read = k->config_read;
+    k->config_read = tb_read_config;
+    tbc->parent_plug = hc->plug;
+    hc->plug = tb_plug;
+    tbc->parent_unplug = hc->unplug;
+    hc->unplug = tb_unplug;
+    tbc->parent_reset = dc->legacy_reset;
+    device_class_set_legacy_reset(dc, tb_reset);
+    ttc->get_slot = tb_get_slot;
+    ohc->hotpluggable = tb_acpi_hotpluggable;
+    ohc->ejected = tb_acpi_ejected;
+    object_class_property_add_bool(klass, "present", tb_get_present,
+                                   tb_set_present);
+    object_class_property_add_str(klass, "root-slot", tb_get_root_slot,
+                                  NULL);
+    usb4_tunnel_slot_class_init(klass);
+}
+
+static const TypeInfo tb_info = {
+    .name = TYPE_USB4_TUNNEL_BRIDGE,
+    .parent = TYPE_PCI_BRIDGE_DEV,
+    .instance_size = sizeof(USB4TunnelBridge),
+    .class_size = sizeof(USB4TunnelBridgeClass),
+    .class_init = tb_class_init,
+    .instance_finalize = tb_finalize,
+    .interfaces = (const InterfaceInfo[]) {
+        { TYPE_USB4_TUNNEL_TARGET },
+        { TYPE_ACPI_PCIHP_SLOT_OWNER },
+        { }
+    },
+};
+
+static void tb_register_types(void)
+{
+    type_register_static(&tb_info);
+}
+
+type_init(tb_register_types)
diff --git a/hw/usb4/usb4-tunnel-dsp.c b/hw/usb4/usb4-tunnel-dsp.c
new file mode 100644
index 0000000000000000000000000000000000000000..376950ccccb45496ed390fd6af9dfd1d467ffed2
--- /dev/null
+++ b/hw/usb4/usb4-tunnel-dsp.c
@@ -0,0 +1,262 @@
+/*
+ * USB4 daisy chain: a gated hot-plug PCIe switch downstream port
+ *
+ * Copyright (c) 2026 usb4-emu contributors
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Written from scratch for the usb4-emu project. A device router with
+ * downstream USB4 ports contains a PCIe switch (Guide 5.3: a PCIe tunnel
+ * runs from a PCIe Downstream adapter to the PCIe Upstream adapter of the
+ * next router). When the device's own tunnel comes up, the tunnel slot
+ * builds that switch (usb4-tunnel-slot.c) with one usb4-tunnel-dsp per
+ * downstream USB4 port. It stands for the PCIe Downstream adapter of that
+ * port: the fabric reports the PCIe tunnel of the router plugged into
+ * that port to it (usb4_device_get_pcie_down_target()), and it gates and
+ * hot-plugs that router's endpoint exactly like usb4-tunnel-port does
+ * for a host port (docs/ARCHITECTURE.md 4.4: same gate-before-unplug
+ * rules, generation-checked removal, settle before a replacement).
+ *
+ * It is an xio3130-downstream with native hot-plug, never created by the
+ * user. On realize it registers with its usb4-device, which replays the
+ * current state of the chained tunnel (it may have come up while the
+ * switch was still being built).
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qom/object.h"
+#include "hw/core/qdev.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/core/hotplug.h"
+#include "hw/pci/pci.h"
+#include "hw/pci/pcie.h"
+#include "hw/pci/pcie_port.h"
+#include "hw/pci-bridge/xio3130_downstream.h"
+#include "hw/acpi/acpi_aml_interface.h"
+#include "hw/acpi/pci.h"
+#include "hw/usb4/usb4-acpi.h"
+#include "usb4-tunnel-slot.h"
+#include "trace.h"
+
+OBJECT_DECLARE_TYPE(USB4TunnelDsp, USB4TunnelDspClass, USB4_TUNNEL_DSP)
+
+struct USB4TunnelDspClass {
+    PCIDeviceClass parent_class;
+
+    void (*parent_realize)(PCIDevice *d, Error **errp);
+    void (*parent_exit)(PCIDevice *d);
+    void (*parent_config_write)(PCIDevice *d, uint32_t addr, uint32_t val,
+                                int len);
+    hotplug_fn parent_unplug;
+};
+
+struct USB4TunnelDsp {
+    PCIESlot parent_obj;
+
+    USB4TunnelSlot slot;
+    char *dev_path;         /* usb4-device whose PCIe Down adapter this is */
+    uint32_t dport;         /* its downstream USB4 port, 1-based */
+    uint32_t depth;
+    bool registered;
+    /* host tunnel target (no usb4-device): ACPI _DSD, as usb4-tunnel-port */
+    uint32_t usb4_port_number;
+    bool acpi_hotplug_d3;
+    bool acpi_external_facing;
+};
+
+static const USB4TunnelSlotOps dsp_slot_ops = {
+    .ep_devfn = PCI_DEVFN(0, 0),
+    .dock_capable = true,
+    .surprise_remove = usb4_pcie_slot_surprise_remove,
+    .request_eject = usb4_pcie_slot_request_eject,
+    .after_insert = usb4_pcie_slot_after_insert,
+    .apply_power = usb4_pcie_slot_apply_power,
+    .power_done = usb4_pcie_slot_power_done,
+};
+
+static USB4Device *dsp_device(USB4TunnelDsp *s)
+{
+    Object *o = s->dev_path ? object_resolve_path(s->dev_path, NULL) : NULL;
+
+    return o ? (USB4Device *)object_dynamic_cast(o, "usb4-device") : NULL;
+}
+
+static void dsp_register(USB4TunnelDsp *s, bool on)
+{
+    USB4Device *d = dsp_device(s);
+
+    trace_usb4_dsp_register(usb4_tunnel_slot_name(&s->slot),
+                            s->dev_path ? s->dev_path : "(none)", s->dport,
+                            on && d);
+    if (on && d) {
+        usb4_device_set_pcie_down_target(d, s->dport, (USB4TunnelPort *)s);
+    } else if (d && usb4_device_get_pcie_down_target(d, s->dport) ==
+                    (USB4TunnelPort *)s) {
+        /*
+         * Clear only our own registration. The QOM path may now name a
+         * replacement device (same id, re-added while this port's removal
+         * was pending) whose target is another port: leave that alone, or
+         * its chained tunnel would lose its gate (ARCHITECTURE.md 4.4,
+         * late emulator work must not hit the replacement).
+         */
+        usb4_device_set_pcie_down_target(d, s->dport, NULL);
+    }
+    s->registered = on && d;
+}
+
+static void dsp_realize(PCIDevice *d, Error **errp)
+{
+    USB4TunnelDsp *s = USB4_TUNNEL_DSP(d);
+    Error *local_err = NULL;
+
+    USB4_TUNNEL_DSP_GET_CLASS(s)->parent_realize(d, &local_err);
+    if (local_err) {
+        error_propagate(errp, local_err);
+        return;
+    }
+    s->slot.depth = s->depth;
+    /*
+     * Data Link Layer Link Active Reporting, which a hot-plug capable
+     * downstream port must implement (PCIe Base 4.0 7.5.3.6) and the
+     * tunnel root port already has. With an attention button, Linux
+     * pciehp enables Data Link Layer State Changed but not Presence
+     * Detect Changed, so without it a tunnel going down (surprise
+     * removal) is never seen and the gated endpoint stays in the guest
+     * (observed with the asm4242 switch, docs/USB4-HOSTS.md 5).
+     */
+    pci_long_test_and_set_mask(d->config + d->exp.exp_cap + PCI_EXP_LNKCAP,
+                               PCI_EXP_LNKCAP_DLLLARC);
+    pcie_cap_slot_enable_dllsc(d);
+    if (!usb4_tunnel_slot_realize(&s->slot, d, &dsp_slot_ops, errp)) {
+        USB4_TUNNEL_DSP_GET_CLASS(s)->parent_exit(d);
+        return;
+    }
+    usb4_pcie_slot_defer_init(&s->slot);
+    dsp_register(s, true);
+}
+
+static void dsp_exit(PCIDevice *d)
+{
+    USB4TunnelDsp *s = USB4_TUNNEL_DSP(d);
+
+    if (s->registered) {
+        dsp_register(s, false);
+    }
+    usb4_tunnel_slot_unrealize(&s->slot);
+    USB4_TUNNEL_DSP_GET_CLASS(s)->parent_exit(d);
+}
+
+static void dsp_unplug(HotplugHandler *hh, DeviceState *dev, Error **errp)
+{
+    USB4TunnelDsp *s = USB4_TUNNEL_DSP(hh);
+    bool ours = usb4_tunnel_slot_is_endpoint(&s->slot, dev);
+
+    USB4_TUNNEL_DSP_GET_CLASS(s)->parent_unplug(hh, dev, errp);
+    usb4_tunnel_slot_unplugged(&s->slot, dev, ours);
+}
+
+static void dsp_write_config(PCIDevice *d, uint32_t addr, uint32_t val,
+                             int len)
+{
+    USB4TunnelDsp *s = USB4_TUNNEL_DSP(d);
+    uint16_t old_ctl, old_sta;
+
+    pcie_cap_slot_get(d, &old_ctl, &old_sta);
+    /* One transaction so a rebuilt window is never visible ungated. */
+    memory_region_transaction_begin();
+    USB4_TUNNEL_DSP_GET_CLASS(s)->parent_config_write(d, addr, val, len);
+    usb4_tunnel_slot_apply_window_gate(&s->slot);
+    memory_region_transaction_commit();
+    usb4_pcie_slot_config_written(&s->slot, addr, val, len, old_ctl,
+                                  old_sta);
+}
+
+static void dsp_finalize(Object *obj)
+{
+    usb4_tunnel_slot_finalize(&USB4_TUNNEL_DSP(obj)->slot);
+}
+
+/*
+ * A tunnel downstream port of a host's own PCIe switch (the ASM4242's,
+ * docs/USB4-HOSTS.md 5) gets the USB4 _DSD port mapping like a tunnel
+ * root port, when its host is a usb4-generic one. Daisy-chain ports
+ * (usb4-device set) are inside a device router and have none.
+ */
+static void dsp_build_aml(AcpiDevAmlIf *adev, Aml *scope)
+{
+    USB4TunnelDsp *s = USB4_TUNNEL_DSP(adev);
+    PCIDevice *d = PCI_DEVICE(s);
+
+    build_pci_bridge_aml(adev, scope);
+    if (!s->dev_path && usb4_acpi_port_has_generic_host(d)) {
+        usb4_acpi_build_tunnel_port_dsd(scope, d, s->usb4_port_number,
+                                        s->acpi_hotplug_d3,
+                                        s->acpi_external_facing);
+    }
+}
+
+static USB4TunnelSlot *dsp_get_slot(Object *obj)
+{
+    return &USB4_TUNNEL_DSP(obj)->slot;
+}
+
+static const Property dsp_props[] = {
+    DEFINE_PROP_STRING("usb4-device", USB4TunnelDsp, dev_path),
+    DEFINE_PROP_UINT32("usb4-dport", USB4TunnelDsp, dport, 1),
+    DEFINE_PROP_UINT32("x-depth", USB4TunnelDsp, depth, 1),
+    DEFINE_PROP_UINT32("eject-timeout-ms", USB4TunnelDsp,
+                       slot.eject_timeout_ms, 10000),
+    DEFINE_PROP_UINT32("settle-ms", USB4TunnelDsp, slot.settle_ms, 2000),
+    DEFINE_PROP_BOOL("orderly-admin-down", USB4TunnelDsp,
+                     slot.orderly_admin_down, false),
+    DEFINE_PROP_UINT32("usb4-port", USB4TunnelDsp, usb4_port_number, 0),
+    DEFINE_PROP_BOOL("acpi-hotplug-in-d3", USB4TunnelDsp, acpi_hotplug_d3,
+                     true),
+    DEFINE_PROP_BOOL("acpi-external-facing", USB4TunnelDsp,
+                     acpi_external_facing, true),
+};
+
+static void dsp_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    PCIDeviceClass *k = PCI_DEVICE_CLASS(klass);
+    HotplugHandlerClass *hc = HOTPLUG_HANDLER_CLASS(klass);
+    USB4TunnelTargetClass *ttc = USB4_TUNNEL_TARGET_CLASS(klass);
+    USB4TunnelDspClass *sc = USB4_TUNNEL_DSP_CLASS(klass);
+    AcpiDevAmlIfClass *adevc = ACPI_DEV_AML_IF_CLASS(klass);
+
+    dc->desc = "USB4 daisy chain PCIe Down adapter (gated switch port)";
+    dc->user_creatable = false;
+    device_class_set_props(dc, dsp_props);
+    sc->parent_realize = k->realize;
+    k->realize = dsp_realize;
+    sc->parent_exit = k->exit;
+    k->exit = dsp_exit;
+    sc->parent_config_write = k->config_write;
+    k->config_write = dsp_write_config;
+    sc->parent_unplug = hc->unplug;
+    hc->unplug = dsp_unplug;
+    ttc->get_slot = dsp_get_slot;
+    adevc->build_dev_aml = dsp_build_aml;
+    usb4_tunnel_slot_class_init(klass);
+}
+
+static const TypeInfo dsp_info = {
+    .name = TYPE_USB4_TUNNEL_DSP,
+    .parent = TYPE_XIO3130_DOWNSTREAM,
+    .instance_size = sizeof(USB4TunnelDsp),
+    .class_size = sizeof(USB4TunnelDspClass),
+    .class_init = dsp_class_init,
+    .instance_finalize = dsp_finalize,
+    .interfaces = (const InterfaceInfo[]) {
+        { TYPE_USB4_TUNNEL_TARGET },
+        { }
+    },
+};
+
+static void dsp_register_types(void)
+{
+    type_register_static(&dsp_info);
+}
+
+type_init(dsp_register_types)
