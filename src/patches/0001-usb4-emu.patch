+/*
+ * T4: check a 63-word device-connected event and return its connection
+ * id. @route is the expected route string, @info the link info without
+ * the boot bit (checked by the caller).
+ */
+static unsigned check_connected(const uint32_t *w, unsigned n,
+                                uint64_t route, uint16_t info,
+                                uint32_t *uuid)
+{
+    uint8_t blk[55 * 4];
+    unsigned pos = 0;
+
+    g_assert_cmpuint(n, ==, 63);
+    g_assert_cmphex(w[0], ==, 0x0100b103);
+    g_assert_cmphex(w[3], ==, 0xffffffff);
+    g_assert_cmphex(w[4], ==, 0xffffffff);
+    g_assert_cmphex(w[5], ==, (uint32_t)(route >> 32));
+    g_assert_cmphex(w[6], ==, (uint32_t)route);
+    /* connection id 7:0, reserved 15:8, link info 31:16 */
+    g_assert_cmphex(w[7] & 0xff00, ==, 0);
+    g_assert_cmphex((w[7] >> 16) & ~0x400u, ==, info);
+    /* name block from word 8: vendor, model, Intel entry, 0x12, zeros */
+    for (unsigned i = 0; i < 55; i++) {
+        stl_le_p(blk + 4 * i, w[8 + i]);
+    }
+    for (unsigned k = 0; k < 4; k++) {
+        static const uint8_t type[] = { 0x01, 0x02, 0x10, 0x12 };
+
+        g_assert_cmpuint(blk[pos], >=, 2);
+        g_assert_cmphex(blk[pos + 1], ==, type[k]);
+        if (k < 2) {
+            g_assert_cmpuint(blk[pos + blk[pos] - 1], ==, 0);
+        }
+        pos += blk[pos];
+    }
+    for (; pos < sizeof(blk); pos++) {
+        g_assert_cmphex(blk[pos], ==, 0);
+    }
+    memcpy(uuid, &w[1], 16);
+    return w[7] & 0xff;
+}
+
+/* T6: approve request, 8 words */
+static void approve(T *t, const uint32_t *uuid, uint64_t route, unsigned id,
+                    uint32_t *w)
+{
+    uint32_t cmd[8];
+
+    cmd[0] = 0x00000004;
+    memcpy(&cmd[1], uuid, 16);
+    cmd[5] = route >> 32;
+    cmd[6] = (uint32_t)route;
+    cmd[7] = id & 0xff;
+    icm_cmd(t, cmd, 8);
+    g_assert_cmpuint(icm_expect(t, PDF_ICM_RESP, w), ==, 8);
+    g_assert_cmpmem(&w[1], 28, &cmd[1], 28);
+}
