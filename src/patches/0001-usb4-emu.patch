+#define HOST 0ULL
+#define DEV1 1ULL           /* TopologyID 0,...,0,1: host adapter 1 */
+
+static void enumerate_router(uint64_t route, unsigned depth)
+{
+    uint32_t v[4];
+
+    CHECK(rd(route, USB4_CS_ROUTER, 0, 1, 4, v) == 0, "read DW1-4");
+    /* Guide 3.2.1 step 4: one write of DW1..DW4 */
+    v[0] = (v[0] & ~(7u << 20)) | (depth << 20);
+    v[1] = (uint32_t)route;
+    v[2] = (uint32_t)(route >> 32) | (1u << 31);
+    v[3] = (v[3] & ~0xff00u) | (0x10 << 8);      /* CMUV 1.0 */
+    CHECK(wr(route, USB4_CS_ROUTER, 0, 1, 4, v) == 0, "enumeration write");
+    CHECK(rd1(route, USB4_CS_ROUTER, 0, 6) & (1u << 24), "Router Ready");
+    CHECK(rd1(route, USB4_CS_ROUTER, 0, 3) & (1u << 31), "TopologyID Valid");
+}
+
+static void walk_caps(uint64_t route, unsigned cs, unsigned adp,
+                      unsigned first, const uint8_t *want, unsigned nwant)
+{
+    unsigned ptr = first, n = 0;
+
+    while (ptr && n < 8) {
+        uint32_t h = rd1(route, cs, adp, ptr);
+        CHECK(n < nwant && ((h >> 8) & 0xff) == want[n],
+              "adp %u cap %u at 0x%x id 0x%x", adp, n, ptr, (h >> 8) & 0xff);
+        ptr = h & 0xff;
+        n++;
+    }
+    CHECK(n == nwant, "adp %u capability count %u want %u", adp, n, nwant);
+}
+
+static void test_host_router(void)
+{
+    uint32_t v[16];
+    static const uint8_t lane0_caps[] = { USB4_CAP_LANE, USB4_CAP_TMU,
+                                          USB4_CAP_PORT };
+    static const uint8_t lane1_caps[] = { USB4_CAP_LANE, USB4_CAP_TMU };
+    static const uint8_t pcie_caps[] = { USB4_CAP_PROTO };
+    static const uint8_t rtr_caps[] = { USB4_CAP_TMU };
+
+    /* Router header (Guide 3.2.1 step 1: DW0..DW4 and more) */
+    CHECK(rd(HOST, USB4_CS_ROUTER, 0, 0, 9, v) == 0, "host DW0-8");
+    CHECK(v[0] == 0x56781234, "vendor/product %08x", v[0]);
+    CHECK(((v[1] >> 8) & 0x3f) == 5, "upstream adapter %u", (v[1] >> 8) & 63);
+    CHECK(((v[1] >> 14) & 0x3f) == 9, "max adapter %u", (v[1] >> 14) & 63);
+    CHECK((v[4] >> 24) == USB4_VERSION_1_0, "USB4 version %02x", v[4] >> 24);
+    CHECK((v[4] & 0xff) == 0x0a, "notification timeout default");
+    CHECK(v[7] >> 16 == 0x1234, "UUID vendor %08x", v[7]);
+    walk_caps(HOST, USB4_CS_ROUTER, 0, v[1] & 0xff, rtr_caps, 1);
+
+    enumerate_router(HOST, 0);
+
+    /* Adapter enumeration (Guide 3.2.2) */
+    static const uint32_t types[] = { 0, 0x01000001, 0x01000001, 0x01000001,
+                                      0x01000001, 0x01000002, 0x01100101,
+                                      0x01100101, 0x01200101, 0x01200101 };
+    for (unsigned a = 1; a <= 9; a++) {
+        CHECK(rd(HOST, USB4_CS_ADAPTER, a, 0, 6, v) == 0, "adp %u", a);
+        CHECK(v[2] == types[a], "adp %u type %08x", a, v[2]);
+        CHECK(((v[3] >> 20) & 0x3f) == a, "adapter number");
+        if (a <= 4) {
+            walk_caps(HOST, USB4_CS_ADAPTER, a, v[1] & 0xff,
+                      (a & 1) ? lane0_caps : lane1_caps, (a & 1) ? 3 : 2);
+            CHECK(v[4] & (1u << 31), "DFP lane adapter %u locked", a);
+            CHECK(!(v[4] & (1u << 30)), "not plugged");
+            CHECK(((rd1(HOST, USB4_CS_ADAPTER, a, USB4_ADP_CAP_LANE + 1) >>
+                    26) & 0xf) == USB4_LANE_CLD, "lane %u in CLd", a);
+        } else if (a >= 8) {
+            walk_caps(HOST, USB4_CS_ADAPTER, a, v[1] & 0xff, pcie_caps, 1);
+            wr1(HOST, USB4_CS_ADAPTER, a, USB4_ADP_CAP_USB3 + 2, 1u << 31);
+            CHECK(rd1(HOST, USB4_CS_ADAPTER, a, USB4_ADP_CAP_USB3 + 1) >> 31,
+                  "USB3 HCA follows CMR");
+            wr1(HOST, USB4_CS_ADAPTER, a, USB4_ADP_CAP_USB3 + 2, 0);
+        } else if (a >= 6) {
+            walk_caps(HOST, USB4_CS_ADAPTER, a, v[1] & 0xff, pcie_caps, 1);
+            CHECK((v[5] & 0x7f) == 8, "PCIe Max Input HopID");
+        } else {
+            CHECK((v[5] & 0x7f) == USB4_HOST_IF_TOTAL_PATHS - 1,
+                  "HI Max Input HopID");
+        }
+    }
+    CHECK(rd(HOST, USB4_CS_ADAPTER, 10, 0, 1, v) == (0x100 | USB4_ERR_ADP),
+          "adapter beyond Max Adapter gives ERR_ADP");
+
+    /* Address range checks (Spec 6.4.3.3) */
+    CHECK(rd(HOST, USB4_CS_ROUTER, 0, USB4_RTR_CS_DWORDS - 1, 2, v) ==
+          (0x100 | USB4_ERR_ADDR), "router CS beyond range: ERR_ADDR");
+    CHECK(rd(HOST, USB4_CS_PATH, 1, 2 * 32, 2, v) == (0x100 | USB4_ERR_ADDR),
+          "lane path CS beyond Max HopID: ERR_ADDR");
+    CHECK(rd(HOST, USB4_CS_COUNTERS, 1, 0, 1, v) == (0x100 | USB4_ERR_ADDR),
+          "no counters CS: ERR_ADDR");
+    CHECK(rd(HOST, USB4_CS_ROUTER, 0, 0, 0, v) == 0, "read size 0");
+    CHECK(rd(HOST, USB4_CS_ROUTER, 0, 0, 61, v) == (0x100 | USB4_ERR_LEN),
+          "read size 61: ERR_LEN");
+    /* Path 0 entry of a lane adapter: credits RO */
+    CHECK(((rd1(HOST, USB4_CS_PATH, 1, 0) >> 17) & 0x7f) >= 2,
+          "path 0 credits");
+
+    /* Write length mismatch: ERR_LEN, no write */
+    {
+        uint32_t dw[5] = { 0, 0, usb4_req_dw3(9, 2, 0, USB4_CS_ROUTER, 0),
+                           0x11, 0x22 };
+        send_raw(USB4_PDF_WRITE, dw, 4, false);   /* one data dword short */
+        Frame *f = rx_pop();
+        CHECK(f && f->pdf == USB4_PDF_NOTIFY &&
+              (f->dw[2] & 0xff) == USB4_ERR_LEN, "write length ERR_LEN");
+        CHECK(!rx_pop(), "no write response");
+    }
+    /* Bad CRC dropped silently */
+    {
+        uint32_t dw[3] = { 0, 0, usb4_req_dw3(0, 1, 0, USB4_CS_ROUTER, 0) };
+        send_raw(USB4_PDF_READ, dw, 3, true);
+        CHECK(!rx_pop(), "bad CRC frame got a reply");
+    }
+    /* Read-only fields keep their value */
+    wr1(HOST, USB4_CS_ROUTER, 0, 0, 0);
+    CHECK(rd1(HOST, USB4_CS_ROUTER, 0, 0) == 0x56781234, "ROUTER_CS_0 RO");
+    /* Unknown register in range: stored */
+    wr1(HOST, USB4_CS_ROUTER, 0, 60, 0xcafef00d);
+    CHECK(rd1(HOST, USB4_CS_ROUTER, 0, 60) == 0xcafef00d, "unknown stored");
+
+    /* Router operations */
+    uint32_t data[17], cs26;
+    cs26 = router_op(HOST, 0x33, 0, data);     /* Buffer Allocation Req */
+    CHECK(!(cs26 & (1u << 30)) && ((cs26 >> 24) & 0x3f) == 0, "BAR status");
+    CHECK((data[16] & 0xff) == 5, "BAR length %u", data[16] & 0xff);
+    CHECK((data[3] & 0xffff) == 4 && (data[3] >> 16) > 0, "baMaxPCIe");
+    cs26 = router_op(HOST, 0x22, 0, NULL);     /* NVM Read: unsupported */
+    CHECK(cs26 & (1u << 30), "NVM Read not supported");
+    usb4_fabric_set_pcie_down_rid(fab, 1, 0x00e0);
+    cs26 = router_op(HOST, 0x30, 0, data);     /* PCIe DS mapping */
+    CHECK(!(cs26 & (1u << 30)), "PCIe DS mapping supported");
+    CHECK((data[16] & 0xff) == 2 && ((data[16] >> 8) & 0xff) == 0,
+          "mapping entries %08x", data[16]);
+    CHECK(data[0] == (6u << 1) && data[1] == 0x00e0, "entry 0 %08x %08x",
+          data[0], data[1]);
+    router_op(HOST, 0x30, 0, data);
+    CHECK(((data[16] >> 8) & 0xff) == 1 && data[0] == (7u << 1), "entry 1");
+    cs26 = router_op(HOST, 0x31, 0, data);     /* Get Capabilities 0 */
+    CHECK(!(cs26 & (1u << 30)) && (data[16] & 0xff) == 5, "get caps");
+    cs26 = router_op(HOST, 0x32, 2 | (1u << 8), NULL);
+    CHECK(((cs26 >> 24) & 0x3f) == 0, "set caps seq bit");
+    cs26 = router_op(HOST, 0x24, (0 << 2) | (4 << 15), data);
+    CHECK(((cs26 >> 24) & 0x3f) == 0 && ((data[3] >> 8) & 0xff) == 3,
+          "host DROM version 3");
+
+    /* USB4 port sideband (Spec 4.1.1.3.2, Guide 9.2) */
+    uint32_t sb[16] = { 0 }, c1;
+    c1 = sb_access(HOST, 1, 0, 0, 0, 4, false, sb);   /* local Vendor ID */
+    CHECK(!(c1 & (3u << 25)) && ((c1 >> 8) & 0xff) == 4 &&
+          (sb[0] & 0xffff) == 0x1234, "SB vendor %08x c1 %08x", sb[0], c1);
+    c1 = sb_access(HOST, 1, 2, 1, 0, 4, false, sb);   /* retimer 1 */
+    CHECK(c1 & (1u << 25), "no re-timer answers (NR)");
+    c1 = sb_access(HOST, 1, 1, 0, 0, 4, false, sb);   /* link partner */
+    CHECK(c1 & (1u << 25), "no link partner (NR)");
+    sb[0] = 0x4d554e45;                               /* "ENUM" */
+    sb_access(HOST, 1, 0, 0, 8, 4, true, sb);
+    sb_access(HOST, 1, 0, 0, 8, 4, false, sb);
+    CHECK(sb[0] == 0, "ENUMERATE_RE-TIMERS completed %08x", sb[0]);
+    sb[0] = 0x12345678;
+    sb_access(HOST, 1, 0, 0, 8, 4, true, sb);
+    sb_access(HOST, 1, 0, 0, 8, 4, false, sb);
+    CHECK(sb[0] == 0x444D4321, "unknown port op: !CMD %08x", sb[0]);
+    c1 = sb_access(HOST, 1, 0, 0, 3, 4, false, sb);   /* undefined reg */
+    CHECK((c1 & (1u << 26)) && !((c1 >> 8) & 0xff), "undefined SB reg RC");
+
+    /* Nothing attached: route through port 1 gives ERR_CONN */
+    CHECK(rd(DEV1, USB4_CS_ROUTER, 0, 0, 1, v) == (0x100 | USB4_ERR_CONN),
+          "ERR_CONN");
+    /* Protocol adapter in the route: ERR_ADP */
+    CHECK(rd(6, USB4_CS_ROUTER, 0, 0, 1, v) == (0x100 | USB4_ERR_ADP),
+          "route through PCIe adapter: ERR_ADP");
+    expect_no_hp();
+}
+
+static USB4Device dev1 = { .serial = "USB4EMU01" };
+
+static void check_ltssm(bool l0)
+{
+    uint32_t h = rd1(HOST, USB4_CS_ADAPTER, 6, USB4_ADP_CAP_PCIE);
+    uint32_t d = rd1(DEV1, USB4_CS_ADAPTER, 3, USB4_ADP_CAP_PCIE);
+
+    CHECK(((h >> 25) & 0xf) == (l0 ? 6u : 0u) && !!(h & (1u << 16)) == l0,
+          "host LTSSM %08x", h);
+    CHECK(((d >> 25) & 0xf) == (l0 ? 6u : 0u), "device LTSSM %08x", d);
+}
+
+static void program_path(uint64_t route, unsigned adp, unsigned hop,
+                         unsigned out_adp, unsigned out_hop, unsigned credits,
+                         bool lane_ingress)
+{
+    uint32_t e[2];
+
+    /* Guide 5.2.1: single read then single write of the entry */
+    CHECK(rd(route, USB4_CS_PATH, adp, 2 * hop, 2, e) == 0, "path read");
+    e[0] = (e[0] & ~(0x7fu | 0x3fu << 11 | 0x7fu << 17)) | out_hop |
+           (out_adp << 11) | (1u << 31);
+    if (lane_ingress) {
+        e[0] |= credits << 17;
+    }
+    /* Table 5-2: priority 3, weight 1, IFC/EFC per segment */
+    e[1] = (e[1] & ~0x0f000f0fu) | 1 | (3 << 8) | (lane_ingress ?
+           (1u << 24) : (1u << 25 | 1u << 27));
+    CHECK(wr(route, USB4_CS_PATH, adp, 2 * hop, 2, e) == 0, "path write");
+}
+
+static void bring_up_device(void)
+{
+    uint32_t v[8], data[17], cs26;
+    static const uint8_t lane0_caps[] = { USB4_CAP_LANE, USB4_CAP_TMU,
+                                          USB4_CAP_PORT };
+
+    /* Hot plug events for both lanes of port 1 (Spec 6.8.1.1) */
+    expect_hp(HOST, 1, false);
+    expect_hp(HOST, 2, false);
+    expect_no_hp();
+    CHECK(((rd1(HOST, USB4_CS_ADAPTER, 1, USB4_ADP_CAP_LANE + 1) >> 26) &
+           0xf) == USB4_LANE_CL0, "lane 0 CL0");
+    CHECK(rd1(HOST, USB4_CS_ADAPTER, 1, 4) & (1u << 30), "plugged");
+    CHECK(rd1(HOST, USB4_CS_ADAPTER, 1, USB4_ADP_CAP_PORT + 18) &
+          (1u << 13), "Router Detected");
+
+    /* Locked DFP: ERR_LOCK; unlock (Guide 3.2.1) */
+    CHECK(rd(DEV1, USB4_CS_ROUTER, 0, 0, 5, v) == (0x100 | USB4_ERR_LOCK),
+          "ERR_LOCK while locked");
+    rmw(HOST, USB4_CS_ADAPTER, 1, 4, 1u << 31, 0);
+
+    /*
+     * Uninitialized router: router CS answers with the request route,
+     * other spaces are dropped (Spec 6.4.3.2).
+     */
+    CHECK(rd(DEV1, USB4_CS_ROUTER, 0, 0, 5, v) == 0, "device DW0-4");
+    CHECK(v[0] == (0x46f4 | (0x0004u << 16)), "device id %08x", v[0]);
+    CHECK(((v[1] >> 8) & 0x3f) == 1, "device upstream adapter");
+    CHECK(((v[1] >> 14) & 0x3f) == 4, "device max adapter");
+    CHECK(rd(DEV1, USB4_CS_ADAPTER, 1, 0, 1, v) == -1,
+          "uninitialized router drops adapter CS read");
+
+    enumerate_router(DEV1, 1);
+
+    /* Device adapters */
+    CHECK(rd(DEV1, USB4_CS_ADAPTER, 1, 0, 6, v) == 0, "dev adp 1");
+    CHECK(v[2] == 0x01000001 && !(v[4] & (1u << 31)), "dev lane, no lock");
+    walk_caps(DEV1, USB4_CS_ADAPTER, 1, v[1] & 0xff, lane0_caps, 3);
+    CHECK(rd(DEV1, USB4_CS_ADAPTER, 3, 0, 6, v) == 0, "dev adp 3");
+    CHECK(v[2] == 0x01100102, "dev PCIe up type %08x", v[2]);
+    CHECK(rd(DEV1, USB4_CS_ADAPTER, 4, 0, 6, v) == 0, "dev adp 4");
+    CHECK(v[2] == 0x01200102, "dev USB3 up type %08x", v[2]);
+    CHECK(rd(DEV1, USB4_CS_ADAPTER, 5, 0, 1, v) == (0x100 | USB4_ERR_ADP),
+          "dev adp 5 beyond max");
+
+    /* DROM via DROM Read router operation (Guide 2.5, Spec 8.3.1.2.5) */
+    cs26 = router_op(DEV1, 0x24, (0 << 2) | (4 << 15), data);
+    CHECK(!(cs26 & (1u << 30)) && ((cs26 >> 24) & 0x3f) == 0, "DROM read");
+    {
+        uint8_t drom[512];
+        unsigned len = ((data[3] >> 16) & 0xfff) + 13, got = 0;
+        uint32_t crc = (data[2] >> 8) | (data[3] << 24);
+
+        CHECK(((data[3] >> 8) & 0xff) == 3, "DROM version");
+        while (got < len) {
+            router_op(DEV1, 0x24, ((got / 4) << 2) | (16 << 15), data);
+            for (unsigned i = 0; i < 64 && got + i < sizeof(drom); i++) {
+                drom[got + i] = data[i / 4] >> (8 * (i % 4));
+            }
+            got += 64;
+        }
+        CHECK(usb4_drom_crc32(drom + 13, len - 13) == crc,
+              "DROM CRC32 %08x", crc);
+        CHECK(drom[17] == 0x01 && !strcmp((char *)drom + 18, "QEMU"),
+              "DROM vendor name");
+        unsigned m = 16 + drom[16];
+        CHECK(drom[m + 1] == 0x02 &&
+              !strcmp((char *)drom + m + 2, "USB4 NVMe Enclosure"),
+              "DROM model name");
+    }
+    /* Device has no PCIe downstream ports */
+    cs26 = router_op(DEV1, 0x30, 0, data);
+    CHECK(!(cs26 & (1u << 30)) && (data[16] & 0xff) == 0, "dev mapping");
+
+    /* Retimer enumeration on the device side and link partner access */
+    {
+        uint32_t sb[16];
+        uint32_t c1 = sb_access(HOST, 1, 1, 0, 0, 4, false, sb);
+        CHECK(!(c1 & (1u << 25)) && (sb[0] & 0xffff) == 0x46f4,
+              "link partner vendor via AT %08x", sb[0]);
+    }
+
+    /* Enable PCIe tunneling, CV -> CR (Guide 3.2.3) */
+    CHECK(!(rd1(DEV1, USB4_CS_ROUTER, 0, 6) & (1u << 25)), "CR before CV");
+    rmw(DEV1, USB4_CS_ROUTER, 0, 5, 0, 1u << 24);
+    rmw(DEV1, USB4_CS_ROUTER, 0, 5, 0, 1u << 31);
+    CHECK(rd1(DEV1, USB4_CS_ROUTER, 0, 6) & (1u << 25), "Configuration Ready");
+
+    /* Lane bonding (Guide 7.1) */
+    for (unsigned a = 1; a <= 2; a++) {
+        rmw(HOST, USB4_CS_ADAPTER, a, USB4_ADP_CAP_LANE + 1, 3u << 4, 3u << 4);
+        rmw(DEV1, USB4_CS_ADAPTER, a, USB4_ADP_CAP_LANE + 1, 3u << 4, 3u << 4);
+    }
+    rmw(HOST, USB4_CS_ADAPTER, 1, USB4_ADP_CAP_LANE + 1, 0, 1u << 15);
+    expect_hp(HOST, 2, true);       /* lane 1 hot unplug after bonding */
+    {
+        uint32_t l1 = rd1(HOST, USB4_CS_ADAPTER, 1, USB4_ADP_CAP_LANE + 1);
+        CHECK(((l1 >> 20) & 0x3f) == 2 && !(l1 & (1u << 15)),
+              "x2 after bonding %08x", l1);
+        l1 = rd1(DEV1, USB4_CS_ADAPTER, 1, USB4_ADP_CAP_LANE + 1);
+        CHECK(((l1 >> 20) & 0x3f) == 2, "device side x2");
+    }
+
+    /* PCIe paths (Guide 5.3.1) */
+    check_ltssm(false);
+    CHECK(tp_state == USB4_TUNNEL_DOWN, "tunnel down before paths");
+    program_path(HOST, 6, 8, 1, 8, 0, false);      /* down: PCIe -> lane */
+    program_path(DEV1, 1, 8, 3, 8, 32, true);      /* down: lane -> PCIe */
+    program_path(DEV1, 3, 8, 1, 9, 0, false);      /* up: PCIe -> lane */
+    program_path(HOST, 1, 9, 6, 8, 32, true);      /* up: lane -> PCIe */
+    CHECK(tp_state == USB4_TUNNEL_DOWN, "tunnel down before PE");
+    rmw(DEV1, USB4_CS_ADAPTER, 3, USB4_ADP_CAP_PCIE, 0, 1u << 31);
+    CHECK(tp_state == USB4_TUNNEL_DOWN, "tunnel down with one PE");
+    rmw(HOST, USB4_CS_ADAPTER, 6, USB4_ADP_CAP_PCIE, 0, 1u << 31);
+    CHECK(tp_state == USB4_TUNNEL_UP && tp_reason == USB4_TUNNEL_REASON_UP &&
+          tp_dev == &dev1, "tunnel UP");
+    CHECK(usb4_fabric_tunnel_state(fab, 1) == USB4_TUNNEL_UP, "query");
+    check_ltssm(true);
+
+    /* USB3 Gen X paths (Guide 5.5.1, Table 5-4): host adp 8 <-> dev 4 */
+    CHECK(u3_state == USB4_TUNNEL_DOWN, "USB3 down before paths");
+    CHECK(!(rd1(HOST, USB4_CS_ADAPTER, 8, USB4_ADP_CAP_USB3 + 4) &
+            (1u << 7)), "ULV 0 before tunnel");
+    program_path(HOST, 8, 8, 1, 10, 0, false);
+    program_path(DEV1, 1, 10, 4, 8, 32, true);
+    program_path(DEV1, 4, 8, 1, 11, 0, false);
+    program_path(HOST, 1, 11, 8, 8, 32, true);
+    rmw(HOST, USB4_CS_ADAPTER, 8, USB4_ADP_CAP_USB3, 0, 3u << 30);
+    rmw(DEV1, USB4_CS_ADAPTER, 4, USB4_ADP_CAP_USB3, 0, 3u << 30);
+    CHECK(u3_state == USB4_TUNNEL_DOWN, "USB3 down without UTO");
+    rmw(DEV1, USB4_CS_ROUTER, 0, 5, 0, 1u << 25);
+    CHECK(u3_state == USB4_TUNNEL_UP && u3_reason == USB4_TUNNEL_REASON_UP,
+          "USB3 tunnel UP");
+    CHECK(rd1(HOST, USB4_CS_ADAPTER, 8, USB4_ADP_CAP_USB3 + 4) & (1u << 7),
+          "host ULV");
+    CHECK(rd1(DEV1, USB4_CS_ADAPTER, 4, USB4_ADP_CAP_USB3 + 4) & (1u << 7),
+          "device ULV");
+    /* Teardown clears PE, keeps V (Guide 5.5.2); then back up */
+    rmw(DEV1, USB4_CS_ADAPTER, 4, USB4_ADP_CAP_USB3, 1u << 31, 0);
+    CHECK(u3_state == USB4_TUNNEL_DOWN &&
+          u3_reason == USB4_TUNNEL_REASON_ADMIN_DOWN, "USB3 admin down");
+    CHECK(tp_state == USB4_TUNNEL_UP, "PCIe unaffected by USB3");
+    rmw(DEV1, USB4_CS_ADAPTER, 4, USB4_ADP_CAP_USB3, 0, 1u << 31);
+    CHECK(u3_state == USB4_TUNNEL_UP, "USB3 up again");
+    /* CM bandwidth handshake: CMR -> HCA (Spec 9.1.2) */
+    rmw(HOST, USB4_CS_ADAPTER, 8, USB4_ADP_CAP_USB3 + 2, 0, 1u << 31);
+    CHECK(rd1(HOST, USB4_CS_ADAPTER, 8, USB4_ADP_CAP_USB3 + 1) & (1u << 31),
+          "HCA follows CMR");
+    rmw(HOST, USB4_CS_ADAPTER, 8, USB4_ADP_CAP_USB3 + 2, 1u << 31, 0);
+}
+
+static void expect_tunnel(USB4TunnelState st, USB4TunnelReason why,
+                          const char *what)
+{
+    CHECK(tp_state == st && (st == USB4_TUNNEL_UP || tp_reason == why),
+          "%s: state %d reason %d", what, tp_state, tp_reason);
+}
+
+static void test_device(void)
+{
+    int calls;
+
+    CHECK(usb4_fabric_attach(fab, 1, &dev1, NULL), "attach");
+    CHECK(dev1.router != NULL, "device router handle");
+    bring_up_device();
+
+    /*
+     * Spec-derived routers: Router CS responses carry the Upstream
+     * Adapter, for writes as for reads (Table 6-3).
+     */
+    wr1(DEV1, USB4_CS_ROUTER, 0, 4, rd1(DEV1, USB4_CS_ROUTER, 0, 4));
+    CHECK(USB4_REQ_ADP(last_rsp_dw2) == 1, "device write reply adapter %u",
+          USB4_REQ_ADP(last_rsp_dw2));
+    rd1(DEV1, USB4_CS_ROUTER, 0, 5);
+    CHECK(USB4_REQ_ADP(last_rsp_dw2) == 1, "device read reply adapter %u",
+          USB4_REQ_ADP(last_rsp_dw2));
+    wr1(HOST, USB4_CS_ROUTER, 0, 4, rd1(HOST, USB4_CS_ROUTER, 0, 4));
+    CHECK(USB4_REQ_ADP(last_rsp_dw2) == fab->hr->upstream_adapter,
+          "host write reply adapter %u", USB4_REQ_ADP(last_rsp_dw2));
+
+    /* Admin-down by Path Enable, then back up */
+    rmw(HOST, USB4_CS_ADAPTER, 6, USB4_ADP_CAP_PCIE, 1u << 31, 0);
+    expect_tunnel(USB4_TUNNEL_DOWN, USB4_TUNNEL_REASON_ADMIN_DOWN,
+                  "clear host PE");
+    check_ltssm(false);
+    rmw(HOST, USB4_CS_ADAPTER, 6, USB4_ADP_CAP_PCIE, 0, 1u << 31);
+    expect_tunnel(USB4_TUNNEL_UP, 0, "set host PE");
+
+    /* Missing PTO */
+    rmw(DEV1, USB4_CS_ROUTER, 0, 5, 1u << 24, 0);
+    expect_tunnel(USB4_TUNNEL_DOWN, USB4_TUNNEL_REASON_ADMIN_DOWN, "no PTO");
+    rmw(DEV1, USB4_CS_ROUTER, 0, 5, 0, 1u << 24);
+    expect_tunnel(USB4_TUNNEL_UP, 0, "PTO again");
+
+    /* Missing CR: clearing CV drops Configuration Ready */
+    rmw(DEV1, USB4_CS_ROUTER, 0, 5, 1u << 31, 0);
+    CHECK(!(rd1(DEV1, USB4_CS_ROUTER, 0, 6) & (1u << 25)), "CR cleared");
+    expect_tunnel(USB4_TUNNEL_DOWN, USB4_TUNNEL_REASON_ADMIN_DOWN, "no CR");
+    rmw(DEV1, USB4_CS_ROUTER, 0, 5, 0, 1u << 31);
+    expect_tunnel(USB4_TUNNEL_UP, 0, "CV again");
+
+    /*
+     * Incomplete path: invalidate the device lane hop (teardown order of
+     * Guide 5.2.2 writes only DW0)
+     */
+    rmw(DEV1, USB4_CS_PATH, 1, 16, 1u << 31, 0);
+    expect_tunnel(USB4_TUNNEL_DOWN, USB4_TUNNEL_REASON_ADMIN_DOWN,
+                  "invalid hop");
+    rmw(DEV1, USB4_CS_PATH, 1, 16, 0, 1u << 31);
+    expect_tunnel(USB4_TUNNEL_UP, 0, "hop valid again");
+
+    /* Lock bit gates control packets only, not the tunnel */
+    calls = tp_calls;
+    rmw(HOST, USB4_CS_ADAPTER, 1, 4, 0, 1u << 31);
+    uint32_t v;
+    CHECK(rd(DEV1, USB4_CS_ROUTER, 0, 0, 1, &v) == (0x100 | USB4_ERR_LOCK),
+          "locked again");
+    CHECK(tp_calls == calls && tp_state == USB4_TUNNEL_UP,
+          "lock does not touch the tunnel");
+    rmw(HOST, USB4_CS_ADAPTER, 1, 4, 1u << 31, 0);
+
+    /*
+     * Downstream Port Reset: link drops, device router resets, then
+     * retrains unbonded (Guide 7.3, Spec 6.9)
+     */
+    rmw(HOST, USB4_CS_ADAPTER, 1, USB4_ADP_CAP_PORT + 19, 0, 1);
+    expect_tunnel(USB4_TUNNEL_DOWN, USB4_TUNNEL_REASON_SURPRISE, "DPR");
+    expect_hp(HOST, 1, true);
+    expect_no_hp();
+    CHECK(((rd1(HOST, USB4_CS_ADAPTER, 1, USB4_ADP_CAP_LANE + 1) >> 26) &
+           0xf) == USB4_LANE_CLD, "CLd during DPR");
+    CHECK(!(rd1(HOST, USB4_CS_ADAPTER, 6, USB4_ADP_CAP_PCIE) & (3u << 25)),
+          "LTSSM back to Detect");
+    /* Guide 3.4.1 / 5.3.2: tear down the host side of the paths */
+    rmw(HOST, USB4_CS_ADAPTER, 6, USB4_ADP_CAP_PCIE, 1u << 31, 0);
+    rmw(HOST, USB4_CS_PATH, 6, 16, 1u << 31, 0);
+    rmw(HOST, USB4_CS_PATH, 1, 18, 1u << 31, 0);
+    advance(10);
+    rmw(HOST, USB4_CS_ADAPTER, 1, USB4_ADP_CAP_PORT + 19, 1, 0);
+    bring_up_device();
+
+    /* Surprise removal */
+    calls = tp_calls;
+    {
+        int u3 = u3_calls;
+
+        usb4_fabric_detach(fab, 1);
+        CHECK(u3_calls == u3 + 1 && u3_state == USB4_TUNNEL_DOWN &&
+              u3_reason == USB4_TUNNEL_REASON_SURPRISE, "USB3 down on detach");
+    }
+    CHECK(tp_calls == calls + 1, "one transition on detach");
+    expect_tunnel(USB4_TUNNEL_DOWN, USB4_TUNNEL_REASON_SURPRISE, "detach");
+    CHECK(dev1.router == NULL, "router handle cleared");
+    expect_hp(HOST, 1, true);
+    expect_no_hp();
+    CHECK(rd(DEV1, USB4_CS_ROUTER, 0, 0, 1, &v) == (0x100 | USB4_ERR_CONN),
+          "ERR_CONN after detach");
+    CHECK(((rd1(HOST, USB4_CS_ADAPTER, 1, USB4_ADP_CAP_LANE + 1) >> 26) &
+           0xf) == USB4_LANE_CLD, "CLd after detach");
+}
+
+/* Device already attached when the CM starts (Guide 3.1.1) */
+static void test_boot_attached(void)
+{
+    USB4FabricConfig cfg = {
+        .profile = USB4_PROFILE_USB4_GENERIC, .dialect = USB4_DIALECT_USB4,
+        .router_vendor_id = 0x1234, .router_device_id = 0x5678,
+        .num_usb4_ports = 2,
+    };
+    USB4Device dev2 = { .serial = "BOOT" };
+
+    usb4_fabric_free(fab);
+    fab = usb4_fabric_new((USB4Host *)&fake_host, &cfg);
+    CHECK(usb4_fabric_attach(fab, 2, &dev2, NULL), "attach port 2");
+    expect_no_hp();     /* host router not enumerated: no events */
+    CHECK(((rd1(HOST, USB4_CS_ADAPTER, 3, USB4_ADP_CAP_LANE + 1) >> 26) &
+           0xf) == USB4_LANE_CL0, "scan finds port 2 in CL0");
+    enumerate_router(HOST, 0);
+    expect_hp(HOST, 3, false);
+    expect_hp(HOST, 4, false);
+    expect_no_hp();
+
+    /*
+     * Unacknowledged events are retransmitted; a host interface reset
+     * drops them
+     */
+    usb4_fabric_detach(fab, 2);
+    rx_flush_hp();
+    CHECK(n_hpev >= 1, "unplug sent");
+    n_hpev = 0;
+    advance(25);
+    rx_flush_hp();
+    CHECK(n_hpev >= 2, "retransmitted %u", n_hpev);
+    usb4_fabric_host_reset(fab);
+    n_hpev = 0;
+    expect_no_hp();
+
+    /* Fabric reset: host router back to defaults */
+    usb4_fabric_reset(fab);
+    CHECK(!(rd1(HOST, USB4_CS_ROUTER, 0, 3) & (1u << 31)), "TIDV reset");
+}
+
+/* ------------------------------------------------------------------ */
+/* Daisy chain: host port 1 -> hub (one downstream port) -> leaf        */
+/* ------------------------------------------------------------------ */
+
+#define HUB  0x01ULL        /* host adapter 1 */
+#define LEAF 0x0301ULL      /* host adapter 1, then hub adapter 3 */
+
+static USB4Device hub = { .serial = "HUB", .ndfp = 1 };
+static USB4Device leaf = { .serial = "LEAF" };
+
+static void expect_tplog(unsigned i, USB4Device *d, USB4TunnelState st,
+                         USB4TunnelReason why, USB4TunnelPort *tp)
+{
+    CHECK(i < n_tplog && tplog[i].dev == d && tplog[i].st == st &&
+          (st == USB4_TUNNEL_UP || tplog[i].why == why) && tplog[i].tp == tp,
+          "transition %u of %u: dev %s state %d reason %d", i, n_tplog,
+          i < n_tplog ? tplog[i].dev->serial : "-",
+          i < n_tplog ? (int)tplog[i].st : -1,
+          i < n_tplog ? (int)tplog[i].why : -1);
+}
+
+/* CV/PTO -> CR and x2 bonding of the link above @route (Guide 3.2.3) */
+static void chain_config(uint64_t route, uint64_t up, unsigned up_lane0)
+{
+    rmw(route, USB4_CS_ROUTER, 0, 5, 0, 1u << 24);
+    rmw(route, USB4_CS_ROUTER, 0, 5, 0, 1u << 31);
+    CHECK(rd1(route, USB4_CS_ROUTER, 0, 6) & (1u << 25), "CR %" PRIx64,
+          route);
+    for (unsigned l = 0; l < 2; l++) {
+        rmw(up, USB4_CS_ADAPTER, up_lane0 + l, USB4_ADP_CAP_LANE + 1,
+            3u << 4, 3u << 4);
+        rmw(route, USB4_CS_ADAPTER, 1 + l, USB4_ADP_CAP_LANE + 1,
+            3u << 4, 3u << 4);
+    }
+    rmw(up, USB4_CS_ADAPTER, up_lane0, USB4_ADP_CAP_LANE + 1, 0, 1u << 15);
+    expect_hp(up, up_lane0 + 1, true);
+    CHECK(((rd1(route, USB4_CS_ADAPTER, 1, USB4_ADP_CAP_LANE + 1) >> 20) &
+           0x3f) == 2, "x2 %" PRIx64, route);
+}
+
+/* PCIe paths between parent PCIe Down @pd / lane @pl and child @route */
+static void chain_paths(uint64_t parent, unsigned pd, unsigned pl,
+                        uint64_t route, unsigned pu)
+{
+    program_path(parent, pd, 8, pl, 8, 0, false);
+    program_path(route, 1, 8, pu, 8, 32, true);
+    program_path(route, pu, 8, 1, 9, 0, false);
+    program_path(parent, pl, 9, pd, 8, 32, true);
+    rmw(route, USB4_CS_ADAPTER, pu, USB4_ADP_CAP_PCIE, 0, 1u << 31);
+    rmw(parent, USB4_CS_ADAPTER, pd, USB4_ADP_CAP_PCIE, 0, 1u << 31);
+}
+
+static void bring_up_leaf(void)
+{
+    uint32_t v[6], data[17], cs26;
+
+    expect_hp(HUB, 3, false);
+    expect_hp(HUB, 4, false);
+    expect_no_hp();
+    CHECK(rd(LEAF, USB4_CS_ROUTER, 0, 0, 1, v) == (0x100 | USB4_ERR_LOCK),
+          "leaf behind locked hub DFP");
+    rmw(HUB, USB4_CS_ADAPTER, 3, 4, 1u << 31, 0);
+    CHECK(rd(LEAF, USB4_CS_ROUTER, 0, 0, 2, v) == 0, "leaf uninitialized");
+    CHECK(((v[1] >> 14) & 0x3f) == 4, "leaf max adapter");
+    enumerate_router(LEAF, 2);
+    CHECK(((rd1(LEAF, USB4_CS_ROUTER, 0, 1) >> 20) & 7) == 2, "leaf depth");
+    cs26 = router_op(LEAF, 0x24, (0 << 2) | (4 << 15), data);
+    CHECK(!(cs26 & (1u << 30)) && ((cs26 >> 24) & 0x3f) == 0 &&
+          ((data[3] >> 8) & 0xff) == 3, "leaf DROM");
+    /* Errors at depth 2 come from the leaf */
+    CHECK(rd(0x020301, USB4_CS_ROUTER, 0, 0, 1, v) ==
+          (0x100 | USB4_ERR_CONN), "route through the leaf UFP lane 1");
+    CHECK(rd(0x040301, USB4_CS_ROUTER, 0, 0, 1, v) ==
+          (0x100 | USB4_ERR_ADP), "route through the leaf PCIe adapter");
+    chain_config(LEAF, HUB, 3);
+    expect_no_hp();
+}
+
+static void test_chain(void)
+{
+    USB4FabricConfig cfg = {
+        .profile = USB4_PROFILE_USB4_GENERIC, .dialect = USB4_DIALECT_USB4,
+        .router_vendor_id = 0x1234, .router_device_id = 0x5678,
+        .num_usb4_ports = 2,
+    };
+    USB4TunnelPort *hub_tp = (USB4TunnelPort *)&hub.tp;
+    USB4TunnelPort *host_tp = (USB4TunnelPort *)&fake_tp;
+    uint32_t v[6], data[17], cs26;
+    int t0;
+
+    usb4_fabric_free(fab);
+    fab = usb4_fabric_new((USB4Host *)&fake_host, &cfg);
+    n_hpev = 0;
+    n_tplog = 0;
+    CHECK(usb4_fabric_attach(fab, 1, &hub, NULL), "attach hub");
+    CHECK(usb4_fabric_attach_chained(fab, &hub, 1, &leaf, NULL),
+          "attach leaf");
+    CHECK(!usb4_fabric_attach_chained(fab, &hub, 2, &dev1, NULL),
+          "no second downstream port");
+    CHECK(!usb4_fabric_attach_chained(fab, &leaf, 1, &dev1, NULL),
+          "leaf has no downstream port");
+    enumerate_router(HOST, 0);
+    expect_hp(HOST, 1, false);
+    expect_hp(HOST, 2, false);
+    expect_no_hp();
+    rmw(HOST, USB4_CS_ADAPTER, 1, 4, 1u << 31, 0);
+
+    /*
+     * Hub layout (usb4-router.c): lanes 1-4, PCIe Up 5, USB3 Up 6,
+     * PCIe Down 7, USB3 Down 8
+     */
+    CHECK(rd(HUB, USB4_CS_ROUTER, 0, 0, 2, v) == 0, "hub DW0-1");
+    CHECK(((v[1] >> 14) & 0x3f) == 8, "hub max adapter %u",
+          (v[1] >> 14) & 0x3f);
+    /*
+     * Spec 6.4.3.2: an uninitialized router consumes any Router CS
+     * request, whatever the rest of the Route String says.
+     */
+    CHECK(rd(LEAF, USB4_CS_ROUTER, 0, 0, 1, v) == 0 &&
+          v[0] == (0x46f4 | (0x0004u << 16)),
+          "uninitialized hub answers a deeper request");
+    CHECK(rd(LEAF, USB4_CS_ADAPTER, 1, 0, 1, v) == -1,
+          "uninitialized hub drops a deeper adapter request");
+    enumerate_router(HUB, 1);
+    {
+        static const uint32_t type[] = { 0, 0x01000001, 0x01000001,
+                                         0x01000001, 0x01000001,
+                                         0x01100102, 0x01200102,
+                                         0x01100101, 0x01200101 };
+        for (unsigned a = 1; a <= 8; a++) {
+            CHECK(rd1(HUB, USB4_CS_ADAPTER, a, 2) == type[a],
+                  "hub adapter %u type", a);
+        }
+        CHECK(rd1(HUB, USB4_CS_ADAPTER, 3, 4) & (1u << 31),
+              "hub DFP locked");
+        CHECK(!(rd1(HUB, USB4_CS_ADAPTER, 1, 4) & (1u << 31)),
+              "hub UFP not locked");
+    }
+    cs26 = router_op(HUB, 0x30, 0, data);
+    CHECK(!(cs26 & (1u << 30)) && (data[16] & 0xff) == 1 &&
+          ((data[0] >> 1) & 0x3f) == 7 && data[1] == 0x0301,
+          "hub PCIe DS mapping %08x %08x", data[16], data[0]);
+    chain_config(HUB, HOST, 1);
+    bring_up_leaf();
+
+    /* Leaf paths first: its tunnel waits for the hub tunnel */
+    chain_paths(HUB, 7, 3, LEAF, 3);
+    CHECK(n_tplog == 0, "leaf tunnel waits for the hub tunnel");
+    chain_paths(HOST, 6, 1, HUB, 5);
+    expect_tplog(0, &hub, USB4_TUNNEL_UP, 0, host_tp);
+    expect_tplog(1, &leaf, USB4_TUNNEL_UP, 0, hub_tp);
+    CHECK(n_tplog == 2, "two tunnels up (%u)", n_tplog);
+    CHECK(usb4_fabric_tunnel_state(fab, 1) == USB4_TUNNEL_UP, "hub up");
+    CHECK(((rd1(HUB, USB4_CS_ADAPTER, 7, USB4_ADP_CAP_PCIE) >> 25) & 0xf) ==
+          6, "hub PCIe Down L0");
+    CHECK(((rd1(LEAF, USB4_CS_ADAPTER, 3, USB4_ADP_CAP_PCIE) >> 25) & 0xf) ==
+          6, "leaf PCIe Up L0");
+
+    /*
+     * USB3 Gen X through the hub (Guide 5.5.1): host USB3 Down 8 <-> hub
+     * USB3 Up 6, hub USB3 Down 8 <-> leaf USB3 Up 4. The leaf waits for
+     * the hub's USB3 tunnel.
+     */
+    {
+        int c = u3_calls;
+
+        rmw(LEAF, USB4_CS_ROUTER, 0, 5, 0, 1u << 25);
+        program_path(HUB, 8, 8, 3, 10, 0, false);
+        program_path(LEAF, 1, 10, 4, 8, 32, true);
+        program_path(LEAF, 4, 8, 1, 10, 0, false);
+        program_path(HUB, 3, 10, 8, 8, 32, true);
+        rmw(LEAF, USB4_CS_ADAPTER, 4, USB4_ADP_CAP_USB3, 0, 3u << 30);
+        rmw(HUB, USB4_CS_ADAPTER, 8, USB4_ADP_CAP_USB3, 0, 3u << 30);
+        CHECK(u3_calls == c, "leaf USB3 waits for the hub USB3 tunnel");
+        rmw(HUB, USB4_CS_ROUTER, 0, 5, 0, 1u << 25);
+        program_path(HOST, 8, 8, 1, 10, 0, false);
+        program_path(HUB, 1, 10, 6, 8, 32, true);
+        program_path(HUB, 6, 8, 1, 10, 0, false);
+        program_path(HOST, 1, 10, 8, 8, 32, true);
+        rmw(HUB, USB4_CS_ADAPTER, 6, USB4_ADP_CAP_USB3, 0, 3u << 30);
+        rmw(HOST, USB4_CS_ADAPTER, 8, USB4_ADP_CAP_USB3, 0, 3u << 30);
+        CHECK(u3_calls == c + 2 && u3_state == USB4_TUNNEL_UP &&
+              u3_dev == &leaf, "hub then leaf USB3 up (%d)", u3_calls - c);
+        CHECK(rd1(HUB, USB4_CS_ADAPTER, 8, USB4_ADP_CAP_USB3 + 4) &
+              (1u << 7), "hub USB3 Down link valid");
+        CHECK(rd1(LEAF, USB4_CS_ADAPTER, 4, USB4_ADP_CAP_USB3 + 4) &
+              (1u << 7), "leaf USB3 Up link valid");
+        c = u3_calls;
+        rmw(HOST, USB4_CS_ADAPTER, 8, USB4_ADP_CAP_USB3, 1u << 31, 0);
+        CHECK(u3_calls == c + 2 && u3_state == USB4_TUNNEL_DOWN &&
+              u3_dev == &hub, "USB3 down leaf first, then hub");
+        CHECK(tp_state == USB4_TUNNEL_UP, "PCIe unaffected");
+        rmw(HOST, USB4_CS_ADAPTER, 8, USB4_ADP_CAP_USB3, 0, 1u << 31);
+        CHECK(u3_calls == c + 4 && u3_dev == &leaf, "USB3 up again");
+    }
+
+    /* Outer tunnel admin down takes the inner one with it, leaf first */
+    n_tplog = 0;
+    rmw(HOST, USB4_CS_ADAPTER, 6, USB4_ADP_CAP_PCIE, 1u << 31, 0);
+    expect_tplog(0, &leaf, USB4_TUNNEL_DOWN, USB4_TUNNEL_REASON_ADMIN_DOWN,
+                 hub_tp);
+    expect_tplog(1, &hub, USB4_TUNNEL_DOWN, USB4_TUNNEL_REASON_ADMIN_DOWN,
+                 host_tp);
+    rmw(HOST, USB4_CS_ADAPTER, 6, USB4_ADP_CAP_PCIE, 0, 1u << 31);
+    expect_tplog(2, &hub, USB4_TUNNEL_UP, 0, host_tp);
+    expect_tplog(3, &leaf, USB4_TUNNEL_UP, 0, hub_tp);
+
+    /* Inner path hop broken: only the leaf goes down */
+    n_tplog = 0;
+    rmw(HUB, USB4_CS_PATH, 3, 18, 1u << 31, 0);
+    expect_tplog(0, &leaf, USB4_TUNNEL_DOWN, USB4_TUNNEL_REASON_ADMIN_DOWN,
+                 hub_tp);
+    CHECK(n_tplog == 1, "hub tunnel untouched");
+    rmw(HUB, USB4_CS_PATH, 3, 18, 0, 1u << 31);
+    expect_tplog(1, &leaf, USB4_TUNNEL_UP, 0, hub_tp);
+
+    /* DPR on the hub DFP resets the leaf (Spec 6.9) */
+    n_tplog = 0;
+    rmw(HUB, USB4_CS_ADAPTER, 3, USB4_ADP_CAP_PORT + 19, 0, 1);
+    expect_tplog(0, &leaf, USB4_TUNNEL_DOWN, USB4_TUNNEL_REASON_SURPRISE,
+                 hub_tp);
+    expect_hp(HUB, 3, true);
+    expect_no_hp();
+    CHECK(rd(LEAF, USB4_CS_ROUTER, 0, 0, 1, v) == (0x100 | USB4_ERR_CONN),
+          "leaf unreachable during DPR");
+    rmw(HUB, USB4_CS_ADAPTER, 7, USB4_ADP_CAP_PCIE, 1u << 31, 0);
+    rmw(HUB, USB4_CS_ADAPTER, 3, USB4_ADP_CAP_PORT + 19, 1, 0);
+    bring_up_leaf();
+    chain_paths(HUB, 7, 3, LEAF, 3);
+    expect_tplog(1, &leaf, USB4_TUNNEL_UP, 0, hub_tp);
+
+    /* Detach only the leaf: the hub reports it, its tunnel stays */
+    n_tplog = 0;
+    usb4_fabric_detach_device(fab, &leaf);
+    expect_tplog(0, &leaf, USB4_TUNNEL_DOWN, USB4_TUNNEL_REASON_SURPRISE,
+                 hub_tp);
+    CHECK(n_tplog == 1 && leaf.router == NULL && hub.router != NULL,
+          "leaf detached alone");
+    CHECK(usb4_fabric_tunnel_state(fab, 1) == USB4_TUNNEL_UP,
+          "hub tunnel still up");
+    expect_hp(HUB, 3, true);
+    expect_no_hp();
+    CHECK(rd(LEAF, USB4_CS_ROUTER, 0, 0, 1, v) == (0x100 | USB4_ERR_CONN),
+          "ERR_CONN from the hub");
+    CHECK(((rd1(HUB, USB4_CS_ADAPTER, 7, USB4_ADP_CAP_PCIE) >> 25) & 0xf) ==
+          0, "hub PCIe Down back to Detect");
+
+    /* Plug it back in; the CM rebuilds the hub side */
+    rmw(HUB, USB4_CS_ADAPTER, 7, USB4_ADP_CAP_PCIE, 1u << 31, 0);
+    CHECK(usb4_fabric_attach_chained(fab, &hub, 1, &leaf, NULL), "replug");
+    bring_up_leaf();
+    chain_paths(HUB, 7, 3, LEAF, 3);
+    expect_tplog(1, &leaf, USB4_TUNNEL_UP, 0, hub_tp);
+
+    /* Detach the middle router: both go away, leaf first, silently */
+    n_tplog = 0;
+    t0 = tp_calls;
+    usb4_fabric_detach(fab, 1);
+    expect_tplog(0, &leaf, USB4_TUNNEL_DOWN, USB4_TUNNEL_REASON_SURPRISE,
+                 hub_tp);
+    expect_tplog(1, &hub, USB4_TUNNEL_DOWN, USB4_TUNNEL_REASON_SURPRISE,
+                 host_tp);
+    CHECK(n_tplog == 2 && tp_calls == t0 + 1, "two downs");
+    CHECK(hub.router == NULL && leaf.router == NULL, "both detached");
+    expect_hp(HOST, 1, true);
+    expect_no_hp();
+    CHECK(rd(HUB, USB4_CS_ROUTER, 0, 0, 1, v) == (0x100 | USB4_ERR_CONN),
+          "hub gone");
+    CHECK(fab->ndr == 0, "no routers left");
+}
