+/*
+ * i440FX stand-ins for the Alpine Ridge switch ports report INTA# like
+ * the captured 15c0 ports (tests/captures/p14s-gen1/win98/ PCIDUMP,
+ * register 0x3d), with and without a hot-plug controller.
+ */
+static void test_switch_pins(void)
+{
+    QGuestAllocator alloc;
+    QTestState *qts = qtest_init("-machine pc "
+                                 "-device usb4-tb3-pci-bridge,bus=pci.0,"
+                                 "addr=0x5,chassis_nr=1,shpc=off,msi=off "
+                                 "-device usb4-tb3-tunnel-bridge,bus=pci.0,"
+                                 "addr=0x6,chassis_nr=2,msi=off");
+    QPCIBus *bus;
+    const int slots[] = { 5, 6 };
+
+    pc_alloc_init(&alloc, qts, ALLOC_NO_FLAGS);
+    bus = qpci_new_pc(qts, &alloc);
+    for (int i = 0; i < ARRAY_SIZE(slots); i++) {
+        QPCIDevice *d = qpci_device_find(bus, QPCI_DEVFN(slots[i], 0));
+
+        g_assert(d);
+        g_assert_cmphex(qpci_config_readw(d, PCI_DEVICE_ID), ==, 0x15c0);
+        g_assert_cmphex(qpci_config_readb(d, PCI_INTERRUPT_PIN), ==, 1);
+        g_free(d);
+    }
+    qpci_free_pc(bus);
+    alloc_destroy(&alloc);
+    qtest_quit(qts);
+}
