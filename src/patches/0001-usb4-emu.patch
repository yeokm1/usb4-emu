+static const char *usb4_pdf_name(unsigned pdf)
+{
+    switch (pdf) {
+    case USB4_PDF_READ: return "READ";
+    case USB4_PDF_WRITE: return "WRITE";
+    case USB4_PDF_NOTIFY: return "NOTIFICATION";
+    case USB4_PDF_NOTIFY_ACK: return "NOTIFICATION_ACK";
+    case 0x8: return "NOTIFICATION_ACK_ENH";
+    case USB4_PDF_HOTPLUG: return "HOTPLUG";
+    case USB4_PDF_XDOMAIN_REQ: return "XDOMAIN_REQ";
+    case USB4_PDF_XDOMAIN_RESP: return "XDOMAIN_RESP";
+    case USB4_PDF_ICM_EVENT: return "ICM_EVENT";
+    case USB4_PDF_ICM_REQ: return "ICM_REQ";
+    case USB4_PDF_ICM_RESP: return "ICM_RESP";
+    default: return "PDF?";
+    }
+}
+
+static uint32_t frame_dw(const uint8_t *f, size_t len, unsigned i)
+{
+    /* Control packets are big-endian DWs in the buffer (Spec 12.1.1). */
+    return (i + 1) * 4 <= len ? ldl_be_p(f + i * 4) : 0;
+}
+
+static void usb4_host_trace_frame(bool tx, unsigned pdf,
+                                  const uint8_t *f, size_t len)
+{
+    const char *dir = tx ? "TX" : "RX";
+    unsigned i, ndw = len / 4;
+
+    if (tx) {
+        trace_usb4_host_frame_tx(pdf, len, frame_dw(f, len, 0),
+                                 frame_dw(f, len, 1), frame_dw(f, len, 2),
+                                 frame_dw(f, len, 3));
+    } else {
+        trace_usb4_host_frame_rx(pdf, len, frame_dw(f, len, 0),
+                                 frame_dw(f, len, 1), frame_dw(f, len, 2),
+                                 frame_dw(f, len, 3));
+    }
+    if (trace_event_get_state_backends(TRACE_USB4_HOST_FRAME_DECODE) &&
+        len >= 12) {
+        /*
+         * Ring buffer payload = Route String High, Route String Low,
+         * control data..., CRC (Spec 6.4.2.2, Table 6-1). For read and
+         * write packets the third DW is Address[12:0], Size[18:13],
+         * Adapter[24:19], CS[26:25], SN[28:27] (Spec Table 6-2).
+         */
+        uint32_t hi = frame_dw(f, len, 0), lo = frame_dw(f, len, 1);
+        uint32_t d2 = frame_dw(f, len, 2);
+        uint64_t route = ((uint64_t)(hi & 0x7fffffff) << 32) | lo;
+        bool cm = hi >> 31;
+
+        if (pdf == USB4_PDF_READ || pdf == USB4_PDF_WRITE) {
+            trace_usb4_host_frame_decode(dir, usb4_pdf_name(pdf), route, cm,
+                                         (d2 >> 25) & 3, (d2 >> 19) & 0x3f,
+                                         d2 & 0x1fff, (d2 >> 13) & 0x3f,
+                                         (d2 >> 27) & 3);
+        } else {
+            trace_usb4_host_frame_decode(dir, usb4_pdf_name(pdf), route, cm,
+                                         0, 0, 0, ndw, 0);
+        }
+    }
+    if (trace_event_get_state_backends(TRACE_USB4_HOST_FRAME_DATA)) {
+        for (i = 0; i < ndw; i++) {
+            trace_usb4_host_frame_data(dir, i, frame_dw(f, len, i));
+        }
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* Receive (Spec 12.4)                                                   */
+/* ------------------------------------------------------------------ */
+
+/*
+ * Post one packet into the next available descriptor of RX ring @n in
+ * Raw Mode (Spec 12.4.2.2). Returns false when no descriptor is
+ * available or DMA failed, in which case nothing was consumed.
+ *
+ * DMA failure: the spec gives a completed descriptor no status for a
+ * host memory error (Table 12-8 has only buffer overrun and CRC error),
+ * so a failed buffer or descriptor write is never reported as a
+ * completion. The descriptor stays not-done (no DD), the Producer Index
+ * does not advance, no status is raised and the frame stays queued.
+ * Delivery is retried only on the next frame or RX doorbell, never in a
+ * loop, so a descriptor the guest does not repair stalls ring 0 (newer
+ * frames then drop at the FIFO limit) instead of exposing a buffer the
+ * device did not fill.
+ */
+static bool usb4_host_rx_post(USB4Host *s, unsigned n, uint8_t pdf,
+                              const uint8_t *data, size_t len)
+{
+    PCIDevice *pd = PCI_DEVICE(s);
+    USB4Ring *r = &s->rx[n];
+    uint32_t desc[4];
+    uint64_t daddr, baddr;
+    unsigned idx, offset, bufsz, avail, wlen;
+    uint32_t dw2;
+    bool rs, ie, bo;
+
+    if (!ring_valid(r) || r->pi == r->ci) {
+        return false;
+    }
+    idx = r->pi;
+    daddr = ring_base(r) + idx * 16;
+    if (pci_dma_read(pd, daddr, desc, sizeof(desc)) != MEMTX_OK) {
+        trace_usb4_host_dma_error("rx descriptor read", daddr, 16);
+        return false;
+    }
+    dw2 = le32_to_cpu(desc[2]);
+    rs = dw2 & DESC_RS;
+    ie = dw2 & DESC_IE;
+    offset = dw2 >> DESC_OFFSET_SHIFT;
+    baddr = ((uint64_t)le32_to_cpu(desc[1]) << 32) | le32_to_cpu(desc[0]);
+
+    /* Spec Table 12-25: buffer size 0 means 4096; minus the Offset. */
+    bufsz = r->buf_size ? r->buf_size : USB4_HI_MAX_BUF;
+    avail = bufsz > offset ? bufsz - offset : 0;
+    bo = len > avail;
+    wlen = MIN(len, avail);
+    if (wlen &&
+        pci_dma_write(pd, baddr + offset, data, wlen) != MEMTX_OK) {
+        trace_usb4_host_dma_error("rx buffer write", baddr + offset, wlen);
+        return false;
+    }
+
+    /* Write back per Spec Table 12-8, Raw Mode: SOF PDF 0, no CRC error. */
+    if (rs) {
+        uint32_t wb = (wlen & DESC_LEN_MASK) |
+                      ((uint32_t)(pdf & 0xf) << DESC_EOF_PDF_SHIFT) |
+                      DESC_DD | (bo ? DESC_BO : 0) | (ie ? DESC_IE : 0) |
+                      (offset << DESC_OFFSET_SHIFT);
+        uint32_t wb_le = cpu_to_le32(wb);
+
+        if (pci_dma_write(pd, daddr + 8, &wb_le, 4) != MEMTX_OK) {
+            trace_usb4_host_dma_error("rx descriptor write", daddr + 8, 4);
+            return false;
+        }
+        dw2 = wb;
+    }
+    /* Producer Index visible before any interrupt (polling rule). */
+    r->pi = ring_next(r, idx);
+    trace_usb4_host_rx_done(n, idx, baddr, wlen, pdf, bo, dw2, r->pi);
+    if (rs && ie) {
+        usb4_host_set_status(s, CAUSE_RX(s, n));
+    }
+    usb4_host_eval_vacancy(s, n);
+    return true;
+}
+
+static void usb4_host_rx_fifo_clear(USB4Host *s)
+{
+    USB4RxFrame *fr;
+
+    while ((fr = g_queue_pop_head(&s->rx_fifo))) {
+        g_free(fr);
+    }
+}
+
+/* Deliver queued ring 0 frames while the guest has descriptors posted. */
+static void usb4_host_rx_flush(USB4Host *s)
+{
+    USB4RxFrame *fr;
+
+    if (s->rx_flushing) {
+        return;
+    }
+    s->rx_flushing = true;
+    while ((fr = g_queue_peek_head(&s->rx_fifo))) {
+        if (!usb4_host_rx_post(s, 0, fr->pdf, fr->data, fr->len)) {
+            break;
+        }
+        g_queue_pop_head(&s->rx_fifo);
+        g_free(fr);
+    }
+    s->rx_flushing = false;
+}
+
+void usb4_host_rx_frame(USB4Host *h, uint8_t pdf,
+                        const uint8_t *frame, size_t len)
+{
+    USB4RxFrame *fr;
+
+    if (!h) {
+        return;
+    }
+    usb4_host_trace_frame(false, pdf, frame, len);
+    if (len > USB4_HI_MAX_BUF) {
+        trace_usb4_host_frame_drop("too long", pdf, len);
+        return;
+    }
+    /* Spec 12.4.2 step 2: a disabled ring discards packets. */
+    if (!ring_valid(&h->rx[0])) {
+        trace_usb4_host_frame_drop("RX ring 0 disabled", pdf, len);
+        return;
+    }
+    if (g_queue_get_length(&h->rx_fifo) >= USB4_HI_RX_FIFO_DEPTH) {
+        trace_usb4_host_frame_drop("fifo overflow", pdf, len);
+        return;
+    }
+    fr = g_malloc(sizeof(*fr) + len);
+    fr->pdf = pdf;
+    fr->len = len;
+    memcpy(fr->data, frame, len);
+    g_queue_push_tail(&h->rx_fifo, fr);
+    usb4_host_rx_flush(h);
+    if (!g_queue_is_empty(&h->rx_fifo)) {
+        trace_usb4_host_fifo(g_queue_get_length(&h->rx_fifo),
+                             "waiting for RX descriptors");
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* Transmit (Spec 12.3)                                                 */
+/* ------------------------------------------------------------------ */
+
+static void usb4_host_tx_frame_out(USB4Host *s, uint8_t pdf,
+                                   const uint8_t *buf, size_t len)
+{
+    usb4_host_trace_frame(true, pdf, buf, len);
+    if (s->icm && pdf == USB4_PDF_ICM_REQ) {
+        /* R5: ICM commands go to the firmware CM, not the fabric. */
+        usb4_icm_tx_frame(s->icm, buf, len);
+    } else if (s->loopback) {
+        usb4_host_rx_frame(s, pdf, buf, len);
+    } else if (s->fabric) {
+        usb4_fabric_tx_frame(s->fabric, pdf, buf, len);
+    } else {
+        trace_usb4_host_no_fabric("ring 0 TX frame dropped");
+    }
+}
+
+/*
+ * Walk TX ring @n from the Consumer Index to the Producer Index.
+ * Ring 0 operates in Raw Mode only (Spec 12.1): one descriptor carries one
+ * control packet whose PDF is the EOF PDF (Spec 12.3.2.2). Other rings
+ * carry no traffic in this model; their descriptors are fetched, completed
+ * and dropped, honouring Frame Mode boundaries only for tracing.
+ */
+static void usb4_host_tx_kick(USB4Host *s, unsigned n)
+{
+    PCIDevice *pd = PCI_DEVICE(s);
+    USB4Ring *r = &s->tx[n];
+
+    if (r->busy) {
+        return;
+    }
+    if (n > 0 && (r->ctrl & RING_CTRL_E2E) && s->asm_quirk_e2e &&
+        s->host_model == USB4_HOST_MODEL_ASM4242) {
+        /*
+         * asm4242 quirk b ([lkml] net patch, docs/research/AM5-USB4.md
+         * 2.3): end-to-end flow control credits for a Tx ring never
+         * arrive, so nothing is sent and no descriptor completes.
+         */
+        if (r->ci != r->pi) {
+            trace_usb4_host_ring_error("TX", n, "E2E credits never arrive "
+                                       "(asm4242 quirk)");
+        }
+        return;
+    }
+    r->busy = true;
+    while (ring_valid(r) && r->ci != r->pi) {
+        uint32_t desc[4];
+        uint64_t daddr, baddr;
+        unsigned idx = r->ci, len, offset, eof, sof;
+        uint32_t dw2;
+        bool rs, ie;
+
+        daddr = ring_base(r) + idx * 16;
+        if (pci_dma_read(pd, daddr, desc, sizeof(desc)) != MEMTX_OK) {
+            trace_usb4_host_dma_error("tx descriptor read", daddr, 16);
+            break;
+        }
+        dw2 = le32_to_cpu(desc[2]);
+        baddr = ((uint64_t)le32_to_cpu(desc[1]) << 32) |
+                le32_to_cpu(desc[0]);
+        len = dw2 & DESC_LEN_MASK;
+        if (!len) {
+            len = USB4_HI_MAX_BUF;       /* Spec Table 12-6 */
+        }
+        eof = (dw2 >> DESC_EOF_PDF_SHIFT) & 0xf;
+        sof = (dw2 >> DESC_SOF_PDF_SHIFT) & 0xf;
+        rs = dw2 & DESC_RS;
+        ie = dw2 & DESC_IE;
+        offset = dw2 >> DESC_OFFSET_SHIFT;
+        trace_usb4_host_tx_desc(n, idx, baddr, len, eof, sof, dw2);
+
+        bool have_frame = false;
+
+        if (n == 0) {
+            if (pci_dma_read(pd, baddr + offset, s->txbuf, len)
+                != MEMTX_OK) {
+                trace_usb4_host_dma_error("tx buffer read", baddr + offset,
+                                          len);
+            } else {
+                have_frame = true;
+            }
+            if (have_frame && !(s->icm && eof == USB4_PDF_ICM_REQ) &&
+                !s->loopback && !usb4_fabric_tx_ready(s->fabric, eof)) {
+                /*
+                 * The firmware CM holds config requests and its queue is
+                 * full (ICM-PROTOCOL.md 6.2): leave this descriptor
+                 * pending, not completed, until the hold drains, so no
+                 * request is lost and the guest sees the backpressure
+                 * as a TX ring that does not advance.
+                 */
+                s->tx_blocked = true;
+                trace_usb4_host_ring_error("TX", n, "fabric busy, "
+                                           "descriptor left pending");
+                break;
+            }
+        } else if (!(r->ctrl & RING_CTRL_RAW)) {
+            r->frame_len += len;
+            if (eof) {
+                trace_usb4_host_ring_error("TX", n,
+                                           "frame dropped (no traffic)");
+                r->frame_len = 0;
+            }
+        }
+
+        /*
+         * Complete the descriptor (DD, Consumer Index, TX cause) before
+         * the packet reaches the fabric, so a guest never sees the reply
+         * on RX ring 0 before the request's own TX completion. The data
+         * buffer has been fetched at this point (Spec 12.3.2.2).
+         */
+        if (rs) {
+            uint32_t wb = cpu_to_le32(dw2 | DESC_DD);
+
+            if (pci_dma_write(pd, daddr + 8, &wb, 4) != MEMTX_OK) {
+                trace_usb4_host_dma_error("tx descriptor write", daddr + 8,
+                                          4);
+            }
+        }
+        r->ci = ring_next(r, idx);
+        trace_usb4_host_tx_done(n, idx, rs, ie, r->ci);
+        if (rs && ie) {
+            usb4_host_set_status(s, CAUSE_TX(s, n));
+        }
+        if (have_frame) {
+            usb4_host_tx_frame_out(s, eof, s->txbuf, len);
+        }
+    }
+    r->busy = false;
+}
+
+void usb4_host_tx_resume(USB4Host *h)
+{
+    /* inside a ring walk the walker itself carries on */
+    if (h && h->tx_blocked && !h->tx[0].busy) {
+        h->tx_blocked = false;
+        usb4_host_tx_kick(h, 0);
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* Reset                                                                */
+/* ------------------------------------------------------------------ */
+
+/* Host Interface Reset (Spec 12.6.3.1.3): every HI register to default. */
+static void usb4_host_hi_reset(USB4Host *s, const char *why)
+{
+    trace_usb4_host_reset(why);
+    memset(s->tx, 0, sizeof(s->tx));
+    memset(s->rx, 0, sizeof(s->rx));
+    memset(s->isr, 0, sizeof(s->isr));
+    memset(s->imr, 0, sizeof(s->imr));
+    memset(s->ivar, 0, sizeof(s->ivar));
+    memset(s->itr, 0, sizeof(s->itr));
+    memset(s->vac_ctrl, 0, sizeof(s->vac_ctrl));
+    s->hi_control = 0;
+    if (s->profile == USB4_PROFILE_TB3_ALPINE_RIDGE) {
+        /* R2: DMA misc reset value as captured */
+        s->hi_control = TB3_AR_DMA_MISC;
+    }
+    if (s->profile == USB4_PROFILE_TB3_ALPINE_RIDGE || s->itr_fixed) {
+        /* R2 and the ADL capture: throttle entries read 0x1f4 */
+        for (int i = 0; i < USB4_HI_MSIX_VECTORS; i++) {
+            s->itr[i] = INTEL_ITR_INTERVAL;
+        }
+    }
+    s->cl1_enable = 0;
+    s->cl2_enable = 0;
+    s->tx_blocked = false;
+    usb4_host_rx_fifo_clear(s);
+    usb4_host_update_intx(s);
+    if (s->fabric) {
+        usb4_fabric_host_reset(s->fabric);
+    }
+}
+
+static void usb4_host_router_reset(USB4Host *s)
+{
+    /* Spec 12.6.3.1.2: the whole host router, which includes the HI. */
+    usb4_host_hi_reset(s, "host router reset");
+    if (s->fabric) {
+        usb4_fabric_reset(s->fabric);
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* MMIO                                                                 */
+/* ------------------------------------------------------------------ */
+
+typedef enum RegKind {
+    RK_NONE,
+    RK_TX_RING,        /* idx = ring, sub = register within ring */
+    RK_RX_RING,
+    RK_TX_CTRL,
+    RK_TX_CTRL2,
+    RK_RX_CTRL,
+    RK_RX_PDF,
+    RK_ISR, RK_ISC, RK_ISS, RK_IMR, RK_IMC, RK_IMS,
+    RK_ITR, RK_IVAR, RK_VAC_CTRL, RK_VAC_STATUS,
+    RK_HI_CAPS, RK_HI_RESET, RK_HI_CONTROL, RK_CL1, RK_CL2,
+    RK_HR_RESET,
+    RK_TB3_MAIL,
+} RegKind;
+
+static RegKind usb4_host_decode(hwaddr a, unsigned *idx, unsigned *sub)
+{
+    *idx = 0;
+    *sub = 0;
+    if (a < R_TX_BASE_LO + USB4_HI_PATHS * 0x10) {
+        *idx = a / 0x10;
+        *sub = a & 0xc;
+        return RK_TX_RING;
+    }
+    if (a >= R_RX_BASE_LO && a < R_RX_BASE_LO + USB4_HI_PATHS * 0x10) {
+        *idx = (a - R_RX_BASE_LO) / 0x10;
+        *sub = a & 0xc;
+        return RK_RX_RING;
+    }
+    if (a >= R_TX_RING_CTRL && a < R_TX_RING_CTRL + USB4_HI_PATHS * 0x20) {
+        *idx = (a - R_TX_RING_CTRL) / 0x20;
+        switch (a & 0x1f) {
+        case 0: return RK_TX_CTRL;
+        case 4: return RK_TX_CTRL2;
+        default: return RK_NONE;
+        }
+    }
+    if (a >= R_RX_RING_CTRL && a < R_RX_RING_CTRL + USB4_HI_PATHS * 0x20) {
+        *idx = (a - R_RX_RING_CTRL) / 0x20;
+        switch (a & 0x1f) {
+        case 0: return RK_RX_CTRL;
+        case 4: return RK_RX_PDF;
+        default: return RK_NONE;
+        }
+    }
+#define IN_ARRAY(base, n) (a >= (base) && a < (base) + 4 * (n))
+    if (IN_ARRAY(R_ISR, USB4_HI_ISR_DWORDS)) {
+        *idx = (a - R_ISR) / 4;
+        return RK_ISR;
+    }
+    if (IN_ARRAY(R_ISC, USB4_HI_ISR_DWORDS)) {
+        *idx = (a - R_ISC) / 4;
+        return RK_ISC;
+    }
+    if (IN_ARRAY(R_ISS, USB4_HI_ISR_DWORDS)) {
+        *idx = (a - R_ISS) / 4;
+        return RK_ISS;
+    }
+    if (IN_ARRAY(R_IMR, USB4_HI_ISR_DWORDS)) {
+        *idx = (a - R_IMR) / 4;
+        return RK_IMR;
+    }
+    if (IN_ARRAY(R_IMC, USB4_HI_ISR_DWORDS)) {
+        *idx = (a - R_IMC) / 4;
+        return RK_IMC;
+    }
+    if (IN_ARRAY(R_IMS, USB4_HI_ISR_DWORDS)) {
+        *idx = (a - R_IMS) / 4;
+        return RK_IMS;
+    }
+    if (IN_ARRAY(R_ITR, USB4_HI_MSIX_VECTORS)) {
+        *idx = (a - R_ITR) / 4;
+        return RK_ITR;
+    }
+    if (IN_ARRAY(R_IVAR, USB4_HI_IVAR_DWORDS)) {
+        *idx = (a - R_IVAR) / 4;
+        return RK_IVAR;
+    }
+    if (IN_ARRAY(R_RX_VAC_CTRL, USB4_HI_VAC_DWORDS)) {
+        *idx = (a - R_RX_VAC_CTRL) / 4;
+        return RK_VAC_CTRL;
+    }
+    if (IN_ARRAY(R_RX_VAC_STATUS, DIV_ROUND_UP(USB4_HI_PATHS, 32))) {
+        *idx = (a - R_RX_VAC_STATUS) / 4;
+        return RK_VAC_STATUS;
+    }
+#undef IN_ARRAY
+    switch (a) {
+    case R_HI_CAPS: return RK_HI_CAPS;
+    case R_HI_RESET: return RK_HI_RESET;
+    case R_HI_CONTROL: return RK_HI_CONTROL;
+    case R_HI_CL1_ENABLE: return RK_CL1;
+    case R_HI_CL2_ENABLE: return RK_CL2;
+    case R_HR_RESET: return RK_HR_RESET;
+    case R_TB3_INMAIL_DATA:
+    case R_TB3_INMAIL_CMD:
+    case R_TB3_OUTMAIL_CMD:
+    case R_TB3_FW_STS:
+        return RK_TB3_MAIL;
+    default:
+        return RK_NONE;
+    }
+}
+
+static const char *const ring_sub_name[] = {
+    "BASE_LO", "BASE_HI", "PROD_CONS", "SIZE"
+};
+
+static const char *usb4_host_reg_name(RegKind k, unsigned sub, bool tx)
+{
+    switch (k) {
+    case RK_TX_RING: return ring_sub_name[sub / 4];
+    case RK_RX_RING: return ring_sub_name[sub / 4];
+    case RK_TX_CTRL: return "TX_RING_CTRL";
+    case RK_TX_CTRL2: return "TX_RING_CTRL+4";
+    case RK_RX_CTRL: return "RX_RING_CTRL";
+    case RK_RX_PDF: return "RX_PDF_MASKS";
+    case RK_ISR: return "ISR";
+    case RK_ISC: return "ISC";
+    case RK_ISS: return "ISS";
+    case RK_IMR: return "IMR";
+    case RK_IMC: return "IMC";
+    case RK_IMS: return "IMS";
+    case RK_ITR: return "ITR";
+    case RK_IVAR: return "IVAR";
+    case RK_VAC_CTRL: return "RX_VACANCY_CTRL";
+    case RK_VAC_STATUS: return "RX_VACANCY_STATUS";
+    case RK_HI_CAPS: return "HI_CAPABILITIES";
+    case RK_HI_RESET: return "HI_RESET";
+    case RK_HI_CONTROL: return "HI_CONTROL";
+    case RK_CL1: return "HI_CL1_ENABLE";
+    case RK_CL2: return "HI_CL2_ENABLE";
+    case RK_HR_RESET: return "HOST_ROUTER_RESET";
+    case RK_TB3_MAIL: return "TB3_FW_MAILBOX";
+    default: return "?";
+    }
+}
+
+static void usb4_host_trace_access(bool write, hwaddr a, RegKind k,
+                                   unsigned idx, unsigned sub, uint32_t v)
+{
+    char name[48];
+    const char *base = usb4_host_reg_name(k, sub, true);
+
+    switch (k) {
+    case RK_TX_RING: case RK_TX_CTRL: case RK_TX_CTRL2:
+        snprintf(name, sizeof(name), "TX%u.%s", idx, base);
+        break;
+    case RK_RX_RING: case RK_RX_CTRL: case RK_RX_PDF:
+        snprintf(name, sizeof(name), "RX%u.%s", idx, base);
+        break;
+    case RK_ISR: case RK_ISC: case RK_ISS: case RK_IMR: case RK_IMC:
+    case RK_IMS: case RK_ITR: case RK_IVAR: case RK_VAC_CTRL:
+    case RK_VAC_STATUS:
+        snprintf(name, sizeof(name), "%s[%u]", base, idx);
+        break;
+    default:
+        snprintf(name, sizeof(name), "%s", base);
+        break;
+    }
+    if (write) {
+        trace_usb4_host_mmio_write(a, name, v);
+    } else {
+        trace_usb4_host_mmio_read(a, name, v);
+    }
+}
+
+static uint32_t usb4_host_ring_read(USB4Ring *r, unsigned sub, bool tx)
+{
+    switch (sub) {
+    case R_RING_BASE_LO: return r->base_lo;
+    case R_RING_BASE_HI: return r->base_hi;
+    case R_RING_INDEX: return ((uint32_t)r->pi << 16) | r->ci;
+    case R_RING_SIZE:
+        return tx ? r->size : (r->size | ((uint32_t)r->buf_size << 16));
+    }
+    return 0;
+}
+
+static uint64_t usb4_host_mmio_read(void *opaque, hwaddr a, unsigned size)
+{
+    USB4Host *s = opaque;
+    unsigned idx, sub;
+    RegKind k = usb4_host_decode(a, &idx, &sub);
+    uint32_t v = 0;
+
+    usb4_fabric_preos_end(s->fabric);       /* the OS driver is here */
+    switch (k) {
+    case RK_TX_RING:
+        v = usb4_host_ring_read(&s->tx[idx], sub, true);
+        break;
+    case RK_RX_RING:
+        v = usb4_host_ring_read(&s->rx[idx], sub, false);
+        break;
+    case RK_TX_CTRL:
+        v = s->tx[idx].ctrl;
+        break;
+    case RK_TX_CTRL2:
+        v = 0;
+        break;
+    case RK_RX_CTRL:
+        v = s->rx[idx].ctrl;
+        break;
+    case RK_RX_PDF:
+        v = s->rx[idx].pdf_masks;
+        break;
+    case RK_ISR:
+        v = s->isr[idx];
+        if (v && usb4_host_isr_read_clears(s)) {
+            s->isr[idx] = 0;
+            trace_usb4_host_irq_status_clear(idx, v, "read");
+            usb4_host_update_intx(s);
+        }
+        break;
+    case RK_IMR:
+        v = s->imr[idx];
+        break;
+    case RK_ISC: case RK_ISS: case RK_IMC: case RK_IMS:
+        v = 0;                       /* write-only, vendor defined */
+        break;
+    case RK_ITR:
+        v = s->itr[idx];
+        break;
+    case RK_IVAR:
+        v = s->ivar[idx];
+        break;
+    case RK_VAC_CTRL:
+        v = s->vac_ctrl[idx];
+        break;
+    case RK_VAC_STATUS: {
+        unsigned n;
+
+        for (n = 0; n < USB4_HI_PATHS; n++) {
+            v |= s->rx[n].vacancy ? 1u << n : 0;
+        }
+        break;
+    }
+    case RK_HI_CAPS:
+        /* Spec Table 12-11: Total Paths [10:0], HI version [23:16]. */
+        v = s->paths | ((uint32_t)s->hi_version << 16);
+        break;
+    case RK_HI_RESET:
+    case RK_HR_RESET:
+        v = 0;                       /* reset completes synchronously */
+        break;
+    case RK_HI_CONTROL:
+        v = s->hi_control;
+        break;
+    case RK_CL1:
+        v = s->cl1_enable;
+        break;
+    case RK_CL2:
+        v = s->cl2_enable;
+        break;
+    case RK_TB3_MAIL:
+        if (s->profile != USB4_PROFILE_TB3_ALPINE_RIDGE) {
+            trace_usb4_host_mmio_unimpl_read(a);
+            return 0;
+        }
+        /* ICM-PROTOCOL.md 2.1 - 2.3, R2, R3 */
+        switch (a) {
+        case R_TB3_INMAIL_DATA:
+            v = s->inmail_data;
+            break;
+        case R_TB3_INMAIL_CMD:
+            v = s->inmail_cmd;
+            break;
+        case R_TB3_OUTMAIL_CMD:
+            v = TB3_AR_OUTMAIL |
+                (s->been_d3 ? TB3_AR_OUTMAIL_AFTER_D3 : 0);
+            break;
+        case R_TB3_FW_STS:
+            v = TB3_AR_FW_STS;
+            break;
+        }
+        break;
+    case RK_NONE:
+        trace_usb4_host_mmio_unimpl_read(a);
+        return 0;
+    }
+    usb4_host_trace_access(false, a, k, idx, sub, v);
+    return v;
+}
+
+static void usb4_host_ring_write(USB4Host *s, unsigned n, unsigned sub,
+                                 uint32_t v, bool tx)
+{
+    USB4Ring *r = tx ? &s->tx[n] : &s->rx[n];
+    const char *dir = tx ? "TX" : "RX";
+
+    switch (sub) {
+    case R_RING_BASE_LO:
+        /* Spec Tables 12-17, 12-22: 16-byte aligned; resets indices. */
+        r->base_lo = v & ~0xfu;
+        usb4_host_ring_reset_indices(r, dir, n, "base write");
+        break;
+    case R_RING_BASE_HI:
+        r->base_hi = v;
+        usb4_host_ring_reset_indices(r, dir, n, "base write");
+        break;
+    case R_RING_SIZE:
+        r->size = v & 0xffff;
+        if (!tx) {
+            r->buf_size = (v >> 16) & 0xfff;
+        }
+        if (r->size > USB4_HI_MAX_RING_SIZE) {
+            qemu_log_mask(LOG_GUEST_ERROR, "usb4-host: %s ring %u size %u "
+                          "exceeds 4096\n", dir, n, r->size);
+            r->size = USB4_HI_MAX_RING_SIZE;
+        }
+        usb4_host_ring_reset_indices(r, dir, n, "size write");
+        trace_usb4_host_ring_config(dir, n, ring_base(r), r->size,
+                                    r->buf_size, r->ctrl);
+        break;
+    case R_RING_INDEX:
+        if (tx) {
+            /* Spec Table 12-19: Producer [31:16] R/W, Consumer RO. */
+            unsigned pi = v >> 16;
+
+            if (r->size && pi >= r->size) {
+                trace_usb4_host_ring_error(dir, n, "producer >= ring size");
+                qemu_log_mask(LOG_GUEST_ERROR, "usb4-host: TX ring %u "
+                              "producer %u >= size %u\n", n, pi, r->size);
+                break;
+            }
+            r->pi = pi;
+            trace_usb4_host_tx_doorbell(n, r->pi, r->ci);
+            usb4_host_tx_kick(s, n);
+        } else {
+            /* Spec Table 12-24: Consumer [15:0] R/W, Producer RO. */
+            unsigned ci = v & 0xffff;
+
+            if (r->size && ci >= r->size) {
+                trace_usb4_host_ring_error(dir, n, "consumer >= ring size");
+                qemu_log_mask(LOG_GUEST_ERROR, "usb4-host: RX ring %u "
+                              "consumer %u >= size %u\n", n, ci, r->size);
+                break;
+            }
+            r->ci = ci;
+            trace_usb4_host_rx_doorbell(n, r->pi, r->ci);
+            if (n == 0) {
+                usb4_host_rx_flush(s);
+            }
+            usb4_host_eval_vacancy(s, n);
+        }
+        break;
+    }
+}
+
+static void usb4_host_ring_ctrl_write(USB4Host *s, unsigned n, uint32_t v,
+                                      bool tx)
+{
+    USB4Ring *r = tx ? &s->tx[n] : &s->rx[n];
+    const char *dir = tx ? "TX" : "RX";
+    bool was = r->ctrl & RING_CTRL_VALID;
+    bool now;
+
+    r->ctrl = v & (tx ? TX_RING_CTRL_WMASK : RX_RING_CTRL_WMASK);
+    now = r->ctrl & RING_CTRL_VALID;
+    if (n == 0 && now && !(r->ctrl & RING_CTRL_RAW)) {
+        /* Spec 12.1: ring 0 is Raw Mode only; we treat it as raw. */
+        qemu_log_mask(LOG_GUEST_ERROR, "usb4-host: %s ring 0 enabled "
+                      "without Raw Mode\n", dir);
+    }
+    trace_usb4_host_ring_config(dir, n, ring_base(r), r->size, r->buf_size,
+                                r->ctrl);
+    if (was == now) {
+        return;
+    }
+    trace_usb4_host_ring_enable(dir, n, now, !!(r->ctrl & RING_CTRL_RAW));
+    if (!now) {
+        /*
+         * Disable. Inferred: the hardware-owned index returns to its
+         * default so a later re-enable starts at descriptor 0, matching
+         * the CM note under Table 12-24 that the CM resets its own index
+         * after clearing Ring Valid. Frames queued for ring 0 belonged
+         * to the previous driver instance and are discarded (12.4.2).
+         */
+        usb4_host_ring_reset_indices(r, dir, n, "ring disabled");
+        r->vacancy = false;
+        if (!tx && n == 0) {
+            usb4_host_rx_fifo_clear(s);
+        }
+        return;
+    }
+    if (tx) {
+        usb4_host_tx_kick(s, n);
+    } else {
+        if (n == 0) {
+            usb4_host_rx_flush(s);
+        }
+        usb4_host_eval_vacancy(s, n);
+    }
+}
+
+/*
+ * NHI mailbox, ICM-PROTOCOL.md 2.3 and R3: a command write with the
+ * request bit runs synchronously, so the guest's first poll sees the
+ * request bit clear; the code stays in bits 7:0 and bit 30 reports an
+ * unsupported command. Firmware status and the outbound mailbox are
+ * read-only here (R4: the firmware start path is not implemented).
+ */
+static void usb4_host_mailbox_write(USB4Host *s, hwaddr a, uint32_t v)
+{
+    bool ok;
+
+    switch (a) {
+    case R_TB3_INMAIL_DATA:
+        s->inmail_data = v;
+        break;
+    case R_TB3_INMAIL_CMD:
+        if (!(v & TB3_INMAIL_REQUEST)) {
+            s->inmail_cmd = v & (0xffu | TB3_INMAIL_ERROR);
+            break;
+        }
+        ok = s->icm && usb4_icm_mailbox(s->icm, v & 0xff, s->inmail_data);
+        s->inmail_cmd = (v & 0xff) | (ok ? 0 : TB3_INMAIL_ERROR);
+        trace_usb4_host_mailbox(v, ok);
+        break;
+    default:
+        trace_usb4_host_mmio_unimpl_write(a, v);
+        break;
+    }
+}
+
+static void usb4_host_mmio_write(void *opaque, hwaddr a, uint64_t val,
+                                 unsigned size)
+{
+    USB4Host *s = opaque;
+    unsigned idx, sub, n;
+    RegKind k = usb4_host_decode(a, &idx, &sub);
+    uint32_t v = val, old;
+
+    usb4_fabric_preos_end(s->fabric);
+
+    if (k == RK_NONE ||
+        (k == RK_TB3_MAIL && s->profile != USB4_PROFILE_TB3_ALPINE_RIDGE)) {
+        /* Spec 12.6: writes to non-implemented registers are discarded. */
+        trace_usb4_host_mmio_unimpl_write(a, v);
+        return;
+    }
+    usb4_host_trace_access(true, a, k, idx, sub, v);
+
+    switch (k) {
+    case RK_TX_RING:
+        usb4_host_ring_write(s, idx, sub, v, true);
+        break;
+    case RK_RX_RING:
+        usb4_host_ring_write(s, idx, sub, v, false);
+        break;
+    case RK_TX_CTRL:
+        usb4_host_ring_ctrl_write(s, idx, v, true);
+        break;
+    case RK_RX_CTRL:
+        usb4_host_ring_ctrl_write(s, idx, v, false);
+        break;
+    case RK_TX_CTRL2:
+        break;
+    case RK_RX_PDF:
+        s->rx[idx].pdf_masks = v;
+        break;
+    case RK_ISR:
+        /* Spec Table 12-28: "A Host shall not write to this register." */
+        qemu_log_mask(LOG_GUEST_ERROR, "usb4-host: write to ISR ignored\n");
+        break;
+    case RK_ISC:
+        if (s->profile == USB4_PROFILE_TB3_ALPINE_RIDGE) {
+            /*
+             * ARCHITECTURE.md 4.1, ICM-PROTOCOL.md 2.5 (R6): on the Intel
+             * register set status clears only by read or MSI-X
+             * auto-clear; the client never writes this register.
+             */
+            trace_usb4_host_mmio_unimpl_write(a, v);
+            break;
+        }
+        old = s->isr[idx] & v;
+        s->isr[idx] &= ~v;
+        if (old) {
+            trace_usb4_host_irq_status_clear(idx, old, "ISC write");
+        }
+        usb4_host_update_intx(s);
+        break;
+    case RK_ISS:
+        /* Spec Table 12-30: set the bits, as if the causes occurred. */
+        for (n = 0; n < 32; n++) {
+            if ((v & (1u << n)) && idx * 32 + n < 3 * s->paths) {
+                usb4_host_set_status(s, idx * 32 + n);
+            }
+        }
+        break;
+    case RK_IMR:
+        old = s->imr[idx];
+        s->imr[idx] = v;
+        usb4_host_mask_changed(s, idx, old);
+        break;
+    case RK_IMC:
+        old = s->imr[idx];
+        s->imr[idx] &= ~v;
+        usb4_host_mask_changed(s, idx, old);
+        break;
+    case RK_IMS:
+        old = s->imr[idx];
+        s->imr[idx] |= v;
+        usb4_host_mask_changed(s, idx, old);
+        break;
+    case RK_ITR:
+        if (s->itr_fixed) {
+            /*
+             * C1: the captured Intel hosts keep Interval at 0x1f4 on any
+             * write. Counter (bits 31:16) is not modelled and reads 0.
+             */
+            trace_usb4_host_mmio_unimpl_write(a, v);
+            break;
+        }
+        /* Stored only; moderation is not modelled (interval treated 0). */
+        s->itr[idx] = v;
+        break;
+    case RK_IVAR:
+        s->ivar[idx] = v;
+        break;
+    case RK_VAC_CTRL:
+        s->vac_ctrl[idx] = v;
+        for (n = 0; n < USB4_HI_PATHS; n++) {
+            usb4_host_eval_vacancy(s, n);
+        }
+        break;
+    case RK_VAC_STATUS:
+    case RK_HI_CAPS:
+        break;                      /* RO */
+    case RK_HI_RESET:
+        if (v & 1) {
+            usb4_host_hi_reset(s, "host interface reset (RST)");
+        }
+        break;
+    case RK_HR_RESET:
+        if (s->profile == USB4_PROFILE_TB3_ALPINE_RIDGE) {
+            /* R4: no host router reset on Alpine Ridge (version 0). */
+            trace_usb4_host_mmio_unimpl_write(a, v);
+            break;
+        }
+        if (v & 1) {
+            usb4_host_router_reset(s);
+        }
+        break;
+    case RK_HI_CONTROL:
+        s->hi_control = v;
+        break;
+    case RK_CL1:
+        s->cl1_enable = v & ~1u;
+        break;
+    case RK_CL2:
+        s->cl2_enable = v & ~1u;
+        break;
+    case RK_TB3_MAIL:
+        usb4_host_mailbox_write(s, a, v);
+        break;
+    case RK_NONE:
+        break;
+    }
+}
+
+static const MemoryRegionOps usb4_host_mmio_ops = {
+    .read = usb4_host_mmio_read,
+    .write = usb4_host_mmio_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    /* Spec 12.6: aligned 32-bit accesses. 64-bit ones are split. */
+    .valid = {
+        .min_access_size = 4,
+        .max_access_size = 8,
+    },
+    .impl = {
+        .min_access_size = 4,
+        .max_access_size = 4,
+    },
+};
+
+/* ------------------------------------------------------------------ */
+/* Accessors for the other components                                    */
+/* ------------------------------------------------------------------ */
+
+USB4Fabric *usb4_host_get_fabric(USB4Host *h)
+{
+    return h ? h->fabric : NULL;
+}
+
+/*
+ * The tunnel target (usb4-tunnel-port or usb4-tunnel-bridge) backing the
+ * PCIe Down adapter of USB4 port @port, or NULL. Resolved lazily because
+ * the target may be created after this device.
+ */
+USB4TunnelPort *usb4_host_get_port_tunnel(USB4Host *h, unsigned port)
+{
+    const char *id;
+    Object *o;
+
+    if (!h || port < 1 || port > 2) {
+        return NULL;
+    }
+    id = port == 1 ? h->tunnel_port_id : h->tunnel_port2_id;
+    if (!id) {
+        return NULL;
+    }
+    /*
+     * Resolved on every use, never cached: the target may be created
+     * after this device, and it may be unrealized and freed before the
+     * device router whose tunnel it carries (removal of a whole
+     * controller, review 2 #1). Only a realized target is returned.
+     */
+    o = object_resolve_path_component(
+            object_resolve_path("/machine/peripheral", NULL), id);
+    if (!o || !object_dynamic_cast(o, "usb4-tunnel-target") ||
+        !DEVICE(o)->realized) {
+        return NULL;
+    }
+    return (USB4TunnelPort *)o;
+}
+
+USB4TunnelPort *usb4_host_get_tunnel_port(USB4Host *h)
+{
+    return usb4_host_get_port_tunnel(h, 1);
+}
+
+USB4Profile usb4_host_profile(USB4Host *h)
+{
+    return h->profile;
+}
+
+USB4Host *usb4_host_from_bus(BusState *bus)
+{
+    if (!bus || !bus->parent) {
+        return NULL;
+    }
+    return (USB4Host *)object_dynamic_cast(OBJECT(bus->parent),
+                                           TYPE_USB4_HOST);
+}
+
+unsigned usb4_host_num_ports(USB4Host *h)
+{
+    return h->num_ports;
+}
+
+bool usb4_host_claim_port(USB4Host *h, unsigned port, USB4Device *d,
+                          Error **errp)
+{
+    if (port < 1 || port > h->num_ports) {
+        error_setg(errp, "usb4 port %u out of range (host has %u ports)",
+                   port, h->num_ports);
+        return false;
+    }
+    if (h->port_dev[port]) {
+        error_setg(errp, "usb4 port %u is already in use", port);
+        return false;
+    }
+    h->port_dev[port] = d;
+    h->usb_tries[port] = 0;
+    trace_usb4_host_port_claim(port, object_get_canonical_path(OBJECT(d)));
+    usb4_host_power_eval(h);
+    return true;
+}
+
+void usb4_host_release_port(USB4Host *h, unsigned port, USB4Device *d)
+{
+    if (port >= 1 && port <= h->num_ports && h->port_dev[port] == d) {
+        h->port_dev[port] = NULL;
+        h->usb_tries[port] = 0;
+        trace_usb4_host_port_release(port);
+        h->last_left_usb4 = usb4_device_dialect(d) == USB4_DIALECT_USB4;
+        usb4_host_power_eval(h);
+        /* R33: its USB side goes with it */
+        usb4_host_usb_mode_changed(h);
+    }
+}
+
+USB4Device *usb4_host_port_device(USB4Host *h, unsigned port)
+{
+    if (port < 1 || port > h->num_ports) {
+        return NULL;
+    }
+    return h->port_dev[port];
+}
+
+/* ------------------------------------------------------------------ */
+/* USB fallback of a USB4 device router, TB3 profiles (R33)             */
+/* ------------------------------------------------------------------ */
+
+/*
+ * The P14s's ORICO, not approved in time, re-enumerated as a SuperSpeed
+ * USB mass storage device on the Alpine Ridge xHCI (ICM-PROTOCOL.md
+ * 13.1, R1-D:161.956) and bound Linux's uas driver (R1-D:1.631). The
+ * stand-in sits on the xHCI named by the "xhci" property, backed by the
+ * device's NVMe drive, which is free while there is no PCIe tunnel:
+ *
+ * - usb-fallback=uas: a usb-uas with one scsi-hd, carrying the captured
+ *   USB and SCSI identity (usb4_host_uas_desc(), usb4_host_uas_disk());
+ *   The default on every machine type, i440FX included: xhci98 ships a
+ *   UAS driver for Windows 98 to 7 (xhciuas.sys).
+ * - usb-fallback=bot: a Bulk-Only usb-storage with QEMU's identity, an
+ *   opt-in for guests without a UAS driver. QEMU's usb-uas has no
+ *   Bulk-Only alternate setting; whether the ASM246X has one is not
+ *   captured (no lsusb -v) [inf: UAS devices usually do].
+ *
+ * The disk is attached through the drive's node with share-rw, so
+ * removing it does not delete a -drive (blockdev_mark_auto_del()).
+ * Not modelled: SuperSpeed Plus Gen 2x1 (R1-D:1.510); QEMU's xHCI runs
+ * SuperSpeed devices at 5 Gb/s.
+ */
+/* The USB bus of an xHCI PCI function, NULL if @o is none. */
+static BusState *usb4_host_xhci_bus(Object *o)
+{
+    BusState *b;
+
+    if (!o || !object_dynamic_cast(o, TYPE_XHCI_PCI)) {
+        return NULL;
+    }
+    QLIST_FOREACH(b, &DEVICE(o)->child_bus, sibling) {
+        if (object_dynamic_cast(OBJECT(b), TYPE_USB_BUS)) {
+            return b;
+        }
+    }
+    return NULL;
+}
+
+/*
+ * Check the "xhci" property (R33). A missing device is accepted at
+ * realize (it may come later on the command line, @final false); an
+ * existing one, and any at machine init done (@final), must be an xHCI
+ * with a USB bus.
+ */
+static bool usb4_host_xhci_check(USB4Host *s, bool final, Error **errp)
+{
+    Object *o;
+
+    if (!s->xhci_id) {
+        return true;
+    }
+    if (s->profile != USB4_PROFILE_TB3_ALPINE_RIDGE) {
+        error_setg(errp, "usb4-host: xhci needs a TB3 profile");
+        return false;
+    }
+    o = object_resolve_path_component(
+            object_resolve_path("/machine/peripheral", NULL), s->xhci_id);
+    if (!o && !final) {
+        return true;
+    }
+    if (!usb4_host_xhci_bus(o)) {
+        error_setg(errp, "usb4-host: xhci=%s is not an xHCI controller "
+                   "with a USB bus (use the usb4-tb3-xhci id)", s->xhci_id);
+        return false;
+    }
+    return true;
+}
+
+static void usb4_host_machine_done(Notifier *n, void *data)
+{
+    USB4Host *s = container_of(n, USB4Host, machine_done);
+    Error *err = NULL;
+
+    if (!usb4_host_xhci_check(s, true, &err)) {
+        error_report_err(err);
+        exit(1);
+    }
+}
+
+static DeviceState *usb4_host_xhci(USB4Host *s)
+{
+    Object *o;
+
+    if (!s->xhci_id) {
+        return NULL;
+    }
+    o = object_resolve_path_component(
+            object_resolve_path("/machine/peripheral", NULL), s->xhci_id);
+    if (!usb4_host_xhci_bus(o) || !DEVICE(o)->realized) {
+        return NULL;
+    }
+    return DEVICE(o);
+}
+
+/*
+ * R33: the ORICO's USB device identity in USB mode [obs] R1-D:1.524
+ * (idVendor=174c, idProduct=2463, bcdDevice=1.00, Mfr=2, Product=3,
+ * "ASM246X series", "ASMedia"; also R1-D:161.969). The serial number
+ * and its string index are redacted in the capture; index 1 is [inf]
+ * (the one left free) and its text is the NVMe serial, as before, or
+ * QEMU's per-port default built from "USB4EMU". The configurations,
+ * interfaces and endpoints stay QEMU's usb-uas ones.
+ */
+#define USB4_UAS_VID        0x174c
+#define USB4_UAS_PID        0x2463
+#define USB4_UAS_BCD        0x0100
+#define USB4_UAS_STR_SERIAL 1
+#define USB4_UAS_STR_MFR    2
+#define USB4_UAS_STR_PROD   3
+
+static const USBDesc *usb4_host_uas_desc(USBDevice *u)
+{
+    static USBDesc desc;
+    static USBDescStrings str;
+    const USBDesc *base = USB_DEVICE_GET_CLASS(u)->usb_desc;
+
+    if (!desc.str) {
+        desc = *base;
+        memcpy(str, base->str, sizeof(str));
+        /* QEMU's usb-uas uses 1-3 for these and 4-5 for configurations */
+        assert(desc.id.iManufacturer < 4 && desc.id.iProduct < 4 &&
+               desc.id.iSerialNumber < 4);
+        str[USB4_UAS_STR_SERIAL] = "USB4EMU";
+        str[USB4_UAS_STR_MFR] = "ASMedia";
+        str[USB4_UAS_STR_PROD] = "ASM246X series";
+        desc.id.idVendor = USB4_UAS_VID;
+        desc.id.idProduct = USB4_UAS_PID;
+        desc.id.bcdDevice = USB4_UAS_BCD;
+        desc.id.iManufacturer = USB4_UAS_STR_MFR;
+        desc.id.iProduct = USB4_UAS_STR_PROD;
+        desc.id.iSerialNumber = USB4_UAS_STR_SERIAL;
+        desc.str = str;
+    }
+    return &desc;
+}
+
+/* Unplug and drop a realized (or never realized) fallback USB device. */
+static void usb4_host_usb_drop(DeviceState *dev)
+{
+    HotplugHandler *hh = dev->realized ? qdev_get_hotplug_handler(dev)
+                                       : NULL;
+
+    if (hh) {
+        /* the USB bus detaches and unparents it */
+        hotplug_handler_unplug(hh, dev, &error_abort);
+    }
+    object_unparent(OBJECT(dev));
+    object_unref(OBJECT(dev));
+}
+
+/* A new USB device of the fallback with id "<host id>-usb<p>". */
+static DeviceState *usb4_host_usb_dev_new(USB4Host *s, unsigned p,
+                                          const char *type,
+                                          const char *serial, Error **errp)
+{
+    DeviceState *dev = qdev_new(type);
+
+    if (!qdev_set_id(dev, g_strdup_printf("%s-usb%u",
+                                          DEVICE(s)->id ? DEVICE(s)->id :
+                                          "usb4-host", p), errp) ||
+        (serial && *serial &&
+         !object_property_set_str(OBJECT(dev), "serial", serial, errp))) {
+        object_unparent(OBJECT(dev));
+        object_unref(OBJECT(dev));
+        return NULL;
+    }
+    return dev;
+}
+
+/*
+ * Realize @dev on @bus, keeping a reference for usb_dev[]. On failure
+ * (e.g. a permission conflict with a holder not yet released) it is
+ * dropped and @retry set.
+ */
+static bool usb4_host_usb_realize(DeviceState *dev, BusState *bus,
+                                  unsigned p, bool *retry)
+{
+    Error *err = NULL;
+
+    object_ref(OBJECT(dev));
+    if (!qdev_realize_and_unref(dev, bus, &err)) {
+        object_unparent(OBJECT(dev));
+        object_unref(OBJECT(dev));
+        trace_usb4_host_usb_fallback(p, error_get_pretty(err));
+        error_free(err);
+        *retry = true;
+        return false;
+    }
+    return true;
+}
+
+/* usb-fallback=bot: QEMU's Bulk-Only usb-storage. */
+static DeviceState *usb4_host_bot_new(USB4Host *s, unsigned p,
+                                      DeviceState *x, const char *node,
+                                      const char *serial, bool *retry)
+{
+    Error *err = NULL;
+    DeviceState *dev = usb4_host_usb_dev_new(s, p, "usb-storage", serial,
+                                             &err);
+
+    if (!dev ||
+        !object_property_set_str(OBJECT(dev), "drive", node, &err) ||
+        !object_property_set_bool(OBJECT(dev), "share-rw", true, &err)) {
+        if (dev) {
+            object_unparent(OBJECT(dev));
+            object_unref(OBJECT(dev));
+        }
+        warn_reportf_err(err, "usb4-host: USB fallback device: ");
+        return NULL;
+    }
+    if (!usb4_host_usb_realize(dev, usb4_host_xhci_bus(OBJECT(x)), p,
+                               retry)) {
+        return NULL;
+    }
+    return dev;
+}
+
+/*
+ * R33, usb-fallback=uas: the disk behind the ORICO's UAS interface,
+ * SCSI identity as captured [obs] R1-D:1.633757 (vendor "ASMT",
+ * product "ASM246X", revision "0"), 1.636958 (write cache disabled),
+ * 1.663835-1.663993 (preferred minimum I/O 512 bytes, optimal transfer
+ * size 2097152 bytes). The capacity is the drive's.
+ */
+static bool usb4_host_uas_disk(DeviceState *uas, const char *node,
+                               Error **errp)
+{
+    DeviceState *hd = qdev_new("scsi-hd");
+    BusState *b, *sbus = NULL;
+
+    QLIST_FOREACH(b, &uas->child_bus, sibling) {
+        if (object_dynamic_cast(OBJECT(b), TYPE_SCSI_BUS)) {
+            sbus = b;
+        }
+    }
+    assert(sbus);
+    if (!object_property_set_str(OBJECT(hd), "drive", node, errp) ||
+        !object_property_set_bool(OBJECT(hd), "share-rw", true, errp) ||
+        !object_property_set_str(OBJECT(hd), "vendor", "ASMT", errp) ||
+        !object_property_set_str(OBJECT(hd), "product", "ASM246X", errp) ||
+        !object_property_set_str(OBJECT(hd), "ver", "0", errp) ||
+        !object_property_set_str(OBJECT(hd), "write-cache", "off", errp) ||
+        !object_property_set_uint(OBJECT(hd), "min_io_size", 512, errp) ||
+        !object_property_set_uint(OBJECT(hd), "opt_io_size", 2097152,
+                                  errp)) {
+        object_unparent(OBJECT(hd));
+        object_unref(OBJECT(hd));
+        return false;
+    }
+    /* on failure qdev_realize_and_unref() drops the last reference */
+    return qdev_realize_and_unref(hd, sbus, errp);
+}
+
+/*
+ * usb-fallback=uas: usb-uas with the captured identity and one scsi-hd.
+ * A usb-uas created after machine init does not attach by itself (QEMU
+ * waits for its SCSI devices); it is attached once the disk exists, in
+ * this same bottom half, so the guest never sees it without its disk.
+ */
+static DeviceState *usb4_host_uas_new(USB4Host *s, unsigned p,
+                                      DeviceState *x, const char *node,
+                                      const char *serial, bool *retry)
+{
+    Error *err = NULL;
+    DeviceState *dev = usb4_host_usb_dev_new(s, p, "usb-uas", serial, &err);
+
+    if (!dev) {
+        warn_reportf_err(err, "usb4-host: USB fallback device: ");
+        return NULL;
+    }
+    USB_DEVICE(dev)->usb_desc = usb4_host_uas_desc(USB_DEVICE(dev));
+    if (!usb4_host_usb_realize(dev, usb4_host_xhci_bus(OBJECT(x)), p,
+                               retry)) {
+        return NULL;
+    }
+    /* the name QEMU reports (info usb), from the device's own string */
+    pstrcpy(USB_DEVICE(dev)->product_desc,
+            sizeof(USB_DEVICE(dev)->product_desc), "ASM246X series");
+    if (!usb4_host_uas_disk(dev, node, &err)) {
+        usb4_host_usb_drop(dev);
+        trace_usb4_host_usb_fallback(p, error_get_pretty(err));
+        error_free(err);
+        *retry = true;
+        return NULL;
+    }
+    if (!USB_DEVICE(dev)->attached &&
+        !object_property_set_bool(OBJECT(dev), "attached", true, &err)) {
+        usb4_host_usb_drop(dev);
+        warn_reportf_err(err, "usb4-host: USB fallback device: ");
+        return NULL;
+    }
+    return dev;
+}
+
+static void usb4_host_usb_remove(USB4Host *s, unsigned p)
+{
+    DeviceState *dev = s->usb_dev[p];
+
+    s->usb_dev[p] = NULL;
+    trace_usb4_host_usb_fallback(p, "USB device removed");
+    usb4_host_usb_drop(dev);
+}
+
+/*
+ * Create the USB device of port @p. True if it should be tried again
+ * later: the NVMe endpoint of a tunnel that just went down (a machine
+ * reset with pre-boot off, an unplug race) still holds the drive. The
+ * tunnel's access gate is already closed then; its endpoint is removed
+ * from a bottom half and released after RCU, so the handoff waits for
+ * that instead of competing for write permission.
+ */
+static bool usb4_host_usb_create(USB4Host *s, unsigned p)
+{
+    USB4Device *d = s->port_dev[p];
+    const char *drive = usb4_device_nvme_drive(d);
+    const char *serial = usb4_device_nvme_serial(d);
+    DeviceState *x = usb4_host_xhci(s), *dev;
+    BlockBackend *blk;
+    bool retry = false;
+
+    if (!x) {
+        trace_usb4_host_usb_fallback(p, "no xhci: the device is unusable");
+        return false;
+    }
+    if (!drive || !*drive) {
+        trace_usb4_host_usb_fallback(p, "no drive: nothing on the xhci");
+        return false;
+    }
+    blk = blk_by_name(drive);
+    if (blk && blk_get_attached_dev(blk)) {
+        trace_usb4_host_usb_fallback(p, "drive still held, retry");
+        return true;
+    }
+    if (blk && blk_bs(blk)) {
+        drive = bdrv_get_node_name(blk_bs(blk));
+    }
+    dev = s->usb_uas ? usb4_host_uas_new(s, p, x, drive, serial, &retry)
+                     : usb4_host_bot_new(s, p, x, drive, serial, &retry);
+    if (!dev) {
+        return retry;
+    }
+    s->usb_dev[p] = dev;
+    trace_usb4_host_usb_fallback(p, "USB device on the xhci");
+    return false;
+}
+
+/*
+ * R30, R33 at machine power-on, BIOS Assist: the firmware shows the
+ * function that matches the attached link (ICM-PROTOCOL.md 12.3, 13.1).
+ * A Thunderbolt link (or none): the NHI, the xHCI hidden. A USB4 device
+ * that fell back to USB during POST: the xHCI, which the BIOS had left
+ * without resources because it saw the NHI when it enumerated, and the
+ * NHI hidden for the whole session (R3: no Thunderbolt traffic through
+ * every replug). Without Assist both are always visible.
+ */
+static void usb4_host_assist_functions(USB4Host *s)
+{
+    bool usb = false;
+
+    for (unsigned p = 1; p <= s->num_ports; p++) {
+        usb |= s->port_dev[p] && usb4_fabric_port_usb_mode(s->fabric, p);
+    }
+    s->nhi_hidden = s->bios_assist && usb;
+    if (s->nhi_hidden) {
+        trace_usb4_host_power_state("hidden: USB4 device in USB mode under "
+                                    "BIOS Assist");
+    }
+    usb4_tb3_xhci_set_mode(usb4_host_xhci(s),
+                           !s->bios_assist ? USB4_XHCI_NORMAL :
+                           usb ? USB4_XHCI_NO_RESOURCES : USB4_XHCI_HIDDEN);
+}
+
+#define USB4_USB_RETRY_MS    100
+#define USB4_USB_RETRIES     100     /* 10 s */
+
+/*
+ * Bring the USB side of every port in line with the fabric (R33). Every
+ * attempt, including a retry, re-reads the port's device and mode, so a
+ * retry never acts on a device that has since left or changed mode.
+ */
+static void usb4_host_usb_reconcile(USB4Host *s)
+{
+    bool retry = false;
+
+    for (unsigned p = 1; p <= s->num_ports; p++) {
+        bool want = s->port_dev[p] &&
+                    usb4_fabric_port_usb_mode(s->fabric, p);
+
+        if (s->usb_dev[p] && !want) {
+            usb4_host_usb_remove(s, p);
+        }
+        if (!want) {
+            s->usb_tries[p] = 0;
+            continue;
+        }
+        if (s->usb_dev[p] || !usb4_host_usb_create(s, p)) {
+            s->usb_tries[p] = 0;
+        } else if (++s->usb_tries[p] < USB4_USB_RETRIES) {
+            retry = true;
+        } else if (s->usb_tries[p] == USB4_USB_RETRIES) {
+            warn_report("usb4-host: USB4 port %u: drive %s stays in use, no "
+                        "USB fallback device", p,
+                        usb4_device_nvme_drive(s->port_dev[p]));
+        }
+    }
+    if (retry) {
+        timer_mod(s->usb_retry, qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) +
+                                USB4_USB_RETRY_MS);
+    }
+}
+
+/*
+ * The retry timer only schedules the bottom half: device creation and
+ * removal never run on a timer stack (AGENTS.md); the bottom half
+ * re-reads the port's device and mode.
+ */
+static void usb4_host_usb_retry(void *opaque)
+{
+    USB4Host *s = opaque;
+
+    if (s->usb_bh) {
+        qemu_bh_schedule(s->usb_bh);
+    }
+}
+
+static void usb4_host_usb_bh(void *opaque)
+{
+    usb4_host_usb_reconcile(opaque);
+}
+
+/* Never from MMIO or reset context directly: a bottom half (AGENTS.md). */
+void usb4_host_usb_mode_changed(USB4Host *h)
+{
+    if (h && h->usb_bh) {
+        qemu_bh_schedule(h->usb_bh);
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* Controller power, tb3-alpine-ridge (ICM-PROTOCOL.md 12.2, R27, R28)   */
+/* ------------------------------------------------------------------ */
+
+/*
+ * The power domain is the secondary bus of the bridge on the root bus
+ * above the usb4-host: the PCH root port (q35) or root bridge (i440FX)
+ * with the controller's PCIe switch behind it (TOPOLOGY=switch). With
+ * the host on the root bus there is no domain and the controller is
+ * always powered.
+ */
+static PCIDevice *usb4_host_power_port(USB4Host *s)
+{
+    PCIBus *b = pci_get_bus(PCI_DEVICE(s));
+    PCIDevice *top = NULL;
+
+    while (!pci_bus_is_root(b)) {
+        top = b->parent_dev;
+        b = pci_get_bus(top);
+    }
+    return top;
+}
+
+/*
+ * What the Windows 98 BIOS matrix shows (ICM-PROTOCOL.md 12.2, README
+ * of tests/captures/p14s-gen1): with BIOS Assist on and nothing
+ * attached the whole controller is powered down; with Assist off it
+ * stays powered. Force power (R28) and an attached device power it.
+ */
+static bool usb4_host_power_wanted(USB4Host *s)
+{
+    if (!s->power_auto || s->force_power) {
+        return true;
+    }
+    for (unsigned p = 1; p <= s->num_ports; p++) {
+        if (s->port_dev[p]) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static void usb4_host_presence(USB4Host *s, bool notify)
+{
+    PCIDevice *rp = usb4_host_power_port(s);
+
+    if (rp && pci_is_express(rp) && rp->exp.exp_cap &&
+        (pci_get_word(rp->config + rp->exp.exp_cap + PCI_EXP_FLAGS) &
+         PCI_EXP_FLAGS_SLOT)) {
+        pcie_cap_slot_set_presence(rp, s->powered, notify);
+    }
+}
+
+/* Presence after the port's own reset has recomputed it. */
+static void usb4_host_presence_bh(void *opaque)
+{
+    usb4_host_presence(opaque, false);
+}
+
+/*
+ * The root port (or root bridge) must be a gated tunnel bridge
+ * (usb4-tunnel-port on q35, usb4-tunnel-bridge on i440FX): its access
+ * gate covers config, INTx, the windows and DMA/MSI of everything below
+ * (review 2 #2), and its slot removes the controller from a bottom half.
+ */
+static USB4TunnelPort *usb4_host_power_domain(USB4Host *s)
+{
+    PCIDevice *rp = usb4_host_power_port(s);
+
+    if (!rp || !object_dynamic_cast(OBJECT(rp), "usb4-tunnel-target")) {
+        return NULL;
+    }
+    return (USB4TunnelPort *)rp;
+}
+
+static void usb4_host_gate(USB4Host *s)
+{
+    USB4TunnelPort *dom = usb4_host_power_domain(s);
+
+    trace_usb4_host_power(s->powered, s->force_power);
+    if (dom) {
+        usb4_tunnel_port_power_domain(dom, s->powered);
+    }
+}
+
+static void usb4_host_power_on_bh(void *opaque)
+{
+    USB4Host *s = opaque;
+    PCIDevice *rp = usb4_host_power_port(s);
+
+    if (s->powered || !usb4_host_power_wanted(s) ||
+        !usb4_host_power_domain(s)) {
+        return;
+    }
+    /*
+     * Power-up: every function below the root port starts from reset,
+     * with the domain still gated; it opens once the reset is complete.
+     */
+    s->power_cycle = true;
+    bus_cold_reset(BUS(pci_bridge_get_sec_bus(PCI_BRIDGE(rp))));
+    s->power_cycle = false;
+    s->powered = true;
+    usb4_host_gate(s);
+    /* Root port: presence and link up, hot-plug event to the guest. */
+    usb4_host_presence(s, true);
+}
+
+static void usb4_host_power_off_timer(void *opaque)
+{
+    USB4Host *s = opaque;
+
+    if (!s->powered || usb4_host_power_wanted(s)) {
+        return;
+    }
+    s->powered = false;
+    usb4_host_presence(s, true);
+    usb4_host_gate(s);
+}
+
+/* Re-evaluate after a plug, an unplug or a force power change. */
+static void usb4_host_power_eval(USB4Host *s)
+{
+    if (!s->power_on_bh) {
+        return;                 /* not the AR profile, or not realized */
+    }
+    if (usb4_host_power_wanted(s)) {
+        timer_del(s->power_off_timer);
+        usb4_icm_set_silent(s->icm, false);
+        if (!s->powered) {
+            qemu_bh_schedule(s->power_on_bh);
+        }
+    } else if (s->powered && !timer_pending(s->power_off_timer)) {
+        /*
+         * 35 s fits the dock (ICM-PROTOCOL.md 12.3); after the ORICO
+         * the controller read all-ones 10.4-11.4 s after the departure
+         * (13.4, R32): power-off-delay-usb4-ms when a USB4 device left
+         * last.
+         */
+        timer_mod(s->power_off_timer,
+                  qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) +
+                  (s->last_left_usb4 && s->power_off_delay_usb4_ms ?
+                   s->power_off_delay_usb4_ms : s->power_off_delay_ms));
+        /*
+         * R32: the firmware stops answering ICM commands from the last
+         * device's departure until the power-off (ICM-PROTOCOL.md 12.3,
+         * observed on Alpine Ridge; Titan Ridge follows it, inferred).
+         */
+        usb4_icm_set_silent(s->icm, s->assist_silence);
+    }
+}
+
+static bool usb4_host_get_force_power(Object *obj, Error **errp)
+{
+    return USB4_HOST(obj)->force_power;
+}
+
+static void usb4_host_set_force_power(Object *obj, bool v, Error **errp)
+{
+    USB4Host *s = USB4_HOST(obj);
+
+    s->force_power = v;
+    usb4_host_power_eval(s);
+}
+
+/* ------------------------------------------------------------------ */
+/* QOM                                                                  */
+/* ------------------------------------------------------------------ */
+
+static void usb4_host_realize(PCIDevice *pd, Error **errp)
+{
+    USB4Host *s = USB4_HOST(pd);
+    bool express = pci_bus_is_express(pci_get_bus(pd));
+    USB4FabricConfig cfg = { 0 };
+    USB4ICMConfig icfg = { 0 };
+    int ret;
+
+    if (!s->profile_str || !strcmp(s->profile_str, "usb4-generic")) {
+        s->profile = USB4_PROFILE_USB4_GENERIC;
+    } else if (!strcmp(s->profile_str, "tb3-alpine-ridge")) {
+        s->profile = USB4_PROFILE_TB3_ALPINE_RIDGE;
+        s->tb3_host = USB4_TB3_HOST_AR_LP;
+    } else if (!strcmp(s->profile_str, "tb3-titan-ridge")) {
+        /*
+         * Titan Ridge (docs/ICM-TITAN-RIDGE.md): 4C with two ports by
+         * default, 2C with ports=1. This name was a deprecated alias of
+         * tb3-alpine-ridge until the Titan Ridge variant existed.
+         */
+        s->profile = USB4_PROFILE_TB3_ALPINE_RIDGE;
+        if (s->num_ports != 1 && s->num_ports != 2) {
+            error_setg(errp, "usb4-host: tb3-titan-ridge has ports=1 (2C) "
+                       "or ports=2 (4C)");
+            return;
+        }
+        s->tb3_host = s->num_ports == 1 ? USB4_TB3_HOST_TR_2C
+                                        : USB4_TB3_HOST_TR_4C;
+    } else {
+        error_setg(errp, "usb4-host: unknown profile '%s' (use usb4-generic"
+                   ", tb3-alpine-ridge or tb3-titan-ridge)", s->profile_str);
+        return;
+    }
+    s->paths = s->profile == USB4_PROFILE_TB3_ALPINE_RIDGE ? TB3_AR_PATHS
+                                                           : USB4_HI_PATHS;
+    /* docs/USB4-HOSTS.md: host router preset of the generic profile */
+    if (!s->host_model_str || !strcmp(s->host_model_str, "minimal")) {
+        s->host_model = USB4_HOST_MODEL_MINIMAL;
+    } else if (!strcmp(s->host_model_str, "intel-adl") &&
+               s->profile == USB4_PROFILE_USB4_GENERIC) {
+        s->host_model = USB4_HOST_MODEL_INTEL_ADL;
+        /*
+         * Captured: 12 rings (HOST_CAPS 0x0000000c in the NHI BAR0
+         * dump), matching Max HopID 11 of the host interface adapter.
+         */
+        s->paths = 12;
+        s->num_ports = 2;
+    } else if (!strcmp(s->host_model_str, "asm4242") &&
+               s->profile == USB4_PROFILE_USB4_GENERIC) {
+        /* docs/USB4-HOSTS.md 5: two USB4 ports ([vendor]) */
+        s->host_model = USB4_HOST_MODEL_ASM4242;
+        s->num_ports = 2;
+        if (!usb4_asm_config_check(&s->asm_cfg, errp)) {
+            return;
+        }
+    } else if (!strcmp(s->host_model_str, "amd") &&
+               s->profile == USB4_PROFILE_USB4_GENERIC) {
+        /* docs/USB4-HOSTS.md 7: minimal layout, AMD router identity */
+        s->host_model = USB4_HOST_MODEL_AMD;
+        if (s->host_domain >= AMD_ROUTER_DEVICES) {
+            error_setg(errp, "usb4-host: host-model=amd needs host-domain "
+                       "0..%d", AMD_ROUTER_DEVICES - 1);
+            return;
+        }
+    } else {
+        error_setg(errp, "usb4-host: host-model must be minimal, intel-adl, "
+                   "asm4242 or amd (usb4-generic profile only)");
+        return;
+    }
+    /*
+     * C1: auto follows the captured Intel hosts (TB3 and intel-adl).
+     * minimal and asm4242 store writes: no ASM4242 capture or public
+     * source documents its throttle registers (docs/USB4-HOSTS.md 5).
+     */
+    s->itr_fixed = s->itr_fixed_prop == ON_OFF_AUTO_ON ||
+                   (s->itr_fixed_prop == ON_OFF_AUTO_AUTO &&
+                    (s->profile == USB4_PROFILE_TB3_ALPINE_RIDGE ||
+                     s->host_model == USB4_HOST_MODEL_INTEL_ADL));
+    /*
+     * ADL-8 is intel-adl behaviour: refused on minimal and asm4242, and
+     * on the TB3 profiles, where R7 auto-clear is always on and the
+     * property would otherwise be silently ignored.
+     */
+    if (s->intel_autoclear && (s->profile != USB4_PROFILE_USB4_GENERIC ||
+                               s->host_model != USB4_HOST_MODEL_INTEL_ADL)) {
+        error_setg(errp, "usb4-host: intel-autoclear needs "
+                   "profile=usb4-generic and host-model=intel-adl");
+        return;
+    }
+    /*
+     * R33: the USB side of the fallback, UAS as captured (R1-D:1.631
+     * "scsi host0: uas") on every machine type (xhci98 has a UAS driver
+     * for Windows 98 to 7), or Bulk-Only on request for guests without
+     * one. Only the TB3 firmware CM profiles fall back to USB.
+     */
+    if (!s->usb_fallback_str || !strcmp(s->usb_fallback_str, "uas")) {
+        s->usb_uas = true;
+    } else if (!strcmp(s->usb_fallback_str, "bot")) {
+        s->usb_uas = false;
+    } else {
+        error_setg(errp, "usb4-host: usb-fallback must be uas or bot");
+        return;
+    }
+    if (s->usb_fallback_str && s->profile != USB4_PROFILE_TB3_ALPINE_RIDGE) {
+        error_setg(errp, "usb4-host: usb-fallback needs a TB3 profile");
+        return;
+    }
+    if (s->profile == USB4_PROFILE_TB3_ALPINE_RIDGE) {
+        if (!s->security_str || !strcmp(s->security_str, "user")) {
+            icfg.security = 1;
+        } else if (!strcmp(s->security_str, "none")) {
+            icfg.security = 0;
+        } else {
+            error_setg(errp, "usb4-host: security must be none or user");
+            return;
+        }
+        icfg.rtd3 = s->rtd3;
+        icfg.bios_assist = s->bios_assist;
+        icfg.dialect = usb4_tb3_ids[s->tb3_host].dialect;
+        icfg.device_id = usb4_tb3_ids[s->tb3_host].nhi_device;
+        icfg.nvm_version = usb4_tb3_ids[s->tb3_host].nvm_version;
+        icfg.boot_acl_slots = 16;
+        icfg.preboot = s->preboot;
+        icfg.preboot_acl_only = s->preboot_acl_only;
+        icfg.usb_fallback_ms = s->usb_fallback_ms;
+        /* R33: the TB xHCI; a forward reference is checked at init done */
+        if (!usb4_host_xhci_check(s, DEVICE(s)->hotplugged, errp)) {
+            return;
+        }
+        /*
+         * Observed first driver ready to host router answer: 2.77 s
+         * under BIOS Assist with the pre-boot ORICO (R4,
+         * ICM-PROTOCOL.md 13.5). Assist off, 0.13-0.80 s; the default
+         * keeps 0 there (immediate, as before), and on Titan Ridge,
+         * which is not captured.
+         */
+        icfg.first_ready_hold_ms = s->first_ready_hold_ms >= 0 ?
+                                   s->first_ready_hold_ms :
+                                   s->bios_assist &&
+                                   s->tb3_host == USB4_TB3_HOST_AR_LP ?
+                                   2770 : 0;
+        icfg.ready_hold_ms = s->ready_hold_ms;
+        icfg.approve_link_ms = s->approve_link_ms;
+        icfg.approve_resp_ms = s->approve_resp_ms;
+        if (!usb4_icm_parse_boot_acl(s->boot_acl, icfg.boot_acl, errp)) {
+            return;
+        }
+        /*
+         * Alpine Ridge LP: one Thunderbolt port (ICM-PROTOCOL.md 1);
+         * Titan Ridge 2C one, 4C two (ICM-TITAN-RIDGE.md 1).
+         */
+        s->num_ports = s->tb3_host == USB4_TB3_HOST_TR_4C ? 2 : 1;
+        /* R27: power follows BIOS Assist unless power=always */
+        if (!s->power_str || !strcmp(s->power_str, "auto")) {
+            s->power_auto = s->bios_assist;
+        } else if (!strcmp(s->power_str, "always")) {
+            s->power_auto = false;
+        } else {
+            error_setg(errp, "usb4-host: power must be auto or always");
+            return;
+        }
+    }
+    if (s->num_ports < 1 || s->num_ports > USB4_HI_MAX_PORTS) {
+        error_setg(errp, "usb4-host: ports must be 1..%d",
+                   USB4_HI_MAX_PORTS);
+        return;
+    }
+
+    /* Identity (docs/ARCHITECTURE.md section 2, Spec 12.6 class code). */
+    if (s->profile == USB4_PROFILE_TB3_ALPINE_RIDGE) {
+        /* R1, ICM-PROTOCOL.md 1 */
+        pci_config_set_vendor_id(pd->config, PCI_VENDOR_ID_INTEL);
+        pci_config_set_device_id(pd->config,
+                                 usb4_tb3_ids[s->tb3_host].nhi_device);
+        pci_config_set_class(pd->config, TB3_AR_CLASS);
+        pci_config_set_prog_interface(pd->config, 0);
+        pci_set_word(pd->config + PCI_SUBSYSTEM_VENDOR_ID,
+                     TB3_AR_SUBSYS_VENDOR);
+        pci_set_word(pd->config + PCI_SUBSYSTEM_ID, TB3_AR_SUBSYS_DEVICE);
+    } else if (s->host_model == USB4_HOST_MODEL_ASM4242) {
+        pci_config_set_vendor_id(pd->config, ASM_VENDOR);
+        pci_config_set_device_id(pd->config, ASM_NHI_DEVICE);
+        pci_config_set_class(pd->config, PCI_CLASS_SERIAL_USB4);
+        pci_config_set_prog_interface(pd->config, PCI_PROGIF_USB4);
+        pci_set_word(pd->config + PCI_SUBSYSTEM_VENDOR_ID, ASM_VENDOR);
+        pci_set_word(pd->config + PCI_SUBSYSTEM_ID, ASM_NHI_DEVICE);
+    } else {
+        pci_config_set_vendor_id(pd->config, PCI_VENDOR_ID_REDHAT);
+        pci_config_set_device_id(pd->config, PCI_DEVICE_ID_REDHAT_USB4_HOST);
+        pci_config_set_class(pd->config, PCI_CLASS_SERIAL_USB4);
+        pci_config_set_prog_interface(pd->config, PCI_PROGIF_USB4);
+    }
+    pci_config_set_revision(pd->config,
+                            s->profile == USB4_PROFILE_TB3_ALPINE_RIDGE ?
+                            usb4_tb3_ids[s->tb3_host].revision : 1);
+    /*
+     * INTA#. asm4242: INTx support of the real function is [unk]
+     * (AM5-USB4.md 8); kept by default for legacy guests, intx=off
+     * removes it so a driver has to work by polling or MSI.
+     */
+    pd->config[PCI_INTERRUPT_PIN] = s->intx_on ? 1 : 0;
+    pd->config[PCI_CACHE_LINE_SIZE] = 0x10;
+
+    /* BAR0: 32-bit non-prefetchable, registers then MSI-X table/PBA. */
+    memory_region_init(&s->bar, OBJECT(s), "usb4-host-bar0",
+                       USB4_HI_BAR_SIZE);
+    memory_region_init_io(&s->regs, OBJECT(s), &usb4_host_mmio_ops, s,
+                          "usb4-host-regs", USB4_HI_REGS_SIZE);
+    memory_region_add_subregion(&s->bar, 0, &s->regs);
+    pci_register_bar(pd, 0, PCI_BASE_ADDRESS_SPACE_MEMORY, &s->bar);
+
+    if (pci_pm_init(pd, 0x80, errp) < 0) {
+        return;
+    }
+    if (s->profile == USB4_PROFILE_TB3_ALPINE_RIDGE) {
+        /*
+         * The captured NHI enters D3 by runtime suspend (lspci "Status:
+         * D3", ICM-PROTOCOL.md 6.5), which the outbound mailbox reflects
+         * (R2, 13.5): PMCSR PowerState is writable (PCI PM 1.2 3.2.4).
+         */
+        pci_set_word(pd->wmask + pd->pm_cap + PCI_PM_CTRL,
+                     PCI_PM_CTRL_STATE_MASK);
+    }
+    if (s->msi_on) {
+        /* Spec 12.5.3: MSI mode uses a single vector. */
+        Error *err = NULL;
+
+        ret = msi_init(pd, 0x88, 1, true, false, &err);
+        if (ret == -ENOTSUP) {
+            /* Board without working MSI: INTx only. */
+            error_free(err);
+        } else if (ret < 0) {
+            error_propagate(errp, err);
+            return;
+        }
+    }
+    if (s->msix_on && s->profile == USB4_PROFILE_TB3_ALPINE_RIDGE) {
+        /* R1/R7: 16 vectors in a 4 KiB BAR1, PBA at 0xfa0 */
+        memory_region_init(&s->bar1, OBJECT(s), "usb4-host-msix",
+                           TB3_AR_BAR1_SIZE);
+        pci_register_bar(pd, 1, PCI_BASE_ADDRESS_SPACE_MEMORY, &s->bar1);
+        ret = msix_init(pd, USB4_HI_MSIX_VECTORS,
+                        &s->bar1, 1, 0,
+                        &s->bar1, 1, TB3_AR_MSIX_PBA, 0xa0, errp);
+        if (ret < 0) {
+            return;
+        }
+        for (int i = 0; i < USB4_HI_MSIX_VECTORS; i++) {
+            msix_vector_use(pd, i);
+        }
+    } else if (s->msix_on) {
+        ret = msix_init(pd, USB4_HI_MSIX_VECTORS,
+                        &s->bar, 0, USB4_HI_MSIX_TABLE,
+                        &s->bar, 0, USB4_HI_MSIX_PBA, 0xa0, errp);
+        if (ret < 0) {
+            return;
+        }
+        for (int i = 0; i < USB4_HI_MSIX_VECTORS; i++) {
+            msix_vector_use(pd, i);
+        }
+    }
+    if (express && s->profile == USB4_PROFILE_TB3_ALPINE_RIDGE) {
+        /* R1: PCIe endpoint capability at 0xc0, no USB4 DVSEC */
+        ret = pcie_endpoint_cap_init(pd, 0xc0);
+        if (ret < 0) {
+            error_setg(errp, "usb4-host: PCIe capability init failed");
+            return;
+        }
+    } else if (express) {
+        ret = pcie_endpoint_cap_init(pd, 0xb0);
+        if (ret < 0) {
+            error_setg(errp, "usb4-host: PCIe capability init failed");
+            return;
+        }
+        /*
+         * USB4 DVSEC Spec 1.0 section 2: a DVSEC implementer also
+         * implements the Device Serial Number capability.
+         */
+        pcie_dev_ser_num_init(pd, USB4_DSN_OFFSET,
+                              ldq_be_p(s->uuid.data));
+        /* USB4 DVSEC section 3 and 4: NHI port type, instance 0. */
+        pcie_add_capability(pd, PCI_EXT_CAP_ID_DVSEC, 1, USB4_DVSEC_OFFSET,
+                            USB4_DVSEC_LEN);
+        pci_set_long(pd->config + USB4_DVSEC_OFFSET + 4,
+                     USB4_DVSEC_VENDOR_USBIF | (0u << 16) |
+                     ((uint32_t)USB4_DVSEC_LEN << 20));
+        pci_set_long(pd->config + USB4_DVSEC_OFFSET + 8,
+                     USB4_DVSEC_ID_USBIF |
+                     ((uint32_t)USB4_DVSEC_PORT_NHI << 16));
+        pci_set_long(pd->config + USB4_DVSEC_OFFSET + 12, 0);
+    }
+
+    g_queue_init(&s->rx_fifo);
+
+    /* The usb4 bus for device routers, named "<id>.0". */
+    s->bus = qbus_new(TYPE_USB4_BUS, DEVICE(s), NULL);
+    qbus_set_hotplug_handler(s->bus, OBJECT(s));
+
+    cfg.profile = s->profile;
+    cfg.dialect = s->profile == USB4_PROFILE_TB3_ALPINE_RIDGE ?
+                  USB4_DIALECT_TB3 : USB4_DIALECT_USB4;
+    if (s->profile == USB4_PROFILE_TB3_ALPINE_RIDGE) {
+        cfg.router_vendor_id = TB3_AR_ROUTER_VENDOR;
+        cfg.router_device_id = usb4_tb3_ids[s->tb3_host].router_device;
+        cfg.tb3_host = s->tb3_host;
+    } else if (s->host_model == USB4_HOST_MODEL_ASM4242) {
+        cfg.router_vendor_id = ASM_ROUTER_VENDOR;
+        cfg.router_device_id = ASM_ROUTER_DEVICE;
+    } else if (s->host_model == USB4_HOST_MODEL_AMD) {
+        cfg.router_vendor_id = AMD_ROUTER_VENDOR;
+        cfg.router_device_id = AMD_ROUTER_DEVICE + s->host_domain;
+    } else {
+        cfg.router_vendor_id = USB4_GENERIC_ROUTER_VENDOR;
+        cfg.router_device_id = USB4_GENERIC_ROUTER_DEVICE;
+    }
+    cfg.num_usb4_ports = s->num_ports;
+    cfg.uuid = s->uuid;
+    {
+        /*
+         * host_salt: FNV-1a of the canonical QOM path (stable for the same
+         * command line, distinct per host) and host-domain. The host UUID
+         * would not do: it is random per run unless given.
+         */
+        g_autofree char *path = object_get_canonical_path(OBJECT(s));
+        uint64_t h = 0xcbf29ce484222325ULL;
+
+        for (const char *p = path; p && *p; p++) {
+            h = (h ^ (uint8_t)*p) * 0x100000001b3ULL;
+        }
+        cfg.host_salt = (h ^ s->host_domain) * 0x100000001b3ULL;
+    }
+    cfg.host_model = s->host_model;
+    cfg.host_domain = s->host_domain;
+    cfg.asm4242 = s->asm_cfg;
+    cfg.preos_cm = s->preos_cm && s->profile == USB4_PROFILE_USB4_GENERIC;
+    s->fabric = usb4_fabric_new(s, &cfg);
+    if (!s->fabric) {
+        warn_report_once("usb4-host: no fabric available (stub build); "
+                         "ring 0 frames will be dropped");
+        trace_usb4_host_no_fabric("usb4_fabric_new returned NULL");
+    }
+    if (s->profile == USB4_PROFILE_TB3_ALPINE_RIDGE) {
+        /* ARCHITECTURE.md 4.2b: the emulated firmware CM owns the fabric */
+        s->icm = usb4_icm_new(s->fabric, &icfg);
+        s->usb_bh = qemu_bh_new(usb4_host_usb_bh, s);
+        s->usb_retry = timer_new_ms(QEMU_CLOCK_VIRTUAL, usb4_host_usb_retry,
+                                    s);
+        s->powered = true;
+        s->power_on_bh = qemu_bh_new(usb4_host_power_on_bh, s);
+        s->presence_bh = qemu_bh_new(usb4_host_presence_bh, s);
+        s->power_off_timer = timer_new_ms(QEMU_CLOCK_VIRTUAL,
+                                          usb4_host_power_off_timer, s);
+        if (s->power_auto && !usb4_host_power_domain(s)) {
+            warn_report("usb4-host: bios-assist power-down needs the "
+                        "controller's switch behind a usb4-tunnel-port "
+                        "(q35) or usb4-tunnel-bridge (i440FX); it stays "
+                        "powered");
+            s->power_auto = false;
+        }
+    }
+
+    if (s->xhci_id && !DEVICE(s)->hotplugged) {
+        s->machine_done.notify = usb4_host_machine_done;
+        qemu_add_machine_init_done_notifier(&s->machine_done);
+    }
+    if (s->icm || cfg.preos_cm) {
+        /* A firmware CM (ICM or preos-cm) builds tunnels during reset. */
+        s->post_reset.notify = usb4_host_reconcile_tunnels;
+        qemu_add_post_reset_notifier(&s->post_reset);
+        s->post_reset_on = true;
+    }
+    if (msix_present(pd)) {
+        /* Pending-vector delivery on unmask: Intel auto-clear (R7). */
+        msix_set_vector_notifiers(pd, usb4_host_msix_use,
+                                  usb4_host_msix_release, NULL);
+    }
+    trace_usb4_host_realize(usb4_profile_name(s), s->num_ports,
+                            s->paths, express,
+                            msi_present(pd), msix_present(pd));
+}
+
+static void usb4_host_exit(PCIDevice *pd)
+{
+    USB4Host *s = USB4_HOST(pd);
+
+    usb4_host_rx_fifo_clear(s);
+    usb4_icm_free(s->icm);
+    s->icm = NULL;
+    if (s->usb_bh) {
+        qemu_bh_delete(s->usb_bh);
+        s->usb_bh = NULL;
+        timer_free(s->usb_retry);
+        s->usb_retry = NULL;
+    }
+    if (s->machine_done.notify) {
+        qemu_remove_machine_init_done_notifier(&s->machine_done);
+        s->machine_done.notify = NULL;
+    }
+    for (unsigned p = 1; p <= USB4_HI_MAX_PORTS; p++) {
+        if (s->usb_dev[p]) {
+            usb4_host_usb_remove(s, p);
+        }
+    }
+    if (s->post_reset_on) {
+        qemu_remove_post_reset_notifier(&s->post_reset);
+        s->post_reset_on = false;
+    }
+    if (s->power_on_bh) {
+        qemu_bh_delete(s->power_on_bh);
+        qemu_bh_delete(s->presence_bh);
+        timer_free(s->power_off_timer);
+        s->power_on_bh = NULL;
+    }
+    if (s->fabric) {
+        usb4_fabric_free(s->fabric);
+        s->fabric = NULL;
+    }
+    if (msix_present(pd)) {
+        MemoryRegion *mb = s->profile == USB4_PROFILE_TB3_ALPINE_RIDGE ?
+                           &s->bar1 : &s->bar;
+
+        msix_unset_vector_notifiers(pd);
+        msix_unuse_all_vectors(pd);
+        msix_uninit(pd, mb, mb);
+    }
+    msi_uninit(pd);
+}
