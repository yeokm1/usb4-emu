+/* Router config read of route 0, dword 0 (the client's host poll, 4.1) */
+static void host_poll_send(T *t)
+{
+    uint32_t f[3] = { 0, 0, 0 | (1u << 13) | (2u << 25) };
+
+    tx_frame(t, 1, f, 3);
+}
