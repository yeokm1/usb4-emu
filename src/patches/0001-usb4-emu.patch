+/*
+ * Malformed and out-of-range numeric rule fields are rejected cleanly
+ * (no double error), the rules in force stay intact and keep working.
+ */
+static void test_bad_rules(void)
+{
+    static const char *const bad[] = {
+        "at=fetch op=read nth=abc act=none",
+        "at=fetch op=read nth=99999999999 act=none",
+        "at=fetch op=read nth=0 act=none",
+        "at=fetch op=read nth= act=none",
+        "at=fetch sq=abc act=none",
+        "at=fetch sq=70000 act=none",
+        "at=fetch sq=1 op=999 act=none",
+        "at=fetch nsid=0x100000000 act=none",
+        "at=fetch lba= act=none",
+        "at=fetch lba=5- act=none",
+        "at=fetch lba=9-3 act=none",
+        "at=stage code=x act=none",
+        "at=fetch op=read act=hold delay=99999999999",
+        "at=complete op=read status=0x8000",
+        "at=complete op=read dw0=0x100000000",
+        "at=stage act=arm",
+        "at=fetch op=read act=reset-controller",
+    };
+    static const char *const bad_range[] = {
+        "abc", "5-", "-5", "0-3", "4-2", "99999999999",
+    };
+    g_autofree char *img = make_img();
+    g_autofree char *before = NULL, *after = NULL;
+    Nv nv;
+    QTestState *qts = tp_start(img, ",x-faults=\"at=stage code=5 act=none\","
+                               "x-intx-drop-range=3-4",
+                               "-device usb4-debug-port", &nv);
+
+    before = qom_get_str(qts, TP_PATH, "x-faults");
+    for (int i = 0; i < ARRAY_SIZE(bad); i++) {
+        g_autofree char *e = qom_set_err(qts, TP_PATH, "x-faults", bad[i]);
+
+        g_assert(strstr(e, "x-faults"));
+        after = qom_get_str(qts, TP_PATH, "x-faults");
+        g_assert_cmpstr(after, ==, before);
+        g_free(after);
+        after = NULL;
+    }
+    for (int i = 0; i < ARRAY_SIZE(bad_range); i++) {
+        g_autofree char *e = qom_set_err(qts, TP_PATH, "x-intx-drop-range",
+                                         bad_range[i]);
+        g_autofree char *r = qom_get_str(qts, TP_PATH, "x-intx-drop-range");
+
+        g_assert(strstr(e, "x-intx-drop-range"));
+        g_assert_cmpstr(r, ==, "3-4");
+    }
+    /* The rule in force still fires. */
+    qtest_outl(qts, DBG_PORT, 5);
+    g_assert(str_has(qts, TP_PATH, "x-harness-state", "rule0=1/1"));
+    qtest_quit(qts);
+    unlink(img);
+}
