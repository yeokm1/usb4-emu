+static void test_loopback(void)
+{
+    T *t = t_start("pc", NULL);
+
+    rings_setup(t, 8, 8);
+    rx_post(t, 4);
+    tx_queue(t, 0x11223344, 20, 1);
+    tx_doorbell(t);
+
+    /* TX completion: DD written back, consumer advanced (Spec 12.3.2.2) */
+    g_assert_cmphex(desc_dw2(t, t->tx_ring, 0) & DESC_DD, ==, DESC_DD);
+    g_assert_cmpuint(tx_ci(t), ==, 1);
+    /* RX completion */
+    g_assert_cmpuint(rx_pi(t), ==, 1);
+    rx_expect(t, 0x11223344, 20, 1);
+    /* Both causes pending; default auto-clear read clears them */
+    g_assert_cmphex(isr0(t), ==, CAUSE_TX0 | CAUSE_RX0);
+    g_assert_cmphex(isr0(t), ==, 0);
+    t_stop(t);
+}
