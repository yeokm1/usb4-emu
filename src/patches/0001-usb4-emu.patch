+/* A tb3-alpine-ridge host with BIOS Assist exists (PCI0._OSC grants). */
+bool usb4_acpi_tb3_assist_present(void);
+
+/*
+ * Append the _DSD of a tunneled PCIe root or switch downstream port to
+ * its device scope: usb4-host-interface / usb4-port-number (when the
+ * usb4-host has an ACPI node, on the root bus or behind cold-plugged
+ * bridges), HotPlugSupportInD3 and ExternalFacingPort.
+ */
+void usb4_acpi_build_tunnel_port_dsd(Aml *scope, PCIDevice *port,
+                                     uint32_t usb4_port, bool hp_d3,
+                                     bool external_facing);
