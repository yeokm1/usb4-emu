+/* ---- usb4-device daisy-chain lifecycle ---- */
+
+static QTestState *chain_start(const char *extra)
+{
+    return qtest_initf("-machine q35 "
+                       "-device usb4-host,id=u4,bus=pcie.0,addr=0x4 "
+                       "-device usb4-device,id=A,bus=u4.0,port=2,"
+                       "serial=A,downstream-ports=1 "
+                       "-device usb4-device,id=B,bus=u4.0,parent=A,port=1,"
+                       "serial=B,downstream-ports=1 %s", extra);
+}
+
+/* Re-adding a deleted router below its own orphan is refused. */
+static void test_chain_cycle(void)
+{
+    QTestState *qts = chain_start("");
+    QDict *rsp;
+
+    dev_del(qts, "A");
+    rsp = qtest_qmp(qts, "{'execute': 'device_add', 'arguments': "
+                    "{'driver': 'usb4-device', 'id': 'A', 'bus': 'u4.0', "
+                    "'parent': 'B', 'port': 1, 'downstream-ports': 1}}");
+    g_assert(qdict_haskey(rsp, "error"));
+    qobject_unref(rsp);
+    /* Still alive, and A can come back where it was. */
+    qtest_qmp_assert_success(qts, "{'execute': 'device_add', 'arguments': "
+                             "{'driver': 'usb4-device', 'id': 'A', "
+                             "'bus': 'u4.0', 'port': 2, "
+                             "'downstream-ports': 1}}");
+    qtest_quit(qts);
+}
+
+static bool dev_attached(QTestState *qts, const char *id)
+{
+    g_autofree char *path = g_strdup_printf("/machine/peripheral/%s", id);
+    QDict *rsp = qtest_qmp(qts, "{'execute': 'qom-get', 'arguments': "
+                           "{'path': %s, 'property': 'x-attached'}}", path);
+    bool on = qdict_get_bool(rsp, "return");
+
+    qobject_unref(rsp);
+    return on;
+}
+
+/*
+ * A failed re-add of an orphan's parent must not leave the orphan bound
+ * to the freed object: once there is room again, a successful re-add
+ * adopts and plugs it.
+ */
+static void test_chain_failed_adopt(void)
+{
+    GString *s = g_string_new("");
+    QTestState *qts;
+    QDict *rsp;
+    int i;
+
+    /* Port 1: X, X1..X3, Y1..Y9 below them, Z1..Z3 below Y1 (16). */
+    g_string_append(s, "-device usb4-device,id=X,bus=u4.0,port=1,"
+                    "downstream-ports=3 ");
+    for (i = 1; i <= 3; i++) {
+        g_string_append_printf(s, "-device usb4-device,id=X%d,bus=u4.0,"
+                               "parent=X,port=%d,downstream-ports=3 ", i, i);
+    }
+    for (i = 1; i <= 9; i++) {
+        g_string_append_printf(s, "-device usb4-device,id=Y%d,bus=u4.0,"
+                               "parent=X%d,port=%d,downstream-ports=3 ",
+                               i, (i + 2) / 3, (i - 1) % 3 + 1);
+    }
+    qts = chain_start(s->str);
+    g_string_free(s, true);
+    /* With A and B present there is room for only 1 + 3 + 9. */
+    g_assert(dev_attached(qts, "B"));
+    dev_del(qts, "A");
+    g_assert(!dev_attached(qts, "B"));
+    for (i = 1; i <= 3; i++) {
+        g_autofree char *id = g_strdup_printf("Z%d", i);
+        QDict *args = qdict_new();
+
+        qdict_put_str(args, "driver", "usb4-device");
+        qdict_put_str(args, "id", id);
+        qdict_put_str(args, "bus", "u4.0");
+        qdict_put_str(args, "parent", "Y1");
+        qdict_put_int(args, "port", i);
+        qtest_qmp_assert_success(qts, "{'execute': 'device_add', "
+                                 "'arguments': %p}", args);
+    }
+    /* 16 routers: A cannot attach, its realize fails. */
+    rsp = qtest_qmp(qts, "{'execute': 'device_add', 'arguments': "
+                    "{'driver': 'usb4-device', 'id': 'A', 'bus': 'u4.0', "
+                    "'port': 2, 'downstream-ports': 1}}");
+    g_assert(qdict_haskey(rsp, "error"));
+    qobject_unref(rsp);
+    /* Room for A and B again: the re-add plugs both. */
+    dev_del(qts, "Z2");
+    dev_del(qts, "Z3");
+    qtest_qmp_assert_success(qts, "{'execute': 'device_add', 'arguments': "
+                             "{'driver': 'usb4-device', 'id': 'A', "
+                             "'bus': 'u4.0', 'port': 2, "
+                             "'downstream-ports': 1}}");
+    g_assert(dev_attached(qts, "A"));
+    g_assert(dev_attached(qts, "B"));
+    qtest_quit(qts);
+}
+
+/*
+ * preos-cm=on (docs/USB4-HOSTS.md): the endpoint of a tunnel the emulated
+ * firmware CM built is on the bus, powered, before the guest runs,
+ * whatever the device order and also after a later machine reset.
+ */
+/* Device order host -> device router -> tunnel port (review 3 #1a) */
+static QTestState *preos_start(const char *model)
+{
+    const char *tp = "-device usb4-tunnel-port,id=tp0,bus=pcie.0,addr=0x3,"
+                     "chassis=1,settle-ms=200";
+    g_autofree char *host = g_strdup_printf(
+        "-device usb4-host,id=u4,bus=pcie.0,addr=0x4,tunnel-port=tp0,"
+        "preos-cm=on,host-model=%s", model);
+    const char *dev = "-device usb4-device,id=d0,bus=u4.0,port=1,"
+                      "drive=disk0,serial=QTPREOS";
+
+    return qtest_initf("-machine q35 -global ICH9-LPC.acpi-pci-hotplug-"
+                       "with-bridge-support=off -drive if=none,id=disk0,"
+                       "file=null-co://,format=raw %s %s %s",
+                       host, dev, tp);
+}
+
+static bool preos_nvme_visible(QTestState *qts)
+{
+    g_autofree char *st = endpoint_state(qts);
+    int exp = find_exp_cap(qts);
+    uint16_t sltctl = cfg_readl(qts, 0, TP_DEVFN, exp + 0x18) & 0xffff;
+
+    cfg_writel(qts, 0, TP_DEVFN, 0x18, 0x00010100);
+    return strstr(st, "gate=open") && !(sltctl & (1u << 10)) &&
+           cfg_readl(qts, 1, 0, 0) == 0x00101b36;
+}
+
+/* The OS driver touches the host interface: the firmware CM is done. */
+static void preos_os_takeover(QTestState *qts)
+{
+    int devfn = 4 << 3;
+
+    cfg_writel(qts, 0, devfn, 0x10, 0xe0000000);
+    cfg_writel(qts, 0, devfn, 0x14, 0);
+    cfg_writel(qts, 0, devfn, 0x04, 0x6);
+    qtest_readl(qts, 0xe0000000);
+}
+
+static void test_preos_order_model(const char *model)
+{
+    QTestState *qts = preos_start(model);
+
+    g_assert_true(preos_nvme_visible(qts));
+    qtest_quit(qts);
+}
+
+static void test_preos_order(void)
+{
+    test_preos_order_model("minimal");
+    test_preos_order_model("intel-adl");
+}
+
+static void test_preos_reset_model(const char *model)
+{
+    QTestState *qts = qtest_initf(
+        "-machine q35 -global ICH9-LPC.acpi-pci-hotplug-with-bridge-"
+        "support=off -drive if=none,id=disk0,file=null-co://,format=raw "
+        "-device usb4-tunnel-port,id=tp0,bus=pcie.0,addr=0x3,chassis=1,"
+        "settle-ms=200 -device usb4-host,id=u4,bus=pcie.0,addr=0x4,"
+        "tunnel-port=tp0,preos-cm=on,host-model=%s", model);
+
+    preos_os_takeover(qts);
+    qtest_qmp_device_add(qts, "usb4-device", "d0",
+                         "{'bus': 'u4.0', 'port': 1, 'drive': 'disk0', "
+                         "'serial': 'QTPREOS'}");
+    qtest_qmp_assert_success(qts, "{'execute': 'system_reset'}");
+    qtest_qmp_eventwait(qts, "RESET");
+    g_assert_true(preos_nvme_visible(qts));
+    qtest_quit(qts);
+}
+
+static void test_preos_reset(void)
+{
+    test_preos_reset_model("minimal");
+    test_preos_reset_model("intel-adl");
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    qtest_add_func("/usb4-tunnel-port/preos-order", test_preos_order);
+    qtest_add_func("/usb4-tunnel-port/preos-reset", test_preos_reset);
+    qtest_add_func("/usb4-tunnel-port/force-tunnel", test_force_tunnel);
+    qtest_add_func("/usb4-tunnel-bridge/slot-enable", test_bridge_slot_enable);
+    qtest_add_func("/usb4-tunnel-bridge/autoenable", test_bridge_autoenable);
+    qtest_add_func("/usb4-tunnel-port/poweroff-deferred",
+                   test_slot_poweroff_deferred);
+    qtest_add_func("/usb4-tunnel-port/poweron-cc", test_slot_poweron_cc);
+    qtest_add_func("/usb4-tunnel-bridge/disable-deferred",
+                   test_bridge_disable_deferred);
+    qtest_add_func("/usb4-tunnel-port/dock", test_dock);
+    qtest_add_func("/usb4-tunnel-port/window-all-ones",
+                   test_window_all_ones);
+    qtest_add_func("/usb4-tunnel-bridge/window-all-ones",
+                   test_bridge_window_all_ones);
+    qtest_add_func("/usb4-tunnel-bridge/ones-fallback",
+                   test_bridge_ones_fallback);
+    qtest_add_func("/usb4-tunnel-port/ones-fallback",
+                   test_port_ones_fallback);
+    qtest_add_func("/usb4-tunnel-port/reset-windows",
+                   test_port_reset_windows);
+    qtest_add_func("/usb4-tunnel-bridge/reset-windows",
+                   test_bridge_reset_windows);
+    qtest_add_func("/usb4-tunnel/unmigratable", test_tunnel_unmigratable);
+    qtest_add_func("/usb4-tunnel/loadvm-blocked",
+                   test_tunnel_loadvm_blocked);
+    qtest_add_func("/usb4-tunnel-port/window-pref64", test_window_pref64);
+    qtest_add_func("/usb4-tunnel-port/chain-switch", test_chain_switch);
+    qtest_add_func("/usb4-tunnel-port/chain-nested-gate",
+                   test_chain_nested_gate);
+    qtest_add_func("/usb4-tunnel-dsp/reset-windows", test_chain_dsp_reset);
+    qtest_add_func("/usb4-tunnel-dsp/flr-windows", test_chain_dsp_flr);
+    qtest_add_func("/usb4-tunnel-port/dllsc-insert", test_port_dllsc_insert);
+    qtest_add_func("/usb4-tunnel-port/dllsc-intx", test_port_dllsc_intx);
+    qtest_add_func("/usb4-tunnel-dsp/dllsc-insert",
+                   test_chain_dsp_dllsc_insert);
+    qtest_add_func("/usb4-tunnel-dsp/dllsc-reset", test_chain_dsp_dllsc_reset);
+    qtest_add_func("/usb4-device/chain-cycle", test_chain_cycle);
+    qtest_add_func("/usb4-device/chain-failed-adopt",
+                   test_chain_failed_adopt);
+    qtest_add_func("/usb4-tunnel-dsp/stale-unregister", test_chain_stale_dsp);
+    return g_test_run();
+}
diff --git a/tests/qtest/x86-smm-tlb-test.c b/tests/qtest/x86-smm-tlb-test.c
new file mode 100644
index 0000000000000000000000000000000000000000..0fa19fe7f47b46d4e13bd05a43881ffb3b221777
--- /dev/null
+++ b/tests/qtest/x86-smm-tlb-test.c
@@ -0,0 +1,308 @@
+/*
+ * QTest: TCG must not carry TLB entries across SMM transitions taken in
+ * real mode, in either direction.
+ *
+ * Copyright (c) 2026 usb4-emu contributors
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Written from scratch for the usb4-emu project. The softmmu TLB has no
+ * SMM index: an entry keeps the address space (normal memory or SMRAM)
+ * that was in effect when it was filled. Entering SMM from real mode, or
+ * leaving it back to real mode, changes none of the CR0/CR4 bits whose
+ * update flushes the TLB, so before the fix an entry filled on one side
+ * was used on the other.
+ *
+ * With SMBASE at 0xa0000 (as SeaBIOS sets it) the SMI entry point is at
+ * 0xa8000, under the legacy VGA window. Entering: a real-mode access to
+ * 0xa8000 followed by an SMI made the CPU fetch its SMI handler from the
+ * VGA frame buffer and loop on #UD at SMBASE + 0x8000. That is how
+ * Windows 98 hung at its boot logo (mode 13h pixels at 0xa8000) when
+ * SeaBIOS served INT 13h for an NVMe or USB disk through its SMM call32
+ * trampoline (docs/WIN98-TEST.md in usb4-emu). Leaving: the fetch at
+ * 0xa8000 in SMM left an SMRAM entry that real-mode code could read after
+ * RSM.
+ *
+ * A VGA device is required: without one, normal memory at 0xa8000 falls
+ * through to the RAM under SMRAM and both views hold the same bytes.
+ */
+
+#include "qemu/osdep.h"
+#include "libqtest.h"
+
+#define WAIT_SECONDS    30      /* per case; meson timeout in meson.build */
+
+/*
+ * Entry case, booted by SeaBIOS: set VGA mode 13h (as the Windows 98 logo
+ * does), read 0xa000:0x8000, raise an SMI through the APM control port
+ * 0xb2 (SeaBIOS ignores command 0 and resumes), then print on COM1.
+ * Without the flush on entry the CPU never comes back.
+ */
+static const uint8_t entry_boot_sector[] = {
+    0xfa,                               /* 7c00: cli                    */
+    0x31, 0xc0,                         /* 7c01: xor ax, ax             */
+    0x8e, 0xd8,                         /* 7c03: mov ds, ax             */
+    0x8e, 0xd0,                         /* 7c05: mov ss, ax             */
+    0xbc, 0x00, 0x7c,                   /* 7c07: mov sp, 0x7c00         */
+    0xb8, 0x13, 0x00,                   /* 7c0a: mov ax, 0x0013         */
+    0xcd, 0x10,                         /* 7c0d: int 0x10 (mode 13h)    */
+    0xfa,                               /* 7c0f: cli                    */
+    0xb8, 0x00, 0xa0,                   /* 7c10: mov ax, 0xa000         */
+    0x8e, 0xc0,                         /* 7c13: mov es, ax             */
+    0x26, 0xa0, 0x00, 0x80,             /* 7c15: mov al, es:[0x8000]    */
+    0xb0, 0x00,                         /* 7c19: mov al, 0              */
+    0xe6, 0xb2,                         /* 7c1b: out 0xb2, al  (SMI)    */
+    0x90, 0x90,                         /* 7c1d: nop; nop               */
+    0xbe, 0x30, 0x7c,                   /* 7c1f: mov si, msg            */
+    0xba, 0xf8, 0x03,                   /* 7c22: mov dx, 0x3f8          */
+    0xac,                               /* 7c25: lodsb                  */
+    0x84, 0xc0,                         /* 7c26: test al, al            */
+    0x74, 0x03,                         /* 7c28: jz 7c2d                */
+    0xee,                               /* 7c2a: out dx, al             */
+    0xeb, 0xf8,                         /* 7c2b: jmp 7c25               */
+    0xf4,                               /* 7c2d: hlt                    */
+    0xeb, 0xfd,                         /* 7c2e: jmp 7c2d               */
+    /* 7c30: msg */
+    'S', 'M', 'M', '-', 'T', 'L', 'B', '-', 'O', 'K', 0x0d, 0x0a, 0,
+};
+
+/*
+ * Exit case, a 64 KiB firmware image of its own (-bios), so that no
+ * firmware SMI handler switches modes (SeaBIOS's enters protected mode
+ * before RSM, which flushes anyway). Everything runs in real mode at
+ * f000:0000:
+ *   1. open SMRAM (i440FX 0x72 = D_OPEN | G_SMRAME | C_BASE_SEG) and
+ *      copy smi_main to 0xa8000 and smi_reloc to 0x38000, close SMRAM;
+ *   2. set APMC_EN (PIIX4 PM 0x5b bit 1);
+ *   3. SMI 1 runs smi_reloc at the default SMBASE 0x30000: it writes
+ *      0xa0000 into the SMBASE field of the 32-bit save state map
+ *      (offset 0x7ef8) and executes RSM;
+ *   4. SMI 2 runs smi_main from SMRAM at 0xa8000: it sets the byte at
+ *      0x500 and executes RSM, still in real mode;
+ *   5. read 0xa000:0x8000. The normal view is the VGA window (0x00 in a
+ *      VGA reset state); 0xc6, the first byte of smi_main, means a TLB
+ *      entry filled in SMM survived RSM.
+ * The result goes to COM1: RSM-OK, RSM-STALE or RSM-NO-SMI.
+ * Assembled with GNU as (.code16) and listed with objdump -M intel.
+ */
+static const uint8_t exit_firmware[] = {
+    0xfa,                               /* 00: cli                      */
+    0x31, 0xc0,                         /* 01: xor ax, ax               */
+    0x8e, 0xd8,                         /* 03: mov ds, ax               */
+    0x8e, 0xd0,                         /* 05: mov ss, ax               */
+    0xbc, 0x00, 0x70,                   /* 07: mov sp, 0x7000           */
+    0xc6, 0x06, 0x00, 0x05, 0x00,       /* 0a: mov byte [0x500], 0      */
+    0xba, 0xf8, 0x0c,                   /* 0f: mov dx, 0xcf8            */
+    0x66, 0xb8, 0x70, 0x00, 0x00, 0x80, /* 12: mov eax, 0x80000070      */
+    0x66, 0xef,                         /* 18: out dx, eax              */
+    0xba, 0xfe, 0x0c,                   /* 1a: mov dx, 0xcfe            */
+    0xb0, 0x4a,                         /* 1d: mov al, 0x4a (D_OPEN)    */
+    0xee,                               /* 1f: out dx, al               */
+    0xb8, 0x00, 0xf0,                   /* 20: mov ax, 0xf000           */
+    0x8e, 0xd8,                         /* 23: mov ds, ax               */
+    0xfc,                               /* 25: cld                      */
+    0xb8, 0x00, 0xa0,                   /* 26: mov ax, 0xa000           */
+    0x8e, 0xc0,                         /* 29: mov es, ax               */
+    0xbf, 0x00, 0x80,                   /* 2b: mov di, 0x8000           */
+    0xbe, 0xa4, 0x00,                   /* 2e: mov si, smi_main         */
+    0xb9, 0x07, 0x00,                   /* 31: mov cx, 7                */
+    0xf3, 0xa4,                         /* 34: rep movsb                */
+    0xb8, 0x00, 0x30,                   /* 36: mov ax, 0x3000           */
+    0x8e, 0xc0,                         /* 39: mov es, ax               */
+    0xbf, 0x00, 0x80,                   /* 3b: mov di, 0x8000           */
+    0xbe, 0xab, 0x00,                   /* 3e: mov si, smi_reloc        */
+    0xb9, 0x0e, 0x00,                   /* 41: mov cx, 14               */
+    0xf3, 0xa4,                         /* 44: rep movsb                */
+    0x31, 0xc0,                         /* 46: xor ax, ax               */
+    0x8e, 0xd8,                         /* 48: mov ds, ax               */
+    0xba, 0xf8, 0x0c,                   /* 4a: mov dx, 0xcf8            */
+    0x66, 0xb8, 0x70, 0x00, 0x00, 0x80, /* 4d: mov eax, 0x80000070      */
+    0x66, 0xef,                         /* 53: out dx, eax              */
+    0xba, 0xfe, 0x0c,                   /* 55: mov dx, 0xcfe            */
+    0xb0, 0x0a,                         /* 58: mov al, 0x0a (closed)    */
+    0xee,                               /* 5a: out dx, al               */
+    0xba, 0xf8, 0x0c,                   /* 5b: mov dx, 0xcf8            */
+    0x66, 0xb8, 0x58, 0x0b, 0x00, 0x80, /* 5e: mov eax, 0x80000b58      */
+    0x66, 0xef,                         /* 64: out dx, eax              */
+    0xba, 0xff, 0x0c,                   /* 66: mov dx, 0xcff            */
+    0xb0, 0x02,                         /* 69: mov al, 2 (APMC_EN)      */
+    0xee,                               /* 6b: out dx, al               */
+    0xe6, 0xb2,                         /* 6c: out 0xb2, al  (SMI 1)    */
+    0x90,                               /* 6e: nop                      */
+    0xe6, 0xb2,                         /* 6f: out 0xb2, al  (SMI 2)    */
+    0x90,                               /* 71: nop                      */
+    0xb8, 0x00, 0xa0,                   /* 72: mov ax, 0xa000           */
+    0x8e, 0xc0,                         /* 75: mov es, ax               */
+    0x26, 0x8a, 0x1e, 0x00, 0x80,       /* 77: mov bl, es:[0x8000]      */
+    0xbe, 0xce, 0x00,                   /* 7c: mov si, msg_nosmi        */
+    0x80, 0x3e, 0x00, 0x05, 0x01,       /* 7f: cmp byte [0x500], 1      */
+    0x75, 0x0b,                         /* 84: jne 91                   */
+    0xbe, 0xb9, 0x00,                   /* 86: mov si, msg_ok           */
+    0x80, 0xfb, 0xc6,                   /* 89: cmp bl, 0xc6             */
+    0x75, 0x03,                         /* 8c: jne 91                   */
+    0xbe, 0xc2, 0x00,                   /* 8e: mov si, msg_stale        */
+    0xb8, 0x00, 0xf0,                   /* 91: mov ax, 0xf000           */
+    0x8e, 0xd8,                         /* 94: mov ds, ax               */
+    0xba, 0xf8, 0x03,                   /* 96: mov dx, 0x3f8            */
+    0xac,                               /* 99: lodsb                    */
+    0x84, 0xc0,                         /* 9a: test al, al              */
+    0x74, 0x03,                         /* 9c: jz a1                    */
+    0xee,                               /* 9e: out dx, al               */
+    0xeb, 0xf8,                         /* 9f: jmp 99                   */
+    0xf4,                               /* a1: hlt                      */
+    0xeb, 0xfd,                         /* a2: jmp a1                   */
+    /* a4: smi_main, copied to SMRAM at 0xa8000 */
+    0xc6, 0x06, 0x00, 0x05, 0x01,       /* a4: mov byte [0x500], 1      */
+    0x0f, 0xaa,                         /* a9: rsm                      */
+    /* ab: smi_reloc, copied to 0x38000 */
+    0x67, 0x66, 0xc7, 0x05,             /* ab: mov dword [0x3fef8],     */
+    0xf8, 0xfe, 0x03, 0x00,             /*       0xa0000 (addr32)       */
+    0x00, 0x00, 0x0a, 0x00,
+    0x0f, 0xaa,                         /* b7: rsm                      */
+    /* b9: msg_ok */
+    'R', 'S', 'M', '-', 'O', 'K', 0x0d, 0x0a, 0,
+    /* c2: msg_stale */
+    'R', 'S', 'M', '-', 'S', 'T', 'A', 'L', 'E', 0x0d, 0x0a, 0,
+    /* ce: msg_nosmi */
+    'R', 'S', 'M', '-', 'N', 'O', '-', 'S', 'M', 'I', 0x0d, 0x0a, 0,
+};
+
+#define FIRMWARE_SIZE   0x10000
+
+/*
+ * Wait for one of @want (NULL-terminated) on the serial log; return its
+ * index, or -1 on timeout or QEMU exit.
+ */
+static int wait_for_serial(QTestState *qts, int fd, const char *const *want)
+{
+    g_autoptr(GString) log = g_string_new(NULL);
+    gint64 end = g_get_monotonic_time() + WAIT_SECONDS * G_USEC_PER_SEC;
+    char buf[256];
+    ssize_t n;
+    int i;
+
+    for (;;) {
+        while ((n = read(fd, buf, sizeof(buf))) > 0) {
+            g_string_append_len(log, buf, n);
+        }
+        g_assert(n == 0);
+        for (i = 0; want[i]; i++) {
+            if (strstr(log->str, want[i])) {
+                return i;
+            }
+        }
+        if (!qtest_probe_child(qts) || g_get_monotonic_time() >= end) {
+            return -1;
+        }
+        g_usleep(10000);
+    }
+}
+
+static char *write_tmp(const char *tmpl, const void *data, size_t len)
+{
+    char *path = NULL;
+    int fd = g_file_open_tmp(tmpl, &path, NULL);
+
+    g_assert(fd != -1);
+    if (len) {
+        g_assert(write(fd, data, len) == len);
+    }
+    close(fd);
+    return path;
+}
+
+static void test_smi_entry_from_real_mode(const void *data)
+{
+    const char *cpu = data;
+    const char *const want[] = { "SMM-TLB-OK", NULL };
+    uint8_t sector[512] = { 0 };
+    g_autofree char *disk = NULL;
+    g_autofree char *serial = NULL;
+    QTestState *qts;
+    int fd, r;
+
+    memcpy(sector, entry_boot_sector, sizeof(entry_boot_sector));
+    sector[510] = 0x55;
+    sector[511] = 0xaa;
+    disk = write_tmp("qtest-smm-tlb-dXXXXXX", sector, sizeof(sector));
+    serial = write_tmp("qtest-smm-tlb-sXXXXXX", NULL, 0);
+
+    qts = qtest_initf("-machine pc -accel tcg -cpu %s -vga std "
+                      "-drive if=ide,index=0,format=raw,file=%s "
+                      "-chardev file,id=ser0,path=%s -serial chardev:ser0",
+                      cpu, disk, serial);
+    fd = open(serial, O_RDONLY);
+    g_assert(fd != -1);
+    r = wait_for_serial(qts, fd, want);
+    close(fd);
+    qtest_quit(qts);
+    unlink(disk);
+    unlink(serial);
+    if (r != 0) {
+        g_error("no SMM-TLB-OK on COM1: the CPU did not return from SMM");
+    }
+}
+
+static void test_rsm_to_real_mode(void)
+{
+    const char *const want[] = { "RSM-OK", "RSM-STALE", "RSM-NO-SMI", NULL };
+    g_autofree uint8_t *rom = g_malloc0(FIRMWARE_SIZE);
+    g_autofree char *bios = NULL;
+    g_autofree char *serial = NULL;
+    QTestState *qts;
+    int fd, r;
+
+    memcpy(rom, exit_firmware, sizeof(exit_firmware));
+    /* reset vector: jmp far f000:0000 */
+    rom[0xfff0] = 0xea;
+    rom[0xfff1] = 0x00;
+    rom[0xfff2] = 0x00;
+    rom[0xfff3] = 0x00;
+    rom[0xfff4] = 0xf0;
+    bios = write_tmp("qtest-smm-tlb-bXXXXXX", rom, FIRMWARE_SIZE);
+    serial = write_tmp("qtest-smm-tlb-sXXXXXX", NULL, 0);
+
+    /* pentium3: no long mode, so the 32-bit save state map */
+    qts = qtest_initf("-machine pc -accel tcg -cpu pentium3,-apic -vga std "
+                      "-bios %s "
+                      "-chardev file,id=ser0,path=%s -serial chardev:ser0",
+                      bios, serial);
+    fd = open(serial, O_RDONLY);
+    g_assert(fd != -1);
+    r = wait_for_serial(qts, fd, want);
+    close(fd);
+    qtest_quit(qts);
+    unlink(bios);
+    unlink(serial);
+    switch (r) {
+    case 0:
+        break;
+    case 1:
+        g_error("real mode read SMRAM at 0xa8000 after RSM: stale TLB entry");
+    case 2:
+        g_error("the SMI handler in SMRAM did not run");
+    default:
+        g_error("no result on COM1");
+    }
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+
+    if (!qtest_has_accel("tcg")) {
+        g_test_skip("TCG not available");
+        return g_test_run();
+    }
+    if (!qtest_has_machine("pc") || !qtest_has_device("VGA")) {
+        g_test_skip("needs the pc machine and the VGA device");
+        return g_test_run();
+    }
+    /* 32-bit SMM save state map (Windows 98 VMs) and the 64-bit one */
+    qtest_add_data_func("/x86/smm-tlb/entry-from-real-mode/pentium3",
+                        "pentium3,-apic", test_smi_entry_from_real_mode);
+    qtest_add_data_func("/x86/smm-tlb/entry-from-real-mode/qemu64",
+                        "qemu64", test_smi_entry_from_real_mode);
+    qtest_add_func("/x86/smm-tlb/rsm-to-real-mode",
+                   test_rsm_to_real_mode);
+    return g_test_run();
+}
