+/* R33: a hidden NHI reads as an empty function and ignores writes. */
+static uint32_t usb4_host_read_config(PCIDevice *pd, uint32_t addr, int len)
+{
+    if (USB4_HOST(pd)->nhi_hidden) {
+        return len == 4 ? 0xffffffffu : (1u << (8 * len)) - 1;
+    }
+    return pci_default_read_config(pd, addr, len);
+}
+
+static void usb4_host_write_config(PCIDevice *pd, uint32_t addr,
+                                   uint32_t val, int len)
+{
+    USB4Host *s = USB4_HOST(pd);
+
+    if (s->nhi_hidden) {
+        return;
+    }
+    pci_default_write_config(pd, addr, val, len);
+    /* MSI/MSI-X enable changes INTx eligibility. */
+    usb4_host_update_intx(s);
+    /*
+     * R2 (ICM-PROTOCOL.md 13.5): the outbound mailbox's low nibble
+     * changes from 0 to 5 after the NHI's first D3 (PCI PM 1.2 PMCSR
+     * PowerState 3) and stays so until reset.
+     */
+    if (pd->pm_cap && range_covers_byte(addr, len, pd->pm_cap + PCI_PM_CTRL) &&
+        (pci_get_word(pd->config + pd->pm_cap + PCI_PM_CTRL) &
+         PCI_PM_CTRL_STATE_MASK) == 3 && !s->been_d3) {
+        s->been_d3 = true;
+        trace_usb4_host_power_state("D3, outbound mailbox low nibble 5");
+    }
+}
