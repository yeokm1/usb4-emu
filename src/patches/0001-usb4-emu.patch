+/*
+ * Maximal vendor and model names (251 bytes each with the terminator)
+ * must fit the builders' scratch buffer: 540 bytes generic, 590 tb3.
+ */
+static void test_drom_long_names(void)
+{
+    char *name = g_strnfill(400, 'x');
+    USB4Router r;
+
+    memset(&r, 0, sizeof(r));
+    r.vendor_name = name;
+    r.model_name = name;
+    usb4_drom_build(&r);
+    CHECK(r.drom_len == 16 + 2 * 253 + 18, "long-name DROM length %zu",
+          r.drom_len);
+    CHECK(r.drom[13 + 3] == 253 && r.drom[13 + 3 + 253] == 253 &&
+          r.drom[13 + 3 + 252] == 0, "long-name entries truncated to 253");
+    CHECK((r.drom[9] | r.drom[10] << 8 | r.drom[11] << 16 |
+           (uint32_t)r.drom[12] << 24) ==
+          usb4_drom_crc32(r.drom + 13, r.drom_len - 13), "long-name DROM CRC");
+    g_free(r.drom);
+    r.drom = NULL;
+    r.is_host = false;
+    usb4_drom_build_tb3(&r);
+    CHECK(r.drom_len == 22 + 62 + 2 * 253, "long-name tb3 DROM length %zu",
+          r.drom_len);
+    g_free(r.drom);
+    g_free(name);
+}
+
+#define TB3_EE 0x2c
+
+static void ee_wr(uint64_t route, uint32_t *v, uint32_t clr, uint32_t set)
+{
+    *v = (*v & ~clr) | set;
+    wr1(route, USB4_CS_ROUTER, 0, TB3_EE, *v);
+}
+
+/* EEPROM bit-bang read as in docs/ICM-PROTOCOL.md 5.4 */
+static void ee_read(uint64_t route, unsigned addr, uint8_t *buf, unsigned n)
+{
+    uint32_t v = rd1(route, USB4_CS_ROUTER, 0, TB3_EE);
+    uint8_t cmd[3] = { 0x03, addr >> 8, addr & 0xff };
+
+    CHECK((v & 0xa0) == 0x80, "EEPROM present %08x", v);
+    ee_wr(route, &v, 0, 0x10);              /* enable */
+    ee_wr(route, &v, 0x02, 0);              /* chip select */
+    for (unsigned i = 0; i < 3; i++) {
+        for (int b = 7; b >= 0; b--) {
+            ee_wr(route, &v, 0x04, ((cmd[i] >> b) & 1) ? 0x04 : 0);
+            ee_wr(route, &v, 0, 0x01);
+            ee_wr(route, &v, 0x01, 0);
+        }
+    }
+    for (unsigned i = 0; i < n; i++) {
+        uint8_t byte = 0;
+
+        for (int b = 7; b >= 0; b--) {
+            ee_wr(route, &v, 0, 0x01);
+            byte = (byte << 1) |
+                   !!(rd1(route, USB4_CS_ROUTER, 0, TB3_EE) & 0x08);
+            ee_wr(route, &v, 0x01, 0);
+        }
+        buf[i] = byte;
+    }
+    ee_wr(route, &v, 0, 0x02);              /* deselect */
+    ee_wr(route, &v, 0x10, 0);              /* disable */
+}
