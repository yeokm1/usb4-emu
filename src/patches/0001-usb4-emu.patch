+/* Hook 5: every 2nd INTx assertion of the endpoint is lost. */
+static void test_lost_intx(void)
+{
+    g_autofree char *img = make_img();
+    Nv nv;
+    QTestState *qts = tp_start(img, ",x-intx-drop-every=2", "", &nv);
+    uint16_t cid;
+
+    nv_enable(&nv);
+    /* Assertion 1 reaches the pin (PCI Status.Interrupt Status). */
+    cid = nv_submit(&nv, 0, 0x06, 0, RAM_ID, 1, 0, 0);
+    for (int i = 0; i < 2000 && !nv_peek(&nv, 0, cid, NULL, NULL); i++) {
+        g_usleep(1000);
+    }
+    g_assert(cfg_readl(qts, 1, 0, 0x04) & (1 << 19));
+    g_assert(nv_poll(&nv, 0, cid, NULL, NULL, 10));
+    g_assert(!(cfg_readl(qts, 1, 0, 0x04) & (1 << 19)));
+    /* Assertion 2 is lost: the completion is posted, the pin stays low. */
+    cid = nv_submit(&nv, 0, 0x06, 0, RAM_ID, 1, 0, 0);
+    for (int i = 0; i < 2000 && !nv_peek(&nv, 0, cid, NULL, NULL); i++) {
+        g_usleep(1000);
+    }
+    g_assert(nv_peek(&nv, 0, cid, NULL, NULL));
+    g_assert(!(cfg_readl(qts, 1, 0, 0x04) & (1 << 19)));
+    g_assert(str_has(qts, TP_PATH, "x-harness-state",
+                     "intx-asserts=2 intx-dropped=1"));
+    g_assert(nv_poll(&nv, 0, cid, NULL, NULL, 10));
+    /* Window form: assertion 3 lost too, 4 delivered. */
+    qom_set_int(qts, TP_PATH, "x-intx-drop-every", 0);
+    qom_set_str(qts, TP_PATH, "x-intx-drop-range", "3-3");
+    cid = nv_submit(&nv, 0, 0x06, 0, RAM_ID, 1, 0, 0);
+    for (int i = 0; i < 2000 && !nv_peek(&nv, 0, cid, NULL, NULL); i++) {
+        g_usleep(1000);
+    }
+    g_assert(!(cfg_readl(qts, 1, 0, 0x04) & (1 << 19)));
+    g_assert(nv_poll(&nv, 0, cid, NULL, NULL, 10));
+    cid = nv_submit(&nv, 0, 0x06, 0, RAM_ID, 1, 0, 0);
+    for (int i = 0; i < 2000 && !nv_peek(&nv, 0, cid, NULL, NULL); i++) {
+        g_usleep(1000);
+    }
+    g_assert(cfg_readl(qts, 1, 0, 0x04) & (1 << 19));
+    g_assert(str_has(qts, TP_PATH, "x-harness-state",
+                     "intx-asserts=4 intx-dropped=2"));
+    qtest_quit(qts);
+    unlink(img);
+}
