+/*
+ * USB4 tunnel test harness: deterministic fault injection for the NVMe
+ * endpoint behind a tunnel bridge.
+ *
+ * Copyright (c) 2026 usb4-emu contributors
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Written from scratch for the usb4-emu project. User interface and
+ * semantics: docs/HARNESS.md in the usb4-emu repository; the cases it
+ * serves are the nvme98 TESTING.md "Harness work needed" items. Gate
+ * actions use the stage 1 gate of docs/ARCHITECTURE.md section 4.4.
+ *
+ * Everything here is test-only and inert by default: with no x-* harness
+ * property set, the hook installed on the endpoint's NVMe controller
+ * passes every command, completion, register access and interrupt
+ * through unchanged.
+ *
+ * Fault rules fire synchronously in the device model, in the same call
+ * that observes their trigger:
+ *  - at=fetch: the NVMe controller fetched a matching command from a
+ *    submission queue (before it executes);
+ *  - at=complete: just before the completion of a matching command is
+ *    queued for posting;
+ *  - at=stage: the guest wrote a matching stage code to the debug port
+ *    (usb4-debug-port).
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qapi/visitor.h"
+#include "qapi/qapi-events-misc.h"
+#include "qemu/cutils.h"
+#include "qemu/main-loop.h"
+#include "qemu/timer.h"
+#include "hw/nvme/nvme-test-hook.h"
+#include "usb4-harness.h"
+#include "trace.h"
+
+/* NVMe controller registers (NVM Express Base 2.0, section 3.1.4) */
+#define H_REG_CC        0x14
+#define H_REG_CSTS      0x1c
+#define H_CC_EN         (1u << 0)
+#define H_CC_SHN(cc)    (((cc) >> 14) & 3)
+#define H_CSTS_RDY      (1u << 0)
+#define H_CSTS_CFS      (1u << 1)
+#define H_CSTS_SHST(cs) (((cs) >> 2) & 3)
+#define H_SHST_OCCURRING 1
+#define H_SHST_COMPLETE  2
+
+enum { H_AT_FETCH, H_AT_COMPLETE, H_AT_STAGE };
+static const char *const h_at_names[] = { "fetch", "complete", "stage" };
+
+enum {
+    H_A_SURPRISE    = 1u << 0,
+    H_A_EJECT       = 1u << 1,
+    H_A_ADMIN_DOWN  = 1u << 2,
+    H_A_GATE        = 1u << 3,
+    H_A_READS_FAIL  = 1u << 4,
+    H_A_REOPEN      = 1u << 5,
+    H_A_HOLD        = 1u << 6,
+    H_A_DROP        = 1u << 7,
+    H_A_RELEASE     = 1u << 8,
+    H_A_CFS         = 1u << 9,
+    H_A_HANG_STUCK  = 1u << 10,
+    H_A_HANG_ONES   = 1u << 11,
+    H_A_UNHANG      = 1u << 12,
+    H_A_NONE        = 1u << 13,
+    H_A_ARM         = 1u << 14,
+    H_A_DISARM      = 1u << 15,
+    H_A_RESET_CTRL  = 1u << 16,
+};
+static const struct {
+    const char *name;
+    uint32_t bit;
+} h_acts[] = {
+    { "surprise", H_A_SURPRISE },
+    { "eject", H_A_EJECT },
+    { "admin-down", H_A_ADMIN_DOWN },
+    { "gate", H_A_GATE },
+    { "reads-fail", H_A_READS_FAIL },
+    { "reopen", H_A_REOPEN },
+    { "hold", H_A_HOLD },
+    { "drop", H_A_DROP },
+    { "release", H_A_RELEASE },
+    { "cfs", H_A_CFS },
+    { "hang-stuck", H_A_HANG_STUCK },
+    { "hang-ones", H_A_HANG_ONES },
+    { "unhang", H_A_UNHANG },
+    { "none", H_A_NONE },
+    { "arm", H_A_ARM },
+    { "disarm", H_A_DISARM },
+    { "reset-controller", H_A_RESET_CTRL },
+};
+
+/* What releases a held command besides delay= and x-release. */
+enum { H_REL_MANUAL, H_REL_RDY0_ACK, H_REL_REOPEN };
+static const char *const h_rel_names[] = { "manual", "rdy0-ack", "reopen" };
+
+enum { H_HANG_OFF, H_HANG_STUCK, H_HANG_ONES };
+static const char *const h_hang_names[] = { "off", "stuck", "ones" };
+
+#define H_SQ_ANY  (-1)
+#define H_SQ_IO   (-2)
+
+/* Command names: opcode and the queue type it belongs to. */
+static const struct {
+    const char *name;
+    uint8_t op;
+    bool io;
+} h_ops[] = {
+    { "flush", 0x00, true },
+    { "write", 0x01, true },
+    { "read", 0x02, true },
+    { "write-uncorrectable", 0x04, true },
+    { "compare", 0x05, true },
+    { "write-zeroes", 0x08, true },
+    { "dsm", 0x09, true },
+    { "verify", 0x0c, true },
+    { "delete-sq", 0x00, false },
+    { "create-sq", 0x01, false },
+    { "get-log-page", 0x02, false },
+    { "delete-cq", 0x04, false },
+    { "create-cq", 0x05, false },
+    { "identify", 0x06, false },
+    { "abort", 0x08, false },
+    { "set-features", 0x09, false },
+    { "get-features", 0x0a, false },
+    { "async-event", 0x0c, false },
+};
+
+typedef struct HRule {
+    char *text;
+    int at;
+    int sq;                 /* H_SQ_ANY, H_SQ_IO or a queue ID */
+    int op;                 /* -1: any */
+    int64_t nsid;           /* -1: any */
+    bool has_lba;
+    uint64_t lba_lo, lba_hi;
+    int64_t code;           /* stage code, -1: any */
+    uint32_t nth;
+    bool repeat;
+    uint32_t acts;
+    int64_t delay_ms;       /* hold: release after this (-1: no timer) */
+    int release_on;
+    bool has_status;
+    uint16_t status;
+    bool has_dw0;
+    uint32_t dw0;
+    char *tag;
+    bool armed;             /* false: ignored until an arm action */
+    uint32_t matched, fired;
+} HRule;
+
+typedef struct HHeld {
+    uint64_t token;
+    int64_t deadline_ms;    /* QEMU_CLOCK_VIRTUAL, -1: none */
+    int release_on;
+    char *tag;
+    bool by_hang;
+} HHeld;
+
+typedef struct HCCWrite {
+    uint64_t val;
+    unsigned size;
+} HCCWrite;
+
+struct USB4Harness {
+    USB4TunnelSlot *ts;
+    PCIDevice *nvme;            /* hooked controller, NULL if none */
+    char *rules_text;
+    GPtrArray *rules;           /* HRule * */
+    GList *held;                /* HHeld * */
+    QEMUTimer *timer;
+    /*
+     * Inside an NVMe hook callback or a debug-port write: no draining
+     * here, released commands run from the controller's bottom half and
+     * other deferred work from the slot's (usb4_harness_bh_work()).
+     */
+    int cb_depth;
+    bool in_bh;                 /* in usb4_harness_bh_work() */
+    bool reopen_pending;        /* reopen + release=reopen, for the BH */
+
+    /* Controller timing faults; delays in ms, -1 never, 0 off. */
+    int32_t rdy_set_delay_ms;
+    int32_t rdy_clear_delay_ms;
+    int32_t shst_delay_ms;
+    bool cfs;
+    int hang;
+    bool stuck_valid;
+    uint32_t stuck_csts;
+    uint32_t cc;                /* last CC value the guest wrote */
+    int64_t en_on_at, en_off_at, shn_at;    /* virtual ms, -1 none */
+
+    /* Deferred disable while a release=rdy0-ack command is held. */
+    bool defer;
+    bool acked;
+    bool defer_apply;           /* the slot's BH should finish it */
+    uint64_t defer_val;
+    unsigned defer_size;
+    GArray *cc_queue;           /* HCCWrite: later CC writes, in order */
+
+    /* Lost INTx */
+    uint32_t intx_every;
+    uint32_t intx_from, intx_to;
+    uint64_t intx_asserts, intx_dropped;
+    bool dev_level, suppress;
+
+    uint32_t marker_db;         /* BAR0 offset of the marker doorbell */
+    uint64_t markers;
+};
+
+static GSList *h_all;
+static uint64_t h_stages;
+
+static const char *h_name(USB4Harness *h)
+{
+    /* Properties may be set before the bridge is realized. */
+    return h->ts->bridge ? usb4_tunnel_slot_name(h->ts) : "(unrealized)";
+}
+
+static int64_t h_now_ms(void)
+{
+    return qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL);
+}
+
+/* ------------------------------------------------------------------ */
+/* Rules                                                                */
+/* ------------------------------------------------------------------ */
+
+static void h_rule_free(gpointer p)
+{
+    HRule *r = p;
+
+    g_free(r->text);
+    g_free(r->tag);
+    g_free(r);
+}
+
+static bool h_num(const char *key, const char *val, uint64_t max,
+                  uint64_t *out, Error **errp)
+{
+    /* @val is NULL for the missing half of an empty range ("lba="). */
+    if (!val || qemu_strtou64(val, NULL, 0, out) || *out > max) {
+        error_setg(errp, "%s%s: bad value \"%s\"",
+                   g_str_has_prefix(key, "x-") ? "" : "x-faults: ", key,
+                   val ? val : "");
+        return false;
+    }
+    return true;
+}
+
+static HRule *h_parse_rule(const char *text, Error **errp)
+{
+    g_auto(GStrv) toks = g_strsplit_set(text, " \t", -1);
+    g_autoptr(GString) acts = NULL;
+    HRule *r = g_new0(HRule, 1);
+    bool have_at = false;
+    uint64_t v;
+
+    r->text = g_strdup(text);
+    r->sq = H_SQ_ANY;
+    r->op = -1;
+    r->nsid = -1;
+    r->code = -1;
+    r->nth = 1;
+    r->delay_ms = -1;
+    r->armed = true;
+    for (int i = 0; toks[i]; i++) {
+        char *eq = strchr(toks[i], '=');
+        const char *key = toks[i], *val;
+
+        if (!*toks[i]) {
+            continue;
+        }
+        if (!eq) {
+            error_setg(errp, "x-faults: \"%s\" is not key=value", toks[i]);
+            goto fail;
+        }
+        *eq = 0;
+        val = eq + 1;
+        if (!strcmp(key, "at")) {
+            for (r->at = 0; r->at < ARRAY_SIZE(h_at_names); r->at++) {
+                if (!strcmp(val, h_at_names[r->at])) {
+                    break;
+                }
+            }
+            if (r->at == ARRAY_SIZE(h_at_names)) {
+                error_setg(errp, "x-faults: at must be fetch, complete or "
+                           "stage");
+                goto fail;
+            }
+            have_at = true;
+        } else if (!strcmp(key, "sq")) {
+            if (!strcmp(val, "any")) {
+                r->sq = H_SQ_ANY;
+            } else if (!strcmp(val, "io")) {
+                r->sq = H_SQ_IO;
+            } else if (!strcmp(val, "admin")) {
+                r->sq = 0;
+            } else if (h_num(key, val, UINT16_MAX, &v, errp)) {
+                r->sq = v;
+            } else {
+                goto fail;
+            }
+        } else if (!strcmp(key, "op")) {
+            int k;
+
+            for (k = 0; k < ARRAY_SIZE(h_ops); k++) {
+                if (!strcmp(val, h_ops[k].name)) {
+                    r->op = h_ops[k].op;
+                    if (r->sq == H_SQ_ANY) {
+                        r->sq = h_ops[k].io ? H_SQ_IO : 0;
+                    }
+                    break;
+                }
+            }
+            if (k == ARRAY_SIZE(h_ops)) {
+                if (!strcmp(val, "any")) {
+                    r->op = -1;
+                } else if (h_num(key, val, UINT8_MAX, &v, errp)) {
+                    r->op = v;
+                } else {
+                    goto fail;
+                }
+            }
+        } else if (!strcmp(key, "nsid")) {
+            if (!h_num(key, val, UINT32_MAX, &v, errp)) {
+                goto fail;
+            }
+            r->nsid = v;
+        } else if (!strcmp(key, "lba")) {
+            g_auto(GStrv) lh = g_strsplit(val, "-", 2);
+
+            if (!h_num(key, lh[0], UINT64_MAX, &r->lba_lo, errp) ||
+                !h_num(key, lh[1] ? lh[1] : lh[0], UINT64_MAX, &r->lba_hi,
+                       errp)) {
+                goto fail;
+            }
+            if (r->lba_hi < r->lba_lo) {
+                error_setg(errp, "x-faults: empty lba range \"%s\"", val);
+                goto fail;
+            }
+            r->has_lba = true;
+        } else if (!strcmp(key, "code")) {
+            if (!h_num(key, val, UINT32_MAX, &v, errp)) {
+                goto fail;
+            }
+            r->code = v;
+        } else if (!strcmp(key, "nth")) {
+            /* h_num() has set *errp on failure: do not set it again. */
+            if (!h_num(key, val, UINT32_MAX, &v, errp)) {
+                goto fail;
+            }
+            if (!v) {
+                error_setg(errp, "x-faults: nth must be at least 1");
+                goto fail;
+            }
+            r->nth = v;
+        } else if (!strcmp(key, "repeat")) {
+            if (!strcmp(val, "on")) {
+                r->repeat = true;
+            } else if (!strcmp(val, "off")) {
+                r->repeat = false;
+            } else {
+                error_setg(errp, "x-faults: repeat must be on or off");
+                goto fail;
+            }
+        } else if (!strcmp(key, "act")) {
+            g_auto(GStrv) names = g_strsplit(val, "+", -1);
+
+            for (int k = 0; names[k]; k++) {
+                int a;
+
+                for (a = 0; a < ARRAY_SIZE(h_acts); a++) {
+                    if (!strcmp(names[k], h_acts[a].name)) {
+                        r->acts |= h_acts[a].bit;
+                        break;
+                    }
+                }
+                if (a == ARRAY_SIZE(h_acts)) {
+                    error_setg(errp, "x-faults: unknown action \"%s\"",
+                               names[k]);
+                    goto fail;
+                }
+            }
+        } else if (!strcmp(key, "delay")) {
+            if (!h_num(key, val, INT32_MAX, &v, errp)) {
+                goto fail;
+            }
+            r->delay_ms = v;
+        } else if (!strcmp(key, "release")) {
+            for (r->release_on = 0;
+                 r->release_on < ARRAY_SIZE(h_rel_names); r->release_on++) {
+                if (!strcmp(val, h_rel_names[r->release_on])) {
+                    break;
+                }
+            }
+            if (r->release_on == ARRAY_SIZE(h_rel_names)) {
+                error_setg(errp, "x-faults: release must be manual, "
+                           "rdy0-ack or reopen");
+                goto fail;
+            }
+        } else if (!strcmp(key, "status")) {
+            if (!h_num(key, val, 0x7fff, &v, errp)) {
+                goto fail;
+            }
+            r->status = v;
+            r->has_status = true;
+        } else if (!strcmp(key, "dw0")) {
+            if (!h_num(key, val, UINT32_MAX, &v, errp)) {
+                goto fail;
+            }
+            r->dw0 = v;
+            r->has_dw0 = true;
+        } else if (!strcmp(key, "tag")) {
+            g_free(r->tag);
+            r->tag = g_strdup(val);
+        } else if (!strcmp(key, "armed")) {
+            if (!strcmp(val, "on")) {
+                r->armed = true;
+            } else if (!strcmp(val, "off")) {
+                r->armed = false;
+            } else {
+                error_setg(errp, "x-faults: armed must be on or off");
+                goto fail;
+            }
+        } else {
+            error_setg(errp, "x-faults: unknown key \"%s\"", key);
+            goto fail;
+        }
+    }
+    if (!have_at) {
+        error_setg(errp, "x-faults: rule \"%s\" has no at=", text);
+        goto fail;
+    }
+    if (!r->acts && !r->has_status && !r->has_dw0) {
+        error_setg(errp, "x-faults: rule \"%s\" has no act=", text);
+        goto fail;
+    }
+    if (r->at == H_AT_STAGE && (r->acts & (H_A_HOLD | H_A_DROP))) {
+        error_setg(errp, "x-faults: hold and drop need at=fetch or "
+                   "at=complete");
+        goto fail;
+    }
+    if (r->at != H_AT_COMPLETE && (r->has_status || r->has_dw0)) {
+        error_setg(errp, "x-faults: status= and dw0= need at=complete");
+        goto fail;
+    }
+    if ((r->acts & H_A_HOLD) && (r->acts & H_A_DROP)) {
+        error_setg(errp, "x-faults: hold and drop exclude each other");
+        goto fail;
+    }
+    if ((r->acts & (H_A_ARM | H_A_DISARM)) && !r->tag) {
+        error_setg(errp, "x-faults: arm and disarm need tag=");
+        goto fail;
+    }
+    if (r->at != H_AT_STAGE && (r->acts & H_A_RESET_CTRL)) {
+        /* Not from inside the controller's own queue processing. */
+        error_setg(errp, "x-faults: reset-controller needs at=stage");
+        goto fail;
+    }
+    return r;
+
+fail:
+    h_rule_free(r);
+    return NULL;
+}
+
+static bool h_set_rules(USB4Harness *h, const char *text, Error **errp)
+{
+    g_auto(GStrv) items = g_strsplit(text ? text : "", ";", -1);
+    GPtrArray *rules = g_ptr_array_new_with_free_func(h_rule_free);
+
+    for (int i = 0; items[i]; i++) {
+        char *t = g_strstrip(items[i]);
+        HRule *r;
+
+        if (!*t) {
+            continue;
+        }
+        r = h_parse_rule(t, errp);
+        if (!r) {
+            g_ptr_array_free(rules, true);
+            return false;
+        }
+        g_ptr_array_add(rules, r);
+    }
+    g_ptr_array_free(h->rules, true);
+    h->rules = rules;
+    g_free(h->rules_text);
+    h->rules_text = g_strdup(text ? text : "");
+    trace_usb4_h_rules(h_name(h), rules->len);
+    return true;
+}
+
+/* An I/O command with a starting LBA in CDW10-11 and NLB in CDW12. */
+static bool h_lba_op(uint8_t op)
+{
+    return op == 0x01 || op == 0x02 || op == 0x04 || op == 0x05 ||
+           op == 0x08 || op == 0x0c;
+}
+
+static bool h_match_cmd(HRule *r, const NvmeTestCmd *c)
+{
+    if (r->sq == H_SQ_IO ? c->sqid == 0 :
+        (r->sq != H_SQ_ANY && c->sqid != r->sq)) {
+        return false;
+    }
+    if (r->op >= 0 && c->opcode != r->op) {
+        return false;
+    }
+    if (r->nsid >= 0 && c->nsid != r->nsid) {
+        return false;
+    }
+    if (r->has_lba) {
+        uint64_t slba = c->cdw10 | (uint64_t)c->cdw11 << 32;
+        uint64_t last = slba + (c->cdw12 & 0xffff);
+
+        if (!c->sqid || !h_lba_op(c->opcode) ||
+            slba > r->lba_hi || last < r->lba_lo) {
+            return false;
+        }
+    }
+    return true;
+}
+
+/* ------------------------------------------------------------------ */
+/* Held commands                                                        */
+/* ------------------------------------------------------------------ */
+
+static void h_held_free(HHeld *e)
+{
+    g_free(e->tag);
+    g_free(e);
+}
+
+static void h_timer_arm(USB4Harness *h)
+{
+    int64_t next = INT64_MAX;
+
+    for (GList *l = h->held; l; l = l->next) {
+        HHeld *e = l->data;
+
+        if (e->deadline_ms >= 0 && e->deadline_ms < next) {
+            next = e->deadline_ms;
+        }
+    }
+    if (next == INT64_MAX) {
+        timer_del(h->timer);
+    } else {
+        timer_mod(h->timer, next);
+    }
+}
+
+/*
+ * Run the released commands to completion now: execute them, drain their
+ * block I/O and post their completions. Draining polls the main
+ * AioContext, which runs other bottom halves, so this takes part in the
+ * tunnel slots' lifecycle serialization (as the slot's quiesce does): no
+ * slot's quiesce, removal or insertion runs meanwhile, they are parked
+ * until it returns. nvme_test_flush() references the controller and
+ * re-validates it after every drain.
+ *
+ * Not from a hook callback or a debug-port write (cb_depth): there the
+ * released commands run from the controller's bottom half instead. The
+ * caller must not use @h afterwards (ending the serialization drops the
+ * bridge reference it took).
+ */
+static void h_flush(USB4Harness *h)
+{
+    USB4TunnelSlot *ts = h->ts;
+    PCIDevice *nvme = h->nvme;
+
+    if (!nvme || h->cb_depth) {
+        return;
+    }
+    if (h->in_bh) {
+        /* The slot's bottom half already holds the serialization. */
+        nvme_test_flush(nvme);
+        return;
+    }
+    if (!usb4_tunnel_slot_lifecycle_begin(ts)) {
+        /* A lifecycle step is draining: the controller's BH runs them. */
+        trace_usb4_h_flush(h_name(h), "deferred");
+        return;
+    }
+    nvme_test_flush(nvme);
+    usb4_tunnel_slot_lifecycle_end(ts);
+}
+
+/*
+ * Release the held commands @pred accepts. Outside an NVMe hook callback
+ * or debug-port write the released commands run to completion (data
+ * transfer and posted completion) before this returns; inside one they
+ * run from the controller's bottom half. Do not use @h after a call that
+ * may flush (cb_depth 0).
+ */
+static unsigned h_release_if(USB4Harness *h, bool (*pred)(HHeld *, void *),
+                             void *arg, const char *why)
+{
+    unsigned n = 0;
+    GList *l = h->held;
+
+    while (l) {
+        GList *next = l->next;
+        HHeld *e = l->data;
+
+        if (pred(e, arg)) {
+            trace_usb4_h_release(h_name(h), e->token, why);
+            if (h->nvme) {
+                nvme_test_release(h->nvme, e->token);
+            }
+            h->held = g_list_delete_link(h->held, l);
+            h_held_free(e);
+            n++;
+        }
+        l = next;
+    }
+    h_timer_arm(h);
+    if (n) {
+        h_flush(h);
+    }
+    return n;
+}
+
+static bool h_pred_all(HHeld *e, void *arg)
+{
+    return true;
+}
+
+static bool h_pred_rel(HHeld *e, void *arg)
+{
+    return e->release_on == *(int *)arg;
+}
+
+static bool h_pred_tag(HHeld *e, void *arg)
+{
+    return e->tag && !strcmp(e->tag, arg);
+}
+
+static bool h_pred_token(HHeld *e, void *arg)
+{
+    return e->token == *(uint64_t *)arg;
+}
+
+static bool h_pred_due(HHeld *e, void *arg)
+{
+    return e->deadline_ms >= 0 && e->deadline_ms <= *(int64_t *)arg;
+}
+
+static bool h_pred_hang(HHeld *e, void *arg)
+{
+    return e->by_hang;
+}
+
+static void h_timer_cb(void *opaque)
+{
+    USB4Harness *h = opaque;
+    int64_t now = h_now_ms();
+
+    h_release_if(h, h_pred_due, &now, "delay");
+}
+
+static void h_hold(USB4Harness *h, uint64_t token, HRule *r)
+{
+    HHeld *e = g_new0(HHeld, 1);
+
+    e->token = token;
+    e->deadline_ms = r && r->delay_ms >= 0 ? h_now_ms() + r->delay_ms : -1;
+    e->release_on = r ? r->release_on : H_REL_MANUAL;
+    e->tag = r && r->tag ? g_strdup(r->tag) : NULL;
+    e->by_hang = !r;
+    h->held = g_list_append(h->held, e);
+    trace_usb4_h_hold(h_name(h), token, e->deadline_ms,
+                      r ? h_rel_names[e->release_on] : "unhang",
+                      e->tag ? e->tag : "");
+    h_timer_arm(h);
+}
+
+static bool h_has_held(USB4Harness *h, int release_on)
+{
+    for (GList *l = h->held; l; l = l->next) {
+        if (((HHeld *)l->data)->release_on == release_on) {
+            return true;
+        }
+    }
+    return false;
+}
+
+/*
+ * Transient state that tracks the controller: what the guest last wrote
+ * to CC, the origins of the CSTS delays, the frozen CSTS of a hang, a
+ * deferred disable and the INTx level. Configured faults, rules, held
+ * commands and counters are not touched.
+ */
+static void h_reset_shadow(USB4Harness *h)
+{
+    if (h->defer) {
+        trace_usb4_h_defer(h_name(h), (uint32_t)h->defer_val,
+                           "discarded by reset");
+    }
+    h->cc = 0;
+    h->en_on_at = h->en_off_at = h->shn_at = -1;
+    h->stuck_valid = false;
+    h->defer = h->acked = h->defer_apply = false;
+    g_array_set_size(h->cc_queue, 0);
+    h->dev_level = h->suppress = false;
+}
+
+/* ------------------------------------------------------------------ */
+/* Actions                                                              */
+/* ------------------------------------------------------------------ */
+
+static void h_set_hang(USB4Harness *h, int mode)
+{
+    if (h->hang == mode) {
+        return;
+    }
+    trace_usb4_h_hang(h_name(h), h_hang_names[mode]);
+    h->hang = mode;
+    h->stuck_valid = false;
+    if (mode == H_HANG_OFF) {
+        h_release_if(h, h_pred_hang, NULL, "unhang");
+    }
+}
+
+/*
+ * Reopen the harness gate without resetting the endpoint, then release
+ * the commands held for release=reopen: outside a hook callback, before
+ * the guest can access the endpoint again (the BQL is held throughout).
+ */
+static void h_reopen(USB4Harness *h)
+{
+    int rel = H_REL_REOPEN;
+
+    usb4_tunnel_slot_set_harness_gate(h->ts, USB4_HGATE_NONE);
+    h_release_if(h, h_pred_rel, &rel, "reopen");
+}
+
+/*
+ * act=reopen from a hook callback or a debug-port write, where the
+ * release=reopen commands cannot be run to completion. The gate stays
+ * closed until the slot's bottom half has reopened it and run them, so
+ * the guest still cannot see the endpoint before they completed.
+ */
+static void h_reopen_deferred(USB4Harness *h)
+{
+    if (!h_has_held(h, H_REL_REOPEN)) {
+        usb4_tunnel_slot_set_harness_gate(h->ts, USB4_HGATE_NONE);
+        return;
+    }
+    h->reopen_pending = true;
+    trace_usb4_h_flush(h_name(h), "reopen deferred to the slot BH");
+    usb4_tunnel_slot_schedule(h->ts);
+}
+
+/*
+ * Arm (or disarm) the rules tagged like @r. Every arming restarts their
+ * match count, already armed or not, so nth= counts from the latest
+ * arming trigger and a spent one-shot rule fires again.
+ */
+static void h_arm(USB4Harness *h, HRule *r, bool on)
+{
+    for (unsigned i = 0; i < h->rules->len; i++) {
+        HRule *t = g_ptr_array_index(h->rules, i);
+
+        if (t != r && t->tag && !strcmp(t->tag, r->tag)) {
+            if (on) {
+                t->matched = 0;
+            }
+            t->armed = on;
+        }
+    }
+}
+
+/*
+ * act=reset-controller, from a debug-port write (at=stage only): reset
+ * the controller now, as CC.EN going to 0 would, before the write
+ * returns. The reset drains the controller's block I/O like the guest's
+ * own CC write does; it runs inside the slots' lifecycle serialization,
+ * so the endpoint cannot be removed under it.
+ */
+static void h_reset_controller(USB4Harness *h)
+{
+    PCIDevice *nvme = h->nvme;
+
+    if (!nvme) {
+        return;
+    }
+    if (!usb4_tunnel_slot_lifecycle_begin(h->ts)) {
+        trace_usb4_h_flush(h_name(h), "reset-controller skipped: a "
+                           "lifecycle step is running");
+        return;
+    }
+    nvme_test_reset_controller(nvme);
+    if (h->nvme == nvme) {
+        /* The guest did not write CC: CSTS shows the reset as it is. */
+        h_reset_shadow(h);
+    }
+    /* The bridge is still referenced by its parent bus: @h stays. */
+    usb4_tunnel_slot_lifecycle_end(h->ts);
+}
+
+static void h_do_actions(USB4Harness *h, HRule *r)
+{
+    USB4TunnelSlot *ts = h->ts;
+    uint32_t a = r->acts;
+
+    if (a & H_A_ARM) {
+        h_arm(h, r, true);
+    }
+    if (a & H_A_DISARM) {
+        h_arm(h, r, false);
+    }
+    if (a & H_A_RESET_CTRL) {
+        h_reset_controller(h);
+    }
+    if (a & H_A_CFS) {
+        h->cfs = true;
+    }
+    if (a & H_A_HANG_STUCK) {
+        h_set_hang(h, H_HANG_STUCK);
+    }
+    if (a & H_A_HANG_ONES) {
+        h_set_hang(h, H_HANG_ONES);
+    }
+    if (a & H_A_UNHANG) {
+        h_set_hang(h, H_HANG_OFF);
+    }
+    if (a & H_A_GATE) {
+        usb4_tunnel_slot_set_harness_gate(ts, USB4_HGATE_CLOSED);
+    }
+    if (a & H_A_READS_FAIL) {
+        usb4_tunnel_slot_set_harness_gate(ts, USB4_HGATE_READS_FAIL);
+    }
+    if (a & H_A_SURPRISE) {
+        usb4_tunnel_slot_set_state(ts, NULL, USB4_TUNNEL_DOWN,
+                                   USB4_TUNNEL_REASON_SURPRISE);
+    }
+    if (a & H_A_EJECT) {
+        usb4_tunnel_slot_set_state(ts, NULL, USB4_TUNNEL_DOWN,
+                                   USB4_TUNNEL_REASON_EJECT);
+    }
+    if (a & H_A_ADMIN_DOWN) {
+        usb4_tunnel_slot_set_state(ts, NULL, USB4_TUNNEL_DOWN,
+                                   USB4_TUNNEL_REASON_ADMIN_DOWN);
+    }
+    if (a & H_A_RELEASE) {
+        if (r->tag) {
+            h_release_if(h, h_pred_tag, r->tag, "rule");
+        } else {
+            h_release_if(h, h_pred_all, NULL, "rule");
+        }
+    }
+    if (a & H_A_REOPEN) {
+        h_reopen_deferred(h);
+    }
+}
+
+static char *h_acts_str(HRule *r)
+{
+    GString *s = g_string_new("");
+
+    for (int a = 0; a < ARRAY_SIZE(h_acts); a++) {
+        if (r->acts & h_acts[a].bit) {
+            g_string_append_printf(s, "%s%s", s->len ? "+" : "",
+                                   h_acts[a].name);
+        }
+    }
+    if (r->has_status) {
+        g_string_append_printf(s, "%sstatus=0x%x", s->len ? "+" : "",
+                               r->status);
+    }
+    if (r->has_dw0) {
+        g_string_append_printf(s, "%sdw0=0x%x", s->len ? "+" : "", r->dw0);
+    }
+    return g_string_free(s, false);
+}
+
+/*
+ * Evaluate the rules for one trigger. For NVMe triggers returns the
+ * combined hold/drop decision (drop beats hold) and applies status and
+ * dw0 overrides; side actions run here, synchronously.
+ */
+static NvmeTestAction h_eval(USB4Harness *h, int at, const NvmeTestCmd *c,
+                             uint32_t code, uint16_t *status, uint32_t *dw0)
+{
+    NvmeTestAction act = NVME_TEST_PASS;
+    HRule *hold_rule = NULL;
+    GPtrArray *rules = h->rules;
+
+    /* Actions may replace the rule set (they do not today); pin it. */
+    g_ptr_array_ref(rules);
+    for (unsigned i = 0; i < rules->len; i++) {
+        HRule *r = g_ptr_array_index(rules, i);
+        g_autofree char *acts = NULL;
+        g_autofree char *path = NULL;
+        uint64_t token = c ? c->token : 0;
+
+        if (r->at != at || !r->armed) {
+            continue;
+        }
+        if (at == H_AT_STAGE ? (r->code >= 0 && r->code != code) :
+            !h_match_cmd(r, c)) {
+            continue;
+        }
+        r->matched++;
+        if (r->matched < r->nth || (!r->repeat && r->matched > r->nth)) {
+            continue;
+        }
+        r->fired++;
+        acts = h_acts_str(r);
+        trace_usb4_h_fire(h_name(h), i, h_at_names[at], token,
+                          c ? c->opcode : 0, code, acts,
+                          qemu_clock_get_ns(QEMU_CLOCK_HOST),
+                          qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL));
+        path = object_get_canonical_path(OBJECT(h->ts->bridge));
+        qapi_event_send_usb4_harness(path, i, h_at_names[at], token, acts);
+
+        if (r->has_status && status) {
+            *status = r->status;
+        }
+        if (r->has_dw0 && dw0) {
+            *dw0 = r->dw0;
+        }
+        if (r->acts & H_A_DROP) {
+            act = NVME_TEST_DROP;
+        } else if ((r->acts & H_A_HOLD) && act == NVME_TEST_PASS) {
+            act = NVME_TEST_HOLD;
+            hold_rule = r;
+        }
+        h_do_actions(h, r);
+    }
+    if (act == NVME_TEST_HOLD) {
+        h_hold(h, c->token, hold_rule);
+    }
+    g_ptr_array_unref(rules);
+    return act;
+}
+
+/* ------------------------------------------------------------------ */
+/* NVMe hook                                                            */
+/* ------------------------------------------------------------------ */
+
+static NvmeTestAction h_fetched(void *opaque, PCIDevice *dev,
+                                const NvmeTestCmd *c)
+{
+    USB4Harness *h = opaque;
+    NvmeTestAction act;
+
+    if (h->hang != H_HANG_OFF) {
+        /* A hung controller executes nothing more. */
+        h_hold(h, c->token, NULL);
+        return NVME_TEST_HOLD;
+    }
+    h->cb_depth++;
+    act = h_eval(h, H_AT_FETCH, c, 0, NULL, NULL);
+    h->cb_depth--;
+    return act;
+}
+
+static NvmeTestAction h_completing(void *opaque, PCIDevice *dev,
+                                   const NvmeTestCmd *c, uint16_t *status,
+                                   uint32_t *dw0)
+{
+    USB4Harness *h = opaque;
+    NvmeTestAction act;
+
+    if (h->hang != H_HANG_OFF) {
+        h_hold(h, c->token, NULL);
+        return NVME_TEST_HOLD;
+    }
+    h->cb_depth++;
+    act = h_eval(h, H_AT_COMPLETE, c, 0, status, dw0);
+    h->cb_depth--;
+    return act;
+}
+
+/* The 32-bit register at @reg lies entirely inside the access. */
+static bool h_covers(hwaddr addr, unsigned size, hwaddr reg)
+{
+    return addr <= reg && reg + 4 <= addr + size;
+}
+
+static uint32_t h_get32(uint64_t val, hwaddr addr, hwaddr reg)
+{
+    return val >> ((reg - addr) * 8);
+}
+
+static uint64_t h_put32(uint64_t val, hwaddr addr, hwaddr reg, uint32_t r)
+{
+    unsigned sh = (reg - addr) * 8;
+
+    return (val & ~((uint64_t)UINT32_MAX << sh)) | ((uint64_t)r << sh);
+}
+
+/* A configured delay since @at has not yet run out (or never will). */
+static bool h_pending(int32_t delay, int64_t at, int64_t now)
+{
+    return at >= 0 && delay && (delay < 0 || now < at + delay);
+}
+
+/* CSTS as the faults make the guest see it. */
+static uint32_t h_csts(USB4Harness *h, uint32_t real)
+{
+    int64_t now = h_now_ms();
+    uint32_t csts = real;
+
+    if (h->hang == H_HANG_STUCK) {
+        if (!h->stuck_valid) {
+            h->stuck_csts = real;
+            h->stuck_valid = true;
+        }
+        return h->stuck_csts;
+    }
+    if (h->defer) {
+        /* The disable is deferred: the controller still runs. */
+        csts &= ~H_CSTS_RDY;
+    }
+    if (h_pending(h->rdy_set_delay_ms, h->en_on_at, now)) {
+        csts &= ~H_CSTS_RDY;
+    }
+    if (h_pending(h->rdy_clear_delay_ms, h->en_off_at, now)) {
+        csts |= H_CSTS_RDY;
+    }
+    if (h_pending(h->shst_delay_ms, h->shn_at, now) &&
+        H_CSTS_SHST(csts) == H_SHST_COMPLETE) {
+        csts = (csts & ~(3u << 2)) | (H_SHST_OCCURRING << 2);
+    }
+    if (h->cfs) {
+        csts |= H_CSTS_CFS;
+    }
+    return csts;
+}
+
+/*
+ * A deferred disable ends: let the slot's bottom half finish it. Never
+ * drains here: this runs from MMIO callbacks.
+ */
+static void h_defer_request(USB4Harness *h)
+{
+    h->defer_apply = true;
+    usb4_tunnel_slot_schedule(h->ts);
+}
+
+/*
+ * End a deferred disable, from the slot's bottom half: run the commands
+ * released at the guest's RDY=0 acknowledgement to completion, then apply
+ * the CC write the controller has not seen yet (which resets it, and
+ * discards whatever is still held) and any CC writes queued behind it,
+ * in order.
+ */
+static void h_defer_finish(USB4Harness *h)
+{
+    PCIDevice *nvme = h->nvme;
+
+    if (!h->defer || !nvme) {
+        return;
+    }
+    if (!nvme_test_flush(nvme) || h->nvme != nvme || !h->defer) {
+        /* Reset or removed while draining: the write has no target. */
+        trace_usb4_h_flush(h_name(h), "deferred disable overtaken");
+        return;
+    }
+    h->defer = false;
+    trace_usb4_h_defer(h_name(h), (uint32_t)h->defer_val, "applied");
+    nvme_test_mmio_write(nvme, H_REG_CC, h->defer_val, h->defer_size);
+    for (unsigned i = 0; i < h->cc_queue->len; i++) {
+        HCCWrite *w = &g_array_index(h->cc_queue, HCCWrite, i);
+
+        trace_usb4_h_defer(h_name(h), (uint32_t)w->val, "applied queued");
+        nvme_test_mmio_write(nvme, H_REG_CC, w->val, w->size);
+    }
+    g_array_set_size(h->cc_queue, 0);
+}
+
+static uint64_t h_mmio_read(void *opaque, PCIDevice *dev, hwaddr addr,
+                            unsigned size, uint64_t val)
+{
+    USB4Harness *h = opaque;
+
+    if (h->hang == H_HANG_ONES) {
+        return MAKE_64BIT_MASK(0, size * 8);
+    }
+    if (h->defer && h_covers(addr, size, H_REG_CC)) {
+        /* The CC value the guest wrote last. */
+        uint64_t cc = h->cc_queue->len ?
+            g_array_index(h->cc_queue, HCCWrite, h->cc_queue->len - 1).val :
+            h->defer_val;
+
+        val = h_put32(val, addr, H_REG_CC, cc);
+    }
+    if (h_covers(addr, size, H_REG_CSTS)) {
+        uint32_t real = h_get32(val, addr, H_REG_CSTS);
+        uint32_t shown = h_csts(h, real);
+
+        if (shown != real) {
+            trace_usb4_h_csts(h_name(h), real, shown);
+        }
+        val = h_put32(val, addr, H_REG_CSTS, shown);
+        if (h->defer && !h->acked && !(shown & H_CSTS_RDY)) {
+            int rel = H_REL_RDY0_ACK;
+
+            /*
+             * The driver acknowledged the disable (RDY=0 seen): release
+             * the commands now (they start from the controller's bottom
+             * half), the slot's bottom half completes them.
+             */
+            h->acked = true;
+            trace_usb4_h_defer(h_name(h), (uint32_t)h->defer_val,
+                               "rdy0-ack");
+            h->cb_depth++;
+            h_release_if(h, h_pred_rel, &rel, "rdy0-ack");
+            h->cb_depth--;
+            h_defer_request(h);
+        }
+    }
+    return val;
+}
+
+static bool h_mmio_write(void *opaque, PCIDevice *dev, hwaddr addr,
+                         uint64_t val, unsigned size)
+{
+    USB4Harness *h = opaque;
+    int64_t now = h_now_ms();
+    bool queue = h->defer;
+    uint32_t old, cc;
+
+    if (h->marker_db && addr == h->marker_db) {
+        h->markers++;
+        trace_usb4_h_marker(h_name(h), h->markers, (uint32_t)val,
+                            qemu_clock_get_ns(QEMU_CLOCK_HOST),
+                            qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL));
+        return false;
+    }
+    if (h->hang != H_HANG_OFF) {
+        return false;
+    }
+    if (addr != H_REG_CC) {
+        return true;
+    }
+    old = h->cc;
+    cc = val;
+    h->cc = cc;
+    if (!(old & H_CC_EN) && (cc & H_CC_EN)) {
+        h->en_on_at = now;
+        h->en_off_at = -1;
+    } else if ((old & H_CC_EN) && !(cc & H_CC_EN)) {
+        h->en_off_at = now;
+        h->en_on_at = -1;
+        if (!queue && h_has_held(h, H_REL_RDY0_ACK)) {
+            /*
+             * Keep the controller running (and the held command alive)
+             * until the driver has seen RDY=0: CSTS reads show the
+             * disable, the controller does not see it yet.
+             */
+            h->defer = true;
+            h->acked = false;
+            h->defer_val = val;
+            h->defer_size = size;
+            trace_usb4_h_defer(h_name(h), cc, "deferred");
+            return false;
+        }
+    }
+    if (H_CC_SHN(cc) && !H_CC_SHN(old)) {
+        h->shn_at = now;
+    } else if (!H_CC_SHN(cc)) {
+        h->shn_at = -1;
+    }
+    if (queue) {
+        /*
+         * A further CC write while a disable is deferred ends it: the
+         * deferred write is applied first, then this one; the slot's
+         * bottom half applies both, in order. Without an acknowledgement
+         * before it, the guest never saw RDY=0: its held commands are not
+         * released and go with the reset.
+         */
+        HCCWrite w = { .val = val, .size = size };
+
+        g_array_append_val(h->cc_queue, w);
+        trace_usb4_h_defer(h_name(h), cc, h->acked ? "queued" :
+                           "queued, held commands go with the reset");
+        h->acked = true;
+        h_defer_request(h);
+        return false;
+    }
+    return true;
+}
+
+static bool h_intx(void *opaque, PCIDevice *dev, bool level)
+{
+    USB4Harness *h = opaque;
+
+    if (level && !h->dev_level) {
+        uint64_t n = ++h->intx_asserts;
+
+        if ((h->intx_every && n % h->intx_every == 0) ||
+            (h->intx_from && n >= h->intx_from && n <= h->intx_to)) {
+            /* Lost: the pin stays low until the controller deasserts. */
+            h->intx_dropped++;
+            h->suppress = true;
+            trace_usb4_h_intx_drop(h_name(h), n);
+        }
+    }
+    if (!level) {
+        h->suppress = false;
+    }
+    h->dev_level = level;
+    return level && !h->suppress;
+}
+
+static void h_dropped(void *opaque, PCIDevice *dev, uint64_t token)
+{
+    USB4Harness *h = opaque;
+
+    for (GList *l = h->held; l; l = l->next) {
+        HHeld *e = l->data;
+
+        if (e->token == token) {
+            trace_usb4_h_release(h_name(h), token, "discarded by reset");
+            h->held = g_list_delete_link(h->held, l);
+            h_held_free(e);
+            break;
+        }
+    }
+    h_timer_arm(h);
+}
+
+static void h_forget_nvme(USB4Harness *h)
+{
+    h->nvme = NULL;
+    g_list_free_full(h->held, (GDestroyNotify)h_held_free);
+    h->held = NULL;
+    timer_del(h->timer);
+    h->defer = h->acked = h->defer_apply = false;
+    g_array_set_size(h->cc_queue, 0);
+}
+
+/*
+ * The controller was reset. A function-level reset (FLR, PCI reset, the
+ * slot's quiesce) clears CC behind the guest's back: forget what the
+ * guest wrote before, restart the delay origins, unfreeze a stuck CSTS
+ * and drop a deferred disable. A controller reset by CC.EN=0 was seen as
+ * a write already. Held commands were discarded through h_dropped().
+ */
+static void h_reset(void *opaque, PCIDevice *dev, bool function)
+{
+    USB4Harness *h = opaque;
+
+    if (h->nvme != dev || !function) {
+        return;
+    }
+    trace_usb4_h_reset(h_name(h));
+    h_reset_shadow(h);
+}
+
+static void h_detach(void *opaque, PCIDevice *dev)
+{
+    USB4Harness *h = opaque;
+
+    if (h->nvme == dev) {
+        h_forget_nvme(h);
+    }
+}
+
+static const NvmeTestHookOps h_hook_ops = {
+    .fetched = h_fetched,
+    .completing = h_completing,
+    .mmio_read = h_mmio_read,
+    .mmio_write = h_mmio_write,
+    .intx = h_intx,
+    .dropped = h_dropped,
+    .detach = h_detach,
+    .reset = h_reset,
+};
+
+/* ------------------------------------------------------------------ */
+/* Lifetime                                                             */
+/* ------------------------------------------------------------------ */
+
+static USB4Harness *h_of_slot(USB4TunnelSlot *ts)
+{
+    USB4Harness *h = ts->harness;
+
+    if (h) {
+        return h;
+    }
+    h = g_new0(USB4Harness, 1);
+    h->ts = ts;
+    h->rules = g_ptr_array_new_with_free_func(h_rule_free);
+    h->rules_text = g_strdup("");
+    h->timer = timer_new_ms(QEMU_CLOCK_VIRTUAL, h_timer_cb, h);
+    h->cc_queue = g_array_new(false, false, sizeof(HCCWrite));
+    h->en_on_at = h->en_off_at = h->shn_at = -1;
+    /*
+     * Not on h_all yet: a property may be set on a bridge that is never
+     * realized (or fails to). usb4_harness_realize() publishes it.
+     */
+    ts->harness = h;
+    return h;
+}
+
+static USB4Harness *h_of(Object *obj)
+{
+    return h_of_slot(usb4_tunnel_slot_from_object(obj));
+}
+
+void usb4_harness_realize(USB4TunnelSlot *ts)
+{
+    USB4Harness *h = h_of_slot(ts);
+
+    if (!g_slist_find(h_all, h)) {
+        h_all = g_slist_prepend(h_all, h);
+    }
+}
+
+void usb4_harness_attach(USB4TunnelSlot *ts, PCIDevice *nvme)
+{
+    USB4Harness *h = h_of_slot(ts);
+
+    h_forget_nvme(h);
+    h->nvme = nvme;
+    h_reset_shadow(h);
+    nvme_test_set_hook(nvme, &h_hook_ops, h);
+    trace_usb4_h_attach(h_name(h), object_get_typename(OBJECT(nvme)));
+}
+
+void usb4_harness_endpoint_gone(USB4TunnelSlot *ts)
+{
+    if (ts->harness) {
+        h_forget_nvme(ts->harness);
+    }
+}
+
+void usb4_harness_free(USB4TunnelSlot *ts)
+{
+    USB4Harness *h = ts->harness;
+
+    if (!h) {
+        return;
+    }
+    h_all = g_slist_remove(h_all, h);
+    if (h->nvme) {
+        nvme_test_set_hook(h->nvme, NULL, NULL);
+    }
+    h_forget_nvme(h);
+    timer_free(h->timer);
+    g_array_free(h->cc_queue, true);
+    g_ptr_array_free(h->rules, true);
+    g_free(h->rules_text);
+    g_free(h);
+    ts->harness = NULL;
+}
+
+void usb4_harness_stage(uint32_t code, uint32_t arg)
+{
+    GSList *l, *all = g_slist_copy(h_all);
+
+    h_stages++;
+    for (l = all; l; l = l->next) {
+        USB4Harness *h = l->data;
+
+        /* Only slots that are realized and not yet torn down. */
+        if (g_slist_find(h_all, h) && h->ts->bh) {
+            /* An I/O port write: no draining, see h_flush(). */
+            h->cb_depth++;
+            h_eval(h, H_AT_STAGE, NULL, code, NULL, NULL);
+            h->cb_depth--;
+        }
+    }
+    g_slist_free(all);
+}
+
+bool usb4_harness_has_work(USB4TunnelSlot *ts)
+{
+    USB4Harness *h = ts->harness;
+
+    return h && (h->reopen_pending || h->defer_apply);
+}
+
+void usb4_harness_bh_work(USB4TunnelSlot *ts)
+{
+    USB4Harness *h = ts->harness;
+
+    if (!h) {
+        return;
+    }
+    h->in_bh = true;
+    if (h->reopen_pending) {
+        h->reopen_pending = false;
+        h_reopen(h);
+    }
+    if (h->defer_apply) {
+        h->defer_apply = false;
+        h_defer_finish(h);
+    }
+    h->in_bh = false;
+}
