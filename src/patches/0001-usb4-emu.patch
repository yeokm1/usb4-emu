+    qts = switch_start("", "dialect=usb4,device-model=asm2464");
+    g_assert_cmphex(cfg_rd(qts, 3, 0, 0), ==, 0x15bf8086);
+    g_assert_cmphex(cfg_rd(qts, 5, 0, 0), ==, 0x15c18086);
