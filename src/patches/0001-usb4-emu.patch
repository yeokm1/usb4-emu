+/*
+ * The xhci property must name an xHCI controller with a USB bus (review
+ * P2): anything else is a configuration error, not an assertion.
+ */
+static void test_xhci_property(void)
+{
+    QTestState *qts = qtest_init("-machine pc "
+                                 "-device usb4-tunnel-bridge,id=tp0,"
+                                 "bus=pci.0,addr=0x5,chassis_nr=1 "
+                                 "-device qemu-xhci,id=x0,bus=pci.0,"
+                                 "addr=0x6");
+    QDict *rsp;
+
+    rsp = qtest_qmp(qts, "{'execute': 'device_add', 'arguments': "
+                    "{'driver': 'usb4-host', 'bus': 'pci.0', 'id': 'u4', "
+                    "'profile': 'tb3-alpine-ridge', 'xhci': 'tp0'}}");
+    g_assert_true(qdict_haskey(rsp, "error"));
+    g_assert_nonnull(strstr(qdict_get_str(qdict_get_qdict(rsp, "error"),
+                                          "desc"), "xhci=tp0"));
+    qobject_unref(rsp);
+    rsp = qtest_qmp(qts, "{'execute': 'device_add', 'arguments': "
+                    "{'driver': 'usb4-host', 'bus': 'pci.0', 'id': 'u4', "
+                    "'profile': 'tb3-alpine-ridge', 'xhci': 'nosuch'}}");
+    g_assert_true(qdict_haskey(rsp, "error"));
+    qobject_unref(rsp);
+    /* any xHCI with a USB bus is accepted */
+    qtest_qmp_assert_success(qts, "{'execute': 'device_add', 'arguments': "
+                             "{'driver': 'usb4-host', 'bus': 'pci.0', "
+                             "'id': 'u4', 'profile': 'tb3-alpine-ridge', "
+                             "'xhci': 'x0'}}");
+    qtest_quit(qts);
+}
+
+static void test_device_user(void)
+{
+    uint32_t w[64], cmd[6], uuid[4];
+    unsigned n, id, id2;
+    T *t = t_start(NULL, true);
+
+    icm_bind(t, w);
+    /* R8, R12: the attached device is announced, not approved */
+    n = icm_expect(t, PDF_ICM_EVENT, w);
+    id = check_connected(w, n, false, false, uuid);
+    icm_expect_none(t);
+    g_assert_false(gate_open(t->qts));
+
+    /* R9: get route as captured (T:833) */
+    cmd[0] = 0x0000000a;
+    cmd[1] = 0x00110000;
+    icm_cmd(t, cmd, 2);
+    g_assert_cmpuint(icm_expect(t, PDF_ICM_RESP, w), ==, 4);
+    g_assert_cmphex(w[0], ==, 0x0100000a);
+    g_assert_cmphex(w[1], ==, 0x00110000);
+    g_assert_cmphex(w[2], ==, 0);
+    g_assert_cmphex(w[3], ==, 1);
+
+    /*
+     * R31: the firmware owns paths and PCIe Path Enable. A guest write
+     * to the host PCIe Down adapter's HopID 8 path entry or to its
+     * protocol capability (tb3: dword 0x39) is answered but ignored.
+     */
+    {
+        uint32_t f[5], dw3;
+
+        dw3 = (2 * 8) | (2u << 13) | (4u << 19) | (0u << 25);
+        f[0] = 0; f[1] = 0; f[2] = dw3;
+        f[3] = 0x80000000 | (1u << 11) | 8; f[4] = 0x03000301;
+        tx_frame(t, 2, f, 5);
+        g_assert_cmpuint(icm_expect(t, 2, w), ==, 3);
+        f[2] = (2 * 8) | (2u << 13) | (4u << 19);
+        tx_frame(t, 1, f, 3);
+        g_assert_cmpuint(icm_expect(t, 1, w), ==, 5);
+        g_assert_cmphex(w[3], ==, 0);
+        dw3 = 0x39 | (1u << 13) | (4u << 19) | (1u << 25);
+        f[2] = dw3;
+        f[3] = 0x80000000;
+        tx_frame(t, 2, f, 4);
+        g_assert_cmpuint(icm_expect(t, 2, w), ==, 3);
+        tx_frame(t, 1, f, 3);
+        g_assert_cmpuint(icm_expect(t, 1, w), ==, 4);
+        g_assert_cmphex(w[3] & 0x80000000, ==, 0);
+        g_assert_false(gate_open(t->qts));
+    }
+
+    /* R10: a stale id fails */
+    cmd[0] = 0x00000004;
+    memcpy(&cmd[1], uuid, 16);
+    cmd[5] = 0x10 | (((id + 1) & 0xff) << 8);
+    icm_cmd(t, cmd, 6);
+    icm_expect(t, PDF_ICM_RESP, w);
+    g_assert_cmphex(w[0], ==, 0x01000104);
+    g_assert_false(gate_open(t->qts));
+
+    /* R10, R22: approve brings the tunnel up before the response */
+    cmd[5] = 0x10 | (id << 8);
+    icm_cmd(t, cmd, 6);
+    g_assert_cmpuint(icm_expect(t, PDF_ICM_RESP, w), ==, 6);
+    g_assert_cmphex(w[0], ==, 0x01000004);
+    g_assert_cmpmem(&w[1], 20, &cmd[1], 20);
+    g_assert_true(gate_open(t->qts));
+    wait_stage(t->qts, "inserted");
+    /* approving again succeeds */
+    icm_cmd(t, cmd, 6);
+    icm_expect(t, PDF_ICM_RESP, w);
+    g_assert_cmphex(w[0], ==, 0x01000004);
+
+    /* 2.3, R12: driver unloads, rebind re-announces, tunnel kept */
+    rings_stop(t);
+    g_assert_cmphex(mailbox(t, 0x07), ==, 0x07);
+    g_assert_true(gate_open(t->qts));
+    icm_bind(t, w);
+    n = icm_expect(t, PDF_ICM_EVENT, w);
+    id2 = check_connected(w, n, true, false, uuid);
+    g_assert_cmpuint(id2, !=, id);
+    g_assert_true(gate_open(t->qts));
+
+    /* R3, R22: mailbox 0x06 closes the gate synchronously */
+    g_assert_cmphex(mailbox(t, 0x06), ==, 0x06);
+    g_assert_false(gate_open(t->qts));
+
+    /* R13: unplug sends device disconnected (T:21087) */
+    qtest_qmp_device_del_send(t->qts, "d0");
+    n = icm_expect(t, PDF_ICM_EVENT, w);
+    g_assert_cmpuint(n, ==, 2);
+    g_assert_cmphex(w[0], ==, 0x01000004);
+    g_assert_cmphex(w[1], ==, 0x00110000);
+    t_stop(t);
+}
+
+static void test_device_none(void)
+{
+    uint32_t w[64], uuid[4], cmd[3];
+    unsigned n;
+    T *t = t_start(",security=none", true);
+
+    /*
+     * R22: the tunnel exists before any driver, and the machine reset
+     * does not flap it: the endpoint is the cold-plugged first one.
+     */
+    g_assert_true(gate_opens(t->qts));
+    {
+        g_autofree char *st = endpoint_state(t->qts);
+
+        g_assert_nonnull(strstr(st, "gen=1 "));
+    }
+    icm_bind(t, w);
+    n = icm_expect(t, PDF_ICM_EVENT, w);
+    check_connected(w, n, true, false, uuid);
+
+    /* R12, R13: unloaded driver hears nothing about an unplug */
+    rings_stop(t);
+    mailbox(t, 0x07);
+    qtest_qmp_device_del_send(t->qts, "d0");
+    g_assert_false(gate_open(t->qts));
+    icm_bind(t, w);
+    icm_expect_none(t);
+
+    /* hot plug while the driver is ready: announced approved */
+    qtest_qmp_device_add(t->qts, "usb4-device", "d1",
+                         "{'bus': 'u4.0', 'port': 1, 'dialect': %s, "
+                         "'drive': 'disk0', 'serial': 'QTICM2', "
+                         "'vendor-name': 'CalDigit, Inc.', "
+                         "'model-name': 'TS3 Plus'}", dialect());
+    n = icm_expect(t, PDF_ICM_EVENT, w);
+    check_connected(w, n, true, true, uuid);
+    g_assert_true(gate_opens(t->qts));
+
+    /*
+     * The client then reads the new router (ICM-PROTOCOL.md 5.5): a
+     * router config read of route 1 (Spec Table 6-2) must be answered,
+     * not refused, after an unplug and re-plug.
+     */
+    cmd[0] = 0;
+    cmd[1] = 1;
+    cmd[2] = 0 | (1u << 13) | (2u << 25);
+    tx_frame(t, 1, cmd, 3);
+    g_assert_cmpuint(icm_expect(t, 1, w), ==, 4);
+    g_assert_cmphex(w[3], ==, 0x15d38086);
+    t_stop(t);
+}
+
+/*
+ * R25, R26: pre-boot approval at power-on. Every attached device is
+ * tunnelled, in the boot ACL or not (ICM-PROTOCOL.md 13.2); with
+ * preboot-acl-only=on only boot-ACL devices.
+ */
+static void test_preboot(void)
+{
+    uint32_t w[64], uuid[4];
+    uint8_t b[8];
+    g_autofree char *opts = NULL;
+    unsigned n;
+    T *t = t_start(",preboot=on", true);
+
+    /* empty ACL: approved and tunnelled anyway, boot bit (R2) */
+    g_assert_true(gate_opens(t->qts));
+    icm_bind(t, w);
+    n = icm_expect(t, PDF_ICM_EVENT, w);
+    check_connected(w, n, true, false, uuid);
+    g_assert_cmphex(w[5] >> 16, ==, 0x0d11);       /* approved + boot */
+    t_stop(t);
+
+    /* ACL-only model: not approved, no tunnel, boot bit still set */
+    t = t_start(",preboot=on,preboot-acl-only=on", true);
+    icm_bind(t, w);
+    n = icm_expect(t, PDF_ICM_EVENT, w);
+    check_connected(w, n, false, false, uuid);
+    g_assert_cmphex(w[5] >> 16, ==, 0x0c11);
+    g_assert_false(gate_open(t->qts));
+    t_stop(t);
+
+    /* the same device in the ACL (sysfs unique_id form) */
+    stl_le_p(b, uuid[0]);
+    stl_le_p(b + 4, uuid[1]);
+    opts = g_strdup_printf(",preboot=on,preboot-acl-only=on,boot-acl="
+                           "%02x%02x%02x%02x-%02x%02x-%02x%02x-ffff-"
+                           "ffffffffffff",
+                           b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7]);
+    t = t_start(opts, true);
+    g_assert_true(gate_opens(t->qts));
+    {
+        g_autofree char *st = endpoint_state(t->qts);
+
+        g_assert_nonnull(strstr(st, "gen=1 "));    /* cold plug */
+    }
+    icm_bind(t, w);
+    n = icm_expect(t, PDF_ICM_EVENT, w);
+    check_connected(w, n, true, false, uuid);
+    g_assert_cmphex(w[5] >> 16, ==, 0x0d11);       /* approved + boot */
+    /* the ACL read back holds the property's entry */
+    {
+        uint32_t cmd[33] = { 0x00000018 };
+
+        icm_cmd(t, cmd, 33);
+        icm_expect(t, PDF_ICM_RESP, w);
+        g_assert_cmphex(w[1], ==, uuid[0]);
+        g_assert_cmphex(w[2], ==, uuid[1]);
+    }
+    /*
+     * a hot plug is never auto-approved, but announced with the boot bit
+     * while pre-boot is on (R2-T:130.710, 0x0c110210)
+     */
+    qtest_qmp_device_del_send(t->qts, "d0");
+    icm_expect(t, PDF_ICM_EVENT, w);
+    qtest_qmp_device_add(t->qts, "usb4-device", "d0",
+                         "{'bus': 'u4.0', 'port': 1, 'dialect': %s, "
+                         "'drive': 'disk0', 'serial': 'QTICM'}", dialect());
+    n = icm_expect(t, PDF_ICM_EVENT, w);
+    check_connected(w, n, false, false, uuid);
+    g_assert_cmphex(w[5] >> 16, ==, 0x0c11);
+    t_stop(t);
+
+    /* pre-boot off: the ACL has no effect (R14) */
+    g_free(opts);
+    opts = g_strdup_printf(",preboot=off,boot-acl=%02x%02x%02x%02x-%02x%02x-"
+                           "%02x%02x-ffff-ffffffffffff",
+                           b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7]);
+    t = t_start(opts, true);
+    icm_bind(t, w);
+    n = icm_expect(t, PDF_ICM_EVENT, w);
+    check_connected(w, n, false, false, uuid);
+    t_stop(t);
+}
+
+/* ---- controller power with BIOS Assist (R27, R28) ---- */
+
+#define RP_DEVFN            QPCI_DEVFN(0x1c, 0)
+
+static uint32_t cfg_rd(QTestState *qts, int bus, int devfn, int off)
+{
+    qtest_outl(qts, 0xcf8, 0x80000000 | (bus << 16) | (devfn << 8) | off);
+    return qtest_inl(qts, 0xcfc);
+}
+
+static void cfg_wr(QTestState *qts, int bus, int devfn, int off, uint32_t v)
+{
+    qtest_outl(qts, 0xcf8, 0x80000000 | (bus << 16) | (devfn << 8) | off);
+    qtest_outl(qts, 0xcfc, v);
+}
+
+static uint16_t rp_sltsta(QTestState *qts)
+{
+    int pos = cfg_rd(qts, 0, RP_DEVFN, 0x34) & 0xfc;
+
+    while ((cfg_rd(qts, 0, RP_DEVFN, pos) & 0xff) != 0x10) {
+        pos = (cfg_rd(qts, 0, RP_DEVFN, pos) >> 8) & 0xfc;
+    }
+    return cfg_rd(qts, 0, RP_DEVFN, pos + 0x18) >> 16;
+}
+
+static QTestState *power_start_dev(const char *host_opts, const char *dev)
+{
+    QTestState *qts = qtest_initf(
+        "-machine q35 -global ICH9-LPC.acpi-pci-hotplug-with-bridge-"
+        "support=off -drive if=none,id=disk0,file=null-co://,format=raw "
+        "-device usb4-tunnel-port,id=tbrp,bus=pcie.0,addr=1c.0,chassis=1,"
+        "usb4-dvsec=off "
+        "-device usb4-tb3-usp,id=tbusp,bus=tbrp "
+        "-device usb4-tb3-dsp,id=tbd0,bus=tbusp,addr=0.0,chassis=2,slot=0 "
+        "-device usb4-tb3-tunnel-dsp,id=tp0,bus=tbusp,addr=1.0,chassis=3,"
+        "slot=1 "
+        "-device usb4-tb3-dsp,id=tbd2,bus=tbusp,addr=2.0,chassis=4,slot=2 "
+        "-device usb4-host,id=u4,bus=tbd0,tunnel-port=tp0,"
+        "profile=tb3-alpine-ridge%s %s", host_opts, dev ? dev : "");
+
+    /* root port: secondary bus 1 (the switch upstream port) */
+    cfg_wr(qts, 0, RP_DEVFN, 0x18, 0x00050100);
+    return qts;
+}
+
+static QTestState *power_start(const char *host_opts, bool dev)
+{
+    return power_start_dev(host_opts, dev ?
+                           "-device usb4-device,id=d0,bus=u4.0,port=1,"
+                           "dialect=tb3,drive=disk0" : NULL);
+}
+
+static bool usp_visible(QTestState *qts)
+{
+    uint32_t id = cfg_rd(qts, 1, 0, 0);
+
+    g_assert(id == 0x15c08086 || id == 0xffffffff);
+    return id == 0x15c08086;
+}
+
+static void test_power(void)
+{
+    QTestState *qts;
+
+    /* Assist off: powered with nothing attached (OFF_*_N captures) */
+    qts = power_start("", false);
+    g_assert_true(usp_visible(qts));
+    g_assert_cmphex(rp_sltsta(qts) & 0x40, ==, 0x40);
+    qtest_quit(qts);
+
+    /* Assist on, device at power-on: powered (ON_ON with the dock) */
+    qts = power_start(",bios-assist=on", true);
+    g_assert_true(usp_visible(qts));
+    qtest_quit(qts);
+
+    /* Assist on, nothing attached: absent (ON_ON_NO, ON_OFF_N captures) */
+    qts = power_start(",bios-assist=on", false);
+    qtest_clock_step(qts, 1000 * 1000);
+    g_assert_false(usp_visible(qts));
+    g_assert_cmphex(rp_sltsta(qts) & 0x40, ==, 0);
+
+    /* a plug powers it up and signals presence on the root port */
+    qtest_qmp_device_add(qts, "usb4-device", "d0",
+                         "{'bus': 'u4.0', 'port': 1, 'dialect': 'tb3', "
+                         "'drive': 'disk0'}");
+    qtest_clock_step(qts, 1000 * 1000);
+    g_assert_true(usp_visible(qts));
+    g_assert_cmphex(rp_sltsta(qts) & 0x48, ==, 0x48);  /* PDS, PDC */
+
+    /* unplug: powered down after the delay (about 35 s, 12.3) */
+    qtest_qmp_device_del_send(qts, "d0");
+    qtest_clock_step(qts, 30 * 1000 * 1000 * 1000LL);
+    g_assert_true(usp_visible(qts));
+    qtest_clock_step(qts, 6 * 1000 * 1000 * 1000LL);
+    g_assert_false(usp_visible(qts));
+    g_assert_cmphex(rp_sltsta(qts) & 0x40, ==, 0);
+
+    /* R28: force power brings it back and holds it */
+    qtest_qmp_assert_success(qts, "{'execute': 'qom-set', 'arguments': "
+                             "{'path': '/machine/peripheral/u4', "
+                             "'property': 'force-power', 'value': true}}");
+    qtest_clock_step(qts, 1000 * 1000);
+    g_assert_true(usp_visible(qts));
+    qtest_clock_step(qts, 60 * 1000 * 1000 * 1000LL);
+    g_assert_true(usp_visible(qts));
+    qtest_quit(qts);
+}
+
+static uint16_t rp_exp(QTestState *qts)
+{
+    int pos = cfg_rd(qts, 0, RP_DEVFN, 0x34) & 0xfc;
+
+    while ((cfg_rd(qts, 0, RP_DEVFN, pos) & 0xff) != 0x10) {
+        pos = (cfg_rd(qts, 0, RP_DEVFN, pos) >> 8) & 0xfc;
+    }
+    return pos;
+}
+
+/*
+ * Review 2 #2: powered down, the controller's BAR0 does not decode and
+ * it cannot master. Buses: root port 1, upstream port 1 -> 2-5, NHI's
+ * downstream port 2:0.0 -> 3, NHI at 3:0.0 with BAR0 at 0xe0000000.
+ */
+static void test_power_mmio(void)
+{
+    QTestState *qts = power_start(",bios-assist=on", true);
+    const uint32_t win = 0xe0f0e000;    /* memory base/limit 0xe0000000+ */
+
+    cfg_wr(qts, 0, RP_DEVFN, 0x20, win);
+    cfg_wr(qts, 0, RP_DEVFN, 0x04, 0x6);
+    cfg_wr(qts, 1, 0, 0x18, 0x00050201);
+    cfg_wr(qts, 1, 0, 0x20, win);
+    cfg_wr(qts, 1, 0, 0x04, 0x6);
+    cfg_wr(qts, 2, 0, 0x18, 0x00030302);
+    cfg_wr(qts, 2, 0, 0x20, win);
+    cfg_wr(qts, 2, 0, 0x04, 0x6);
+    g_assert_cmphex(cfg_rd(qts, 3, 0, 0), ==, 0x15bf8086);
+    cfg_wr(qts, 3, 0, 0x10, 0xe0000000);
+    cfg_wr(qts, 3, 0, 0x04, 0x6);
+    g_assert_cmphex(qtest_readl(qts, 0xe0039944), ==, 0x800001a1);
+
+    /* unplug, then the power-off delay */
+    qtest_qmp_device_del_send(qts, "d0");
+    qtest_clock_step(qts, 40 * 1000 * 1000 * 1000LL);
+    g_assert_false(usp_visible(qts));
+    g_assert_cmphex(qtest_readl(qts, 0xe0039944), !=, 0x800001a1);
+    /* a mailbox write must not reach the powered-down controller */
+    qtest_writel(qts, 0xe0039904, 0x80000042);
+    qtest_quit(qts);
+}
+
+/*
+ * The power_start() machine driven through ring 0: buses as in
+ * test_power_mmio(), the NHI at 3:0.0 with BAR0 assigned by libqos
+ * (0xe0000000, inside the bridge windows).
+ */
+static T *t_start_assist_dev(const char *host_opts, const char *dev)
+{
+    T *t = g_new0(T, 1);
+    const uint32_t win = 0xe0f0e000;
+
+    t->qts = power_start_dev(host_opts, dev);
+    cfg_wr(t->qts, 0, RP_DEVFN, 0x20, win);
+    cfg_wr(t->qts, 0, RP_DEVFN, 0x04, 0x6);
+    cfg_wr(t->qts, 1, 0, 0x18, 0x00050201);
+    cfg_wr(t->qts, 1, 0, 0x20, win);
+    cfg_wr(t->qts, 1, 0, 0x04, 0x6);
+    cfg_wr(t->qts, 2, 0, 0x18, 0x00030302);
+    cfg_wr(t->qts, 2, 0, 0x20, win);
+    cfg_wr(t->qts, 2, 0, 0x04, 0x6);
+    pc_alloc_init(&t->alloc, t->qts, ALLOC_NO_FLAGS);
+    t->bus = qpci_new_pc(t->qts, &t->alloc);
+    t->dev = qpci_device_find(t->bus, 3 << 8);      /* bus 3, 0.0 */
+    g_assert(t->dev);
+    g_assert_cmphex(qpci_config_readw(t->dev, PCI_DEVICE_ID), ==, 0x15bf);
+    qpci_device_enable(t->dev);
+    t->bar = qpci_iomap(t->dev, 0, NULL);
+    return t;
+}
+
+static T *t_start_assist(const char *host_opts)
+{
+    return t_start_assist_dev(host_opts, "-device usb4-device,id=d0,"
+                              "bus=u4.0,port=1,dialect=tb3,drive=disk0");
+}
+
+/*
+ * The first driver ready under BIOS Assist: the devices are announced
+ * after the 2.77 s hold (ICM-PROTOCOL.md 13.5).
+ */
+static unsigned icm_expect_assist_event(T *t, uint32_t *w)
+{
+    icm_expect_none(t);
+    qtest_clock_step(t->qts, 2800 * 1000 * 1000LL);
+    return icm_expect(t, PDF_ICM_EVENT, w);
+}
+
+/* Boot-ACL read (4.6): answered with 33 words, or not at all. */
+static bool acl_read_answered(T *t)
+{
+    uint32_t w[64], cmd[33] = { 0x00000018 };
+    unsigned n = 0;
+
+    icm_cmd(t, cmd, 33);
+    if (!icm_recv(t, w, &n)) {
+        return false;
+    }
+    g_assert_cmpuint(n, ==, 33);
+    g_assert_cmphex(w[0], ==, 0x01000018);
+    return true;
+}
+
+/*
+ * R32 (ICM-PROTOCOL.md 12.3, CAPTURE-VS-LINUX.md C2): with BIOS Assist
+ * on, after the last device leaves the firmware answers no ICM command
+ * until the controller is powered off; a re-plug before that ends the
+ * silence. assist-icm-silence=off keeps it answering.
+ */
+static void test_assist_silence(void)
+{
+    uint32_t w[64];
+    unsigned n;
+    T *t = t_start_assist(",bios-assist=on");
+
+    icm_bind(t, w);
+    /* driver-ready flags 0x22 under Assist (R4-T:86.764, AR-27) */
+    g_assert_cmphex(w[0], ==, 0x01002203);
+    g_assert_cmphex(w[1], ==, 0x28010b60);
+    n = icm_expect_assist_event(t, w);
+    g_assert_cmpuint(n, ==, 61);
+    g_assert_true(acl_read_answered(t));
+
+    /* the disconnect event still arrives (Assist-on trace line 1) */
+    qtest_qmp_device_del_send(t->qts, "d0");
+    n = icm_expect(t, PDF_ICM_EVENT, w);
+    g_assert_cmpuint(n, ==, 2);
+    g_assert_cmphex(w[0], ==, 0x01000004);
+    /* then nothing is answered, also not after the client's 5 s timeout */
+    g_assert_false(acl_read_answered(t));
+    qtest_clock_step(t->qts, 5 * 1000 * 1000 * 1000LL);
+    icm_expect_none(t);
+    g_assert_false(acl_read_answered(t));
+    g_assert_true(usp_visible(t->qts));
+
+    /* a device before the power-off: announced, and answers again */
+    qtest_qmp_device_add(t->qts, "usb4-device", "d0",
+                         "{'bus': 'u4.0', 'port': 1, 'dialect': 'tb3', "
+                         "'drive': 'disk0'}");
+    n = icm_expect(t, PDF_ICM_EVENT, w);
+    g_assert_cmpuint(n, ==, 61);
+    g_assert_true(acl_read_answered(t));
+
+    /* last unplug again: silent until the controller disappears */
+    qtest_qmp_device_del_send(t->qts, "d0");
+    icm_expect(t, PDF_ICM_EVENT, w);
+    g_assert_false(acl_read_answered(t));
+    qtest_clock_step(t->qts, 36 * 1000 * 1000 * 1000LL);
+    g_assert_false(usp_visible(t->qts));
+    t_stop(t);
+
+    /* disabled: the model keeps answering until the power-off */
+    t = t_start_assist(",bios-assist=on,assist-icm-silence=off");
+    icm_bind(t, w);
+    icm_expect_assist_event(t, w);
+    qtest_qmp_device_del_send(t->qts, "d0");
+    icm_expect(t, PDF_ICM_EVENT, w);
+    g_assert_true(acl_read_answered(t));
+    t_stop(t);
+
+    /* Assist off: never silent (the controller stays powered) */
+    t = t_start_assist("");
+    icm_bind(t, w);
+    g_assert_cmphex(w[0], ==, 0x0100a203);
+    icm_expect(t, PDF_ICM_EVENT, w);
+    qtest_qmp_device_del_send(t->qts, "d0");
+    icm_expect(t, PDF_ICM_EVENT, w);
+    g_assert_true(acl_read_answered(t));
+    qtest_clock_step(t->qts, 40 * 1000 * 1000 * 1000LL);
+    g_assert_true(acl_read_answered(t));
+    t_stop(t);
+}
