+/*
+ * More config requests than the hold queue takes (review P2): the TX
+ * ring stops advancing instead of dropping requests, and when the hold
+ * ends every request is answered in order.
+ */
+static void test_ready_hold_backpressure(void)
+{
+    uint32_t w[64];
+    unsigned n, ci;
+    T *t = t_start_assist_dev(",bios-assist=on,preboot=on",
+                              "-device usb4-device,id=d0,bus=u4.0,port=1,"
+                              "dialect=usb4,device-model=asm2464,"
+                              "drive=disk0");
+
+    icm_bind(t, w);
+    /* 20 reads of host router dwords 0-19 while the firmware holds */
+    for (unsigned i = 0; i < 20; i++) {
+        uint32_t f[3] = { 0, 0, i | (1u << 13) | (2u << 25) };
+
+        tx_frame(t, 1, f, 3);
+    }
+    /* 16 taken, 4 descriptors pending: the consumer index stopped */
+    ci = rd(t, TX_RING(0) + RING_INDEX) & 0xffff;
+    g_assert_cmpuint(ci, ==, (t->tx_pi + RING_N - 4) % RING_N);
+    icm_expect_none(t);
+    qtest_clock_step(t->qts, 2800 * 1000 * 1000LL);
+    g_assert_cmpuint(rd(t, TX_RING(0) + RING_INDEX) & 0xffff, ==, t->tx_pi);
+    n = icm_expect(t, PDF_ICM_EVENT, w);
+    g_assert_cmpuint(n, ==, 61);
+    for (unsigned i = 0; i < 20; i++) {
+        g_assert_cmpuint(icm_expect(t, 1, w), ==, 4);
+        g_assert_cmphex(w[2] & 0x1fff, ==, i);
+    }
+    icm_expect_none(t);
+    t_stop(t);
+}
+
+/*
+ * Review: driver unload (mailbox 0x07) while the hold queue is full and
+ * a driver ready waits behind pending config descriptors. Ending the
+ * hold resumes the TX ring at once and the driver ready announces the
+ * device; the unload must not then forget that announcement, or the
+ * later unplug sends no device disconnected.
+ */
+static void test_ready_hold_unload(void)
+{
+    uint32_t w[64], dr = 0x00000003;
+    unsigned n, got_event = 0, got_dr = 0, got_rd = 0;
+    T *t = t_start_assist_dev(",bios-assist=on,preboot=on",
+                              "-device usb4-device,id=d0,bus=u4.0,port=1,"
+                              "dialect=usb4,device-model=asm2464,"
+                              "drive=disk0");
+
+    icm_bind(t, w);
+    for (unsigned i = 0; i < 18; i++) {
+        uint32_t f[3] = { 0, 0, i | (1u << 13) | (2u << 25) };
+
+        tx_frame(t, 1, f, 3);
+    }
+    icm_cmd(t, &dr, 1);             /* pending behind two reads */
+    icm_expect_none(t);
+    g_assert_cmphex(mailbox(t, 0x07), ==, 0x07);
+    for (;;) {
+        unsigned pdf = icm_recv(t, w, &n);
+
+        if (!pdf) {
+            break;
+        }
+        got_rd += pdf == 1;
+        got_dr += pdf == PDF_ICM_RESP && w[0] == 0x01002203;
+        got_event += pdf == PDF_ICM_EVENT && n == 61;
+    }
+    g_assert_cmpuint(got_rd, ==, 18);
+    g_assert_cmpuint(got_dr, ==, 1);
+    g_assert_cmpuint(got_event, ==, 1);
+
+    /* the announced device's unplug is reported */
+    qtest_qmp_device_del_send(t->qts, "d0");
+    n = icm_expect(t, PDF_ICM_EVENT, w);
+    g_assert_cmpuint(n, ==, 2);
+    g_assert_cmphex(w[1], ==, 0x00110000);
+    t_stop(t);
+}
