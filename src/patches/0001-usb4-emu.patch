+/*
+ * x-nn is the highest NSID: Identify Namespace above it fails, the
+ * active list stays within it and no namespace can be attached above it.
+ */
+static void test_nn_enforced(void)
+{
+    g_autofree char *img = make_img();
+    g_autofree char *img2 = make_img();
+    g_autofree char *drive1 = g_strdup_printf("-drive if=none,id=disk1,"
+                                              "file=%s,format=raw", img2);
+    Nv nv;
+    QTestState *qts;
+    QDict *rsp;
+    uint32_t list[4], nn;
+    uint16_t cid, st;
+
+    qts = tp_start(img, ",nvme-drive=,nvme-namespaces=2:disk0,nvme-nn=4",
+                   drive1, &nv);
+    nv_bringup(&nv);
+    nv_admin_ok(&nv, 0x06, 0, RAM_ID, 1, 0);
+    qtest_memread(qts, RAM_ID + 516, &nn, 4);
+    g_assert_cmpuint(nn, ==, 4);
+    /* NSID 4: valid, inactive (zeroed data). NSID 5: invalid. */
+    nv_admin_ok(&nv, 0x06, 4, RAM_ID, 0, 0);
+    cid = nv_submit(&nv, 0, 0x06, 5, RAM_ID, 0, 0, 0);
+    g_assert(nv_poll(&nv, 0, cid, NULL, &st, 2000));
+    g_assert_cmphex(st, ==, 0x400b);        /* Invalid Namespace, DNR */
+    cid = nv_submit(&nv, 0, 0x06, 256, RAM_ID, 0, 0, 0);
+    g_assert(nv_poll(&nv, 0, cid, NULL, &st, 2000));
+    g_assert_cmphex(st, ==, 0x400b);
+
+    /* No namespace above NN, even hot-plugged onto the controller. */
+    rsp = qtest_qmp(qts, "{'execute': 'device_add', 'arguments': "
+                    "{'driver': 'nvme-ns', 'id': 'ns5', 'bus': 'tp0-nvme1', "
+                    "'drive': 'disk1', 'nsid': 5}}");
+    g_assert(qdict_haskey(rsp, "error"));
+    g_assert(strstr(qdict_get_str(qdict_get_qdict(rsp, "error"), "desc"),
+                    "Number of Namespaces"));
+    qobject_unref(rsp);
+    nv_admin_ok(&nv, 0x06, 0, RAM_ID, 2, 0);
+    qtest_memread(qts, RAM_ID, list, sizeof(list));
+    g_assert_cmpuint(list[0], ==, 2);
+    g_assert_cmpuint(list[1], ==, 0);
+    qtest_quit(qts);
+    unlink(img);
+    unlink(img2);
+}
