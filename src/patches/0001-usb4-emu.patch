+/* The same on the i440FX tunnel bridge (pci-bridge with SHPC). */
+static void test_bridge_window_all_ones(void)
+{
+    g_autofree char *img = make_img();
+    QTestState *qts = tb_start(img, true);
+    uint32_t vs;
+
+    bridge_windows(qts, 0, TB_DEVFN, WIN_MEM_REG);
+    assert_all_ones(qts, WIN_MEM);
+    assert_io_all_ones(qts, WIN_IO);
+    g_assert(mtree_enabled(qts, "usb4-tunnel-gate-ones-io", MTREE_IO_WIN));
+
+    tb_set_tunnel(qts, "up");
+    g_assert_cmpuint(wait_stage(qts, "inserted"), ==, 1);
+    nvme_map(qts, 1, EP_DEVFN, WIN_MEM);
+    vs = qtest_readl(qts, WIN_MEM + NVME_VS);
+    g_assert_cmphex(vs, !=, 0);
+    g_assert_cmphex(vs, !=, 0xffffffff);
+    g_assert(!mtree_enabled(qts, "usb4-tunnel-gate-ones-mem", NULL));
+
+    /*
+     * The guest disables the slot with the power indicator left on (so
+     * stock SHPC keeps the device): closed by the slot state alone.
+     */
+    tb_shpc_command(qts, SHPC_ENABLE_PWR_ON);
+    /* CC with the controller disabled: queue entry sizes only. */
+    qtest_writel(qts, WIN_MEM + NVME_CC, NVME_CC_MARK);
+    g_assert_cmphex(qtest_readl(qts, WIN_MEM + NVME_CC), ==, NVME_CC_MARK);
+    tb_shpc_command(qts, SHPC_DISABLE);
+    g_assert_cmphex(qtest_readl(qts, WIN_MEM + NVME_CSTS), ==, 0xffffffff);
+    assert_all_ones(qts, WIN_MEM);
+    /*
+     * Writes to the cut-off endpoint are dropped: it keeps its CC (checked
+     * below on the same endpoint, re-enabled without a reset). There is
+     * no I/O counterpart: the endpoint has no I/O BAR to write to.
+     */
+    qtest_writel(qts, WIN_MEM + NVME_CC, 0);
+    qtest_writew(qts, WIN_MEM + NVME_CC + 2, 0);
+    qtest_writeq(qts, WIN_MEM + NVME_CC, 0);
+    g_assert_cmphex(qtest_readl(qts, WIN_MEM + NVME_CC), ==, 0xffffffff);
+    /* VGA forwarding enabled on the bridge: the legacy ranges abort too. */
+    cfg_writel(qts, 0, TB_DEVFN, 0x3c, 0x00080000);
+    g_assert(mtree_enabled(qts, "usb4-tunnel-gate-ones-vga-mem",
+                           "00000000000a0000-00000000000bffff"));
+    g_assert(mtree_enabled(qts, "usb4-tunnel-gate-ones-vga-io-lo", NULL));
+    g_assert(mtree_enabled(qts, "usb4-tunnel-gate-ones-vga-io-hi", NULL));
+    cfg_writel(qts, 0, TB_DEVFN, 0x3c, 0);
+    g_assert(!mtree_enabled(qts, "usb4-tunnel-gate-ones-vga-mem", NULL));
+
+    /* Enabled again: the same endpoint answers, its CC untouched. */
+    tb_shpc_command(qts, SHPC_ENABLE_PWR_ON);
+    g_assert_cmphex(qtest_readl(qts, WIN_MEM + NVME_VS), ==, vs);
+    g_assert_cmphex(qtest_readl(qts, WIN_MEM + NVME_CC), ==, NVME_CC_MARK);
+    g_assert(!mtree_enabled(qts, "usb4-tunnel-gate-ones-mem", NULL));
+
+    /* Surprise: all-ones until the replacement is back. */
+    tb_set_tunnel(qts, "surprise");
+    g_assert_cmpuint(wait_stage(qts, "removed"), ==, 1);
+    g_assert_cmphex(qtest_readl(qts, WIN_MEM + NVME_CSTS), ==, 0xffffffff);
+    tb_set_tunnel(qts, "up");
+    qtest_clock_step(qts, 300 * 1000 * 1000);   /* past settle-ms */
+    g_assert_cmpuint(wait_stage(qts, "inserted"), ==, 2);
+    nvme_map(qts, 1, EP_DEVFN, WIN_MEM);
+    g_assert_cmphex(qtest_readl(qts, WIN_MEM + NVME_VS), ==, vs);
+    qtest_quit(qts);
+    unlink(img);
+}
