index 0000000000000000000000000000000000000000..7c8b4943011676249feb377dbcfce3e7b1441a35
--- /dev/null
+++ b/tests/usb4/gen-asm2464-data.py
@@ -0,0 +1,328 @@
+#!/usr/bin/env python3
+# Generate hw/usb4/usb4-asm2464-data.h, the register images of the
+# captured ASMedia ASM2464PD USB4 device router (ORICO AAGM2-U4 NVMe
+# enclosure), from the Framework 13 (12th gen) Linux capture
+# (tests/captures/framework13-12th/linux-orico, extracted).
+#
+#   python3 tests/usb4/gen-asm2464-data.py <extracted capture dir> \
+#       hw/usb4/usb4-asm2464-data.h
+#
+# Image rule (docs/captures/ORICO-ASM2464.md): the debugfs dump of device
+# router 1-3 in snap-3-after-rebind gives the layout and the base values;
+# every dword the Linux CM read in the trace before it first wrote that
+# dword overrides it (the state of a freshly reset router: the first
+# device session in the trace starts right after a Downstream Port
+# Reset). A dword the CM wrote before ever reading it has no observed
+# reset value and is 0, as are the Router Operation registers
+# (ROUTER_CS_9-26), observed 0 after the router lost power in
+# suspend-to-idle. The DROM is the byte stream the DROM Read router
+# operations returned, which includes two bytes past the DROM's end.
+#
+# Copyright (c) 2026 usb4-emu contributors
+# SPDX-License-Identifier: GPL-2.0-only
+
+import os
+import re
+import sys
+
+CAP_LANE, CAP_TMU, CAP_PROTO, CAP_VS, CAP_PORT = 1, 3, 4, 5, 6
+CS_PATH, CS_ADP, CS_RTR, CS_CNT = 0, 1, 2, 3
+DOMAIN, ROUTE = 1, 3
+# The only adapter without a debugfs dump, marked unused in the DROM
+UNUSED_ADP = 4
+# Adapters whose dumps the image needs: lanes 1-2, PCIe Upstream 3
+REQUIRED = {1: 'USB4_ADP_LANE', 2: 'USB4_ADP_LANE', 3: 'USB4_ADP_PCIE_UP'}
+
+
+def read_regs(path):
+    """debugfs regs: offset rel cap vs value -> {off: (cap, rel, val)}."""
+    out = {}
+    for line in open(path):
+        if line.startswith('#') or not line.strip():
+            continue
+        f = line.split()
+        out[int(f[0], 16)] = (int(f[2], 16), int(f[1]), int(f[-1], 16))
+    return out
+
+
+def read_path(path):
+    out = {}
+    for line in open(path):
+        if line.startswith('#') or not line.strip():
+            continue
+        f = line.split()
+        out[int(f[0], 16)] = int(f[-1], 16)
+    return out
+
+
+TRACE = re.compile(r'\s([\d.]+): (tb_\w+): (.*)')
+KV = re.compile(r'(\w+)=(\[[^\]]*\]|[^,]+)')
+REC = re.compile(r'\s[\d.]+: tb_\w+: ')
+
+
+def trace_records(path):
+    for line in open(path):
+        # A few lines hold two records, the first truncated: keep the last.
+        starts = [m.start() for m in REC.finditer(line)]
+        if not starts:
+            continue
+        m = TRACE.search(line[starts[-1]:])
+        if not m:
+            continue
+        f = dict(KV.findall(m.group(3)))
+        f['t'] = float(m.group(1))
+        f['k'] = m.group(2)
+        if 'data' in f:
+            try:
+                f['data'] = [int(x, 16) for x in
+                             f['data'].strip('[]').split(',') if x.strip()]
+            except ValueError:
+                continue
+        try:
+            for k in ('offset', 'len', 'port', 'config', 'domain'):
+                if k in f:
+                    f[k] = int(f[k], 0)
+            f['route'] = int(f['route'], 16) if 'route' in f else None
+        except ValueError:
+            continue
+        yield f
+
+
+def first_reads(trace):
+    """{(cs, adp, off): value} read before the first write; written set."""
+    written, first = set(), {}
+    for f in trace_records(trace):
+        if f.get('route') != ROUTE or f.get('domain') != DOMAIN:
+            continue
+        if f.get('type') not in ('TB_CFG_PKG_READ', 'TB_CFG_PKG_WRITE'):
+            continue
+        cs = f['config']
+        adp = 0 if cs == CS_RTR else f['port']
+        if f['k'] == 'tb_tx' and f['type'] == 'TB_CFG_PKG_WRITE':
+            for i in range(f['len']):
+                key = (cs, adp, f['offset'] + i)
+                if key not in first:
+                    written.add(key)
+        elif f['k'] == 'tb_rx' and f['type'] == 'TB_CFG_PKG_READ':
+            for i, v in enumerate(f['data'][3:3 + f['len']]):
+                key = (cs, adp, f['offset'] + i)
+                if key not in written and key not in first:
+                    first[key] = v
+    return first, written
+
+
+def drom_from_ops(trace):
+    """DROM bytes as the DROM Read router operations (0x24) returned."""
+    meta, op_meta, out = None, None, {}
+    for f in trace_records(trace):
+        if f.get('route') != ROUTE or f.get('domain') != DOMAIN or \
+                f.get('config') != CS_RTR:
+            continue
+        if f['k'] == 'tb_tx' and f.get('type') == 'TB_CFG_PKG_WRITE':
+            d = f['data'][3:3 + f['len']]
+            for i, v in enumerate(d):
+                off = f['offset'] + i
+                if off == 0x19:
+                    meta = v
+                elif off == 0x1a and (v & 0xffff) == 0x24 and v >> 31:
+                    op_meta = meta
+                elif off == 0x1a:
+                    op_meta = None
+        elif f['k'] == 'tb_rx' and f.get('type') == 'TB_CFG_PKG_READ' and \
+                op_meta is not None and f['offset'] == 9:
+            dw = (op_meta >> 2) & 0x1fff
+            n = (op_meta >> 15) & 0x1f
+            if f['len'] < n:
+                continue
+            for i, v in enumerate(f['data'][3:3 + n]):
+                for b in range(4):
+                    out[4 * (dw + i) + b] = (v >> (8 * b)) & 0xff
+            op_meta = None
+    size = max(out) + 1
+    return bytes(out.get(i, 0) for i in range(size))
+
+
+def caps(regs):
+    """{cap_id: (first offset, length)} from a debugfs dump."""
+    out = {}
+    for off in sorted(regs):
+        cap, rel, _ = regs[off]
+        if cap == 0 or cap == CAP_VS:
+            continue
+        if rel == 0:
+            out[cap] = [off, 1]
+        elif cap in out and off == out[cap][0] + out[cap][1]:
+            out[cap][1] += 1
+    return {k: tuple(v) for k, v in out.items()}
+
+
+def kind_of(adp_cs2):
+    return {
+        0x000001: 'USB4_ADP_LANE',
+        0x100102: 'USB4_ADP_PCIE_UP',
+        0x200102: 'USB4_ADP_USB3_UP',
+    }[adp_cs2 & 0xffffff]
+
+
+def regs_c(name, items):
+    s = 'static const USB4ImgReg %s[] = {\n' % name
+    row = []
+    for off, val in items:
+        row.append('{ 0x%03x, 0x%08x },' % (off, val))
+        if len(row) == 3:
+            s += '    ' + ' '.join(row) + '\n'
+            row = []
+    if row:
+        s += '    ' + ' '.join(row) + '\n'
+    if not items:
+        s += '    { 0, 0 },\n'
+    return s + '};\n'
+
+
+def bytes_c(b):
+    s = ''
+    for i in range(0, len(b), 12):
+        s += '    ' + ' '.join('0x%02x,' % x for x in b[i:i + 12]) + '\n'
+    return s
+
+
+def image(base, fr, written, cs, adp):
+    img = {off: v[2] if isinstance(v, tuple) else v for off, v in base.items()}
+    for (c, a, off), v in fr.items():
+        if c == cs and a == adp:
+            img[off] = v
+    for (c, a, off) in written:
+        if c == cs and a == adp:
+            img[off] = 0
+    return img
+
+
+def main():
+    cap_dir, out_path = sys.argv[1], sys.argv[2]
+    snap = os.path.join(cap_dir, 'snap-3-after-rebind', 'debugfs-thunderbolt',
+                        '1-3')
+    trace = os.path.join(cap_dir, 'trace-thunderbolt.txt')
+    fr, written = first_reads(trace)
+
+    o = ['''/*
+ * ASMedia ASM2464PD USB4 device router register images
+ *
+ * Copyright (c) 2026 usb4-emu contributors
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * GENERATED by tests/usb4/gen-asm2464-data.py from the Framework Laptop
+ * 13 (12th gen) capture with an ORICO AAGM2-U4 enclosure attached,
+ * tests/captures/framework13-12th/linux-orico (observed data,
+ * docs/captures/ORICO-ASM2464.md). Base: debugfs dump of device router
+ * 1-3 in snap-3-after-rebind; dwords the Linux CM read before writing
+ * them are taken from the trace (a freshly reset router); dwords written
+ * before any read, and ROUTER_CS_9-26, are 0. Offsets are the captured
+ * ones. Only non-zero dwords are listed. Do not edit by hand.
+ */
+''']
+
+    # Router CS
+    rregs = read_regs(os.path.join(snap, 'regs'))
+    img = image(rregs, fr, written, CS_RTR, 0)
+    for off in range(9, 27):
+        img[off] = 0
+    rsize = max(rregs) + 1
+    rc = caps(rregs)
+    o.append('/* Router CS (%u dwords) */' % rsize)
+    o.append('#define ASM2464_RTR_CS_SIZE 0x%x' % rsize)
+    o.append('#define ASM2464_RTR_TMU { 0x%02x, %d }' % rc[CAP_TMU])
+    o.append(regs_c('asm2464_rtr_regs',
+                    [(k, img[k]) for k in sorted(img) if img[k] and k > 0]))
+    o.append('/* Identity: ROUTER_CS_0, ROUTER_CS_7/8 (router UID) */')
+    o.append('#define ASM2464_CS0 0x%08x' % img[0])
+    o.append('#define ASM2464_CS7 0x%08x' % img[7])
+    o.append('#define ASM2464_CS8 0x%08x\n' % img[8])
+
+    nmax = (img[1] >> 14) & 0x3f
+    ents = []
+    for n in range(1, nmax + 1):
+        pdir = os.path.join(snap, 'port%d' % n)
+        if not os.path.isdir(pdir):
+            # Fall back only where the capture shows an unused adapter:
+            # adapter 4, whose ADP_CS_0 Linux read as 0.
+            if n != UNUSED_ADP or fr.get((CS_ADP, n, 0), None) != 0:
+                raise SystemExit('adapter %d: no debugfs dump in %s' %
+                                 (n, snap))
+            ents.append((n, None))
+            continue
+        regs = read_regs(os.path.join(pdir, 'regs'))
+        aimg = image(regs, fr, written, CS_ADP, n)
+        pimg = image(read_path(os.path.join(pdir, 'path')), fr, written,
+                     CS_PATH, n)
+        pimg = {k: v for k, v in pimg.items() if v}
+        ents.append((n, (regs, aimg, pimg)))
+        o.append(regs_c('asm2464_adp%d_cs' % n,
+                        [(k, aimg[k]) for k in sorted(aimg) if aimg[k]]))
+        o.append(regs_c('asm2464_adp%d_path' % n, sorted(pimg.items())))
+
+    missing = sorted(set(REQUIRED) - {n for n, e in ents if e})
+    if missing:
+        raise SystemExit('adapters %s: required dumps missing' % missing)
+    o.append('#define ASM2464_MAX_ADAPTER %d' % nmax)
+    o.append('#define ASM2464_UPSTREAM_ADAPTER %d' % ((img[1] >> 8) & 0x3f))
+    o.append('static const USB4ImgAdapter asm2464_adapters'
+             '[ASM2464_MAX_ADAPTER + 1] = {')
+    for n, e in ents:
+        if e is None:
+            # Adapter 4: the DROM marks it unused and Linux reads only
+            # ADP_CS_0 (0); no image. A USB3 Gen X Upstream adapter by
+            # its number (Spec 5.2.1), with the model's layout.
+            o.append('    [%d] = {' % n)
+            o.append('        .kind = USB4_ADP_USB3_UP, .usb4_port = 1,')
+            o.append('        .max_hop = USB4_USB3_MAX_HOPID,')
+            o.append('    },')
+            continue
+        regs, aimg, pimg = e
+        cp = caps(regs)
+        kind = kind_of(aimg[2])
+        if n in REQUIRED and kind != REQUIRED[n]:
+            raise SystemExit('adapter %d: %s, not %s' %
+                             (n, kind, REQUIRED[n]))
+        lane = (n + 1) % 2 if kind == 'USB4_ADP_LANE' else 0
+        cs1 = aimg.get(1, 0)
+        cntsets = (cs1 >> 8) & 0x7ff if cs1 & (1 << 19) else 0
+
+        def cap(c):
+            v = cp.get(c)
+            return '{ 0x%02x, %d }' % v if v else '{ 0, 0 }'
+        o.append('    [%d] = {' % n)
+        o.append('        .kind = %s, .usb4_port = 1, .lane = %d,' %
+                 (kind, lane))
+        o.append('        .max_hop = %d, .cs_size = 0x%x, .counter_sets = %d,'
+                 % (aimg.get(5, 0) & 0x7ff, max(regs) + 1, cntsets))
+        o.append('        .lane_cap = %s, .tmu_cap = %s,' %
+                 (cap(CAP_LANE), cap(CAP_TMU)))
+        o.append('        .port_cap = %s, .proto_cap = %s,' %
+                 (cap(CAP_PORT), cap(CAP_PROTO)))
+        o.append('        .cs = asm2464_adp%d_cs, '
+                 '.ncs = ARRAY_SIZE(asm2464_adp%d_cs),' % (n, n))
+        o.append('        .path = asm2464_adp%d_path, .npath = %d,' %
+                 (n, len(pimg)))
+        o.append('    },')
+    o.append('};\n')
+
+    drom = drom_from_ops(trace)
+    dbg = open(os.path.join(snap, 'drom'), 'rb').read()
+    assert drom[:len(dbg)] == dbg, 'DROM read data differs from debugfs'
+    o.append('/*')
+    o.append(' * DROM as the DROM Read router operation returns it: %d bytes'
+             % len(drom))
+    o.append(' * (the DROM is %d bytes, debugfs `drom`; the rest is what the'
+             % len(dbg))
+    o.append(' * operation returned past its end).')
+    o.append(' */')
+    o.append('#define ASM2464_DROM_LEN %d' % len(dbg))
+    o.append('static const uint8_t asm2464_drom[%d] = {' % len(drom))
+    o.append(bytes_c(drom) + '};')
+
+    with open(out_path, 'w', newline='\n') as fp:
+        fp.write('\n'.join(o) + '\n')
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tests/usb4/gen-tb3-sw-data.py b/tests/usb4/gen-tb3-sw-data.py
new file mode 100644
index 0000000000000000000000000000000000000000..411bc6eafee0d602d4507bc3cb3de471ee2e40ad
--- /dev/null
+++ b/tests/usb4/gen-tb3-sw-data.py
@@ -0,0 +1,198 @@
+#!/usr/bin/env python3
+# Generate hw/usb4/usb4-tb3-sw-data.h: the power-on state of the
+# Thunderbolt 3 device router (CalDigit TS3 Plus, Alpine Ridge C 4C,
+# router 8086:15d3) as a USB4 host's software connection manager finds
+# it, from the Framework Laptop 13 (12th gen) Linux capture
+# (tests/captures/framework13-12th/linux-ts3plus, extracted).
+#
+#   python3 tests/usb4/gen-tb3-sw-data.py <extracted capture dir> \
+#       hw/usb4/usb4-tb3-data.h hw/usb4/usb4-tb3-sw-data.h
+#
+# The tb3 device router model resets to the register images of
+# usb4-tb3-data.h, captured on the ThinkPad P14s under the Alpine Ridge
+# firmware CM (docs/ICM-PROTOCOL.md 5): the state after the firmware CM
+# configured the dock. Under a software CM the same dock starts from its
+# power-on state. This script emits the Router CS dwords where the two
+# differ, as an overlay on the P14s image.
+#
+# Rule: the device session starts at the re-plug after the host router
+# reset (SESSION_START, "0:3: hotplug: scanning" in dmesg-live.txt); every
+# Router CS dword of route 3 on domain 1 that Linux read in that session
+# before it wrote it gives the power-on value. The accessible windows are
+# those of the debugfs dump of 1-3 (snap-6-approved). Below MODEL_END
+# (up to the second link controller port block) the model stores the
+# dwords and the overlay lists where they differ from the P14s image.
+# Above it are the vendor capabilities that follow the link controller
+# (VSEC 7, 9 and 10), emitted as read-only values (the first read in the
+# session, else the dump). Path CS power-on values are the session's
+# first reads too. The link controller UUID (lc.c:tb_lc_read_uuid,
+# router dwords 0x102-0x105) is emitted separately.
+#
+# Copyright (c) 2026 usb4-emu contributors
+# SPDX-License-Identifier: GPL-2.0-only
+
+import importlib.util
+import os
+import re
+import sys
+
+CS_PATH, CS_RTR = 0, 2
+DOMAIN, ROUTE = 1, 3
+SESSION_START = 85.30
+MODEL_END = 0x2ed           # model storage: router dwords below this
+LC_UUID = 0x102             # link controller common registers + 3
+
+here = os.path.dirname(os.path.abspath(__file__))
+spec = importlib.util.spec_from_file_location(
+    'gen_asm2464', os.path.join(here, 'gen-asm2464-data.py'))
+gen = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(gen)
+
+
+def first_reads(trace, cs):
+    """{off} (Router CS) or {(adp, off)} (Path CS) values read before
+    written, from SESSION_START."""
+    written, first = set(), {}
+    for f in gen.trace_records(trace):
+        if f['t'] < SESSION_START or f.get('route') != ROUTE or \
+                f.get('domain') != DOMAIN or f.get('config') != cs:
+            continue
+        for i in range(f['len']):
+            key = f['offset'] + i if cs == CS_RTR else \
+                (f['port'], f['offset'] + i)
+            if f['k'] == 'tb_tx' and f.get('type') == 'TB_CFG_PKG_WRITE':
+                if key not in first:
+                    written.add(key)
+            elif f['k'] == 'tb_rx' and f.get('type') == 'TB_CFG_PKG_READ':
+                if key not in written and key not in first and \
+                        3 + i < len(f['data']):
+                    first[key] = f['data'][3 + i]
+    return first
+
+
+def windows(regs_path):
+    """Accessible [start, end) ranges of a debugfs regs dump."""
+    acc = []
+    for line in open(regs_path):
+        if line.startswith('#') or not line.strip():
+            continue
+        f = line.split()
+        acc.append((int(f[0], 16), 'not' not in line))
+    out, start = [], None
+    for off, ok in acc:
+        if ok and start is None:
+            start = off
+        elif not ok and start is not None:
+            out.append((start, off))
+            start = None
+    if start is not None:
+        out.append((start, acc[-1][0] + 1))
+    return out
+
+
+def p14s_image(hdr_path):
+    src = open(hdr_path).read()
+    m = re.search(r'tb3_rtr_dev_regs\[\] = \{(.*?)\};', src, re.S)
+    return {int(a, 16): int(b, 16) for a, b in
+            re.findall(r'\{ (0x[0-9a-f]+), (0x[0-9a-f]+) \}', m.group(1))}
+
+
+def regs_c(name, items):
+    s = 'static const USB4Tb3Reg %s[] = {\n' % name
+    for i in range(0, len(items), 3):
+        s += '    ' + ' '.join('{ 0x%03x, 0x%08x },' % r
+                               for r in items[i:i + 3]) + '\n'
+    return s + '};\n'
+
+
+def main():
+    cap_dir, p14s_hdr, out_path = sys.argv[1], sys.argv[2], sys.argv[3]
+    snap = os.path.join(cap_dir, 'snap-6-approved', 'debugfs-thunderbolt',
+                        '1-3', 'regs')
+    trace = os.path.join(cap_dir, 'trace-thunderbolt.txt')
+    fr = first_reads(trace, CS_RTR)
+    fpath = first_reads(trace, CS_PATH)
+    path = sorted(((a << 8) | off, v) for (a, off), v in fpath.items() if v)
+    if any((off & 0xff) >= 16 and not (off & 1) and v >> 31
+           for off, v in path):
+        raise SystemExit('a power-on path entry of HopID >= 8 is valid')
+    allwin = windows(snap)
+    win = [(s, min(e, MODEL_END)) for s, e in allwin if s < MODEL_END]
+    xwin = [(s, e) for s, e in allwin if s >= MODEL_END]
+    if len(win) != 2 or win[0][0] != 0 or not xwin:
+        raise SystemExit('unexpected accessible windows %s' % allwin)
+    dump = {}
+    for line in open(snap):
+        f = line.split()
+        if line.startswith('#') or len(f) < 5:
+            continue
+        dump[int(f[0], 16)] = int(f[4], 16)
+    xregs = []
+    for s, e in xwin:
+        for off in range(s, e):
+            v = fr.get(off, dump.get(off, 0))
+            if v:
+                xregs.append((off, v))
+    img = p14s_image(p14s_hdr)
+    uuid = [fr.get(LC_UUID + i) for i in range(4)]
+    if None in uuid:
+        raise SystemExit('link controller UUID not read in the session')
+
+    ov = []
+    for off in sorted(fr):
+        if not any(s <= off < e for s, e in win):
+            continue
+        if off == 0 or LC_UUID <= off < LC_UUID + 4:
+            continue        # identity and UUID are set by the model
+        if fr[off] != img.get(off, 0):
+            ov.append((off, fr[off]))
+
+    o = ['''/*
+ * Thunderbolt 3 device router under a software connection manager:
+ * power-on Router CS values
+ *
+ * Copyright (c) 2026 usb4-emu contributors
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * GENERATED by tests/usb4/gen-tb3-sw-data.py from the Framework Laptop
+ * 13 (12th gen) capture with the CalDigit TS3 Plus attached,
+ * tests/captures/framework13-12th/linux-ts3plus (observed data). The
+ * Router CS dwords where the dock's power-on state, as the Linux
+ * software CM read it after a re-plug, differs from the P14s image of
+ * usb4-tb3-data.h (the state the Alpine Ridge firmware CM leaves). It is
+ * an overlay on tb3_rtr_dev; values not listed are as in that image.
+ * Do not edit by hand.
+ */
+''']
+    o.append('/* Accessible Router CS windows (debugfs dump of 1-3) */')
+    o.append('#define TB3_SW_RTR_WIN0_END   0x%03x' % win[0][1])
+    o.append('#define TB3_SW_RTR_WIN1_START 0x%03x' % win[1][0])
+    o.append('#define TB3_SW_RTR_WIN1_END   0x%03x' % win[1][1])
+    o.append('/* Read-only windows above them, [start, end) */')
+    o.append('static const struct { uint16_t start, end; } tb3_sw_xwin[] = {')
+    o.append('    ' + ' '.join('{ 0x%03x, 0x%03x },' % w for w in xwin))
+    o.append('};')
+    o.append('#define TB3_SW_RTR_CS_SIZE    0x%03x\n' % xwin[-1][1])
+    o.append('/* Link controller UUID, router dwords 0x102-0x105 */')
+    o.append('static const uint32_t tb3_sw_lc_uuid[4] = {')
+    o.append('    ' + ', '.join('0x%08x' % v for v in uuid) + ',')
+    o.append('};\n')
+    o.append(regs_c('tb3_rtr_dev_sw_regs', ov))
+    o.append('/*')
+    o.append(' * Non-zero dwords of the read-only windows (vendor capabilities')
+    o.append(' * 7, 9 and 10 after the link controller), sorted by offset')
+    o.append(' */')
+    o.append(regs_c('tb3_rtr_dev_sw_xregs', xregs))
+    o.append('/*')
+    o.append(' * Non-zero power-on Path CS dwords, .off = adapter << 8 | dword')
+    o.append(' * (HopID 0 of the lane adapters, and defaults in the other')
+    o.append(' * entries; none of HopID 8 and above is valid)')
+    o.append(' */')
+    o.append(regs_c('tb3_dev_sw_path', path).rstrip('\n'))
+
+    with open(out_path, 'w', newline='\n') as fp:
+        fp.write('\n'.join(o) + '\n')
+
+
+if __name__ == '__main__':
+    main()
