diff --git a/hw/usb4/meson.build b/hw/usb4/meson.build
new file mode 100644
index 0000000000000000000000000000000000000000..b41f84b609ea07c2c596c6d9ee362da7571d805e
--- /dev/null
+++ b/hw/usb4/meson.build
@@ -0,0 +1,35 @@
+system_ss.add(when: 'CONFIG_USB4', if_true: files(
+  'usb4-host.c',       # host interface: PCI function, BAR0, rings, IRQs
+  'usb4-ctl.c',        # control packet framing and CRC32C
+  'usb4-fabric.c',     # router tree, packet routing, events, tunnel inputs
+  'usb4-router.c',     # router/adapter/path config spaces, operations
+  'usb4-router-img.c', # captured register images (intel-adl, asm2464)
+  'usb4-router-adl.c', # intel-adl host model (captured Alder Lake-P router)
+  'usb4-router-asm2464.c', # asm2464 device model (captured ASM2464PD)
+  'usb4-router-asm.c', # asm4242 host model (ASMedia ASM4242, public sources)
+  'usb4-preos.c',      # emulated pre-OS firmware CM (preos-cm=on)
+  'usb4-router-tb3.c', # tb3 dialect register images and EEPROM bit-bang
+  'usb4-drom.c',       # USB4 DROM image builder
+  'usb4-timer.c',      # QEMU timer glue for the fabric core
+  'usb4-device.c',     # usb4-device QOM type on the usb4 bus
+  'usb4-tunnel.c',     # tunnel evaluator
+  'usb4-tunnel-slot.c',# tunnel access gate + endpoint lifecycle (shared)
+  'usb4-tunnel-port.c',# gated pcie-root-port subclass (q35)
+  'usb4-tunnel-bridge.c',# gated pci-bridge + SHPC subclass (i440FX)
+  'usb4-acpi.c',       # ACPI _OSC / _DSD for the generic profile
+  'usb4-fabric-usb3.c',# USB3 Gen X tunnel evaluation
+  'usb4-usb3.c',       # USB devices behind the USB3 tunnel, xHCI _DSD
+  'usb4-icm.c',        # emulated Alpine Ridge firmware CM (ICM)
+  'usb4-harness.c',    # test harness: NVMe fault rules, gate overrides
+), if_false: files('usb4-acpi-stub.c'))
+system_ss.add(when: ['CONFIG_USB4', 'CONFIG_XIO3130'], if_true: files(
+  'usb4-tunnel-dsp.c', # daisy chain: gated hot-plug switch downstream port
+))
+system_ss.add(when: ['CONFIG_USB4', 'CONFIG_XIO3130', 'CONFIG_USB_XHCI_PCI'],
+              if_true: files(
+  'usb4-tb3-switch.c', # Alpine Ridge PCIe switch and xHCI identities
+  'usb4-asm-switch.c', # ASMedia ASM4242 PCIe switch and xHCI identities
+))
+system_ss.add(when: ['CONFIG_USB4', 'CONFIG_ISA_BUS'], if_true: files(
+  'usb4-debug-port.c', # test harness: guest stage codes and markers
+))
