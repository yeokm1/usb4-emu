+static void test_msix(void)
+{
+    T *t = t_start("pc", NULL);
+    uint8_t cap = qpci_find_capability(t->dev, PCI_CAP_ID_MSIX, 0);
+    uint64_t target = guest_alloc(&t->alloc, 64);
+    uint32_t table, off;
+    uint16_t ctrl;
+    unsigned v;
+
+    g_assert(cap);
+    ctrl = qpci_config_readw(t->dev, cap + PCI_MSIX_FLAGS);
+    g_assert_cmpuint((ctrl & PCI_MSIX_FLAGS_QSIZE) + 1, ==, 16);
+    table = qpci_config_readl(t->dev, cap + PCI_MSIX_TABLE);
+    g_assert_cmpuint(table & PCI_MSIX_FLAGS_BIRMASK, ==, 0);
+    off = table & ~PCI_MSIX_FLAGS_BIRMASK;
+    /* Vectors v write v+1 at target + 4 * v */
+    for (v = 0; v < 16; v++) {
+        uint32_t e = off + v * 16;
+
+        wr(t, e + PCI_MSIX_ENTRY_LOWER_ADDR, (uint32_t)(target + 4 * v));
+        wr(t, e + PCI_MSIX_ENTRY_UPPER_ADDR, (target + 4 * v) >> 32);
+        wr(t, e + PCI_MSIX_ENTRY_DATA, v + 1);
+        wr(t, e + PCI_MSIX_ENTRY_VECTOR_CTRL, 0);
+        qtest_writel(t->qts, target + 4 * v, 0);
+    }
+    qpci_config_writew(t->dev, cap + PCI_MSIX_FLAGS,
+                       ctrl | PCI_MSIX_FLAGS_ENABLE);
+
+    /* Spec 12.6.3.4.8: cause 0 (TX0) -> vector 2, cause 16 (RX0) -> 5 */
+    wr(t, IVAR0, 2);
+    wr(t, IVAR0 + 8, 5);
+    wr(t, IMS0, CAUSE_TX0 | CAUSE_RX0);
+
+    rings_setup(t, 8, 8);
+    rx_post(t, 4);
+    tx_queue(t, 1, 8, 1);
+    tx_doorbell(t);
+    g_assert_cmphex(qtest_readl(t->qts, target + 4 * 2), ==, 3);
+    g_assert_cmphex(qtest_readl(t->qts, target + 4 * 5), ==, 6);
+    g_assert_cmphex(qtest_readl(t->qts, target + 4 * 0), ==, 0);
+    t_stop(t);
+}
