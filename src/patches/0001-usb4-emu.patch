+/*
+ * An RX buffer the device cannot write (unassigned address) does not
+ * complete: no DD, Producer Index unchanged, no status, frame kept. Once
+ * the guest repairs the descriptor and rings the doorbell it arrives.
+ */
+static void test_rx_dma_error(void)
+{
+    T *t = t_start("pc", NULL);
+
+    rings_setup(t, 8, 8);
+    desc_write(t, t->rx_ring, 0, 0x10000000000ULL, DESC_RS | DESC_IE);
+    t->rx_ci = 1;
+    wr(t, RX_RING(0) + RING_INDEX, t->rx_ci);
+    tx_queue(t, 0xabc00000, 16, 1);
+    tx_doorbell(t);
+    g_assert_cmpuint(tx_ci(t), ==, 1);
+    g_assert_cmpuint(rx_pi(t), ==, 0);
+    g_assert_cmphex(desc_dw2(t, t->rx_ring, 0) & DESC_DD, ==, 0);
+    g_assert_cmphex(isr0(t) & CAUSE_RX0, ==, 0);
+
+    /* Repaired: the queued frame completes into descriptor 0. */
+    desc_write(t, t->rx_ring, 0, t->rx_buf, DESC_RS | DESC_IE);
+    wr(t, RX_RING(0) + RING_INDEX, t->rx_ci);
+    g_assert_cmpuint(rx_pi(t), ==, 1);
+    rx_expect(t, 0xabc00000, 16, 1);
+    t_stop(t);
+}
