+static void test_boot_acl(void)
+{
+    uint32_t w[64], cmd[33] = { 0x00000018 };
+    T *t = t_start(NULL, false);
+
+    icm_bind(t, w);
+    /* R14: 16 empty slots */
+    icm_cmd(t, cmd, 33);
+    g_assert_cmpuint(icm_expect(t, PDF_ICM_RESP, w), ==, 33);
+    g_assert_cmphex(w[0], ==, 0x01000018);
+    for (int i = 1; i < 33; i++) {
+        g_assert_cmphex(w[i], ==, 0xffffffff);
+    }
+    /* write as captured (T:7101): flags 0x80 echoed, entries zero */
+    cmd[0] = 0x00008018;
+    for (int i = 1; i < 33; i++) {
+        cmd[i] = 0xffffffff;
+    }
+    cmd[1] = 0xa0211100;
+    cmd[2] = 0x003d0efc;
+    icm_cmd(t, cmd, 33);
+    g_assert_cmpuint(icm_expect(t, PDF_ICM_RESP, w), ==, 33);
+    g_assert_cmphex(w[0], ==, 0x01008018);
+    g_assert_cmphex(w[1], ==, 0);
+    cmd[0] = 0x00000018;
+    icm_cmd(t, cmd, 33);
+    icm_expect(t, PDF_ICM_RESP, w);
+    g_assert_cmphex(w[1], ==, 0xa0211100);
+    g_assert_cmphex(w[2], ==, 0x003d0efc);
+    g_assert_cmphex(w[3], ==, 0xffffffff);
+
+    /* truncated and multi-packet writes are refused, ACL unchanged */
+    cmd[0] = 0x00008018;
+    icm_cmd(t, cmd, 1);
+    icm_expect(t, PDF_ICM_RESP, w);
+    g_assert_cmphex(w[0], ==, 0x01008118);
+    icm_cmd(t, cmd, 9);
+    icm_expect(t, PDF_ICM_RESP, w);
+    g_assert_cmphex(w[0], ==, 0x01008118);
+    cmd[0] = 0x02008018;
+    icm_cmd(t, cmd, 33);
+    icm_expect(t, PDF_ICM_RESP, w);
+    g_assert_cmphex(w[0] & 0x100, ==, 0x100);
+    cmd[0] = 0x00000018;
+    icm_cmd(t, cmd, 33);
+    icm_expect(t, PDF_ICM_RESP, w);
+    g_assert_cmphex(w[1], ==, 0xa0211100);
+    g_assert_cmphex(w[2], ==, 0x003d0efc);
+    g_assert_cmphex(w[3], ==, 0xffffffff);
+    t_stop(t);
+}
