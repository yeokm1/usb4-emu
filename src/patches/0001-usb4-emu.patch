+/*
+ * q35 with tp0 behind a usb4-host whose device router has the NVMe
+ * layout @dev_props; the tunnel is forced up. True if inserted, false
+ * if the insertion failed.
+ */
+static bool layout_start(QTestState **pqts, const char *img,
+                         const char *img2, const char *dev_props)
+{
+    QTestState *qts = qtest_initf(
+        "-machine q35 "
+        "-global ICH9-LPC.acpi-pci-hotplug-with-bridge-support=off "
+        "-drive if=none,id=disk0,file=%s,format=raw "
+        "-drive if=none,id=disk1,file=%s,format=raw "
+        "-device usb4-tunnel-port,id=tp0,bus=pcie.0,addr=0x3,chassis=1,"
+        "settle-ms=200 "
+        "-device usb4-host,id=u4,bus=pcie.0,addr=0x4,tunnel-port=tp0 "
+        "-device usb4-device,id=enc0,bus=u4.0,port=1,serial=QTL,%s",
+        img, img2, dev_props);
+
+    cfg_writel(qts, 0, TP_DEVFN, 0x18, 0x00010100);
+    cfg_writel(qts, 0, TP_DEVFN, find_exp_cap(qts) + 0x18, 0x0100);
+    qom_set_str(qts, TP_PATH, "tunnel", "up");
+    *pqts = qts;
+    return wait_stage2(qts, "inserted", "insert-failed");
+}
