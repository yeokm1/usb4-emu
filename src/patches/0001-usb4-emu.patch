+/*
+ * Review 2 #1: removing the controller's switch below the root port
+ * (device_del of the upstream port, the guest powering the slot off)
+ * must not crash, whatever the device order of the teardown.
+ */
+static void test_controller_removal(void)
+{
+    QTestState *qts = power_start(",security=none", true);
+    uint16_t exp = rp_exp(qts);
+    QDict *rsp;
+
+    g_assert_true(usp_visible(qts));
+    qtest_qmp_device_del_send(qts, "tbusp");
+    /* the guest's answer: slot power off, power indicator off */
+    cfg_wr(qts, 0, RP_DEVFN, exp + 0x18,
+           (cfg_rd(qts, 0, RP_DEVFN, exp + 0x18) & ~0x3ffu) | 0x7c0);
+    qtest_clock_step(qts, 1000 * 1000 * 1000LL);
+    qtest_qmp_eventwait(qts, "DEVICE_DELETED");
+    rsp = qtest_qmp(qts, "{'execute': 'query-status'}");
+    g_assert_true(qdict_haskey(rsp, "return"));
+    qobject_unref(rsp);
+    qtest_quit(qts);
+}
+
+/* bridge topology with a chosen device order (review 2 #5, #6) */
+static QTestState *order_start(const char *order, const char *acl)
+{
+    const char *host = "-device usb4-host,id=u4,bus=pcie.0,addr=0x4,"
+                       "tunnel-port=tp0,profile=tb3-alpine-ridge,"
+                       "preboot=on,preboot-acl-only=on";
+    const char *tp = "-device usb4-tunnel-port,id=tp0,bus=pcie.0,addr=0x3,"
+                     "chassis=1,settle-ms=200";
+    const char *dev = "-device usb4-device,id=d0,bus=u4.0,port=1,"
+                      "dialect=tb3,drive=disk0,serial=QTICM";
+    QTestState *qts;
+
+    if (!strcmp(order, "host-dev-tp")) {
+        qts = qtest_initf("-machine q35 -global ICH9-LPC.acpi-pci-hotplug-"
+                          "with-bridge-support=off -drive if=none,id=disk0,"
+                          "file=null-co://,format=raw %s,boot-acl=%s %s %s",
+                          host, acl, dev, tp);
+    } else {
+        qts = qtest_initf("-machine q35 -global ICH9-LPC.acpi-pci-hotplug-"
+                          "with-bridge-support=off -drive if=none,id=disk0,"
+                          "file=null-co://,format=raw %s %s,boot-acl=%s",
+                          tp, host, acl);
+    }
+    return qts;
+}
+
+static char *learn_acl(void)
+{
+    uint32_t w[64], uuid[4];
+    uint8_t b[8];
+    unsigned n;
+    T *t = t_start(NULL, true);
+
+    icm_bind(t, w);
+    n = icm_expect(t, PDF_ICM_EVENT, w);
+    check_connected(w, n, false, false, uuid);
+    t_stop(t);
+    stl_le_p(b, uuid[0]);
+    stl_le_p(b + 4, uuid[1]);
+    return g_strdup_printf("%02x%02x%02x%02x-%02x%02x-%02x%02x-ffff-"
+                           "ffffffffffff", b[0], b[1], b[2], b[3], b[4],
+                           b[5], b[6], b[7]);
+}
+
+static bool nvme_cold_and_visible(QTestState *qts)
+{
+    g_autofree char *st = endpoint_state(qts);
+
+    /* tunnel port at 0:3.0 -> bus 1, the NVMe at 1:0.0 */
+    qtest_outl(qts, 0xcf8, 0x80000000 | (QPCI_DEVFN(3, 0) << 8) | 0x18);
+    qtest_outl(qts, 0xcfc, 0x00010100);
+    return strstr(st, "gate=open") && cfg_rd(qts, 1, 0, 0) == 0x00101b36;
+}
+
+/* Review 2 #5: pre-boot approval whatever the device order */
+static void test_preboot_order(void)
+{
+    g_autofree char *acl = learn_acl();
+    QTestState *qts = order_start("host-dev-tp", acl);
+
+    g_assert_true(nvme_cold_and_visible(qts));
+    qtest_quit(qts);
+}
+
+/* Review 2 #6: pre-boot on a later machine reset is a cold insertion */
+static void test_preboot_reset(void)
+{
+    g_autofree char *acl = learn_acl();
+    QTestState *qts = order_start("tp-host", acl);
+
+    g_assert_false(nvme_cold_and_visible(qts));
+    qtest_qmp_device_add(qts, "usb4-device", "d0",
+                         "{'bus': 'u4.0', 'port': 1, 'dialect': 'tb3', "
+                         "'drive': 'disk0', 'serial': 'QTICM'}");
+    qtest_qmp_assert_success(qts, "{'execute': 'system_reset'}");
+    qtest_qmp_eventwait(qts, "RESET");
+    g_assert_true(nvme_cold_and_visible(qts));
+    qtest_quit(qts);
+}
+
+/*
+ * Review 3 #2: a replacement endpoint pending behind an obsolete one
+ * (removal held, device router detached and reconnected) is still cold
+ * at the next machine reset: the old occupant is removed and the new one
+ * inserted before the reset returns.
+ */
+static void test_reset_pending_removal(void)
+{
+    QTestState *qts = qtest_initf(
+        "-machine q35 -global ICH9-LPC.acpi-pci-hotplug-with-bridge-"
+        "support=off -drive if=none,id=disk0,file=null-co://,format=raw "
+        "-device usb4-tunnel-port,id=tp0,bus=pcie.0,addr=0x3,chassis=1,"
+        "settle-ms=200 "
+        "-device usb4-host,id=u4,bus=pcie.0,addr=0x4,tunnel-port=tp0,"
+        "profile=tb3-alpine-ridge,security=none "
+        "-device usb4-device,id=d0,bus=u4.0,port=1,dialect=tb3,"
+        "drive=disk0,serial=QTICM");
+    g_autofree char *st = NULL;
+
+    g_assert_true(nvme_cold_and_visible(qts));
+    qtest_qmp_assert_success(qts, "{'execute': 'qom-set', 'arguments': "
+                             "{'path': '/machine/peripheral/tp0', "
+                             "'property': 'x-hold-deferred', 'value': true}}");
+    qtest_qmp_device_del_send(qts, "d0");
+    qtest_qmp_device_add(qts, "usb4-device", "d0",
+                         "{'bus': 'u4.0', 'port': 1, 'dialect': 'tb3', "
+                         "'drive': 'disk0', 'serial': 'QTICM'}");
+    st = endpoint_state(qts);
+    g_assert_nonnull(strstr(st, "gate=closed"));
+    qtest_qmp_assert_success(qts, "{'execute': 'system_reset'}");
+    qtest_qmp_eventwait(qts, "RESET");
+    g_assert_true(nvme_cold_and_visible(qts));
+    g_free(st);
+    st = endpoint_state(qts);
+    g_assert_nonnull(strstr(st, "gen=2 "));
+    qtest_quit(qts);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    qtest_add_func("/usb4-icm/identity", test_identity);
+    qtest_add_func("/usb4-icm/switch-pins", test_switch_pins);
+    qtest_add_func("/usb4-icm/driver-ready", test_driver_ready);
+    qtest_add_func("/usb4-icm/boot-acl", test_boot_acl);
+    qtest_add_func("/usb4-icm/msix-autoclear", test_msix_autoclear);
+    qtest_add_func("/usb4-icm/device-user", test_device_user);
+    qtest_add_func("/usb4-icm/device-none", test_device_none);
+    qtest_add_func("/usb4-icm/usb4-device", test_usb4_device);
+    qtest_add_func("/usb4-icm/usb-fallback", test_usb_fallback);
+    qtest_add_func("/usb4-icm/usb-fallback-reset", test_usb_fallback_reset);
+    qtest_add_func("/usb4-icm/usb-fallback-bot", test_usb_fallback_bot);
+    qtest_add_func("/usb4-icm/xhci-property", test_xhci_property);
+    qtest_add_func("/usb4-icm/preboot", test_preboot);
+    qtest_add_func("/usb4-icm/power", test_power);
+    qtest_add_func("/usb4-icm/power-mmio", test_power_mmio);
+    qtest_add_func("/usb4-icm/assist-silence", test_assist_silence);
+    qtest_add_func("/usb4-icm/assist-silence-recovery",
+                   test_assist_silence_recovery);
+    qtest_add_func("/usb4-icm/controller-removal", test_controller_removal);
+    qtest_add_func("/usb4-icm/assist-functions", test_assist_functions);
+    qtest_add_func("/usb4-icm/ready-hold", test_ready_hold);
+    qtest_add_func("/usb4-icm/ready-hold-backpressure",
+                   test_ready_hold_backpressure);
+    qtest_add_func("/usb4-icm/ready-hold-unload", test_ready_hold_unload);
+    qtest_add_func("/usb4-icm/power-off-usb4", test_power_off_usb4);
+    qtest_add_func("/usb4-icm/approve-timing", test_approve_timing);
+    qtest_add_func("/usb4-icm/preboot-order", test_preboot_order);
+    qtest_add_func("/usb4-icm/preboot-reset", test_preboot_reset);
+    qtest_add_func("/usb4-icm/reset-pending-removal",
+                   test_reset_pending_removal);
+    return g_test_run();
+}
diff --git a/tests/qtest/usb4-icm-tr-test.c b/tests/qtest/usb4-icm-tr-test.c
new file mode 100644
index 0000000000000000000000000000000000000000..3fe17ffe1c43e6f9006413a345bb8fe75a754be2
--- /dev/null
+++ b/tests/qtest/usb4-icm-tr-test.c
@@ -0,0 +1,1157 @@
+/*
+ * QTest for the tb3-titan-ridge profile of usb4-host: the Titan Ridge
+ * variant of the emulated firmware connection manager (ICM)
+ *
+ * Copyright (c) 2026 usb4-emu contributors
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Same structure and helpers as usb4-icm-test.c (the Alpine Ridge
+ * profile). Expected values come from docs/ICM-TITAN-RIDGE.md, which is
+ * inferred from the Linux ICM client, not from a capture: these tests
+ * pin the model to that description (requirements T1-T12), they do not
+ * prove real Titan Ridge firmware behaves the same. The guest side is
+ * driven by polling only: MSI, MSI-X and INTx are never enabled.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/bswap.h"
+#include "libqtest.h"
+#include "libqos/pci.h"
+#include "libqos/pci-pc.h"
+#include "libqos/malloc-pc.h"
+#include "hw/pci/pci_regs.h"
+#include "qobject/qdict.h"
+
+#define DEVFN                QPCI_DEVFN(4, 0)
+#define TP_PATH              "/machine/peripheral/tp0"
+#define TP1_PATH             "/machine/peripheral/tp1"
+
+/* BAR0, ICM-PROTOCOL.md 2.1 (shared by both dialects, T1) */
+#define TX_RING(n)           (0x00000 + (n) * 0x10)
+#define RX_RING(n)           (0x08000 + (n) * 0x10)
+#define  RING_BASE_LO        0x0
+#define  RING_BASE_HI        0x4
+#define  RING_INDEX          0x8
+#define  RING_SIZE           0xc
+#define TX_CTRL(n)           (0x19800 + (n) * 0x20)
+#define RX_CTRL(n)           (0x29800 + (n) * 0x20)
+#define RX_PDF(n)            (0x29804 + (n) * 0x20)
+#define RING_VALID           (1u << 31)
+#define RING_RAW             (1u << 30)
+#define IMR0                 0x38200
+#define HI_CAPS              0x39640
+#define DMA_MISC             0x39864
+#define INMAIL_DATA          0x39900
+#define INMAIL_CMD           0x39904
+#define OUTMAIL              0x3990c
+#define FW_STS               0x39944
+
+#define PDF_READ             1
+#define PDF_WRITE            2
+#define PDF_ERROR            3
+#define PDF_ICM_EVENT        10
+#define PDF_ICM_CMD          11
+#define PDF_ICM_RESP         12
+
+#define DESC_DD              (1u << 21)
+#define DESC_RS              (1u << 22)
+#define DESC_IE              (1u << 23)
+
+#define RING_N               16
+#define BUF_SIZE             256
+
+/* Driver-ready info half-word, T2: user, protocol 2, 16 ACL entries */
+#define TR_INFO_USER         (1u | (2u << 4) | (16u << 7))
+
+typedef struct T {
+    QTestState *qts;
+    QPCIBus *bus;
+    QPCIDevice *dev;
+    QPCIBar bar;
+    QGuestAllocator alloc;
+    uint64_t tx_ring, rx_ring, tx_buf, rx_buf;
+    unsigned tx_pi, rx_ci, rx_next;
+    char *img;
+} T;
+
+static uint32_t rd(T *t, uint32_t off)
+{
+    return qpci_io_readl(t->dev, t->bar, off);
+}
+
+static void wr(T *t, uint32_t off, uint32_t v)
+{
+    qpci_io_writel(t->dev, t->bar, off, v);
+}
+
+/*
+ * Two tunnel ports (4C: one per Thunderbolt port). @dev1 / @dev2 attach
+ * a TB3 device router (the TS3 Plus model) to port 1 / port 2.
+ */
+static T *t_start2(const char *host_opts, bool dev1, bool dev2)
+{
+    T *t = g_new0(T, 1);
+    int fd = g_file_open_tmp("usb4-icm-tr-XXXXXX", &t->img, NULL);
+
+    g_assert(fd >= 0);
+    g_assert(ftruncate(fd, 1024 * 1024) == 0);
+    close(fd);
+    t->qts = qtest_initf("-machine q35 "
+                         "-global ICH9-LPC.acpi-pci-hotplug-with-bridge-"
+                         "support=off "
+                         "-drive if=none,id=disk0,file=%s,format=raw "
+                         "-drive if=none,id=disk1,file=null-co://,"
+                         "format=raw "
+                         "-device usb4-tunnel-port,id=tp0,bus=pcie.0,"
+                         "addr=0x3,chassis=1,settle-ms=200 "
+                         "-device usb4-tunnel-port,id=tp1,bus=pcie.0,"
+                         "addr=0x5,chassis=2,settle-ms=200 "
+                         "-device usb4-host,id=u4,bus=pcie.0,addr=0x4,"
+                         "tunnel-port=tp0,tunnel-port2=tp1,"
+                         "profile=tb3-titan-ridge%s %s %s",
+                         t->img, host_opts ? host_opts : "",
+                         dev1 ? "-device usb4-device,id=d0,bus=u4.0,port=1,"
+                                "dialect=tb3,drive=disk0,serial=QTTR" : "",
+                         dev2 ? "-device usb4-device,id=d1,bus=u4.0,port=2,"
+                                "dialect=tb3,drive=disk1,serial=QTTR2" : "");
+    pc_alloc_init(&t->alloc, t->qts, ALLOC_NO_FLAGS);
+    t->bus = qpci_new_pc(t->qts, &t->alloc);
+    t->dev = qpci_device_find(t->bus, DEVFN);
+    g_assert(t->dev);
+    qpci_device_enable(t->dev);
+    t->bar = qpci_iomap(t->dev, 0, NULL);
+    return t;
+}
+
+static T *t_start(const char *host_opts, bool with_device)
+{
+    return t_start2(host_opts, with_device, false);
+}
+
+static void t_stop(T *t)
+{
+    g_free(t->dev);
+    qpci_free_pc(t->bus);
+    alloc_destroy(&t->alloc);
+    qtest_quit(t->qts);
+    if (t->img) {
+        unlink(t->img);
+    }
+    g_free(t->img);
+    g_free(t);
+}
+
+/* ---- ring 0, raw mode, as the Linux client sets it up ---- */
+
+static void desc_write(T *t, uint64_t ring, unsigned i, uint64_t addr,
+                       uint32_t dw2)
+{
+    uint64_t d = ring + i * 16;
+
+    qtest_writel(t->qts, d, (uint32_t)addr);
+    qtest_writel(t->qts, d + 4, addr >> 32);
+    qtest_writel(t->qts, d + 8, dw2);
+    qtest_writel(t->qts, d + 12, 0);
+}
+
+static void rx_post(T *t, unsigned n)
+{
+    while (n--) {
+        desc_write(t, t->rx_ring, t->rx_ci, t->rx_buf + t->rx_ci * BUF_SIZE,
+                   DESC_RS | DESC_IE);
+        t->rx_ci = (t->rx_ci + 1) % RING_N;
+    }
+    wr(t, RX_RING(0) + RING_INDEX, t->rx_ci);
+}
+
+static void rings_setup(T *t)
+{
+    if (!t->tx_ring) {
+        t->tx_ring = guest_alloc(&t->alloc, RING_N * 16);
+        t->rx_ring = guest_alloc(&t->alloc, RING_N * 16);
+        t->tx_buf = guest_alloc(&t->alloc, RING_N * BUF_SIZE);
+        t->rx_buf = guest_alloc(&t->alloc, RING_N * BUF_SIZE);
+    }
+    t->tx_pi = t->rx_ci = t->rx_next = 0;
+    wr(t, TX_RING(0) + RING_BASE_LO, (uint32_t)t->tx_ring);
+    wr(t, TX_RING(0) + RING_BASE_HI, t->tx_ring >> 32);
+    wr(t, TX_RING(0) + RING_SIZE, RING_N);
+    wr(t, TX_CTRL(0), RING_VALID | RING_RAW);
+    wr(t, RX_RING(0) + RING_BASE_LO, (uint32_t)t->rx_ring);
+    wr(t, RX_RING(0) + RING_BASE_HI, t->rx_ring >> 32);
+    wr(t, RX_RING(0) + RING_SIZE, RING_N | (BUF_SIZE << 16));
+    wr(t, RX_PDF(0), 0xffffffff);
+    wr(t, RX_CTRL(0), RING_VALID | RING_RAW);
+    wr(t, IMR0, (1u << 0) | (1u << 12));
+    rx_post(t, RING_N - 1);
+}
+
+static void rings_stop(T *t)
+{
+    wr(t, IMR0, 0);
+    wr(t, TX_CTRL(0), 0);
+    wr(t, RX_CTRL(0), 0);
+}
+
+static uint32_t crc32c(const uint8_t *p, size_t n)
+{
+    uint32_t c = 0xffffffff;
+
+    while (n--) {
+        c ^= *p++;
+        for (int b = 0; b < 8; b++) {
+            c = (c >> 1) ^ ((c & 1) ? 0x82f63b78 : 0);
+        }
+    }
+    return ~c;
+}
+
+static void tx_frame(T *t, unsigned pdf, const uint32_t *w, unsigned n)
+{
+    uint8_t buf[BUF_SIZE];
+    uint64_t b = t->tx_buf + t->tx_pi * BUF_SIZE;
+
+    for (unsigned i = 0; i < n; i++) {
+        stl_be_p(buf + 4 * i, w[i]);
+    }
+    stl_be_p(buf + 4 * n, crc32c(buf, 4 * n));
+    qtest_memwrite(t->qts, b, buf, 4 * n + 4);
+    desc_write(t, t->tx_ring, t->tx_pi, b,
+               (4 * n + 4) | (pdf << 12) | DESC_RS | DESC_IE);
+    t->tx_pi = (t->tx_pi + 1) % RING_N;
+    wr(t, TX_RING(0) + RING_INDEX, t->tx_pi << 16);
+}
+
+static void icm_cmd(T *t, const uint32_t *w, unsigned n)
+{
+    tx_frame(t, PDF_ICM_CMD, w, n);
+}
+
+static unsigned icm_recv(T *t, uint32_t *w, unsigned *n)
+{
+    unsigned i = t->rx_next, len, pdf;
+    uint32_t dw2;
+    uint8_t buf[BUF_SIZE];
+
+    if (((rd(t, RX_RING(0) + RING_INDEX) >> 16) & 0xffff) == i) {
+        return 0;
+    }
+    dw2 = qtest_readl(t->qts, t->rx_ring + i * 16 + 8);
+    g_assert_cmphex(dw2 & DESC_DD, ==, DESC_DD);
+    len = dw2 & 0xfff;
+    pdf = (dw2 >> 12) & 0xf;
+    g_assert_cmpuint(len, >=, 8);
+    g_assert_cmpuint(len, <=, BUF_SIZE);
+    qtest_memread(t->qts, t->rx_buf + i * BUF_SIZE, buf, len);
+    g_assert_cmphex(crc32c(buf, len - 4), ==,
+                    (uint32_t)ldl_be_p(buf + len - 4));
+    *n = len / 4 - 1;
+    for (unsigned k = 0; k < *n; k++) {
+        w[k] = (uint32_t)ldl_be_p(buf + 4 * k);
+    }
+    t->rx_next = (i + 1) % RING_N;
+    rx_post(t, 1);
+    return pdf;
+}
+
+static unsigned icm_expect(T *t, unsigned pdf, uint32_t *w)
+{
+    unsigned n = 0, got = icm_recv(t, w, &n);
+
+    g_assert_cmpuint(got, ==, pdf);
+    return n;
+}
+
+static void icm_expect_none(T *t)
+{
+    uint32_t w[64];
+    unsigned n;
+
+    g_assert_cmpuint(icm_recv(t, w, &n), ==, 0);
+}
+
+static uint32_t mailbox(T *t, uint8_t cmd)
+{
+    wr(t, INMAIL_DATA, 0);
+    wr(t, INMAIL_CMD, (1u << 31) | cmd);
+    return rd(t, INMAIL_CMD);
+}
+
+/* Bind sequence (ICM-PROTOCOL.md 6.1, shared, T1) to the response. */
+static void icm_bind(T *t, uint32_t *resp)
+{
+    uint32_t dr = 0x00000003;
+
+    g_assert_cmphex(rd(t, FW_STS) & 0x80000001, ==, 0x80000001);
+    g_assert_cmphex((rd(t, OUTMAIL) >> 8) & 0xf, ==, 3);
+    rings_setup(t);
+    g_assert_cmphex(mailbox(t, 0x23), ==, 0x23);
+    icm_cmd(t, &dr, 1);
+    /* T2: four words */
+    g_assert_cmpuint(icm_expect(t, PDF_ICM_RESP, resp), ==, 4);
+}
+
+/*
+ * Config read (Spec 6.4 / ICM-PROTOCOL.md 5): @cs 1 adapter, 2 router.
+ * Returns the PDF of the answer; the first data dword in *@v.
+ */
+static unsigned cfg_read(T *t, uint64_t route, unsigned cs, unsigned adp,
+                         unsigned off, uint32_t *v)
+{
+    uint32_t f[3], w[64];
+    unsigned pdf, n = 0;
+
+    f[0] = route >> 32;
+    f[1] = (uint32_t)route;
+    f[2] = off | (1u << 13) | (adp << 19) | (cs << 25);
+    tx_frame(t, PDF_READ, f, 3);
+    pdf = icm_recv(t, w, &n);
+    if (pdf == PDF_READ) {
+        g_assert_cmpuint(n, ==, 4);
+        *v = w[3];
+    }
+    return pdf;
+}
+
+/* ---- PCI and fabric helpers ---- */
+
+static char *endpoint_state(QTestState *qts, const char *path)
+{
+    QDict *rsp = qtest_qmp(qts, "{'execute': 'qom-get', 'arguments': "
+                           "{'path': %s, 'property': 'endpoint'}}", path);
+    char *s = g_strdup(qdict_get_str(rsp, "return"));
+
+    qobject_unref(rsp);
+    return s;
+}
+
+static bool gate_open_at(QTestState *qts, const char *path)
+{
+    g_autofree char *st = endpoint_state(qts, path);
+
+    return strstr(st, "gate=open") != NULL;
+}
+
+static bool gate_open(QTestState *qts)
+{
+    return gate_open_at(qts, TP_PATH);
+}
+
+static bool gate_opens(QTestState *qts)
+{
+    for (int i = 0; i < 50; i++) {
+        if (gate_open(qts)) {
+            return true;
+        }
+        qtest_clock_step(qts, 100 * 1000 * 1000);
+    }
+    return false;
+}
