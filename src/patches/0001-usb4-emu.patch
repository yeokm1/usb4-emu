--- /dev/null
+++ b/hw/usb4/usb4-internal.h
@@ -0,0 +1,567 @@
+/*
+ * USB4 / Thunderbolt 3 host emulation - internal interfaces
+ *
+ * Copyright (c) 2026 usb4-emu contributors
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Written from scratch for the usb4-emu project. See docs/ARCHITECTURE.md
+ * in the usb4-emu repository for the component split:
+ *
+ *   [1] host interface (usb4-host.c)  <-- ring 0 frames -->  [2] fabric
+ *   (usb4-fabric.c, usb4-ctl.c)  -->  [3] tunnel evaluator (usb4-tunnel.c)
+ *   -->  [4] PCI integration (usb4-tunnel-port.c)
+ *
+ * Each component only talks to its neighbours through the functions
+ * declared here.
+ */
+
+#ifndef HW_USB4_INTERNAL_H
+#define HW_USB4_INTERNAL_H
+
+#include "hw/usb4/usb4.h"
+
+/* ------------------------------------------------------------------ */
+/* Profiles (docs/ARCHITECTURE.md section 2)                           */
+/* ------------------------------------------------------------------ */
+
+typedef enum USB4Profile {
+    USB4_PROFILE_USB4_GENERIC = 0,
+    /*
+     * Intel Thunderbolt 3 controller impersonation with the firmware CM
+     * (ICM-PROTOCOL.md). One profile for every TB3 controller: the
+     * controller variant (USB4Tb3Host) only selects the PCI identity,
+     * the host router layout and the ICM message dialect. Profile names
+     * tb3-alpine-ridge and tb3-titan-ridge (ICM-TITAN-RIDGE.md).
+     */
+    USB4_PROFILE_TB3_ALPINE_RIDGE = 1,
+} USB4Profile;
+
+/*
+ * Controller variant of the TB3 firmware-CM profile: host router layout
+ * (usb4-router-tb3.c) and identity. Alpine Ridge LP is the captured
+ * P14s controller (ICM-PROTOCOL.md 1, 5.1); the Titan Ridge variants
+ * are inferred (docs/ICM-TITAN-RIDGE.md).
+ */
+typedef enum USB4Tb3Host {
+    USB4_TB3_HOST_AR_LP = 0,    /* JHL6240, one port */
+    USB4_TB3_HOST_TR_2C = 1,    /* JHL7340, one port */
+    USB4_TB3_HOST_TR_4C = 2,    /* JHL7540, two ports */
+} USB4Tb3Host;
+
+/* ICM message dialect (docs/ICM-TITAN-RIDGE.md 2) */
+typedef enum USB4ICMDialect {
+    USB4_ICM_DIALECT_AR = 0,    /* Alpine Ridge, ICM-PROTOCOL.md 4 */
+    USB4_ICM_DIALECT_TR = 1,    /* Titan Ridge, ICM-TITAN-RIDGE.md 3 */
+} USB4ICMDialect;
+
+typedef enum USB4Dialect {
+    USB4_DIALECT_USB4 = 0,
+    USB4_DIALECT_TB3 = 1,
+} USB4Dialect;
+
+/*
+ * Host router preset of the usb4-generic profile (docs/USB4-HOSTS.md):
+ * the spec-derived minimal router, the captured Intel Alder Lake-P
+ * integrated host router (usb4-router-adl.c), the ASMedia ASM4242
+ * discrete host router of AM5 X870 boards, built from public sources
+ * only (usb4-router-asm.c, docs/research/AM5-USB4.md 7), or an AMD
+ * integrated USB4 host router (Yellow Carp / Pink Sardine), public
+ * sources only: the minimal router with AMD's router identity
+ * (docs/USB4-HOSTS.md 7, inferred).
+ */
+typedef enum USB4HostModel {
+    USB4_HOST_MODEL_MINIMAL = 0,
+    USB4_HOST_MODEL_INTEL_ADL = 1,
+    USB4_HOST_MODEL_ASM4242 = 2,
+    USB4_HOST_MODEL_AMD = 3,
+} USB4HostModel;
+
+/*
+ * asm4242 host model options (docs/USB4-HOSTS.md 5). Adapter numbers are
+ * inferred, not observed, so they are configurable: lanes are always
+ * 1-4 (USB4 ports 1 and 2); @adp_dp is the first of two DP IN adapters
+ * (0: none), @adp_hi the Host Interface adapter, @adp_pcie and @adp_usb3
+ * the first of two PCIe / USB3 Gen X Downstream adapters.
+ */
+typedef struct USB4AsmConfig {
+    uint8_t adp_dp;
+    uint8_t adp_hi;
+    uint8_t adp_pcie;
+    uint8_t adp_usb3;
+    /* Host Interface adapter path Pending Packets latches (quirk a) */
+    bool quirk_pending;
+    /* 174 lane buffers and baMaxHI 32 (quirk c, 7-bit credit overflow) */
+    bool quirk_credits;
+    /* NVM version and date as Linux shows them (hex); version 0: no NVM */
+    uint32_t nvm_version;
+    uint32_t nvm_date;
+} USB4AsmConfig;
+
+/* Validate an asm4242 adapter layout; false with @errp set if invalid. */
+bool usb4_asm_config_check(const USB4AsmConfig *c, Error **errp);
+
+/* ------------------------------------------------------------------ */
+/* Control packets (Spec 2.0 section 6.4, ring framing section 12.3)   */
+/* ------------------------------------------------------------------ */
+
+/*
+ * Protocol Defined Field values carried in the SOF/EOF descriptor
+ * fields of a ring 0 frame (Spec Table 6-? "Control Packet Types").
+ */
+enum {
+    USB4_PDF_READ = 0x1,        /* Read Request / Read Response */
+    USB4_PDF_WRITE = 0x2,       /* Write Request / Write Response */
+    USB4_PDF_NOTIFY = 0x3,      /* Notification Packet (errors) */
+    USB4_PDF_NOTIFY_ACK = 0x4,  /* Notification Acknowledgment */
+    USB4_PDF_HOTPLUG = 0x5,     /* Hot Plug Event */
+    USB4_PDF_XDOMAIN_REQ = 0x6, /* Inter-Domain Request */
+    USB4_PDF_XDOMAIN_RESP = 0x7,/* Inter-Domain Response */
+    USB4_PDF_NOTIFY_ACK_ENH = 0x8, /* Enhanced Notification Ack (v2) */
+    USB4_PDF_ICM_EVENT = 0xa,   /* TB3 firmware CM only */
+    USB4_PDF_ICM_REQ = 0xb,
+    USB4_PDF_ICM_RESP = 0xc,
+};
+
+/* Config space selector (Spec Table 6-? "Configuration Space" field). */
+enum {
+    USB4_CS_PATH = 0,
+    USB4_CS_ADAPTER = 1,
+    USB4_CS_ROUTER = 2,
+    USB4_CS_COUNTERS = 3,
+};
+
+/* Max control packet payload incl. header and CRC (Spec 6.4). */
+#define USB4_CTL_MAX_FRAME 256
+
+/* CRC32C (Castagnoli) as used by control packets, Spec 6.4.1.x. */
+uint32_t usb4_crc32c(const uint8_t *data, size_t len);
+
+/*
+ * Control packets on the wire are big-endian dwords. A frame as stored in
+ * a ring buffer is the packet followed by its CRC32C (big-endian).
+ * Returns true when the trailing CRC matches.
+ */
+bool usb4_ctl_frame_crc_ok(const uint8_t *frame, size_t len);
+/* Append the CRC to a frame of len bytes; buffer must have len + 4. */
+size_t usb4_ctl_frame_seal(uint8_t *frame, size_t len);
+
+/* ------------------------------------------------------------------ */
+/* Host interface <-> fabric                                           */
+/* ------------------------------------------------------------------ */
+
+typedef struct USB4Host USB4Host;     /* the PCI function (usb4-host.c) */
+typedef struct USB4Fabric USB4Fabric; /* router tree (usb4-fabric.c) */
+typedef struct USB4Device USB4Device; /* a device router (usb4-device.c) */
+typedef struct USB4TunnelPort USB4TunnelPort; /* usb4-tunnel-port.c */
+
+/*
+ * Host interface -> fabric. Called when the guest completes a TX
+ * descriptor on ring 0 (EOF set). @pdf is the descriptor's EOF PDF,
+ * @frame/@len the gathered frame including trailing CRC. The fabric
+ * validates the CRC itself and silently drops bad frames. May be called
+ * from MMIO context: the fabric must not hot-plug from here, only change
+ * state and queue replies (usb4_host_rx_frame()).
+ */
+void usb4_fabric_tx_frame(USB4Fabric *f, uint8_t pdf,
+                          const uint8_t *frame, size_t len);
+
+/*
+ * Fabric -> host interface. Queue a frame (already sealed with CRC)
+ * for delivery on RX ring 0 with SOF and EOF PDF = @pdf. The host keeps
+ * an internal FIFO and delivers as soon as the guest supplies RX
+ * descriptors; it never drops frames unless the FIFO (>= 64 frames)
+ * overflows or the host interface is reset.
+ */
+void usb4_host_rx_frame(USB4Host *h, uint8_t pdf,
+                        const uint8_t *frame, size_t len);
+
+/* Host interface reset / guest driver gone: drop fabric-side pending
+ * state such as unacknowledged hot-plug retransmits. */
+void usb4_fabric_host_reset(USB4Fabric *f);
+/*
+ * Firmware CM: hold config requests (@on) or serve the held ones and
+ * stop holding (ICM-PROTOCOL.md 6.2, R8: delayed, never dropped).
+ */
+void usb4_fabric_cfg_hold(USB4Fabric *f, bool on);
+/*
+ * Can the fabric take a frame with @pdf now? False while config
+ * requests are held and the hold queue is full: the host then leaves the
+ * TX descriptor pending (backpressure) until usb4_host_tx_resume().
+ */
+bool usb4_fabric_tx_ready(USB4Fabric *f, uint8_t pdf);
+void usb4_host_tx_resume(USB4Host *h);
+
+/* ------------------------------------------------------------------ */
+/* Fabric construction                                                  */
+/* ------------------------------------------------------------------ */
+
+typedef struct USB4FabricConfig {
+    USB4Profile profile;
+    USB4Dialect dialect;        /* host router dialect */
+    uint16_t router_vendor_id;  /* ROUTER_CS_0 vendor/product */
+    uint16_t router_device_id;
+    uint8_t num_usb4_ports;     /* downstream USB4 ports on the host */
+    USB4Tb3Host tb3_host;       /* tb3 dialect: host router layout */
+    QemuUUID uuid;              /* host router UUID / unique id */
+    USB4HostModel host_model;   /* usb4 dialect host router preset */
+    uint8_t host_domain;        /* intel-adl: domain 0-1; amd: 0-3 */
+    USB4AsmConfig asm4242;      /* asm4242 host model options */
+    /*
+     * Stable per-host discriminator (usb4-host: a hash of its QOM path and
+     * host-domain), for identities that must differ between hosts whose
+     * device routers are otherwise configured alike.
+     */
+    uint64_t host_salt;
+    /*
+     * Emulated platform firmware runs a software CM before the OS at every
+     * power-on and for devices attached before the OS takes over
+     * (docs/USB4-HOSTS.md, usb4-preos.c).
+     */
+    bool preos_cm;
+} USB4FabricConfig;
+
+USB4Fabric *usb4_fabric_new(USB4Host *h, const USB4FabricConfig *cfg);
+void usb4_fabric_free(USB4Fabric *f);
+/*
+ * preos-cm: the OS has taken over the host interface (first guest BAR
+ * access after reset); the firmware CM stops handling new devices.
+ */
+void usb4_fabric_preos_end(USB4Fabric *f);
+/* Power-on / system reset of the whole fabric (all config spaces). */
+void usb4_fabric_reset(USB4Fabric *f);
+
+/*
+ * Device router attach/detach on host USB4 port @port (1-based).
+ * Attach makes the lane adapters of that port report link up and queues
+ * a hot-plug event towards the CM; detach does the reverse and runs
+ * the tunnel evaluator (surprise removal if a tunnel was up).
+ */
+bool usb4_fabric_attach(USB4Fabric *f, unsigned port, USB4Device *d,
+                        Error **errp);
+void usb4_fabric_detach(USB4Fabric *f, unsigned port);
+
+/*
+ * Number of paths (rings) of the host interface. The host router's
+ * Host Interface Adapter reports Max Input/Output HopID = this - 1
+ * (Spec Table 8-9), so usb4-host.c must report the same Total Paths in
+ * its Host Interface Capabilities register (Spec 12.6.3.1.1).
+ */
+#define USB4_HOST_IF_TOTAL_PATHS 16
+
+/*
+ * Routing ID (bus << 8 | devfn, non-FPB scheme) of the PCIe downstream
+ * port backing host USB4 port @port. Reported by the Get PCIe
+ * Downstream Entry Mapping router operation (Spec 8.3.1.3.1). Optional:
+ * the default 0 means "not known".
+ */
+void usb4_fabric_set_pcie_down_rid(USB4Fabric *f, unsigned port,
+                                   uint16_t rid);
+
+/* ------------------------------------------------------------------ */
+/* Tunnel evaluator (docs/ARCHITECTURE.md section 4.3)                  */
+/* ------------------------------------------------------------------ */
+
+typedef enum USB4TunnelState {
+    USB4_TUNNEL_DOWN = 0,
+    USB4_TUNNEL_UP,
+} USB4TunnelState;
+
+typedef enum USB4TunnelReason {
+    USB4_TUNNEL_REASON_UP = 0,
+    USB4_TUNNEL_REASON_ADMIN_DOWN, /* CM cleared a path / enable */
+    USB4_TUNNEL_REASON_EJECT,      /* orderly unplug */
+    USB4_TUNNEL_REASON_SURPRISE,   /* device gone while tunnel up */
+} USB4TunnelReason;
+
+/*
+ * Pure input snapshot of fabric state for one host PCIe down adapter
+ * to device PCIe up adapter pair. Filled by the fabric, evaluated by
+ * usb4_tunnel_evaluate() which has no side effects.
+ */
+typedef struct USB4TunnelInputs {
+    bool device_attached;
+    bool lanes_up;
+    bool host_ready_for_pcie;
+    bool device_ready_for_pcie;
+    bool path_down_valid;   /* host PCIe down -> device PCIe up, all hops */
+    bool path_up_valid;     /* device PCIe up -> host PCIe down */
+    bool host_pcie_enabled; /* Path Enable on host PCIe down adapter */
+    bool dev_pcie_enabled;  /* Path Enable on device PCIe up adapter */
+    /*
+     * Daisy chain: the PCIe tunnel of the parent device router is up, so
+     * the PCIe switch holding the parent's PCIe Down adapter is
+     * reachable. Always true below the host router.
+     */
+    bool upstream_tunnel_up;
+} USB4TunnelInputs;
+
+USB4TunnelState usb4_tunnel_evaluate(const USB4TunnelInputs *in);
+
+/*
+ * Fabric -> PCI integration. Called synchronously whenever the
+ * evaluated state of the tunnel to @dev changes. On a down transition
+ * the tunnel port closes its gate before returning (Gate before you
+ * unplug, AGENTS.md); realise/unplug work is deferred to a bottom half.
+ */
+void usb4_tunnel_port_set_state(USB4TunnelPort *p, USB4Device *dev,
+                                USB4TunnelState st, USB4TunnelReason why);
+
+/* Current evaluated PCIe tunnel state of host USB4 port @port. */
+USB4TunnelState usb4_fabric_tunnel_state(USB4Fabric *f, unsigned port);
+/* Is the device router on host USB4 port @port in USB mode (R33)? */
+bool usb4_fabric_port_usb_mode(USB4Fabric *f, unsigned port);
+/*
+ * Added by the PCI-integration worker. PCIe requester ID (bus << 8 |
+ * devfn) of the tunnel root port, for the "Get PCIe Downstream Entry
+ * Mapping" router operation (usb4_fabric_set_pcie_down_rid()). The port
+ * sits on the root bus, so the value is stable once realised. Returns
+ * 0 for NULL.
+ */
+uint16_t usb4_tunnel_port_rid(USB4TunnelPort *p);
+/*
+ * tb3-alpine-ridge (usb4-host): gate @p as the power domain of the
+ * controller below it (R27), and give a tunnel that is up at machine
+ * reset its endpoint as a cold insertion (R25).
+ */
+void usb4_tunnel_port_power_domain(USB4TunnelPort *p, bool powered);
+/*
+ * True while the bridge itself resets the domain below it as a
+ * controller power-up (root-bus usb4-tunnel-bridge arrival, ARCHITECTURE.md
+ * 4.4a), so a reset hold phase below does not take it for machine
+ * power-on.
+ */
+bool usb4_tunnel_port_power_cycling(USB4TunnelPort *p);
+void usb4_tunnel_port_cold_reconcile(USB4TunnelPort *p, USB4Device *dev);
+/*
+ * usb4-acpi.c: the usb4-host whose tunnel port is @port, or the only
+ * usb4-host in the machine when that is unambiguous; NULL otherwise.
+ */
+PCIDevice *usb4_host_for_tunnel_port(PCIDevice *port);
+
+/*
+ * Daisy chaining. Attach device router @d to downstream USB4 port
+ * @dport (1-based, counting downstream ports only) of the attached
+ * device router @parent. Detach works at any depth; detaching a router
+ * also detaches every router below it (surprise removal of the whole
+ * subtree). usb4_fabric_detach() is the host port shorthand.
+ */
+bool usb4_fabric_attach_chained(USB4Fabric *f, USB4Device *parent,
+                                unsigned dport, USB4Device *d, Error **errp);
+void usb4_fabric_detach_device(USB4Fabric *f, USB4Device *d);
+
+/*
+ * In-emulator configuration access, for code that manages the fabric
+ * the way a connection manager does (the emulated ICM, docs/
+ * ARCHITECTURE.md 4.2b) without ring 0 frames. @route is a Route String
+ * (Spec 6.4.2.2), followed like a control packet; @cs a USB4_CS_* value;
+ * @adp is ignored for USB4_CS_ROUTER; @n is 1..60 dwords. Same register
+ * semantics and side effects (including tunnel re-evaluation) as a
+ * Read/Write Request from the guest. Returns false, with nothing sent to
+ * the guest, where the wire would give an error notification or no
+ * response: unreachable router, link down, uninitialized router and not
+ * router CS, missing adapter, or an out-of-range offset (a write stores
+ * the in-range part first, like the wire).
+ */
+bool usb4_fabric_cfg_read(USB4Fabric *f, uint64_t route, unsigned cs,
+                          unsigned adp, unsigned off, unsigned n,
+                          uint32_t *out);
+bool usb4_fabric_cfg_write(USB4Fabric *f, uint64_t route, unsigned cs,
+                           unsigned adp, unsigned off, unsigned n,
+                           const uint32_t *in);
+
+/* ------------------------------------------------------------------ */
+/* Device router (usb4-device.c)                                        */
+/* ------------------------------------------------------------------ */
+
+/* Accessors the fabric uses on a device router object. */
+USB4Dialect usb4_device_dialect(USB4Device *d);
+const char *usb4_device_nvme_drive(USB4Device *d);  /* blockdev id */
+const char *usb4_device_nvme_serial(USB4Device *d);
+/* nvme-ns layout "nsid:drive[;...]" and Identify NN (docs/HARNESS.md) */
+const char *usb4_device_nvme_namespaces(USB4Device *d);
+uint32_t usb4_device_nvme_nn(USB4Device *d);
+/* Per-device router state lives in the fabric; this is its handle. */
+void *usb4_device_get_router(USB4Device *d);
+void usb4_device_set_router(USB4Device *d, void *router);
+
+/* Host accessors used by usb4-device.c and the tunnel port. */
+USB4Fabric *usb4_host_get_fabric(USB4Host *h);
+USB4TunnelPort *usb4_host_get_tunnel_port(USB4Host *h); /* USB4 port 1 */
+/* Tunnel target backing the PCIe Down adapter of USB4 port @port (1-2). */
+USB4TunnelPort *usb4_host_get_port_tunnel(USB4Host *h, unsigned port);
+
+/* Added by the host-interface worker. */
+USB4Profile usb4_host_profile(USB4Host *h);
+/* The usb4-host that owns a usb4-bus, or NULL. */
+USB4Host *usb4_host_from_bus(BusState *bus);
+unsigned usb4_host_num_ports(USB4Host *h);
+/* Port occupancy bookkeeping done by usb4-device realize/unrealize. */
+bool usb4_host_claim_port(USB4Host *h, unsigned port, USB4Device *d,
+                          Error **errp);
+void usb4_host_release_port(USB4Host *h, unsigned port, USB4Device *d);
+/* The device router on host USB4 port @port (1-based), or NULL. */
+USB4Device *usb4_host_port_device(USB4Host *h, unsigned port);
+
+/*
+ * Daisy chaining: number of downstream USB4 ports of a device router
+ * (each with a PCIe Downstream adapter), and the tunnel target behind
+ * the PCIe Downstream adapter of downstream port @dport (1-based). The
+ * fabric passes that target to usb4_tunnel_port_set_state() for the
+ * PCIe tunnel of the router attached to @dport. NULL: no PCI side yet.
+ */
+unsigned usb4_device_downstream_ports(USB4Device *d);
+USB4TunnelPort *usb4_device_get_pcie_down_target(USB4Device *d,
+                                                 unsigned dport);
+/*
+ * The PCI side (usb4-tunnel-dsp) registers (@tp) or withdraws (NULL) the
+ * target of downstream port @dport. Registering replays the current
+ * state of the chained router's PCIe tunnel to it.
+ */
+void usb4_device_set_pcie_down_target(USB4Device *d, unsigned dport,
+                                      USB4TunnelPort *tp);
+/* Routing ID of that target, 0 if none (Get PCIe DS Entry Mapping). */
+uint16_t usb4_device_pcie_down_rid(USB4Device *d, unsigned dport);
+/*
+ * State of the PCIe tunnel of the router on downstream port @dport of
+ * device router @parent; *child is that router's device (or NULL).
+ */
+USB4TunnelState usb4_fabric_chained_tunnel(USB4Fabric *f, USB4Device *parent,
+                                           unsigned dport,
+                                           USB4Device **child);
+
+/*
+ * Device router preset (usb4-device "device-model"): the spec-derived
+ * router of usb4-router.c, or the captured ASMedia ASM2464PD
+ * (usb4-router-asm2464.c, docs/captures/ORICO-ASM2464.md).
+ */
+typedef enum USB4DeviceModel {
+    USB4_DEVICE_MODEL_DEFAULT = 0,
+    USB4_DEVICE_MODEL_ASM2464 = 1,
+} USB4DeviceModel;
+USB4DeviceModel usb4_device_model(USB4Device *d);
+/* Router UID ("uid" property); 0: the preset's default */
+uint64_t usb4_device_uid(USB4Device *d);
+/*
+ * dialect=tb3 on a USB4 host: lc-uuid=captured gives the link controller
+ * the UUID captured from the real dock (a fixture for one dock), the
+ * default (derived) a stable one of its own per device.
+ */
+bool usb4_device_lc_uuid_captured(USB4Device *d);
+
+/* More device router accessors (DROM strings, 1-based host port). */
+unsigned usb4_device_port(USB4Device *d);
+USB4Host *usb4_device_host(USB4Device *d);
+const char *usb4_device_vendor_name(USB4Device *d);
+const char *usb4_device_model_name(USB4Device *d);
+/* Dock mode: a PCIe switch with NVMe, NIC and xHCI behind the tunnel. */
+bool usb4_device_dock(USB4Device *d);
+const char *usb4_device_nic_netdev(USB4Device *d);  /* netdev id */
+const char *usb4_device_usb_drive(USB4Device *d);   /* blockdev id */
+
+/*
+ * USB3 tunneling (usb4-usb3.c). Fabric -> device router: the USB3 Gen X
+ * tunnel to @d changed state. Called synchronously from the fabric (may
+ * be MMIO context); attach/detach of the USB devices behind the
+ * enclosure runs from a bottom half.
+ */
+void usb4_device_usb3_tunnel(USB4Device *d, USB4TunnelState st,
+                             USB4TunnelReason why);
+/* Comma-separated ids of the USB devices behind @d ("usb3-dev"), or NULL */
+const char *usb4_device_usb3_devs(USB4Device *d);
+/* usb4-device realize/unrealize: register / forget @d's USB devices */
+void usb4_usb3_device_realized(USB4Device *d);
+void usb4_usb3_device_unrealized(USB4Device *d);
+
+/* ------------------------------------------------------------------ */
+/* Emulated firmware connection manager (usb4-icm.c), TB3 profile only. */
+/* Wire contract: docs/ICM-PROTOCOL.md (Alpine Ridge, R1-R31) and      */
+/* docs/ICM-TITAN-RIDGE.md (Titan Ridge dialect, T1-T12).              */
+/* ------------------------------------------------------------------ */
+
+typedef struct USB4ICM USB4ICM;
+
+typedef struct USB4ICMConfig {
+    USB4ICMDialect dialect;    /* message set, ICM-TITAN-RIDGE.md 3 */
+    uint16_t device_id;        /* TR driver-ready word 3 (NHI device ID) */
+    uint32_t nvm_version;      /* TR driver-ready word 2 */
+    uint8_t security;          /* ICM-PROTOCOL.md 4.1: 0 none, 1 user */
+    bool rtd3;                 /* driver-ready flags bit 6 (R8) */
+    bool bios_assist;          /* R30: BIOS Assist (driver-ready flags) */
+    uint8_t boot_acl_slots;    /* 0 or 16 (R8, R14) */
+    bool preboot;              /* R25: tunnel attached devices at power-on */
+    bool preboot_acl_only;     /* R25 before 2026-10-15: boot-ACL ones only */
+    /*
+     * R33: an unapproved USB4 device router falls back to USB this long
+     * after the firmware enumerated it (0: never).
+     */
+    uint32_t usb_fallback_ms;
+    /*
+     * R8: after driver ready, config requests are held this long while
+     * the firmware announces attached devices (ICM-PROTOCOL.md 6.2,
+     * 13.5); the first driver ready after power-on and later ones.
+     */
+    uint32_t first_ready_hold_ms;
+    uint32_t ready_hold_ms;
+    /*
+     * R10: approve timing; 0, 0 = synchronous. Observed PCIe link up
+     * 89 ms and response 383 ms after the request (ORICO, 13.3).
+     */
+    uint32_t approve_link_ms;
+    uint32_t approve_resp_ms;
+    uint32_t boot_acl[32];     /* R26: initial ACL, 16 x (bytes 0-3, 4-7) */
+} USB4ICMConfig;
+
+/* Created by the host for the AR profile, attached to its fabric. */
+USB4ICM *usb4_icm_new(USB4Fabric *f, const USB4ICMConfig *cfg);
+void usb4_icm_free(USB4ICM *icm);
+void usb4_fabric_set_icm(USB4Fabric *f, USB4ICM *icm);
+/*
+ * Host -> ICM: a ring 0 TX frame with PDF 11 (ICM command, R5).
+ * @frame is the payload followed by its CRC-32C trailer.
+ */
+void usb4_icm_tx_frame(USB4ICM *icm, const uint8_t *frame, size_t len);
+/*
+ * Host -> ICM: NHI mailbox command (ICM-PROTOCOL.md 2.3, R3). Returns
+ * false when the command is not supported (error bit 30).
+ */
+bool usb4_icm_mailbox(USB4ICM *icm, uint8_t cmd, uint32_t data);
+/*
+ * Parse a boot-acl property value (R26): UUIDs in the sysfs unique_id
+ * form, separated by ';'. Fills @acl (16 slots of two words, empty
+ * slots all ones). Returns false with @errp set on a malformed list.
+ */
+/* The next reset is a controller power-up, not machine power-on (R27). */
+void usb4_icm_next_reset_hot(USB4ICM *icm);
+/*
+ * R32: leave ICM commands unanswered (BIOS Assist, between the last
+ * device's departure and the controller's power-off). Events are still
+ * sent; a reset of the ICM ends the silence.
+ */
+void usb4_icm_set_silent(USB4ICM *icm, bool silent);
+/*
+ * R33: a device router changed between USB4 and USB mode; the host
+ * reconciles the USB device on its xHCI from a bottom half.
+ */
+void usb4_host_usb_mode_changed(USB4Host *h);
+
+/* usb4-tb3-switch.c: how the firmware presents the integrated xHCI */
+typedef enum USB4XhciMode {
+    USB4_XHCI_NORMAL,
+    USB4_XHCI_HIDDEN,           /* BIOS Assist (R30) */
+    USB4_XHCI_NO_RESOURCES,     /* BIOS Assist, USB fallback in POST (R33) */
+} USB4XhciMode;
+struct DeviceState;
+void usb4_tb3_xhci_set_mode(struct DeviceState *xhci, USB4XhciMode mode);
+bool usb4_icm_parse_boot_acl(const char *list, uint32_t acl[32],
+                             Error **errp);
+
+/* ------------------------------------------------------------------ */
+/* ACPI (usb4-acpi.c)                                                   */
+/* ------------------------------------------------------------------ */
+
+/* True if a usb4-host with profile=usb4-generic exists in the machine,
+ * in which case the machine's ACPI builder adds the USB4 _OSC grant
+ * and the _DSD port mapping. */
+bool usb4_acpi_generic_present(void);
+
+#endif /* HW_USB4_INTERNAL_H */
diff --git a/hw/usb4/usb4-preos.c b/hw/usb4/usb4-preos.c
new file mode 100644
index 0000000000000000000000000000000000000000..39a13a58b74719a9aa01ec0ab28810b8f93a79f2
--- /dev/null
+++ b/hw/usb4/usb4-preos.c
@@ -0,0 +1,182 @@
+/*
+ * USB4 fabric: emulated pre-OS (platform firmware) connection manager
+ *
+ * Copyright (c) 2026 usb4-emu contributors
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Written from scratch for the usb4-emu project from the USB4 Connection
+ * Manager Guide 2.0 ("Guide") and the USB4 Specification 2.0 ("Spec").
+ *
+ * With preos-cm=on (docs/USB4-HOSTS.md) the platform firmware runs a
+ * software CM before the OS, the way a USB4 BIOS does: it enumerates the
+ * host router and every connected device router, bonds the lanes and
+ * brings up a PCIe tunnel to each device router, then hands over without
+ * cleaning up. The OS CM finds a configured fabric, no pending hot plug
+ * events, and the endpoints already on the PCI bus (cold plugged).
+ *
+ * Like the emulated ICM it programs the same router state a guest CM
+ * writes, through the routers' own register semantics, so the tunnel
+ * evaluator needs nothing special. Capabilities are found by walking the
+ * capability chains, so it works on every host model.
+ */
+
+#include "qemu/osdep.h"
+#include "usb4-fabric-int.h"
+#include "trace.h"
+
+static uint32_t rd(USB4Router *r, unsigned cs, unsigned adp, unsigned off)
+{
+    uint32_t v = 0;
+
+    usb4_router_read(r, cs, adp, off, 1, &v);
+    return v;
+}
+
+static void rmw(USB4Router *r, unsigned cs, unsigned adp, unsigned off,
+                uint32_t clr, uint32_t set)
+{
+    uint32_t v = (rd(r, cs, adp, off) & ~clr) | set;
+
+    usb4_router_write(r, cs, adp, off, 1, &v);
+}
+
+/* Adapter capability @id by walking the chain from ADP_CS_1 (8.2.2). */
+static unsigned find_cap(USB4Router *r, unsigned adp, unsigned id)
+{
+    unsigned off = rd(r, USB4_CS_ADAPTER, adp, 1) & 0xff;
+
+    for (unsigned n = 0; off && n < 16; n++) {
+        uint32_t v = rd(r, USB4_CS_ADAPTER, adp, off);
+
+        if (((v >> 8) & 0xff) == id) {
+            return off;
+        }
+        off = v & 0xff;
+    }
+    return 0;
+}
+
+/* Guide 5.2.1: one path entry, single read then single write. */
+static void program_path(USB4Router *r, unsigned adp, unsigned hop,
+                         unsigned out_adp, unsigned out_hop, unsigned credits,
+                         bool lane_ingress)
+{
+    uint32_t e[2];
+
+    usb4_router_read(r, USB4_CS_PATH, adp, 2 * hop, 2, e);
+    e[0] = (e[0] & ~(0x7fu | 0x3fu << 11 | 0x7fu << 17)) | out_hop |
+           (out_adp << 11) | (1u << 31);
+    if (lane_ingress) {
+        e[0] |= credits << 17;
+    }
+    /* Guide Table 5-2: priority 3, weight 1, IFC/EFC per segment */
+    e[1] = (e[1] & ~0x0f000f0fu) | 1 | (3 << 8) |
+           (lane_ingress ? (1u << 24) : (1u << 25 | 1u << 27));
+    usb4_router_write(r, USB4_CS_PATH, adp, 2 * hop, 2, e);
+}
+
+/* Guide 3.2.1 step 4: one write of ROUTER_CS_1-4. */
+static void enumerate(USB4Router *r, uint64_t route, unsigned depth)
+{
+    uint32_t v[4];
+
+    usb4_router_read(r, USB4_CS_ROUTER, 0, 1, 4, v);
+    v[0] = (v[0] & ~(7u << 20)) | (depth << 20);
+    v[1] = (uint32_t)route;
+    v[2] = (uint32_t)(route >> 32) | (1u << 31);
+    v[3] = (v[3] & ~0xff00u) | (0x10 << 8);      /* CMUV 1.0 */
+    usb4_router_write(r, USB4_CS_ROUTER, 0, 1, 4, v);
+}
+
+static void bond(USB4Router *p, USB4Port *dfp, USB4Router *d)
+{
+    USB4Port *ufp = d->up_port;
+
+    /* Guide 7.1: Target Link Width x2 on all four lanes, then LB */
+    for (unsigned l = 0; l < 2; l++) {
+        unsigned pl = find_cap(p, dfp->lane[l]->num, USB4_CAP_LANE);
+        unsigned dl = find_cap(d, ufp->lane[l]->num, USB4_CAP_LANE);
+
+        if (!pl || !dl) {
+            return;
+        }
+        rmw(p, USB4_CS_ADAPTER, dfp->lane[l]->num, pl + 1, 3u << 4, 3u << 4);
+        rmw(d, USB4_CS_ADAPTER, ufp->lane[l]->num, dl + 1, 3u << 4, 3u << 4);
+    }
+    rmw(p, USB4_CS_ADAPTER, dfp->lane[0]->num,
+        find_cap(p, dfp->lane[0]->num, USB4_CAP_LANE) + 1, 0, 1u << 15);
+}
+
+/* Guide 5.3.1: PCIe tunnel from @p's PCIe Down adapter of @dfp to @d. */
+static void pcie_tunnel(USB4Router *p, USB4Port *dfp, USB4Router *d)
+{
+    USB4Adapter *pd = usb4_router_find_kind(p, USB4_ADP_PCIE_DOWN,
+                                            dfp->index);
+    USB4Adapter *pu = usb4_router_find_kind(d, USB4_ADP_PCIE_UP, 1);
+    unsigned pl = dfp->lane[0]->num, ul = d->up_port->lane[0]->num;
+    unsigned cap;
+
+    if (!pd || !pu) {
+        return;
+    }
+    program_path(p, pd->num, 8, pl, 8, 0, false);
+    program_path(d, ul, 8, pu->num, 8, 32, true);
+    program_path(d, pu->num, 8, ul, 9, 0, false);
+    program_path(p, pl, 9, pd->num, 8, 32, true);
+    cap = find_cap(d, pu->num, USB4_CAP_PROTO);
+    if (cap) {
+        rmw(d, USB4_CS_ADAPTER, pu->num, cap, 0, 1u << 31);
+    }
+    cap = find_cap(p, pd->num, USB4_CAP_PROTO);
+    if (cap) {
+        rmw(p, USB4_CS_ADAPTER, pd->num, cap, 0, 1u << 31);
+    }
+}
+
+static void bring_up(USB4Router *p, USB4Port *dfp)
+{
+    USB4Router *d;
+    uint64_t route;
+    unsigned depth;
+
+    if (!dfp->partner || !usb4_port_link_up(dfp) ||
+        dfp->partner->router->dialect != USB4_DIALECT_USB4) {
+        return;
+    }
+    d = dfp->partner->router;
+    depth = usb4_router_depth(p) + 1;
+    route = usb4_router_topology(p) |
+            ((uint64_t)dfp->lane[0]->num << (8 * (depth - 1)));
+
+    /* Guide 3.2.1: clear Lock on the DFP lane adapter, enumerate */
+    rmw(p, USB4_CS_ADAPTER, dfp->lane[0]->num, 4, 1u << 31, 0);
+    enumerate(d, route, depth);
+    /* Guide 3.2.3: PCIe tunneling on, Configuration Valid */
+    rmw(d, USB4_CS_ROUTER, 0, 5, 0, 1u << 24);
+    rmw(d, USB4_CS_ROUTER, 0, 5, 0, 1u << 31);
+    bond(p, dfp, d);
+    pcie_tunnel(p, dfp, d);
+    trace_usb4_preos_router(route, depth);
+    for (unsigned i = 1; i < d->nports; i++) {
+        bring_up(d, &d->ports[i]);
+    }
+}
+
+void usb4_fabric_preos_cm(USB4Fabric *f)
+{
+    USB4Router *hr = f->hr;
+
+    if (!f->cfg.preos_cm || hr->dialect != USB4_DIALECT_USB4) {
+        return;
+    }
+    trace_usb4_preos_start(f->ndr);
+    enumerate(hr, 0, 0);
+    for (unsigned i = 0; i < hr->nports; i++) {
+        bring_up(hr, &hr->ports[i]);
+    }
+    /*
+     * The firmware consumed (acknowledged) every hot plug event it caused;
+     * nothing is left pending for the OS (Spec 6.8).
+     */
+    usb4_fabric_host_reset(f);
+}
diff --git a/hw/usb4/usb4-router-adl.c b/hw/usb4/usb4-router-adl.c
new file mode 100644
index 0000000000000000000000000000000000000000..ca9987e48398f93803f7cddaf86cb3eec8284be5
--- /dev/null
+++ b/hw/usb4/usb4-router-adl.c
@@ -0,0 +1,308 @@
+/*
+ * USB4 router model: the intel-adl host model, a host router that
+ * reproduces the Intel Alder Lake-P integrated USB4 host router captured
+ * on a Framework Laptop 13 (12th gen), docs/USB4-HOSTS.md.
+ *
+ * Copyright (c) 2026 usb4-emu contributors
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Written from scratch for the usb4-emu project. Register semantics are
+ * the shared ones of usb4-router.c (USB4 Specification 2.0 chapter 8);
+ * this file supplies the captured adapter layout, the captured reset
+ * values (usb4-adl-data.h, generated from observed data), and the
+ * router operation, sideband and retimer behaviour observed in the
+ * capture's trace (tests/captures/framework13-12th/linux-ts3plus).
+ */
+
+#include "qemu/osdep.h"
+#include "usb4-fabric-int.h"
+#include "trace.h"
+#include "usb4-adl-data.h"
+
+/* ------------------------------------------------------------------ */
+/* Layout and images                                                    */
+/* ------------------------------------------------------------------ */
+
+/*
+ * The captured image (usb4-router-img.c). Router CS dwords 0-0x34
+ * (ROUTER_CS_0-26 and the TMU Router Configuration Capability at 0x1b,
+ * Spec Table 8-3/8-4) are at the model's offsets; everything above is
+ * vendor-specific capabilities, kept as captured storage.
+ */
+static const USB4Image adl_image = {
+    .rtr = adl_rtr_regs,
+    .nrtr = ARRAY_SIZE(adl_rtr_regs),
+    .rtr_cs_size = ADL_RTR_CS_SIZE,
+    .rtr_tmu = { USB4_RTR_CAP_TMU, USB4_RTR_CAP_TMU_LEN },
+    .adp = adl_adapters,
+    .max_adapter = ADL_MAX_ADAPTER,
+};
+
+void usb4_router_adl_layout(USB4Router *r, unsigned domain)
+{
+    unsigned i;
+
+    domain = MIN(domain, 1);
+    r->adl = true;
+    r->sb_delay = true;
+    r->nports = 2;
+    for (i = 0; i < r->nports; i++) {
+        r->ports[i].index = i + 1;
+        r->ports[i].dfp = true;
+        /* Every Type-C port of the platform has an on-board retimer. */
+        r->ports[i].has_retimer = true;
+    }
+    /* 10, 11: not implemented (ERR_ADDR, observed) */
+    usb4_router_img_layout(r, &adl_image);
+    r->upstream_adapter = ADL_UPSTREAM_ADAPTER;
+    r->vendor_id = adl_ident[domain].cs0 & 0xffff;
+    r->product_id = adl_ident[domain].cs0 >> 16;
+    r->uuid = ((uint64_t)adl_ident[domain].cs7 << 32) | adl_ident[domain].cs8;
+    r->drom = g_memdup2(adl_host_drom, sizeof(adl_host_drom));
+    r->drom_len = sizeof(adl_host_drom);
+}
+
+/*
+ * Sideband registers. Response lengths differ from the register sizes
+ * of Spec Table 4-18 for a few registers (observed in the trace: a read
+ * of Debug Configuration (5) and Debug (6) answers 16 bytes, LRD Tuning
+ * (7) one byte); a read of any other register answers its full size.
+ */
+static void sb_load(USB4SBReg *sb, const USB4AdlSB *img, unsigned n)
+{
+    memset(sb, 0, sizeof(USB4SBReg) * USB4_SB_REGS);
+    for (unsigned i = 0; i < n; i++) {
+        USB4SBReg *s = &sb[img[i].reg];
+
+        s->size = img[i].len;
+        memcpy(s->data, img[i].data, img[i].len);
+    }
+    sb[0].ro = sb[1].ro = sb[2].ro = sb[15].ro = true;
+}
+
+void usb4_router_adl_sb_image(USB4Router *r, USB4Port *p)
+{
+    if (p->index == 1) {
+        sb_load(p->sb, adl_port1_sb, ARRAY_SIZE(adl_port1_sb));
+    } else {
+        sb_load(p->sb, adl_port2_sb, ARRAY_SIZE(adl_port2_sb));
+    }
+    /* Spec Table 4-20: same values as Router Configuration Space. */
+    p->sb[1].data[0] = r->product_id & 0xff;
+    p->sb[1].data[1] = r->product_id >> 8;
+    sb_load(p->rt_sb, adl_retimer_sb, ARRAY_SIZE(adl_retimer_sb));
+    p->sb_adapter = NULL;
+    if (p->sb_timer) {
+        usb4_timer_del(p->sb_timer);
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* Router operations (Spec 8.3.1), as observed                          */
+/* ------------------------------------------------------------------ */
+
+enum {
+    ROP_QUERY_DP_RESOURCE = 0x10,
+    ROP_ALLOC_DP_RESOURCE = 0x11,
+    ROP_DEALLOC_DP_RESOURCE = 0x12,
+    ROP_GET_PCIE_DS_MAPPING = 0x30,
+    ROP_BUFFER_ALLOC = 0x33,
+};
+
+bool usb4_router_adl_op(USB4Router *r, unsigned op, uint32_t *meta,
+                        uint32_t *data, unsigned *status, bool *ons)
+{
+    switch (op) {
+    case ROP_QUERY_DP_RESOURCE:
+    case ROP_ALLOC_DP_RESOURCE:
+    case ROP_DEALLOC_DP_RESOURCE: {
+        /*
+         * Spec 8.3.1.2: Metadata is the DP IN adapter number. The capture
+         * shows Query DP Resource Availability succeeding for adapters 5
+         * and 6 with Metadata unchanged; allocation is not modelled
+         * (there is no DP source behind the adapters) and succeeds.
+         */
+        USB4Adapter *a = usb4_router_adapter(r, *meta & 0x3f);
+
+        *status = a && a->kind == USB4_ADP_DP_IN ? 0 : 1;
+        return true;
+    }
+    case ROP_BUFFER_ALLOC:
+        /*
+         * Buffer Allocation Request (Spec 8.3.1.3.4), captured answer:
+         * USB3 32, DP AUX 1, DP main 0, PCIe 64, HI 14 buffers. Only the
+         * five entries are written; the rest of the Data registers keep
+         * what an earlier operation left there (observed).
+         */
+        data[0] = 0x00200001;
+        data[1] = 0x00010002;
+        data[2] = 0x00000003;
+        data[3] = 0x00400004;
+        data[4] = 0x000e0005;
+        *meta = 5;
+        return true;
+    case ROP_GET_PCIE_DS_MAPPING:
+        /*
+         * Get PCIe Downstream Entry Mapping (Spec 8.3.1.3, Tables 8-47,
+         * 8-48), optional for a Host Router. The real host's answer is
+         * unknown. The Linux CM never issues it (it maps
+         * PCIe Down adapters by position, usb4.c usb4_switch_map_pcie_down),
+         * and the Framework 13 traces (linux-ts3plus, linux-orico) hold
+         * only opcodes 0x10, 0x24, 0x25 and 0x33. Without an observed
+         * answer the preset reports Not Supported, as for 0x25, so a CM
+         * cannot come to depend on a made-up mapping (docs/USB4-HOSTS.md 1).
+         */
+        *ons = true;
+        return true;
+    default:
+        return false;
+    }
+}
+
+void usb4_router_adl_enumerated(USB4Router *r)
+{
+    /*
+     * Observed: setting ROUTER_CS_3.Enumerated makes the host router send
+     * a hot plug (plug) event for each DP IN adapter, every time.
+     */
+    for (unsigned i = 1; i <= r->max_adapter; i++) {
+        if (r->adp[i].kind == USB4_ADP_DP_IN && !(r->adp[i].cs[5] >> 31)) {
+            usb4_fabric_hp_event(r, i, false);
+        }
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* On-board retimer (Spec 4.1.1.3, 8.3.2.3), as observed                */
+/* ------------------------------------------------------------------ */
+
+#define FOURCC(a, b, c, d) \
+    ((uint32_t)(a) | ((uint32_t)(b) << 8) | ((uint32_t)(c) << 16) | \
+     ((uint32_t)(d) << 24))
+#define RT_OP_LAST    FOURCC('L', 'A', 'S', 'T')  /* Query Last Retimer */
+#define RT_OP_CBLR    FOURCC('C', 'B', 'L', 'R')  /* Query Cable Retimer */
+#define RT_OP_GNSS    FOURCC('G', 'N', 'S', 'S')  /* NVM Sector Size */
+#define RT_OP_NVM_RD  FOURCC('A', 'F', 'R', 'R')  /* NVM Read */
+#define RT_OP_BAD     FOURCC('!', 'C', 'M', 'D')
+
+/*
+ * Retimer NVM dwords the Linux CM read (observed): byte offset 0x08 and
+ * 0x44-0x4b. The rest of the NVM reads as 0.
+ */
+static const struct { uint32_t off, val; } adl_rt_nvm[] = {
+    { 0x08, 0x10100003 }, { 0x44, 0xaaaa2b2d }, { 0x48, 0x0428a800 },
+};
+
+static uint32_t rt_nvm_dw(uint32_t off)
+{
+    for (unsigned i = 0; i < ARRAY_SIZE(adl_rt_nvm); i++) {
+        if (adl_rt_nvm[i].off == off) {
+            return adl_rt_nvm[i].val;
+        }
+    }
+    return 0;
+}
+
+/*
+ * @hp: the host port that holds the retimer state, @p the port the
+ * request came through (@hp, or the device router's Upstream Facing
+ * Port on the other side of the link).
+ */
+static void rt_op(USB4Port *hp, USB4Port *p)
+{
+    uint32_t op = usb4_ld_le32(hp->rt_sb[8].data);
+    uint32_t meta = usb4_ld_le32(hp->rt_sb[9].data);
+    uint32_t res = 0;
+
+    switch (op) {
+    case RT_OP_LAST:
+        /*
+         * Observed: from the host port the only retimer is the last one
+         * (Metadata 1); from the ASM2464's Upstream Facing Port the same
+         * retimer, at index 1 there too, answers 0.
+         */
+        meta = p == hp ? 1 : 0;
+        break;
+    case RT_OP_CBLR:
+        meta = 0;                   /* on-board, not a cable retimer */
+        break;
+    case RT_OP_GNSS:
+        meta = 0x1000;              /* observed: 4 KiB sectors */
+        break;
+    case RT_OP_NVM_RD: {
+        /* Metadata: byte address [23:0], dword count [27:24] (0: 16) */
+        uint32_t addr = meta & 0x00fffffc;
+        unsigned n = (meta >> 24) & 0xf;
+
+        n = n ? n : 16;
+        memset(hp->rt_sb[18].data, 0, sizeof(hp->rt_sb[18].data));
+        for (unsigned i = 0; i < n; i++) {
+            usb4_st_le32(hp->rt_sb[18].data + 4 * i,
+                         rt_nvm_dw(addr + 4 * i));
+        }
+        break;
+    }
+    case 0:
+        return;
+    default:
+        /* Sideband TX enable/disable and other ops: accepted. */
+        if ((op & 0xff) < 'A' || (op & 0xff) > 'Z') {
+            res = RT_OP_BAD;
+        }
+        break;
+    }
+    usb4_st_le32(hp->rt_sb[9].data, meta);
+    usb4_st_le32(hp->rt_sb[8].data, res);
+    trace_usb4_port_op(usb4_router_topology(p->router), p->lane[0]->num, op,
+                       res, false);
+}
+
+/* The host port whose on-board retimer sits on @p's link, or NULL. */
+static USB4Port *rt_host_port(USB4Port *p)
+{
+    USB4Port *hp = p->dfp ? p : p->partner;
+
+    return hp && hp->has_retimer ? hp : NULL;
+}
+
+bool usb4_router_adl_rt_present(USB4Port *p, unsigned index)
+{
+    USB4Port *hp = rt_host_port(p);
+
+    return hp && index == 1 && hp->partner && !hp->dpr && !hp->partner->dpr;
+}
+
+unsigned usb4_router_adl_rt_access(USB4Port *p, unsigned index, unsigned reg,
+                                   unsigned len, bool wnr, uint8_t *buf,
+                                   bool *rc, bool *nr)
+{
+    USB4Port *hp = rt_host_port(p);
+    USB4SBReg *s;
+
+    *rc = false;
+    *nr = !usb4_router_adl_rt_present(p, index);
+    if (*nr) {
+        return 0;
+    }
+    s = reg < USB4_SB_REGS ? &hp->rt_sb[reg] : NULL;
+    if (!s || !s->size || len == 0) {
+        *rc = true;
+        return 0;
+    }
+    if (!wnr) {
+        unsigned rlen = reg == 7 ? 1 : s->size;
+
+        /* every advertised byte is register data (see sb_access) */
+        memcpy(buf, s->data, MIN(MAX(rlen, len), sizeof(s->data)));
+        return rlen;
+    }
+    if (s->ro || len > s->size) {
+        *rc = true;
+        return 0;
+    }
+    memcpy(s->data, buf, len);
+    if (reg == 8) {
+        rt_op(hp, p);
+    }
+    return len;
+}
diff --git a/hw/usb4/usb4-router-asm.c b/hw/usb4/usb4-router-asm.c
new file mode 100644
index 0000000000000000000000000000000000000000..880689d00a4074469979d1bbce958be7133cc0af
--- /dev/null
+++ b/hw/usb4/usb4-router-asm.c
@@ -0,0 +1,341 @@
+/*
+ * USB4 router model: the asm4242 host model, an ASMedia ASM4242 discrete
+ * USB4 host router as found on AM5 X870 / X870E boards, built from
+ * public sources only (docs/research/AM5-USB4.md, docs/USB4-HOSTS.md 5).
+ *
+ * Copyright (c) 2026 usb4-emu contributors
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Written from scratch for the usb4-emu project. There is no capture of
+ * this chip: no register image, no trace. The router is therefore the
+ * spec-derived router of usb4-router.c (USB4 Specification 2.0 chapter
+ * 8) with:
+ *
+ *  - the router identity 174c:2428 published with the Linux quirk patch
+ *    for this host (AM5-USB4.md 2.3, [lkml], confidence high);
+ *  - two USB4 ports with an inferred adapter layout (lanes 1-4, then DP
+ *    IN, Host Interface, PCIe Down and USB3 Gen X Down adapters at
+ *    configurable numbers; AM5-USB4.md 8 "adapter numbers [unk]");
+ *  - two DP IN adapters without a DP source (M11, [vendor] two DP sink
+ *    inputs), answering the DP resource router operations;
+ *  - an NVM readable through the NVM Sector Size and NVM Read router
+ *    operations, holding only the version and date dwords at the
+ *    ASMedia offsets, so a CM reports the published NVM version
+ *    (200011.250708 [lkml][pub], medium);
+ *  - the vendor quirks of AM5-USB4.md 2.3 / M6 as options: a Host
+ *    Interface adapter path whose Pending Packets bit never clears once
+ *    the path is torn down (quirk a), and 174 lane adapter buffers with a
+ *    baMaxHI of 32 (quirk c). Quirk b (Tx E2E credits) is a host
+ *    interface behaviour, in usb4-host.c.
+ *
+ * Everything else (TMU, CLx, sideband, DROM content, router operations
+ * not listed) is the minimal router's behaviour and is [unk] for the
+ * real chip.
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "usb4-fabric-int.h"
+#include "trace.h"
+
+#define ASM_LANE_BUFFERS        174     /* quirk c, [lkml] */
+#define ASM_BA_MAX_HI           32      /* quirk c, [lkml] */
+#define ASM_DEF_LANE_BUFFERS    120     /* minimal router figures */
+#define ASM_DEF_BA_MAX_HI       14
+#define ASM_DP_MAX_HOPID        9       /* [inf] same as captured ADL DP IN */
+#define ASM_ADP_CAP_DP          0x10    /* ADP_DP_CS_0 */
+#define ASM_ADP_CAP_DP_LEN      9       /* ADP_DP_CS_0..8, USB4 v1 */
+#define ASM_NVM_SECTOR_SIZE     0x1000  /* [inf] 4 KiB */
+#define ASM_NVM_DATE_OFF        0x1c    /* byte offsets, AM5-USB4.md 3 */
+#define ASM_NVM_VERSION_OFF     0x28
+#define ASM_NVM_SIZE            (512 * 1024)
+
+/* PATH_CS_1 Pending Packets (Spec Table 8-22/8-23) */
+#define PATH_PENDING            (1u << 28)
+#define PATH_VALID              (1u << 31)
+
+enum {
+    ROP_QUERY_DP_RESOURCE = 0x10,
+    ROP_ALLOC_DP_RESOURCE = 0x11,
+    ROP_DEALLOC_DP_RESOURCE = 0x12,
+    ROP_NVM_READ = 0x22,
+    ROP_NVM_SECTOR_SIZE = 0x25,
+    ROP_BUFFER_ALLOC = 0x33,
+};
+
+/* ------------------------------------------------------------------ */
+/* Configuration                                                        */
+/* ------------------------------------------------------------------ */
+
+bool usb4_asm_config_check(const USB4AsmConfig *c, Error **errp)
+{
+    /* adapter -> owner, 0 free; lanes 1-4 are fixed */
+    uint8_t used[USB4_MAX_ADAPTERS] = { [1] = 1, [2] = 1, [3] = 1, [4] = 1 };
+    const struct { const char *name; uint8_t first, count; } blk[] = {
+        { "asm-adp-dp", c->adp_dp, c->adp_dp ? 2 : 0 },
+        { "asm-adp-hi", c->adp_hi, 1 },
+        { "asm-adp-pcie", c->adp_pcie, 2 },
+        { "asm-adp-usb3", c->adp_usb3, 2 },
+    };
+
+    for (unsigned i = 0; i < ARRAY_SIZE(blk); i++) {
+        if (!blk[i].count) {
+            continue;
+        }
+        if (blk[i].first < 5 ||
+            blk[i].first + blk[i].count - 1 >= USB4_MAX_ADAPTERS) {
+            error_setg(errp, "usb4-host: %s=%u: adapters 5..%u only (1-4 "
+                       "are the lane adapters)", blk[i].name, blk[i].first,
+                       USB4_MAX_ADAPTERS - blk[i].count);
+            return false;
+        }
+        for (unsigned k = 0; k < blk[i].count; k++) {
+            if (used[blk[i].first + k]) {
+                error_setg(errp, "usb4-host: %s=%u overlaps another adapter",
+                           blk[i].name, blk[i].first);
+                return false;
+            }
+            used[blk[i].first + k] = 1;
+        }
+    }
+    return true;
+}
+
+/* ------------------------------------------------------------------ */
+/* Layout                                                               */
+/* ------------------------------------------------------------------ */
+
+static void asm_adapter(USB4Router *r, unsigned num, USB4AdpKind kind,
+                        unsigned usb4_port, unsigned max_hop)
+{
+    USB4Adapter *a = &r->adp[num];
+
+    a->kind = kind;
+    a->usb4_port = usb4_port;
+    a->max_hop = max_hop;
+    r->max_adapter = MAX(r->max_adapter, num);
+}
+
+/*
+ * Inferred layout (AM5-USB4.md 8): Spec 5.2.x only requires lane
+ * adapters of a port to be consecutive and PCIe / USB3 adapters to pair
+ * with USB4 ports in increasing order (Guide 3.2.2). The default puts
+ * them in the order the captured Intel integrated host uses (lanes, DP
+ * IN, Host Interface, PCIe Down, USB3 Down), without its unused
+ * adapters 10-11. A CM must discover them, never hard-code them.
+ */
+void usb4_router_asm_layout(USB4Router *r, const USB4AsmConfig *c)
+{
+    r->asm4242 = true;
+    r->nports = 2;
+    r->max_adapter = 4;
+    for (unsigned p = 1; p <= 2; p++) {
+        USB4Port *port = &r->ports[p - 1];
+
+        port->index = p;
+        port->dfp = true;
+        for (unsigned l = 0; l < 2; l++) {
+            USB4Adapter *a = &r->adp[2 * p - 1 + l];
+
+            a->kind = USB4_ADP_LANE;
+            a->lane = l;
+            a->port = port;
+            a->max_hop = USB4_LANE_MAX_HOPID;
+            port->lane[l] = a;
+        }
+    }
+    if (c->adp_dp) {
+        asm_adapter(r, c->adp_dp, USB4_ADP_DP_IN, 0, ASM_DP_MAX_HOPID);
+        asm_adapter(r, c->adp_dp + 1, USB4_ADP_DP_IN, 0, ASM_DP_MAX_HOPID);
+    }
+    asm_adapter(r, c->adp_hi, USB4_ADP_HI, 0, USB4_HOST_IF_TOTAL_PATHS - 1);
+    r->upstream_adapter = c->adp_hi;
+    for (unsigned p = 1; p <= 2; p++) {
+        asm_adapter(r, c->adp_pcie + p - 1, USB4_ADP_PCIE_DOWN, p,
+                    USB4_PCIE_MAX_HOPID);
+        asm_adapter(r, c->adp_usb3 + p - 1, USB4_ADP_USB3_DOWN, p,
+                    USB4_USB3_MAX_HOPID);
+    }
+}
+
+/*
+ * Reset values on top of the shared adapter_reset(): DP IN adapters
+ * (Spec Table 8-10 type 0E0101h, DP Adapter Capability Table 8-17 with
+ * ADP_DP_CS_0..8 as a USB4 1.0 router has) and the lane buffer figure.
+ */
+void usb4_router_asm_adapter_reset(USB4Router *r, USB4Adapter *a)
+{
+    const USB4AsmConfig *c = &r->fabric->cfg.asm4242;
+    uint32_t *cs = a->cs;
+
+    switch (a->kind) {
+    case USB4_ADP_LANE:
+        cs[4] = (cs[4] & ~(0x3ffu << 20)) |
+                (uint32_t)(c->quirk_credits ? ASM_LANE_BUFFERS
+                                            : ASM_DEF_LANE_BUFFERS) << 20;
+        break;
+    case USB4_ADP_DP_IN:
+        cs[1] = ASM_ADP_CAP_DP;
+        cs[2] = 0x010e0101;
+        cs[ASM_ADP_CAP_DP] = USB4_CAP_PROTO << 8;
+        /*
+         * DP_LOCAL_CAP: protocol adapter version 1, DPCD 1.4, HBR3,
+         * 4 lanes, MST ([vendor] DP 1.4a, HBR3, 4 lanes per sink).
+         */
+        cs[ASM_ADP_CAP_DP + 4] = 0x1 | (0x4 << 4) | (0x3 << 8) | (0x2 << 12) |
+                                 (1u << 15);
+        break;
+    default:
+        break;
+    }
+}
+
+bool usb4_router_asm_adp_mask(USB4Adapter *a, unsigned off, uint32_t *mask)
+{
+    static const uint32_t dp[ASM_ADP_CAP_DP_LEN] = {
+        0xc07f0000,     /* ADP_DP_CS_0: VE, AE, Video HopID */
+        0x0003f87f,     /* ADP_DP_CS_1: AUX HopIDs */
+        0x00000408,     /* ADP_DP_CS_2: SW Link Init, CM Ack */
+        0x00000600,     /* ADP_DP_CS_3: HPD Output Clear/Set */
+        0,              /* DP_LOCAL_CAP */
+        0xffffffff,     /* DP_REMOTE_CAP, written by the CM */
+        0,              /* DP_STATUS */
+        0,              /* DP_COMMON_CAP */
+        0,              /* ADP_DP_CS_8 */
+    };
+
+    if (a->kind != USB4_ADP_DP_IN || off < ASM_ADP_CAP_DP ||
+        off >= ASM_ADP_CAP_DP + ASM_ADP_CAP_DP_LEN) {
+        return false;
+    }
+    *mask = dp[off - ASM_ADP_CAP_DP];
+    return true;
+}
+
+/* ------------------------------------------------------------------ */
+/* Router operations (Spec 8.3.1)                                       */
+/* ------------------------------------------------------------------ */
+
+/*
+ * NVM dword at byte offset @off. Only the two dwords the ASMedia NVM
+ * version format uses are populated (AM5-USB4.md 3, [code] nvm.c
+ * behaviour: version and date each a 24-bit value stored with its first
+ * and last byte swapped); everything else reads 0.
+ */
+static uint32_t asm_nvm_swap24(uint32_t v)
+{
+    return ((v >> 16) & 0xff) | (v & 0xff00) | ((v & 0xff) << 16);
+}
+
+static uint32_t asm_nvm_dw(const USB4AsmConfig *c, uint32_t off)
+{
+    switch (off) {
+    case ASM_NVM_VERSION_OFF:
+        return asm_nvm_swap24(c->nvm_version);
+    case ASM_NVM_DATE_OFF:
+        return asm_nvm_swap24(c->nvm_date);
+    default:
+        return 0;
+    }
+}
+
+bool usb4_router_asm_op(USB4Router *r, unsigned op, uint32_t *meta,
+                        uint32_t *data, unsigned *status, bool *ons)
+{
+    const USB4AsmConfig *c = &r->fabric->cfg.asm4242;
+
+    switch (op) {
+    case ROP_QUERY_DP_RESOURCE:
+    case ROP_ALLOC_DP_RESOURCE:
+    case ROP_DEALLOC_DP_RESOURCE: {
+        /*
+         * Spec 8.3.1.2: Metadata is the DP IN adapter number. No DP
+         * source exists, so availability is always granted. [inf]
+         */
+        USB4Adapter *a = usb4_router_adapter(r, *meta & 0x3f);
+
+        *status = a && a->kind == USB4_ADP_DP_IN ? 0 : 1;
+        return true;
+    }
+    case ROP_NVM_SECTOR_SIZE:
+        if (!c->nvm_version) {
+            *ons = true;
+            return true;
+        }
+        *meta = ASM_NVM_SECTOR_SIZE;
+        return true;
+    case ROP_NVM_READ: {
+        /*
+         * Spec 8.3.1.2.3: Metadata [23:2] dword address, [27:24] dword
+         * count (0: 16). Data[] receives the dwords.
+         */
+        uint32_t addr = *meta & 0x00fffffc;
+        unsigned n = (*meta >> 24) & 0xf;
+
+        if (!c->nvm_version) {
+            *ons = true;
+            return true;
+        }
+        n = n ? n : 16;
+        if (addr + 4 * n > ASM_NVM_SIZE) {
+            *status = 1;
+            return true;
+        }
+        for (unsigned i = 0; i < n; i++) {
+            data[i] = asm_nvm_dw(c, addr + 4 * i);
+        }
+        return true;
+    }
+    case ROP_BUFFER_ALLOC: {
+        /*
+         * Spec 8.3.1.3.4, Table 8-58: USB3 32, DP AUX 1, DP main 18,
+         * PCIe 32 as on the minimal router [unk]; baMaxHI 32 with quirk c
+         * ([lkml] credit-clamp patch), else the minimal router's 14.
+         */
+        unsigned lane = (r->caps_enabled & (1u << 3)) ? *meta & 0x3f : 0;
+        unsigned hi = c->quirk_credits ? ASM_BA_MAX_HI : ASM_DEF_BA_MAX_HI;
+
+        memset(data, 0, 16 * 4);
+        data[0] = 0x00200001;
+        data[1] = 0x00010002;
+        data[2] = 0x00120003;
+        data[3] = 0x00200004;
+        data[4] = 0x0005 | (hi << 16);
+        *meta = 5 | (lane << 8);
+        return true;
+    }
+    default:
+        return false;
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* Path configuration space                                             */
+/* ------------------------------------------------------------------ */
+
+/*
+ * Quirk a ([lkml] Fan Ye v3, AM5-USB4.md 2.3): on the Host Interface
+ * adapter, Pending Packets (PATH_CS_1 bit 28) is set when a CM clears
+ * Valid on a path that was valid, and never clears again, so a CM that
+ * waits for it to drain (Guide 5.x path teardown) waits out its whole
+ * timeout. The model latches it until the entry is made valid again or
+ * the router is reset [inf: the patch only says it never clears]. Without
+ * the quirk the model drains at once, like the minimal router.
+ */
+void usb4_router_asm_path_written(USB4Router *r, USB4Adapter *a,
+                                  unsigned off, uint32_t old, uint32_t new)
+{
+    unsigned hop = off / 2;
+
+    if (a->kind != USB4_ADP_HI || (off & 1) || hop == 0 ||
+        !r->fabric->cfg.asm4242.quirk_pending) {
+        return;
+    }
+    if ((old & PATH_VALID) && !(new & PATH_VALID)) {
+        a->path[off + 1] |= PATH_PENDING;
+        trace_usb4_router_state(usb4_router_topology(r), "asm-pending-stuck",
+                                hop);
+    } else if (!(old & PATH_VALID) && (new & PATH_VALID)) {
+        a->path[off + 1] &= ~PATH_PENDING;
+    }
+}
diff --git a/hw/usb4/usb4-router-asm2464.c b/hw/usb4/usb4-router-asm2464.c
new file mode 100644
index 0000000000000000000000000000000000000000..0ecfa6654f7dfee00d93074297d3768795a995ef
--- /dev/null
+++ b/hw/usb4/usb4-router-asm2464.c
@@ -0,0 +1,194 @@
+/*
+ * USB4 router model: the asm2464 device router model, the ASMedia
+ * ASM2464PD of an ORICO AAGM2-U4 USB4 NVMe enclosure as captured on a
+ * Framework Laptop 13 (12th gen), docs/captures/ORICO-ASM2464.md.
+ *
+ * Copyright (c) 2026 usb4-emu contributors
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Written from scratch for the usb4-emu project. Register semantics are
+ * the shared ones of usb4-router.c (USB4 Specification 2.0 chapter 8);
+ * this file supplies the captured adapter layout, reset values and DROM
+ * (usb4-asm2464-data.h, generated from observed data), and the router
+ * operation, sideband and Router Ready behaviour observed in the
+ * capture's trace (tests/captures/framework13-12th/linux-orico). Every
+ * statement below is observed unless it says inferred.
+ */
+
+#include "qemu/osdep.h"
+#include "usb4-fabric-int.h"
+#include "trace.h"
+#include "usb4-asm2464-data.h"
+
+static const USB4Image asm2464_image = {
+    .rtr = asm2464_rtr_regs,
+    .nrtr = ARRAY_SIZE(asm2464_rtr_regs),
+    .rtr_cs_size = ASM2464_RTR_CS_SIZE,
+    .rtr_tmu = ASM2464_RTR_TMU,     /* TMU capability at 0xc0, not 0x1b */
+    .adp = asm2464_adapters,
+    .max_adapter = ASM2464_MAX_ADAPTER,
+};
+
+/*
+ * Router Ready (ROUTER_CS_6 bit 24) after ROUTER_CS_3.Enumerated is set:
+ * the capture reads 0 0.4 ms after the write and 1 with Configuration
+ * Ready about 400 ms later (Spec 6.7 tSetRR). The delay is inferred
+ * inside that window.
+ */
+#define ASM2464_RR_DELAY_MS 5
+
+static void rr_timer(void *opaque)
+{
+    USB4Router *r = opaque;
+
+    if (usb4_router_enumerated(r) && !(r->cs[6] & (1u << 24))) {
+        r->cs[6] |= 1u << 24;
+        trace_usb4_router_state(usb4_router_topology(r), "router-ready", 1);
+    }
+}
+
+/*
+ * After the link to the router drops while it stays connected (a
+ * Downstream Port Reset), the ASM2464 comes back about 590 ms later:
+ * Linux released DPR at 74.639 s and the host router reported the plug
+ * at 75.233 s, and the router answered as freshly reset. The model holds
+ * the link that long from the link loss.
+ */
+#define ASM2464_LINK_DELAY_MS 590
+
+static void link_timer(void *opaque)
+{
+    USB4Router *r = opaque;
+    USB4Port *ufp = &r->ports[0];
+
+    if (ufp->link_hold) {
+        ufp->link_hold = false;
+        trace_usb4_router_state(usb4_router_topology(r), "link-hold", 0);
+        usb4_fabric_port_changed(ufp);
+    }
+}
+
+void usb4_router_asm2464_link_lost(USB4Router *r)
+{
+    r->ports[0].link_hold = true;
+    trace_usb4_router_state(usb4_router_topology(r), "link-hold", 1);
+    usb4_timer_mod_ms(r->link_timer, ASM2464_LINK_DELAY_MS);
+}
+
+uint64_t usb4_router_asm2464_uid(void)
+{
+    return ((uint64_t)ASM2464_CS7 << 32) | ASM2464_CS8;
+}
+
+void usb4_router_asm2464_layout(USB4Router *r)
+{
+    USB4Port *ufp = &r->ports[0];
+
+    r->asm2464 = true;
+    r->sb_delay = true;         /* retimer transactions, port_sb_post() */
+    r->nports = 1;              /* the Upstream Facing Port only */
+    r->ndfp = 0;
+    ufp->index = 1;
+    ufp->dfp = false;
+    r->up_port = ufp;
+    usb4_router_img_layout(r, &asm2464_image);
+    r->upstream_adapter = ASM2464_UPSTREAM_ADAPTER;
+    r->vendor_id = ASM2464_CS0 & 0xffff;
+    r->product_id = ASM2464_CS0 >> 16;
+    r->uuid = usb4_router_asm2464_uid();
+    r->rr_timer = usb4_timer_new(rr_timer, r);
+    r->link_timer = usb4_timer_new(link_timer, r);
+}
+
+/*
+ * The DROM with router UID @r->uuid. The captured DROM carries the UID
+ * in bytes 1-8 as the little-endian value (ROUTER_CS_7 << 32) |
+ * ROUTER_CS_8, the order r->uuid has, with its CRC-8 in byte 0 (USB4
+ * DROM Specification section 8, TBT3-compatible header). The data CRC-32
+ * does not cover the UID, so another UID only changes bytes 0-8.
+ */
+void usb4_router_asm2464_drom(USB4Router *r)
+{
+    g_free(r->drom);
+    r->drom = g_memdup2(asm2464_drom, sizeof(asm2464_drom));
+    r->drom_len = sizeof(asm2464_drom);
+    for (unsigned i = 0; i < 8; i++) {
+        r->drom[1 + i] = r->uuid >> (8 * i);
+    }
+    r->drom[0] = usb4_drom_crc8(r->drom + 1, 8);
+}
+
+/*
+ * A reset ends a link recovery in progress: the hold and its timer go
+ * with it, so a power-on reset during Downstream Port Reset recovery
+ * brings the link back at once (inferred). On a link loss the caller
+ * resets the router first and then starts the hold.
+ */
+void usb4_router_asm2464_reset(USB4Router *r)
+{
+    usb4_timer_del(r->rr_timer);
+    usb4_timer_del(r->link_timer);
+    if (r->ports[0].link_hold) {
+        r->ports[0].link_hold = false;
+        trace_usb4_router_state(usb4_router_topology(r), "link-hold", 0);
+    }
+}
+
+void usb4_router_asm2464_enumerated(USB4Router *r)
+{
+    usb4_timer_mod_ms(r->rr_timer, ASM2464_RR_DELAY_MS);
+}
+
+/*
+ * Sideband register space of the Upstream Facing Port (Spec Table
+ * 4-18/4-20). A local read of Vendor ID and Product ID answers the
+ * router's IDs with length 4; a read of Debug Configuration (5) gets
+ * the Result Code error bit. The other registers were not read; they
+ * keep the model's definitions (inferred).
+ */
+void usb4_router_asm2464_sb_image(USB4Router *r, USB4Port *p)
+{
+    p->sb[5].size = 0;
+    memset(p->sb[5].data, 0, sizeof(p->sb[5].data));
+}
+
+/* ------------------------------------------------------------------ */
+/* Router operations (Spec 8.3.1), as observed                          */
+/* ------------------------------------------------------------------ */
+
+enum {
+    ROP_NVM_SECTOR_SIZE = 0x25,
+    ROP_BUFFER_ALLOC = 0x33,
+};
+
+bool usb4_router_asm2464_op(USB4Router *r, unsigned op, uint32_t *meta,
+                            uint32_t *data, unsigned *status, bool *ons)
+{
+    switch (op) {
+    case ROP_BUFFER_ALLOC:
+        /*
+         * Buffer Allocation Request (Spec 8.3.1.3.4): one entry, PCIe 64
+         * buffers (Linux: "credit allocation parameters: PCIe: 64").
+         * Only that Data dword is written; the rest keep what an earlier
+         * operation left (observed after DROM reads).
+         */
+        data[0] = 0x00400004;
+        *meta = 1;
+        return true;
+    case ROP_NVM_SECTOR_SIZE:
+        /*
+         * NVM Sector Size: completes with Status 2, not with Operation
+         * Not Supported (ROUTER_CS_26 reads 0x02000025, three tries), so
+         * a CM sees an NVM it cannot use.
+         */
+        *status = 2;
+        return true;
+    default:
+        /*
+         * DROM Read (0x24) behaves as in the model over the captured
+         * DROM. Other operations were not issued; the model's
+         * spec-derived answers stand (inferred).
+         */
+        return false;
+    }
+}
diff --git a/hw/usb4/usb4-router-img.c b/hw/usb4/usb4-router-img.c
new file mode 100644
index 0000000000000000000000000000000000000000..b2cead56ff66a37b2cdc86ac4da34105bb83e0b7
--- /dev/null
+++ b/hw/usb4/usb4-router-img.c
@@ -0,0 +1,215 @@
+/*
+ * USB4 router model: captured register images
+ *
+ * Copyright (c) 2026 usb4-emu contributors
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Written from scratch for the usb4-emu project. A router preset built
+ * from a hardware capture (USB4Image: the intel-adl host router of
+ * docs/USB4-HOSTS.md, the asm2464 device router of
+ * docs/captures/ORICO-ASM2464.md) keeps the captured configuration
+ * space layout and reset values. Register semantics stay those of
+ * usb4-router.c (USB4 Specification 2.0 chapter 8): the dwords of the
+ * capabilities the model implements (ROUTER_CS_0-26 and the TMU Router
+ * Configuration Capability, Spec Table 8-3/8-4; ADP_CS_0-8, Lane
+ * Adapter, TMU Adapter, USB4 Port and protocol adapter capabilities,
+ * Table 8-9 and following) are mapped from their captured offsets onto
+ * the model's own offsets. Every other dword (vendor-specific
+ * capabilities, gaps) is plain storage holding the captured value.
+ */
+
+#include "qemu/osdep.h"
+#include "usb4-fabric-int.h"
+
+void usb4_router_img_layout(USB4Router *r, const USB4Image *img)
+{
+    r->img = img;
+    for (unsigned i = 1; i <= img->max_adapter; i++) {
+        const USB4ImgAdapter *d = &img->adp[i];
+        USB4Adapter *a = &r->adp[i];
+
+        if (d->kind == USB4_ADP_NONE) {
+            continue;       /* not implemented: ERR_ADDR */
+        }
+        a->kind = d->kind;
+        a->max_hop = d->max_hop;
+        a->usb4_port = d->usb4_port;
+        a->cs_size = d->cs_size;
+        a->img = d;
+        if (d->cs_size) {
+            a->xcs = g_new0(uint32_t, d->cs_size);
+        }
+        if (d->kind == USB4_ADP_LANE) {
+            USB4Port *p = &r->ports[d->usb4_port - 1];
+
+            a->lane = d->lane;
+            a->port = p;
+            p->lane[d->lane] = a;
+            a->usb4_port = 0;
+        }
+    }
+    r->max_adapter = img->max_adapter;
+    r->xcs_size = img->rtr_cs_size;
+    r->xcs = g_new0(uint32_t, img->rtr_cs_size);
+}
+
+void usb4_router_img_free(USB4Router *r)
+{
+    for (unsigned i = 0; i < USB4_MAX_ADAPTERS; i++) {
+        g_free(r->adp[i].xcs);
+    }
+    g_free(r->xcs);
+}
+
+static bool in_cap(const USB4ImgCap *c, unsigned off, unsigned *rel)
+{
+    if (c->off && off >= c->off && off < c->off + c->len) {
+        *rel = off - c->off;
+        return true;
+    }
+    return false;
+}
+
+/* ROUTER_CS_0-26 (Spec Table 8-3) are at fixed offsets. */
+#define IMG_RTR_BASIC   27
+
+bool usb4_router_img_rtr_map(USB4Router *r, unsigned off, unsigned *ioff)
+{
+    unsigned rel;
+
+    if (off < IMG_RTR_BASIC) {
+        *ioff = off;
+        return true;
+    }
+    if (in_cap(&r->img->rtr_tmu, off, &rel) && rel < USB4_RTR_CAP_TMU_LEN) {
+        *ioff = USB4_RTR_CAP_TMU + rel;
+        return true;
+    }
+    return false;
+}
+
+bool usb4_router_img_map(USB4Adapter *a, unsigned off, unsigned *ioff)
+{
+    const USB4ImgAdapter *d = a->img;
+    unsigned rel;
+
+    if (!a->xcs) {
+        *ioff = off;            /* no image: the model's own layout */
+        return true;
+    }
+    if (off <= 8) {
+        *ioff = off;            /* ADP_CS_0-8, Spec Table 8-9 */
+        return true;
+    }
+    if (in_cap(&d->lane_cap, off, &rel) && rel < USB4_ADP_CAP_LANE_LEN) {
+        *ioff = USB4_ADP_CAP_LANE + rel;
+        return true;
+    }
+    if (in_cap(&d->tmu_cap, off, &rel) && rel < USB4_ADP_CAP_TMU_LEN) {
+        *ioff = USB4_ADP_CAP_TMU + rel;
+        return true;
+    }
+    if (in_cap(&d->port_cap, off, &rel) && rel < USB4_ADP_CAP_PORT_LEN) {
+        *ioff = USB4_ADP_CAP_PORT + rel;
+        return true;
+    }
+    if (in_cap(&d->proto_cap, off, &rel)) {
+        if ((a->kind == USB4_ADP_PCIE_DOWN || a->kind == USB4_ADP_PCIE_UP) &&
+            rel < USB4_ADP_CAP_PCIE_LEN) {
+            *ioff = USB4_ADP_CAP_PCIE + rel;
+            return true;
+        }
+        if ((a->kind == USB4_ADP_USB3_DOWN || a->kind == USB4_ADP_USB3_UP) &&
+            rel < USB4_ADP_CAP_USB3_LEN) {
+            *ioff = USB4_ADP_CAP_USB3 + rel;
+            return true;
+        }
+    }
+    return false;
+}
+
+/*
+ * Router CS image. Only the captured values remain in the mapped model
+ * dwords; the identity comes from the router (r->vendor_id, product_id,
+ * uuid), which the preset sets from the capture or per instance.
+ */
+void usb4_router_img_router_image(USB4Router *r)
+{
+    const USB4Image *img = r->img;
+
+    memset(r->xcs, 0, r->xcs_size * 4);
+    for (unsigned off = 0; off < img->rtr_cs_size; off++) {
+        unsigned ioff;
+
+        if (usb4_router_img_rtr_map(r, off, &ioff)) {
+            r->cs[ioff] = 0;
+        }
+    }
+    for (unsigned i = 0; i < img->nrtr; i++) {
+        unsigned off = img->rtr[i].off, ioff;
+
+        if (off >= r->xcs_size) {
+            continue;
+        }
+        if (usb4_router_img_rtr_map(r, off, &ioff)) {
+            r->cs[ioff] = img->rtr[i].val;
+        } else {
+            r->xcs[off] = img->rtr[i].val;
+        }
+    }
+    r->cs[0] = r->vendor_id | ((uint32_t)r->product_id << 16);
+    r->cs[7] = r->uuid >> 32;
+    r->cs[8] = (uint32_t)r->uuid;
+}
+
+void usb4_router_img_adapter_image(USB4Router *r, USB4Adapter *a)
+{
+    const USB4ImgAdapter *d = a->img;
+
+    if (!a->xcs) {
+        return;
+    }
+    memset(a->xcs, 0, a->cs_size * 4);
+    for (unsigned off = 0; off < a->cs_size; off++) {
+        unsigned ioff;
+
+        if (usb4_router_img_map(a, off, &ioff)) {
+            a->cs[ioff] = 0;    /* only the captured values remain */
+        }
+    }
+    for (unsigned i = 0; i < d->ncs; i++) {
+        unsigned off = d->cs[i].off, ioff;
+
+        if (off >= a->cs_size) {
+            continue;
+        }
+        if (usb4_router_img_map(a, off, &ioff)) {
+            a->cs[ioff] = d->cs[i].val;
+        } else {
+            a->xcs[off] = d->cs[i].val;
+        }
+    }
+    /* Path CS: adapter_reset() cleared it; captured entries override. */
+    for (unsigned i = 0; i < d->npath; i++) {
+        if (d->path[i].off < 2u * (a->max_hop + 1)) {
+            a->path[d->path[i].off] = d->path[i].val;
+        }
+    }
+}
+
+unsigned usb4_router_img_cs_size(USB4Router *r, unsigned cs, USB4Adapter *a)
+{
+    switch (cs) {
+    case USB4_CS_ROUTER:
+        return r->xcs_size;
+    case USB4_CS_ADAPTER:
+        return a->xcs ? a->cs_size : USB4_ADP_CS_DWORDS;
+    case USB4_CS_PATH:
+        return 2 * (a->max_hop + 1);
+    case USB4_CS_COUNTERS:
+        /* Three dwords per counter set (Spec 8.2.4); ADP_CS_1.CCS = 1 */
+        return a->xcs ? 3 * a->img->counter_sets : 0;
+    default:
+        return 0;
+    }
+}
diff --git a/hw/usb4/usb4-router-tb3.c b/hw/usb4/usb4-router-tb3.c
new file mode 100644
index 0000000000000000000000000000000000000000..22c62a77176c6fdd6f1c17f607734f693d33670b
--- /dev/null
+++ b/hw/usb4/usb4-router-tb3.c
@@ -0,0 +1,1021 @@
+/*
+ * Thunderbolt 3 (tb3 dialect) router model: the Alpine Ridge or Titan
+ * Ridge host router and a TB3 device router as a firmware connection
+ * manager presents them to the operating system
+ *
+ * Copyright (c) 2026 usb4-emu contributors
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Written from scratch for the usb4-emu project from
+ * docs/ICM-PROTOCOL.md section 5 (requirements R17-R21) and the register
+ * values captured on the ThinkPad P14s Gen 1 (usb4-tb3-data.h). The
+ * dialect shares the fabric, the path configuration space format and
+ * the tunnel evaluator with the usb4 dialect (docs/ARCHITECTURE.md 4.2):
+ * only the register images, the capability layout and the EEPROM
+ * bit-bang interface differ.
+ *
+ * Storage model: every accessible dword is stored and initialised from
+ * the captured image. Only the dwords a connection manager writes are
+ * writable: route and depth (router dwords 1-3), the EEPROM control
+ * dword and PCIe Path Enable. Other writes are traced and ignored. Live
+ * state (link state, PCIe tunnel state, EEPROM data line) is overlaid on
+ * read. Accesses beyond the accessible range fail with error code 2
+ * (docs/ICM-PROTOCOL.md 5).
+ *
+ * A TB3 device router on a USB4 host (usb4-generic profile) is enumerated
+ * by a software CM, as on the Framework 13 with the TS3 Plus
+ * (tests/captures/framework13-12th/linux-ts3plus, docs/CAPTURE-VS-LINUX.md
+ * ADL-38..ADL-54, observed). There it starts from its power-on state
+ * (usb4-tb3-sw-data.h overlays the P14s image), and the registers that
+ * software CM writes are writable as well: the Upstream Port Number, the
+ * Notification Timeout (router dword 4), the plug events enables (Linux
+ * switch.c tb_plug_events_active), the link controller SX_CTRL dwords
+ * (lc.c tb_lc_configure_port) and the lane adapters' Target Link Width
+ * (switch.c tb_port_set_link_width). Lane state then follows the USB4
+ * host's lane bonding instead of the firmware CM's fixed x2 link. Its
+ * Host Interface adapter 5 carries the read-only DMA port (R20), as on
+ * the real dock: Linux reads the NVM version through it, and Windows'
+ * built-in CM also the DROM and the eGPU configuration, without which it
+ * fails the router with Code 10 (docs/USB4-HOSTS.md 8).
+ */
+#include "qemu/osdep.h"
+#include "usb4-fabric-int.h"
+#include "trace.h"
+#include "usb4-tb3-data.h"
+#include "usb4-tb3-sw-data.h"
+
+/* Router dwords, docs/ICM-PROTOCOL.md 5.1 */
+#define TB3_RTR_CS_SIZE     0x1ed   /* accessible dwords (P14s capture) */
+#define TB3_RTR_PE_CS1      0x29    /* plug events capability + 1 */
+#define TB3_RTR_EEPROM_CTL  0x2c    /* plug events capability + 4 */
+#define TB3_RTR_DROM_OFF    0x34    /* plug events capability + 12 */
+#define TB3_RTR_LC_LONG     0x100   /* link controller long header dw1 */
+#define TB3_RTR_LC_UUID     0x102   /* link controller UUID, 4 dwords */
+#define TB3_RTR_LC_UUID2    0x118   /* copy of UUID dwords 2-3 */
+/*
+ * Link controller port blocks: the capability at 0xff, its descriptor
+ * (0x101 = 0x01001402) puts the port blocks at +0x14, 0x100 dwords each
+ * (Linux lc.c find_port_lc_cap, tb_regs.h TB_LC_DESC); SX_CTRL is +0x96
+ * in a block (tb_regs.h TB_LC_SX_CTRL). Block 0 serves lane adapters 1-2
+ * (Upstream Facing Port), block 1 lane adapters 3-4.
+ */
+#define TB3_RTR_LC_SX_CTRL0 0x1a9
+#define TB3_RTR_LC_SX_CTRL1 0x2a9
+/*
+ * SX_CTRL bits a software CM sets (tb_regs.h): wake enables WOC..WOP
+ * (6:1), L1C/L1D/L2C/L2D (16, 17, 20, 21), SLI, UPSTREAM, SLP (31:29).
+ * Observed: 0x160 at power-on, 0x40010160 after tb_lc_configure_port.
+ */
+#define TB3_LC_SX_CTRL_RW   0xe033007e
+/*
+ * Plug events dword 1: the enables Linux tb_plug_events_active clears
+ * (active) or sets (inactive), bits 6:2. Observed: 0x4e05 at power-on,
+ * 0x4e01 written and read back; the other bits change on their own.
+ * Per Linux tb_regs.h (TB_PLUG_EVENTS_*): bit 2 disables USB events, 3
+ * lane adapter events, 4 DP OUT, 5 low and 6 high DP IN [inferred: names
+ * only, no capture shows a disabled event].
+ */
+#define TB3_PE_CS1_RW       0x0000007c
+#define TB3_PE_LANE_DIS     (1u << 3)
+#define TB3_PE_DPOUT_DIS    (1u << 4)
+#define TB3_PE_LOW_DPIN_DIS (1u << 5)
+#define TB3_PE_HIGH_DPIN_DIS (1u << 6)
+
+/* EEPROM control bits, docs/ICM-PROTOCOL.md 5.4 */
+#define TB3_EE_CLK          (1u << 0)
+#define TB3_EE_CS           (1u << 1)   /* 0 = selected */
+#define TB3_EE_DO           (1u << 2)   /* data to the EEPROM */
+#define TB3_EE_DI           (1u << 3)   /* data from the EEPROM */
+#define TB3_EE_EN           (1u << 4)
+#define TB3_EE_SPI_READ     0x03
+
+/*
+ * DMA port mailbox (R20, docs/ICM-PROTOCOL.md 5.2) at fixed dwords of the
+ * Host Interface adapter: data window, inbound and outbound words.
+ * Observed on the TS3 Plus's adapter 5 under both CMs (P14s, Framework).
+ */
+#define TB3_DMA_DATA        0x3f    /* 16 dwords */
+#define TB3_DMA_IN          0x4f
+#define TB3_DMA_OUT         0x50
+#define TB3_DMA_IN_REQ      (1u << 0)
+#define TB3_DMA_IN_ADDR     0x00fffffcu     /* bits 23:2, dword address */
+#define TB3_DMA_OUT_VALID   (1u << 29)
+#define TB3_DMA_CMD_READ    2               /* flash read */
+#define TB3_DMA_ST_ACCESS   2               /* access error */
+
+/* Adapter dwords, docs/ICM-PROTOCOL.md 5.1, 5.3 */
+#define TB3_ADP_PCIE_CAP    0x39
+#define TB3_ADP_LANE_CS1    0x37    /* lane capability (0x36) + 1 */
+#define TB3_ADP_HDR_DWORDS  9
+
+/* Max HopIDs from the captured ADP_CS_5 values */
+#define TB3_LANE_MAX_HOPID  15
+#define TB3_NHI_MAX_HOPID   11
+#define TB3_PCIE_MAX_HOPID  8
+#define TB3_DP_MAX_HOPID    9
+
+/* Router revision byte (router dword 1 bits 31:24, adapter dword 1). */
+#define TB3_HOST_REV        0x01
+#define TB3_DEV_REV         0x06
+
+/*
+ * ADP_PCIE_CS_0 of a tb3 PCIe adapter (captured): with the tunnel up,
+ * idle, and idle at power-on under a software CM (Framework 13: bit 19
+ * set until a PCIe tunnel to the router first came up, then clear on
+ * both PCIe adapters).
+ */
+#define TB3_PCIE_CAP_UP     0x46210400
+#define TB3_PCIE_CAP_IDLE   0x01260400
+#define TB3_PCIE_CAP_RESET  0x012e0400
+
+/*
+ * Host Interface adapter 5 of the TS3 Plus with its DMA port, as a
+ * software CM finds it on a USB4 host. Observed (Framework 13,
+ * linux-ts3plus, the only dwords Linux reads): dword 0 0x15788086, not
+ * the router's ID, type 0x01000002 (Host Interface) in dword 2, and the
+ * mailbox below. The other header dwords and the capability chain (DMA
+ * port VSEC at 0x3e, VSEC at 0x52) are the P14s host NHI adapter's with
+ * the dock's revision and adapter number [inferred: no capture reads
+ * them on the dock].
+ */
+static const USB4Tb3Reg tb3_adp_dev_sw_dma_regs[] = {
+    { 0x000, 0x15788086 }, { 0x001, 0x0608103e }, { 0x002, 0x01000002 },
+    { 0x003, 0x80500010 }, { 0x004, 0x01000000 }, { 0x005, 0x0000580b },
+    { 0x03e, 0x13010552 }, { 0x052, 0x04000500 }, { 0x053, 0xaa900820 },
+    { 0x055, 0x00003e80 },
+};
+static const USB4Tb3Image tb3_adp_dev_sw_dma = {
+    tb3_adp_dev_sw_dma_regs, ARRAY_SIZE(tb3_adp_dev_sw_dma_regs), 0x56,
+};
+
+static uint64_t rt_route(USB4Router *r)
+{
+    return usb4_router_topology(r);
+}
+
+bool usb4_router_tb3_sw_cm(USB4Router *r)
+{
+    return r->dialect == USB4_DIALECT_TB3 && !r->is_host &&
+           r->fabric->cfg.dialect == USB4_DIALECT_USB4;
+}
+
+bool usb4_router_tb3_hp_enabled(USB4Router *r, USB4Adapter *a)
+{
+    uint32_t pe = r->cs[TB3_RTR_PE_CS1];
+    USB4Adapter *low;
+
+    /*
+     * Under the firmware CM the ICM consumes every event; only a software
+     * CM can turn the Plug Events enables off (TB3_PE_* above).
+     */
+    if (!usb4_router_tb3_sw_cm(r)) {
+        return true;
+    }
+    switch (a->kind) {
+    case USB4_ADP_LANE:
+        return !(pe & TB3_PE_LANE_DIS);
+    case USB4_ADP_DP_OUT:
+        return !(pe & TB3_PE_DPOUT_DIS);
+    case USB4_ADP_DP_IN:
+        /* the lowest-numbered DP IN adapter is the "low" one */
+        low = usb4_router_find_kind(r, USB4_ADP_DP_IN, 0);
+        return !(pe & (a == low ? TB3_PE_LOW_DPIN_DIS
+                                : TB3_PE_HIGH_DPIN_DIS));
+    default:
+        return true;
+    }
+}
+
+/* Queue a hot plug event unless the Plug Events enables suppress it */
+static void tb3_hp_event(USB4Router *r, USB4Adapter *a, bool unplug)
+{
+    if (!usb4_router_tb3_hp_enabled(r, a)) {
+        trace_usb4_hotplug_suppressed(usb4_router_topology(r), a->num,
+                                      unplug);
+        return;
+    }
+    usb4_fabric_hp_event(r, a->num, unplug);
+}
+
+/* ------------------------------------------------------------------ */
+/* Layout                                                               */
+/* ------------------------------------------------------------------ */
+
+static void set_adp(USB4Router *r, unsigned num, USB4AdpKind kind,
+                    unsigned usb4_port, unsigned max_hop)
+{
+    USB4Adapter *a = &r->adp[num];
+
+    a->kind = kind;
+    a->usb4_port = usb4_port;
+    a->max_hop = max_hop;
+}
+
+static void set_lanes(USB4Router *r, unsigned port_index, bool dfp)
+{
+    USB4Port *port = &r->ports[port_index - 1];
+
+    port->index = port_index;
+    port->dfp = dfp;
+    for (int l = 0; l < 2; l++) {
+        USB4Adapter *a = &r->adp[2 * port_index - 1 + l];
+
+        a->kind = USB4_ADP_LANE;
+        a->lane = l;
+        a->port = port;
+        a->max_hop = TB3_LANE_MAX_HOPID;
+        port->lane[l] = a;
+    }
+}
+
+/*
+ * Titan Ridge host router (docs/ICM-TITAN-RIDGE.md 4, inferred): 1-2
+ * lane (port A), 3-4 lane (port B, 4C only), 5 NHI and Upstream
+ * Adapter, 6-7 not present to the CM, 8 PCIe Down for port A and 9 for
+ * port B (the per-port PCIe Down numbers the Linux software CM hard-codes
+ * for Titan Ridge), 10-11 DP IN (11 on 4C only). No USB3 adapters: a
+ * Thunderbolt 3 router tunnels USB as PCIe to an xHCI in the device.
+ */
+static void tb3_host_tr(USB4Router *r, bool four_c)
+{
+    r->nports = four_c ? 2 : 1;
+    set_lanes(r, 1, true);
+    if (four_c) {
+        set_lanes(r, 2, true);
+    }
+    set_adp(r, 5, USB4_ADP_HI, 0, TB3_NHI_MAX_HOPID);
+    set_adp(r, 8, USB4_ADP_PCIE_DOWN, 1, TB3_PCIE_MAX_HOPID);
+    set_adp(r, 10, USB4_ADP_DP_IN, 0, TB3_DP_MAX_HOPID);
+    if (four_c) {
+        set_adp(r, 9, USB4_ADP_PCIE_DOWN, 2, TB3_PCIE_MAX_HOPID);
+        set_adp(r, 11, USB4_ADP_DP_IN, 0, TB3_DP_MAX_HOPID);
+    }
+    r->upstream_adapter = 5;
+    r->max_adapter = 11;
+}
+
+/*
+ * Host router, R17/R18: 1-2 lane (USB4 port 1), 3 NHI and Upstream
+ * Adapter, 4 PCIe Down, 5 DP IN (Alpine Ridge LP), or the Titan Ridge
+ * layout above. Device router, R21 (as the captured dock): 1-2 lane
+ * (UFP), 3-4 lane (DFP), 5 NHI slot, 6 PCIe Up, 7 PCIe Down, 8-11 DP
+ * OUT (9 and 10 disabled by the DROM). The DFP exists in the layout
+ * even when daisy chaining is off (@ndfp 0).
+ */
+USB4Router *usb4_router_new_tb3(USB4Fabric *f, bool is_host, unsigned ndfp,
+                                USB4Device *dev)
+{
+    USB4Router *r = g_new0(USB4Router, 1);
+    unsigned i;
+
+    r->fabric = f;
+    r->is_host = is_host;
+    r->dev = dev;
+    r->dialect = USB4_DIALECT_TB3;
+    r->rtd3 = true;
+    if (is_host && f->cfg.tb3_host != USB4_TB3_HOST_AR_LP) {
+        tb3_host_tr(r, f->cfg.tb3_host == USB4_TB3_HOST_TR_4C);
+    } else if (is_host) {
+        r->nports = 1;
+        set_lanes(r, 1, true);
+        set_adp(r, 3, USB4_ADP_HI, 0, TB3_NHI_MAX_HOPID);
+        set_adp(r, 4, USB4_ADP_PCIE_DOWN, 1, TB3_PCIE_MAX_HOPID);
+        set_adp(r, 5, USB4_ADP_DP_IN, 0, TB3_DP_MAX_HOPID);
+        r->upstream_adapter = 3;
+        r->max_adapter = 5;
+    } else {
+        r->nports = 2;
+        r->ndfp = MIN(ndfp, 1);
+        set_lanes(r, 1, false);
+        set_lanes(r, 2, true);
+        r->up_port = &r->ports[0];
+        set_adp(r, 5, USB4_ADP_HI, 0, TB3_NHI_MAX_HOPID);
+        set_adp(r, 6, USB4_ADP_PCIE_UP, 1, TB3_PCIE_MAX_HOPID);
+        set_adp(r, 7, USB4_ADP_PCIE_DOWN, 2, TB3_PCIE_MAX_HOPID);
+        for (i = 8; i <= 11; i++) {
+            set_adp(r, i, USB4_ADP_DP_OUT, 0, TB3_DP_MAX_HOPID);
+        }
+        r->upstream_adapter = 1;
+        r->max_adapter = 11;
+    }
+    for (i = 0; i < r->nports; i++) {
+        r->ports[i].router = r;
+    }
+    for (i = 0; i <= r->max_adapter; i++) {
+        USB4Adapter *a = &r->adp[i];
+
+        a->num = i;
+        if (i > 0 && a->kind != USB4_ADP_NONE) {
+            a->path = g_new0(uint32_t, 2 * (a->max_hop + 1));
+        }
+    }
+    r->hp_timer = usb4_timer_new(usb4_fabric_hp_timer, r);
+    return r;
+}
+
+/* ------------------------------------------------------------------ */
+/* Reset values                                                         */
+/* ------------------------------------------------------------------ */
+
+static void load_image(uint32_t *cs, size_t store, const USB4Tb3Image *img)
+{
+    memset(cs, 0, store * sizeof(uint32_t));
+    for (unsigned i = 0; i < img->nregs; i++) {
+        cs[img->regs[i].off] = img->regs[i].val;
+    }
+}
+
+static const USB4Tb3Image *adp_image(USB4Router *r, USB4Adapter *a)
+{
+    if (r->is_host && r->fabric->cfg.tb3_host != USB4_TB3_HOST_AR_LP) {
+        /*
+         * Titan Ridge: no capture, so every adapter reuses the captured
+         * Alpine Ridge LP image of its kind (ICM-TITAN-RIDGE.md 4).
+         */
+        switch (a->kind) {
+        case USB4_ADP_LANE:
+            return a->lane ? &tb3_adp_host_lane1 : &tb3_adp_host_lane0;
+        case USB4_ADP_HI: return &tb3_adp_host_nhi;
+        case USB4_ADP_PCIE_DOWN: return &tb3_adp_host_pcie_down;
+        case USB4_ADP_DP_IN: return &tb3_adp_host_dp_in;
+        default: return NULL;
+        }
+    }
+    if (r->is_host) {
+        switch (a->num) {
+        case 1: return &tb3_adp_host_lane0;
+        case 2: return &tb3_adp_host_lane1;
+        case 3: return &tb3_adp_host_nhi;
+        case 4: return &tb3_adp_host_pcie_down;
+        case 5: return &tb3_adp_host_dp_in;
+        }
+        return NULL;
+    }
+    switch (a->num) {
+    case 1: return &tb3_adp_dev_lane0;
+    case 2: return &tb3_adp_dev_lane1;
+    case 3: return &tb3_adp_dev_dfp_lane0;
+    case 4: return &tb3_adp_dev_dfp_lane1;
+    case 5:
+        return r->dma_port ? &tb3_adp_dev_sw_dma : NULL;
+    case 6: return &tb3_adp_dev_pcie_up;
+    case 7: return &tb3_adp_dev_pcie_down;
+    case 11: return &tb3_adp_dev_dp_out11;
+    case 8: case 9: case 10: return &tb3_adp_dev_dp_out;
+    }
+    return NULL;
+}
+
+static void adapter_reset(USB4Router *r, USB4Adapter *a)
+{
+    const USB4Tb3Image *img = adp_image(r, a);
+    uint32_t *cs = a->cs;
+
+    if (a->path) {
+        memset(a->path, 0, 8 * (a->max_hop + 1));
+        if (usb4_router_tb3_sw_cm(r)) {
+            /* Power-on Path CS (usb4-tb3-sw-data.h, observed) */
+            for (unsigned i = 0; i < ARRAY_SIZE(tb3_dev_sw_path); i++) {
+                unsigned off = tb3_dev_sw_path[i].off & 0xff;
+
+                if (tb3_dev_sw_path[i].off >> 8 == a->num &&
+                    off < 2 * (a->max_hop + 1)) {
+                    a->path[off] = tb3_dev_sw_path[i].val;
+                }
+            }
+        }
+    }
+    a->reported_plugged = false;
+    if (img) {
+        load_image(cs, USB4_ADP_CS_STORE, img);
+        a->cs_size = img->size;
+    } else {
+        /* Device NHI slot: header only, values as the host's NHI */
+        memset(cs, 0, sizeof(a->cs));
+        cs[1] = ((uint32_t)TB3_DEV_REV << 24) | 0x00081000;
+        cs[3] = 1u << 31;
+        cs[5] = TB3_NHI_MAX_HOPID | (TB3_NHI_MAX_HOPID << 11);
+        a->cs_size = TB3_ADP_HDR_DWORDS;
+    }
+    if (a->kind != USB4_ADP_HI || !r->dma_port) {
+        cs[0] = r->vendor_id | ((uint32_t)r->product_id << 16);
+    }
+    /* Adapter dword 3 bits 25:20: adapter number (all captured headers) */
+    cs[3] = (cs[3] & ~(0x3fu << 20)) | ((uint32_t)a->num << 20);
+    if (a->kind == USB4_ADP_HI && !r->dma_port) {
+        /*
+         * docs/ARCHITECTURE.md 4.2 deviation (ICM-PROTOCOL R18): without
+         * the optional DMA port (R20) the NHI adapter is not NHI-typed,
+         * so the client's DMA port probe of adapters 3, 5 and 7 finds
+         * nothing. It reads as an inactive adapter with no capabilities.
+         */
+        cs[1] &= ~0xffu;
+        cs[2] = 0;
+        a->cs_size = TB3_ADP_HDR_DWORDS;
+    }
+    if (a->kind == USB4_ADP_PCIE_DOWN || a->kind == USB4_ADP_PCIE_UP) {
+        cs[TB3_ADP_PCIE_CAP] &= ~(1u << 31);  /* Path Enable off */
+    }
+    if (a->kind == USB4_ADP_LANE && usb4_router_tb3_sw_cm(r)) {
+        /*
+         * Power-on Target Link Width single (observed 0x0814001c; the
+         * P14s image holds the firmware CM's dual setting, 0x3c).
+         */
+        cs[TB3_ADP_LANE_CS1] = (cs[TB3_ADP_LANE_CS1] & ~0xffffu) | 0x001c;
+    }
+}
+
+static void lc_uuid_init(USB4Router *r)
+{
+    uint32_t *cs = r->cs;
+
+    if (r->is_host) {
+        /* Host UUID: the fabric's configured UUID (5.1, R17) */
+        for (unsigned i = 0; i < 4; i++) {
+            cs[TB3_RTR_LC_UUID + i] =
+                usb4_ld_le32(r->fabric->cfg.uuid.data + 4 * i);
+        }
+    } else if (usb4_router_tb3_sw_cm(r)) {
+        /*
+         * Software CM (docs/CAPTURE-VS-LINUX.md ADL-41, C3): the link
+         * controller UUID is a fused one, unrelated to the DROM UID;
+         * Linux reads it as the router's UUID (lc.c tb_lc_read_uuid) and
+         * bolt identifies the device by it. By default each device gets
+         * its own, derived from its DROM UID (unique per position and
+         * serial within a host, stable across re-plugs) and the host's
+         * discriminator (cfg.host_salt: two hosts with a default dock on
+         * the same port differ) by a mixing function, so it is unrelated
+         * to the DROM UID in form as on the real dock;
+         * lc-uuid=captured gives the captured value. A uid replaces
+         * dwords 0-1 either way.
+         */
+        uint64_t uid = r->dev ? usb4_device_uid(r->dev) : 0;
+        bool captured = r->dev && usb4_device_lc_uuid_captured(r->dev);
+
+        for (unsigned i = 0; i < 4; i++) {
+            uint64_t x = (r->uuid ^ r->fabric->cfg.host_salt) +
+                         0x9e3779b97f4a7c15ULL * (i + 1);
+
+            /* splitmix64 finaliser */
+            x = (x ^ (x >> 30)) * 0xbf58476d1ce4e5b9ULL;
+            x = (x ^ (x >> 27)) * 0x94d049bb133111ebULL;
+            x ^= x >> 31;
+            cs[TB3_RTR_LC_UUID + i] = captured ? tb3_sw_lc_uuid[i]
+                                               : (uint32_t)x;
+        }
+        if (uid) {
+            cs[TB3_RTR_LC_UUID] = (uint32_t)uid;
+            cs[TB3_RTR_LC_UUID + 1] = uid >> 32;
+        }
+    } else {
+        /*
+         * Identity consistency rule (docs/ARCHITECTURE.md 4.2): the link
+         * controller UUID is the DROM UID followed by all ones, as the
+         * ICM reports it (ICM-PROTOCOL 4.4).
+         */
+        cs[TB3_RTR_LC_UUID] = (uint32_t)r->uuid;
+        cs[TB3_RTR_LC_UUID + 1] = r->uuid >> 32;
+        cs[TB3_RTR_LC_UUID + 2] = 0xffffffff;
+        cs[TB3_RTR_LC_UUID + 3] = 0xffffffff;
+    }
+    cs[TB3_RTR_LC_UUID2] = cs[TB3_RTR_LC_UUID + 2];
+    cs[TB3_RTR_LC_UUID2 + 1] = cs[TB3_RTR_LC_UUID + 3];
+}
+
+void usb4_router_tb3_reset(USB4Router *r)
+{
+    uint32_t *cs = r->cs;
+    bool sw = usb4_router_tb3_sw_cm(r);
+
+    /*
+     * The TS3 Plus answers on its DMA port under a software CM (observed,
+     * Framework 13: Linux reads the NVM version 44.0 through it). Under
+     * the firmware CM the port stays off, the deviation of
+     * docs/ARCHITECTURE.md 4.2 (ICM-PROTOCOL R18/R20).
+     */
+    r->dma_port = sw;
+    load_image(cs, USB4_RTR_CS_STORE,
+               r->is_host ? &tb3_rtr_host : &tb3_rtr_dev);
+    if (sw) {
+        /* Power-on values (usb4-tb3-sw-data.h, observed) */
+        for (unsigned i = 0; i < ARRAY_SIZE(tb3_rtr_dev_sw_regs); i++) {
+            cs[tb3_rtr_dev_sw_regs[i].off] = tb3_rtr_dev_sw_regs[i].val;
+        }
+    }
+    cs[0] = r->vendor_id | ((uint32_t)r->product_id << 16);
+    /*
+     * Router dword 1 (5.1, 5.3): capability pointer, Upstream Adapter,
+     * highest adapter, depth (written by the CM), revision. At power-on
+     * the Upstream Port Number reads 0 until a software CM writes it
+     * (observed: 0x0602c005, then 0x0612c105 as written).
+     */
+    cs[1] = (cs[1] & 0xff0000ffu) |
+            ((uint32_t)(sw ? 0 : r->upstream_adapter) << 8) |
+            ((uint32_t)r->max_adapter << 14);
+    cs[2] = 0;
+    /*
+     * Route and configured bit. The firmware CM has configured the host
+     * router before the OS driver loads (R17, captured 0x80000000); a
+     * device router is configured by the CM that enumerates it.
+     */
+    cs[3] = r->is_host ? 1u << 31 : 0;
+    /*
+     * The link controller capability ends the chain (5.1 table). The
+     * captured long header points further, at vendor registers this
+     * model does not have under the firmware CM; under a software CM
+     * they are there, read-only (usb4-tb3-sw-data.h).
+     */
+    if (!sw) {
+        cs[TB3_RTR_LC_LONG] &= 0xffff0000u;
+    }
+    cs[TB3_RTR_EEPROM_CTL] &= ~(TB3_EE_CLK | TB3_EE_EN);
+    cs[TB3_RTR_EEPROM_CTL] |= TB3_EE_CS | TB3_EE_DI;
+    lc_uuid_init(r);
+
+    memset(&r->eeprom, 0, sizeof(r->eeprom));
+    r->eeprom.data_out = true;
+    for (unsigned i = 0; i <= r->max_adapter; i++) {
+        if (r->adp[i].kind != USB4_ADP_NONE) {
+            adapter_reset(r, &r->adp[i]);
+        }
+    }
+    for (unsigned i = 0; i < r->nports; i++) {
+        r->ports[i].bonded = false;
+        r->ports[i].bond_reported = false;
+    }
+    r->hpq_len = 0;
+    r->hp_outstanding = false;
+    r->pcie_trained = false;
+    if (r->hp_timer) {
+        usb4_timer_del(r->hp_timer);
+    }
+    trace_usb4_router_reset(rt_route(r), r->is_host);
+}
+
+/* ------------------------------------------------------------------ */
+/* Access                                                               */
+/* ------------------------------------------------------------------ */
+
+unsigned usb4_router_tb3_cs_size(USB4Router *r, unsigned cs, USB4Adapter *a)
+{
+    switch (cs) {
+    case USB4_CS_ROUTER:
+        return usb4_router_tb3_sw_cm(r) ? TB3_SW_RTR_CS_SIZE
+                                        : TB3_RTR_CS_SIZE;
+    case USB4_CS_ADAPTER:
+        return a->cs_size;
+    case USB4_CS_PATH:
+        return 2 * (a->max_hop + 1);
+    default:
+        return 0;
+    }
+}
+
+bool usb4_router_tb3_range_ok(USB4Router *r, unsigned cs, unsigned addr,
+                              unsigned n)
+{
+    /*
+     * Under a software CM the Router CS has gaps (observed: 0x1ed-0x212,
+     * 0x2ed-0x3ff, 0x402-0x43e are not accessible). An access must fall
+     * inside one window.
+     */
+    if (cs != USB4_CS_ROUTER || !usb4_router_tb3_sw_cm(r) ||
+        addr + n <= TB3_SW_RTR_WIN0_END ||
+        (addr >= TB3_SW_RTR_WIN1_START && addr + n <= TB3_SW_RTR_WIN1_END)) {
+        return true;
+    }
+    for (unsigned i = 0; i < ARRAY_SIZE(tb3_sw_xwin); i++) {
+        if (addr >= tb3_sw_xwin[i].start && addr + n <= tb3_sw_xwin[i].end) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static int xreg_cmp(const void *key, const void *elem)
+{
+    unsigned off = *(const unsigned *)key;
+    const USB4Tb3Reg *e = elem;
+
+    return off < e->off ? -1 : off > e->off;
+}
+
+/*
+ * Read-only captured vendor capabilities above the stored range (VSEC 7,
+ * 9 and 10 after the link controller, usb4-tb3-sw-data.h).
+ */
+static uint32_t xreg_read(unsigned off)
+{
+    const USB4Tb3Reg *e = bsearch(&off, tb3_rtr_dev_sw_xregs,
+                                  ARRAY_SIZE(tb3_rtr_dev_sw_xregs),
+                                  sizeof(tb3_rtr_dev_sw_xregs[0]), xreg_cmp);
+
+    return e ? e->val : 0;
+}
+
+bool usb4_router_tb3_mask(USB4Router *r, USB4Adapter *a, unsigned cs,
+                          unsigned off, uint32_t *mask)
+{
+    bool sw = usb4_router_tb3_sw_cm(r);
+
+    *mask = 0;
+    if (cs == USB4_CS_ROUTER) {
+        switch (off) {
+        case 1:
+            /* Depth; a software CM also writes the Upstream Port Number */
+            *mask = sw ? 0x00703f00 : 0x00700000;
+            break;
+        case 2:
+            *mask = 0xffffffff;                /* Route low */
+            break;
+        case 3:
+            *mask = 0x80ffffff;                /* Route high, configured */
+            break;
+        case 4:
+            /*
+             * Notification Timeout (Linux switch.c tb_switch_configure
+             * writes 0xff; observed 0x0200000a, then 0x020000ff).
+             */
+            *mask = sw ? 0x000000ff : 0;
+            break;
+        case TB3_RTR_PE_CS1:
+            *mask = sw ? TB3_PE_CS1_RW : 0;
+            break;
+        case TB3_RTR_EEPROM_CTL:
+            /* 5.4: clock, chip select, data out, enable */
+            *mask = TB3_EE_CLK | TB3_EE_CS | TB3_EE_DO | TB3_EE_EN;
+            break;
+        case TB3_RTR_LC_SX_CTRL0:
+        case TB3_RTR_LC_SX_CTRL1:
+            *mask = sw ? TB3_LC_SX_CTRL_RW : 0;
+            break;
+        }
+        return true;
+    }
+    if ((a->kind == USB4_ADP_PCIE_DOWN || a->kind == USB4_ADP_PCIE_UP) &&
+        off == TB3_ADP_PCIE_CAP) {
+        *mask = 1u << 31;                      /* Path Enable */
+    }
+    if (a->kind == USB4_ADP_HI && r->dma_port && off == TB3_DMA_IN) {
+        *mask = 0xffffffff;                    /* DMA port inbound word */
+    }
+    if (sw && a->kind == USB4_ADP_LANE && off == TB3_ADP_LANE_CS1) {
+        /*
+         * Target Link Width, bits 5:4 as in LANE_ADP_CS_1 (Spec Table
+         * 8-12). Observed: 0x0814001c, 0x0814003c written for bonding.
+         * On lane 0 of the downstream port also Lane Bonding, bit 15:
+         * the CM bonds the link to a chained router there (observed,
+         * linux-ts3plus-orico: 0x0814803c on 3:3, then 3:4 unplugged).
+         */
+        *mask = 0x00000030 |
+                (a->port->dfp && a->lane == 0 ? 1u << 15 : 0);
+    }
+    return true;
+}
+
+/*
+ * Lane adapter link state, captured linked (snapshot 6) and unlinked
+ * (snapshot 7) values: adapter dword 3 bits 7:0, dword 4, and lane
+ * capability dword 1, whose state (31:26), width (25:20) and speed
+ * (19:16) fields read 2 / dual / 4 when linked and 7 / single / 4 when
+ * not. Under the firmware CM the two lanes of a link are always bonded.
+ */
+static uint32_t lane_read(USB4Adapter *a, unsigned off, uint32_t v)
+{
+    bool up = usb4_lane_up(a);
+
+    if (usb4_router_tb3_sw_cm(a->port->router)) {
+        /*
+         * Software CM (observed on the Framework 13): the link comes up
+         * as two single lanes of 60 credits each (dword 3 bits 7:0 0x3c,
+         * dword 4 0x03c00000, state 2 / single / speed 4). Once the USB4
+         * host bonds them, lane 0 reads 0x78 / 0x07800000 / dual and
+         * lane 1 0 / 0. Unlinked lanes read state 7 / single / speed 8
+         * (0x1c18001c). The low half of the lane capability dword keeps
+         * Target Link Width.
+         */
+        bool x2 = up && a->port->bonded;
+
+        switch (off) {
+        case 3:
+            return (v & ~0xffu) | (x2 ? (a->lane ? 0x00 : 0x78) : 0x3c);
+        case 4:
+            return x2 ? (a->lane ? 0 : 0x07800000) : 0x03c00000;
+        case TB3_ADP_LANE_CS1:
+            return (v & 0xffff) |
+                   (up ? (x2 ? 0x08240000 : 0x08140000) : 0x1c180000);
+        }
+        return v;
+    }
+    switch (off) {
+    case 3:
+        return (v & ~0xffu) | (up ? (a->lane ? 0x00 : 0x78) : 0x3c);
+    case 4:
+        return up ? (a->lane ? 0 : 0x07800000) : 0x03c00000;
+    case TB3_ADP_LANE_CS1:
+        return up ? 0x0824003c : 0x1c14001c;
+    }
+    return v;
+}
+
+uint32_t usb4_router_tb3_read_dw(USB4Router *r, USB4Adapter *a, unsigned cs,
+                                 unsigned off)
+{
+    uint32_t v;
+
+    if (cs == USB4_CS_ROUTER) {
+        if (off >= USB4_RTR_CS_STORE) {
+            return xreg_read(off);
+        }
+        v = r->cs[off];
+        if (off == TB3_RTR_EEPROM_CTL && usb4_router_tb3_sw_cm(r) &&
+            (v & TB3_EE_EN)) {
+            /*
+             * Observed under the software CM: while bit-banging is
+             * enabled the dword reads only the CM's control bits and the
+             * data line (0x10, 0x11, 0x18, 0x19 ...); the idle value
+             * (0x0002218a) is back once it is disabled.
+             */
+            v = (v & (TB3_EE_CLK | TB3_EE_CS | TB3_EE_DO | TB3_EE_EN)) |
+                (r->eeprom.data_out ? TB3_EE_DI : 0);
+        } else if (off == TB3_RTR_EEPROM_CTL) {
+            v = (v & ~TB3_EE_DI) | (r->eeprom.data_out ? TB3_EE_DI : 0);
+        }
+        return v;
+    }
+    v = a->cs[off];
+    if (a->kind == USB4_ADP_LANE) {
+        v = lane_read(a, off, v);
+    } else if ((a->kind == USB4_ADP_PCIE_DOWN ||
+                a->kind == USB4_ADP_PCIE_UP) && off == TB3_ADP_PCIE_CAP) {
+        /*
+         * Captured: 0xc6210400 with the tunnel up (both ends), 0x01260400
+         * on an idle PCIe adapter. Bit 31 is the stored Path Enable.
+         */
+        v = (v & (1u << 31)) |
+            (usb4_fabric_adapter_up(r, a) ? TB3_PCIE_CAP_UP :
+             usb4_router_tb3_sw_cm(r) && !r->pcie_trained ?
+             TB3_PCIE_CAP_RESET : TB3_PCIE_CAP_IDLE);
+    }
+    return v;
+}
+
+/* ------------------------------------------------------------------ */
+/* EEPROM bit-bang, docs/ICM-PROTOCOL.md 5.4, R19                       */
+/* ------------------------------------------------------------------ */
+
+static uint8_t eeprom_byte(USB4Router *r, uint32_t addr)
+{
+    uint32_t base = r->cs[TB3_RTR_DROM_OFF];
+
+    if (r->drom && addr >= base && addr - base < r->drom_len) {
+        return r->drom[addr - base];
+    }
+    return 0xff;            /* erased */
+}
+
+/*
+ * A 25-series SPI EEPROM: after chip select, 8 command bits and 16
+ * address bits are sampled MSB first on rising clock edges; for the
+ * read command each further rising edge puts the next data bit, MSB
+ * first, on the data-in line, and the address auto-increments.
+ */
+static void eeprom_ctl(USB4Router *r, uint32_t old, uint32_t new)
+{
+    bool was = (old & TB3_EE_EN) && !(old & TB3_EE_CS);
+    bool on = (new & TB3_EE_EN) && !(new & TB3_EE_CS);
+
+    if (!on) {
+        if (was) {
+            trace_usb4_tb3_eeprom(rt_route(r), "deselect", r->eeprom.cmd,
+                                  r->eeprom.addr);
+        }
+        r->eeprom.active = false;
+        r->eeprom.data_out = true;
+        return;
+    }
+    if (!was || !r->eeprom.active) {
+        memset(&r->eeprom, 0, sizeof(r->eeprom));
+        r->eeprom.active = true;
+        /*
+         * The data line while the command is clocked in: high in the
+         * P14s model; low on the dock under the software CM (observed:
+         * 0x10 and 0x11 read back until the first data bit).
+         */
+        r->eeprom.data_out = !usb4_router_tb3_sw_cm(r);
+    }
+    if ((old & TB3_EE_CLK) || !(new & TB3_EE_CLK)) {
+        return;             /* not a rising edge */
+    }
+    if (r->eeprom.nbits < 24) {
+        r->eeprom.shift_in = (r->eeprom.shift_in << 1) |
+                             !!(new & TB3_EE_DO);
+        if (++r->eeprom.nbits == 24) {
+            r->eeprom.cmd = r->eeprom.shift_in >> 16;
+            r->eeprom.addr = r->eeprom.shift_in & 0xffff;
+            r->eeprom.out_byte = r->eeprom.cmd == TB3_EE_SPI_READ ?
+                                 eeprom_byte(r, r->eeprom.addr) : 0xff;
+            r->eeprom.out_bit = 0;
+            trace_usb4_tb3_eeprom(rt_route(r), "command", r->eeprom.cmd,
+                                  r->eeprom.addr);
+        }
+        return;
+    }
+    r->eeprom.data_out = (r->eeprom.out_byte >> (7 - r->eeprom.out_bit)) & 1;
+    if (++r->eeprom.out_bit == 8) {
+        r->eeprom.addr++;
+        r->eeprom.out_byte = r->eeprom.cmd == TB3_EE_SPI_READ ?
+                             eeprom_byte(r, r->eeprom.addr) : 0xff;
+        r->eeprom.out_bit = 0;
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* DMA port, docs/ICM-PROTOCOL.md 5.2, R20                              */
+/* ------------------------------------------------------------------ */
+
+/*
+ * The router's flash as the DMA port reads it. The dwords a CM reads on
+ * the real dock are observed (NVM version 44.0 at 0x08, the flash size
+ * dwords at 0x44): 0x10440000, 0xaaaa2b2d, 0x0428a804 (Framework and
+ * P14s captures). Everything else is the SPI part the EEPROM bit-bang
+ * interface reads, so the DROM sits at the same offset (router dword
+ * 0x34) as there [inferred: on the P14s host the DMA port's flash holds
+ * the DROM at 0x210, which is that offset; no capture reads the dock's
+ * DROM through its DMA port].
+ *
+ * The dword at 0x734 is the eGPU configuration Windows' built-in CM reads
+ * from every Thunderbolt 3 router (DMA port flash read 0x21000734): bit 8
+ * set means a GPU sits behind the router, and bits 11:9, the downstream
+ * bridge the GPU is behind, must be 0-6 or the router fails to start
+ * (Code 10). An erased dword (0xffffffff) fails that check. The TS3
+ * Plus is a dock, not an eGPU enclosure, so bit 8 is clear and the dword
+ * reads 0 [inferred: from the Windows driver, no capture reads it; the
+ * other bits are unknown].
+ */
+static uint8_t dma_flash_byte(USB4Router *r, uint32_t addr)
+{
+    static const struct {
+        uint32_t addr, val;
+    } fixed[] = {
+        { 0x08, 0x10440000 }, { 0x44, 0xaaaa2b2d }, { 0x48, 0x0428a804 },
+        { 0x734, 0x00000000 },
+    };
+
+    for (unsigned i = 0; i < ARRAY_SIZE(fixed); i++) {
+        if (addr >= fixed[i].addr && addr < fixed[i].addr + 4) {
+            return fixed[i].val >> (8 * (addr - fixed[i].addr));
+        }
+    }
+    return eeprom_byte(r, addr);
+}
+
+/*
+ * A request is posted by writing the inbound word with bit 0 set: bits
+ * 31:28 command, 27:24 dword count (0 means 16), 23:2 dword address. The
+ * port clears bit 0 and posts the outbound word: bit 29 valid, 7:4 the
+ * command, 3:0 status (observed: 0x22000045 written, 0x22000044 and
+ * 0x20000020 read back, then the data window). Flash read is the only
+ * command (R20); the others complete with an access error [inferred].
+ * The answer is there by the next read (the real dock took one extra
+ * poll on the P14s, which no CM depends on).
+ */
+static void dma_port_request(USB4Router *r, USB4Adapter *a, uint32_t in)
+{
+    unsigned cmd = in >> 28;
+    unsigned n = (in >> 24) & 0xf;
+    uint32_t addr = in & TB3_DMA_IN_ADDR;
+    unsigned status = 0;
+
+    n = n ? n : 16;
+    if (cmd == TB3_DMA_CMD_READ) {
+        for (unsigned i = 0; i < n; i++) {
+            uint32_t v = 0;
+
+            for (unsigned b = 0; b < 4; b++) {
+                v |= (uint32_t)dma_flash_byte(r, addr + 4 * i + b) << (8 * b);
+            }
+            a->cs[TB3_DMA_DATA + i] = v;
+        }
+    } else {
+        status = TB3_DMA_ST_ACCESS;
+    }
+    a->cs[TB3_DMA_IN] = in & ~TB3_DMA_IN_REQ;
+    a->cs[TB3_DMA_OUT] = TB3_DMA_OUT_VALID | (cmd << 4) | status;
+    trace_usb4_tb3_dma_port(rt_route(r), cmd, n, addr, status);
+}
+
+void usb4_router_tb3_side_effect(USB4Router *r, USB4Adapter *a, unsigned cs,
+                                 unsigned off, uint32_t old, uint32_t new)
+{
+    uint64_t route = rt_route(r);
+
+    if (cs == USB4_CS_ADAPTER && a && a->kind == USB4_ADP_HI &&
+        r->dma_port && off == TB3_DMA_IN && (new & TB3_DMA_IN_REQ)) {
+        dma_port_request(r, a, new);
+        return;
+    }
+
+    if (cs == USB4_CS_ADAPTER && a && a->kind == USB4_ADP_LANE &&
+        off == TB3_ADP_LANE_CS1 && (new & (1u << 15))) {
+        usb4_router_lane_bond(r, a);
+        return;
+    }
+    if (cs != USB4_CS_ROUTER) {
+        return;
+    }
+    switch (off) {
+    case 3:
+        if (!(old & (1u << 31)) && (new & (1u << 31))) {
+            trace_usb4_router_state(route, "enumerated", 1);
+            if (usb4_router_tb3_sw_cm(r)) {
+                /*
+                 * Observed (CAPTURE-VS-LINUX.md ADL-39): a few ms after a
+                 * software CM configured it, the TS3 Plus sends plug
+                 * events for adapters 9, 2 and 10 (DP OUT, Upstream
+                 * Facing Port lane 1, DP OUT). Linux acknowledges and
+                 * ignores them. With a router on its downstream port,
+                 * the plug events of lanes 3 and 4 come after those
+                 * (observed, linux-ts3plus-orico: 9, 2, 10, then 3 and
+                 * 4 about 90 ms later).
+                 */
+                static const uint8_t ev[] = { 9, 2, 10 };
+
+                for (unsigned i = 0; i < ARRAY_SIZE(ev); i++) {
+                    if (ev[i] <= r->max_adapter &&
+                        r->adp[ev[i]].kind != USB4_ADP_NONE) {
+                        tb3_hp_event(r, &r->adp[ev[i]], false);
+                    }
+                }
+            }
+            usb4_fabric_hp_enumerated(r);
+        } else if ((old ^ new) & (1u << 31)) {
+            trace_usb4_router_state(route, "enumerated", 0);
+        }
+        break;
+    case TB3_RTR_EEPROM_CTL:
+        eeprom_ctl(r, old, new);
+        break;
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* Accessors                                                            */
+/* ------------------------------------------------------------------ */
+
+unsigned usb4_adapter_pcie_cap(USB4Adapter *a)
+{
+    /* only tb3 and intel-adl adapters set cs_size; intel-adl has xcs */
+    bool tb3 = a->cs_size != 0 && !a->xcs;
+
+    return tb3 ? TB3_ADP_PCIE_CAP : USB4_ADP_CAP_PCIE;
+}
+
+void usb4_router_tb3_uuid(USB4Router *r, uint8_t out[16])
+{
+    if (!r->is_host) {
+        /* R11: the DROM UID, then all ones (not the link controller's) */
+        for (unsigned i = 0; i < 8; i++) {
+            out[i] = r->uuid >> (8 * i);
+            out[8 + i] = 0xff;
+        }
+        return;
+    }
+    for (unsigned i = 0; i < 4; i++) {
+        usb4_st_le32(out + 4 * i, r->cs[TB3_RTR_LC_UUID + i]);
+    }
+}
+
+unsigned usb4_adapter_lane_cs1(USB4Adapter *a)
+{
+    return a->port && a->port->router->dialect == USB4_DIALECT_TB3 ?
+           TB3_ADP_LANE_CS1 : USB4_ADP_CAP_LANE + 1;
+}
+
+void usb4_router_tb3_bonded(USB4Router *r)
+{
+    /*
+     * Observed (CAPTURE-VS-LINUX.md ADL-46): after the USB4 host bonded
+     * the link, the TS3 Plus reports lane 1 (adapter 2) unplugged.
+     */
+    if (usb4_router_tb3_sw_cm(r) && r->up_port) {
+        tb3_hp_event(r, r->up_port->lane[1], true);
+    }
+}
+
+uint16_t usb4_router_link_info(USB4Router *r)
+{
+    USB4Router *x = r;
+    USB4Port *dfp = NULL;
+    unsigned depth = 0;
+
+    while (x && !x->is_host) {
+        dfp = x->up_port->partner;
+        x = dfp ? dfp->router : NULL;
+        depth++;
+    }
+    if (!x || !dfp) {
+        return 0;
+    }
+    return (dfp->lane[0]->num & 7) | (depth << 4);
+}
diff --git a/hw/usb4/usb4-router.c b/hw/usb4/usb4-router.c
new file mode 100644
index 0000000000000000000000000000000000000000..1ac3794ef51e3f4c88d45a491d0c27080deb1202
--- /dev/null
+++ b/hw/usb4/usb4-router.c
@@ -0,0 +1,1766 @@
+/*
+ * USB4 router model: Router, Adapter and Path configuration spaces,
+ * Router Operations and USB4 Port sideband (Port Operations)
+ *
+ * Copyright (c) 2026 usb4-emu contributors
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Written from scratch for the usb4-emu project from the USB4
+ * Specification 2.0 ("Spec") chapter 8 and section 4.1.1.3, and the USB4
+ * Connection Manager Guide 2.0 ("Guide"). Register layouts were
+ * cross-checked against tbtools registers.json (MIT).
+ *
+ * Storage model: every supported dword is stored. A write merges the
+ * writable bits given by reg_mask() into the stored value; registers
+ * with no known definition inside the supported range are stored as
+ * written and traced as unhandled, so read-back always works. Live
+ * state (adapter state, link width, LTSSM, cable bits, TMU time) is
+ * overlaid on read.
+ */
+#include "qemu/osdep.h"
+#include "usb4-fabric-int.h"
+#include "trace.h"
+
+/* ------------------------------------------------------------------ */
+/* Layout                                                               */
+/* ------------------------------------------------------------------ */
+
+/*
+ * Router layouts. This is the single place that decides adapter
+ * numbering; change it here to try a different layout.
+ *
+ * Host router with N USB4 ports (generic profile):
+ *   0                control adapter (no config space)
+ *   2p-1, 2p         lane 0 / lane 1 adapters of USB4 port p (1..N)
+ *   2N+1             host interface adapter (Upstream Adapter)
+ *   2N+1+p           PCIe Downstream adapter paired with USB4 port p
+ *   3N+1+p           USB3 Gen X Downstream adapter paired with port p
+ * USB4 ports and PCIe adapters are ordered in pairs in increasing
+ * adapter numbers (Guide 3.2.2), so the CM maps PCIe down adapter p to
+ * USB4 port p, and likewise USB3 down adapter p. Only port 1's PCIe
+ * adapter is backed by a tunnel port. The USB3 adapters exist because the
+ * Windows CM rejects a host router without one USB3 Gen X Downstream
+ * adapter per USB4 port (observed: "Unexpected number of USB3 down
+ * adapters" assertion, PcieUsbSegmentManager::ValidateAdapters); there
+ * is no USB3 host controller behind them.
+ *
+ * Device router with D downstream USB4 ports (D = 0 for a plain
+ * enclosure, D >= 1 for a daisy-chainable one):
+ *   0                control adapter
+ *   1, 2             lane 0 / lane 1 of the Upstream Facing Port
+ *                    (adapter 1 is the Upstream Adapter, Spec 5.2.1)
+ *   2k+1, 2k+2       lane 0 / lane 1 of downstream USB4 port k (1..D)
+ *   2D+3             PCIe Upstream adapter (lowest PCIe adapter, 5.2.1)
+ *   2D+4             USB3 Gen X Upstream adapter (lowest USB3 adapter)
+ *   2D+4+k           PCIe Downstream adapter paired with downstream
+ *                    port k
+ *   3D+4+k           USB3 Gen X Downstream adapter paired with
+ *                    downstream port k
+ * USB4 ports and PCIe adapters pair in increasing adapter numbers (Spec
+ * 5.2.3): the UFP with the PCIe Upstream adapter, downstream port k with
+ * the k-th PCIe Downstream adapter. As on the host router, the Windows
+ * CM rejects a router whose USB3 Gen X Downstream adapters do not match
+ * its downstream USB4 ports (observed with a daisy-chainable device:
+ * "Unexpected number of USB3 down adapters", and "No Usb3 Up adapter
+ * found on device router with Usb3 Down adapters present"), so each
+ * downstream port gets one; nothing sits behind them. Internally the
+ * UFP is ports[0] (index 1) and downstream port k is ports[k] (index
+ * k + 1).
+ */
+static void layout_host(USB4Router *r, unsigned nports)
+{
+    unsigned p;
+
+    r->nports = nports;
+    for (p = 1; p <= nports; p++) {
+        USB4Port *port = &r->ports[p - 1];
+
+        port->index = p;
+        port->dfp = true;
+        for (int l = 0; l < 2; l++) {
+            USB4Adapter *a = &r->adp[2 * p - 1 + l];
+            a->kind = USB4_ADP_LANE;
+            a->lane = l;
+            a->port = port;
+            a->max_hop = USB4_LANE_MAX_HOPID;
+            port->lane[l] = a;
+        }
+    }
+    r->upstream_adapter = 2 * nports + 1;
+    r->adp[r->upstream_adapter].kind = USB4_ADP_HI;
+    r->adp[r->upstream_adapter].max_hop = USB4_HOST_IF_TOTAL_PATHS - 1;
+    for (p = 1; p <= nports; p++) {
+        USB4Adapter *a = &r->adp[2 * nports + 1 + p];
+        a->kind = USB4_ADP_PCIE_DOWN;
+        a->usb4_port = p;
+        a->max_hop = USB4_PCIE_MAX_HOPID;
+    }
+    for (p = 1; p <= nports; p++) {
+        USB4Adapter *a = &r->adp[3 * nports + 1 + p];
+        a->kind = USB4_ADP_USB3_DOWN;
+        a->usb4_port = p;
+        a->max_hop = USB4_USB3_MAX_HOPID;
+    }
+    r->max_adapter = 4 * nports + 1;
+}
+
+static void layout_device(USB4Router *r, unsigned ndfp)
+{
+    unsigned p, up;
+
+    r->nports = 1 + ndfp;
+    r->ndfp = ndfp;
+    for (p = 1; p <= r->nports; p++) {
+        USB4Port *port = &r->ports[p - 1];
+
+        port->index = p;
+        port->dfp = p > 1;
+        for (int l = 0; l < 2; l++) {
+            USB4Adapter *a = &r->adp[2 * p - 1 + l];
+            a->kind = USB4_ADP_LANE;
+            a->lane = l;
+            a->port = port;
+            a->max_hop = USB4_LANE_MAX_HOPID;
+            port->lane[l] = a;
+        }
+    }
+    r->up_port = &r->ports[0];
+    r->upstream_adapter = 1;
+    up = 2 * r->nports + 1;
+    r->adp[up].kind = USB4_ADP_PCIE_UP;
+    r->adp[up].usb4_port = 1;
+    r->adp[up].max_hop = USB4_PCIE_MAX_HOPID;
+    r->adp[up + 1].kind = USB4_ADP_USB3_UP;
+    r->adp[up + 1].usb4_port = 1;
+    r->adp[up + 1].max_hop = USB4_USB3_MAX_HOPID;
+    for (p = 2; p <= r->nports; p++) {
+        USB4Adapter *a = &r->adp[up + p];
+        a->kind = USB4_ADP_PCIE_DOWN;
+        a->usb4_port = p;
+        a->max_hop = USB4_PCIE_MAX_HOPID;
+    }
+    for (p = 2; p <= r->nports; p++) {
+        USB4Adapter *a = &r->adp[up + ndfp + p];
+        a->kind = USB4_ADP_USB3_DOWN;
+        a->usb4_port = p;
+        a->max_hop = USB4_USB3_MAX_HOPID;
+    }
+    r->max_adapter = up + 1 + 2 * ndfp;
+}
+
+/*
+ * Buffer figures (vendor defined). Reported by Buffer Allocation
+ * Request (Spec 8.3.1.3.4) and ADP_CS_4.Total Buffers.
+ */
+#define USB4_TOTAL_BUFFERS   120
+#define USB4_PATH0_CREDITS   7
+#define USB4_BA_USB3         32
+#define USB4_BA_DP_AUX       1
+#define USB4_BA_DP_MAIN      18
+#define USB4_BA_PCIE         32
+#define USB4_BA_HI           14
+
+/* ------------------------------------------------------------------ */
+/* Reset values                                                         */
+/* ------------------------------------------------------------------ */
+
+static uint64_t rt_route(USB4Router *r)
+{
+    return usb4_router_topology(r);
+}
+
+static void sb_init(USB4Router *r, USB4Port *p)
+{
+    static const struct { uint8_t reg, size; bool ro; } defs[] = {
+        { 0, 4, true },   /* Vendor ID */
+        { 1, 4, true },   /* Product ID */
+        { 5, 4, false },  /* Debug Configuration */
+        { 6, 54, false }, /* Debug */
+        { 7, 4, false },  /* LRD Tuning */
+        { 8, 4, false },  /* Opcode */
+        { 9, 4, false },  /* Metadata */
+        { 12, 3, false }, /* Link Configuration */
+        { 13, 4, false }, /* Gen 2/3 TxFFE */
+        { 14, 4, false }, /* Gen 4 TxFFE */
+        { 15, 4, true },  /* Sideband Channel Version */
+        { 18, 64, false },/* Data */
+    };
+
+    memset(p->sb, 0, sizeof(p->sb));
+    for (unsigned i = 0; i < ARRAY_SIZE(defs); i++) {
+        p->sb[defs[i].reg].size = defs[i].size;
+        p->sb[defs[i].reg].ro = defs[i].ro;
+    }
+    /* Spec Table 4-20: same values as Router Configuration Space. */
+    p->sb[0].data[0] = r->vendor_id & 0xff;
+    p->sb[0].data[1] = r->vendor_id >> 8;
+    p->sb[1].data[0] = r->product_id & 0xff;
+    p->sb[1].data[1] = r->product_id >> 8;
+    p->sb[15].data[0] = 1;
+}
+
+static void adapter_reset(USB4Router *r, USB4Adapter *a)
+{
+    uint32_t *cs = a->cs;
+    bool lane0;
+
+    memset(cs, 0, sizeof(a->cs));
+    if (a->path) {
+        memset(a->path, 0, 8 * (a->max_hop + 1));
+    }
+    a->reported_plugged = false;
+    if (a->kind == USB4_ADP_NONE) {
+        return;
+    }
+
+    /* ADP_CS_2 Adapter Type (Spec Table 8-9, 8-10), bits 31:24 = 01h. */
+    switch (a->kind) {
+    case USB4_ADP_LANE:
+        cs[2] = 0x01000001;
+        break;
+    case USB4_ADP_HI:
+        cs[2] = 0x01000002;
+        break;
+    case USB4_ADP_PCIE_DOWN:
+        cs[2] = 0x01100101;
+        break;
+    case USB4_ADP_PCIE_UP:
+        cs[2] = 0x01100102;
+        break;
+    case USB4_ADP_USB3_DOWN:
+        cs[2] = 0x01200101;
+        break;
+    case USB4_ADP_USB3_UP:
+        cs[2] = 0x01200102;
+        break;
+    default:
+        break;
+    }
+    cs[3] = (uint32_t)a->num << 20;
+    /* ADP_CS_5 Max Input / Output HopID */
+    cs[5] = a->max_hop | ((uint32_t)a->max_hop << 11);
+
+    switch (a->kind) {
+    case USB4_ADP_LANE:
+        lane0 = a->lane == 0;
+        cs[1] = USB4_ADP_CAP_LANE;
+        cs[4] = (uint32_t)USB4_TOTAL_BUFFERS << 20;
+        if (a->port->dfp) {
+            /* Lock set on reset and after disconnect, Spec 6.7, 8-9 */
+            cs[4] |= 1u << 31;
+        }
+        /* LANE_ADP_CS_0: Gen 2 + Gen 3 (bits 19,18), x1 + x2, no CLx */
+        cs[USB4_ADP_CAP_LANE] = USB4_ADP_CAP_TMU | (USB4_CAP_LANE << 8) |
+                                0x000c0000 | 0x00300000;
+        /*
+         * LANE_ADP_CS_1: Target Link Speed Gen 3, Target Link Width
+         * two single lanes (01b), PM Secondary 1b (Table 8-12).
+         */
+        cs[USB4_ADP_CAP_LANE + 1] = 0xc | (1 << 4) | (1u << 30);
+        /* TMU_ADP_CS_0..9 (Table 8-11); TimeToWire 10 ns * 2^16 */
+        cs[USB4_ADP_CAP_TMU] = (lane0 ? USB4_ADP_CAP_PORT : 0) |
+                               (USB4_CAP_TMU << 8);
+        cs[USB4_ADP_CAP_TMU + 1] = 10 << 16;
+        cs[USB4_ADP_CAP_TMU + 2] = 10 << 16;
+        if (lane0) {
+            /* USB4 Port Capability (Table 8-13): RS2 = RS3 = 1b */
+            cs[USB4_ADP_CAP_PORT] = USB4_CAP_PORT << 8;
+            cs[USB4_ADP_CAP_PORT + 19] = 0x6;
+        }
+        break;
+    case USB4_ADP_PCIE_DOWN:
+    case USB4_ADP_PCIE_UP:
+        cs[1] = USB4_ADP_CAP_PCIE;
+        cs[USB4_ADP_CAP_PCIE] = USB4_CAP_PROTO << 8;
+        break;
+    case USB4_ADP_USB3_DOWN:
+    case USB4_ADP_USB3_UP:
+        /*
+         * ADP_USB3_GX_CS_0..4 (Table 8-14): Max Supported Link Rate
+         * 20 Gbps, no link valid. ULV, Actual Link Rate and PLS are
+         * overlaid on read from the USB3 tunnel state (Spec 9.1.2).
+         */
+        cs[1] = USB4_ADP_CAP_USB3;
+        cs[USB4_ADP_CAP_USB3] = USB4_CAP_PROTO << 8;
+        cs[USB4_ADP_CAP_USB3 + 4] = 1u << 12;
+        break;
+    case USB4_ADP_HI:
+    default:
+        break;
+    }
+
+    /* Path 0 entry: Path Credits Allocated (Table 8-21, minimum 2) */
+    if (a->kind == USB4_ADP_LANE || a->kind == USB4_ADP_HI) {
+        a->path[0] = (uint32_t)USB4_PATH0_CREDITS << 17;
+    }
+}
+
+void usb4_router_reset(USB4Router *r)
+{
+    uint32_t *cs = r->cs;
+    uint32_t keep[USB4_MAX_ADAPTERS][2];
+    unsigned i;
+
+    if (r->dialect == USB4_DIALECT_TB3) {
+        usb4_router_tb3_reset(r);
+        return;
+    }
+
+    /*
+     * Spec 6.10: Target Link Speed and RS-FEC requests survive a Host
+     * Router reset.
+     */
+    for (i = 0; i <= r->max_adapter; i++) {
+        keep[i][0] = r->adp[i].cs[USB4_ADP_CAP_LANE + 1] & 0xf;
+        keep[i][1] = r->adp[i].cs[USB4_ADP_CAP_PORT + 19] & 0x6;
+    }
+
+    memset(cs, 0, sizeof(r->cs));
+    cs[0] = r->vendor_id | ((uint32_t)r->product_id << 16);
+    cs[1] = USB4_RTR_CAP_TMU | ((uint32_t)r->upstream_adapter << 8) |
+            ((uint32_t)r->max_adapter << 14) | (1u << 24);
+    /* ROUTER_CS_4: Notification Timeout 0Ah, USB4 Version 1.0 */
+    cs[4] = 0x0a | ((uint32_t)USB4_VERSION_1_0 << 24);
+    cs[7] = r->uuid >> 32;
+    cs[8] = (uint32_t)r->uuid;
+    /*
+     * TMU Router Configuration Capability (Table 8-4): Freq Measurement
+     * Window 800, uni-directional capable, avg constants 8.
+     */
+    cs[USB4_RTR_CAP_TMU] = (USB4_CAP_TMU << 8) | (800u << 16) | (1u << 30);
+    cs[USB4_RTR_CAP_TMU + 15] = 8 | (8 << 6) | (8 << 12) | (8 << 18);
+    if (r->is_host) {
+        cs[USB4_RTR_CAP_TMU + 18] = 1u << 31;   /* no Inter-Domain time */
+    }
+    if (r->img) {
+        usb4_router_img_router_image(r);
+    }
+
+    for (i = 0; i <= r->max_adapter; i++) {
+        adapter_reset(r, &r->adp[i]);
+        if (r->img) {
+            usb4_router_img_adapter_image(r, &r->adp[i]);
+        }
+        if (r->asm4242) {
+            usb4_router_asm_adapter_reset(r, &r->adp[i]);
+        }
+        if (r->is_host && r->adp[i].kind == USB4_ADP_LANE &&
+            !(r->adl && !keep[i][0])) {
+            /* intel-adl: before any CM write the captured values stand */
+            r->adp[i].cs[USB4_ADP_CAP_LANE + 1] =
+                (r->adp[i].cs[USB4_ADP_CAP_LANE + 1] & ~0xfu) | keep[i][0];
+            if (r->adp[i].lane == 0) {
+                r->adp[i].cs[USB4_ADP_CAP_PORT + 19] =
+                    (r->adp[i].cs[USB4_ADP_CAP_PORT + 19] & ~0x6u) |
+                    keep[i][1];
+            }
+        }
+    }
+    for (i = 0; i < r->nports; i++) {
+        sb_init(r, &r->ports[i]);
+        if (r->adl) {
+            usb4_router_adl_sb_image(r, &r->ports[i]);
+        }
+        if (r->asm2464) {
+            usb4_router_asm2464_sb_image(r, &r->ports[i]);
+        }
+        r->ports[i].sb_adapter = NULL;
+        if (r->ports[i].sb_timer) {
+            usb4_timer_del(r->ports[i].sb_timer);
+        }
+        r->ports[i].bonded = false;
+        r->ports[i].bond_reported = false;
+    }
+    r->pcie_entry_index = 0;
+    r->caps_enabled = 0;
+    r->tmu_locked_time = 0;
+    r->hpq_len = 0;
+    r->hp_outstanding = false;
+    if (r->hp_timer) {
+        usb4_timer_del(r->hp_timer);
+    }
+    if (r->asm2464) {
+        usb4_router_asm2464_reset(r);
+    }
+    trace_usb4_router_reset(rt_route(r), r->is_host);
+}
+
+
+static void port_sb_timer(void *opaque);
+static void router_op(USB4Router *r);
+
+static void router_op_timer(void *opaque)
+{
+    USB4Router *r = opaque;
+
+    if (r->cs[26] & (1u << 31)) {
+        router_op(r);
+    }
+}
+
+USB4Router *usb4_router_new(USB4Fabric *f, bool is_host, unsigned nports,
+                            USB4Device *dev)
+{
+    USB4Router *r = g_new0(USB4Router, 1);
+    unsigned i;
+
+    r->fabric = f;
+    r->is_host = is_host;
+    r->dev = dev;
+    if (is_host && f->cfg.host_model == USB4_HOST_MODEL_INTEL_ADL) {
+        usb4_router_adl_layout(r, f->cfg.host_domain);
+    } else if (is_host && f->cfg.host_model == USB4_HOST_MODEL_ASM4242) {
+        usb4_router_asm_layout(r, &f->cfg.asm4242);
+    } else if (is_host) {
+        layout_host(r, nports);
+    } else if (dev && usb4_device_model(dev) == USB4_DEVICE_MODEL_ASM2464) {
+        usb4_router_asm2464_layout(r);
+    } else {
+        layout_device(r, MIN(nports, USB4_MAX_PORTS - 1));
+    }
+    for (i = 0; i < r->nports; i++) {
+        r->ports[i].router = r;
+        if (r->sb_delay) {
+            r->ports[i].sb_timer = usb4_timer_new(port_sb_timer, &r->ports[i]);
+        }
+    }
+    for (i = 0; i <= r->max_adapter; i++) {
+        USB4Adapter *a = &r->adp[i];
+        a->num = i;
+        if (i > 0 && a->kind != USB4_ADP_NONE) {
+            a->path = g_new0(uint32_t, 2 * (a->max_hop + 1));
+        }
+    }
+    r->hp_timer = usb4_timer_new(usb4_fabric_hp_timer, r);
+    if (r->adl) {
+        r->op_timer = usb4_timer_new(router_op_timer, r);
+    }
+    return r;
+}
+
+void usb4_router_free(USB4Router *r)
+{
+    if (!r) {
+        return;
+    }
+    if (r->img) {
+        usb4_router_img_free(r);
+    }
+    for (unsigned i = 0; i < r->nports; i++) {
+        usb4_timer_free(r->ports[i].sb_timer);
+    }
+    for (unsigned i = 0; i < USB4_MAX_ADAPTERS; i++) {
+        g_free(r->adp[i].path);
+    }
+    usb4_timer_free(r->op_timer);
+    usb4_timer_free(r->rr_timer);
+    usb4_timer_free(r->link_timer);
+    usb4_timer_free(r->hp_timer);
+    g_free(r->drom);
+    g_free(r);
+}
+
+/* ------------------------------------------------------------------ */
+/* State helpers                                                        */
+/* ------------------------------------------------------------------ */
+
+uint64_t usb4_router_topology(USB4Router *r)
+{
+    return (((uint64_t)(r->cs[3] & 0xffffff)) << 32) | r->cs[2];
+}
+
+bool usb4_router_enumerated(USB4Router *r)
+{
+    return r->cs[3] & (1u << 31);
+}
+
+unsigned usb4_router_depth(USB4Router *r)
+{
+    return (r->cs[1] >> 20) & 7;
+}
+
+/* docs/ARCHITECTURE.md 4.3: ready_for_pcie, Spec Table 8-3. */
+bool usb4_router_ready_for_pcie(USB4Router *r)
+{
+    if (!usb4_router_enumerated(r)) {
+        return false;
+    }
+    if (r->is_host || r->dialect == USB4_DIALECT_TB3) {
+        /*
+         * CV, CR and PTO do not apply to a host router. A tb3 router has
+         * no Configuration Valid handshake (docs/ICM-PROTOCOL.md R21).
+         */
+        return true;
+    }
+    return (r->cs[5] & (1u << 31)) &&          /* CV */
+           (r->cs[5] & (1u << 24)) &&          /* PTO */
+           (r->cs[6] & (1u << 25));            /* CR */
+}
+
+USB4Adapter *usb4_router_adapter(USB4Router *r, unsigned num)
+{
+    if (num == 0 || num > r->max_adapter ||
+        r->adp[num].kind == USB4_ADP_NONE) {
+        return NULL;
+    }
+    return &r->adp[num];
+}
+
+USB4Adapter *usb4_router_find_kind(USB4Router *r, USB4AdpKind kind,
+                                   unsigned usb4_port)
+{
+    for (unsigned i = 1; i <= r->max_adapter; i++) {
+        if (r->adp[i].kind == kind && r->adp[i].usb4_port == usb4_port) {
+            return &r->adp[i];
+        }
+    }
+    return NULL;
+}
+
+static bool lane_disabled(USB4Adapter *a)
+{
+    if (a && a->port && a->port->router->dialect == USB4_DIALECT_TB3) {
+        return false;   /* no lane disable in the tb3 dialect model */
+    }
+    return a && (a->cs[USB4_ADP_CAP_LANE + 1] & (1u << 14));
+}
+
+/*
+ * Physical link of a USB4 port: cable present, no Downstream Port Reset
+ * and lane 0 enabled on both sides (Spec 4.4.5, 4.4.6, 6.9). A device
+ * router keeps its downstream lane adapters in CLd while its Upstream
+ * Facing Port is disconnected (Spec 6.3.1), so a link below a device
+ * router also needs that router's upstream link.
+ */
+bool usb4_port_link_up(USB4Port *p)
+{
+    USB4Port *q = p->partner;
+    USB4Port *dfp;
+
+    if (!q || p->dpr || q->dpr || p->link_hold || q->link_hold ||
+        p->usb_mode || q->usb_mode) {
+        return false;
+    }
+    if (lane_disabled(p->lane[0]) || lane_disabled(q->lane[0])) {
+        return false;
+    }
+    dfp = p->dfp ? p : q;
+    return dfp->router->is_host || usb4_port_link_up(dfp->router->up_port);
+}
+
+bool usb4_lane_up(USB4Adapter *a)
+{
+    USB4Port *p = a->port;
+
+    if (a->kind != USB4_ADP_LANE || !usb4_port_link_up(p)) {
+        return false;
+    }
+    if (a->lane == 0) {
+        return true;
+    }
+    return !lane_disabled(a) && !lane_disabled(p->partner->lane[1]);
+}
+
+unsigned usb4_lane_state(USB4Adapter *a)
+{
+    if (lane_disabled(a)) {
+        return USB4_LANE_DISABLED;
+    }
+    return usb4_lane_up(a) ? USB4_LANE_CL0 : USB4_LANE_CLD;
+}
+
+static bool router_is_v2(USB4Router *r)
+{
+    return ((r->cs[4] >> 24) & 0xff) >= USB4_VERSION_2_0 &&
+           ((r->cs[4] >> 8) & 0xff) >= 0x20;
+}
+
+/* ------------------------------------------------------------------ */
+/* Register masks                                                       */
+/* ------------------------------------------------------------------ */
+
+/*
+ * Return the writable bits of a dword and whether the dword has a
+ * definition. Unknown dwords are fully writable storage.
+ */
+static bool rtr_mask(USB4Router *r, unsigned off, uint32_t *mask)
+{
+    unsigned t = USB4_RTR_CAP_TMU;
+
+    switch (off) {
+    case 0: case 6: case 7: case 8:
+        *mask = 0;
+        return true;
+    case 1:
+        *mask = 0x00700000;                    /* Depth */
+        return true;
+    case 2:
+        *mask = 0xffffffff;                    /* TopologyID Low */
+        return true;
+    case 3:
+        *mask = 0x80ffffff;                    /* TopologyID High, V */
+        return true;
+    case 4:
+        *mask = 0x0000ffff;                    /* Notif Timeout, CMUV */
+        return true;
+    case 5:
+        /*
+         * Table 8-3: wake bits are hardwired 0 and CNS/PTO/UTO/HCO/SWM/
+         * HSGT/CV do not apply in a host router.
+         */
+        *mask = r->is_host ? 0x00000001 : 0x9f80001f;
+        return true;
+    case 26:
+        *mask = 0xff00ffff;
+        return true;
+    default:
+        break;
+    }
+    if (off >= 9 && off <= 25) {
+        *mask = 0xffffffff;                    /* Data[], Metadata */
+        return true;
+    }
+    if (off >= t && off < t + USB4_RTR_CAP_TMU_LEN) {
+        switch (off - t) {
+        case 0:   /* FMW, TD, IDE (host only) */
+            *mask = r->is_host ? 0x8fff0000 : 0x0fff0000;
+            break;
+        case 3:   /* TSPacketInterval */
+            *mask = 0xffff0000;
+            break;
+        case 15:
+            *mask = 0xffffffff;
+            break;
+        case 18:  /* DeltaAvgConst */
+            *mask = 0x00ff0000;
+            break;
+        case 22: case 23: case 24: case 25:
+            *mask = 0xffffffff;                /* Post Local Time/Time */
+            break;
+        default:
+            *mask = 0;
+            break;
+        }
+        return true;
+    }
+    *mask = 0xffffffff;
+    return false;
+}
+
+static bool adp_mask(USB4Adapter *a, unsigned off, uint32_t *mask)
+{
+    bool lane = a->kind == USB4_ADP_LANE;
+
+    switch (off) {
+    case 0: case 2: case 3: case 6: case 7: case 8:
+        *mask = 0;      /* VD, RO, W/Clr counters (no counting) */
+        return true;
+    case 1:
+        *mask = 0;      /* RBE/LBE need Bytes Counter Supported (0) */
+        return true;
+    case 4:
+        *mask = lane ? (0x3ff | (a->port->dfp ? (1u << 31) : 0)) : 0;
+        return true;
+    case 5:
+        *mask = lane ? 0xffc00000 : 0;
+        return true;
+    default:
+        break;
+    }
+    if (lane) {
+        unsigned l = USB4_ADP_CAP_LANE, t = USB4_ADP_CAP_TMU;
+        unsigned p = USB4_ADP_CAP_PORT;
+
+        if (off >= l && off < l + USB4_ADP_CAP_LANE_LEN) {
+            static const uint32_t m[] = { 0, 0x4000dcff, 0x007f0000 };
+            *mask = m[off - l];
+            return true;
+        }
+        if (off >= t && off < t + USB4_ADP_CAP_TMU_LEN) {
+            static const uint32_t m[] = {
+                0, 0, 0, 0xe0000000, 0, 0, 0x00000002, 0, 0x03ffffff,
+                0xffffffff,
+            };
+            *mask = m[off - t];
+            return true;
+        }
+        if (a->lane == 0 && off >= p && off < p + USB4_ADP_CAP_PORT_LEN) {
+            if (off == p) {
+                *mask = 0;
+            } else if (off == p + 1) {
+                *mask = 0x87f7ffff;
+            } else if (off == p + 18) {
+                *mask = 0;
+            } else if (off == p + 19) {
+                *mask = a->port->dfp ? 0xc10fff1f : 0xc10fff1e;
+            } else {
+                *mask = 0xffffffff;            /* Data[15:0] */
+            }
+            return true;
+        }
+    }
+    if (a->kind == USB4_ADP_USB3_DOWN &&
+        off >= USB4_ADP_CAP_USB3 && off < USB4_ADP_CAP_USB3 + 5) {
+        static const uint32_t m[] = {
+            0xc0000000, 0, 0x80ffffff, 0x0000003f, 0,
+        };
+        *mask = m[off - USB4_ADP_CAP_USB3];
+        return true;
+    }
+    if (a->kind == USB4_ADP_USB3_UP &&
+        off >= USB4_ADP_CAP_USB3 && off < USB4_ADP_CAP_USB3 + 5) {
+        /* Table 8-14: bandwidth fields are hardwired 0 in a Device Router */
+        *mask = off == USB4_ADP_CAP_USB3 ? 0xc0000000 : 0;
+        return true;
+    }
+    if (a->kind == USB4_ADP_DP_IN && usb4_router_asm_adp_mask(a, off, mask)) {
+        return true;        /* asm4242 DP IN adapter capability */
+    }
+    if (a->kind == USB4_ADP_PCIE_DOWN || a->kind == USB4_ADP_PCIE_UP) {
+        if (off == USB4_ADP_CAP_PCIE) {
+            *mask = 0x80000000;                /* Path Enable */
+            return true;
+        }
+        if (off == USB4_ADP_CAP_PCIE + 1) {
+            *mask = 0x00000001;                /* Extended Encapsulation */
+            return true;
+        }
+    }
+    *mask = 0xffffffff;
+    return false;
+}
+
+static bool path_mask(USB4Router *r, USB4Adapter *a, unsigned off,
+                      uint32_t *mask)
+{
+    unsigned hop = off / 2, dw = off & 1;
+    /*
+     * tb3 protocol adapters take credits and flow control bits too: the
+     * captured PCIe adapter HopID 8 entry is 0x800e0808 0x03800301
+     * (docs/ICM-PROTOCOL.md 5.5 fabric state under the firmware CM).
+     */
+    bool lane = a->kind == USB4_ADP_LANE || r->dialect == USB4_DIALECT_TB3 ||
+                r->asm2464;
+    unsigned first = a->kind == USB4_ADP_HI ? 1 : 8;
+
+    if (hop == 0) {
+        /* Path 0 (Table 8-21): only Counter ID and Counter Enable. */
+        *mask = dw ? 0x00fff000 : 0;
+        return true;
+    }
+    if (hop < first) {
+        *mask = 0xffffffff;                    /* reserved entries */
+        return false;
+    }
+    if (lane) {
+        /* Table 8-22 */
+        *mask = dw ? 0x0ffff70f : 0x81fff87f;
+    } else {
+        /* Table 8-23: credits, IFC and ISE are vendor defined (0) */
+        *mask = dw ? 0x0afff70f : 0x8001f87f;
+    }
+    return true;
+}
+
+unsigned usb4_router_cs_size(USB4Router *r, unsigned cs, unsigned adp)
+{
+    USB4Adapter *a;
+
+    a = cs == USB4_CS_ROUTER ? NULL : usb4_router_adapter(r, adp);
+    if (r->dialect == USB4_DIALECT_TB3) {
+        return cs == USB4_CS_ROUTER || a ? usb4_router_tb3_cs_size(r, cs, a)
+                                         : 0;
+    }
+    if (r->img) {
+        return cs == USB4_CS_ROUTER || a ? usb4_router_img_cs_size(r, cs, a)
+                                         : 0;
+    }
+    if (cs == USB4_CS_ROUTER) {
+        return USB4_RTR_CS_DWORDS;
+    }
+    if (!a) {
+        return 0;
+    }
+    switch (cs) {
+    case USB4_CS_ADAPTER:
+        return USB4_ADP_CS_DWORDS;
+    case USB4_CS_PATH:
+        return 2 * (a->max_hop + 1);
+    default:
+        return 0;       /* Counters CS not implemented (CCS flag 0) */
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* Reads                                                                */
+/* ------------------------------------------------------------------ */
+
+static uint64_t tmu_now(USB4Router *r)
+{
+    /* LocalTime: ns with 16 fractional bits (Spec 7.x, Table 8-4) */
+    return (uint64_t)usb4_clock_ns() << 16;
+}
+
+static uint32_t rtr_read_dw(USB4Router *r, unsigned off)
+{
+    unsigned t = USB4_RTR_CAP_TMU;
+
+    if (off == t + 1) {
+        /* Register Locking Mechanism, Spec 8.2.1.2.1 */
+        r->tmu_locked_time = tmu_now(r);
+        return (uint32_t)r->tmu_locked_time;
+    }
+    if (off == t + 2) {
+        return r->tmu_locked_time >> 32;
+    }
+    if (off == t + 3) {
+        /* LocalTime[79:64]: ns << 16 never reaches 2^64 in practice */
+        return r->cs[off] & 0xffff0000;
+    }
+    return r->cs[off];
+}
+
+static void port_cs18(USB4Adapter *a, uint32_t *v)
+{
+    USB4Port *p = a->port;
+    bool present = p->partner && !p->dpr && !p->partner->dpr;
+    bool up = usb4_port_link_up(p);
+    uint32_t rs3 = a->cs[USB4_ADP_CAP_PORT + 19] & 0x4;
+    bool tbt = present && p->partner->router->dialect == USB4_DIALECT_TB3;
+
+    /*
+     * PORT_CS_18 (Table 8-13): Cable USB4 Version 10h, bonding enabled
+     * once the link is active, RS-FEC on at Gen 3, Router Detected and
+     * Cable Gen 3 Support while a cable/partner is present.
+     */
+    *v = 0x10;
+    if (p->router->img) {
+        /* captured static bits (CLx Protocol Support, cable version) */
+        *v = a->cs[USB4_ADP_CAP_PORT + 18] &
+             ~((1u << 8) | (1u << 12) | (1u << 13) | (1u << 20));
+    }
+    if (up) {
+        *v |= 1u << 8;
+        if (rs3) {
+            *v |= 1u << 12;
+        }
+    }
+    if (present) {
+        *v |= 1u << 13;
+        /*
+         * Cable Gen 3 Support: the Upstream Facing Port of the asm2464
+         * never sets it, also on a Gen 3 link (observed: 0x00003110).
+         */
+        if (!p->router->asm2464 && !tbt) {
+            *v |= 1u << 20;
+        }
+    }
+    if (tbt) {
+        /*
+         * Thunderbolt 3 link partner: TBT3-Compatible Mode (TCM, bit 9,
+         * Spec Table 8-13) set. Observed on intel-adl with the TS3 Plus:
+         * 0x00003301, i.e. Cable USB4 Version 01h, no CLx Protocol
+         * Support and no Cable Gen 3 Support; applied to every host model.
+         */
+        *v = (*v & ~(0xffu | 1u << 10)) | 0x01 | (1u << 9);
+    }
+}
+
+static uint32_t lane_cs1(USB4Adapter *a, uint32_t v)
+{
+    unsigned st = usb4_lane_state(a);
+
+    if (a->port->router->adl && st != USB4_LANE_CL0) {
+        /* observed: speed and width keep their last values in CLd */
+        v &= ~(0xfu << 26 | 1u << 31);
+    } else {
+        v &= ~(0x3fu << 20 | 0xfu << 16 | 0xfu << 26 | 1u << 31);
+    }
+    v |= (uint32_t)st << 26;
+    if (st == USB4_LANE_CL0) {
+        v |= 0x4u << 16;                       /* Current: Gen 3 */
+        v |= (a->port->bonded ? 2u : 1u) << 20; /* Negotiated width */
+    }
+    return v;
+}
+
+static uint32_t adp_read_dw(USB4Router *r, USB4Adapter *a, unsigned off)
+{
+    uint32_t v = a->cs[off];
+
+    if (off == 4 && a->kind == USB4_ADP_LANE) {
+        /* Plugged (Spec 4.2.1.x): set on Training -> CL0 */
+        v &= ~(1u << 30);
+        if (usb4_lane_up(a)) {
+            v |= 1u << 30;
+        }
+        if (r->adl && usb4_lane_up(a)) {
+            /*
+             * intel-adl, observed: Total Buffers 120 on a lane in CL0,
+             * 0 on lane 1 of a bonded port (60 while disconnected). With
+             * a Thunderbolt 3 partner both lanes have 60 until bonded
+             * (CAPTURE-VS-LINUX.md ADL-44: "credits changed 120 -> 60").
+             */
+            bool tbt = a->port->partner &&
+                       a->port->partner->router->dialect == USB4_DIALECT_TB3;
+
+            v &= ~(0x3ffu << 20);
+            v |= (a->lane && a->port->bonded ? 0u :
+                  tbt && !a->port->bonded ? 60u : 120u) << 20;
+        }
+    } else if (a->kind == USB4_ADP_LANE &&
+               off == USB4_ADP_CAP_LANE + 1) {
+        v = lane_cs1(a, v);
+    } else if (a->kind == USB4_ADP_LANE && a->lane == 0 &&
+               off == USB4_ADP_CAP_PORT + 18) {
+        port_cs18(a, &v);
+    } else if ((a->kind == USB4_ADP_PCIE_DOWN ||
+                a->kind == USB4_ADP_PCIE_UP) && off == USB4_ADP_CAP_PCIE) {
+        bool l0 = usb4_fabric_adapter_up(r, a);
+
+        /*
+         * ADP_PCIE_CS_0 (Table 8-19): LTSSM Detect -> L0 once the
+         * tunnel is up (docs/ARCHITECTURE.md 4.3 item 5). RST 0: the
+         * internal PCIe port is out of PERST#.
+         */
+        v &= ~(0xfu << 25 | 0xfu << 16);
+        if (l0) {
+            v |= (1u << 16) | (6u << 25);
+        } else {
+            v |= (1u << 17) | (1u << 18);
+            if (r->asm2464) {
+                /*
+                 * asm2464, observed: RST is set while the tunnel is down
+                 * (0x000e0400), clear in L0 (0x8c010400).
+                 */
+                v |= 1u << 19;
+            }
+        }
+    } else if ((a->kind == USB4_ADP_USB3_DOWN ||
+                a->kind == USB4_ADP_USB3_UP) &&
+               off == USB4_ADP_CAP_USB3 + 4) {
+        /*
+         * ADP_USB3_GX_CS_4 (Table 8-14, Spec 9.1.2): once the USB3 tunnel
+         * is up the USB3 link trains to U0 at 10 Gbps (Actual Link Rate
+         * 0h) and USB3 Link Valid is set.
+         */
+        if (r->adl && !usb4_fabric_adapter_up(r, a)) {
+            return v;   /* intel-adl: captured idle value (observed) */
+        }
+        v &= ~(0x7fu | 1u << 7 | 0xfu << 8);
+        if (usb4_fabric_adapter_up(r, a)) {
+            v |= 1u << 7;
+        }
+    }
+    return v;
+}
+
+bool usb4_router_read(USB4Router *r, unsigned cs, unsigned adp,
+                      unsigned addr, unsigned n, uint32_t *out)
+{
+    unsigned size = usb4_router_cs_size(r, cs, adp);
+    USB4Adapter *a = cs == USB4_CS_ROUTER ? NULL : usb4_router_adapter(r, adp);
+    uint32_t mask;
+
+    if (addr + n > size || (r->dialect == USB4_DIALECT_TB3 &&
+                            !usb4_router_tb3_range_ok(r, cs, addr, n))) {
+        return false;
+    }
+    for (unsigned i = 0; i < n; i++) {
+        unsigned off = addr + i;
+        bool known = true;
+
+        if (r->dialect == USB4_DIALECT_TB3 && cs != USB4_CS_PATH) {
+            known = usb4_router_tb3_mask(r, a, cs, off, &mask);
+            out[i] = usb4_router_tb3_read_dw(r, a, cs, off);
+            goto traced;
+        }
+        if (r->img && cs == USB4_CS_ROUTER) {
+            unsigned ioff;
+
+            if (!usb4_router_img_rtr_map(r, off, &ioff)) {
+                out[i] = r->xcs[off];   /* captured vendor capabilities */
+                continue;
+            }
+            off = ioff;
+        }
+        if (r->img && cs == USB4_CS_ADAPTER) {
+            unsigned ioff;
+
+            if (!usb4_router_img_map(a, off, &ioff)) {
+                out[i] = a->xcs[off];
+                continue;
+            }
+            off = ioff;
+        }
+        switch (cs) {
+        case USB4_CS_ROUTER:
+            known = rtr_mask(r, off, &mask);
+            out[i] = rtr_read_dw(r, off);
+            break;
+        case USB4_CS_ADAPTER:
+            known = adp_mask(a, off, &mask);
+            out[i] = adp_read_dw(r, a, off);
+            break;
+        case USB4_CS_COUNTERS:
+            out[i] = 0;                 /* no counting (Spec 8.2.4) */
+            break;
+        case USB4_CS_PATH:
+            known = path_mask(r, a, off, &mask);
+            out[i] = a->path[off];
+            break;
+        default:
+            out[i] = 0;
+            break;
+        }
+traced:
+        if (!known) {
+            trace_usb4_unhandled_read(rt_route(r), usb4_ctl_cs_name(cs),
+                                      adp, off, out[i]);
+        }
+    }
+    return true;
+}
+
+/* ------------------------------------------------------------------ */
+/* Router Operations, Spec 8.3.1, Guide 9.1                             */
+/* ------------------------------------------------------------------ */
+
+enum {
+    ROP_DROM_READ = 0x24,
+    ROP_GET_PCIE_DS_MAPPING = 0x30,
+    ROP_GET_CAPS = 0x31,
+    ROP_SET_CAPS = 0x32,
+    ROP_BUFFER_ALLOC = 0x33,
+    ROP_BLOCK_SB = 0x34,
+    ROP_UNBLOCK_SB = 0x35,
+};
+
+/*
+ * Get/Set Capabilities, Table 8-51: we support Hot Plug Failure
+ * Indication (1), Sequence bit in Notification (2) and Buffer Allocation
+ * Per USB4 Port (3). None changes what this model sends.
+ */
+#define ROP_MAX_CAP_INDEX   5
+#define ROP_CAPS_SUPPORTED  ((1u << 1) | (1u << 2) | (1u << 3))
+
+static void router_op(USB4Router *r)
+{
+    uint32_t *cs = r->cs;
+    unsigned op = cs[26] & 0xffff;
+    uint32_t meta = cs[25];
+    uint32_t *data = &cs[9];
+    unsigned status = 0;
+    bool ons = false;
+
+    if (r->adl && usb4_router_adl_op(r, op, &meta, data, &status, &ons)) {
+        goto done;
+    }
+    if (r->asm4242 &&
+        usb4_router_asm_op(r, op, &meta, data, &status, &ons)) {
+        goto done;
+    }
+    if (r->asm2464 &&
+        usb4_router_asm2464_op(r, op, &meta, data, &status, &ons)) {
+        goto done;
+    }
+    switch (op) {
+    case ROP_DROM_READ: {
+        /* Table 8-43..8-45 */
+        unsigned dwaddr = (meta >> 2) & 0x1fff;
+        unsigned n = (meta >> 15) & 0x1f;
+
+        if (!r->drom || n == 0 || n > 16) {
+            status = 1;
+            break;
+        }
+        for (unsigned i = 0; i < n; i++) {
+            uint32_t v = 0;
+            for (unsigned b = 0; b < 4; b++) {
+                size_t idx = 4 * (size_t)(dwaddr + i) + b;
+                if (idx < r->drom_len) {
+                    v |= (uint32_t)r->drom[idx] << (8 * b);
+                }
+            }
+            data[i] = v;
+        }
+        break;
+    }
+    case ROP_GET_PCIE_DS_MAPPING: {
+        /*
+         * Tables 8-47, 8-48: one entry per Downstream PCIe Adapter. A
+         * plain device router has none (the endpoint sits directly
+         * behind the PCIe Upstream adapter). A daisy-chainable one has
+         * one per downstream USB4 port, whose Routing ID is the switch
+         * downstream port standing for it while the device's own tunnel
+         * is up (0 otherwise).
+         */
+        unsigned total = r->is_host ? r->nports : r->ndfp;
+
+        memset(data, 0, 16 * 4);
+        if (total) {
+            unsigned idx = r->pcie_entry_index % total;
+            unsigned port = r->is_host ? idx + 1 : idx + 2;
+            USB4Adapter *a = usb4_router_find_kind(r, USB4_ADP_PCIE_DOWN,
+                                                   port);
+            data[0] = a ? (uint32_t)a->num << 1 : 0;
+            /* non-FPB RID */
+            data[1] = r->is_host ? r->fabric->pcie_rid[idx + 1] :
+                      r->dev ? usb4_device_pcie_down_rid(r->dev, idx + 1) : 0;
+            meta = total | (idx << 8);
+            r->pcie_entry_index = (idx + 1) % total;
+        } else {
+            meta = 0;
+        }
+        break;
+    }
+    case ROP_GET_CAPS: {
+        unsigned idx = meta & 0xff;
+
+        if (idx > ROP_MAX_CAP_INDEX) {
+            status = 1;
+            break;
+        }
+        meta = ROP_MAX_CAP_INDEX | (idx << 8);
+        if (idx == 0) {
+            memset(data, 0, 16 * 4);
+            for (unsigned c = 1; c <= ROP_MAX_CAP_INDEX; c++) {
+                if (ROP_CAPS_SUPPORTED & (1u << c)) {
+                    data[0] |= 1u << (2 * c);
+                }
+                if (r->caps_enabled & (1u << c)) {
+                    data[0] |= 1u << (2 * c + 1);
+                }
+            }
+        } else {
+            if (ROP_CAPS_SUPPORTED & (1u << idx)) {
+                meta |= 1u << 30;
+            }
+            if (r->caps_enabled & (1u << idx)) {
+                meta |= 1u << 31;
+            }
+        }
+        break;
+    }
+    case ROP_SET_CAPS: {
+        unsigned idx = meta & 0xff;
+
+        if (idx == 0 || idx > ROP_MAX_CAP_INDEX ||
+            !(ROP_CAPS_SUPPORTED & (1u << idx))) {
+            status = 1;
+            break;
+        }
+        if (meta & (1u << 8)) {
+            r->caps_enabled |= 1u << idx;
+        } else {
+            r->caps_enabled &= ~(1u << idx);
+        }
+        break;
+    }
+    case ROP_BUFFER_ALLOC: {
+        /* Table 8-56..8-58 */
+        static const uint16_t ba[][2] = {
+            { 1, USB4_BA_USB3 }, { 2, USB4_BA_DP_AUX },
+            { 3, USB4_BA_DP_MAIN }, { 4, USB4_BA_PCIE }, { 5, USB4_BA_HI },
+        };
+        unsigned lane = (r->caps_enabled & (1u << 3)) ? meta & 0x3f : 0;
+
+        memset(data, 0, 16 * 4);
+        for (unsigned i = 0; i < ARRAY_SIZE(ba); i++) {
+            data[i] = ba[i][0] | ((uint32_t)ba[i][1] << 16);
+        }
+        meta = ARRAY_SIZE(ba) | (lane << 8);
+        break;
+    }
+    case ROP_BLOCK_SB:
+    case ROP_UNBLOCK_SB:
+        break;
+    default:
+        /*
+         * DP resource ops (no DP IN adapters), NVM ops (no NVM),
+         * Get Container-ID, Get Connectors Information, vendor ops.
+         */
+        ons = true;
+        break;
+    }
+
+done:
+    cs[25] = meta;
+    cs[26] = (cs[26] & 0xffff) | ((uint32_t)status << 24) |
+             (ons ? 1u << 30 : 0);       /* Operation Valid -> 0 */
+    trace_usb4_router_op(rt_route(r), op, meta, status, ons);
+    if (router_is_v2(r)) {
+        usb4_fabric_notify(r, USB4_EV_ROP_CMPLT, 0);
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* USB4 Port sideband register access and Port Operations               */
+/* ------------------------------------------------------------------ */
+
+#define FOURCC(a, b, c, d) \
+    ((uint32_t)(a) | ((uint32_t)(b) << 8) | ((uint32_t)(c) << 16) | \
+     ((uint32_t)(d) << 24))
+#define POP_NOT_SUPPORTED FOURCC('!', 'C', 'M', 'D')
+#define POP_ERROR         FOURCC('E', 'R', 'R', ' ')
+#define POP_ENUM_RETIMERS FOURCC('E', 'N', 'U', 'M')
+#define POP_OFFLINE_MODE  FOURCC('L', 'S', 'E', 'N')
+
+/*
+ * Spec 8.3.2.1. @local: issued through the USB4 Port Capability rather
+ * than over the sideband channel.
+ */
+static void port_op(USB4Port *p, bool local)
+{
+    USB4SBReg *opc = &p->sb[8];
+    uint32_t op = usb4_ld_le32(opc->data);
+    uint32_t res;
+
+    switch (op) {
+    case 0:
+        return;         /* completion value written back, nothing to do */
+    case POP_ENUM_RETIMERS:
+        /*
+         * Spec 8.3.2.3.2: broadcast RT transaction; there are no
+         * retimers on an emulated link, so later RT accesses get no
+         * response. Rejected when delivered over the sideband.
+         */
+        res = local ? 0 : POP_ERROR;
+        break;
+    case POP_OFFLINE_MODE:
+        res = local ? 0 : POP_ERROR;
+        break;
+    default:
+        res = POP_NOT_SUPPORTED;
+        break;
+    }
+    usb4_st_le32(opc->data, res);
+    trace_usb4_port_op(rt_route(p->router), p->lane[0]->num, op, res, local);
+    if (router_is_v2(p->router)) {
+        usb4_fabric_notify(p->router, USB4_EV_POP_CMPLT, p->lane[0]->num);
+    }
+}
+
+/*
+ * Access the SB register space of @p (Spec 4.1.1.3.1 Table 4-17).
+ * Returns the LEN value of the response; *rc is the Result Code bit.
+ */
+static unsigned sb_access(USB4Port *p, unsigned reg, unsigned len, bool wnr,
+                          uint8_t *buf, bool *rc, bool local)
+{
+    USB4SBReg *s = reg < USB4_SB_REGS ? &p->sb[reg] : NULL;
+
+    if (!s || !s->size || len == 0) {
+        *rc = true;
+        return 0;
+    }
+    if (!wnr) {
+        unsigned n = MIN(len, s->size);
+        memcpy(buf, s->data, n);
+        *rc = false;
+        if (p->router->adl) {
+            /*
+             * Observed on the intel-adl host: a read answers the register
+             * size, except Debug Configuration and Debug (16 bytes) and
+             * LRD Tuning (1 byte).
+             */
+            unsigned rlen = reg == 5 || reg == 6 ? 16 : reg == 7 ? 1
+                                                                 : s->size;
+
+            /*
+             * Every advertised byte is register data (zero past the
+             * register's size), whatever Length the CM asked for.
+             */
+            memcpy(buf, s->data, MIN(rlen, sizeof(s->data)));
+            return rlen;
+        }
+        return n;
+    }
+    if (s->ro || len > s->size) {
+        *rc = true;
+        return 0;
+    }
+    memcpy(s->data, buf, len);
+    *rc = false;
+    if (reg == 8) {
+        port_op(p, local);
+    }
+    return s->size;
+}
+
+/*
+ * PORT_CS_1.Pending set by the CM (Spec 4.1.1.3.2). Completes at once,
+ * except on the intel-adl host (port_sb_post).
+ */
+static void port_sb_request(USB4Router *r, USB4Adapter *a)
+{
+    uint32_t *pc = &a->cs[USB4_ADP_CAP_PORT];
+    uint32_t c1 = pc[1];
+    unsigned reg = c1 & 0xff, len = (c1 >> 8) & 0xff;
+    unsigned target = (c1 >> 16) & 7, index = (c1 >> 20) & 0xf;
+    bool wnr = c1 & (1u << 24), nr = false, rc = false;
+    uint8_t buf[64];
+    unsigned rlen = 0;
+
+    memset(buf, 0, sizeof(buf));
+    if (len > 64) {
+        len = 64;
+    }
+    for (unsigned i = 0; i < 16; i++) {
+        usb4_st_le32(buf + 4 * i, pc[2 + i]);
+    }
+
+    switch (target) {
+    case 0:     /* Router, local access */
+        rlen = sb_access(a->port, reg, len, wnr, buf, &rc, true);
+        break;
+    case 1: {   /* Link Partner, AT transaction */
+        USB4Port *q = a->port->partner;
+
+        if (q && !a->port->dpr && !q->dpr) {
+            rlen = sb_access(q, reg, len, wnr, buf, &rc, false);
+        } else {
+            nr = true;
+        }
+        break;
+    }
+    case 2:     /* Re-timer, RT transaction */
+        if (r->adl || r->asm2464) {
+            rlen = usb4_router_adl_rt_access(a->port, index, reg, len, wnr,
+                                             buf, &rc, &nr);
+            break;
+        }
+        nr = true;      /* no re-timers on an emulated link */
+        break;
+    default:
+        nr = true;
+        break;
+    }
+
+    if (!wnr && !nr && !rc) {
+        for (unsigned i = 0; i < 16; i++) {
+            pc[2 + i] = usb4_ld_le32(buf + 4 * i);
+        }
+    }
+    c1 &= ~((0xffu << 8) | (1u << 25) | (1u << 26) | (1u << 31));
+    c1 |= (rlen & 0xff) << 8;
+    if (nr) {
+        c1 |= 1u << 25;
+        /*
+         * Observed on the captured routers: No Response comes without the
+         * Result Code bit (intel-adl 0x02220008, asm2464 0x02220408); the
+         * asm2464 leaves the requested Length in place.
+         */
+        if (r->asm2464) {
+            c1 |= (len & 0xff) << 8;
+        }
+        rc = !r->img;
+    }
+    if (rc) {
+        c1 |= 1u << 26;
+    }
+    pc[1] = c1;
+    trace_usb4_port_sb(rt_route(r), a->num, target, index, reg, len, wnr,
+                       rlen, (nr ? 2 : 0) | (rc ? 1 : 0));
+}
+
+/*
+ * intel-adl host: a sideband transaction stays Pending for a while
+ * (observed: about 2 ms when answered, about 100 ms before No Response
+ * when no retimer answers at that index).
+ */
+static void port_sb_timer(void *opaque)
+{
+    USB4Port *p = opaque;
+    USB4Adapter *a = p->sb_adapter;
+
+    if (a) {
+        p->sb_adapter = NULL;
+        port_sb_request(p->router, a);
+    }
+}
+
+static void port_sb_post(USB4Router *r, USB4Adapter *a)
+{
+    USB4Port *p = a->port;
+    uint32_t c1 = a->cs[USB4_ADP_CAP_PORT + 1];
+    unsigned target = (c1 >> 16) & 7, index = (c1 >> 20) & 0xf;
+    bool answered;
+
+    if (!r->sb_delay || (r->asm2464 && target == 0)) {
+        /* asm2464, observed: local accesses complete at once */
+        port_sb_request(r, a);
+        return;
+    }
+    switch (target) {
+    case 0:
+        answered = true;
+        break;
+    case 1:
+        answered = p->partner && !p->dpr && !p->partner->dpr;
+        break;
+    case 2:
+        answered = usb4_router_adl_rt_present(p, index);
+        break;
+    default:
+        answered = false;
+        break;
+    }
+    p->sb_adapter = a;
+    usb4_timer_mod_ms(p->sb_timer, answered ? 1 : 100);
+}
+
+/* ------------------------------------------------------------------ */
+/* Writes and side effects                                              */
+/* ------------------------------------------------------------------ */
+
+static void tmu_post_time(USB4Router *r, unsigned off)
+{
+    unsigned t = USB4_RTR_CAP_TMU;
+
+    /*
+     * Spec 8.2.1.2 / Guide 7.4.3.1: writing Post Time High activates the
+     * mechanism; a zero Post Time updates Local Time immediately. The
+     * model's Local Time is the virtual clock, so the update is a
+     * no-op, and Post Time reads back as 0 once done.
+     */
+    if (off == t + 25 && r->cs[t + 24] <= 1 && r->cs[t + 25] == 0) {
+        r->cs[t + 24] = 0;
+        trace_usb4_router_state(rt_route(r), "post-time", 0);
+    }
+}
+
+static void rtr_side_effect(USB4Router *r, unsigned off, uint32_t old,
+                            uint32_t new)
+{
+    uint64_t route = rt_route(r);
+
+    switch (off) {
+    case 3:
+        if (!(old & (1u << 31)) && (new & (1u << 31))) {
+            /* Enumerated (Spec 6.3.4, 6.7): Router Ready within tSetRR */
+            trace_usb4_router_state(route, "enumerated", 1);
+            if (r->asm2464) {
+                usb4_router_asm2464_enumerated(r);  /* RR a bit later */
+            } else {
+                r->cs[6] |= 1u << 24;
+                trace_usb4_router_state(route, "router-ready", 1);
+            }
+            if (router_is_v2(r)) {
+                usb4_fabric_notify(r, USB4_EV_ROP_CMPLT, 1);
+            }
+            usb4_fabric_hp_enumerated(r);
+            if (r->adl) {
+                usb4_router_adl_enumerated(r);
+            }
+        } else if ((old ^ new) & (1u << 31)) {
+            trace_usb4_router_state(route, "enumerated", 0);
+        }
+        break;
+    case 5:
+        if (r->is_host) {
+            break;
+        }
+        if ((new & (1u << 31)) && !(old & (1u << 31))) {
+            /*
+             * Configuration Valid -> Configuration Ready within tSetCR
+             * (Spec 6.7). PTO/UTO take effect here.
+             */
+            r->cs[6] |= 1u << 25;
+            trace_usb4_router_state(route, "config-ready", 1);
+            if (router_is_v2(r)) {
+                usb4_fabric_notify(r, USB4_EV_ROP_CMPLT, 2);
+            }
+        } else if (!(new & (1u << 31)) && (old & (1u << 31))) {
+            r->cs[6] &= ~(1u << 25);
+            trace_usb4_router_state(route, "config-ready", 0);
+        }
+        /* fall through: Enter Sleep */
+        if ((new ^ old) & 1) {
+            if (new & 1) {
+                r->cs[6] |= 1;      /* Sleep Ready */
+            } else {
+                r->cs[6] &= ~1u;
+            }
+            trace_usb4_router_state(route, "sleep-ready", new & 1);
+        }
+        break;
+    case 26:
+        if ((new & (1u << 31)) && !(old & (1u << 31))) {
+            if (r->adl) {
+                /*
+                 * intel-adl: Operation Valid stays set for about 1 ms
+                 * (observed: one or two CM polls see it set).
+                 */
+                usb4_timer_mod_ms(r->op_timer, 1);
+            } else {
+                router_op(r);
+            }
+        }
+        break;
+    default:
+        if (off == USB4_RTR_CAP_TMU + 25) {
+            tmu_post_time(r, off);
+        }
+        break;
+    }
+    if (off == 5 && r->is_host && ((new ^ old) & 1)) {
+        if (new & 1) {
+            r->cs[6] |= 1;
+        } else {
+            r->cs[6] &= ~1u;
+        }
+        trace_usb4_router_state(route, "sleep-ready", new & 1);
+    }
+}
+
+/*
+ * LB written on lane adapter @a (lane 0 of a downstream facing port). A
+ * tb3 router keeps its lane capability at 0x36 (usb4_adapter_lane_cs1()):
+ * the TS3 Plus bonds its downstream link to a chained router this way
+ * (observed, linux-ts3plus-orico 34.387 s).
+ */
+void usb4_router_lane_bond(USB4Router *r, USB4Adapter *a)
+{
+    USB4Port *p = a->port, *q = p->partner;
+    bool ok;
+
+    /* LB is R/W self-clearing (Table 8-12). */
+    a->cs[usb4_adapter_lane_cs1(a)] &= ~(1u << 15);
+    if (p->bonded) {
+        trace_usb4_lane_bond(rt_route(r), a->num, 1, "already bonded");
+        return;
+    }
+    /*
+     * Spec 4.1.2.3: both ports' lanes in CL0 with Target Link Width =
+     * Symmetric (11b) on both adapters of both ports.
+     */
+    ok = q && usb4_lane_up(p->lane[0]) && usb4_lane_up(p->lane[1]);
+    for (int l = 0; ok && l < 2; l++) {
+        /* A tb3 partner keeps its lane capability at 0x36 */
+        USB4Adapter *ql = q->lane[l];
+
+        if (((p->lane[l]->cs[usb4_adapter_lane_cs1(p->lane[l])] >> 4) & 3) !=
+            3 ||
+            ((ql->cs[usb4_adapter_lane_cs1(ql)] >> 4) & 3) != 3) {
+            ok = false;
+        }
+    }
+    if (!ok) {
+        trace_usb4_lane_bond(rt_route(r), a->num, 0,
+                             "lanes not in CL0 or target width not x2");
+        return;
+    }
+    p->bonded = q->bonded = true;
+    trace_usb4_lane_bond(rt_route(r), a->num, 1, "bonded x2");
+    /* Lane 1 of the DFP reports a hot unplug (Spec 4.1.2.3). */
+    usb4_fabric_port_changed(p);
+    if (q->router->dialect == USB4_DIALECT_TB3) {
+        usb4_router_tb3_bonded(q->router);
+    }
+}
+
+static void adp_side_effect(USB4Router *r, USB4Adapter *a, unsigned off,
+                            uint32_t old, uint32_t new)
+{
+    if (a->kind == USB4_ADP_USB3_DOWN && off == USB4_ADP_CAP_USB3 + 2 &&
+        ((old ^ new) & (1u << 31))) {
+        /*
+         * Connection Manager Request -> Host Controller Ack (Table 8-14).
+         * No USB3 host controller consumes bandwidth, so the ack follows
+         * the request at once and Consumed Bandwidth stays 0.
+         */
+        if (new & (1u << 31)) {
+            a->cs[USB4_ADP_CAP_USB3 + 1] |= 1u << 31;
+        } else {
+            a->cs[USB4_ADP_CAP_USB3 + 1] &= ~(1u << 31);
+        }
+        trace_usb4_router_state(rt_route(r), "usb3-hc-ack", new >> 31);
+    }
+    if (a->kind == USB4_ADP_LANE) {
+        unsigned l = USB4_ADP_CAP_LANE, t = USB4_ADP_CAP_TMU;
+        unsigned p = USB4_ADP_CAP_PORT;
+
+        if (off == l + 1) {
+            if ((new ^ old) & (1u << 14)) {
+                trace_usb4_lane_state(rt_route(r), a->num,
+                                      (new & (1u << 14)) ? "disable" :
+                                      "enable");
+                if (a->lane == 0 || !(new & (1u << 14))) {
+                    a->port->bonded = false;
+                    if (a->port->partner) {
+                        a->port->partner->bonded = false;
+                    }
+                }
+                usb4_fabric_port_changed(a->port);
+            }
+            if (new & (1u << 15)) {
+                usb4_router_lane_bond(r, a);
+            }
+        } else if (off >= t && off < t + USB4_ADP_CAP_TMU_LEN) {
+            /* Both lanes of a port hold identical TMU values (8.2.2.2) */
+            USB4Adapter *o = a->port->lane[a->lane ^ 1];
+            o->cs[off] = new;
+        } else if (a->lane == 0 && off == p + 1) {
+            if ((new & (1u << 31)) && !(old & (1u << 31))) {
+                port_sb_post(r, a);
+            }
+        } else if (a->lane == 0 && off == p + 19 && a->port->dfp) {
+            bool dpr = new & 1;
+            if (dpr != a->port->dpr) {
+                a->port->dpr = dpr;
+                trace_usb4_port_dpr(rt_route(r), a->num, dpr);
+                usb4_fabric_port_changed(a->port);
+            }
+        }
+    }
+}
+
+bool usb4_router_write(USB4Router *r, unsigned cs, unsigned adp,
+                       unsigned addr, unsigned n, const uint32_t *in)
+{
+    unsigned size = usb4_router_cs_size(r, cs, adp);
+    USB4Adapter *a = cs == USB4_CS_ROUTER ? NULL : usb4_router_adapter(r, adp);
+    unsigned cnt = addr >= size ? 0 : MIN(n, size - addr);
+    uint32_t old[60], mask;
+    int ioffs[60];      /* model offset of each dword, -1: no semantics */
+    bool path_changed = false;
+
+    if (r->dialect == USB4_DIALECT_TB3 &&
+        !usb4_router_tb3_range_ok(r, cs, addr, n)) {
+        cnt = 0;            /* touches the inaccessible gap: no effect */
+    }
+
+    assert(n <= 60);
+    /*
+     * Store first, then run side effects in address order (a Router
+     * Operation is posted by the last dword of the same request).
+     */
+    for (unsigned i = 0; i < cnt; i++) {
+        unsigned off = addr + i;
+        uint32_t *p;
+        bool known;
+
+        ioffs[i] = -1;
+        if (r->dialect == USB4_DIALECT_TB3 && cs != USB4_CS_PATH) {
+            static uint32_t ro_dummy;
+
+            known = usb4_router_tb3_mask(r, a, cs, off, &mask);
+            if (cs == USB4_CS_ROUTER && off >= USB4_RTR_CS_STORE) {
+                /* read-only captured vendor registers (tb3, software CM) */
+                ro_dummy = usb4_router_tb3_read_dw(r, a, cs, off);
+                p = &ro_dummy;
+                mask = 0;
+            } else {
+                p = cs == USB4_CS_ROUTER ? &r->cs[off] : &a->cs[off];
+            }
+            goto store;
+        }
+        if (cs == USB4_CS_COUNTERS) {
+            /* Counters are W/Clr and never count here (Spec 8.2.4) */
+            static uint32_t dummy;
+            known = true;
+            mask = 0;
+            p = &dummy;
+            goto store;
+        }
+        if (r->img && cs == USB4_CS_ROUTER) {
+            unsigned ioff;
+
+            if (!usb4_router_img_rtr_map(r, off, &ioff)) {
+                known = false;
+                mask = 0xffffffff;
+                p = &r->xcs[off];
+                goto store;
+            }
+            off = ioff;
+        }
+        if (r->img && cs == USB4_CS_ADAPTER) {
+            unsigned ioff;
+
+            if (!usb4_router_img_map(a, off, &ioff)) {
+                known = false;
+                mask = 0xffffffff;
+                p = &a->xcs[off];
+                goto store;
+            }
+            off = ioff;
+        }
+        ioffs[i] = off;
+        switch (cs) {
+        case USB4_CS_ROUTER:
+            known = rtr_mask(r, off, &mask);
+            p = &r->cs[off];
+            break;
+        case USB4_CS_ADAPTER:
+            known = adp_mask(a, off, &mask);
+            p = &a->cs[off];
+            break;
+        case USB4_CS_PATH:
+        default:
+            known = path_mask(r, a, off, &mask);
+            p = &a->path[off];
+            break;
+        }
+store:
+        old[i] = *p;
+        *p = (*p & ~mask) | (in[i] & mask);
+        if (!known) {
+            trace_usb4_unhandled_write(rt_route(r), usb4_ctl_cs_name(cs),
+                                       adp, off, in[i]);
+        } else if ((in[i] & ~mask) != (old[i] & ~mask) &&
+                   cs != USB4_CS_PATH) {
+            trace_usb4_ro_write(rt_route(r), usb4_ctl_cs_name(cs), adp, off,
+                                in[i], *p);
+        }
+        trace_usb4_cs_write(rt_route(r), usb4_ctl_cs_name(cs), adp, off,
+                            old[i], *p);
+    }
+    for (unsigned i = 0; i < cnt; i++) {
+        unsigned off = addr + i;
+
+        if (r->dialect != USB4_DIALECT_TB3 || cs == USB4_CS_PATH) {
+            if (ioffs[i] < 0) {
+                continue;       /* captured storage, counters */
+            }
+            off = ioffs[i];
+        }
+        if (r->dialect == USB4_DIALECT_TB3 && cs != USB4_CS_PATH) {
+            if (cs == USB4_CS_ROUTER && off >= USB4_RTR_CS_STORE) {
+                continue;       /* read-only, no side effects */
+            }
+            usb4_router_tb3_side_effect(r, a, cs, off, old[i],
+                                        cs == USB4_CS_ROUTER ? r->cs[off]
+                                                             : a->cs[off]);
+            continue;
+        }
+        switch (cs) {
+        case USB4_CS_ROUTER:
+            rtr_side_effect(r, off, old[i], r->cs[off]);
+            break;
+        case USB4_CS_ADAPTER:
+            adp_side_effect(r, a, off, old[i], a->cs[off]);
+            break;
+        case USB4_CS_PATH:
+            if (old[i] != a->path[off]) {
+                path_changed = true;
+            }
+            if (r->asm4242) {
+                usb4_router_asm_path_written(r, a, off, old[i], a->path[off]);
+            }
+            if (off & 1) {
+                trace_usb4_path(rt_route(r), adp, off / 2, a->path[off - 1],
+                                a->path[off]);
+            } else if (i + 1 == cnt) {
+                /* Version 1 CM teardown may write only DW0 (8.2.3.4) */
+                trace_usb4_path(rt_route(r), adp, off / 2, a->path[off],
+                                a->path[off + 1]);
+            }
+            break;
+        }
+    }
+    if (cnt && (cs != USB4_CS_PATH || path_changed)) {
+        usb4_fabric_reevaluate(r->fabric, USB4_TUNNEL_REASON_ADMIN_DOWN);
+    }
+    return cnt == n;
+}
