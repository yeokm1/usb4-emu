+static void test_tb3_device(void)
+{
+    static const uint32_t hdr[5] = {
+        0x15d38086, 0x0612c105, 0x00000001, 0x80000000, 0x020000fe,
+    };
+    static const uint32_t dev_type[12] = {
+        0, 0x01000001, 0x01000001, 0x01000001, 0x01000001, 0,
+        0x01100102, 0x01100101, 0x010e0102, 0x010e0102, 0x010e0102,
+        0x010e0102,
+    };
+    uint32_t v[8], one = 1;
+    uint8_t drom[256], uuid[16];
+    USB4Router *r;
+    unsigned len;
+    Error *err = NULL;
+
+    tp_calls = 0;
+    CHECK(usb4_fabric_attach(fab, 1, &tb3dev, &err), "attach tb3 device");
+    r = tb3dev.router;
+    CHECK(r && r->dialect == USB4_DIALECT_TB3, "tb3 device router");
+    rx_flush_hp();
+
+    /* Linked lanes, captured snapshot 6 */
+    CHECK(rd1(HOST, USB4_CS_ADAPTER, 1, 0x37) == 0x0824003c &&
+          rd1(HOST, USB4_CS_ADAPTER, 1, 4) == 0x07800000 &&
+          rd1(HOST, USB4_CS_ADAPTER, 1, 3) == 0x80100078 &&
+          rd1(HOST, USB4_CS_ADAPTER, 2, 3) == 0x80200000, "lanes linked");
+
+    /* Enumerate as the firmware CM does: depth, route, configured */
+    CHECK(!usb4_fabric_cfg_read(fab, DEV1, USB4_CS_ADAPTER, 1, 0, 1, v),
+          "uninitialized router: router CS only");
+    CHECK(usb4_fabric_cfg_read(fab, DEV1, USB4_CS_ROUTER, 0, 1, 1, v),
+          "internal read of an uninitialized router");
+    v[0] |= 1u << 20;
+    CHECK(usb4_fabric_cfg_write(fab, DEV1, USB4_CS_ROUTER, 0, 1, 1, v),
+          "depth");
+    v[0] = 1;
+    v[1] = 1u << 31;
+    CHECK(usb4_fabric_cfg_write(fab, DEV1, USB4_CS_ROUTER, 0, 2, 2, v),
+          "route and configured");
+    CHECK(usb4_router_ready_for_pcie(r), "no CV handshake (R21)");
+
+    CHECK(rd(DEV1, USB4_CS_ROUTER, 0, 0, 5, v) == 0 &&
+          !memcmp(v, hdr, sizeof(hdr)), "tb3 device header %08x %08x "
+          "%08x %08x %08x", v[0], v[1], v[2], v[3], v[4]);
+    CHECK(USB4_REQ_ADP(last_rsp_dw2) == 1, "device reply adapter (R21)");
+    CHECK(rd1(DEV1, USB4_CS_ROUTER, 0, 0x28) == 0x35010563 &&
+          rd1(DEV1, USB4_CS_ROUTER, 0, 0x34) == 0x210 &&
+          rd1(DEV1, USB4_CS_ROUTER, 0, TB3_EE) == 0x0002218e,
+          "device plug events capability");
+    for (unsigned a = 1; a <= 11; a++) {
+        CHECK(rd1(DEV1, USB4_CS_ADAPTER, a, 2) == dev_type[a],
+              "device adapter %u type", a);
+    }
+    CHECK(rd1(DEV1, USB4_CS_ADAPTER, 7, 0x39) == 0x01260400,
+          "device PCIe down cap");
+    CHECK(rd1(DEV1, USB4_CS_ADAPTER, 3, 0x37) == 0x1c14001c,
+          "unlinked DFP lane");
+
+    /* DROM by bit-bang: size, then everything (5.4 transfers) */
+    ee_read(DEV1, 0x21e, drom, 2);
+    len = drom[0] | drom[1] << 8;
+    CHECK(len + 13 == r->drom_len, "DROM length %u", len);
+    ee_read(DEV1, 0x210, drom, MIN(len + 13, sizeof(drom)));
+    CHECK(!memcmp(drom, r->drom, r->drom_len), "DROM via EEPROM");
+    CHECK(usb4_drom_crc8(drom + 1, 8) == drom[0], "DROM CRC-8");
+    CHECK(usb4_drom_crc32(drom + 13, len) ==
+          (drom[9] | drom[10] << 8 | drom[11] << 16 |
+           (uint32_t)drom[12] << 24), "DROM CRC-32");
+    CHECK(!memcmp(drom + 0x56, "QEMU Thunderbolt", 17), "DROM vendor name");
+
+    /* Identity for the ICM (4.4, R11) */
+    usb4_router_tb3_uuid(r, uuid);
+    for (unsigned i = 0; i < 8; i++) {
+        CHECK(uuid[i] == drom[1 + i] && uuid[8 + i] == 0xff, "UUID byte %u",
+              i);
+    }
+    CHECK(usb4_router_link_info(r) == 0x11, "link info %04x",
+          usb4_router_link_info(r));
+    CHECK(rd(DEV1, USB4_CS_ROUTER, 0, 0x102, 2, v) == 0 &&
+          v[0] == (uint32_t)r->uuid && v[1] == r->uuid >> 32,
+          "device link controller UUID = DROM UID");
+
+    /*
+     * PCIe tunnel programmed with the captured path entries (host
+     * adapter 4 and lane 1, dock lane 1 and adapter 6, snap-6 path
+     * files); the host side over ring 0, the device side through the
+     * internal API as the emulated ICM will.
+     */
+    tb3_path(HOST, 4, 0x800e0808, 0x03800301, false);
+    tb3_path(HOST, 1, 0x80402008, 0x01801301, false);
+    tb3_path(DEV1, 1, 0x80403008, 0x01801301, true);
+    tb3_path(DEV1, 6, 0x800e0808, 0x03800301, true);
+    CHECK(tp_calls == 0, "no tunnel before Path Enable");
+    v[0] = rd1(HOST, USB4_CS_ADAPTER, 4, 0x39) | (1u << 31);
+    wr1(HOST, USB4_CS_ADAPTER, 4, 0x39, v[0]);
+    CHECK(tp_calls == 0, "no tunnel with one Path Enable");
+    v[0] = 0x80000000;
+    CHECK(usb4_fabric_cfg_write(fab, DEV1, USB4_CS_ADAPTER, 6, 0x39, 1, v),
+          "device Path Enable");
+    CHECK(tp_calls == 1 && tp_state == USB4_TUNNEL_UP && tp_dev == &tb3dev,
+          "tb3 PCIe tunnel up");
+    CHECK(rd1(HOST, USB4_CS_ADAPTER, 4, 0x39) == 0xc6210400 &&
+          rd1(DEV1, USB4_CS_ADAPTER, 6, 0x39) == 0xc6210400,
+          "PCIe caps as captured with the tunnel up");
+    CHECK(rd1(HOST, USB4_CS_PATH, 4, 16) == 0x800e0808, "path read back");
+
+    /* Teardown by clearing Path Enable, then unplug */
+    wr1(HOST, USB4_CS_ADAPTER, 4, 0x39, 0);
+    CHECK(tp_calls == 2 && tp_state == USB4_TUNNEL_DOWN &&
+          tp_reason == USB4_TUNNEL_REASON_ADMIN_DOWN, "tunnel admin down");
+    wr1(HOST, USB4_CS_ADAPTER, 4, 0x39, 1u << 31);
+    CHECK(tp_calls == 3 && tp_state == USB4_TUNNEL_UP, "tunnel up again");
+    usb4_fabric_detach(fab, 1);
+    CHECK(tp_calls == 4 && tp_state == USB4_TUNNEL_DOWN &&
+          tp_reason == USB4_TUNNEL_REASON_SURPRISE, "surprise removal");
+    CHECK(!usb4_fabric_cfg_write(fab, DEV1, USB4_CS_ROUTER, 0, 2, 1, &one),
+          "internal write to a detached router fails");
+    rx_flush_hp();
+}
