+/*
+ * Send one full-size Titan Ridge request (ICM-TITAN-RIDGE.md 3.6, 3.7)
+ * and check the R15 error frame: the request words echoed, the error
+ * flag set, packet index 0 and count 1, nothing else on the ring.
+ */
+static void unsupported_full(T *t, const uint32_t *cmd, unsigned n)
+{
+    uint32_t w[64];
+
+    icm_cmd(t, cmd, n);
+    g_assert_cmpuint(icm_expect(t, PDF_ICM_RESP, w), ==, n);
+    g_assert_cmphex(w[0], ==, 0x01000100 | (cmd[0] & 0xff));
+    g_assert_cmpmem(&w[1], 4 * (n - 1), &cmd[1], 4 * (n - 1));
+    icm_expect_none(t);
+}
+
+/*
+ * T7, R15: challenge (0x05) and add key (0x06) addressed to the attached
+ * device, approve XDomain (0x10) and disconnect XDomain (0x11) at its
+ * route, each with its full Titan Ridge length.
+ */
+static void send_unsupported(T *t, const uint32_t *uuid, unsigned id)
+{
+    uint32_t cmd[16];
+
+    /* 0x05 challenge: UUID, route, id, 8 challenge words (16 words) */
+    cmd[0] = 0x00000005;
+    memcpy(&cmd[1], uuid, 16);
+    cmd[5] = 0;
+    cmd[6] = 1;
+    cmd[7] = id;
+    for (unsigned i = 8; i < 16; i++) {
+        cmd[i] = 0x5a5a0000 | i;
+    }
+    unsupported_full(t, cmd, 16);
+    /* 0x06 add key: same addressing, 8 key words (16 words) */
+    cmd[0] = 0x00000006;
+    for (unsigned i = 8; i < 16; i++) {
+        cmd[i] = 0xa5a50000 | i;
+    }
+    unsupported_full(t, cmd, 16);
+    /* 0x10 approve XDomain: route, remote UUID, paths and rings (9) */
+    cmd[0] = 0x00000010;
+    cmd[1] = 0;
+    cmd[2] = 1;
+    memcpy(&cmd[3], uuid, 16);
+    cmd[7] = 0x00010008;
+    cmd[8] = 0x00010008;
+    unsupported_full(t, cmd, 9);
+    /* 0x11 disconnect XDomain: stage, route, remote UUID (8 words) */
+    cmd[0] = 0x00000011;
+    cmd[1] = 1;
+    cmd[2] = 0;
+    cmd[3] = 1;
+    memcpy(&cmd[4], uuid, 16);
+    unsupported_full(t, cmd, 8);
+}
+
+/*
+ * The refused requests change no tunnel or approval state, before and
+ * after the approve.
+ */
+static void test_unsupported_full(void)
+{
+    uint32_t w[64], uuid[4], v;
+    unsigned n, id;
+    T *t = t_start(NULL, true);
+
+    icm_bind(t, w);
+    n = icm_expect(t, PDF_ICM_EVENT, w);
+    id = check_connected(w, n, 1, 0x0811, uuid);
+
+    /* unapproved: refused, the tunnel stays down */
+    send_unsupported(t, uuid, id);
+    g_assert_false(gate_open(t->qts));
+    g_assert_cmpuint(cfg_read(t, 0, 1, 8, 0x39, &v), ==, PDF_READ);
+    g_assert_cmphex(v & 0x80000000, ==, 0);
+
+    /* approved: refused, the tunnel stays up */
+    approve(t, uuid, 1, id, w);
+    g_assert_cmphex(w[0], ==, 0x01000004);
+    g_assert_true(gate_open(t->qts));
+    send_unsupported(t, uuid, id);
+    g_assert_true(gate_open(t->qts));
+    g_assert_cmpuint(cfg_read(t, 0, 1, 8, 0x39, &v), ==, PDF_READ);
+    g_assert_cmphex(v & 0x80000000, ==, 0x80000000);
+    g_assert_cmpuint(cfg_read(t, 1, 2, 0, 0, &v), ==, PDF_READ);
+    g_assert_cmphex(v, ==, 0x15d38086);
+
+    /* the firmware still has it approved: a rebind announces it so */
+    rings_stop(t);
+    g_assert_cmphex(mailbox(t, 0x07), ==, 0x07);
+    icm_bind(t, w);
+    n = icm_expect(t, PDF_ICM_EVENT, w);
+    g_assert_cmpuint(check_connected(w, n, 1, 0x0911, uuid), !=, id);
+    icm_expect_none(t);
+    t_stop(t);
+}
+
+/* T9: write the boot ACL with the first two words of each UUID given. */
+static void acl_write(T *t, const uint32_t *const *uuids, unsigned n)
+{
+    uint32_t w[64], cmd[33];
+
+    cmd[0] = 0x00008018;
+    for (unsigned i = 1; i < 33; i++) {
+        cmd[i] = 0xffffffff;
+    }
+    for (unsigned i = 0; i < n; i++) {
+        cmd[1 + 2 * i] = uuids[i][0];
+        cmd[2 + 2 * i] = uuids[i][1];
+    }
+    icm_cmd(t, cmd, 33);
+    g_assert_cmpuint(icm_expect(t, PDF_ICM_RESP, w), ==, 33);
+    g_assert_cmphex(w[0], ==, 0x01008018);
+}
+
+/*
+ * Machine reset, then bind again and check both announcements: route
+ * string, UUID, and link info with the approved and boot flags.
+ */
+static void reset_and_rebind(T *t, uint16_t info_a, uint16_t info_b,
+                             const uint32_t *uuid_a, const uint32_t *uuid_b)
+{
+    uint32_t w[64], uuid[4];
+    unsigned n;
+
+    qtest_qmp_assert_success(t->qts, "{'execute': 'system_reset'}");
+    qtest_qmp_eventwait(t->qts, "RESET");
+    /* the reset cleared the NHI's command register and BAR0 */
+    qpci_device_enable(t->dev);
+    t->bar = qpci_iomap(t->dev, 0, NULL);
+    icm_bind(t, w);
+    /* R12: adapter order, port A (route 1) before port B (route 3) */
+    n = icm_expect(t, PDF_ICM_EVENT, w);
+    check_connected(w, n, 1, info_a & ~0x400u, uuid);
+    g_assert_cmphex(w[7] >> 16, ==, info_a);
+    g_assert_cmpmem(uuid, 16, uuid_a, 16);
+    n = icm_expect(t, PDF_ICM_EVENT, w);
+    check_connected(w, n, 3, info_b & ~0x400u, uuid);
+    g_assert_cmphex(w[7] >> 16, ==, info_b);
+    g_assert_cmpmem(uuid, 16, uuid_b, 16);
+    icm_expect_none(t);
+}
+
+/*
+ * T9, T10 (R25, R26) on a 4C: a boot ACL written by the guest survives
+ * machine reset and decides, per port, which device the firmware
+ * approves at the next power-on, with the boot flag; the other port's
+ * tunnel stays down.
+ */
+static void test_reset_two_ports(void)
+{
+    uint32_t w[64], uuid_a[4], uuid_b[4];
+    const uint32_t *only_b[] = { uuid_b };
+    const uint32_t *both[] = { uuid_a, uuid_b };
+    unsigned n;
+    T *t = t_start2(",preboot=on,preboot-acl-only=on", true, true);
+
+    icm_bind(t, w);
+    n = icm_expect(t, PDF_ICM_EVENT, w);
+    check_connected(w, n, 1, 0x0811, uuid_a);
+    g_assert_cmphex(w[7] >> 16, ==, 0x0c11);
+    n = icm_expect(t, PDF_ICM_EVENT, w);
+    check_connected(w, n, 3, 0x0813, uuid_b);
+    g_assert_cmphex(w[7] >> 16, ==, 0x0c13);
+    g_assert_false(gate_open_at(t->qts, TP_PATH));
+    g_assert_false(gate_open_at(t->qts, TP1_PATH));
+
+    /* only port B's device in the ACL */
+    acl_write(t, only_b, 1);
+    reset_and_rebind(t, 0x0c11, 0x0d13, uuid_a, uuid_b);
+    g_assert_true(gate_open_at(t->qts, TP1_PATH));
+    g_assert_false(gate_open_at(t->qts, TP_PATH));
+
+    /* both devices: both pre-boot approved after the next reset */
+    acl_write(t, both, 2);
+    reset_and_rebind(t, 0x0d11, 0x0d13, uuid_a, uuid_b);
+    g_assert_true(gate_open_at(t->qts, TP_PATH));
+    g_assert_true(gate_open_at(t->qts, TP1_PATH));
+
+    /* the ACL itself survived both resets (R26) */
+    memset(w, 0, sizeof(w));
+    w[0] = 0x00000018;
+    icm_cmd(t, w, 33);
+    g_assert_cmpuint(icm_expect(t, PDF_ICM_RESP, w), ==, 33);
+    g_assert_cmphex(w[1], ==, uuid_a[0]);
+    g_assert_cmphex(w[2], ==, uuid_a[1]);
+    g_assert_cmphex(w[3], ==, uuid_b[0]);
+    g_assert_cmphex(w[4], ==, uuid_b[1]);
+    g_assert_cmphex(w[5], ==, 0xffffffff);
+    t_stop(t);
+}
+
+/* T11: the Titan Ridge switch and xHCI identities */
+static void test_switch_ids(void)
+{
+    QGuestAllocator alloc;
+    QTestState *qts = qtest_init("-machine pc "
+                                 "-device usb4-tr-pci-bridge,bus=pci.0,"
+                                 "addr=0x5,chassis_nr=1,shpc=off,msi=off "
+                                 "-device usb4-tr-tunnel-bridge,bus=pci.0,"
+                                 "addr=0x6,chassis_nr=2,msi=off "
+                                 "-device usb4-tr-xhci,bus=pci.0,addr=0x7,"
+                                 "msi=off,msix=off");
+    QPCIBus *bus;
+    const struct {
+        int slot;
+        uint16_t id;
+    } exp[] = { { 5, 0x15ea }, { 6, 0x15ea }, { 7, 0x15ec } };
+
+    pc_alloc_init(&alloc, qts, ALLOC_NO_FLAGS);
+    bus = qpci_new_pc(qts, &alloc);
+    for (int i = 0; i < ARRAY_SIZE(exp); i++) {
+        QPCIDevice *d = qpci_device_find(bus, QPCI_DEVFN(exp[i].slot, 0));
+
+        g_assert(d);
+        g_assert_cmphex(qpci_config_readw(d, PCI_VENDOR_ID), ==, 0x8086);
+        g_assert_cmphex(qpci_config_readw(d, PCI_DEVICE_ID), ==, exp[i].id);
+        g_assert_cmphex(qpci_config_readb(d, PCI_REVISION_ID), ==, 6);
+        g_assert_cmphex(qpci_config_readb(d, PCI_INTERRUPT_PIN), ==, 1);
+        g_free(d);
+    }
+    qpci_free_pc(bus);
+    alloc_destroy(&alloc);
+    qtest_quit(qts);
+}
+
+/* ---- T12: controller power with BIOS Assist, Titan Ridge switch ---- */
+
+#define RP_DEVFN            QPCI_DEVFN(0x1c, 0)
+
+static uint32_t cfg_rd(QTestState *qts, int bus, int devfn, int off)
+{
+    qtest_outl(qts, 0xcf8, 0x80000000 | (bus << 16) | (devfn << 8) | off);
+    return qtest_inl(qts, 0xcfc);
+}
+
+static void cfg_wr(QTestState *qts, int bus, int devfn, int off, uint32_t v)
+{
+    qtest_outl(qts, 0xcf8, 0x80000000 | (bus << 16) | (devfn << 8) | off);
+    qtest_outl(qts, 0xcfc, v);
+}
+
+static bool usp_visible(QTestState *qts)
+{
+    uint32_t id = cfg_rd(qts, 1, 0, 0);
+
+    g_assert(id == 0x15ea8086 || id == 0xffffffff);
+    return id == 0x15ea8086;
+}
+
+static void test_power(void)
+{
+    QTestState *qts = qtest_init(
+        "-machine q35 -global ICH9-LPC.acpi-pci-hotplug-with-bridge-"
+        "support=off -drive if=none,id=disk0,file=null-co://,format=raw "
+        "-device usb4-tunnel-port,id=tbrp,bus=pcie.0,addr=1c.0,chassis=1,"
+        "usb4-dvsec=off "
+        "-device usb4-tr-usp,id=tbusp,bus=tbrp "
+        "-device usb4-tr-dsp,id=tbd0,bus=tbusp,addr=0.0,chassis=2,slot=0 "
+        "-device usb4-tr-tunnel-dsp,id=tp0,bus=tbusp,addr=1.0,chassis=3,"
+        "slot=1 "
+        "-device usb4-tr-dsp,id=tbd2,bus=tbusp,addr=2.0,chassis=4,slot=2 "
+        "-device usb4-tr-tunnel-dsp,id=tp1,bus=tbusp,addr=4.0,chassis=5,"
+        "slot=4 "
+        "-device usb4-host,id=u4,bus=tbd0,tunnel-port=tp0,tunnel-port2=tp1,"
+        "profile=tb3-titan-ridge,bios-assist=on");
+
+    cfg_wr(qts, 0, RP_DEVFN, 0x18, 0x00060100);
+    /* Assist on, nothing attached: the controller is absent */
+    qtest_clock_step(qts, 1000 * 1000);
+    g_assert_false(usp_visible(qts));
+    /* a device on port B powers it up */
+    qtest_qmp_device_add(qts, "usb4-device", "d1",
+                         "{'bus': 'u4.0', 'port': 2, 'dialect': 'tb3', "
+                         "'drive': 'disk0'}");
+    qtest_clock_step(qts, 1000 * 1000);
+    g_assert_true(usp_visible(qts));
+    /* and its removal powers it down after the delay */
+    qtest_qmp_device_del_send(qts, "d1");
+    qtest_clock_step(qts, 40 * 1000 * 1000 * 1000LL);
+    g_assert_false(usp_visible(qts));
+    qtest_quit(qts);
+}
+
+/*
+ * The BIOS Assist machine with the Titan Ridge switch: the NHI at 3:0.0
+ * behind the root port, upstream port and DSP 2:0.0. @devices are the
+ * usb4-device options present at power-on (drives disk0 and disk1).
+ */
+static T *t_start_assist(const char *devices)
+{
+    T *t = g_new0(T, 1);
+    const uint32_t win = 0xe0f0e000;
+
+    t->qts = qtest_initf(
+        "-machine q35 -global ICH9-LPC.acpi-pci-hotplug-with-bridge-"
+        "support=off -drive if=none,id=disk0,file=null-co://,format=raw "
+        "-drive if=none,id=disk1,file=null-co://,format=raw "
+        "-device usb4-tunnel-port,id=tbrp,bus=pcie.0,addr=1c.0,chassis=1,"
+        "usb4-dvsec=off "
+        "-device usb4-tr-usp,id=tbusp,bus=tbrp "
+        "-device usb4-tr-dsp,id=tbd0,bus=tbusp,addr=0.0,chassis=2,slot=0 "
+        "-device usb4-tr-tunnel-dsp,id=tp0,bus=tbusp,addr=1.0,chassis=3,"
+        "slot=1 "
+        "-device usb4-tr-dsp,id=tbd2,bus=tbusp,addr=2.0,chassis=4,slot=2 "
+        "-device usb4-tr-tunnel-dsp,id=tp1,bus=tbusp,addr=4.0,chassis=5,"
+        "slot=4 "
+        "-device usb4-host,id=u4,bus=tbd0,tunnel-port=tp0,tunnel-port2=tp1,"
+        "profile=tb3-titan-ridge,bios-assist=on %s", devices);
+    cfg_wr(t->qts, 0, RP_DEVFN, 0x18, 0x00060100);
+    cfg_wr(t->qts, 0, RP_DEVFN, 0x20, win);
+    cfg_wr(t->qts, 0, RP_DEVFN, 0x04, 0x6);
+    cfg_wr(t->qts, 1, 0, 0x18, 0x00060201);
+    cfg_wr(t->qts, 1, 0, 0x20, win);
+    cfg_wr(t->qts, 1, 0, 0x04, 0x6);
+    cfg_wr(t->qts, 2, 0, 0x18, 0x00030302);
+    cfg_wr(t->qts, 2, 0, 0x20, win);
+    cfg_wr(t->qts, 2, 0, 0x04, 0x6);
+    pc_alloc_init(&t->alloc, t->qts, ALLOC_NO_FLAGS);
+    t->bus = qpci_new_pc(t->qts, &t->alloc);
+    t->dev = qpci_device_find(t->bus, 3 << 8);      /* bus 3, 0.0 */
+    g_assert(t->dev);
+    g_assert_cmphex(qpci_config_readw(t->dev, PCI_DEVICE_ID), ==, 0x15eb);
+    qpci_device_enable(t->dev);
+    t->bar = qpci_iomap(t->dev, 0, NULL);
+    return t;
+}
+
+/* Boot-ACL read (T3): answered with 33 words, or not at all. */
+static bool acl_read_answered(T *t)
+{
+    uint32_t w[64], cmd[33] = { 0x00000018 };
+    unsigned n = 0, pdf;
+
+    icm_cmd(t, cmd, 33);
+    pdf = icm_recv(t, w, &n);
+    if (!pdf) {
+        return false;
+    }
+    g_assert_cmpuint(pdf, ==, PDF_ICM_RESP);
+    g_assert_cmpuint(n, ==, 33);
+    return true;
+}
+
+/*
+ * R32 with the Titan Ridge switch (shared power model, inferred for
+ * Titan Ridge, ICM-TITAN-RIDGE.md 5): a device on port B at power-on.
+ * After the last unplug the firmware leaves commands unanswered until
+ * the controller powers off.
+ */
+static void test_assist_silence(void)
+{
+    uint32_t w[64];
+    T *t = t_start_assist("-device usb4-device,id=d1,bus=u4.0,port=2,"
+                          "dialect=tb3,drive=disk0");
+
+    icm_bind(t, w);
+    g_assert_cmpuint(icm_expect(t, PDF_ICM_EVENT, w), ==, 63);
+    g_assert_true(acl_read_answered(t));
+
+    /* T5: the disconnect event, then silence */
+    qtest_qmp_device_del_send(t->qts, "d1");
+    g_assert_cmpuint(icm_expect(t, PDF_ICM_EVENT, w), ==, 3);
+    g_assert_cmphex(w[2], ==, 3);
+    g_assert_false(acl_read_answered(t));
+    qtest_clock_step(t->qts, 10 * 1000 * 1000 * 1000LL);
+    icm_expect_none(t);
+    g_assert_true(usp_visible(t->qts));
+    qtest_clock_step(t->qts, 30 * 1000 * 1000 * 1000LL);
+    g_assert_false(usp_visible(t->qts));
+    t_stop(t);
+}
+
+/*
+ * R32 is about the last device: with devices on both ports, losing one
+ * of them keeps the controller powered and the firmware answering
+ * (the power model of ICM-PROTOCOL.md R27 counts every port). Only
+ * when the second one leaves does the silence start.
+ */
+static void test_assist_silence_two_ports(void)
+{
+    uint32_t w[64];
+    T *t = t_start_assist("-device usb4-device,id=d0,bus=u4.0,port=1,"
+                          "dialect=tb3,drive=disk0,serial=QTTR "
+                          "-device usb4-device,id=d1,bus=u4.0,port=2,"
+                          "dialect=tb3,drive=disk1,serial=QTTR2");
+
+    icm_bind(t, w);
+    g_assert_cmpuint(icm_expect(t, PDF_ICM_EVENT, w), ==, 63);
+    g_assert_cmpuint(icm_expect(t, PDF_ICM_EVENT, w), ==, 63);
+    icm_expect_none(t);
+    g_assert_true(acl_read_answered(t));
+
+    /* port B loses its device: event, and the firmware still answers */
+    qtest_qmp_device_del_send(t->qts, "d1");
+    g_assert_cmpuint(icm_expect(t, PDF_ICM_EVENT, w), ==, 3);
+    g_assert_cmphex(w[2], ==, 3);
+    g_assert_true(acl_read_answered(t));
+    /* no power-off either, well past the delay */
+    qtest_clock_step(t->qts, 40 * 1000 * 1000 * 1000LL);
+    g_assert_true(usp_visible(t->qts));
+    g_assert_true(acl_read_answered(t));
+
+    /* port A's device was the last one: now silent, then powered off */
+    qtest_qmp_device_del_send(t->qts, "d0");
+    g_assert_cmpuint(icm_expect(t, PDF_ICM_EVENT, w), ==, 3);
+    g_assert_cmphex(w[2], ==, 1);
+    g_assert_false(acl_read_answered(t));
+    g_assert_true(usp_visible(t->qts));
+    qtest_clock_step(t->qts, 40 * 1000 * 1000 * 1000LL);
+    g_assert_false(usp_visible(t->qts));
+    t_stop(t);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    qtest_add_func("/usb4-icm-tr/identity", test_identity);
+    qtest_add_func("/usb4-icm-tr/adapters", test_adapters);
+    qtest_add_func("/usb4-icm-tr/switch-ids", test_switch_ids);
+    qtest_add_func("/usb4-icm-tr/driver-ready", test_driver_ready);
+    qtest_add_func("/usb4-icm-tr/boot-acl", test_boot_acl);
+    qtest_add_func("/usb4-icm-tr/device-user", test_device_user);
+    qtest_add_func("/usb4-icm-tr/port2", test_port2);
+    qtest_add_func("/usb4-icm-tr/device-none", test_device_none);
+    qtest_add_func("/usb4-icm-tr/preboot", test_preboot);
+    qtest_add_func("/usb4-icm-tr/power", test_power);
+    qtest_add_func("/usb4-icm-tr/unsupported-full", test_unsupported_full);
+    qtest_add_func("/usb4-icm-tr/reset-two-ports", test_reset_two_ports);
+    qtest_add_func("/usb4-icm-tr/assist-silence", test_assist_silence);
+    qtest_add_func("/usb4-icm-tr/assist-silence-two-ports",
+                   test_assist_silence_two_ports);
+    return g_test_run();
+}
diff --git a/tests/qtest/usb4-root-hotplug-test.c b/tests/qtest/usb4-root-hotplug-test.c
new file mode 100644
index 0000000000000000000000000000000000000000..76471348e6cae9e75e7e719a538de695e4d679a8
--- /dev/null
+++ b/tests/qtest/usb4-root-hotplug-test.c
@@ -0,0 +1,857 @@
+/*
+ * QTest for the root-bus power domain of usb4-tunnel-bridge on i440FX:
+ * the Thunderbolt 3 tree leaves (surprise removal, controller power-off
+ * after R32) and comes back, with ACPI PCI hot-plug or the restore
+ * fallback (docs/ARCHITECTURE.md 4.4a)
+ *
+ * Copyright (c) 2026 usb4-emu contributors
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Written from scratch for the usb4-emu project. Timing of the Assist
+ * power-off from docs/ICM-PROTOCOL.md 13.4 (P14s with the ORICO:
+ * registers all-ones about 11 s after the departure, removal 15.4 s).
+ */
+
+#include "qemu/osdep.h"
+#include "libqtest.h"
+#include "libqos/fw_cfg.h"
+#include "qobject/qdict.h"
+
+#define RP_DEVFN        ((6 << 3) | 0)      /* root bridge tbrp at 00:06.0 */
+#define RP_PATH         "/machine/peripheral/tbrp"
+#define NHI_BAR         0xe0000000u
+#define FW_STS          0x39944
+#define FW_STS_VAL      0x800001a1u
+
+/* PIIX4 ACPI: GPE0 status and PCI hot-plug registers (acpi_pci_hotplug.rst) */
+#define GPE0_STS        0xafe0
+#define GPE_PCI_HP      0x02
+#define PCIHP_UP        0xae00
+#define PCIHP_DOWN      0xae04
+#define PCIHP_EJ        0xae08
+#define PCIHP_RMV       0xae0c
+#define PCIHP_SEL       0xae10
+#define SLOT_BIT        (1u << 6)
+
+#define SEC(n)          ((int64_t)((n) * 1e9))
+
+static uint32_t cfg_rd(QTestState *qts, int bus, int devfn, int off)
+{
+    qtest_outl(qts, 0xcf8, 0x80000000 | (bus << 16) | (devfn << 8) | off);
+    return qtest_inl(qts, 0xcfc);
+}
+
+static void cfg_wr(QTestState *qts, int bus, int devfn, int off, uint32_t v)
+{
+    qtest_outl(qts, 0xcf8, 0x80000000 | (bus << 16) | (devfn << 8) | off);
+    qtest_outl(qts, 0xcfc, v);
+}
+
+/*
+ * The captured topology on i440FX as scripts/run-win98.sh builds it
+ * (BIOS=OFF_OFF, ROOT_ADDR=6): root bridge 00:06.0, switch upstream
+ * port, NHI downstream port, tunnel bridge, xHCI downstream port.
+ */
+/* As start(), with @dev_opts for the device router d0 (NULL: none). */
+static QTestState *start_dev(const char *root_opts, const char *host_opts,
+                             const char *dev_opts)
+{
+    g_autofree char *dev = dev_opts ?
+        g_strdup_printf("-device usb4-device,id=d0,bus=u4.0,port=1,"
+                        "dialect=tb3,%s", dev_opts) : g_strdup("");
+
+    return qtest_initf(
+        "-machine pc "
+        "-global PIIX4_PM.acpi-pci-hotplug-with-bridge-support=off "
+        "-drive if=none,id=disk0,file=null-co://,format=raw "
+        "-drive if=none,id=disk1,file=null-co://,format=raw "
+        "-device usb4-tunnel-bridge,id=tbrp,bus=pci.0,addr=0x6,"
+        "chassis_nr=1,msi=off%s "
+        "-device usb4-tb3-pci-bridge,id=tbusp,bus=tbrp,addr=0x1,"
+        "chassis_nr=2,shpc=off,msi=off "
+        "-device usb4-tb3-pci-bridge,id=tbd0,bus=tbusp,addr=0x0,"
+        "chassis_nr=3,shpc=off,msi=off "
+        "-device usb4-tb3-tunnel-bridge,id=tb0,bus=tbusp,addr=0x1,"
+        "chassis_nr=4,shpc-autoenable=on,msi=off "
+        "-device usb4-tb3-pci-bridge,id=tbd2,bus=tbusp,addr=0x2,"
+        "chassis_nr=5,shpc=off,msi=off "
+        "-device usb4-host,id=u4,bus=tbd0,addr=0x0,tunnel-port=tb0,"
+        "msi=off,msix=off,profile=tb3-alpine-ridge%s %s",
+        root_opts, host_opts, dev);
+}
+
+static QTestState *start(const char *root_opts, const char *host_opts,
+                         bool dev)
+{
+    return start_dev(root_opts, host_opts, dev ? "drive=disk0" : NULL);
+}
+
+/*
+ * What firmware does at POST: buses 1 (switch upstream port), 2-5
+ * below it, the NHI at 3:0.0 with BAR0 at NHI_BAR, memory decode.
+ */
+static void configure(QTestState *qts)
+{
+    const uint32_t win = 0xe0f0e000;    /* 0xe0000000-0xe0ffffff */
+
+    cfg_wr(qts, 0, RP_DEVFN, 0x18, 0x00050100);
+    cfg_wr(qts, 0, RP_DEVFN, 0x20, win);
+    cfg_wr(qts, 0, RP_DEVFN, 0x04, 0x6);
+    cfg_wr(qts, 1, 0x08, 0x18, 0x00050201);
+    cfg_wr(qts, 1, 0x08, 0x20, win);
+    cfg_wr(qts, 1, 0x08, 0x04, 0x6);
+    cfg_wr(qts, 2, 0, 0x18, 0x00030302);
+    cfg_wr(qts, 2, 0, 0x20, win);
+    cfg_wr(qts, 2, 0, 0x04, 0x6);
+    g_assert_cmphex(cfg_rd(qts, 3, 0, 0), ==, 0x15bf8086);
+    cfg_wr(qts, 3, 0, 0x10, NHI_BAR);
+    cfg_wr(qts, 3, 0, 0x04, 0x6);
+    g_assert_cmphex(qtest_readl(qts, NHI_BAR + FW_STS), ==, FW_STS_VAL);
+}
+
+static bool root_visible(QTestState *qts)
+{
+    uint32_t id = cfg_rd(qts, 0, RP_DEVFN, 0);
+
+    g_assert(id == 0x00011b36 || id == 0xffffffff);
+    return id == 0x00011b36;
+}
+
+static bool nhi_alive(QTestState *qts)
+{
+    uint32_t v = qtest_readl(qts, NHI_BAR + FW_STS);
+
+    g_assert(v == FW_STS_VAL || v == 0xffffffff);
+    return v == FW_STS_VAL;
+}
+
+static void set_present(QTestState *qts, bool on)
+{
+    qtest_qmp_assert_success(qts, "{'execute': 'qom-set', 'arguments': "
+                             "{'path': %s, 'property': 'present', "
+                             "'value': %i}}", RP_PATH, on);
+}
+
+/* GPE0 PCI hot-plug status, cleared after reading */
+static bool gpe_take(QTestState *qts)
+{
+    bool set = qtest_inb(qts, GPE0_STS) & GPE_PCI_HP;
+
+    qtest_outb(qts, GPE0_STS, GPE_PCI_HP);
+    return set;
+}
+
+static uint32_t pcihp_rd(QTestState *qts, uint16_t reg)
+{
+    qtest_outl(qts, PCIHP_SEL, 0);      /* bus 0 */
+    return qtest_inl(qts, reg);
+}
+
+/* Wait for USB4_TUNNEL_ENDPOINT with the given stage. */
+static void wait_stage(QTestState *qts, const char *stage)
+{
+    for (;;) {
+        QDict *ev = qtest_qmp_eventwait_ref(qts, "USB4_TUNNEL_ENDPOINT");
+        QDict *data = qdict_get_qdict(ev, "data");
+        bool match = !strcmp(qdict_get_str(data, "stage"), stage);
+
+        qobject_unref(ev);
+        if (match) {
+            return;
+        }
+    }
+}
+
+/*
+ * Surprise removal (qom-set present false): the gate closes in the same
+ * QMP command, before the clock moves or a bottom half runs: the NHI's
+ * BAR and config space read all-ones. The root bridge (the PCH root
+ * port's stand-in) stays.
+ */
+static void test_surprise_gate(void)
+{
+    QTestState *qts = start(",root-hotplug=acpi", "", true);
+
+    configure(qts);
+    /* the slot is hot-pluggable in the ACPI description (RMV bit) */
+    g_assert_cmphex(pcihp_rd(qts, PCIHP_RMV) & SLOT_BIT, ==, SLOT_BIT);
+    gpe_take(qts);
+
+    set_present(qts, false);
+    g_assert_false(nhi_alive(qts));
+    g_assert_cmphex(cfg_rd(qts, 3, 0, 0), ==, 0xffffffff);
+    g_assert_cmphex(cfg_rd(qts, 1, 0x08, 0), ==, 0xffffffff);
+    g_assert_true(root_visible(qts));
+    /* writes are dropped: the BAR cannot be re-enabled */
+    cfg_wr(qts, 3, 0, 0x04, 0x6);
+    g_assert_false(nhi_alive(qts));
+    qtest_quit(qts);
+}
+
+/*
+ * The ACPI side: a notification on slot 6 (a Bus Check in the AML) from
+ * the bottom half (GPE status, PCIU bit) after the tree was reset; then
+ * a fresh arrival with its own notification, everything below the root
+ * bridge from reset (bus numbers 0, BAR 0).
+ */
+static void test_acpi_event_and_arrival(void)
+{
+    QTestState *qts = start(",root-hotplug=acpi", "", true);
+
+    configure(qts);
+    gpe_take(qts);
+    set_present(qts, false);
+    wait_stage(qts, "root-quiesced");
+    wait_stage(qts, "root-removal-notified");
+    g_assert_true(gpe_take(qts));
+    g_assert_cmphex(pcihp_rd(qts, PCIHP_UP) & SLOT_BIT, ==, SLOT_BIT);
+    g_assert_cmphex(pcihp_rd(qts, PCIHP_DOWN) & SLOT_BIT, ==, 0);
+    g_assert_true(root_visible(qts));
+    g_assert_cmphex(cfg_rd(qts, 1, 0x08, 0), ==, 0xffffffff);
+
+    /* nothing more while it is away */
+    qtest_clock_step(qts, SEC(30));
+    g_assert_false(gpe_take(qts));
+
+    set_present(qts, true);
+    wait_stage(qts, "root-arrived");
+    wait_stage(qts, "root-arrival-notified");
+    g_assert_true(gpe_take(qts));
+    g_assert_true(root_visible(qts));
+    /* fresh below the root bridge, which keeps its buses (a root port) */
+    g_assert_cmphex(cfg_rd(qts, 0, RP_DEVFN, 0x18), ==, 0x00050100);
+    g_assert_cmphex(cfg_rd(qts, 1, 0x08, 0), ==, 0x15c08086);
+    g_assert_cmphex(cfg_rd(qts, 1, 0x08, 0x18), ==, 0);
+    g_assert_cmphex(cfg_rd(qts, 1, 0x08, 0x04) & 0x7, ==, 0);
+    configure(qts);
+    g_assert_true(nhi_alive(qts));
+    qtest_quit(qts);
+}
+
+/*
+ * root-hotplug=restore: no ACPI event; the root bridge stays (a PCH
+ * root port does), the tree below reads all-ones, and on its return the
+ * configuration it had is written back, so the guest's driver finds the
+ * NHI where it was.
+ */
+static void test_restore(void)
+{
+    QTestState *qts = start(",root-hotplug=restore", "", true);
+
+    configure(qts);
+    gpe_take(qts);
+    g_assert_cmphex(pcihp_rd(qts, PCIHP_RMV) & SLOT_BIT, ==, 0);
+
+    set_present(qts, false);
+    g_assert_false(nhi_alive(qts));
+    g_assert_true(root_visible(qts));
+    wait_stage(qts, "root-quiesced");
+
+    set_present(qts, true);
+    wait_stage(qts, "root-arrived");
+    g_assert_false(gpe_take(qts));
+    g_assert_cmphex(cfg_rd(qts, 1, 0x08, 0x18), ==, 0x00050201);
+    g_assert_cmphex(cfg_rd(qts, 2, 0, 0x18), ==, 0x00030302);
+    g_assert_cmphex(cfg_rd(qts, 3, 0, 0x10) & ~0xfu, ==, NHI_BAR);
+    g_assert_cmphex(cfg_rd(qts, 3, 0, 0x04) & 0x7, ==, 0x6);
+    g_assert_true(nhi_alive(qts));
+    qtest_quit(qts);
+}
+
+/* root-hotplug=none (default): gate only, from reset on return. */
+static void test_none(void)
+{
+    QTestState *qts = start("", "", true);
+
+    configure(qts);
+    gpe_take(qts);
+    set_present(qts, false);
+    g_assert_false(nhi_alive(qts));
+    g_assert_true(root_visible(qts));
+    set_present(qts, true);
+    wait_stage(qts, "root-arrived");
+    g_assert_false(gpe_take(qts));
+    g_assert_cmphex(cfg_rd(qts, 1, 0x08, 0x18), ==, 0);
+    qtest_quit(qts);
+}
