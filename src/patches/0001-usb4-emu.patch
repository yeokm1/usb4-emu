+static void test_driver_ready(void)
+{
+    uint32_t w[64], cmd[2];
+    unsigned n;
+    T *t = t_start(",rtd3=on", false);
+
+    /* R8: byte-exact with the capture (T:2) when RTD3 is on */
+    icm_bind(t, w);
+    g_assert_cmphex(w[0], ==, 0x0100e203);
+    g_assert_cmphex(w[1], ==, 0x28010b60);
+    /* R6: RX ring 0 is status bit 12 with 12 rings; read clears */
+    wr(t, 0x37808, 0xffffffff);     /* explicit clear: ignored (R6) */
+    g_assert_cmphex(rd(t, ISR0) & (1u << 12), ==, 1u << 12);
+    g_assert_cmphex(rd(t, ISR0) & (1u << 12), ==, 0);
+    icm_expect_none(t);
+
+    /* a command with a bad CRC is dropped unanswered */
+    cmd[0] = 0x00000003;
+    tx_frame_crc(t, PDF_ICM_CMD, cmd, 1, true);
+    icm_expect_none(t);
+
+    /* R15: unsupported command answers with the error flag */
+    cmd[0] = 0x00000001;
+    icm_cmd(t, cmd, 1);
+    g_assert_cmpuint(icm_expect(t, PDF_ICM_RESP, w), >=, 1);
+    g_assert_cmphex(w[0], ==, 0x01000101);
+
+    /* R9: no device at link 1 */
+    cmd[0] = 0x0000000a;
+    cmd[1] = 0x00110000;
+    icm_cmd(t, cmd, 2);
+    n = icm_expect(t, PDF_ICM_RESP, w);
+    g_assert_cmpuint(n, ==, 4);
+    g_assert_cmphex(w[0], ==, 0x0100010a);
+    t_stop(t);
+
+    /* Default: RTD3 off, security user */
+    t = t_start(NULL, false);
+    icm_bind(t, w);
+    g_assert_cmphex(w[0], ==, 0x0100a203);
+    g_assert_cmphex(w[1], ==, 0x28010b60);
+    t_stop(t);
+
+    t = t_start(",security=none", false);
+    icm_bind(t, w);
+    g_assert_cmphex(w[1], ==, 0x28000b60);
+    t_stop(t);
+}
