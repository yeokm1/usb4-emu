+/* ---- 64-bit prefetchable window ---- */
+
+#define PREF64_MEM  0x100000000ull
+#define MTREE_PREF64_WIN "0000000100000000-00000001000fffff"
+
+/*
+ * A populated prefetchable window above 4 GiB (upper 32 base/limit bits
+ * set): forwarded while open, all-ones at the same 64-bit address once
+ * closed.
+ */
+static void test_window_pref64(void)
+{
+    g_autofree char *img = make_img();
+    QTestState *qts;
+
+    qts = qtest_initf("-machine q35 "
+                      "-global ICH9-LPC.acpi-pci-hotplug-with-bridge-support=off "
+                      "-drive if=none,id=disk0,file=%s,format=raw "
+                      "-device usb4-tunnel-port,id=tp0,bus=pcie.0,addr=0x3,"
+                      "chassis=1,nvme-drive=disk0,nvme-serial=QT1,"
+                      "settle-ms=200", img);
+    cfg_writel(qts, 0, TP_DEVFN, 0x18, 0x00010100);
+    cfg_writel(qts, 0, TP_DEVFN, find_exp_cap(qts) + 0x18, 0x0100);
+    /* Only the prefetchable window: 0x1_0000_0000-0x1_000f_ffff. */
+    cfg_writel(qts, 0, TP_DEVFN, 0x20, 0x0000fff0);
+    cfg_writel(qts, 0, TP_DEVFN, 0x24, 0x00000000);
+    cfg_writel(qts, 0, TP_DEVFN, 0x28, 1);
+    cfg_writel(qts, 0, TP_DEVFN, 0x2c, 1);
+    cfg_writel(qts, 0, TP_DEVFN, 0x04, 0x0006);
+    g_assert_cmphex(cfg_readl(qts, 0, TP_DEVFN, 0x24) & 0xf, ==, 1);
+    g_assert(mtree_enabled(qts, "usb4-tunnel-gate-ones-pref-mem",
+                           MTREE_PREF64_WIN));
+    g_assert(!mtree_enabled(qts, "usb4-tunnel-gate-ones-mem", NULL));
+    assert_all_ones(qts, PREF64_MEM);
+
+    set_tunnel(qts, "up");
+    g_assert_cmpuint(wait_stage(qts, "inserted"), ==, 1);
+    g_assert(!mtree_enabled(qts, "usb4-tunnel-gate-ones-pref-mem", NULL));
+    nvme_map(qts, 1, 0, PREF64_MEM);
+    g_assert_cmphex(qtest_readl(qts, PREF64_MEM + NVME_VS), !=, 0);
+    g_assert_cmphex(qtest_readl(qts, PREF64_MEM + NVME_VS), !=, 0xffffffff);
+    g_assert_cmphex(qtest_readl(qts, PREF64_MEM + NVME_CSTS), ==, 0);
+
+    set_hold(qts, true);
+    set_tunnel(qts, "surprise");
+    g_assert_cmpuint(wait_stage(qts, "gated"), ==, 1);
+    g_assert(mtree_enabled(qts, "usb4-tunnel-gate-ones-pref-mem",
+                           MTREE_PREF64_WIN));
+    g_assert_cmphex(qtest_readl(qts, PREF64_MEM + NVME_CSTS), ==,
+                    0xffffffff);
+    assert_all_ones(qts, PREF64_MEM);
+    /*
+     * The low 32 bits alone are not decoded. RAM hides address 0 from the
+     * CPU, so check the region's own placement, not the flat view.
+     */
+    g_assert(!mtree_enabled(qts, "usb4-tunnel-gate-ones-pref-mem",
+                            "0000000000000000-00000000000fffff"));
+    set_hold(qts, false);
+    g_assert_cmpuint(wait_stage(qts, "removed"), ==, 1);
+
+    qtest_quit(qts);
+    unlink(img);
+}
