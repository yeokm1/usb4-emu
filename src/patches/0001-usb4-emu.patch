+/*
+ * A function-level reset clears the harness's view of the controller:
+ * the RDY set delay restarts at the next enable.
+ */
+static void test_reset_shadow(void)
+{
+    g_autofree char *img = make_img();
+    Nv nv;
+    QTestState *qts = tp_start(img, ",x-rdy-set-delay-ms=1000", "", &nv);
+
+    nv_enable(&nv);
+    g_assert_cmphex(nv_csts(&nv) & 1, ==, 0);
+    qtest_clock_step(qts, 1000 * 1000 * 1000ll);
+    g_assert_cmphex(nv_csts(&nv) & 1, ==, 1);
+
+    ep_flr(qts);
+    g_assert_cmphex(qtest_readl(qts, WIN_MEM + NVME_CC), ==, 0);
+    nv_enable(&nv);
+    g_assert_cmphex(nv_csts(&nv) & 1, ==, 0);          /* delay restarted */
+    qtest_clock_step(qts, 999 * 1000 * 1000ll);
+    g_assert_cmphex(nv_csts(&nv) & 1, ==, 0);
+    qtest_clock_step(qts, 1000 * 1000);
+    g_assert_cmphex(nv_csts(&nv) & 1, ==, 1);
+    qtest_quit(qts);
+    unlink(img);
+}
