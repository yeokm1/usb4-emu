+/* T1: PCI identity and the shared BAR0 reset state */
+static void test_identity(void)
+{
+    T *t = t_start(NULL, false);
+    uint32_t v;
+
+    g_assert_cmphex(qpci_config_readw(t->dev, PCI_VENDOR_ID), ==, 0x8086);
+    g_assert_cmphex(qpci_config_readw(t->dev, PCI_DEVICE_ID), ==, 0x15eb);
+    g_assert_cmphex(qpci_config_readb(t->dev, PCI_REVISION_ID), ==, 6);
+    g_assert_cmphex(qpci_config_readl(t->dev, PCI_CLASS_REVISION) >> 8,
+                    ==, 0x088000);
+    g_assert_cmphex(qpci_config_readb(t->dev, PCI_INTERRUPT_PIN), ==, 1);
+    g_assert_cmphex(rd(t, HI_CAPS), ==, 0x0000000c);
+    g_assert_cmphex(rd(t, FW_STS), ==, 0x800001a1);
+    /* shared power-on values (T1; ICM-PROTOCOL.md 13.5 for AR) */
+    g_assert_cmphex(rd(t, OUTMAIL), ==, 0x800003f0);
+    g_assert_cmphex(rd(t, DMA_MISC), ==, 0x01000012);
+    g_assert_cmphex(mailbox(t, 0x23), ==, 0x23);
+    g_assert_cmphex(mailbox(t, 0x07), ==, 0x07);
+    g_assert_cmphex(mailbox(t, 0x42), ==, 0x40000042);
+
+    /* T8: host router 8086:15ea, upstream adapter 5, highest 11 */
+    rings_setup(t);
+    g_assert_cmpuint(cfg_read(t, 0, 2, 0, 0, &v), ==, PDF_READ);
+    g_assert_cmphex(v, ==, 0x15ea8086);
+    g_assert_cmpuint(cfg_read(t, 0, 2, 0, 1, &v), ==, PDF_READ);
+    g_assert_cmpuint((v >> 8) & 0x3f, ==, 5);
+    g_assert_cmpuint((v >> 14) & 0x3f, ==, 11);
+    t_stop(t);
+
+    /* 2C: ports=1 */
+    t = t_start(",ports=1", false);
+    g_assert_cmphex(qpci_config_readw(t->dev, PCI_DEVICE_ID), ==, 0x15e8);
+    rings_setup(t);
+    g_assert_cmpuint(cfg_read(t, 0, 2, 0, 0, &v), ==, PDF_READ);
+    g_assert_cmphex(v, ==, 0x15e78086);
+    t_stop(t);
+}
