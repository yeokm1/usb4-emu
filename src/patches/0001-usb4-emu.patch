+static void test_tb3_drom(void)
+{
+    /* Captured host EEPROM UID read (5.4): CRC-8 then UID */
+    static const uint8_t host_uid[9] = {
+        0x49, 0x00, 0x88, 0x50, 0x98, 0x15, 0xa6, 0x09, 0x01,
+    };
+    USB4Router r;
+
+    CHECK(usb4_drom_crc8(host_uid + 1, 8) == host_uid[0], "host UID CRC-8");
+    /* The builder reproduces the captured dock DROM byte for byte (R19) */
+    memset(&r, 0, sizeof(r));
+    r.uuid = 0x003d0efca0211100ULL;
+    r.drom_vendor_id = 0x3d;
+    r.drom_model_id = 0x11;
+    r.vendor_name = "CalDigit, Inc.";
+    r.model_name = "TS3 Plus";
+    usb4_drom_build_tb3(&r);
+    CHECK(r.drom_len == sizeof(dock_drom), "dock DROM length %zu",
+          r.drom_len);
+    CHECK(r.drom_len == sizeof(dock_drom) &&
+          !memcmp(r.drom, dock_drom, sizeof(dock_drom)), "dock DROM bytes");
+    g_free(r.drom);
+}
