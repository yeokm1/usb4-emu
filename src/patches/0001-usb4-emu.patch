+static void set_force_power(QTestState *qts, bool on)
+{
+    qtest_qmp_assert_success(qts, "{'execute': 'qom-set', 'arguments': "
+                             "{'path': '/machine/peripheral/u4', "
+                             "'property': 'force-power', 'value': %i}}", on);
+}
+
+/*
+ * R32 ends when the controller is wanted again: force power (R28) set
+ * during the silence keeps the controller and the firmware answers;
+ * clearing it again with nothing attached restarts the silence and the
+ * power-off delay. A host interface reset (Spec 12.6.3.1.3) during the
+ * silence resets the rings only, not the firmware: commands on the
+ * reprogrammed ring stay unanswered.
+ */
+static void test_assist_silence_recovery(void)
+{
+    uint32_t w[64];
+    T *t = t_start_assist(",bios-assist=on");
+
+    icm_bind(t, w);
+    g_assert_cmpuint(icm_expect_assist_event(t, w), ==, 61);
+    qtest_qmp_device_del_send(t->qts, "d0");
+    g_assert_cmpuint(icm_expect(t, PDF_ICM_EVENT, w), ==, 2);
+    g_assert_false(acl_read_answered(t));
+
+    /* host interface reset: rings to defaults, the firmware still silent */
+    wr(t, HI_RESET, 1);
+    g_assert_cmphex(rd(t, TX_CTRL(0)), ==, 0);
+    g_assert_cmphex(rd(t, RX_CTRL(0)), ==, 0);
+    g_assert_cmphex(rd(t, DMA_MISC), ==, 0x01000012);
+    rings_setup(t);
+    g_assert_false(acl_read_answered(t));
+    icm_expect_none(t);
+    g_assert_true(usp_visible(t->qts));
+
+    /* force power: answered again, and no power-off past the delay */
+    set_force_power(t->qts, true);
+    g_assert_true(acl_read_answered(t));
+    qtest_clock_step(t->qts, 40 * 1000 * 1000 * 1000LL);
+    g_assert_true(usp_visible(t->qts));
+    g_assert_true(acl_read_answered(t));
+
+    /* force power off with nothing attached: silent, then powered off */
+    set_force_power(t->qts, false);
+    g_assert_false(acl_read_answered(t));
+    qtest_clock_step(t->qts, 30 * 1000 * 1000 * 1000LL);
+    g_assert_true(usp_visible(t->qts));
+    g_assert_false(acl_read_answered(t));
+    qtest_clock_step(t->qts, 6 * 1000 * 1000 * 1000LL);
+    g_assert_false(usp_visible(t->qts));
+    t_stop(t);
+}
