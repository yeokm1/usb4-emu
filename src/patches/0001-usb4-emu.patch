+/* A drive is attached to no device (query-block). */
+static bool drive_free(QTestState *qts, const char *id)
+{
+    QDict *rsp = qtest_qmp(qts, "{'execute': 'query-block'}");
+    QList *l = qdict_get_qlist(rsp, "return");
+    QListEntry *e;
+    bool found = false, free = false;
+
+    QLIST_FOREACH_ENTRY(l, e) {
+        QDict *d = qobject_to(QDict, qlist_entry_obj(e));
+
+        if (!strcmp(qdict_get_str(d, "device"), id)) {
+            found = true;
+            free = !qdict_haskey(d, "qdev");
+        }
+    }
+    qobject_unref(rsp);
+    g_assert(found);
+    return free;
+}
+
+/*
+ * A bad namespace layout is refused before the endpoint exists: nothing
+ * is inserted and no drive stays attached.
+ */
+static void test_layout_errors(void)
+{
+    static const char *const bad[] = {
+        "\"nvme-namespaces=2:disk0;2:disk1\"",          /* NSID twice */
+        "\"nvme-namespaces=2:disk0;3:nodisk\"",         /* no such drive */
+        "drive=disk0,nvme-namespaces=1:disk1",          /* NSID 1 taken */
+        "\"nvme-namespaces=2:disk0;3:disk0\"",          /* drive twice */
+        "\"nvme-namespaces=2:disk0;5:disk1\",nvme-nn=4", /* above NN */
+    };
+    g_autofree char *img = make_img();
+    g_autofree char *img2 = make_img();
+    QTestState *qts;
+
+    for (int i = 0; i < ARRAY_SIZE(bad); i++) {
+        g_assert(!layout_start(&qts, img, img2, bad[i]));
+        g_assert(str_has(qts, TP_PATH, "endpoint", "none"));
+        g_assert_cmphex(cfg_readl(qts, 1, 0, 0), ==, 0xffffffff);
+        g_assert(drive_free(qts, "disk0"));
+        g_assert(drive_free(qts, "disk1"));
+        qtest_quit(qts);
+    }
+    /* A good one for comparison. */
+    g_assert(layout_start(&qts, img, img2,
+                          "\"nvme-namespaces=2:disk0;3:disk1\""));
+    g_assert(!drive_free(qts, "disk0"));
+    g_assert(!drive_free(qts, "disk1"));
+    qtest_quit(qts);
+    unlink(img);
+    unlink(img2);
+}
+
+/* The debug port's default range leaves the CS4231A at 0x534 alone. */
+static void test_debug_port_cs4231a(void)
+{
+    QTestState *qts = qtest_init("-machine pc -device cs4231a "
+                                 "-device usb4-debug-port");
+
+    g_assert_cmphex(qtest_inl(qts, DBG_PORT), ==, 0x42443455);
+    /* CS4231A index register: select MODE_And_ID, read the index back. */
+    qtest_outb(qts, 0x534, 0x0c);
+    g_assert_cmphex(qtest_inb(qts, 0x534), ==, 0x0c);
+    qtest_outl(qts, DBG_PORT, 7);
+    g_assert_cmphex(qtest_inb(qts, 0x534), ==, 0x0c);
+    qtest_quit(qts);
+}
+
+/*
+ * Exact-point stage actions: arm a fetch hold, so the next matching
+ * command is held after its doorbell but before it executes; and a
+ * controller reset completed before the stage write returns.
+ */
+static void test_stage_arm_reset(void)
+{
+    g_autofree char *img = make_img();
+    Nv nv;
+    QTestState *qts = tp_start(img, ",x-faults=\"at=fetch op=read act=hold "
+                               "tag=wb armed=off;at=stage code=0x22 act=arm "
+                               "tag=wb;at=stage code=0x23 "
+                               "act=reset-controller\"",
+                               "-device usb4-debug-port", &nv);
+    uint16_t cid;
+
+    nv_bringup(&nv);
+    /* Disarmed: the read runs. */
+    qtest_memset(qts, RAM_BUF, SENTINEL, 512);
+    cid = nv_read(&nv, 1, 0, RAM_BUF);
+    g_assert(nv_poll(&nv, 1, cid, NULL, NULL, 2000));
+    g_assert(str_has(qts, TP_PATH, "x-harness-state", "rule0=0/0:off"));
+
+    /* Armed by the stage write, before it returns. */
+    qtest_outl(qts, DBG_PORT, 0x22);
+    g_assert(str_has(qts, TP_PATH, "x-harness-state", "rule0=0/0 "));
+    qtest_memset(qts, RAM_BUF2, SENTINEL, 512);
+    nv_read(&nv, 1, 1, RAM_BUF2);
+    g_assert_cmpuint(held_count(qts), ==, 1);
+    g_assert(!nv_poll(&nv, 1, -1, NULL, NULL, 50));
+    g_assert(buf_is(qts, RAM_BUF2, SENTINEL));
+
+    /* Reset by the stage write: done when it returns. */
+    qtest_outl(qts, DBG_PORT, 0x23);
+    g_assert_cmphex(qtest_readl(qts, WIN_MEM + NVME_CC) & 1, ==, 0);
+    g_assert_cmphex(nv_csts(&nv) & 1, ==, 0);
+    g_assert_cmpuint(held_count(qts), ==, 0);
+    g_assert(!nv_poll(&nv, 1, -1, NULL, NULL, 50));
+    g_assert(buf_is(qts, RAM_BUF2, SENTINEL));
+
+    /* And the controller comes back up. */
+    nv_reg_init(&nv, qts, WIN_MEM);
+    nv.cid = 0x80;
+    nv_bringup(&nv);
+    qom_set_str(qts, TP_PATH, "x-faults", "");
+    cid = nv_read(&nv, 1, 1, RAM_BUF2);
+    g_assert(nv_poll(&nv, 1, cid, NULL, NULL, 2000));
+    g_assert(buf_is(qts, RAM_BUF2, PATTERN1));
+    qtest_quit(qts);
+    unlink(img);
+}
+
+/*
+ * Every arming restarts the count: a one-shot fetch hold re-armed by
+ * each stage write holds the next matching command each time, and only
+ * that one.
+ */
+static void test_rearm(void)
+{
+    g_autofree char *img = make_img();
+    Nv nv;
+    QTestState *qts = tp_start(img, ",x-faults=\"at=fetch op=read act=hold "
+                               "tag=wb armed=off;at=stage code=0x22 act=arm "
+                               "tag=wb repeat=on\"",
+                               "-device usb4-debug-port", &nv);
+    uint16_t cid;
+
+    nv_bringup(&nv);
+    for (int i = 0; i < 3; i++) {
+        qtest_outl(qts, DBG_PORT, 0x22);
+        qtest_memset(qts, RAM_BUF2, SENTINEL, 512);
+        cid = nv_read(&nv, 1, 1, RAM_BUF2);
+        g_assert_cmpuint(held_count(qts), ==, 1);
+        g_assert(!nv_poll(&nv, 1, -1, NULL, NULL, 20));
+        qom_set_str(qts, TP_PATH, "x-release", "tag:wb");
+        g_assert(nv_poll(&nv, 1, cid, NULL, NULL, 2000));
+        g_assert(buf_is(qts, RAM_BUF2, PATTERN1));
+
+        /* Spent until the next arming. */
+        cid = nv_read(&nv, 1, 0, RAM_BUF);
+        g_assert(nv_poll(&nv, 1, cid, NULL, NULL, 2000));
+        g_assert_cmpuint(held_count(qts), ==, 0);
+    }
+    qtest_quit(qts);
+    unlink(img);
+}
+
+/*
+ * The admin CQ placed at the endpoint's own BAR0: completions posted by
+ * a synchronous release (x-release) are DMA writes into its registers.
+ * The second CQE's Dword 1 would land on CC and reset the controller
+ * under the completion writer; the memory re-entrancy guard refuses them
+ * as for any completion, so the controller reports CFS and CC is intact.
+ */
+static void test_cq_at_bar0(void)
+{
+    g_autofree char *img = make_img();
+    Nv nv;
+    QTestState *qts = tp_start(img, ",nvme-drive=,x-faults=\"at=complete "
+                               "op=identify act=hold repeat=on tag=c\"", "",
+                               &nv);
+
+    qtest_memset(qts, RAM_ASQ, 0, 0x1000);
+    qtest_writel(qts, WIN_MEM + NVME_AQA, ((QSIZE - 1) << 16) | (QSIZE - 1));
+    qtest_writeq(qts, WIN_MEM + NVME_ASQ, RAM_ASQ);
+    qtest_writeq(qts, WIN_MEM + NVME_ACQ, WIN_MEM);
+    qtest_writel(qts, WIN_MEM + NVME_CC, NVME_CC_ON);
+    g_assert_cmphex(nv_csts(&nv), ==, 1);
+    nv_submit(&nv, 0, 0x06, 0, RAM_ID, 1, 0, 0);
+    nv_submit(&nv, 0, 0x06, 0, RAM_ID, 1, 0, 0);
+    g_assert_cmpuint(held_count(qts), ==, 2);
+
+    qom_set_str(qts, TP_PATH, "x-release", "tag:c");
+    g_assert_cmpuint(held_count(qts), ==, 0);
+    g_assert_cmphex(qtest_readl(qts, WIN_MEM + NVME_CC), ==, NVME_CC_ON);
+    g_assert_cmphex(nv_csts(&nv), ==, 0x2);     /* CFS (RDY is cleared) */
+    qtest_quit(qts);
+    unlink(img);
+}
+
+/*
+ * Work the harness defers to the slot's bottom half: a further CC write
+ * during a deferred disable (queued behind it), and act=reopen from a
+ * stage write with a release=reopen command held.
+ */
+static void test_deferred_work(void)
+{
+    g_autofree char *img = make_img();
+    Nv nv;
+    QTestState *qts = tp_start(img, ",x-faults=\"at=fetch op=read lba=0 "
+                               "act=hold release=rdy0-ack;at=fetch op=read "
+                               "lba=1 act=hold release=reopen;at=stage "
+                               "code=9 act=reopen\"",
+                               "-device usb4-debug-port", &nv);
+
+    nv_bringup(&nv);
+    qtest_memset(qts, RAM_BUF, SENTINEL, 512);
+    nv_read(&nv, 1, 0, RAM_BUF);
+    g_assert_cmpuint(held_count(qts), ==, 1);
+    /*
+     * CC.EN=0 deferred, then CC.EN=1 before the RDY=0 acknowledgement:
+     * both reach the controller in order and the held read, never
+     * acknowledged, goes with the reset.
+     */
+    qtest_writel(qts, WIN_MEM + NVME_CC, NVME_CC_ON & ~1);
+    g_assert(str_has(qts, TP_PATH, "x-harness-state", "defer=pending"));
+    qtest_writel(qts, WIN_MEM + NVME_CC, NVME_CC_ON);
+    g_assert_cmphex(qtest_readl(qts, WIN_MEM + NVME_CC), ==, NVME_CC_ON);
+    for (int i = 0; i < 2000 &&
+         !str_has(qts, TP_PATH, "x-harness-state", "defer=no"); i++) {
+        g_usleep(1000);
+    }
+    g_assert(str_has(qts, TP_PATH, "x-harness-state", "defer=no"));
+    g_assert_cmpuint(held_count(qts), ==, 0);
+    g_assert(buf_is(qts, RAM_BUF, SENTINEL));
+    /* Enabled again by the queued write. */
+    g_assert_cmphex(qtest_readl(qts, WIN_MEM + NVME_CC), ==, NVME_CC_ON);
+    g_assert_cmphex(nv_csts(&nv) & 1, ==, 1);
+
+    /* Reopen from a stage write runs the release=reopen command first. */
+    nv_reg_init(&nv, qts, WIN_MEM);
+    nv.cid = 0x20;
+    nv_bringup(&nv);
+    qtest_memset(qts, RAM_BUF2, SENTINEL, 512);
+    nv_read(&nv, 1, 1, RAM_BUF2);
+    qom_set_str(qts, TP_PATH, "x-gate", "closed");
+    qtest_outl(qts, DBG_PORT, 9);
+    g_assert(wait_buf(qts, RAM_BUF2, PATTERN1));
+    for (int i = 0; i < 2000 &&
+         !str_has(qts, TP_PATH, "x-gate", "normal"); i++) {
+        g_usleep(1000);
+    }
+    g_assert(str_has(qts, TP_PATH, "x-gate", "normal"));
+    g_assert(nv_peek(&nv, 1, -1, NULL, NULL));
+    g_assert_cmpuint(held_count(qts), ==, 0);
+    qtest_quit(qts);
+    unlink(img);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    qtest_add_func("/usb4-harness/fetch-surprise", test_fetch_surprise);
+    qtest_add_func("/usb4-harness/hold-drop-override",
+                   test_hold_drop_override);
+    qtest_add_func("/usb4-harness/reads-fail", test_reads_fail);
+    qtest_add_func("/usb4-harness/reopen-rdy0-ack", test_reopen_rdy0_ack);
+    qtest_add_func("/usb4-harness/reopen-release", test_reopen_release);
+    qtest_add_func("/usb4-harness/timing", test_timing);
+    qtest_add_func("/usb4-harness/lost-intx", test_lost_intx);
+    qtest_add_func("/usb4-harness/debug-port-q35", test_debug_port_q35);
+    qtest_add_func("/usb4-harness/debug-port-i440fx",
+                   test_debug_port_i440fx);
+    qtest_add_func("/usb4-harness/namespaces", test_namespaces);
+    qtest_add_func("/usb4-harness/measure-trace", test_measure_trace);
+    qtest_add_func("/usb4-harness/bad-rules", test_bad_rules);
+    qtest_add_func("/usb4-harness/unrealized-harness",
+                   test_unrealized_harness);
+    qtest_add_func("/usb4-harness/release-vs-surprise",
+                   test_release_vs_surprise);
+    qtest_add_func("/usb4-harness/reset-shadow", test_reset_shadow);
+    qtest_add_func("/usb4-harness/held-discarded", test_held_discarded);
+    qtest_add_func("/usb4-harness/token-isolation", test_token_isolation);
+    qtest_add_func("/usb4-harness/nn-enforced", test_nn_enforced);
+    qtest_add_func("/usb4-harness/layout-errors", test_layout_errors);
+    qtest_add_func("/usb4-harness/debug-port-cs4231a",
+                   test_debug_port_cs4231a);
+    qtest_add_func("/usb4-harness/stage-arm-reset", test_stage_arm_reset);
+    qtest_add_func("/usb4-harness/deferred-work", test_deferred_work);
+    qtest_add_func("/usb4-harness/rearm", test_rearm);
+    qtest_add_func("/usb4-harness/cq-at-bar0", test_cq_at_bar0);
+    qtest_add_func("/usb4-harness/nn-before-setup", test_nn_before_setup);
+    return g_test_run();
+}
diff --git a/tests/qtest/usb4-host-test.c b/tests/qtest/usb4-host-test.c
new file mode 100644
index 0000000000000000000000000000000000000000..10b70206fb44da3555fb16e3b14f44abb5b5e5d9
--- /dev/null
+++ b/tests/qtest/usb4-host-test.c
@@ -0,0 +1,1021 @@
+/*
+ * QTest for the usb4-host PCI function (USB4 host interface)
+ *
+ * Copyright (c) 2026 usb4-emu contributors
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Written from scratch for the usb4-emu project. Exercises the USB4
+ * Specification 2.0 chapter 12 host interface with x-loopback=on, where
+ * ring 0 transmit frames come back on ring 0 receive, so no fabric is
+ * needed.
+ */
+
+#include "qemu/osdep.h"
+#include "libqtest.h"
+#include "libqos/pci.h"
+#include "libqos/pci-pc.h"
+#include "libqos/malloc-pc.h"
+#include "hw/pci/pci_regs.h"
+#include "qobject/qdict.h"
+
+#define USB4_VENDOR          0x1b36
+#define USB4_DEVICE          0x00f4
+#define DEVFN                QPCI_DEVFN(4, 0)
+
+/* BAR0 registers, Spec 2.0 Table 12-10 */
+#define TX_RING(n)           (0x00000 + (n) * 0x10)
+#define RX_RING(n)           (0x08000 + (n) * 0x10)
+#define  RING_BASE_LO        0x0
+#define  RING_BASE_HI        0x4
+#define  RING_INDEX          0x8
+#define  RING_SIZE           0xc
+#define TX_CTRL(n)           (0x19800 + (n) * 0x20)
+#define RX_CTRL(n)           (0x29800 + (n) * 0x20)
+#define RING_VALID           (1u << 31)
+#define RING_RAW             (1u << 30)
+#define ISR0                 0x37800
+#define ISC0                 0x37808
+#define ISS0                 0x37810
+#define IMR0                 0x38200
+#define IMC0                 0x38208
+#define IMS0                 0x38210
+#define ITR0                 0x38c00
+#define IVAR0                0x38c40
+#define HI_CAPS              0x39640
+#define HI_RESET             0x39858
+#define HI_CONTROL           0x39864
+#define DISABLE_ISR_AUTOCLR  (1u << 17)
+
+#define PATHS                16
+#define CAUSE_TX0            (1u << 0)
+#define CAUSE_RX0            (1u << PATHS)
+
+#define DESC_DD              (1u << 21)
+#define DESC_RS              (1u << 22)
+#define DESC_IE              (1u << 23)
+
+#define BUF_SIZE             256
+
+typedef struct T {
+    QTestState *qts;
+    QPCIBus *bus;
+    QPCIDevice *dev;
+    QPCIBar bar;
+    QGuestAllocator alloc;
+    uint64_t tx_ring, rx_ring;
+    uint64_t tx_buf, rx_buf;
+    unsigned tx_size, rx_size;
+    unsigned tx_pi;          /* our producer index on TX */
+    unsigned rx_ci;          /* our consumer index (posted) on RX */
+    unsigned rx_next;        /* next RX descriptor we expect to complete */
+} T;
+
+static uint32_t rd(T *t, uint32_t off)
+{
+    return qpci_io_readl(t->dev, t->bar, off);
+}
+
+static void wr(T *t, uint32_t off, uint32_t v)
+{
+    qpci_io_writel(t->dev, t->bar, off, v);
+}
+
+static T *t_start(const char *machine, const char *extra)
+{
+    T *t = g_new0(T, 1);
+
+    t->qts = qtest_initf("-nodefaults -machine %s "
+                         "-device usb4-host,id=u4,x-loopback=on,addr=04.0%s",
+                         machine, extra ? extra : "");
+    pc_alloc_init(&t->alloc, t->qts, ALLOC_NO_FLAGS);
+    t->bus = qpci_new_pc(t->qts, &t->alloc);
+    t->dev = qpci_device_find(t->bus, DEVFN);
+    g_assert(t->dev);
+    qpci_device_enable(t->dev);
+    t->bar = qpci_iomap(t->dev, 0, NULL);
+    return t;
+}
+
+static void t_stop(T *t)
+{
+    g_free(t->dev);
+    qpci_free_pc(t->bus);
+    alloc_destroy(&t->alloc);
+    qtest_quit(t->qts);
+    g_free(t);
+}
+
+static void desc_write(T *t, uint64_t ring, unsigned i, uint64_t addr,
+                       uint32_t dw2)
+{
+    uint64_t d = ring + i * 16;
+
+    qtest_writel(t->qts, d, (uint32_t)addr);
+    qtest_writel(t->qts, d + 4, addr >> 32);
+    qtest_writel(t->qts, d + 8, dw2);
+    qtest_writel(t->qts, d + 12, 0);
+}
+
+static uint32_t desc_dw2(T *t, uint64_t ring, unsigned i)
+{
+    return qtest_readl(t->qts, ring + i * 16 + 8);
+}
+
+/* Program ring 0 in both directions (raw mode) and enable it. */
+static void rings_setup(T *t, unsigned tx_size, unsigned rx_size)
+{
+    t->tx_size = tx_size;
+    t->rx_size = rx_size;
+    t->tx_ring = guest_alloc(&t->alloc, tx_size * 16);
+    t->rx_ring = guest_alloc(&t->alloc, rx_size * 16);
+    t->tx_buf = guest_alloc(&t->alloc, tx_size * BUF_SIZE);
+    t->rx_buf = guest_alloc(&t->alloc, rx_size * BUF_SIZE);
+    t->tx_pi = t->rx_ci = t->rx_next = 0;
+
+    wr(t, TX_RING(0) + RING_BASE_LO, (uint32_t)t->tx_ring);
+    wr(t, TX_RING(0) + RING_BASE_HI, t->tx_ring >> 32);
+    wr(t, TX_RING(0) + RING_SIZE, tx_size);
+    wr(t, TX_CTRL(0), RING_VALID | RING_RAW);
+
+    wr(t, RX_RING(0) + RING_BASE_LO, (uint32_t)t->rx_ring);
+    wr(t, RX_RING(0) + RING_BASE_HI, t->rx_ring >> 32);
+    wr(t, RX_RING(0) + RING_SIZE, rx_size | (BUF_SIZE << 16));
+    wr(t, RX_CTRL(0), RING_VALID | RING_RAW);
+}
+
+/* Post @n more RX descriptors (Spec Table 12-24 consumer index). */
+static void rx_post(T *t, unsigned n)
+{
+    while (n--) {
+        unsigned i = t->rx_ci;
+
+        desc_write(t, t->rx_ring, i, t->rx_buf + i * BUF_SIZE,
+                   DESC_RS | DESC_IE);
+        t->rx_ci = (t->rx_ci + 1) % t->rx_size;
+    }
+    wr(t, RX_RING(0) + RING_INDEX, t->rx_ci);
+}
+
+/* Queue one TX frame whose DWs are seed, seed+1, ... without ringing. */
+static void tx_queue(T *t, uint32_t seed, unsigned len, unsigned pdf)
+{
+    unsigned i = t->tx_pi;
+    uint64_t b = t->tx_buf + i * BUF_SIZE;
+    unsigned k;
+
+    for (k = 0; k < len / 4; k++) {
+        qtest_writel(t->qts, b + k * 4, seed + k);
+    }
+    desc_write(t, t->tx_ring, i, b,
+               len | (pdf << 12) | DESC_RS | DESC_IE);
+    t->tx_pi = (t->tx_pi + 1) % t->tx_size;
+}
+
+static void tx_doorbell(T *t)
+{
+    wr(t, TX_RING(0) + RING_INDEX, t->tx_pi << 16);
+}
+
+/* Check the next RX completion carries the frame from tx_queue(seed). */
+static void rx_expect(T *t, uint32_t seed, unsigned len, unsigned pdf)
+{
+    unsigned i = t->rx_next;
+    uint32_t dw2 = desc_dw2(t, t->rx_ring, i);
+    unsigned k;
+
+    g_assert_cmphex(dw2 & DESC_DD, ==, DESC_DD);
+    g_assert_cmpuint(dw2 & 0xfff, ==, len);
+    g_assert_cmpuint((dw2 >> 12) & 0xf, ==, pdf);
+    g_assert_cmpuint((dw2 >> 16) & 0xf, ==, 0);      /* raw: SOF 0 */
+    g_assert_cmphex(dw2 & (1u << 22), ==, 0);         /* no overflow */
+    for (k = 0; k < len / 4; k++) {
+        g_assert_cmphex(qtest_readl(t->qts, t->rx_buf + i * BUF_SIZE + k * 4),
+                        ==, seed + k);
+    }
+    t->rx_next = (t->rx_next + 1) % t->rx_size;
+}
+
+/* ISR DW0 holds the TX and RX data buffer causes (16 + 16 paths). */
+static uint32_t isr0(T *t)
+{
+    return rd(t, ISR0);
+}
+
+static unsigned rx_pi(T *t)
+{
+    return rd(t, RX_RING(0) + RING_INDEX) >> 16;
+}
+
+static unsigned tx_ci(T *t)
+{
+    return rd(t, TX_RING(0) + RING_INDEX) & 0xffff;
+}
+
+/* ------------------------------------------------------------------ */
+
+static void test_identity(void)
+{
+    T *t = t_start("pc", NULL);
+    uint64_t barsize;
+    uint32_t bar0;
+
+    g_assert_cmphex(qpci_config_readw(t->dev, PCI_VENDOR_ID), ==,
+                    USB4_VENDOR);
+    g_assert_cmphex(qpci_config_readw(t->dev, PCI_DEVICE_ID), ==,
+                    USB4_DEVICE);
+    /* Spec 12.6: class code 0C 03 40h */
+    g_assert_cmphex(qpci_config_readb(t->dev, PCI_CLASS_PROG), ==, 0x40);
+    g_assert_cmphex(qpci_config_readw(t->dev, PCI_CLASS_DEVICE), ==, 0x0c03);
+    g_assert_cmphex(qpci_config_readb(t->dev, PCI_INTERRUPT_PIN), ==, 1);
+
+    /* BAR0: 32-bit non-prefetchable memory */
+    bar0 = qpci_config_readl(t->dev, PCI_BASE_ADDRESS_0);
+    g_assert_cmphex(bar0 & 0xf, ==, 0);
+    qpci_iounmap(t->dev, t->bar);
+    t->bar = qpci_iomap(t->dev, 0, &barsize);
+    g_assert_cmphex(barsize, ==, 0x40000);
+
+    g_assert(qpci_find_capability(t->dev, PCI_CAP_ID_PM, 0));
+    g_assert(qpci_find_capability(t->dev, PCI_CAP_ID_MSI, 0));
+    g_assert(qpci_find_capability(t->dev, PCI_CAP_ID_MSIX, 0));
+    /* Conventional PCI bus: no PCIe capability */
+    g_assert(!qpci_find_capability(t->dev, PCI_CAP_ID_EXP, 0));
+
+    /* Spec Table 12-11: Total Paths, version */
+    g_assert_cmphex(rd(t, HI_CAPS) & 0x7ff, ==, PATHS);
+    t_stop(t);
+}
