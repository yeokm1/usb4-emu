diff --git a/hw/acpi/pcihp.c b/hw/acpi/pcihp.c
index 87162ff2c0b15c7045c3344a37c53d528489fb6f..23f0ae1d5d91e8e2949c2e2d2301032006a54b8f 100644
--- a/hw/acpi/pcihp.c
+++ b/hw/acpi/pcihp.c
@@ -160,9 +160,37 @@ static PCIBus *acpi_pcihp_find_hotplug_bus(AcpiPciHpState *s, int bsel)
     return find.bus;
 }
 
+/*
+ * Every initialised hot-plug state, to find the one serving a slot owner
+ * (acpi_pcihp_slot_owner_notify()).
+ */
+static GSList *acpi_pcihp_states;
+
+/*
+ * @dev is a slot owner that wants its slot hot-pluggable and can have
+ * it: the hot-plug description covers function 0 only, so an owner at
+ * another function is handled as any other cold-plugged device
+ * everywhere (AML, RMV, eject), and keeps its static acpi-index _DSM.
+ */
+static bool acpi_pcihp_is_slot_owner(const PCIDevice *dev)
+{
+    AcpiPciHpSlotOwnerClass *oc;
+
+    if (!dev || PCI_FUNC(dev->devfn) != 0 ||
+        !object_dynamic_cast(OBJECT(dev), TYPE_ACPI_PCIHP_SLOT_OWNER)) {
+        return false;
+    }
+    oc = ACPI_PCIHP_SLOT_OWNER_GET_CLASS(dev);
+    return oc->hotpluggable && oc->hotpluggable((PCIDevice *)dev);
+}
+
 static bool acpi_pcihp_pc_no_hotplug(AcpiPciHpState *s, PCIDevice *dev)
 {
     DeviceClass *dc = DEVICE_GET_CLASS(dev);
+
+    if (acpi_pcihp_is_slot_owner(dev)) {
+        return false;
+    }
     /*
      * ACPI doesn't allow hotplug of bridge devices.  Don't allow
      * hot-unplug of bridge devices unless they were added by hotplug
@@ -196,7 +224,10 @@ static void acpi_pcihp_eject_slot(AcpiPciHpState *s, unsigned bsel, unsigned slo
         DeviceState *qdev = kid->child;
         PCIDevice *dev = PCI_DEVICE(qdev);
         if (PCI_SLOT(dev->devfn) == slot) {
-            if (!acpi_pcihp_pc_no_hotplug(s, dev)) {
+            if (acpi_pcihp_is_slot_owner(dev)) {
+                /* A slot owner stays realized; it handles the eject. */
+                ACPI_PCIHP_SLOT_OWNER_GET_CLASS(dev)->ejected(dev);
+            } else if (!acpi_pcihp_pc_no_hotplug(s, dev)) {
                 /*
                  * partially_hotplugged is used by virtio-net failover:
                  * failover has asked the guest OS to unplug the device
@@ -367,6 +398,57 @@ void acpi_pcihp_device_unplug_request_cb(HotplugHandler *hotplug_dev,
     acpi_send_event(DEVICE(hotplug_dev), ACPI_PCI_HOTPLUG_STATUS);
 }
 
+/* The hot-plug state serving the slot of @dev, or NULL. */
+static AcpiPciHpState *acpi_pcihp_state_of(PCIDevice *dev, int *bsel)
+{
+    PCIBus *root = pci_device_root_bus(dev);
+    GSList *l;
+
+    *bsel = acpi_pcihp_get_bsel(pci_get_bus(dev));
+    if (*bsel < 0) {
+        return NULL;
+    }
+    for (l = acpi_pcihp_states; l; l = l->next) {
+        AcpiPciHpState *s = l->data;
+
+        if (s->root == root) {
+            return s;
+        }
+    }
+    return NULL;
+}
+
+bool acpi_pcihp_slot_owner_has_hotplug(PCIDevice *dev)
+{
