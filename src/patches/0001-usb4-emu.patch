+    qtest_outl(qts, DBG_PORT + 8, 0x89abcdef);
+    qtest_outl(qts, DBG_PORT + 12, 0x01234567);
+    g_assert(str_has(qts, "/machine/peripheral/dbg", "counts",
+                     "stages=2 markers=1"));
+    qtest_quit(qts);
+    unlink(img);
+}
