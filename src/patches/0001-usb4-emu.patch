+/*
+ * A namespace above x-nn is refused before it is set up: a zoned one
+ * (whose setup allocates the zone arrays) repeatedly, and one whose zone
+ * geometry is invalid too reports NN, not the geometry. A valid
+ * namespace still attaches afterwards.
+ */
+static void test_nn_before_setup(void)
+{
+    g_autofree char *img = make_img();
+    g_autofree char *img2 = make_img();
+    g_autofree char *drive1 = g_strdup_printf("-drive if=none,id=disk1,"
+                                              "file=%s,format=raw", img2);
+    Nv nv;
+    QTestState *qts;
+    uint32_t list[4];
+
+    qts = tp_start(img, ",nvme-drive=,nvme-namespaces=2:disk0,nvme-nn=4",
+                   drive1, &nv);
+    for (int i = 0; i < 8; i++) {
+        g_autofree char *err = ns_add(qts, "'nsid': 5, 'zoned': true, "
+                                      "'zoned.zone_size': 65536");
+
+        g_assert(err && strstr(err, "Number of Namespaces"));
+    }
+    {
+        /* The default zone size does not fit the 1 MiB drive. */
+        g_autofree char *err = ns_add(qts, "'nsid': 6, 'zoned': true");
+
+        g_assert(err && strstr(err, "Number of Namespaces"));
+    }
+    g_assert(drive_free(qts, "disk1"));
+    g_assert_null(ns_add(qts, "'id': 'ns3', 'nsid': 3"));
+
+    nv_bringup(&nv);
+    nv_admin_ok(&nv, 0x06, 0, RAM_ID, 2, 0);
+    qtest_memread(qts, RAM_ID, list, sizeof(list));
+    g_assert_cmpuint(list[0], ==, 2);
+    g_assert_cmpuint(list[1], ==, 3);
+    g_assert_cmpuint(list[2], ==, 0);
+    qtest_quit(qts);
+    unlink(img);
+    unlink(img2);
+}
