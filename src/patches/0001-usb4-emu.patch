+/*
+ * Titan Ridge host routers (docs/ICM-TITAN-RIDGE.md 4, inferred): 4C with
+ * two ports, 2C with one; adapter numbers, router ID and host DROM.
+ */
+static void test_tb3_tr(void)
+{
+    static const struct { unsigned adp; USB4AdpKind kind; unsigned port; }
+    exp[] = {
+        { 5, USB4_ADP_HI, 0 }, { 6, USB4_ADP_NONE, 0 },
+        { 7, USB4_ADP_NONE, 0 }, { 8, USB4_ADP_PCIE_DOWN, 1 },
+        { 9, USB4_ADP_PCIE_DOWN, 2 }, { 10, USB4_ADP_DP_IN, 0 },
+        { 11, USB4_ADP_DP_IN, 0 },
+    };
+    USB4Fabric *saved = fab;
+
+    for (int four = 1; four >= 0; four--) {
+        USB4FabricConfig cfg = {
+            .profile = USB4_PROFILE_TB3_ALPINE_RIDGE,
+            .dialect = USB4_DIALECT_TB3,
+            .router_vendor_id = 0x8086,
+            .router_device_id = four ? 0x15ea : 0x15e7,
+            .num_usb4_ports = 2,
+            .tb3_host = four ? USB4_TB3_HOST_TR_4C : USB4_TB3_HOST_TR_2C,
+        };
+        USB4Router *hr;
+        const uint8_t *d;
+
+        fab = usb4_fabric_new((USB4Host *)&fake_host, &cfg);
+        hr = fab->hr;
+        rx_flush_hp();
+        CHECK(hr->nports == (four ? 2 : 1) &&
+              fab->cfg.num_usb4_ports == hr->nports, "TR ports (4C %d)", four);
+        CHECK(hr->max_adapter == 11 && hr->upstream_adapter == 5,
+              "TR max adapter / upstream adapter");
+        CHECK(rd1(HOST, USB4_CS_ROUTER, 0, 0) ==
+              (four ? 0x15ea8086u : 0x15e78086u), "TR router ID");
+        CHECK(((rd1(HOST, USB4_CS_ROUTER, 0, 1) >> 8) & 0x3f) == 5,
+              "TR router header upstream adapter");
+        for (unsigned i = 0; i < ARRAY_SIZE(exp); i++) {
+            bool b = exp[i].port == 2 || exp[i].adp == 11;
+            USB4AdpKind k = (!four && b) ? USB4_ADP_NONE : exp[i].kind;
+
+            CHECK(hr->adp[exp[i].adp].kind == k &&
+                  (k == USB4_ADP_NONE ||
+                   hr->adp[exp[i].adp].usb4_port == exp[i].port),
+                  "TR adapter %u kind (4C %d)", exp[i].adp, four);
+        }
+        CHECK(usb4_router_find_kind(hr, USB4_ADP_PCIE_DOWN, 1) == &hr->adp[8],
+              "TR port A PCIe Down 8");
+        CHECK((hr->adp[3].kind == USB4_ADP_LANE &&
+               hr->adp[4].kind == USB4_ADP_LANE) == four, "TR port B lanes");
+        /* host DROM: valid CRC, port B entries disabled on 2C */
+        d = hr->drom;
+        CHECK((d[9] | d[10] << 8 | d[11] << 16 | (uint32_t)d[12] << 24) ==
+              usb4_drom_crc32(d + 13, hr->drom_len - 13), "TR DROM CRC");
+        CHECK(d[22 + 17] == (four ? 0x83 : 0xc3) &&
+              d[22 + 42] == (four ? 0x89 : 0xc9), "TR DROM port B entries");
+        usb4_fabric_free(fab);
+    }
+    fab = saved;
+}
