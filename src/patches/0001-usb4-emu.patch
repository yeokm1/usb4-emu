+/* device_add an nvme-ns with @props; NULL if it worked, else its error. */
+static char *ns_add(QTestState *qts, const char *props)
+{
+    g_autofree char *cmd = g_strdup_printf(
+        "{'execute': 'device_add', 'arguments': {'driver': 'nvme-ns', "
+        "'bus': 'tp0-nvme1', 'drive': 'disk1', %s}}", props);
+    QDict *rsp = qtest_qmp(qts, cmd);
