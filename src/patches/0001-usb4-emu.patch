+/* ---- dock mode (usb4-device dock=on behind usb4-tunnel-port) ---- */
+
+/* Program bus numbers and check the dock's tree is visible. */
+static void dock_check_tree(QTestState *qts)
+{
+    static const uint32_t ids[] = { 0x00101b36, 0x10d38086, 0x000d1b36 };
+    int i;
+
+    /* Upstream switch port (bus 1 dev 0): secondary 2, subordinate 5. */
+    g_assert_cmphex(cfg_readl(qts, 1, 0, 0), ==, 0x8232104c);
+    cfg_writel(qts, 1, 0, 0x18, 0x00050201);
+    for (i = 0; i < 3; i++) {
+        /* Downstream port i: secondary/subordinate 3 + i. */
+        g_assert_cmphex(cfg_readl(qts, 2, i << 3, 0), ==, 0x8233104c);
+        cfg_writel(qts, 2, i << 3, 0x18, 0x00000002 | ((3 + i) << 8) |
+                   ((3 + i) << 16));
+        g_assert_cmphex(cfg_readl(qts, 3 + i, 0, 0), ==, ids[i]);
+    }
+}
+
+static void test_dock(void)
+{
+    g_autofree char *img = make_img();
+    g_autofree char *uimg = make_img();
+    QTestState *qts;
+    char *st;
+    int i;
+
+    qts = qtest_initf("-machine q35 "
+                      "-global ICH9-LPC.acpi-pci-hotplug-with-bridge-support=off "
+                      "-drive if=none,id=disk0,file=%s,format=raw "
+                      "-blockdev driver=file,node-name=usbdisk,filename=%s "
+                      "-netdev user,id=dnet,restrict=on "
+                      "-device usb4-tunnel-port,id=tp0,bus=pcie.0,addr=0x3,"
+                      "chassis=1,settle-ms=200 "
+                      "-device usb4-host,id=u4,bus=pcie.0,addr=0x4,"
+                      "tunnel-port=tp0 "
+                      "-device usb4-device,id=dock0,bus=u4.0,port=1,dock=on,"
+                      "drive=disk0,serial=QTD,nic-netdev=dnet,"
+                      "usb-drive=usbdisk", img, uimg);
+
+    /* Root port: secondary 1, subordinate 5; slot powered on. */
+    cfg_writel(qts, 0, TP_DEVFN, 0x18, 0x00050100);
+    cfg_writel(qts, 0, TP_DEVFN, find_exp_cap(qts) + 0x18, 0x0100);
+
+    set_tunnel(qts, "up");
+    g_assert_cmpuint(wait_stage(qts, "inserted"), ==, 1);
+    dock_check_tree(qts);
+    st = endpoint_state(qts);
+    g_assert(g_str_has_prefix(st, "live"));
+    g_free(st);
+
+    /*
+     * Down with the deferred stages held: the gate on the tunnel port's
+     * secondary bus also closes config access to every bus below the
+     * switch.
+     */
+    set_hold(qts, true);
+    set_tunnel(qts, "down");
+    g_assert_cmpuint(wait_stage(qts, "gated"), ==, 1);
+    g_assert_cmphex(cfg_readl(qts, 1, 0, 0), ==, 0xffffffff);
+    for (i = 0; i < 3; i++) {
+        g_assert_cmphex(cfg_readl(qts, 2, i << 3, 0), ==, 0xffffffff);
+        g_assert_cmphex(cfg_readl(qts, 3 + i, 0, 0), ==, 0xffffffff);
+        cfg_writel(qts, 3 + i, 0, 4, 0x6);      /* dropped */
+    }
+
+    /* Admin-down is a surprise removal: the whole tree goes. */
+    set_hold(qts, false);
+    g_assert_cmpuint(wait_stage(qts, "cutoff"), ==, 1);
+    g_assert_cmpuint(wait_stage(qts, "removed"), ==, 1);
+    g_assert(!peripheral_exists(qts, "tp0-dock1-nvme"));
+    g_assert(!peripheral_exists(qts, "tp0-dock1-usb"));
+
+    /* Up again: a fresh dock, with the same drives and netdev. */
+    set_tunnel(qts, "up");
+    qtest_clock_step(qts, 300 * 1000 * 1000);   /* past settle-ms */
+    g_assert_cmpuint(wait_stage(qts, "inserted"), ==, 2);
+    dock_check_tree(qts);
+    g_assert(peripheral_exists(qts, "tp0-dock2-usb"));
+    for (i = 0; i < 3; i++) {
+        g_assert_cmphex(cfg_readl(qts, 3 + i, 0, 4) & 0x6, ==, 0);
+    }
+
+    set_tunnel(qts, "surprise");
+    g_assert_cmpuint(wait_stage(qts, "removed"), ==, 2);
+    qtest_quit(qts);
+    unlink(img);
+    unlink(uimg);
+}
