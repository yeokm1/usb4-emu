+/*
+ * A firmware CM tunnel that is up once the fabric has been reset
+ * (pre-boot or security none, R22, R25), including one built before its
+ * tunnel target existed, gets its endpoint as a cold insertion before
+ * guest firmware enumerates PCI (review 2 #5, #6). It runs after the
+ * machine reset has completed and before the CPUs run again: devices
+ * may not be realized inside a reset phase.
+ */
+static void usb4_host_reconcile_tunnels(Notifier *n, void *data)
+{
+    USB4Host *s = container_of(n, USB4Host, post_reset);
+
+    /*
+     * R33: the power-on decided which devices run in USB mode. Their USB
+     * device is settled first: one leaving USB mode frees the drive for
+     * a pre-boot tunnel's endpoint below.
+     */
+    if (s->usb_bh) {
+        qemu_bh_cancel(s->usb_bh);
+        timer_del(s->usb_retry);
+        for (unsigned p = 1; p <= s->num_ports; p++) {
+            s->usb_tries[p] = 0;
+        }
+        usb4_host_usb_reconcile(s);
+    }
+    /* An Alpine Ridge controller switched off has no tunnels (R27). */
+    if (!s->fabric || (s->power_on_bh && !s->powered)) {
+        return;
+    }
+    for (unsigned p = 1; p <= s->num_ports; p++) {
+        USB4TunnelPort *tp = usb4_host_get_port_tunnel(s, p);
+
+        if (tp && usb4_fabric_tunnel_state(s->fabric, p) == USB4_TUNNEL_UP) {
+            usb4_tunnel_port_cold_reconcile(tp, s->port_dev[p]);
+        }
+    }
+}
+
+static void usb4_host_reset_hold(Object *obj, ResetType type)
+{
+    USB4Host *s = USB4_HOST(obj);
+
+    /*
+     * A controller power-up: ours, or the root bridge resetting the
+     * domain for a fresh arrival (ARCHITECTURE.md 4.4a).
+     */
+    bool cycling = s->power_cycle ||
+        (s->power_on_bh &&
+         usb4_tunnel_port_power_cycling(usb4_host_power_domain(s)));
+
+    usb4_host_hi_reset(s, "device reset");
+    s->inmail_data = 0;
+    s->inmail_cmd = 0;
+    s->been_d3 = false;
+    if (s->icm && cycling) {
+        /* a controller power-up, not machine power-on (R25) */
+        usb4_icm_next_reset_hot(s->icm);
+    }
+    if (s->power_on_bh && !cycling) {
+        /* Machine power-on: powered iff wanted (R27, 12.2). */
+        timer_del(s->power_off_timer);
+        s->powered = usb4_host_power_wanted(s);
+        usb4_host_gate(s);
+        qemu_bh_schedule(s->presence_bh);
+    }
+    if (s->fabric) {
+        usb4_fabric_reset(s->fabric);
+        if (s->icm && !cycling) {
+            usb4_host_assist_functions(s);
+        }
+        /* All devices exist by now: resolve the tunnel targets. */
+        for (unsigned p = 1; p <= 2; p++) {
+            USB4TunnelPort *tp = usb4_host_get_port_tunnel(s, p);
+
+            if (tp) {
+                usb4_fabric_set_pcie_down_rid(s->fabric, p,
+                                              usb4_tunnel_port_rid(tp));
+            }
+        }
+    }
+}
