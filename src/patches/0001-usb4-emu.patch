+/* Does the xHCI at 5:0.0 have a sizable BAR0 (resources possible)? */
+static bool xhci_bar0_sizable(QTestState *qts)
+{
+    cfg_wr(qts, 5, 0, 0x10, 0xffffffff);
+    return cfg_rd(qts, 5, 0, 0x10) != 0;
+}
