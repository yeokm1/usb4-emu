+/*
+ * Hook 2: reads fail (MMIO and config all-ones, writes dropped) while
+ * the DMA alias stays open and the endpoint is not reset: a held read
+ * released afterwards still writes guest memory.
+ */
+static void test_reads_fail(void)
+{
+    g_autofree char *img = make_img();
+    Nv nv;
+    QTestState *qts = tp_start(img, ",x-faults=\"at=fetch op=read act=hold "
+                               "tag=late\"", "", &nv);
+    uint16_t st, cid;
+
+    nv_bringup(&nv);
+    qtest_memset(qts, RAM_BUF, SENTINEL, 512);
+    cid = nv_read(&nv, 1, 0, RAM_BUF);
+    g_assert(!nv_poll(&nv, 1, -1, NULL, NULL, 50));
+
+    qom_set_str(qts, TP_PATH, "x-gate", "reads-fail");
+    g_assert_cmpuint(wait_stage(qts, "harness-reads-fail"), ==, 1);
+    g_assert(str_has(qts, TP_PATH, "endpoint", "live gen=1 gate=closed "
+                     "dma=open"));
+    g_assert_cmphex(nv_csts(&nv), ==, 0xffffffff);
+    g_assert_cmphex(cfg_readl(qts, 1, 0, 0), ==, 0xffffffff);
+    qtest_writel(qts, WIN_MEM + NVME_CC, 0);            /* dropped */
+
+    /* The delayed transfer completes after the reads went all-ones. */
+    qom_set_str(qts, TP_PATH, "x-release", "tag:late");
+    g_assert(buf_is(qts, RAM_BUF, PATTERN));
+    g_assert(nv_peek(&nv, 1, cid, NULL, &st));
+    g_assert_cmphex(st, ==, 0);
+
+    /* Back to normal: no reset happened, the controller kept running. */
+    qom_set_str(qts, TP_PATH, "x-gate", "normal");
+    g_assert_cmpuint(wait_stage(qts, "harness-reopened"), ==, 1);
+    g_assert_cmphex(cfg_readl(qts, 1, 0, 0), ==, 0x00101b36);
+    g_assert_cmphex(qtest_readl(qts, WIN_MEM + NVME_CC), ==, NVME_CC_ON);
+    g_assert_cmphex(nv_csts(&nv), ==, 1);
+    qtest_quit(qts);
+    unlink(img);
+}
