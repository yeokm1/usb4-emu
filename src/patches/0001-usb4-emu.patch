+/*
+ * Pin-based (INTx) interrupt bookkeeping across Completion Queue Head
+ * doorbell writes. MSI-X is never enabled, so the controller drives INTx,
+ * which QEMU mirrors in the Interrupt Status bit of the PCI Status register.
+ */
+static bool nvme_intx_asserted(nvme_ctrl *ctrl)
+{
+    return qpci_config_readw(ctrl->pdev, PCI_STATUS) & PCI_STATUS_INTERRUPT;
+}
+
+static void nvme_wait_cqe(nvme_cq *cq)
+{
+    int i;
+
+    for (i = 0; i < 5000; i++) {
+        if (nvme_cqe_pending(cq)) {
+            return;
+        }
+        g_usleep(1000);
+    }
+
+    g_assert_not_reached();
+}
+
+static void nvme_cq_doorbell(nvme_cq *cq, uint16_t head)
+{
+    qpci_io_writel(cq->common.ctrl->pdev, cq->common.ctrl->bar,
+                   cq->common.doorbell, head);
+}
+
+/* Submit Identify Controller, wait for its completion and leave it posted */
+static uint64_t nvme_identify_posted(nvme_ctrl *ctrl, uint16_t cid)
+{
+    uint64_t buf = nvme_admin_identify_ctrl(ctrl, cid, true);
+
+    nvme_wait_cqe(&ctrl->admin_cq);
+    return buf;
+}
+
+/* Consume one posted completion for @cid and ring the CQ head doorbell */
+static void nvme_consume(nvme_ctrl *ctrl, uint16_t cid, uint64_t buf)
+{
+    NvmeCqe cqe = nvme_handle_cqe(&ctrl->admin_sq);
+
+    g_assert(nvme_is_cqe_success(&cqe));
+    g_assert_cmpint(le16_to_cpu(cqe.cid), ==, cid);
+    if (buf) {
+        guest_free(ctrl->alloc, buf);
+    }
+}
+
+static nvme_ctrl *nvme_intx_setup(QNvme *nvme, QGuestAllocator *alloc)
+{
+    nvme_ctrl *ctrl = g_new0(nvme_ctrl, 1);
+
+    qpci_device_enable(&nvme->dev);
+    ctrl->alloc = alloc;
+    ctrl->pdev = &nvme->dev;
+    ctrl->bar = qpci_iomap(ctrl->pdev, 0, NULL);
+    nvme_setup_ctrl(ctrl, 8, 8);
+    g_assert(!nvme_intx_asserted(ctrl));
+
+    return ctrl;
+}
+
+/* Run one command to completion and check that INTx follows the queue */
+static void nvme_intx_roundtrip(nvme_ctrl *ctrl, uint16_t cid)
+{
+    uint64_t buf = nvme_identify_posted(ctrl, cid);
+
+    g_assert(nvme_intx_asserted(ctrl));
+    nvme_consume(ctrl, cid, buf);
+    g_assert(!nvme_intx_asserted(ctrl));
+}
+
+/*
+ * NVMe 1.4c Section 4.1: a head doorbell write equal to the current head
+ * releases no entry and must not change the interrupt state.
+ */
+static void nvmetest_intx_cq_db_redundant_test(void *obj, void *data,
+                                               QGuestAllocator *alloc)
+{
+    g_autofree nvme_ctrl *ctrl = nvme_intx_setup(obj, alloc);
+    nvme_cq *cq = &ctrl->admin_cq;
+    uint64_t buf;
+    int i;
+
+    nvme_intx_roundtrip(ctrl, 1);
+
+    /* Redundant writes on the empty queue */
+    for (i = 0; i < 3; i++) {
+        nvme_cq_doorbell(cq, cq->head);
+        g_assert(!nvme_intx_asserted(ctrl));
+    }
+
+    /* The next completion must still deassert INTx once consumed */
+    nvme_intx_roundtrip(ctrl, 2);
+
+    /* A redundant write while an entry is outstanding keeps INTx asserted */
+    buf = nvme_identify_posted(ctrl, 3);
+    nvme_cq_doorbell(cq, cq->head);
+    g_assert(nvme_intx_asserted(ctrl));
+    nvme_consume(ctrl, 3, buf);
+    g_assert(!nvme_intx_asserted(ctrl));
+
+    /* Across a phase wrap of the 8-entry queue */
+    for (i = 4; i < 12; i++) {
+        nvme_intx_roundtrip(ctrl, i);
+        nvme_cq_doorbell(cq, cq->head);
+        g_assert(!nvme_intx_asserted(ctrl));
+    }
+
+    qpci_iounmap(ctrl->pdev, ctrl->bar);
+}
+
+/*
+ * A head doorbell write beyond the tail (an Invalid Doorbell Write Value,
+ * NVMe 1.4c Section 4.1 and Figure 147) is accepted by default, as it always
+ * was. It must not corrupt the pin-based interrupt bookkeeping: once the
+ * head is back at the tail, completions assert and deassert INTx again.
+ */
+static void nvmetest_intx_cq_db_past_tail_test(void *obj, void *data,
+                                               QGuestAllocator *alloc)
+{
+    g_autofree nvme_ctrl *ctrl = nvme_intx_setup(obj, alloc);
+    nvme_cq *cq = &ctrl->admin_cq;
+
+    nvme_intx_roundtrip(ctrl, 1);
+
+    nvme_cq_doorbell(cq, (cq->head + 1) % cq->common.size);
+    g_assert(!nvme_intx_asserted(ctrl));
+    nvme_cq_doorbell(cq, cq->head);
+    g_assert(!nvme_intx_asserted(ctrl));
+
+    nvme_intx_roundtrip(ctrl, 2);
+    nvme_intx_roundtrip(ctrl, 3);
+
+    qpci_iounmap(ctrl->pdev, ctrl->bar);
+}
+
+/*
+ * With x-strict-cq-db=on a head doorbell write beyond the tail is ignored
+ * and, with an Asynchronous Event Request outstanding, reported as Invalid
+ * Doorbell Write Value (NVMe 1.4c Section 4.1 and Figure 147).
+ */
+static void nvmetest_intx_cq_db_strict_test(void *obj, void *data,
+                                            QGuestAllocator *alloc)
+{
+    g_autofree nvme_ctrl *ctrl = nvme_intx_setup(obj, alloc);
+    nvme_cq *cq = &ctrl->admin_cq;
+    NvmeCqe cqe;
+
+    nvme_intx_roundtrip(ctrl, 1);
+
+    nvme_get_next_sqe(&ctrl->admin_sq, NVME_ADM_CMD_ASYNC_EV_REQ, 100, 0);
+    nvme_commit_sqe(&ctrl->admin_sq);
+    nvme_cq_doorbell(cq, (cq->head + 1) % cq->common.size);
+    nvme_wait_cqe(cq);
+    g_assert(nvme_intx_asserted(ctrl));
+    cqe = nvme_handle_cqe(&ctrl->admin_sq);
+    g_assert(nvme_is_cqe_success(&cqe));
+    g_assert_cmpint(le16_to_cpu(cqe.cid), ==, 100);
+    g_assert_cmphex(le32_to_cpu(cqe.result), ==,
+                    NVME_AER_TYPE_ERROR |
+                    NVME_AER_INFO_ERR_INVALID_DB_VALUE << 8 |
+                    NVME_LOG_ERROR_INFO << 16);
+    g_assert(!nvme_intx_asserted(ctrl));
+
+    /* Without an outstanding AER the write is still ignored */
+    nvme_cq_doorbell(cq, (cq->head + 3) % cq->common.size);
+    g_assert(!nvme_intx_asserted(ctrl));
+    nvme_intx_roundtrip(ctrl, 2);
+    nvme_intx_roundtrip(ctrl, 3);
+
+    qpci_iounmap(ctrl->pdev, ctrl->bar);
+}
+
+/*
+ * With MSI-X (all vectors left masked, so notifications only set pending
+ * bits) the default behaviour is unchanged: a head write beyond the tail is
+ * accepted and no Invalid Doorbell Write Value event completes the
+ * outstanding AER.
+ */
+static void nvmetest_msix_cq_db_past_tail_test(void *obj, void *data,
+                                               QGuestAllocator *alloc)
+{
+    QNvme *nvme = obj;
+    g_autofree nvme_ctrl *ctrl = g_new0(nvme_ctrl, 1);
+    nvme_cq *cq = &ctrl->admin_cq;
+    uint8_t cap;
+    uint16_t flags;
+    uint64_t buf;
+    int i;
+
+    qpci_device_enable(&nvme->dev);
+    cap = qpci_find_capability(&nvme->dev, PCI_CAP_ID_MSIX, 0);
+    g_assert(cap);
+    flags = qpci_config_readw(&nvme->dev, cap + PCI_MSIX_FLAGS);
+    qpci_config_writew(&nvme->dev, cap + PCI_MSIX_FLAGS,
+                       flags | PCI_MSIX_FLAGS_ENABLE);
+
+    ctrl->alloc = alloc;
+    ctrl->pdev = &nvme->dev;
+    ctrl->bar = qpci_iomap(ctrl->pdev, 0, NULL);
+    nvme_setup_ctrl(ctrl, 8, 8);
+
+    buf = nvme_identify_posted(ctrl, 1);
+    nvme_consume(ctrl, 1, buf);
+
+    nvme_get_next_sqe(&ctrl->admin_sq, NVME_ADM_CMD_ASYNC_EV_REQ, 100, 0);
+    nvme_commit_sqe(&ctrl->admin_sq);
+    nvme_cq_doorbell(cq, (cq->head + 1) % cq->common.size);
+
+    /*
+     * The write is accepted: with the controller's head one past its tail
+     * the queue counts as full, so neither an AER nor the completion of a
+     * new command is posted (a rejected write would let both through).
+     */
+    buf = nvme_admin_identify_ctrl(ctrl, 2, true);
+    for (i = 0; i < 200; i++) {
+        g_assert(!nvme_cqe_pending(cq));
+        g_usleep(1000);
+    }
+
+    /* Head back at the tail: the held completion is posted */
+    nvme_cq_doorbell(cq, cq->head);
+    nvme_wait_cqe(cq);
+    nvme_consume(ctrl, 2, buf);
+    g_assert(!nvme_intx_asserted(ctrl));
+
+    qpci_iounmap(ctrl->pdev, ctrl->bar);
+}
+
+/*
+ * Offset of NvmeCtrl.irq_status in the full-state section of the device
+ * with idstr @idstr. The section header (migration/savevm.c) is
+ * QEMU_VM_SECTION_FULL (0x04), section id (be32), idstr length (u8), idstr,
+ * instance id (be32) and version id (be32); the section ends with
+ * QEMU_VM_SECTION_FOOTER (0x7e) and the same section id. The fields before
+ * irq_status are qs_created, page_size, page_bits, max_prp_ents, max_q_ents
+ * and outstanding_aers, all big endian; with a 4 KiB page, page_size,
+ * page_bits and max_prp_ents read 00001000 000c 0200. The header and the
+ * field pattern must each match exactly once, or the test fails.
+ */
+static gsize nvme_mig_irq_status_offset(const guint8 *buf, gsize len,
+                                        const char *idstr)
+{
+    static const guint8 sig[] = { 0, 0, 0x10, 0, 0, 0x0c, 0x02, 0 };
+    gsize idlen = strlen(idstr), hdrlen = 1 + 4 + 1 + idlen + 4 + 4;
+    gsize i, body = 0, end = 0, found = 0;
+    int headers = 0, matches = 0;
+    uint32_t section_id = 0;
+
+    g_assert_cmpuint(idlen, <, 256);
+    for (i = 0; i + hdrlen <= len; i++) {
+        if (buf[i] == 0x04 && buf[i + 5] == idlen &&
+            !memcmp(buf + i + 6, idstr, idlen) &&
+            ldl_be_p(buf + i + 6 + idlen + 4) == 1) {
+            headers++;
+            section_id = ldl_be_p(buf + i + 1);
+            body = i + hdrlen;
+        }
+    }
+    g_assert_cmpint(headers, ==, 1);
+
+    for (i = body; i + 5 <= len; i++) {
+        if (buf[i] == 0x7e && ldl_be_p(buf + i + 1) == section_id) {
+            end = i;
+            break;
+        }
+    }
+    g_assert(end);
+
+    for (i = body; i + sizeof(sig) + 13 + 8 <= end; i++) {
+        if (!memcmp(buf + i, sig, sizeof(sig))) {
+            matches++;
+            found = i + 13;
+        }
+    }
+    g_assert_cmpint(matches, ==, 1);
+
+    return found;
+}
+
+typedef struct NvmeMigRecv {
+    int lsock;
+    GByteArray *stream;
+    bool done;  /* the source reported completion */
+} NvmeMigRecv;
+
+/*
+ * Receive a whole migration stream on the listening socket. The source may
+ * keep the connection open after completion, so stop at the first idle
+ * receive timeout once the source has reported completion.
+ */
+static gpointer nvme_mig_recv(gpointer opaque)
+{
+    NvmeMigRecv *r = opaque;
+#ifndef _WIN32
+    struct timeval timeout = { .tv_sec = 0, .tv_usec = 200000 };
+#else
+    DWORD timeout = 200;
+#endif
+    guint8 chunk[65536];
+    ssize_t n;
+    int fd;
+
+    fd = accept(r->lsock, NULL, NULL);
+    g_assert_cmpint(fd, >=, 0);
+    g_assert(!setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO,
+                         (void *)&timeout, sizeof(timeout)));
+    for (;;) {
+        n = recv(fd, (void *)chunk, sizeof(chunk), 0);
+        if (n > 0) {
+            g_byte_array_append(r->stream, chunk, n);
+        } else if (n == 0 || qatomic_read(&r->done)) {
+            break;
+        }
+    }
+    close(fd);
+    close(r->lsock);
+
+    return NULL;
+}
+
+/*
+ * A source without the transition-based accounting may migrate a corrupted
+ * (negative) cq_pending. The destination rebuilds the count from the queues
+ * in post_load, so INTx still deasserts after the next completion. The
+ * stream is relayed through the test, which corrupts the field on the way.
+ */
+static void nvmetest_intx_migrate_test(void *obj, void *data,
+                                       QGuestAllocator *alloc)
+{
+    QNvme *nvme = obj;
+    g_autofree nvme_ctrl *ctrl = NULL;
+    g_autoptr(GError) err = NULL;
+    g_autofree gchar *tmpdir = NULL;
+    g_autofree gchar *src_path = NULL;
+    g_autofree gchar *dst_path = NULL;
+    g_autofree gchar *uri = NULL;
+    g_autofree guint8 *stream = NULL;
+    GString *dest_cmdline;
+    QTestState *to;
+    QDict *rsp;
+    NvmeMigRecv recv_state;
+    GThread *thread;
+    gsize len, off;
+    int fd, i;
+
+    /*
+     * The stream is patched at the section of the device at 04.0 on PCI
+     * domain 0, bus 0, which is where qos places it on the x86 machines.
+     */
+    if (strcmp(qtest_get_arch(), "x86_64") &&
+        strcmp(qtest_get_arch(), "i386")) {
+        g_test_skip("migration stream layout checked on x86 only");
+        return;
+    }
+
+    ctrl = nvme_intx_setup(nvme, alloc);
+    tmpdir = g_dir_make_tmp("nvme-test-XXXXXX", &err);
+    g_assert(tmpdir);
+    src_path = g_build_filename(tmpdir, "src.sock", NULL);
+    dst_path = g_build_filename(tmpdir, "dst.sock", NULL);
+
+    nvme_intx_roundtrip(ctrl, 1);
+    qpci_iounmap(ctrl->pdev, ctrl->bar);
+
+    recv_state.done = false;
+    recv_state.lsock = qtest_socket_server(src_path);
+    recv_state.stream = g_byte_array_new();
+    thread = g_thread_new("nvme-mig-recv", nvme_mig_recv, &recv_state);
+    uri = g_strdup_printf("unix:%s", src_path);
+    rsp = qmp("{ 'execute': 'migrate', 'arguments': { 'uri': %s } }", uri);
+    g_assert(qdict_haskey(rsp, "return"));
+    qobject_unref(rsp);
+    for (;;) {
+        g_autofree gchar *status = NULL;
+        QDict *ret;
+
+        rsp = qmp("{ 'execute': 'query-migrate' }");
+        ret = qdict_get_qdict(rsp, "return");
+        g_assert(ret);
+        status = g_strdup(qdict_get_try_str(ret, "status"));
+        qobject_unref(rsp);
+        g_assert_cmpstr(status, !=, "failed");
+        if (!g_strcmp0(status, "completed")) {
+            break;
+        }
+        g_usleep(10000);
+    }
+    qatomic_set(&recv_state.done, true);
+    g_thread_join(thread);
+    len = recv_state.stream->len;
+    stream = g_byte_array_free(recv_state.stream, false);
+
+    /* irq_status 0 and cq_pending 0: make cq_pending -1 */
+    off = nvme_mig_irq_status_offset(stream, len, "0000:00:04.0/nvme");
+    g_assert_cmphex(ldl_be_p(stream + off), ==, 0);
+    g_assert_cmphex(ldl_be_p(stream + off + 4), ==, 0);
+    stl_be_p(stream + off + 4, 0xffffffff);
+
+    dest_cmdline = g_string_new(qos_get_current_command_line());
+    g_string_append_printf(dest_cmdline, " -incoming unix:%s", dst_path);
+    to = qtest_init(dest_cmdline->str);
+    g_string_free(dest_cmdline, true);
+
+    for (i = 0; ; i++) {
+        fd = unix_connect(dst_path, NULL);
+        if (fd >= 0) {
+            break;
+        }
+        g_assert_cmpint(i, <, 5000);
+        g_usleep(1000);
+    }
+    g_assert_cmpint(qemu_send_full(fd, stream, len), ==, len);
+    close(fd);
+    qtest_qmp_eventwait(to, "RESUME");
+
+    nvme = qos_allocate_objects(to, &ctrl->alloc);
+    migrate_allocator(alloc, ctrl->alloc);
+    ctrl->pdev = &nvme->dev;
+    ctrl->bar = qpci_iomap(ctrl->pdev, 0, NULL);
+    g_assert(!nvme_intx_asserted(ctrl));
+
+    nvme_intx_roundtrip(ctrl, 2);
+    nvme_intx_roundtrip(ctrl, 3);
+
+    qpci_iounmap(ctrl->pdev, ctrl->bar);
+    qtest_quit(to);
+    g_unlink(src_path);
+    g_unlink(dst_path);
+    g_rmdir(tmpdir);
+}
+
+/*
+ * NVMe 1.4c Section 7.3.2: a Controller Level Reset deletes the queues, so
+ * a completion still posted at the reset leaves no interrupt behind.
+ */
+static void nvmetest_intx_reset_test(void *obj, void *data,
+                                     QGuestAllocator *alloc)
+{
+    g_autofree nvme_ctrl *ctrl = nvme_intx_setup(obj, alloc);
+    uint64_t buf;
+
+    buf = nvme_identify_posted(ctrl, 1);
+    g_assert(nvme_intx_asserted(ctrl));
+    qpci_io_writel(ctrl->pdev, ctrl->bar, NVME_REG_CC, 0);
+    nvme_wait_ready(ctrl, 0);
+    g_assert(!nvme_intx_asserted(ctrl));
+    guest_free(alloc, buf);
+
+    /* No stale status is left for the next completion */
+    nvme_setup_ctrl(ctrl, 8, 8);
+    g_assert(!nvme_intx_asserted(ctrl));
+    nvme_intx_roundtrip(ctrl, 2);
+    nvme_intx_roundtrip(ctrl, 3);
+
+    qpci_iounmap(ctrl->pdev, ctrl->bar);
+}
