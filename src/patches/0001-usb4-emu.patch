diff --git a/hw/usb4/usb4-ctl.c b/hw/usb4/usb4-ctl.c
new file mode 100644
index 0000000000000000000000000000000000000000..1319e16694952e4e14c0eafd1e26bd80ddb0656d
--- /dev/null
+++ b/hw/usb4/usb4-ctl.c
@@ -0,0 +1,137 @@
+/*
+ * USB4 control packet framing: CRC32C, sealing and decode helpers
+ *
+ * Copyright (c) 2026 usb4-emu contributors
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Written from scratch for the usb4-emu project from the USB4
+ * Specification 2.0 section 6.4 and Appendix A.2.
+ */
+#include "qemu/osdep.h"
+#include "usb4-fabric-int.h"
+#include "trace.h"
+
+/*
+ * Spec 6.4.2.2 Table 6-1: CRC-32 with polynomial 1EDC6F41h (Castagnoli),
+ * init FFFFFFFFh, reflected in and out, final XOR FFFFFFFFh. It covers
+ * the Route String and Control Data dwords, each fed most significant
+ * byte first, i.e. the big-endian wire image. Appendix A.2 vectors are
+ * checked by tests/usb4/fabric-test.c.
+ */
+static uint32_t crc32c_table[256];
+
+static void crc32c_init(void)
+{
+    for (unsigned i = 0; i < 256; i++) {
+        uint32_t c = i;
+        for (int b = 0; b < 8; b++) {
+            c = (c >> 1) ^ ((c & 1) ? 0x82F63B78u : 0);
+        }
+        crc32c_table[i] = c;
+    }
+}
+
+uint32_t usb4_crc32c(const uint8_t *data, size_t len)
+{
+    uint32_t crc = 0xffffffffu;
+
+    if (!crc32c_table[1]) {
+        crc32c_init();
+    }
+    for (size_t i = 0; i < len; i++) {
+        crc = (crc >> 8) ^ crc32c_table[(crc ^ data[i]) & 0xff];
+    }
+    return crc ^ 0xffffffffu;
+}
+
+bool usb4_ctl_frame_crc_ok(const uint8_t *frame, size_t len)
+{
+    if (len < 8 || (len & 3)) {
+        return false;
+    }
+    return usb4_crc32c(frame, len - 4) == usb4_get_be32(frame + len - 4);
+}
+
+size_t usb4_ctl_frame_seal(uint8_t *frame, size_t len)
+{
+    usb4_put_be32(frame + len, usb4_crc32c(frame, len));
+    return len + 4;
+}
+
+const char *usb4_ctl_cs_name(unsigned cs)
+{
+    static const char *const n[] = { "path", "adapter", "router",
+                                     "counters" };
+    return n[cs & 3];
+}
+
+const char *usb4_ctl_pdf_name(unsigned pdf)
+{
+    switch (pdf) {
+    case USB4_PDF_READ: return "read";
+    case USB4_PDF_WRITE: return "write";
+    case USB4_PDF_NOTIFY: return "notify";
+    case USB4_PDF_NOTIFY_ACK: return "notify-ack";
+    case USB4_PDF_HOTPLUG: return "hotplug";
+    case USB4_PDF_XDOMAIN_REQ: return "xdomain-req";
+    case USB4_PDF_XDOMAIN_RESP: return "xdomain-resp";
+    case USB4_PDF_NOTIFY_ACK_ENH: return "notify-ack-enh";
+    case USB4_PDF_ICM_EVENT: return "icm-event";
+    case USB4_PDF_ICM_REQ: return "icm-req";
+    case USB4_PDF_ICM_RESP: return "icm-resp";
+    default: return "unknown";
+    }
+}
+
+const char *usb4_ctl_event_name(unsigned ev)
+{
+    switch (ev) {
+    case USB4_ERR_CONN: return "ERR_CONN";
+    case USB4_ERR_LINK: return "ERR_LINK";
+    case USB4_ERR_ADDR: return "ERR_ADDR";
+    case USB4_ERR_ADP: return "ERR_ADP";
+    case USB4_HP_ACK: return "HP_ACK";
+    case USB4_ERR_ENUM: return "ERR_ENUM";
+    case USB4_ERR_NUA: return "ERR_NUA";
+    case USB4_ERR_LEN: return "ERR_LEN";
+    case USB4_ERR_HEC: return "ERR_HEC";
+    case USB4_ERR_FC: return "ERR_FC";
+    case USB4_ERR_PLUG: return "ERR_PLUG";
+    case USB4_ERR_LOCK: return "ERR_LOCK";
+    case USB4_EV_DP_BW: return "DP_BW";
+    case USB4_EV_ROP_CMPLT: return "ROP_CMPLT";
+    case USB4_EV_POP_CMPLT: return "POP_CMPLT";
+    default: return "?";
+    }
+}
+
+void usb4_ctl_hexdump(char *buf, size_t bufsz, const uint32_t *dw, unsigned n)
+{
+    size_t pos = 0;
+
+    buf[0] = 0;
+    for (unsigned i = 0; i < n && pos + 10 < bufsz; i++) {
+        pos += snprintf(buf + pos, bufsz - pos, "%s%08x", i ? " " : "",
+                        dw[i]);
+    }
+}
+
+void usb4_ctl_send(USB4Host *h, uint8_t pdf, const uint32_t *dw,
+                   unsigned ndw)
+{
+    uint8_t frame[USB4_CTL_MAX_FRAME];
+    char hex[USB4_CTL_MAX_FRAME / 4 * 9 + 1];
+    size_t len;
+
+    assert(ndw * 4 + 4 <= sizeof(frame));
+    for (unsigned i = 0; i < ndw; i++) {
+        usb4_put_be32(frame + 4 * i, dw[i]);
+    }
+    len = usb4_ctl_frame_seal(frame, ndw * 4);
+    usb4_ctl_hexdump(hex, sizeof(hex), dw, ndw);
+    trace_usb4_ctl_rx(usb4_ctl_pdf_name(pdf), pdf,
+                      ((uint64_t)dw[0] << 32) | dw[1], (unsigned)len, hex);
+    if (h) {
+        usb4_host_rx_frame(h, pdf, frame, len);
+    }
+}
diff --git a/hw/usb4/usb4-debug-port.c b/hw/usb4/usb4-debug-port.c
new file mode 100644
index 0000000000000000000000000000000000000000..8f8591ad4e28e89a82aa16f8a5157a2dea245869
--- /dev/null
+++ b/hw/usb4/usb4-debug-port.c
@@ -0,0 +1,154 @@
+/*
+ * usb4-debug-port: test-only ISA I/O port for guest driver stage codes
+ * and clock-correlation markers (usb4-emu test harness).
+ *
+ * Copyright (c) 2026 usb4-emu contributors
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Written from scratch for the usb4-emu project. Interface:
+ * docs/HARNESS.md in the usb4-emu repository. Works on every machine
+ * with an ISA bus (i440FX and q35).
+ *
+ * Registers (32-bit, little-endian; offsets from iobase):
+ *   0x0  STAGE   W: a stage code. Traced with a timestamp, and the
+ *                   harness rules "at=stage" of every tunnel slot fire
+ *                   synchronously before the write returns.
+ *                R: the magic 0x42443455 ("U4DB").
+ *   0x4  ARG     W: an argument recorded with the next STAGE write.
+ *   0x8  MARKLO  W: low 32 bits of a marker value (e.g. the guest TSC).
+ *   0xC  MARKHI  W: high 32 bits; records the marker with a timestamp.
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/timer.h"
+#include "hw/isa/isa.h"
+#include "hw/core/qdev-properties.h"
+#include "migration/vmstate.h"
+#include "usb4-harness.h"
+#include "trace.h"
+
+#define TYPE_USB4_DEBUG_PORT "usb4-debug-port"
+OBJECT_DECLARE_SIMPLE_TYPE(USB4DebugPort, USB4_DEBUG_PORT)
+
+#define DBG_MAGIC   0x42443455u
+#define DBG_SIZE    16
+
+struct USB4DebugPort {
+    ISADevice parent_obj;
+    MemoryRegion io;
+    uint32_t iobase;
+    uint32_t arg;
+    uint32_t mark_lo;
+    uint64_t stages;
+    uint64_t markers;
+};
+
+static uint64_t dbg_read(void *opaque, hwaddr addr, unsigned size)
+{
+    uint32_t v = addr < 4 ? DBG_MAGIC : 0;
+
+    return (v >> ((addr & 3) * 8)) & MAKE_64BIT_MASK(0, size * 8);
+}
+
+static void dbg_write(void *opaque, hwaddr addr, uint64_t val, unsigned size)
+{
+    USB4DebugPort *s = opaque;
+    int64_t host = qemu_clock_get_ns(QEMU_CLOCK_HOST);
+    int64_t vm = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+
+    switch (addr) {
+    case 0x0:
+        s->stages++;
+        trace_usb4_dbg_stage(s->stages, val, s->arg, host, vm);
+        usb4_harness_stage(val, s->arg);
+        s->arg = 0;
+        break;
+    case 0x4:
+        s->arg = val;
+        break;
+    case 0x8:
+        s->mark_lo = val;
+        break;
+    case 0xc:
+        s->markers++;
+        trace_usb4_dbg_marker(s->markers, (val << 32) | s->mark_lo, host, vm);
+        s->mark_lo = 0;
+        break;
+    default:
+        break;
+    }
+}
+
+static const MemoryRegionOps dbg_ops = {
+    .read = dbg_read,
+    .write = dbg_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 4 },
+    .impl = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+static void dbg_realize(DeviceState *dev, Error **errp)
+{
+    USB4DebugPort *s = USB4_DEBUG_PORT(dev);
+
+    if (s->iobase > 0x10000 - DBG_SIZE) {
+        error_setg(errp, "iobase 0x%x out of range", s->iobase);
+        return;
+    }
+    memory_region_init_io(&s->io, OBJECT(dev), &dbg_ops, s,
+                          TYPE_USB4_DEBUG_PORT, DBG_SIZE);
+    isa_register_ioport(ISA_DEVICE(dev), &s->io, s->iobase);
+}
+
+/*
+ * Default I/O base 0x5a0 (0x5a0-0x5af): clear of every ISA device QEMU's
+ * pc and q35 machines can carry at its default address (among them
+ * cs4231a at 0x534, fw_cfg 0x510, pvpanic 0x505, isa-debug-exit 0x501,
+ * ib700 0x441/0x443, ne2000 0x300, sb16/adlib 0x220/0x388, gus 0x240),
+ * of the firmware's PM and SMBus blocks (0x600, 0x700) and of the PCI
+ * I/O windows (0x1000 up). Its 10-bit ISA alias 0x1a0 is free as well.
+ */
+static const Property dbg_props[] = {
+    DEFINE_PROP_UINT32("iobase", USB4DebugPort, iobase, 0x5a0),
+};
+
+static char *dbg_get_counts(Object *obj, Error **errp)
+{
+    USB4DebugPort *s = USB4_DEBUG_PORT(obj);
+
+    return g_strdup_printf("stages=%" PRIu64 " markers=%" PRIu64,
+                           s->stages, s->markers);
+}
+
+/* Test-only and not migratable, like the tunnel bridges it serves. */
+static const VMStateDescription dbg_vmstate = {
+    .name = TYPE_USB4_DEBUG_PORT,
+    .unmigratable = 1,
+};
+
+static void dbg_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->realize = dbg_realize;
+    dc->vmsd = &dbg_vmstate;
+    dc->desc = "usb4-emu test harness debug port (stage codes, markers)";
+    device_class_set_props(dc, dbg_props);
+    set_bit(DEVICE_CATEGORY_MISC, dc->categories);
+    object_class_property_add_str(klass, "counts", dbg_get_counts, NULL);
+}
+
+static const TypeInfo dbg_info = {
+    .name = TYPE_USB4_DEBUG_PORT,
+    .parent = TYPE_ISA_DEVICE,
+    .instance_size = sizeof(USB4DebugPort),
+    .class_init = dbg_class_init,
+};
+
+static void dbg_register_types(void)
+{
+    type_register_static(&dbg_info);
+}
+
+type_init(dbg_register_types)
diff --git a/hw/usb4/usb4-device.c b/hw/usb4/usb4-device.c
new file mode 100644
index 0000000000000000000000000000000000000000..a68b7df612c2529e79ebac875db4825a72cdd68f
--- /dev/null
+++ b/hw/usb4/usb4-device.c
@@ -0,0 +1,600 @@
+/*
+ * USB4 / Thunderbolt 3 device router on the usb4 bus
+ *
+ * Copyright (c) 2026 usb4-emu contributors
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Written from scratch for the usb4-emu project. A usb4-device stands for
+ * one device router (an enclosure) plugged into a downstream USB4 port of
+ * a usb4-host. Its router state (config spaces, DROM) lives in the fabric;
+ * this object only carries the user's configuration and the attach/detach
+ * lifecycle. It is hot-pluggable:
+ *
+ *   device_add usb4-device,bus=u4.0,port=1,drive=disk0,serial=S1
+ *   device_del <id>
+ *
+ * Daisy chaining: a device router with downstream-ports=N has N
+ * downstream USB4 ports; another usb4-device on the same bus names it
+ * with parent=<id> and picks one with port=<1..N>:
+ *
+ *   -device usb4-device,id=enc0,bus=u4.0,port=1,downstream-ports=1,...
+ *   -device usb4-device,id=enc1,bus=u4.0,parent=enc0,port=1,...
+ *
+ * Removing the parent unplugs the whole chain below it (the children
+ * stay as objects and plug back in when a usb4-device with the parent's
+ * id is added again).
+ *
+ * The NVMe endpoint behind the tunnel is created later by the tunnel port
+ * from the "drive" id; this device never attaches the block backend
+ * itself (docs/ARCHITECTURE.md section 4.5).
+ *
+ * device-model selects the router: "default" is the spec-derived router
+ * of usb4-router.c; "asm2464" is the ASMedia ASM2464PD captured in an
+ * ORICO AAGM2-U4 enclosure (docs/captures/ORICO-ASM2464.md): captured
+ * router ID 174c:2463, DROM ("ASMedia" / "246x"), adapter layout,
+ * register images and quirks, and on q35 the ASM2464's PCIe switch
+ * (1b21:2463 upstream and downstream port) in front of the NVMe. Every
+ * asm2464 router has the captured router UID unless "uid" is set (give
+ * a second enclosure its own).
+ *
+ * dialect=tb3 on a usb4-generic host is the CalDigit TS3 Plus as a
+ * software CM finds it (docs/USB4-HOSTS.md 8). Its link controller UUID,
+ * which Linux shows as unique_id, is derived per device by default, so
+ * two docks never share one; lc-uuid=captured gives the captured value
+ * instead (one dock that looks like the real one, as in the replay).
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/error-report.h"
+#include "qemu/module.h"
+#include "hw/core/qdev.h"
+#include "hw/core/qdev-properties.h"
+#include "qom/object.h"
+#include "usb4-internal.h"
+#include "trace.h"
+
+OBJECT_DECLARE_SIMPLE_TYPE(USB4Device, USB4_DEVICE)
+
+/* Downstream USB4 ports of one device router (fabric: USB4_MAX_PORTS-1) */
+#define USB4_DEV_MAX_DFP 3
+
+struct USB4Device {
+    DeviceState parent_obj;
+
+    /* properties */
+    uint32_t port;          /* 1-based host USB4 port */
+    char *dialect_str;      /* "usb4" or "tb3" */
+    char *drive;            /* -drive / -blockdev id for the NVMe */
+    char *serial;
+    char *nvme_namespaces;  /* "nsid:drive[;...]", docs/HARNESS.md */
+    uint32_t nvme_nn;       /* NVMe Identify NN (0: default) */
+    char *vendor_name;      /* DROM strings */
+    char *model_name;
+    bool dock;              /* PCIe switch with several endpoints */
+    char *nic_netdev;       /* dock NIC backend, -netdev id */
+    char *usb_drive;        /* dock USB storage, -blockdev node name */
+    char *usb3_devs;        /* USB devices behind the USB3 Up adapter */
+    char *model_str;        /* "default" or "asm2464" */
+    uint64_t uid;           /* router UID, 0: the preset's default */
+    char *lc_uuid_str;      /* tb3: "derived" (default) or "captured" */
+    bool lc_uuid_captured;
+    USB4DeviceModel model;
+
+    USB4Dialect dialect;
+    USB4Host *host;
+    uint32_t downstream_ports;  /* daisy chain: downstream USB4 ports */
+    char *parent;               /* daisy chain: id of the parent device */
+
+    USB4Device *parent_dev;     /* resolved parent, NULL if orphaned */
+    USB4Device *child[USB4_DEV_MAX_DFP + 1];  /* by downstream port */
+    /* PCI side of each downstream port's PCIe Down adapter */
+    USB4TunnelPort *dfp_target[USB4_DEV_MAX_DFP + 1];
+    void *router;           /* fabric-owned router state, NULL = detached */
+};
+
+USB4DeviceModel usb4_device_model(USB4Device *d)
+{
+    return d->model;
+}
+
+uint64_t usb4_device_uid(USB4Device *d)
+{
+    return d->uid;
+}
+
+bool usb4_device_lc_uuid_captured(USB4Device *d)
+{
+    return d->lc_uuid_captured;
+}
+
+const char *usb4_device_usb3_devs(USB4Device *d)
+{
+    return d->usb3_devs;
+}
+
+USB4Dialect usb4_device_dialect(USB4Device *d)
+{
+    return d->dialect;
+}
+
+const char *usb4_device_nvme_drive(USB4Device *d)
+{
+    return d->drive;
+}
+
+const char *usb4_device_nvme_serial(USB4Device *d)
+{
+    return d->serial;
+}
+
+const char *usb4_device_nvme_namespaces(USB4Device *d)
+{
+    return d->nvme_namespaces;
+}
+
+uint32_t usb4_device_nvme_nn(USB4Device *d)
+{
+    return d->nvme_nn;
+}
+
+void *usb4_device_get_router(USB4Device *d)
+{
+    return d->router;
+}
+
+void usb4_device_set_router(USB4Device *d, void *router)
+{
+    d->router = router;
+}
+
+unsigned usb4_device_port(USB4Device *d)
+{
+    return d->port;
+}
+
+USB4Host *usb4_device_host(USB4Device *d)
+{
+    return d->host;
+}
+
+const char *usb4_device_vendor_name(USB4Device *d)
+{
+    return d->vendor_name ? d->vendor_name : "QEMU";
+}
+
+const char *usb4_device_model_name(USB4Device *d)
+{
+    if (d->model_name) {
+        return d->model_name;
+    }
+    return d->dock ? "USB4 Dock" : "USB4 NVMe Enclosure";
+}
+
+bool usb4_device_dock(USB4Device *d)
+{
+    return d->dock;
+}
+
+const char *usb4_device_nic_netdev(USB4Device *d)
+{
+    return d->nic_netdev;
+}
+
+const char *usb4_device_usb_drive(USB4Device *d)
+{
+    return d->usb_drive;
+}
+
+unsigned usb4_device_downstream_ports(USB4Device *d)
+{
+    return d->downstream_ports;
+}
+
+/*
+ * Tunnel target behind the PCIe Downstream adapter of downstream port
+ * @dport: a hot-plug downstream port (usb4-tunnel-dsp) of the PCIe switch
+ * that exists while this device's own PCIe tunnel is up, else NULL.
+ */
+USB4TunnelPort *usb4_device_get_pcie_down_target(USB4Device *d,
+                                                 unsigned dport)
+{
+    return dport >= 1 && dport <= USB4_DEV_MAX_DFP ? d->dfp_target[dport]
+                                                   : NULL;
+}
+
+void usb4_device_set_pcie_down_target(USB4Device *d, unsigned dport,
+                                      USB4TunnelPort *tp)
+{
+    USB4Fabric *f = d->host ? usb4_host_get_fabric(d->host) : NULL;
+    USB4Device *child = NULL;
+
+    if (dport < 1 || dport > USB4_DEV_MAX_DFP) {
+        return;
+    }
+    if (!tp) {
+        d->dfp_target[dport] = NULL;
+        return;
+    }
+    d->dfp_target[dport] = tp;
+    /* The chained tunnel may be up already: replay it. */
+    if (f && usb4_fabric_chained_tunnel(f, d, dport, &child) ==
+             USB4_TUNNEL_UP && child) {
+        usb4_tunnel_port_set_state(tp, child, USB4_TUNNEL_UP,
+                                   USB4_TUNNEL_REASON_UP);
+    }
+}
+
+uint16_t usb4_device_pcie_down_rid(USB4Device *d, unsigned dport)
+{
+    return usb4_tunnel_port_rid(usb4_device_get_pcie_down_target(d, dport));
+}
+
+static const char *dev_id(USB4Device *d)
+{
+    return DEVICE(d)->id ? DEVICE(d)->id : "(anon)";
+}
+
+/* Plug @c into its parent's downstream port, if the parent is plugged. */
+static void attach_child(USB4Device *c)
+{
+    USB4Fabric *f = usb4_host_get_fabric(c->host);
+    Error *err = NULL;
+
+    if (!f || c->router || !c->parent_dev || !c->parent_dev->router) {
+        return;
+    }
+    if (!usb4_fabric_attach_chained(f, c->parent_dev, c->port, c, &err)) {
+        warn_reportf_err(err, "usb4-device %s: ", dev_id(c));
+        return;
+    }
+    trace_usb4_device_chain(dev_id(c), c->parent, c->port, "plugged");
+}
+
+/*
+ * Bound on the depth of the device tree below one router. The fabric
+ * refuses chains deeper than its route string allows (Spec 6.4.2.2), and
+ * claim_child() refuses cycles; the bound keeps the recursion finite
+ * even if an unattached orphan subtree were malformed.
+ */
+#define USB4_DEV_MAX_TREE_DEPTH 8
+
+/* After @d was plugged in: plug in the routers below it, depth first. */
+static void attach_children(USB4Device *d, unsigned depth)
+{
+    if (depth >= USB4_DEV_MAX_TREE_DEPTH) {
+        return;
+    }
+    for (unsigned p = 1; p <= USB4_DEV_MAX_DFP; p++) {
+        USB4Device *c = d->child[p];
+
+        if (c) {
+            attach_child(c);
+            attach_children(c, depth + 1);
+        }
+    }
+}
+
+/* True if @a is @d or one of @d's (resolved) ancestors. */
+static bool is_ancestor_or_self(USB4Device *a, USB4Device *d)
+{
+    for (unsigned i = 0; d && i <= USB4_DEV_MAX_TREE_DEPTH; i++) {
+        if (d == a) {
+            return true;
+        }
+        d = d->parent_dev;
+    }
+    return d != NULL;   /* too deep to be a tree: treat as a cycle */
+}
+
+/* Claim downstream port @c->port of @parent for @c. */
+static bool claim_child(USB4Device *parent, USB4Device *c, Error **errp)
+{
+    if (c->port < 1 || c->port > parent->downstream_ports) {
+        error_setg(errp, "usb4-device %s: port %u out of range, %s has %u "
+                   "downstream ports", dev_id(c), c->port, dev_id(parent),
+                   parent->downstream_ports);
+        return false;
+    }
+    if (parent->child[c->port]) {
+        error_setg(errp, "usb4-device %s: port %u of %s is already in use",
+                   dev_id(c), c->port, dev_id(parent));
+        return false;
+    }
+    /*
+     * A device cannot sit below itself. Re-adding a deleted router with
+     * parent= naming one of its own orphaned descendants would otherwise
+     * make each the other's parent once the orphans are adopted.
+     */
+    if (is_ancestor_or_self(c, parent)) {
+        error_setg(errp, "usb4-device %s: parent %s is below it: the daisy "
+                   "chain would form a cycle", dev_id(c), dev_id(parent));
+        return false;
+    }
+    parent->child[c->port] = c;
+    c->parent_dev = parent;
+    return true;
+}
+
+/*
+ * A device was (re)added: adopt orphaned devices on the same bus that
+ * name it as their parent.
+ */
+static void adopt_orphans(USB4Device *d, BusState *bus)
+{
+    BusChild *kid;
+
+    if (!DEVICE(d)->id) {
+        return;
+    }
+    QTAILQ_FOREACH(kid, &bus->children, sibling) {
+        USB4Device *c = (USB4Device *)object_dynamic_cast(OBJECT(kid->child),
+                                                          TYPE_USB4_DEVICE);
+
+        if (c && c != d && c->host && !c->parent_dev && c->parent &&
+            !strcmp(c->parent, DEVICE(d)->id)) {
+            Error *err = NULL;
+
+            if (!claim_child(d, c, &err)) {
+                warn_report_err(err);
+            }
+        }
+    }
+}
+
+/*
+ * True if adopt_orphans(@d) would adopt an ancestor of @parent, i.e. the
+ * root of @parent's (detached) subtree is an orphan waiting for @d's id.
+ */
+static bool would_adopt_ancestor(USB4Device *d, USB4Device *parent)
+{
+    USB4Device *root = parent;
+
+    for (unsigned i = 0; root->parent_dev; i++) {
+        if (i > USB4_DEV_MAX_TREE_DEPTH) {
+            return true;
+        }
+        root = root->parent_dev;
+    }
+    return DEVICE(d)->id && root->parent &&
+           !strcmp(root->parent, DEVICE(d)->id);
+}
+
+static void usb4_device_realize(DeviceState *dev, Error **errp)
+{
+    USB4Device *d = USB4_DEVICE(dev);
+    BusState *bus = qdev_get_parent_bus(dev);
+    USB4Host *h = usb4_host_from_bus(bus);
+    USB4Device *parent = NULL;
+    USB4Fabric *f;
+
+    if (!h) {
+        error_setg(errp, "usb4-device must sit on a usb4-host bus");
+        return;
+    }
+    if (!d->dialect_str || !strcmp(d->dialect_str, "usb4")) {
+        d->dialect = USB4_DIALECT_USB4;
+    } else if (!strcmp(d->dialect_str, "tb3")) {
+        d->dialect = USB4_DIALECT_TB3;
+    } else {
+        error_setg(errp, "usb4-device: dialect must be usb4 or tb3");
+        return;
+    }
+    if (!d->lc_uuid_str || !strcmp(d->lc_uuid_str, "derived")) {
+        d->lc_uuid_captured = false;
+    } else if (!strcmp(d->lc_uuid_str, "captured") &&
+               d->dialect == USB4_DIALECT_TB3) {
+        d->lc_uuid_captured = true;
+    } else {
+        error_setg(errp, "usb4-device: lc-uuid must be derived or captured "
+                   "(dialect=tb3 only)");
+        return;
+    }
+    if (d->lc_uuid_captured &&
+        usb4_host_profile(h) != USB4_PROFILE_USB4_GENERIC) {
+        /* Under a firmware CM no CM reads it (ICM-PROTOCOL.md 5.1) */
+        error_setg(errp, "usb4-device: lc-uuid=captured needs a "
+                   "profile=usb4-generic host");
+        return;
+    }
+    if (d->downstream_ports > USB4_DEV_MAX_DFP) {
+        error_setg(errp, "usb4-device: downstream-ports must be 0..%u",
+                   USB4_DEV_MAX_DFP);
+        return;
+    }
+    if (!d->model_str || !strcmp(d->model_str, "default")) {
+        d->model = USB4_DEVICE_MODEL_DEFAULT;
+    } else if (!strcmp(d->model_str, "asm2464")) {
+        d->model = USB4_DEVICE_MODEL_ASM2464;
+    } else {
+        error_setg(errp, "usb4-device: device-model must be default or "
+                   "asm2464");
+        return;
+    }
+    if (d->model == USB4_DEVICE_MODEL_ASM2464 &&
+        (d->dialect != USB4_DIALECT_USB4 || d->downstream_ports || d->dock)) {
+        /*
+         * The ASM2464 is a USB4 device router with no downstream USB4
+         * port and one NVMe behind its PCIe switch, as captured on a
+         * USB4 host (software CM, docs/captures/ORICO-ASM2464.md) and
+         * behind the Alpine Ridge firmware CM
+         * (docs/captures/P14S-ORICO-2026-10-15.md).
+         */
+        error_setg(errp, "usb4-device: device-model=asm2464 needs "
+                   "dialect=usb4, downstream-ports=0 and dock=off");
+        return;
+    }
+    if (d->parent) {
+        Object *o = object_resolve_path_component(
+            object_resolve_path("/machine/peripheral", NULL), d->parent);
+
+        parent = o ? (USB4Device *)object_dynamic_cast(o, TYPE_USB4_DEVICE)
+                   : NULL;
+        if (!parent || parent->host != h) {
+            error_setg(errp, "usb4-device: parent '%s' is not a usb4-device "
+                       "on the same usb4-host", d->parent);
+            return;
+        }
+        if (would_adopt_ancestor(d, parent)) {
+            error_setg(errp, "usb4-device %s: parent '%s' is one of its "
+                       "orphaned descendants: the daisy chain would form a "
+                       "cycle", dev_id(d), d->parent);
+            return;
+        }
+        if (!claim_child(parent, d, errp)) {
+            return;
+        }
+    } else if (!usb4_host_claim_port(h, d->port, d, errp)) {
+        return;
+    }
+    d->host = h;
+    trace_usb4_device_realize(dev->id ? dev->id : "(anon)", d->port,
+                              d->dialect == USB4_DIALECT_TB3 ? "tb3" : "usb4",
+                              d->drive ? d->drive : "(none)");
+
+    f = usb4_host_get_fabric(h);
+    if (!f) {
+        /* Stub build without a fabric: keep the object, no link. */
+        trace_usb4_host_no_fabric("usb4-device not attached to a fabric");
+        adopt_orphans(d, bus);
+        return;
+    }
+    if (parent) {
+        /* Plugged now if the parent is; else when the parent is. */
+        attach_child(d);
+    } else if (!usb4_fabric_attach(f, d->port, d, errp)) {
+        usb4_host_release_port(h, d->port, d);
+        d->host = NULL;
+        return;
+    }
+    /*
+     * Adopt orphans only once realize can no longer fail: a failed
+     * realize frees @d, and an orphan adopted before would keep a
+     * dangling parent pointer.
+     */
+    adopt_orphans(d, bus);
+    attach_children(d, 0);
+    usb4_usb3_device_realized(d);
+}
+
+static void usb4_device_unrealize(DeviceState *dev)
+{
+    USB4Device *d = USB4_DEVICE(dev);
+    USB4Fabric *f;
+
+    if (!d->host) {
+        return;
+    }
+    trace_usb4_device_unrealize(dev->id ? dev->id : "(anon)", d->port);
+    /* Unplugs this router and every router below it (surprise). */
+    f = usb4_host_get_fabric(d->host);
+    if (f && d->router) {
+        usb4_fabric_detach_device(f, d);
+    }
+    for (unsigned p = 1; p <= USB4_DEV_MAX_DFP; p++) {
+        if (d->child[p]) {
+            trace_usb4_device_chain(dev_id(d->child[p]), d->child[p]->parent,
+                                    p, "orphaned");
+            d->child[p]->parent_dev = NULL;
+            d->child[p] = NULL;
+        }
+    }
+    if (d->parent_dev) {
+        d->parent_dev->child[d->port] = NULL;
+        d->parent_dev = NULL;
+    } else if (!d->parent) {
+        usb4_host_release_port(d->host, d->port, d);
+    }
+    usb4_usb3_device_unrealized(d);
+    d->host = NULL;
+}
+
+static const Property usb4_device_properties[] = {
+    /* Host USB4 port, or with "parent" the parent's downstream port */
+    DEFINE_PROP_UINT32("port", USB4Device, port, 1),
+    DEFINE_PROP_UINT32("downstream-ports", USB4Device, downstream_ports, 0),
+    DEFINE_PROP_STRING("parent", USB4Device, parent),
+    DEFINE_PROP_STRING("dialect", USB4Device, dialect_str),
+    /* A string on purpose: DEFINE_PROP_DRIVE would attach the backend. */
+    DEFINE_PROP_STRING("drive", USB4Device, drive),
+    DEFINE_PROP_STRING("serial", USB4Device, serial),
+    DEFINE_PROP_STRING("nvme-namespaces", USB4Device, nvme_namespaces),
+    DEFINE_PROP_UINT32("nvme-nn", USB4Device, nvme_nn, 0),
+    DEFINE_PROP_STRING("vendor-name", USB4Device, vendor_name),
+    DEFINE_PROP_STRING("model-name", USB4Device, model_name),
+    /*
+     * Dock mode (q35 usb4-tunnel-port only): the tunnel exposes a PCIe
+     * switch with the NVMe, an e1000e NIC and a qemu-xhci with one USB
+     * device. Ids only; the backends are attached by the endpoints the
+     * tunnel port creates on every tunnel up.
+     */
+    DEFINE_PROP_BOOL("dock", USB4Device, dock, false),
+    DEFINE_PROP_STRING("nic-netdev", USB4Device, nic_netdev),
+    DEFINE_PROP_STRING("usb-drive", USB4Device, usb_drive),
+    /* ':'-separated ids of USB devices behind the USB3 tunnel */
+    DEFINE_PROP_STRING("usb3-dev", USB4Device, usb3_devs),
+    /* Router preset: default (spec-derived) or asm2464 (captured) */
+    DEFINE_PROP_STRING("device-model", USB4Device, model_str),
+    DEFINE_PROP_UINT64("uid", USB4Device, uid, 0),
+    /* tb3 link controller UUID on a USB4 host: derived or captured */
+    DEFINE_PROP_STRING("lc-uuid", USB4Device, lc_uuid_str),
+};
+
+/* Debug/test: the router is plugged into the fabric. */
+static bool usb4_device_get_attached(Object *obj, Error **errp)
+{
+    return USB4_DEVICE(obj)->router != NULL;
+}
+
+/*
+ * Debug/test: the registered tunnel target of each downstream port, as
+ * canonical QOM paths separated by commas ("-" for none).
+ */
+static char *usb4_device_get_pcie_down(Object *obj, Error **errp)
+{
+    USB4Device *d = USB4_DEVICE(obj);
+    GString *s = g_string_new("");
+
+    for (unsigned p = 1; p <= d->downstream_ports; p++) {
+        g_autofree char *path = d->dfp_target[p] ?
+            object_get_canonical_path(OBJECT(d->dfp_target[p])) : NULL;
+
+        g_string_append_printf(s, "%s%s", p > 1 ? "," : "",
+                               path ? path : "-");
+    }
+    return g_string_free(s, false);
+}
+
+static void usb4_device_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    object_class_property_add_bool(klass, "x-attached",
+                                   usb4_device_get_attached, NULL);
+    object_class_property_add_str(klass, "x-pcie-down",
+                                  usb4_device_get_pcie_down, NULL);
+
+    dc->realize = usb4_device_realize;
+    dc->unrealize = usb4_device_unrealize;
+    dc->bus_type = TYPE_USB4_BUS;
+    dc->hotpluggable = true;
+    dc->desc = "USB4 / Thunderbolt 3 device router";
+    device_class_set_props(dc, usb4_device_properties);
+    set_bit(DEVICE_CATEGORY_USB, dc->categories);
+}
+
+static const TypeInfo usb4_device_types[] = {
+    {
+        .name = TYPE_USB4_BUS,
+        .parent = TYPE_BUS,
+        .instance_size = sizeof(BusState),
+    },
+    {
+        .name = TYPE_USB4_DEVICE,
+        .parent = TYPE_DEVICE,
+        .instance_size = sizeof(USB4Device),
+        .class_init = usb4_device_class_init,
+    },
+};
+
+DEFINE_TYPES(usb4_device_types)
diff --git a/hw/usb4/usb4-drom.c b/hw/usb4/usb4-drom.c
new file mode 100644
index 0000000000000000000000000000000000000000..ce5f039a2035b2b6a68aa532663becd471a52e97
--- /dev/null
+++ b/hw/usb4/usb4-drom.c
@@ -0,0 +1,286 @@
+/*
+ * USB4 DROM image builder
+ *
+ * Copyright (c) 2026 usb4-emu contributors
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Written from scratch for the usb4-emu project from the USB4 DROM
+ * Specification (November 2025), sections 5 and 7 and Appendix A.
+ */
+#include "qemu/osdep.h"
+#include "usb4-fabric-int.h"
+
+/* DROM spec Appendix A.1: x^8 + x^2 + x + 1, init FFh (TBT3 UUID CRC). */
+uint8_t usb4_drom_crc8(const uint8_t *data, size_t len)
+{
+    uint8_t crc = 0xff;
+
+    for (size_t i = 0; i < len; i++) {
+        crc ^= data[i];
+        for (int b = 0; b < 8; b++) {
+            crc = (crc & 0x80) ? (uint8_t)((crc << 1) ^ 0x07) : crc << 1;
+        }
+    }
+    return crc;
+}
+
+/*
+ * DROM spec Table 5-1 and Appendix A.2: the CRC32 is the Castagnoli
+ * CRC (same as control packets) over the bytes starting at Version.
+ */
+uint32_t usb4_drom_crc32(const uint8_t *data, size_t len)
+{
+    return usb4_crc32c(data, len);
+}
+
+/*
+ * Worst case of one ASCII entry: 2-byte header + 251 bytes of name with
+ * its terminator (the entry Length field is one byte, DROM Table 7-2).
+ */
+#define DROM_ASCII_MAX  253
+/*
+ * Scratch size for either builder: header (16 or 22 bytes), the fixed
+ * entries (generic 18 bytes, tb3 at most sizeof(tb3_dev_entries)) and
+ * two maximal ASCII entries. Names are guest-independent properties but
+ * can be arbitrarily long, so the bound is static, not the 512 bytes a
+ * typical DROM needs.
+ */
+#define DROM_BUF_MAX    (22 + 64 + 2 * DROM_ASCII_MAX)
+
+static size_t put_ascii(uint8_t *p, unsigned type, const char *s)
+{
+    size_t n = strlen(s) + 1;   /* null terminated, DROM Table 7-2 */
+
+    if (n > 251) {
+        n = 251;
+    }
+    p[0] = n + 2;
+    p[1] = type & 0x3f;         /* AE = 0: generic entry */
+    memcpy(p + 2, s, n - 1);
+    p[n + 1] = 0;
+    return n + 2;
+}
+
+/*
+ * Generic entries start after the header: 16 bytes in a version 3 DROM
+ * (Table 5-1), 22 in a TBT3-compatible header (version 1, the
+ * ASM2464's captured DROM and docs/ICM-PROTOCOL.md 5.3). An entry is
+ * Length (including the 2-byte header), then AE in bit 7 (0: generic)
+ * and the type in bits 5:0 (Table 7-1).
+ */
+const uint8_t *usb4_drom_entry(USB4Router *r, unsigned type, unsigned *len)
+{
+    size_t end, pos;
+
+    if (!r->drom || r->drom_len < 16) {
+        return NULL;
+    }
+    end = MIN(r->drom_len, 13 + ((r->drom[14] | (r->drom[15] << 8)) & 0xfff));
+    pos = r->drom[13] >= 3 ? 16 : 22;
+    while (pos + 2 <= end) {
+        unsigned n = r->drom[pos];
+
+        if (n < 2 || pos + n > end) {
+            break;
+        }
+        if (!(r->drom[pos + 1] & 0x80) && (r->drom[pos + 1] & 0x3f) == type) {
+            *len = n - 2;
+            return r->drom + pos + 2;
+        }
+        pos += n;
+    }
+    return NULL;
+}
+
+bool usb4_drom_ids(USB4Router *r, uint16_t *vendor, uint16_t *model)
+{
+    const uint8_t *pd;
+    unsigned len;
+
+    if (r->drom && r->drom_len >= 22 && r->drom[13] < 3) {
+        *vendor = r->drom[16] | (r->drom[17] << 8);
+        *model = r->drom[18] | (r->drom[19] << 8);
+        return true;
+    }
+    /* Product Descriptor, Table 7-5: idVendor, idProduct after bcdUSB */
+    pd = usb4_drom_entry(r, 0x9, &len);
+    if (!pd || len < 6) {
+        return false;
+    }
+    *vendor = pd[2] | (pd[3] << 8);
+    *model = pd[4] | (pd[5] << 8);
+    return true;
+}
+
+/*
+ * Build a USB4 DROM (version 3) with the mandatory generic entries
+ * (DROM spec 7.1): ASCII vendor and model name, TMU Minimum Requested
+ * Mode (Off: PCIe-only product without PTM) and Product Descriptor.
+ */
+void usb4_drom_build(USB4Router *r)
+{
+    uint8_t buf[DROM_BUF_MAX];
+    size_t pos = 13;            /* Version field offset, Table 5-1 */
+    uint32_t crc;
+
+    memset(buf, 0, sizeof(buf));
+    buf[pos++] = 3;             /* Version */
+    pos += 2;                   /* Length, filled below */
+
+    pos += put_ascii(buf + pos, 0x1, r->vendor_name);
+    pos += put_ascii(buf + pos, 0x2, r->model_name);
+
+    /* TMU Minimum Requested Mode, Table 7-4: Mode Off. */
+    buf[pos++] = 3;
+    buf[pos++] = 0x8;
+    buf[pos++] = 0x00;
+
+    /* Product Descriptor, Table 7-5 (15 bytes, multi-byte fields LE). */
+    buf[pos++] = 15;
+    buf[pos++] = 0x9;
+    buf[pos++] = 0x00;          /* bcdUSBSpec 0x0400: USB4 Version 1.0 */
+    buf[pos++] = 0x04;
+    buf[pos++] = r->vendor_id & 0xff;
+    buf[pos++] = r->vendor_id >> 8;
+    buf[pos++] = r->product_id & 0xff;
+    buf[pos++] = r->product_id >> 8;
+    buf[pos++] = 0x00;          /* bcdProductFWRevision 1.00 */
+    buf[pos++] = 0x01;
+    pos += 4;                   /* TID 0: not certified */
+    buf[pos++] = 1;             /* productHWRevision */
+    assert(pos <= sizeof(buf));
+
+    buf[14] = (pos - 13) & 0xff;
+    buf[15] = ((pos - 13) >> 8) & 0x0f;
+    crc = usb4_drom_crc32(buf + 13, pos - 13);
+    buf[9] = crc;
+    buf[10] = crc >> 8;
+    buf[11] = crc >> 16;
+    buf[12] = crc >> 24;
+
+    g_free(r->drom);
+    r->drom = g_malloc(pos);
+    memcpy(r->drom, buf, pos);
+    r->drom_len = pos;
+}
+
+/*
+ * Thunderbolt 3 DROM (docs/ICM-PROTOCOL.md 5.3, 5.4, R19), laid out as
+ * the captured DROMs (tests/captures/p14s-gen1, snap-6 debugfs drom
+ * files): CRC-8 over the UID, 8-byte UID, CRC-32C over the bytes from
+ * Version on, Version 1, data length, DROM vendor and model IDs,
+ * hardware and NVM revision, then one entry per adapter and the ASCII
+ * vendor and model name entries. The adapter entries are the captured
+ * bytes of the matching adapter layout (usb4-router-tb3.c): host router
+ * as the P14s Alpine Ridge, device router as the TS3 Plus dock.
+ */
+static const uint8_t tb3_host_entries[] = {
+    0x08, 0x81, 0x80, 0x02, 0x80, 0x00, 0x00, 0x00,     /* lane 1 */
+    0x08, 0x82, 0x80, 0x02, 0x80, 0x00, 0x00, 0x00,     /* lane 2 */
+    0x02, 0x83,                                         /* NHI 3 */
+    0x0b, 0x84, 0x20, 0x01, 0x00, 0x3c, 0x00, 0x00,     /* PCIe down 4 */
+    0x00, 0x00, 0x00,
+    0x05, 0x85, 0x50, 0x00, 0x00,                       /* DP in 5 */
+};
+
+QEMU_BUILD_BUG_ON(sizeof(tb3_host_entries) > 64);
+
+/*
+ * Titan Ridge host router (docs/ICM-TITAN-RIDGE.md 4): not captured.
+ * Entries follow the layout of usb4-router-tb3.c in the format of the
+ * captured entries above (lane pairs as on the dock); a port-B adapter
+ * of a 2C controller is listed as disabled. Linux reads only the UID of
+ * a host DROM when no DMA port exists, so these bytes are inferred and
+ * unchecked.
+ */
+static const uint8_t tb3_tr_host_entries[] = {
+    0x08, 0x81, 0x80, 0x02, 0x80, 0x00, 0x00, 0x00,     /* lane 1 */
+    0x08, 0x82, 0x90, 0x01, 0x80, 0x00, 0x00, 0x00,     /* lane 2 */
+    0x08, 0x83, 0x80, 0x04, 0x80, 0x01, 0x00, 0x00,     /* lane 3 */
+    0x08, 0x84, 0x90, 0x03, 0x80, 0x01, 0x00, 0x00,     /* lane 4 */
+    0x02, 0x85,                                         /* NHI 5 */
+    0x02, 0xc6,                                         /* 6 disabled */
+    0x02, 0xc7,                                         /* 7 disabled */
+    0x03, 0x88, 0x80,                                   /* PCIe down 8 */
+    0x03, 0x89, 0x80,                                   /* PCIe down 9 */
+    0x05, 0x8a, 0x50, 0x00, 0x00,                       /* DP in 10 */
+    0x05, 0x8b, 0x50, 0x00, 0x00,                       /* DP in 11 */
+};
+
+QEMU_BUILD_BUG_ON(sizeof(tb3_tr_host_entries) > 64);
+
+/* Byte offsets of the port-B entries, disabled on a 2C controller. */
+static const uint8_t tb3_tr_host_port_b[] = { 17, 25, 42, 50 };
+
+static const uint8_t tb3_dev_entries[] = {
+    0x08, 0x81, 0x80, 0x02, 0x80, 0x00, 0x00, 0x00,     /* lane 1 */
+    0x08, 0x82, 0x90, 0x01, 0x80, 0x00, 0x00, 0x00,     /* lane 2 */
+    0x08, 0x83, 0x80, 0x04, 0x80, 0x01, 0x00, 0x00,     /* lane 3 */
+    0x08, 0x84, 0x90, 0x03, 0x80, 0x01, 0x00, 0x00,     /* lane 4 */
+    0x02, 0xc5,                                         /* 5 disabled */
+    0x0b, 0x86, 0x20, 0x01, 0x00, 0x8a, 0x00, 0x00,     /* PCIe up 6 */
+    0x00, 0x00, 0x00,
+    0x03, 0x87, 0x80,                                   /* PCIe down 7 */
+    0x05, 0x88, 0x50, 0x40, 0x00,                       /* DP out 8 */
+    0x02, 0xc9,                                         /* 9 disabled */
+    0x02, 0xca,                                         /* 10 disabled */
+    0x05, 0x8b, 0x50, 0x40, 0x00,                       /* DP out 11 */
+};
+
+QEMU_BUILD_BUG_ON(sizeof(tb3_dev_entries) > 64);
+
+void usb4_drom_build_tb3(USB4Router *r)
+{
+    uint8_t buf[DROM_BUF_MAX];
+    size_t pos = 0;
+    uint32_t crc;
+    USB4Tb3Host host = r->fabric ? r->fabric->cfg.tb3_host
+                                 : USB4_TB3_HOST_AR_LP;
+    const uint8_t *ent = r->is_host ? tb3_host_entries : tb3_dev_entries;
+    size_t nent = r->is_host ? sizeof(tb3_host_entries)
+                             : sizeof(tb3_dev_entries);
+    uint8_t tr[sizeof(tb3_tr_host_entries)];
+
+    if (r->is_host && host != USB4_TB3_HOST_AR_LP) {
+        memcpy(tr, tb3_tr_host_entries, sizeof(tr));
+        for (unsigned i = 0; host == USB4_TB3_HOST_TR_2C &&
+                             i < ARRAY_SIZE(tb3_tr_host_port_b); i++) {
+            tr[tb3_tr_host_port_b[i]] |= 0x40;  /* port disabled */
+        }
+        ent = tr;
+        nent = sizeof(tr);
+    }
+
+    memset(buf, 0, sizeof(buf));
+    for (unsigned i = 0; i < 8; i++) {
+        buf[1 + i] = r->uuid >> (8 * i);        /* UID, little-endian */
+    }
+    buf[0] = usb4_drom_crc8(buf + 1, 8);
+    pos = 13;
+    buf[pos++] = 1;                             /* Version */
+    pos += 2;                                   /* Length, below */
+    buf[pos++] = r->drom_vendor_id & 0xff;
+    buf[pos++] = r->drom_vendor_id >> 8;
+    buf[pos++] = r->drom_model_id & 0xff;
+    buf[pos++] = r->drom_model_id >> 8;
+    buf[pos++] = 1;                             /* hardware revision */
+    buf[pos++] = 1;                             /* NVM revision */
+    memcpy(buf + pos, ent, nent);
+    pos += nent;
+    pos += put_ascii(buf + pos, 0x1, r->vendor_name ? r->vendor_name : "");
+    pos += put_ascii(buf + pos, 0x2, r->model_name ? r->model_name : "");
+    assert(pos <= sizeof(buf));
+
+    buf[14] = (pos - 13) & 0xff;
+    buf[15] = ((pos - 13) >> 8) & 0xff;
+    crc = usb4_drom_crc32(buf + 13, pos - 13);
+    buf[9] = crc;
+    buf[10] = crc >> 8;
+    buf[11] = crc >> 16;
+    buf[12] = crc >> 24;
+
+    g_free(r->drom);
+    r->drom = g_malloc(pos);
+    memcpy(r->drom, buf, pos);
+    r->drom_len = pos;
+}
diff --git a/hw/usb4/usb4-fabric-int.h b/hw/usb4/usb4-fabric-int.h
new file mode 100644
index 0000000000000000000000000000000000000000..79318133246c91aca567aa98850e4749c6c97e30
--- /dev/null
+++ b/hw/usb4/usb4-fabric-int.h
@@ -0,0 +1,702 @@
+/*
+ * USB4 fabric - private definitions shared by the fabric source files
+ *
+ * Copyright (c) 2026 usb4-emu contributors
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Written from scratch for the usb4-emu project from the USB4
+ * Specification 2.0 ("Spec") and the USB4 Connection Manager Guide 2.0
+ * ("Guide"). Register layouts were cross-checked against tbtools
+ * registers.json (MIT).
+ *
+ * Only usb4-ctl.c, usb4-router.c, usb4-drom.c, usb4-fabric.c and
+ * usb4-tunnel.c include this header. None of them depend on QOM, so the
+ * standalone test harness in tests/usb4/ can link them with stubs.
+ */
+
+#ifndef HW_USB4_FABRIC_INT_H
+#define HW_USB4_FABRIC_INT_H
+
+#include "usb4-internal.h"
+
+/* ------------------------------------------------------------------ */
+/* Timer and clock abstraction (usb4-timer.c in QEMU, faked in tests)   */
+/* ------------------------------------------------------------------ */
+
+typedef struct USB4Timer USB4Timer;
+typedef void USB4TimerCB(void *opaque);
+
+USB4Timer *usb4_timer_new(USB4TimerCB *cb, void *opaque);
+void usb4_timer_mod_ms(USB4Timer *t, int64_t ms_from_now);
+void usb4_timer_del(USB4Timer *t);
+void usb4_timer_free(USB4Timer *t);
+/* Virtual time in ns, used for TMU LocalTime. */
+int64_t usb4_clock_ns(void);
+
+/* ------------------------------------------------------------------ */
+/* Big-endian helpers and control packet encoding (usb4-ctl.c)          */
+/* ------------------------------------------------------------------ */
+
+static inline uint32_t usb4_get_be32(const uint8_t *p)
+{
+    return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) |
+           ((uint32_t)p[2] << 8) | p[3];
+}
+
+static inline void usb4_put_be32(uint8_t *p, uint32_t v)
+{
+    p[0] = v >> 24;
+    p[1] = v >> 16;
+    p[2] = v >> 8;
+    p[3] = v;
+}
+
+static inline uint32_t usb4_ld_le32(const uint8_t *p)
+{
+    return p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) |
+           ((uint32_t)p[3] << 24);
+}
+
+static inline void usb4_st_le32(uint8_t *p, uint32_t v)
+{
+    p[0] = v;
+    p[1] = v >> 8;
+    p[2] = v >> 16;
+    p[3] = v >> 24;
+}
+
+/* Route String (Spec 6.4.2.2, Figure 6-5): 7 levels of 8 bits. */
+#define USB4_ROUTE_CM_BIT      (1ULL << 63)
+#define USB4_ROUTE_TOPO_MASK   0x00ffffffffffffffULL
+#define USB4_MAX_DEPTH         5
+
+static inline unsigned usb4_route_level(uint64_t route, unsigned level)
+{
+    return (route >> (8 * level)) & 0x3f;
+}
+
+/* Request DW3 fields, Spec Table 6-2 / 6-4. */
+#define USB4_REQ_ADDR(dw)   ((dw) & 0x1fff)
+#define USB4_REQ_SIZE(dw)   (((dw) >> 13) & 0x3f)
+#define USB4_REQ_ADP(dw)    (((dw) >> 19) & 0x3f)
+#define USB4_REQ_CS(dw)     (((dw) >> 25) & 0x3)
+#define USB4_REQ_SEQ(dw)    (((dw) >> 27) & 0x3)
+
+static inline uint32_t usb4_req_dw3(unsigned addr, unsigned size,
+                                    unsigned adp, unsigned cs, unsigned seq)
+{
+    return (addr & 0x1fff) | ((size & 0x3f) << 13) | ((adp & 0x3f) << 19) |
+           ((cs & 3) << 25) | ((seq & 3) << 27);
+}
+
+/* Notification event codes, Spec Table 6-12. */
+enum {
+    USB4_ERR_CONN = 0,
+    USB4_ERR_LINK = 1,
+    USB4_ERR_ADDR = 2,
+    USB4_ERR_ADP = 4,
+    USB4_HP_ACK = 7,
+    USB4_ERR_ENUM = 8,
+    USB4_ERR_NUA = 9,
+    USB4_ERR_LEN = 11,
+    USB4_ERR_HEC = 12,
+    USB4_ERR_FC = 13,
+    USB4_ERR_PLUG = 14,
+    USB4_ERR_LOCK = 15,
+    USB4_EV_DP_BW = 32,
+    USB4_EV_ROP_CMPLT = 33,
+    USB4_EV_POP_CMPLT = 34,
+};
+
+/* Notification DW3 PG field, Spec Table 6-6. */
+#define USB4_PG_NONE    0
+#define USB4_PG_PLUG    2
+#define USB4_PG_UNPLUG  3
+
+const char *usb4_ctl_cs_name(unsigned cs);
+const char *usb4_ctl_pdf_name(unsigned pdf);
+const char *usb4_ctl_event_name(unsigned ev);
+/* Format up to n dwords as hex into buf (size >= n * 9 + 1). */
+void usb4_ctl_hexdump(char *buf, size_t bufsz, const uint32_t *dw, unsigned n);
+
+/*
+ * Build a frame (big-endian dwords + CRC) from host-order dwords and
+ * deliver it to the host interface. @ndw excludes the CRC.
+ */
+void usb4_ctl_send(USB4Host *h, uint8_t pdf, const uint32_t *dw,
+                   unsigned ndw);
+
+/* ------------------------------------------------------------------ */
+/* Router model                                                         */
+/* ------------------------------------------------------------------ */
+
+/* Adapter kinds. Encodings for ADP_CS_2 are in Spec Table 8-10. */
+typedef enum USB4AdpKind {
+    USB4_ADP_NONE = 0,      /* not implemented: reads give ERR_ADDR */
+    USB4_ADP_LANE,
+    USB4_ADP_HI,            /* host interface adapter */
+    USB4_ADP_PCIE_DOWN,
+    USB4_ADP_PCIE_UP,
+    USB4_ADP_USB3_DOWN,     /* USB3 Gen X Downstream adapter */
+    USB4_ADP_USB3_UP,       /* USB3 Gen X Upstream adapter */
+    USB4_ADP_DP_IN,         /* DP IN adapter (tb3 routers, no function) */
+    USB4_ADP_DP_OUT,        /* DP OUT adapter (tb3 routers, no function) */
+} USB4AdpKind;
+
+#define USB4_MAX_ADAPTERS     64
+#define USB4_RTR_CS_DWORDS    64   /* supported Router CS address range */
+#define USB4_ADP_CS_DWORDS    64   /* supported Adapter CS address range */
+/*
+ * Storage for the tb3 dialect, whose captured config spaces are larger
+ * (docs/ICM-PROTOCOL.md 5.1: router dwords up to 0x1ec, DP IN adapter
+ * dwords up to 0xce; a tb3 device router under a software CM also has
+ * its second link controller port block at 0x213-0x2ec, observed on the
+ * Framework 13 with the TS3 Plus, usb4-tb3-sw-data.h).
+ */
+#define USB4_RTR_CS_STORE     0x2ed
+#define USB4_ADP_CS_STORE     0xd0
+#define USB4_MAX_PORTS        4    /* USB4 ports per router */
+#define USB4_LANE_MAX_HOPID   31
+#define USB4_PCIE_MAX_HOPID   8
+#define USB4_PCIE_HOPID       8    /* Guide Table 5-2 */
+
+/* Capability IDs, Spec Table 8-2 and Table 8-8. */
+#define USB4_CAP_LANE   0x01
+#define USB4_CAP_TMU    0x03
+#define USB4_CAP_PROTO  0x04
+#define USB4_CAP_VS     0x05
+#define USB4_CAP_PORT   0x06
+
+/*
+ * Capability placement (DW offsets). Kept in one place so a different
+ * layout can be tried quickly. The chain is followed by CMs (Spec 8.2.2,
+ * Guide 3.2.2), so the exact offsets are not part of the contract.
+ */
+#define USB4_RTR_CAP_TMU      0x1b  /* 26 DWs, after ROUTER_CS_26 */
+#define USB4_RTR_CAP_TMU_LEN  26
+#define USB4_ADP_CAP_LANE     0x10  /* LANE_ADP_CS_0..2 */
+#define USB4_ADP_CAP_LANE_LEN 3
+#define USB4_ADP_CAP_TMU      0x13  /* TMU_ADP_CS_0..9 */
+#define USB4_ADP_CAP_TMU_LEN  10
+#define USB4_ADP_CAP_PORT     0x20  /* PORT_CS_0..19, lane 0 only */
+#define USB4_ADP_CAP_PORT_LEN 20
+#define USB4_ADP_CAP_PCIE     0x10  /* ADP_PCIE_CS_0..1 */
+#define USB4_ADP_CAP_PCIE_LEN 2
+#define USB4_ADP_CAP_USB3     0x10  /* ADP_USB3_GX_CS_0..4 */
+#define USB4_ADP_CAP_USB3_LEN 5
+#define USB4_USB3_MAX_HOPID   8
+#define USB4_USB3_HOPID       8    /* Guide Table 5-4 */
+
+typedef struct USB4Router USB4Router;
+typedef struct USB4Port USB4Port;
+
+/*
+ * Captured register images (usb4-router-img.c). A router preset built
+ * from a hardware capture (the intel-adl host router, the asm2464 device
+ * router) keeps the captured configuration space layout. Image offsets
+ * are the captured dword offsets; dwords inside a capability the model
+ * implements are mapped onto the model's own offsets (so the register
+ * semantics stay shared), every other dword is stored as captured.
+ * The images are generated from observed data (tests/usb4/gen-*-data.py).
+ */
+typedef struct USB4ImgReg {
+    uint16_t off;
+    uint32_t val;
+} USB4ImgReg;
+
+typedef struct USB4ImgCap {
+    uint16_t off;           /* captured dword offset, 0: none */
+    uint16_t len;
+} USB4ImgCap;
+
+typedef struct USB4ImgAdapter {
+    USB4AdpKind kind;
+    uint8_t usb4_port;      /* lane: USB4 port; PCIe/USB3/DP: paired port */
+    uint8_t lane;
+    uint8_t max_hop;        /* ADP_CS_5 Max Input HopID */
+    uint16_t cs_size;       /* accessible Adapter CS dwords, 0: no image */
+    uint16_t counter_sets;  /* ADP_CS_1 Max Counter Sets */
+    USB4ImgCap lane_cap, tmu_cap, port_cap, proto_cap;
+    const USB4ImgReg *cs;
+    unsigned ncs;
+    const USB4ImgReg *path;
+    unsigned npath;
+} USB4ImgAdapter;
+
+typedef struct USB4ImgSB {
+    uint8_t reg;
+    uint8_t len;
+    uint8_t data[64];
+} USB4ImgSB;
+
+typedef struct USB4Image {
+    const USB4ImgReg *rtr;  /* Router CS, non-zero dwords */
+    unsigned nrtr;
+    unsigned rtr_cs_size;   /* accessible Router CS dwords */
+    USB4ImgCap rtr_tmu;     /* TMU Router Configuration Capability */
+    const USB4ImgAdapter *adp;  /* indexed by adapter number */
+    unsigned max_adapter;
+} USB4Image;
+
+typedef struct USB4Adapter {
+    uint8_t num;
+    USB4AdpKind kind;
+    uint8_t lane;            /* 0 or 1 for lane adapters */
+    USB4Port *port;          /* owning USB4 port for lane adapters */
+    uint8_t usb4_port;       /* PCIe down: USB4 port index it pairs with */
+    uint8_t max_hop;         /* Max Input HopID = Max Output HopID */
+    uint32_t cs[USB4_ADP_CS_STORE];
+    unsigned cs_size;        /* tb3: accessible Adapter CS dwords */
+    uint32_t *path;          /* 2 * (max_hop + 1) dwords */
+    bool reported_plugged;   /* last hot plug event sent was a plug */
+    /*
+     * Captured image (r->img): Adapter CS in the captured layout (cs_size
+     * dwords). Dwords that map to a capability this model implements
+     * live in cs[] at the model's offsets; the rest are stored here.
+     * NULL for an adapter the capture has no image of (model layout).
+     */
+    uint32_t *xcs;
+    const USB4ImgAdapter *img;
+} USB4Adapter;
+
+/* SB register space of a USB4 port, Spec Table 4-18 / 4-20. */
+#define USB4_SB_REGS 19
+typedef struct USB4SBReg {
+    uint8_t size;            /* 0: undefined register */
+    bool ro;
+    uint8_t data[64];
+} USB4SBReg;
+
+struct USB4Port {
+    USB4Router *router;
+    unsigned index;          /* 1-based USB4 port index in the router */
+    USB4Adapter *lane[2];
+    bool dfp;                /* downstream facing port */
+    USB4Port *partner;       /* port on the other side of the cable */
+    bool dpr;                /* Downstream Port Reset asserted */
+    bool link_cached;        /* DFP: link state last acted upon */
+    bool bonded;
+    bool bond_reported;      /* lane 1 hot unplug sent after bonding */
+    /*
+     * The router behind this port is still coming up after it lost the
+     * link (asm2464: about 590 ms, usb4-router-asm2464.c): no link yet.
+     */
+    bool link_hold;
+    /*
+     * Upstream Facing Port of a USB4 device router that gave up on the
+     * USB4 link and runs as a USB 3 device (docs/ICM-PROTOCOL.md 13.1):
+     * no USB4 link until it is plugged in again or powered on.
+     */
+    bool usb_mode;
+    USB4SBReg sb[USB4_SB_REGS];
+    /*
+     * intel-adl host model: one on-board retimer (index 1) between the
+     * port and the connector, with its own SB register space, and
+     * sideband transactions that complete after a delay.
+     */
+    bool has_retimer;
+    USB4SBReg rt_sb[USB4_SB_REGS];
+    USB4Timer *sb_timer;
+    USB4Adapter *sb_adapter;  /* lane 0 adapter with a pending request */
+};
+
+/* One pending Hot Plug Event (Spec 6.8). */
+typedef struct USB4HPEvent {
+    uint8_t adapter;
+    bool unplug;
+} USB4HPEvent;
+
+#define USB4_HP_QUEUE 16
+
+/*
+ * PCIe tunnel bookkeeping of a device router: the tunnel from the PCIe
+ * Downstream adapter of its parent router (host or device) to its own
+ * PCIe Upstream adapter.
+ */
+typedef struct USB4TunnelTrack {
+    USB4TunnelState state;
+    USB4TunnelState prev;     /* during usb4_fabric_reevaluate() */
+    USB4TunnelReason reason;
+    USB4Device *dev;          /* device the current state refers to */
+    USB4TunnelInputs last;    /* last inputs traced */
+    const char *why_down, *why_up;
+} USB4TunnelTrack;
+
+struct USB4Router {
+    USB4Fabric *fabric;
+    bool is_host;
+    USB4Dialect dialect;
+    USB4Device *dev;          /* device routers only */
+    USB4Port *up_port;        /* UFP of a device router */
+    unsigned ndfp;            /* downstream USB4 ports of a device router */
+    uint64_t phys_route;      /* Route String by position, for traces */
+    unsigned phys_depth;      /* depth by position (host 0) */
+    USB4TunnelTrack tunnel;   /* device routers: PCIe tunnel to PCIe Up */
+    USB4TunnelTrack usb3;     /* device routers: USB3 tunnel to USB3 Up */
+    USB4Port *tunnel_dfp;     /* parent DFP the tunnel came up through */
+    uint32_t cs[USB4_RTR_CS_STORE];
+    /*
+     * Captured image (usb4-router-img.c), NULL for a spec-derived router.
+     * xcs holds the Router CS dwords that are not mapped to the model.
+     */
+    const USB4Image *img;
+    /* intel-adl host model (usb4-router-adl.c) */
+    bool adl;
+    /* asm2464 device model (usb4-router-asm2464.c), captured */
+    bool asm2464;
+    USB4Timer *rr_timer;      /* asm2464: Router Ready after Enumerated */
+    USB4Timer *link_timer;    /* asm2464: link back after a link loss */
+    /* sideband transactions complete after a delay (port_sb_post) */
+    bool sb_delay;
+    /* asm4242 host model (usb4-router-asm.c), public-source preset */
+    bool asm4242;
+    USB4Timer *op_timer;      /* Router Operation completion delay */
+    uint32_t *xcs;
+    unsigned xcs_size;
+    unsigned max_adapter;
+    uint8_t upstream_adapter;
+    USB4Adapter adp[USB4_MAX_ADAPTERS];
+    unsigned nports;
+    USB4Port ports[USB4_MAX_PORTS];
+    /* Hot plug event machine (Spec 6.8) */
+    USB4HPEvent hpq[USB4_HP_QUEUE];
+    unsigned hpq_len;
+    bool hp_outstanding;      /* hpq[0] sent and awaiting HP_ACK */
+    unsigned hp_retries;
+    USB4Timer *hp_timer;
+    /* Router operation state */
+    unsigned pcie_entry_index;  /* Get PCIe Downstream Entry Mapping */
+    uint32_t caps_enabled;      /* Set Capabilities bitmap */
+    /* TMU register lock (Spec 8.2.1.2.1) */
+    uint64_t tmu_locked_time;
+    /* DROM image */
+    uint8_t *drom;
+    size_t drom_len;
+    /* Identity */
+    uint16_t vendor_id;
+    uint16_t product_id;
+    uint64_t uuid;
+    const char *vendor_name;
+    const char *model_name;
+    /*
+     * tb3 dialect (docs/ICM-PROTOCOL.md 5.3, 5.4, R19): DROM header
+     * vendor and model IDs (the ICM's endpoint name block repeats them),
+     * device RTD3 support flag, and the EEPROM bit-bang state. The DROM
+     * sits at EEPROM byte offset 0x210; r->uuid is the DROM UID.
+     */
+    uint16_t drom_vendor_id;
+    uint16_t drom_model_id;
+    bool rtd3;
+    /*
+     * R20 read-only DMA port on the Host Interface adapter. Only the tb3
+     * device router under a software CM has it (usb4-router-tb3.c).
+     */
+    bool dma_port;
+    /*
+     * tb3 device router under a software CM: a PCIe tunnel to this
+     * router came up since its last reset (the PCIe adapters' bit 19
+     * clears then, observed: usb4-router-tb3.c).
+     */
+    bool pcie_trained;
+    struct {
+        bool active;          /* enabled and chip selected */
+        unsigned nbits;       /* bits clocked since chip select */
+        uint32_t shift_in;    /* command and address bits */
+        uint8_t cmd;
+        uint16_t addr;        /* next byte to send */
+        uint8_t out_byte;
+        unsigned out_bit;     /* bits of out_byte already sent */
+        bool data_out;        /* level on control bit 3 */
+    } eeprom;
+};
+
+/* Device routers in one fabric, at any depth. */
+#define USB4_MAX_ROUTERS 16
+
+struct USB4Fabric {
+    USB4Host *host;
+    USB4FabricConfig cfg;
+    USB4Router *hr;                          /* host router */
+    /*
+     * Device routers in attach order. A router is attached only below
+     * an attached parent, so a parent always precedes its children.
+     */
+    USB4Router *dr[USB4_MAX_ROUTERS];
+    unsigned ndr;
+    uint16_t pcie_rid[USB4_MAX_PORTS + 1];   /* Get PCIe DS Entry Mapping */
+    bool in_tx;                              /* inside usb4_fabric_tx_frame */
+    USB4ICM *icm;                            /* tb3-alpine-ridge firmware CM */
+    bool eval_hold;                          /* inside usb4_fabric_reset */
+    /*
+     * Firmware CM busy announcing (ICM-PROTOCOL.md 6.2): config requests
+     * wait here and are served, in order, when the hold ends.
+     */
+    bool cfg_hold;
+    unsigned nheld;
+    struct {
+        uint8_t pdf;
+        uint16_t len;
+        uint8_t data[USB4_CTL_MAX_FRAME];
+    } held[16];
+    bool preos_window;                       /* firmware CM still in charge */
+};
+
+/*
+ * Advertised USB4 version (ROUTER_CS_4[31:24], Spec Table 8-3).
+ * Windows 11's first CM implements Guide 1.0, so routers report 1.0.
+ */
+#define USB4_VERSION_1_0  0x20
+#define USB4_VERSION_2_0  0x40
+
+/* Lane adapter states, Spec Table 8-12 LANE_ADP_CS_1.Adapter State. */
+enum {
+    USB4_LANE_DISABLED = 0,
+    USB4_LANE_TRAINING = 1,
+    USB4_LANE_CL0 = 2,
+    USB4_LANE_CLD = 7,
+};
