diff --git a/include/hw/acpi/pcihp.h b/include/hw/acpi/pcihp.h
index efce5fd2e10da14d46afa94771dbf4158b91f8a9..53d37d3281ff0e61d031cbee93d1f1fb4edfe1a8 100644
--- a/include/hw/acpi/pcihp.h
+++ b/include/hw/acpi/pcihp.h
@@ -60,8 +60,47 @@ typedef struct AcpiPciHpState {
     uint16_t io_len;
     bool use_acpi_hotplug_bridge;
     bool use_acpi_root_pci_hotplug;
+    Object *owner;              /* the ACPI device that raises the GPE */
 } AcpiPciHpState;
 
+/*
+ * A cold-plugged PCI device implementing this interface takes part in
+ * ACPI PCI hot-plug on its own slot while it stays realized. QEMU does
+ * not otherwise describe cold-plugged bridges as hot-pluggable. The
+ * device decides whether its slot gets _EJ0 and notifications, raises
+ * the notifications itself with acpi_pcihp_slot_owner_notify(), and is
+ * told about a guest eject (_EJ0) instead of being unrealized. Where a
+ * normal slot gets a Device Check, an owner's slot gets a Bus Check:
+ * the guest re-enumerates the owner and everything below it, as after
+ * a platform's hot-plug event on a root port.
+ * (usb4-emu: the root bridge of an emulated Thunderbolt controller,
+ * whose whole tree leaves the guest's view and comes back.)
+ */
+#define TYPE_ACPI_PCIHP_SLOT_OWNER "acpi-pcihp-slot-owner"
+typedef struct AcpiPciHpSlotOwnerClass {
+    InterfaceClass parent_class;
+    /* The slot is described and handled as hot-pluggable. */
+    bool (*hotpluggable)(PCIDevice *dev);
+    /* The guest ejected the slot (_EJ0). The device stays realized. */
+    void (*ejected)(PCIDevice *dev);
+} AcpiPciHpSlotOwnerClass;
+DECLARE_CLASS_CHECKERS(AcpiPciHpSlotOwnerClass, ACPI_PCIHP_SLOT_OWNER,
+                       TYPE_ACPI_PCIHP_SLOT_OWNER)
+
+/* Notify values (ACPI 6.5 table 5.207) a slot owner can raise. */
+#define ACPI_PCIHP_NOTIFY_BUS_CHECK 0
+#define ACPI_PCIHP_NOTIFY_EJECT_REQUEST 3
+
+/*
+ * Raise a Bus Check or an Eject Request on the slot of @dev, a slot
+ * owner on a bus with ACPI PCI hot-plug. False (with @errp set) if the
+ * slot has no ACPI hot-plug.
+ */
+bool acpi_pcihp_slot_owner_notify(PCIDevice *dev, uint32_t event,
+                                  Error **errp);
+/* The slot of @dev is described with ACPI hot-plug (_EJ0, DVNT). */
+bool acpi_pcihp_slot_owner_has_hotplug(PCIDevice *dev);
+
 void acpi_pcihp_init(Object *owner, AcpiPciHpState *,
                      MemoryRegion *io, uint16_t io_base);
 
diff --git a/include/hw/nvme/nvme-test-hook.h b/include/hw/nvme/nvme-test-hook.h
new file mode 100644
index 0000000000000000000000000000000000000000..fdcefefa036553849dbf7643cee560d8bae83582
--- /dev/null
+++ b/include/hw/nvme/nvme-test-hook.h
@@ -0,0 +1,120 @@
+/*
+ * Test-only fault hook of the NVMe controller model (usb4-emu harness).
+ *
+ * Copyright (c) 2026 usb4-emu contributors
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Written from scratch for the usb4-emu project. Design and user
+ * interface: docs/HARNESS.md in the usb4-emu repository.
+ *
+ * A test harness (hw/usb4/usb4-harness.c) installs one hook on an "nvme"
+ * device before or after it is realized. The controller then calls the
+ * hook synchronously at four points: when a command has been fetched
+ * from a submission queue (before it executes), just before a completion
+ * is queued for posting, on every BAR0 MMIO access and on every change of
+ * its INTx level. With no hook installed (the default) none of this code
+ * runs and the controller behaves exactly as upstream QEMU.
+ *
+ * Held commands: a hook may hold a command at fetch (it has not executed;
+ * releasing it executes it then, so its data transfer happens at release)
+ * or at completion (it executed; releasing it posts the completion). A
+ * held command occupies its submission queue slot as an outstanding
+ * command would. A controller reset, queue deletion or unrealize discards
+ * held commands, as a real reset discards outstanding ones, and tells the
+ * hook through @dropped.
+ */
+
+#ifndef HW_NVME_TEST_HOOK_H
+#define HW_NVME_TEST_HOOK_H
+
+#include "exec/hwaddr.h"
+
+typedef struct PCIDevice PCIDevice;
+
+typedef enum NvmeTestAction {
+    NVME_TEST_PASS = 0,     /* continue normally */
+    NVME_TEST_HOLD,         /* hold until nvme_test_release() */
+    /* fetch: never execute or complete it; completion: never post it */
+    NVME_TEST_DROP,
+} NvmeTestAction;
+
+/* A submission queue entry as the hook sees it. */
+typedef struct NvmeTestCmd {
+    /*
+     * Unique per fetch across every controller of the process, so a token
+     * of a removed controller never names a command of its replacement.
+     */
+    uint64_t token;
+    uint16_t sqid;
+    uint16_t cid;
+    uint8_t opcode;
+    uint32_t nsid;
+    uint32_t cdw10, cdw11, cdw12, cdw13, cdw14, cdw15;
+} NvmeTestCmd;
+
+typedef struct NvmeTestHookOps {
+    /* A command was fetched and is about to execute. */
+    NvmeTestAction (*fetched)(void *opaque, PCIDevice *dev,
+                              const NvmeTestCmd *cmd);
+    /*
+     * Its completion is about to be queued for posting. *@status (the
+     * Status Field without the phase tag) and *@dw0 (completion dword 0)
+     * may be changed.
+     */
+    NvmeTestAction (*completing)(void *opaque, PCIDevice *dev,
+                                 const NvmeTestCmd *cmd, uint16_t *status,
+                                 uint32_t *dw0);
+    /* Every BAR0 read: returns the value the guest sees. */
+    uint64_t (*mmio_read)(void *opaque, PCIDevice *dev, hwaddr addr,
+                          unsigned size, uint64_t val);
+    /* Every BAR0 write, before it takes effect: false drops it. */
+    bool (*mmio_write)(void *opaque, PCIDevice *dev, hwaddr addr,
+                       uint64_t val, unsigned size);
+    /* INTx: @level is what the controller drives; returns the pin level. */
+    bool (*intx)(void *opaque, PCIDevice *dev, bool level);
+    /* A held command was discarded by a reset or queue deletion. */
+    void (*dropped)(void *opaque, PCIDevice *dev, uint64_t token);
+    /* The controller is being unrealized; the hook is removed. */
+    void (*detach)(void *opaque, PCIDevice *dev);
+    /*
+     * The controller was reset, after its held commands were discarded
+     * (and reported to @dropped). @function: a function-level reset (PCI
+     * reset, FLR, unrealize); otherwise a controller reset (CC.EN 1 to 0,
+     * or nvme_test_reset_controller()). Called from inside the reset, which
+     * may be an MMIO or config write: no draining or device lifecycle work.
+     */
+    void (*reset)(void *opaque, PCIDevice *dev, bool function);
+} NvmeTestHookOps;
+
+/* Install (or with @ops NULL remove, releasing what is held) the hook. */
+void nvme_test_set_hook(PCIDevice *dev, const NvmeTestHookOps *ops,
+                        void *opaque);
+/*
+ * Release held command @token (0: every held command). Asynchronous: the
+ * command executes or its completion is queued from a bottom half.
+ */
+void nvme_test_release(PCIDevice *dev, uint64_t token);
+/*
+ * Run released commands now, wait for their block I/O and post their
+ * completions before returning. Not from inside a hook callback.
+ *
+ * Waiting polls the main AioContext, which runs other bottom halves: the
+ * caller must keep device lifecycle work (removal of this controller)
+ * out while it runs. The controller is referenced throughout and checked
+ * after every wait; returns false, having stopped early, if it was reset
+ * or unrealized meanwhile.
+ */
+bool nvme_test_flush(PCIDevice *dev);
+/*
+ * A controller reset as if CC.EN went from 1 to 0 (no-op while disabled):
+ * outstanding and held commands are discarded and CSTS.RDY clears. It
+ * drains the controller's block I/O like the guest-driven reset does.
+ */
+void nvme_test_reset_controller(PCIDevice *dev);
+/* A BAR0 write that bypasses the hook (to replay a deferred write). */
+void nvme_test_mmio_write(PCIDevice *dev, hwaddr addr, uint64_t val,
+                          unsigned size);
+/* Number of held commands. */
+unsigned nvme_test_held(PCIDevice *dev);
+
+#endif
