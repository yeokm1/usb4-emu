@@ -0,0 +1,39 @@
+#!/bin/sh
+# Real host conformance check of the intel-adl host model
+# (docs/USB4-HOSTS.md). Needs the extracted Framework 13 capture
+# (tests/captures/framework13-12th/linux-ts3plus/*.tar.gz in the outer
+# repository), passed as $1 or in ADL_CAPTURE.
+#   scripts/msys2-shell.sh ".../tests/usb4/run-adl-conformance.sh <dir>"
+# ADL_VERBOSE=1 lists every mismatch, ADL_TOP=n the n worst registers,
+# ADL_MIN_MATCH=pct fails below that share of matching dwords. Arguments
+# after the capture directory go to adl-replay.py (device routers:
+# run-asm2464-conformance.sh).
+# Copyright (c) 2026 usb4-emu contributors. SPDX-License-Identifier: GPL-2.0-only
+set -e
+here="$(cd "$(dirname "$0")" && pwd)"
+top="$here/../.."
+out="${OUT:-$here/build}"
+cap="${1:-$ADL_CAPTURE}"
+[ $# -gt 0 ] && shift
+if [ -z "$cap" ]; then
+    echo "usage: $0 <extracted capture dir>" >&2
+    exit 2
+fi
+mkdir -p "$out/trace"
+python3 "$here/gen-trace-stub.py" "$top/hw/usb4/trace-events" \
+    "$out/trace/trace-hw_usb4.h"
+python3 "$here/adl-replay.py" "$cap" "$out/adl-replay.txt" "$@"
+gcc -std=gnu11 -O1 -g -Wall -Wextra -Wno-unused-parameter \
+    -Wno-sign-compare -Wno-missing-field-initializers -Wno-unused-function \
+    -I"$here" -I"$here/stub" -I"$out" -I"$top/include" -I"$top" \
+    -I"$top/hw/usb4" $(pkg-config --cflags glib-2.0) \
+    "$here/adl-conformance.c" \
+    "$top/hw/usb4/usb4-ctl.c" "$top/hw/usb4/usb4-fabric.c" \
+    "$top/hw/usb4/usb4-router.c" "$top/hw/usb4/usb4-router-tb3.c" \
+    "$top/hw/usb4/usb4-router-adl.c" "$top/hw/usb4/usb4-router-asm.c" \
+    "$top/hw/usb4/usb4-router-img.c" "$top/hw/usb4/usb4-router-asm2464.c" \
+    "$top/hw/usb4/usb4-preos.c" \
+    "$top/hw/usb4/usb4-drom.c" \
+    "$top/hw/usb4/usb4-tunnel.c" "$top/hw/usb4/usb4-fabric-usb3.c" \
+    $(pkg-config --libs glib-2.0) -o "$out/adl-conformance"
+"$out/adl-conformance" "$out/adl-replay.txt"
