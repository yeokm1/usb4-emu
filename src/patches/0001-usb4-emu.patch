+/* Hook 7: namespace layout (NSID 2 only, then two) and NN. */
+static void test_namespaces(void)
+{
+    g_autofree char *img = make_img();
+    g_autofree char *img2 = make_img();
+    g_autofree char *drive1 = g_strdup_printf("-drive if=none,id=disk1,"
+                                              "file=%s,format=raw", img2);
+    Nv nv;
+    QTestState *qts;
+    uint32_t list[4], nn;
+    uint16_t cid;
+
+    qts = tp_start(img, ",nvme-drive=,nvme-namespaces=2:disk0,nvme-nn=4", "",
+                   &nv);
+    nv_bringup(&nv);
+    nv_admin_ok(&nv, 0x06, 0, RAM_ID, 1, 0);            /* controller */
+    qtest_memread(qts, RAM_ID + 516, &nn, 4);
+    g_assert_cmpuint(nn, ==, 4);
+    nv_admin_ok(&nv, 0x06, 0, RAM_ID, 2, 0);            /* active NSIDs */
+    qtest_memread(qts, RAM_ID, list, sizeof(list));
+    g_assert_cmpuint(list[0], ==, 2);
+    g_assert_cmpuint(list[1], ==, 0);
+    qtest_memset(qts, RAM_BUF, SENTINEL, 512);
+    cid = nv_read(&nv, 2, 0, RAM_BUF);
+    g_assert(nv_poll(&nv, 1, cid, NULL, NULL, 2000));
+    g_assert(buf_is(qts, RAM_BUF, PATTERN));
+
+    /* Reconnect: the fresh endpoint gets the namespace (drive released). */
+    qom_set_str(qts, TP_PATH, "tunnel", "surprise");
+    g_assert_cmpuint(wait_stage(qts, "removed"), ==, 1);
+    qom_set_str(qts, TP_PATH, "tunnel", "up");
+    qtest_clock_step(qts, 300 * 1000 * 1000);
+    g_assert_cmpuint(wait_stage(qts, "inserted"), ==, 2);
+    cfg_writel(qts, 1, 0, 0x10, (uint32_t)WIN_MEM);
+    cfg_writel(qts, 1, 0, 0x14, 0);
+    cfg_writel(qts, 1, 0, 0x04, 0x0006);
+    nv_reg_init(&nv, qts, WIN_MEM);
+    nv_bringup(&nv);
+    nv_admin_ok(&nv, 0x06, 0, RAM_ID, 2, 0);
+    qtest_memread(qts, RAM_ID, list, sizeof(list));
+    g_assert_cmpuint(list[0], ==, 2);
+    qtest_quit(qts);
+
+    /* Several namespaces. */
+    qts = tp_start(img, ",nvme-drive=,\"nvme-namespaces=2:disk0;5:disk1\"",
+                   drive1, &nv);
+    nv_bringup(&nv);
+    nv_admin_ok(&nv, 0x06, 0, RAM_ID, 2, 0);
+    qtest_memread(qts, RAM_ID, list, sizeof(list));
+    g_assert_cmpuint(list[0], ==, 2);
+    g_assert_cmpuint(list[1], ==, 5);
+    g_assert_cmpuint(list[2], ==, 0);
