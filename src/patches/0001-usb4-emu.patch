+static void test_isr_autoclear(void)
+{
+    T *t = t_start("pc", NULL);
+
+    rings_setup(t, 8, 8);
+    rx_post(t, 2);
+    tx_queue(t, 9, 8, 1);
+    tx_doorbell(t);
+    /* Spec Table 12-28, Disable ISR Auto-Clear = 0: read clears */
+    g_assert_cmphex(isr0(t), ==, CAUSE_TX0 | CAUSE_RX0);
+    g_assert_cmphex(isr0(t), ==, 0);
+    /* ISS sets, read clears */
+    wr(t, ISS0, 1u << 5);
+    g_assert_cmphex(isr0(t), ==, 1u << 5);
+    g_assert_cmphex(isr0(t), ==, 0);
+    /* Masking does not hide status (polling) */
+    wr(t, IMC0, 0xffffffff);
+    tx_queue(t, 10, 8, 1);
+    tx_doorbell(t);
+    g_assert_cmphex(isr0(t), ==, CAUSE_TX0 | CAUSE_RX0);
+    t_stop(t);
+}
+
+static void test_isr_noautoclear(void)
+{
+    T *t = t_start("pc", NULL);
+
+    rings_setup(t, 8, 8);
+    wr(t, HI_CONTROL, DISABLE_ISR_AUTOCLR);
+    g_assert_cmphex(rd(t, HI_CONTROL), ==, DISABLE_ISR_AUTOCLR);
+    rx_post(t, 2);
+    tx_queue(t, 9, 8, 1);
+    tx_doorbell(t);
+    /* Reads are non-destructive; ISC is the only software clear */
+    g_assert_cmphex(isr0(t), ==, CAUSE_TX0 | CAUSE_RX0);
+    g_assert_cmphex(isr0(t), ==, CAUSE_TX0 | CAUSE_RX0);
+    wr(t, ISC0, CAUSE_TX0);
+    g_assert_cmphex(isr0(t), ==, CAUSE_RX0);
+    wr(t, ISS0, 1u << 3);
+    g_assert_cmphex(isr0(t), ==, CAUSE_RX0 | (1u << 3));
+    wr(t, ISC0, 0xffffffff);
+    g_assert_cmphex(isr0(t), ==, 0);
+    /* The ISR register itself ignores writes */
+    wr(t, ISS0, 1);
+    wr(t, ISR0, 0xffffffff);
+    g_assert_cmphex(isr0(t), ==, 1);
+    t_stop(t);
+}
