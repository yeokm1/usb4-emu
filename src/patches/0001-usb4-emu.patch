+/* R7: MSI-X vectors per ring and the Intel auto-clear bit */
+static void test_msix_autoclear(void)
+{
+    uint32_t w[64], dr = 0x00000003;
+    uint64_t msg = 0;
+    T *t = t_start(NULL, false);
+
+    qpci_msix_enable(t->dev);
+    g_assert_cmpuint(qpci_msix_table_size(t->dev), ==, 16);
+    g_assert_cmpuint(t->dev->msix_table_bar.addr, !=, t->bar.addr);
+    msg = guest_alloc(&t->alloc, 4);
+    /* table entry 1: address, data, unmasked */
+    qpci_io_writel(t->dev, t->dev->msix_table_bar,
+                   t->dev->msix_table_off + 16 + 0, (uint32_t)msg);
+    qpci_io_writel(t->dev, t->dev->msix_table_bar,
+                   t->dev->msix_table_off + 16 + 4, msg >> 32);
+    qpci_io_writel(t->dev, t->dev->msix_table_bar,
+                   t->dev->msix_table_off + 16 + 8, 0x1234);
+    qpci_io_writel(t->dev, t->dev->msix_table_bar,
+                   t->dev->msix_table_off + 16 + 12, 0);
+    /* RX ring 0 (cause 12) on vector 1, as captured (0x38c44) */
+    wr(t, 0x38c44, 0x00010000);
+    rings_setup(t);
+
+    /*
+     * auto-clear, set by the client as Linux does with MSI-X (R7; the
+     * power-on value 0x01000012 has it clear, 13.5): delivery clears
+     * the status bit
+     */
+    g_assert_cmphex(rd(t, DMA_MISC) & 4, ==, 0);
+    wr(t, DMA_MISC, 0x01000016);
+    g_assert_cmphex(rd(t, DMA_MISC), ==, 0x01000016);
+    icm_cmd(t, &dr, 1);
+    g_assert_cmpuint(qtest_readl(t->qts, msg), ==, 0x1234);
+    g_assert_cmphex(rd(t, ISR0) & (1u << 12), ==, 0);
+    icm_expect(t, PDF_ICM_RESP, w);
+
+    /*
+     * Vector masked: the message is pending and the status stays set
+     * (not read here: a read clears). Unmasking delivers the pending
+     * message, and that delivery clears the status too.
+     */
+    qtest_writel(t->qts, msg, 0);
+    qpci_io_writel(t->dev, t->dev->msix_table_bar,
+                   t->dev->msix_table_off + 16 + 12, 1);
+    icm_cmd(t, &dr, 1);
+    g_assert_cmpuint(qtest_readl(t->qts, msg), ==, 0);
+    qpci_io_writel(t->dev, t->dev->msix_table_bar,
+                   t->dev->msix_table_off + 16 + 12, 0);
+    g_assert_cmpuint(qtest_readl(t->qts, msg), ==, 0x1234);
+    g_assert_cmphex(rd(t, ISR0) & (1u << 12), ==, 0);
+    icm_expect(t, PDF_ICM_RESP, w);
+
+    /* auto-clear off: the bit stays until read */
+    wr(t, DMA_MISC, 0x01000012);
+    qtest_writel(t->qts, msg, 0);
+    icm_cmd(t, &dr, 1);
+    g_assert_cmpuint(qtest_readl(t->qts, msg), ==, 0x1234);
+    g_assert_cmphex(rd(t, ISR0) & (1u << 12), ==, 1u << 12);
+    g_assert_cmphex(rd(t, ISR0) & (1u << 12), ==, 0);
+    icm_expect(t, PDF_ICM_RESP, w);
+    t_stop(t);
+}
