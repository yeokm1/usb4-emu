+static void tb3_path(uint64_t route, unsigned adp, uint32_t e0, uint32_t e1,
+                     bool internal)
+{
+    uint32_t e[2] = { e0, e1 };
+
+    if (internal) {
+        CHECK(usb4_fabric_cfg_write(fab, route, USB4_CS_PATH, adp, 16, 2, e),
+              "internal path write");
+        CHECK(usb4_fabric_cfg_read(fab, route, USB4_CS_PATH, adp, 16, 2, e) &&
+              e[0] == e0 && e[1] == e1, "internal path read back");
+    } else {
+        CHECK(wr(route, USB4_CS_PATH, adp, 16, 2, e) == 0, "path write");
+    }
+}
