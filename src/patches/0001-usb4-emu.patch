diff --git a/hw/usb4/usb4-acpi.c b/hw/usb4/usb4-acpi.c
new file mode 100644
index 0000000000000000000000000000000000000000..f356532ded842d9362dc8e65b7fc2235d7ca6027
--- /dev/null
+++ b/hw/usb4/usb4-acpi.c
@@ -0,0 +1,350 @@
+/*
+ * USB4 host emulation - ACPI objects for the usb4-generic profile
+ *
+ * Copyright (c) 2026 usb4-emu contributors
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Written from scratch for the usb4-emu project.
+ *
+ * What Windows needs before it adds the PCI\USB4_MS_CM hardware ID to a
+ * USB4 host interface (loading its in-box connection manager), per
+ * Microsoft "USB4 ACPI requirements" and the ACPI 6.4 specification:
+ *
+ *  1. \_SB._OSC, platform-wide OSPM capabilities UUID
+ *     0811B06E-4A27-44F9-8D60-3CBBC22E7B48 (ACPI 6.4 section 6.2.11.2),
+ *     granting "Native USB4 Support", DWORD 2 bit 18, when evaluated with
+ *     the Query flag clear.
+ *  2. \_SB._OSC, "Operating System Capabilities for USB" UUID
+ *     23A0D13A-26AB-486C-9C5F-0FFA525A575A, revision 1 (ACPI 6.4
+ *     section 6.2.11.3). DWORD 2 is reserved, DWORD 3 is the control
+ *     field: bit 0 USB3 tunneling, bit 1 DisplayPort tunneling, bit 2
+ *     PCIe tunneling, bit 3 inter-domain USB4 IP. The platform must grant
+ *     USB, DP and inter-domain; we grant all four.
+ *  3. _DSD on each tunneled PCIe port: device-properties UUID
+ *     DAFFD814-6EBA-4D8C-8A91-BC9BBF4AA301 with "usb4-host-interface"
+ *     (a reference to the host interface's ACPI node, whose name must
+ *     end in a digit 0-7) and "usb4-port-number". Microsoft "_DSD for
+ *     PCIe root ports" adds HotPlugSupportInD3 (UUID 6211E2C0-...) and
+ *     ExternalFacingPort (UUID EFCC06CC-...) for USB4/TBT root ports.
+ *
+ * The host interface node is the Device(Sxx) QEMU already emits for every
+ * cold-plugged PCI device (xx = devfn in hex), on the root bus and, since
+ * every cold-plugged bridge describes its secondary bus, below bridges
+ * too (\_SB.PCI0.S18.S00.S18.S00 for an NHI behind a switch). xx must end
+ * in 0-7: function 0 at an even slot (addr=0x2 -> S10, addr=0x4 -> S20),
+ * or slot 0 behind a bridge (S00).
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/error-report.h"
+#include "qom/object.h"
+#include "hw/pci/pci.h"
+#include "hw/pci/pci_bus.h"
+#include "hw/pci/pci_bridge.h"
+#include "hw/usb4/usb4-acpi.h"
+#include "usb4-internal.h"
+#include "trace.h"
+
+#define UUID_OSC_PLATFORM      "0811B06E-4A27-44F9-8D60-3CBBC22E7B48"
+#define UUID_OSC_USB           "23A0D13A-26AB-486C-9C5F-0FFA525A575A"
+#define UUID_DEVICE_PROPERTIES "DAFFD814-6EBA-4D8C-8A91-BC9BBF4AA301"
+#define UUID_MS_HOTPLUG_IN_D3  "6211E2C0-58A3-4AF3-90E1-927A4E0C55A4"
+#define UUID_MS_EXTERNAL_PORT  "EFCC06CC-73AC-4BC3-BFF0-76143807C389"
+
+/* ACPI 6.4 6.2.11.2 platform-wide capabilities DWORD 2 */
+#define OSC_PLATFORM_NATIVE_USB4    (1u << 18)
+/* ACPI 6.4 6.2.11.3 USB _OSC control DWORD 3 */
+#define OSC_USB_CONTROL_ALL         0xfu /* USB3, DP, PCIe, inter-domain */
+/* _OSC status DWORD 1 error bits (ACPI 6.4 6.2.11) */
+#define OSC_STATUS_UNRECOGNISED_UUID (1u << 2)
+#define OSC_STATUS_UNRECOGNISED_REV  (1u << 3)
+
+typedef struct USB4HostScan {
+    GSList *hosts;
+} USB4HostScan;
+
+static int usb4_acpi_scan_host(Object *obj, void *opaque)
+{
+    USB4HostScan *scan = opaque;
+
+    if (object_dynamic_cast(obj, TYPE_USB4_HOST)) {
+        scan->hosts = g_slist_append(scan->hosts, obj);
+    }
+    return 0;
+}
+
+static GSList *usb4_acpi_hosts(void)
+{
+    USB4HostScan scan = { 0 };
+
+    object_child_foreach_recursive(object_get_root(), usb4_acpi_scan_host,
+                                   &scan);
+    return scan.hosts;
+}
+
+/* A host without a readable "profile" property defaults to generic. */
+static bool usb4_acpi_host_is_generic(Object *host)
+{
+    g_autofree char *profile = NULL;
+
+    if (!object_property_find(host, "profile")) {
+        return true;
+    }
+    profile = object_property_print(host, "profile", false, NULL);
+    /* An unset profile is the default, usb4-generic. */
+    return !profile || !*profile || strstr(profile, "usb4-generic");
+}
+
+bool usb4_acpi_generic_present(void)
+{
+    GSList *hosts = usb4_acpi_hosts(), *l;
+    bool found = false;
+
+    for (l = hosts; l; l = l->next) {
+        if (usb4_acpi_host_is_generic(l->data)) {
+            found = true;
+        }
+    }
+    g_slist_free(hosts);
+    return found;
+}
+
+/*
+ * A tb3-alpine-ridge usb4-host with bios-assist=on exists: the platform
+ * keeps PCIe native hot-plug, PME and AER and grants the OS only LTR and
+ * DPC in PCI0._OSC (ICM-PROTOCOL.md 11.3, R30).
+ *
+ * Limitation (review 2 #3): the platform's ACPI hot-plug path (the TB
+ * GPE handler that notifies the root port with a bus check, 11.1) is not
+ * modelled, so an OS that honours this _OSC learns of a controller that
+ * powers up after boot only by rescanning. That matches the captured
+ * Linux Assist-on run (no re-enumeration). The grant applies to the whole
+ * PCI0 root, so it is never changed when a usb4-generic host shares the
+ * machine: that host's native CM relies on native hot-plug.
+ */
+bool usb4_acpi_tb3_assist_present(void)
+{
+    GSList *hosts = usb4_acpi_hosts(), *l;
+    bool found = false, generic = false;
+
+    for (l = hosts; l; l = l->next) {
+        if (usb4_acpi_host_is_generic(l->data)) {
+            generic = true;
+        } else if (object_property_find(l->data, "bios-assist") &&
+                   object_property_get_bool(l->data, "bios-assist", NULL)) {
+            found = true;
+        }
+    }
+    g_slist_free(hosts);
+    if (found && generic) {
+        warn_report_once("usb4: bios-assist ignored for PCI0._OSC: a "
+                         "usb4-generic host needs native PCIe hot-plug");
+    }
+    return found && !generic;
+}
+
+/*
+ * ACPI path of the Device(Sxx) node QEMU's DSDT builder gives a PCI
+ * device: \_SB.PCI0 then one Sxx per bridge level (build_pci_bridge_aml()
+ * describes the secondary bus of every cold-plugged bridge). NULL when
+ * the device is behind a hot-plugged bridge or on an expander root bus,
+ * where there is no such node.
+ */
+static char *usb4_acpi_pci_path(PCIDevice *d)
+{
+    GSList *chain = NULL, *l;
+    GString *path;
+    PCIBus *bus;
+
+    for (;;) {
+        chain = g_slist_prepend(chain, d);
+        bus = pci_get_bus(d);
+        if (pci_bus_is_root(bus)) {
+            break;
+        }
+        d = pci_bridge_get_device(bus);
+        if (!d || DEVICE(d)->hotplugged) {
+            g_slist_free(chain);
+            return NULL;
+        }
+    }
+    if (pci_bus_num(bus) != 0) {
+        g_slist_free(chain);    /* pxb: a different host bridge node */
+        return NULL;
+    }
+    path = g_string_new("\\_SB.PCI0");
+    for (l = chain; l; l = l->next) {
+        g_string_append_printf(path, ".S%.02X", ((PCIDevice *)l->data)->devfn);
+    }
+    g_slist_free(chain);
+    return g_string_free(path, false);
+}
+
+/* The usb4-host that owns @port, or the only usb4-host if unambiguous. */
+PCIDevice *usb4_host_for_tunnel_port(PCIDevice *port)
+{
+    GSList *hosts = usb4_acpi_hosts(), *l;
+    PCIDevice *match = NULL;
+
+    for (l = hosts; l; l = l->next) {
+        if ((Object *)usb4_host_get_port_tunnel(l->data, 1) == OBJECT(port) ||
+            (Object *)usb4_host_get_port_tunnel(l->data, 2) == OBJECT(port)) {
+            match = PCI_DEVICE(l->data);
+            break;
+        }
+    }
+    if (!match && hosts && !hosts->next) {
+        match = PCI_DEVICE(hosts->data);
+    }
+    g_slist_free(hosts);
+    return match;
+}
+
+static Aml *usb4_acpi_prop(const char *name, Aml *value)
+{
+    Aml *pkg = aml_package(2);
+
+    aml_append(pkg, aml_string("%s", name));
+    aml_append(pkg, value);
+    return pkg;
+}
+
+void usb4_acpi_build_tunnel_port_dsd(Aml *scope, PCIDevice *port,
+                                     uint32_t usb4_port, bool hp_d3,
+                                     bool external_facing)
+{
+    PCIDevice *host = usb4_host_for_tunnel_port(port);
+    g_autofree char *host_path = NULL;
+    Aml *dsd, *props;
+    int n;
+
+    if (host && usb4_acpi_host_is_generic(OBJECT(host))) {
+        host_path = usb4_acpi_pci_path(host);
+        if (!host_path) {
+            warn_report("usb4-host has no ACPI node (hot-plugged bridge or "
+                        "expander bus): no USB4 _DSD port mapping");
+        } else if ((host->devfn & 0xf) >= 8) {
+            warn_report("usb4-host at devfn 0x%02x: ACPI name S%02X does "
+                        "not end in 0-7; use an even slot (addr=0x2, "
+                        "0x4, ...) for the Windows USB4 CM",
+                        host->devfn, host->devfn);
+        }
+    }
+    trace_usb4_acpi_tunnel_port(object_get_canonical_path_component(
+                                    OBJECT(port)),
+                                host_path ? host_path : "(none)");
+
+    n = (host_path ? 1 : 0) + (hp_d3 ? 1 : 0) + (external_facing ? 1 : 0);
+    if (!n) {
+        return;
+    }
+    /* Package size must match exactly: (UUID, properties) pairs. */
+    dsd = aml_package(n * 2);
+    if (host_path) {
+        aml_append(dsd, aml_touuid(UUID_DEVICE_PROPERTIES));
+        props = aml_package(2);
+        aml_append(props, usb4_acpi_prop("usb4-host-interface",
+                                         aml_name("%s", host_path)));
+        aml_append(props, usb4_acpi_prop("usb4-port-number",
+                                         aml_int(usb4_port)));
+        aml_append(dsd, props);
+    }
+    if (hp_d3) {
+        aml_append(dsd, aml_touuid(UUID_MS_HOTPLUG_IN_D3));
+        props = aml_package(1);
+        aml_append(props, usb4_acpi_prop("HotPlugSupportInD3", aml_int(1)));
+        aml_append(dsd, props);
+    }
+    if (external_facing) {
+        aml_append(dsd, aml_touuid(UUID_MS_EXTERNAL_PORT));
+        props = aml_package(2);
+        aml_append(props, usb4_acpi_prop("ExternalFacingPort", aml_int(1)));
+        aml_append(props, usb4_acpi_prop("UID", aml_int(usb4_port)));
+        aml_append(dsd, props);
+    }
+    aml_append(scope, aml_name_decl("_DSD", dsd));
+}
+
+bool usb4_acpi_port_has_generic_host(PCIDevice *port)
+{
+    PCIDevice *host = usb4_host_for_tunnel_port(port);
+
+    return host && usb4_acpi_host_is_generic(OBJECT(host));
+}
+
+/*
+ * \_SB._OSC. Only bits we support are returned set; we never set the
+ * Capabilities Masked status bit, so OSPMs that treat it as a failure on
+ * a non-query call still see the native USB4 grant.
+ */
+static Aml *usb4_acpi_sb_osc(void)
+{
+    Aml *method, *if_plat, *if_usb, *else_usb, *else_unk, *if_rev, *ifx;
+    Aml *cdw1 = aml_name("CDW1");
+
+    method = aml_method("_OSC", 4, AML_NOTSERIALIZED);
+    aml_append(method, aml_create_dword_field(aml_arg(3), aml_int(0),
+                                              "CDW1"));
+
+    /* Platform-wide OSPM capabilities: grant Native USB4 Support only. */
+    if_plat = aml_if(aml_equal(aml_arg(0), aml_touuid(UUID_OSC_PLATFORM)));
+    {
+        aml_append(if_plat, aml_create_dword_field(aml_arg(3), aml_int(4),
+                                                   "CDW2"));
+        aml_append(if_plat, aml_and(aml_name("CDW2"),
+                                    aml_int(OSC_PLATFORM_NATIVE_USB4),
+                                    aml_name("CDW2")));
+        if_rev = aml_if(aml_lnot(aml_equal(aml_arg(1), aml_int(1))));
+        aml_append(if_rev, aml_or(cdw1,
+                                  aml_int(OSC_STATUS_UNRECOGNISED_REV),
+                                  cdw1));
+        aml_append(if_plat, if_rev);
+    }
+    aml_append(method, if_plat);
+
+    else_usb = aml_else();
+    {
+        /* USB _OSC: grant every tunneling type requested. */
+        if_usb = aml_if(aml_equal(aml_arg(0), aml_touuid(UUID_OSC_USB)));
+        {
+            if_rev = aml_if(aml_lnot(aml_equal(aml_arg(1), aml_int(1))));
+            aml_append(if_rev, aml_or(cdw1,
+                                      aml_int(OSC_STATUS_UNRECOGNISED_REV),
+                                      cdw1));
+            aml_append(if_usb, if_rev);
+
+            ifx = aml_if(aml_lnot(aml_lless(aml_arg(2), aml_int(3))));
+            aml_append(ifx, aml_create_dword_field(aml_arg(3), aml_int(8),
+                                                   "CDW3"));
+            aml_append(ifx, aml_and(aml_name("CDW3"),
+                                    aml_int(OSC_USB_CONTROL_ALL),
+                                    aml_name("CDW3")));
+            aml_append(if_usb, ifx);
+        }
+        aml_append(else_usb, if_usb);
+
+        else_unk = aml_else();
+        aml_append(else_unk, aml_or(cdw1,
+                                    aml_int(OSC_STATUS_UNRECOGNISED_UUID),
+                                    cdw1));
+        aml_append(else_usb, else_unk);
+    }
+    aml_append(method, else_usb);
+
+    aml_append(method, aml_return(aml_arg(3)));
+    return method;
+}
+
+void usb4_acpi_build_sb(Aml *sb_scope)
+{
+    bool generic = usb4_acpi_generic_present();
+
+    if (!generic) {
+        return;
+    }
+    trace_usb4_acpi_sb_osc(generic);
+    aml_append(sb_scope, usb4_acpi_sb_osc());
+    /* USB3 Down adapter <-> xHCI SS port mapping (usb4-usb3.c) */
+    usb4_acpi_build_usb3(sb_scope);
+}
