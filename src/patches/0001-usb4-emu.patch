index 0000000000000000000000000000000000000000..36d45584a898ada4139497cc2cac89817182e95c
--- /dev/null
+++ b/tests/usb4/gen-trace-stub.py
@@ -0,0 +1,36 @@
+#!/usr/bin/env python3
+# Copyright (c) 2026 usb4-emu contributors
+# SPDX-License-Identifier: GPL-2.0-only
+#
+# Generate a printf-based trace header from hw/usb4/trace-events for the
+# standalone fabric test (no QEMU tracing infrastructure needed).
+import re
+import sys
+
+src, dst = sys.argv[1], sys.argv[2]
+out = ['/* Generated by gen-trace-stub.py. Do not edit. */',
+       '#ifndef USB4_TRACE_STUB_H', '#define USB4_TRACE_STUB_H',
+       '#include <stdio.h>', '#include <inttypes.h>',
+       'extern int usb4_test_trace;']
+for line in open(src, encoding='utf-8'):
+    line = line.strip()
+    if not line or line.startswith('#'):
+        continue
+    m = re.match(r'(\w+)\((.*?)\)\s+(".*)$', line)
+    if not m:
+        sys.exit('cannot parse: ' + line)
+    name, args, fmt = m.groups()
+    names = []
+    if args.strip() != 'void':
+        for a in args.split(','):
+            names.append(a.strip().split()[-1].lstrip('*'))
+    call = ', '.join(names)
+    out.append('static inline void trace_%s(%s)' % (name, args))
+    out.append('{')
+    out.append('    if (usb4_test_trace) {')
+    out.append('        fprintf(stderr, "  [%s] " %s "\\n"%s);'
+               % (name, fmt, (', ' + call) if call else ''))
+    out.append('    }')
+    out.append('}')
+out.append('#endif')
+open(dst, 'w', encoding='utf-8').write('\n'.join(out) + '\n')
