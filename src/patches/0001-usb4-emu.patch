--- /dev/null
+++ b/hw/usb4/usb4-tunnel-port.c
@@ -0,0 +1,479 @@
+/*
+ * USB4 PCIe tunnel port: a gated pcie-root-port subclass (q35).
+ *
+ * Copyright (c) 2026 usb4-emu contributors
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Written from scratch for the usb4-emu project. Design reference:
+ * docs/ARCHITECTURE.md section 4.4 ("PCI integration") in the usb4-emu
+ * repository. The gate and the endpoint lifecycle are in
+ * usb4-tunnel-slot.c; this file supplies the PCIe native hot-plug slot
+ * mechanics, the ACPI _DSD and the USB4 DVSEC.
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/error-report.h"
+#include "qemu/units.h"
+#include "qom/object.h"
+#include "hw/core/qdev.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/core/hotplug.h"
+#include "hw/pci/pci.h"
+#include "hw/pci/pci_bridge.h"
+#include "hw/pci/pcie.h"
+#include "hw/pci/pcie_port.h"
+#include "hw/pci-bridge/gen_pcie_root_port.h"
+#include "hw/acpi/acpi_aml_interface.h"
+#include "hw/acpi/pci.h"
+#include "hw/usb4/usb4-acpi.h"
+#include "usb4-tunnel-slot.h"
+#include "trace.h"
+
+OBJECT_DECLARE_TYPE(USB4TunnelPort, USB4TunnelPortClass, USB4_TUNNEL_PORT)
+
+struct USB4TunnelPortClass {
+    PCIERootPortClass parent_class;
+
+    DeviceRealize parent_realize;
+    DeviceUnrealize parent_unrealize;
+    void (*parent_config_write)(PCIDevice *d, uint32_t addr, uint32_t val,
+                                int len);
+    hotplug_fn parent_unplug;
+};
+
+struct USB4TunnelPort {
+    GenPCIERootPort parent_obj;
+
+    USB4TunnelSlot slot;
+
+    uint32_t usb4_port_number;
+    bool acpi_hotplug_d3;
+    bool acpi_external_facing;
+    bool usb4_dvsec;
+};
+
+#define TP_OF(ts) container_of(ts, USB4TunnelPort, slot)
+
+#define TP_DEFAULT_BUS_RESERVE  8
+#define TP_DEFAULT_MEM_RESERVE  (8 * MiB)
+#define TP_DEFAULT_IO_RESERVE   (4 * KiB)
+
+/* ------------------------------------------------------------------ */
+/* PCIe native hot-plug slot mechanics                                  */
+/* ------------------------------------------------------------------ */
+
+/*
+ * Shared with usb4-tunnel-dsp (a PCIe switch downstream port with the
+ * same slot mechanics).
+ */
+void usb4_pcie_slot_surprise_remove(USB4TunnelSlot *ts)
+{
+    /* Calls back into the bridge's unplug hook for the endpoint. */
+    pcie_cap_slot_surprise_remove(ts->bridge);
+}
+
+void usb4_pcie_slot_request_eject(USB4TunnelSlot *ts, Error **errp)
+{
+    pcie_cap_slot_unplug_request_cb(HOTPLUG_HANDLER(ts->bridge),
+                                    DEVICE(ts->ep), errp);
+}
+
+/*
+ * A hot insert asks the guest to power the slot with Presence Detect
+ * Changed plus Attention Button Pressed (stock pcie_cap_slot_plug_cb).
+ * Windows initialises its hot-plug controller late in boot: it clears
+ * the pending status, disables and re-enables slot interrupts and leaves
+ * an occupied slot powered off, so an endpoint that arrived while the
+ * CM was starting is never powered (observed with Windows 11 26300).
+ * While a hot-inserted endpoint has not been powered on by the guest,
+ * re-arming Hot-Plug and Attention Button interrupts repeats the
+ * attention button request, a bounded number of times. A guest that has
+ * powered the slot once owns it from then on (explicit guest slot
+ * commands win).
+ */
+#define TP_POWER_RETRIES 3
+#define TP_ABP_ARMED (PCI_EXP_SLTCTL_HPIE | PCI_EXP_SLTCTL_ABPE)
+
+void usb4_pcie_slot_after_insert(USB4TunnelSlot *ts, bool cold)
+{
+    PCIDevice *pd = ts->bridge;
+    uint16_t sltctl, sltsta;
+
+    ts->power_retries = cold ? 0 : TP_POWER_RETRIES;
+    if (cold) {
+        return;
+    }
+    /*
+     * The stock PCIe plug path reports Attention Button Pressed along
+     * with Presence Detect Changed. Windows needs the button press to
+     * power up a slot it left off (indicator off), but treats it as an
+     * eject request when the power indicator is still on or blinking,
+     * e.g. after an eject request that timed out, or when the slot is
+     * still powered, e.g. after a surprise removal (observed with the
+     * pre-OS CM: Windows tears the firmware's tunnels down and builds
+     * them again, and powered the slot off 5 s after the button press).
+     * Withdraw the button press in those cases; presence change remains.
+     */
+    pcie_cap_slot_get(pd, &sltctl, &sltsta);
+    if ((sltctl & PCI_EXP_SLTCTL_PIC) != PCI_EXP_SLTCTL_PWR_IND_OFF ||
+        !(sltctl & PCI_EXP_SLTCTL_PCC)) {
+        pci_word_test_and_clear_mask(pd->config + pd->exp.exp_cap +
+                                     PCI_EXP_SLTSTA, PCI_EXP_SLTSTA_ABP);
+    }
+}
+
+/*
+ * Guest Slot Control writes (ARCHITECTURE.md 4.4): power off with the
+ * power indicator off removes the devices below the slot, and a power
+ * change resets them (pci_set_power()). Both are device lifecycle work,
+ * which must not run inside the config write. The stock handler updates
+ * Slot Status as usual (presence cleared, Presence Detect Changed); this
+ * hook closes the gate at once and leaves the rest to the slot's bottom
+ * half. Writes with no such effect (interrupt enables, indicators while
+ * powered) keep the stock path and never touch the gate.
+ */
+typedef struct PowerCheck {
+    bool power;
+    bool mismatch;
+} PowerCheck;
+
+static void usb4_pcie_slot_check_power(PCIBus *bus, PCIDevice *d,
+                                       void *opaque)
+{
+    PowerCheck *pc = opaque;
+
+    pc->mismatch |= d->enabled != pc->power;
+}
+
+static bool usb4_pcie_slot_defer(PCIESlot *ps, bool unplug)
+{
+    USB4TunnelSlot *ts = USB4_TUNNEL_TARGET_GET_CLASS(ps)->get_slot(
+        OBJECT(ps));
+    PCIDevice *d = PCI_DEVICE(ps);
+    PCIBus *sec = pci_bridge_get_sec_bus(PCI_BRIDGE(d));
+    uint8_t *exp_cap = d->config + d->exp.exp_cap;
+    PowerCheck pc = { .power = true };
+
+    if (!ts->ep) {
+        return false;           /* nothing of ours below: stock path */
+    }
+    if (unplug) {
+        usb4_tunnel_slot_guest_unplug(ts);
+        return true;
+    }
+    if (pci_get_long(exp_cap + PCI_EXP_SLTCAP) & PCI_EXP_SLTCAP_PCP) {
+        pc.power = (pci_get_word(exp_cap + PCI_EXP_SLTCTL) &
+                    PCI_EXP_SLTCTL_PCC) == PCI_EXP_SLTCTL_PWR_ON;
+    }
+    pci_for_each_device(sec, pci_bus_num(sec), usb4_pcie_slot_check_power,
+                        &pc);
+    if (!pc.mismatch) {
+        return false;
+    }
+    usb4_tunnel_slot_guest_power(ts);
+    return true;
+}
+
+/* Bottom half: the stock power update, now that it is safe to reset. */
+void usb4_pcie_slot_apply_power(USB4TunnelSlot *ts)
+{
+    pcie_cap_update_power(ts->bridge);
+}
+
+/*
+ * Command Completed for a deferred power command, after the power and
+ * the gate are reconciled (the core holds it back, see
+ * PCIESlot.cc_deferred; a later command or a reset cancels it).
+ */
+void usb4_pcie_slot_power_done(USB4TunnelSlot *ts)
+{
+    pcie_cap_slot_complete_deferred(ts->bridge);
+}
+
+void usb4_pcie_slot_defer_init(USB4TunnelSlot *ts)
+{
+    PCIE_SLOT(ts->bridge)->defer_slot_effects = usb4_pcie_slot_defer;
+}
+
+/*
+ * USB4 DVSEC Spec 1.0: a PCIe tunneled port may carry a USB4 DVSEC (port
+ * type 1, section 3 and 5) and then also a Device Serial Number
+ * capability with the same serial as the rest of the enclosure
+ * (section 2). The serial is copied from the usb4-host at machine done.
+ */
+#define TP_DSN_OFFSET    0x200
+#define TP_DVSEC_OFFSET  (TP_DSN_OFFSET + PCI_EXT_CAP_DSN_SIZEOF)
+#define TP_DVSEC_LEN     0x10
+#define USB4_DVSEC_VENDOR_USBIF 0x1ec0
+#define USB4_DVSEC_ID_USBIF     0x01
+#define USB4_DVSEC_PORT_PCIE    0x1
+
+static void tp_dvsec_init(USB4TunnelPort *s)
+{
+    PCIDevice *d = PCI_DEVICE(s);
+    uint8_t *cfg = d->config + TP_DVSEC_OFFSET;
+
+    pcie_dev_ser_num_init(d, TP_DSN_OFFSET, 0);
+    pcie_add_capability(d, PCI_EXT_CAP_ID_DVSEC, 1, TP_DVSEC_OFFSET,
+                        TP_DVSEC_LEN);
+    /* DVSEC header 1: vendor USB-IF, revision 0, length 10h */
+    pci_set_long(cfg + 4, USB4_DVSEC_VENDOR_USBIF |
+                 ((uint32_t)TP_DVSEC_LEN << 20));
+    /* DVSEC header 2: DVSEC ID 01h, Port Type PCIe Tunneled Port */
+    pci_set_long(cfg + 8, USB4_DVSEC_ID_USBIF |
+                 (USB4_DVSEC_PORT_PCIE << 16));
+    /*
+     * PCIe attributes (section 5): Port_NHI# 0, Port_Expandability 1
+     * (non-expandable), Host_Router_Indication 3 (host, external
+     * facing), no D3cold wake, no bus number reservation hint.
+     */
+    pci_set_long(cfg + 12, 0 | (1u << 16) | (3u << 18));
+}
+
+static void tp_machine_done(USB4TunnelSlot *ts)
+{
+    USB4TunnelPort *s = TP_OF(ts);
+    PCIDevice *host = usb4_host_for_tunnel_port(PCI_DEVICE(s));
+    uint16_t pos;
+
+    if (!s->usb4_dvsec || !host) {
+        return;
+    }
+    pos = pcie_find_capability(host, PCI_EXT_CAP_ID_DSN);
+    if (pos) {
+        memcpy(PCI_DEVICE(s)->config + TP_DSN_OFFSET + 4,
+               host->config + pos + 4, 8);
+    }
+}
+
+static const USB4TunnelSlotOps tp_slot_ops = {
+    .ep_devfn = PCI_DEVFN(0, 0),
+    .dock_capable = true,
+    .surprise_remove = usb4_pcie_slot_surprise_remove,
+    .request_eject = usb4_pcie_slot_request_eject,
+    .after_insert = usb4_pcie_slot_after_insert,
+    .machine_done = tp_machine_done,
+    .apply_power = usb4_pcie_slot_apply_power,
+    .power_done = usb4_pcie_slot_power_done,
+};
+
+/* ------------------------------------------------------------------ */
+/* Hooks into the stock root port                                       */
+/* ------------------------------------------------------------------ */
+
+static void tp_unplug(HotplugHandler *hh, DeviceState *dev, Error **errp)
+{
+    USB4TunnelPort *s = USB4_TUNNEL_PORT(hh);
+    bool ours = usb4_tunnel_slot_is_endpoint(&s->slot, dev);
+
+    USB4_TUNNEL_PORT_GET_CLASS(s)->parent_unplug(hh, dev, errp);
+    usb4_tunnel_slot_unplugged(&s->slot, dev, ours);
+}
+
+static void tp_write_config(PCIDevice *d, uint32_t addr, uint32_t val,
+                            int len)
+{
+    USB4TunnelPort *s = USB4_TUNNEL_PORT(d);
+    USB4TunnelSlot *ts = &s->slot;
+    uint16_t old_ctl, old_sta;
+
+    pcie_cap_slot_get(d, &old_ctl, &old_sta);
+
+    /* One transaction so a rebuilt window is never visible ungated. */
+    memory_region_transaction_begin();
+    USB4_TUNNEL_PORT_GET_CLASS(s)->parent_config_write(d, addr, val, len);
+    usb4_tunnel_slot_apply_window_gate(&s->slot);
+    memory_region_transaction_commit();
+
+    usb4_pcie_slot_config_written(ts, addr, val, len, old_ctl, old_sta);
+}
+
+/*
+ * After a guest config write to a PCIe tunnel bridge with a native
+ * hot-plug slot (@old_ctl/@old_sta: Slot Control/Status before it):
+ * the power-on retry above, and the empty-slot acknowledgment.
+ */
+void usb4_pcie_slot_config_written(USB4TunnelSlot *ts, uint32_t addr,
+                                   uint32_t val, int len, uint16_t old_ctl,
+                                   uint16_t old_sta)
+{
+    PCIDevice *d = ts->bridge;
+    uint16_t sltctl, sltsta;
+
+    pcie_cap_slot_get(d, &sltctl, &sltsta);
+    if (ranges_overlap(addr, len, d->exp.exp_cap + PCI_EXP_SLTCTL, 4)) {
+        trace_usb4_tp_slot_write(usb4_tunnel_slot_name(ts), addr, val,
+                                 len, sltctl, sltsta);
+        if (!(sltctl & PCI_EXP_SLTCTL_PCC)) {
+            ts->power_retries = 0;          /* guest powered the slot */
+        } else if (ts->power_retries && ts->ep && ts->ep_state == EP_LIVE &&
+                   (sltsta & PCI_EXP_SLTSTA_PDS) &&
+                   (old_ctl & TP_ABP_ARMED) != TP_ABP_ARMED &&
+                   (sltctl & TP_ABP_ARMED) == TP_ABP_ARMED &&
+                   !(sltsta & PCI_EXP_SLTSTA_ABP)) {
+            ts->power_retries--;
+            trace_usb4_tp_power_retry(usb4_tunnel_slot_name(ts), ts->ep_gen,
+                                      ts->power_retries);
+            /*
+             * Presence Detect Changed again, then the attention button,
+             * as for the original insertion.
+             */
+            pci_word_test_and_set_mask(d->config + d->exp.exp_cap +
+                                       PCI_EXP_SLTSTA, PCI_EXP_SLTSTA_PDC);
+            pcie_cap_slot_push_attention_button(d);
+        }
+    }
+    /* The guest acknowledged the empty slot: it cleared PDC. */
+    if ((old_sta & PCI_EXP_SLTSTA_PDC) && !(sltsta & PCI_EXP_SLTSTA_PDC)) {
+        usb4_tunnel_slot_empty_acked(ts);
+    }
+}
+
+static void tp_build_aml(AcpiDevAmlIf *adev, Aml *scope)
+{
+    USB4TunnelPort *s = USB4_TUNNEL_PORT(adev);
+
+    build_pci_bridge_aml(adev, scope);
+    usb4_acpi_build_tunnel_port_dsd(scope, PCI_DEVICE(s),
+                                    s->usb4_port_number,
+                                    s->acpi_hotplug_d3,
+                                    s->acpi_external_facing);
+}
+
+static void tp_realize(DeviceState *dev, Error **errp)
+{
+    USB4TunnelPort *s = USB4_TUNNEL_PORT(dev);
+    GenPCIERootPort *grp = GEN_PCIE_ROOT_PORT(dev);
+    Error *local_err = NULL;
+
+    /*
+     * Resource reservation hints for firmware (QEMU bridge reserve
+     * capability), applied when the user left them unset. A USB4 tunnel
+     * is hot-plug only, so the port needs room for what may appear: a
+     * dock (usb4-device dock=on) is a switch with an internal bus and
+     * three downstream buses, three 1 MiB memory windows and an I/O
+     * window for the NIC. Real Thunderbolt hosts reserve generously for
+     * the same reason.
+     */
+    if (grp->res_reserve.bus == (uint32_t)-1) {
+        grp->res_reserve.bus = TP_DEFAULT_BUS_RESERVE;
+    }
+    if (grp->res_reserve.mem_non_pref == (uint64_t)-1) {
+        grp->res_reserve.mem_non_pref = TP_DEFAULT_MEM_RESERVE;
+    }
+    if (grp->res_reserve.io == (uint64_t)-1) {
+        grp->res_reserve.io = TP_DEFAULT_IO_RESERVE;
+    }
+
+    USB4_TUNNEL_PORT_GET_CLASS(dev)->parent_realize(dev, &local_err);
+    if (local_err) {
+        error_propagate(errp, local_err);
+        return;
+    }
+    /*
+     * Report the link loss of a surprise removal (or a CM tearing the
+     * tunnel down) as Data Link Layer State Changed. A guest that has an
+     * attention button to watch may not enable Presence Detect Changed
+     * and relies on DLLSC instead (observed with Linux 7.0 pciehp, see
+     * docs/LINUX-TEST.md); without it the gated endpoint is never removed.
+     */
+    pcie_cap_slot_enable_dllsc(PCI_DEVICE(dev));
+    if (!usb4_tunnel_slot_realize(&s->slot, PCI_DEVICE(dev), &tp_slot_ops,
+                                  errp)) {
+        /* Unwind the root port realized above. */
+        USB4_TUNNEL_PORT_GET_CLASS(dev)->parent_unrealize(dev);
+        return;
+    }
+    usb4_pcie_slot_defer_init(&s->slot);
+    if (s->usb4_dvsec) {
+        tp_dvsec_init(s);
+    }
+}
+
+/*
+ * Release the slot's BH, timers, machine-done notifier and gate address
+ * space before the root port goes (the endpoint below is already gone:
+ * child buses are unrealized first).
+ */
+static void tp_unrealize(DeviceState *dev)
+{
+    usb4_tunnel_slot_unrealize(&USB4_TUNNEL_PORT(dev)->slot);
+    USB4_TUNNEL_PORT_GET_CLASS(dev)->parent_unrealize(dev);
+}
+
+static void tp_finalize(Object *obj)
+{
+    usb4_tunnel_slot_finalize(&USB4_TUNNEL_PORT(obj)->slot);
+}
+
+static USB4TunnelSlot *tp_get_slot(Object *obj)
+{
+    return &USB4_TUNNEL_PORT(obj)->slot;
+}
+
+static const Property tp_props[] = {
+    DEFINE_PROP_STRING("nvme-drive", USB4TunnelPort, slot.nvme_drive),
+    DEFINE_PROP_STRING("nvme-serial", USB4TunnelPort, slot.nvme_serial),
+    DEFINE_PROP_STRING("nvme-namespaces", USB4TunnelPort,
+                       slot.nvme_namespaces),
+    DEFINE_PROP_UINT32("nvme-nn", USB4TunnelPort, slot.nvme_nn, 0),
+    DEFINE_PROP_BOOL("x-force-tunnel", USB4TunnelPort, slot.force_tunnel,
+                     false),
+    DEFINE_PROP_UINT32("eject-timeout-ms", USB4TunnelPort,
+                       slot.eject_timeout_ms, 10000),
+    DEFINE_PROP_UINT32("settle-ms", USB4TunnelPort, slot.settle_ms, 2000),
+    DEFINE_PROP_BOOL("orderly-admin-down", USB4TunnelPort,
+                     slot.orderly_admin_down, false),
+    DEFINE_PROP_UINT32("usb4-port", USB4TunnelPort, usb4_port_number, 0),
+    DEFINE_PROP_BOOL("acpi-hotplug-in-d3", USB4TunnelPort,
+                     acpi_hotplug_d3, true),
+    DEFINE_PROP_BOOL("acpi-external-facing", USB4TunnelPort,
+                     acpi_external_facing, true),
+    DEFINE_PROP_BOOL("usb4-dvsec", USB4TunnelPort, usb4_dvsec, true),
+};
+
+static void tp_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    PCIDeviceClass *k = PCI_DEVICE_CLASS(klass);
+    HotplugHandlerClass *hc = HOTPLUG_HANDLER_CLASS(klass);
+    AcpiDevAmlIfClass *adevc = ACPI_DEV_AML_IF_CLASS(klass);
+    USB4TunnelTargetClass *ttc = USB4_TUNNEL_TARGET_CLASS(klass);
+    USB4TunnelPortClass *tpc = USB4_TUNNEL_PORT_CLASS(klass);
+
+    dc->desc = "USB4 PCIe tunnel port (gated PCIe root port)";
+    dc->hotpluggable = false;
+    device_class_set_props(dc, tp_props);
+    device_class_set_parent_realize(dc, tp_realize, &tpc->parent_realize);
+    device_class_set_parent_unrealize(dc, tp_unrealize,
+                                      &tpc->parent_unrealize);
+
+    tpc->parent_config_write = k->config_write;
+    k->config_write = tp_write_config;
+    tpc->parent_unplug = hc->unplug;
+    hc->unplug = tp_unplug;
+    adevc->build_dev_aml = tp_build_aml;
+    ttc->get_slot = tp_get_slot;
+    usb4_tunnel_slot_class_init(klass);
+}
+
+static const TypeInfo tp_info = {
+    .name = TYPE_USB4_TUNNEL_PORT,
+    .parent = TYPE_GEN_PCIE_ROOT_PORT,
+    .instance_size = sizeof(USB4TunnelPort),
+    .class_size = sizeof(USB4TunnelPortClass),
+    .class_init = tp_class_init,
+    .instance_finalize = tp_finalize,
+    .interfaces = (const InterfaceInfo[]) {
+        { TYPE_USB4_TUNNEL_TARGET },
+        { }
+    },
+};
+
+static void tp_register_types(void)
+{
+    type_register_static(&tp_info);
+}
+
+type_init(tp_register_types)
diff --git a/hw/usb4/usb4-tunnel-slot.c b/hw/usb4/usb4-tunnel-slot.c
new file mode 100644
index 0000000000000000000000000000000000000000..5ef2a2dd2c443f166d7c19d13343e9e642def53c
--- /dev/null
+++ b/hw/usb4/usb4-tunnel-slot.c
@@ -0,0 +1,1944 @@
+/*
+ * USB4 PCIe tunnel: access gate and endpoint lifecycle shared by
+ * usb4-tunnel-port (q35) and usb4-tunnel-bridge (i440FX).
+ *
+ * Copyright (c) 2026 usb4-emu contributors
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Written from scratch for the usb4-emu project. Design reference:
+ * docs/ARCHITECTURE.md section 4.4 ("PCI integration") and 4.5 in the
+ * usb4-emu repository.
+ *
+ * The tunnel evaluator (or a debug override) calls
+ * usb4_tunnel_port_set_state(). A down transition closes the access gate
+ * synchronously (stage 1); quiesce, notify and removal (stages 2-4) and
+ * insertion of a fresh endpoint run from a bottom half.
+ *
+ * The access gate has four parts, all toggles without device reset:
+ *  - DMA: every device behind the bridge gets its bus-master address
+ *    space from gate_as (installed with pci_setup_iommu() on the
+ *    secondary bus). gate_as is a container with one alias of system
+ *    memory; the alias is disabled while the gate is closed, so DMA and
+ *    MSI/MSI-X writes fail.
+ *  - MMIO/IO: the bridge forwarding window aliases are disabled while
+ *    closed, and re-disabled after every guest config write to the bridge.
+ *    In their place, all-ones regions cover the same windows (as the
+ *    guest currently programs them) on the primary bus: reads return
+ *    all-ones, writes are dropped, as with a dropped link. They decode
+ *    only what no other agent on the primary bus claims (fallback
+ *    priority), and are rebuilt after every bridge reset.
+ *  - Config: pci_bus_set_access_gated() makes config reads to the
+ *    secondary bus return all-ones and drops writes.
+ *  - INTx: also pci_bus_set_access_gated(): deasserted and not forwarded.
+ *
+ * The bridge type supplies the slot mechanics (USB4TunnelSlotOps): how to
+ * request an eject, how to remove without asking, and (SHPC) whether its
+ * own slot state additionally holds the gate closed.
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qapi/qapi-events-misc.h"
+#include "qemu/cutils.h"
+#include "qemu/error-report.h"
+#include "qemu/main-loop.h"
+#include "qemu/rcu.h"
+#include "hw/core/qdev.h"
+#include "hw/pci/pci.h"
+#include "hw/pci/pci_bus.h"
+#include "hw/pci/pci_bridge.h"
+#include "hw/pci/pcie_port.h"
+#include "hw/pci/shpc.h"
+#include "hw/core/resettable.h"
+#include "migration/vmstate.h"
+#include "monitor/qdev.h"
+#include "system/address-spaces.h"
+#include "system/block-backend.h"
+#include "block/block-global-state.h"
+#include "system/system.h"
+#include "usb4-tunnel-slot.h"
+#include "usb4-harness.h"
+#include "trace.h"
+
+const char *usb4_tunnel_slot_name(USB4TunnelSlot *ts)
+{
+    DeviceState *d = DEVICE(ts->bridge);
+
+    return d->id ? d->id : object_get_canonical_path_component(OBJECT(d));
+}
+
+static void ts_event(USB4TunnelSlot *ts, uint64_t gen, const char *stage)
+{
+    g_autofree char *path = object_get_canonical_path(OBJECT(ts->bridge));
+
+    qapi_event_send_usb4_tunnel_endpoint(path, gen, stage);
+}
+
+static PCIBus *ts_sec_bus(USB4TunnelSlot *ts)
+{
+    return pci_bridge_get_sec_bus(PCI_BRIDGE(ts->bridge));
+}
+
+static void ts_schedule(USB4TunnelSlot *ts)
+{
+    qemu_bh_schedule(ts->bh);
+}
+
+void usb4_tunnel_slot_schedule(USB4TunnelSlot *ts)
+{
+    if (ts->bh) {
+        ts_schedule(ts);
+    }
+}
+
+#define TS_INSERT_RETRIES  100
+#define TS_INSERT_RETRY_MS 20
+
+/*
+ * Lifecycle serialization (ARCHITECTURE.md 4.4 stages 2-4 and insertion).
+ * Quiesce, removal and insertion reset, drain or unrealize devices, and
+ * each of those can poll the main AioContext (blk_drain_all(), the NVMe
+ * reset and unrealize drain block I/O), which runs other bottom halves:
+ * another slot's ts_bh(), or this one's again. An outer tunnel could then
+ * remove a usb4-tunnel-dsp whose own stage is on the stack, or a DSP
+ * change state under an outer slot's stage. So at most one slot runs
+ * lifecycle work at a time. A slot whose bottom half fires meanwhile is
+ * parked and scheduled again once the running work returns (never
+ * retried in a loop). The running slot's bridge is referenced, and every
+ * draining step re-validates the slot and its occupant afterwards.
+ */
+static USB4TunnelSlot *ts_running;
+static GSList *ts_parked;
+
+/* The slot has not been unrealized (its bridge may still be referenced). */
+static bool ts_alive(USB4TunnelSlot *ts)
+{
+    return ts->bh != NULL;
+}
+
+static void ts_unpark(void)
+{
+    GSList *l, *parked = ts_parked;
+
+    ts_parked = NULL;
+    for (l = parked; l; l = l->next) {
+        USB4TunnelSlot *p = l->data;
+
+        if (ts_alive(p)) {
+            qemu_bh_schedule(p->bh);
+        }
+    }
+    g_slist_free(parked);
+}
+
+/*
+ * The test harness (docs/HARNESS.md) drains the endpoint's block I/O when
+ * it runs released commands to completion outside the slot's bottom half
+ * (a QMP command, a timer). It takes the same serialization: while it
+ * drains, slot bottom halves are parked.
+ */
+bool usb4_tunnel_slot_lifecycle_begin(USB4TunnelSlot *ts)
+{
+    if (ts_running || !ts_alive(ts)) {
+        return false;
+    }
+    ts_running = ts;
+    object_ref(OBJECT(ts->bridge));
+    return true;
+}
+
+void usb4_tunnel_slot_lifecycle_end(USB4TunnelSlot *ts)
+{
+    Object *bridge = OBJECT(ts->bridge);
+
+    assert(ts_running == ts);
+    ts_running = NULL;
+    ts_unpark();
+    object_unref(bridge);       /* may finalize the bridge and @ts */
+}
+
+/* ------------------------------------------------------------------ */
+/* Access gate (ARCHITECTURE.md 4.4 stage 1)                           */
+/* ------------------------------------------------------------------ */
+
+static AddressSpace *ts_gate_get_as(PCIBus *bus, void *opaque, int devfn)
+{
+    USB4TunnelSlot *ts = opaque;
+
+    return &ts->gate_as;
+}
+
+static const PCIIOMMUOps ts_gate_ops = {
+    .get_address_space = ts_gate_get_as,
+};
+
+/*
+ * What the CPU sees behind a closed gate. With the link down, a request
+ * the bridge would forward downstream cannot complete: in the PCIe Base
+ * Specification 6.x, a downstream port whose link is down (section 2.9.1)
+ * handles such a request as an Unsupported Request (section 2.3.1), and
+ * a requester that never gets a completion gives up when its completion
+ * timeout expires (section 2.8); posted writes are lost. Either way the root
+ * complex ends the CPU load as a master abort, and on x86 a master-aborted
+ * read returns all-ones of the access size. Drivers that handle surprise
+ * removal (an NVMe driver seeing CSTS == 0xFFFFFFFF, for example) rely on
+ * this, so a closed window must not read as QEMU's unassigned zeroes.
+ */
+static uint64_t ts_ones_read(void *opaque, hwaddr addr, unsigned size)
+{
+    return MAKE_64BIT_MASK(0, size * 8);
+}
+
+static void ts_ones_write(void *opaque, hwaddr addr, uint64_t val,
+                          unsigned size)
+{
+}
+
+static const MemoryRegionOps ts_ones_mem_ops = {
+    .read = ts_ones_read,
+    .write = ts_ones_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 8,
+               .unaligned = true },
+    .impl = { .min_access_size = 1, .max_access_size = 8,
+              .unaligned = true },
+};
+
+static const MemoryRegionOps ts_ones_io_ops = {
+    .read = ts_ones_read,
+    .write = ts_ones_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 4,
+               .unaligned = true },
+    .impl = { .min_access_size = 1, .max_access_size = 4,
+              .unaligned = true },
+};
+
+static const struct {
+    const char *name;
+    bool io;
+} ts_ones_info[USB4_TS_ONES_NUM] = {
+    [USB4_TS_ONES_MEM] = { "mem", false },
+    [USB4_TS_ONES_PREF_MEM] = { "pref-mem", false },
+    [USB4_TS_ONES_IO] = { "io", true },
+    [USB4_TS_ONES_VGA_MEM] = { "vga-mem", false },
+    [USB4_TS_ONES_VGA_IO_LO] = { "vga-io-lo", true },
+    [USB4_TS_ONES_VGA_IO_HI] = { "vga-io-hi", true },
+};
+
+static MemoryRegion *ts_ones_parent(USB4TunnelSlot *ts, int i)
+{
+    PCIBus *pbus = pci_get_bus(ts->bridge);
+
+    return ts_ones_info[i].io ? pbus->address_space_io
+                              : pbus->address_space_mem;
+}
+
+static void ts_ones_place(USB4TunnelSlot *ts, int i, bool on, hwaddr base,
+                          uint64_t size)
+{
+    MemoryRegion *mr = &ts->gate_ones[i];
+
+    on = on && size;
+    if (on) {
+        if (!mr->enabled || mr->addr != base ||
+            memory_region_size(mr) != size) {
+            trace_usb4_tp_gate_ones(usb4_tunnel_slot_name(ts),
+                                    ts_ones_info[i].name, 1, base, size);
+        }
+        memory_region_set_size(mr, size);
+        memory_region_set_address(mr, base);
+    } else if (mr->enabled) {
+        trace_usb4_tp_gate_ones(usb4_tunnel_slot_name(ts),
+                                ts_ones_info[i].name, 0, mr->addr,
+                                memory_region_size(mr));
+    }
+    memory_region_set_enabled(mr, on);
+}
+
+/* One forwarding window, computed as pci_bridge_update_mappings() does. */
+static void ts_ones_window(USB4TunnelSlot *ts, int i, uint8_t type, bool on)
+{
+    pcibus_t base = pci_bridge_get_base(ts->bridge, type);
+    pcibus_t limit = pci_bridge_get_limit(ts->bridge, type);
+
+    /* limit < base: the window is empty (forwarding disabled). */
+    ts_ones_place(ts, i, on && limit >= base, base, limit + 1 - base);
+}
+
+/*
+ * Place the all-ones regions over the windows the bridge would forward
+ * (its command register enables, base/limit registers and VGA enable)
+ * while the gate is closed; disable them all while it is open.
+ */
+static void ts_ones_sync(USB4TunnelSlot *ts)
+{
+    PCIDevice *d = ts->bridge;
+    uint16_t cmd = pci_get_word(d->config + PCI_COMMAND);
+    uint16_t brctl = pci_get_word(d->config + PCI_BRIDGE_CONTROL);
+    bool mem = ts->gate_closed && (cmd & PCI_COMMAND_MEMORY);
+    bool io = ts->gate_closed && (cmd & PCI_COMMAND_IO);
+    bool vga = brctl & PCI_BRIDGE_CTL_VGA;
+
+    ts_ones_window(ts, USB4_TS_ONES_MEM, PCI_BASE_ADDRESS_SPACE_MEMORY, mem);
+    ts_ones_window(ts, USB4_TS_ONES_PREF_MEM, PCI_BASE_ADDRESS_MEM_PREFETCH,
+                   mem);
+    ts_ones_window(ts, USB4_TS_ONES_IO, PCI_BASE_ADDRESS_SPACE_IO, io);
+    ts_ones_place(ts, USB4_TS_ONES_VGA_MEM, mem && vga,
+                  QEMU_PCI_VGA_MEM_BASE, QEMU_PCI_VGA_MEM_SIZE);
+    ts_ones_place(ts, USB4_TS_ONES_VGA_IO_LO, io && vga,
+                  QEMU_PCI_VGA_IO_LO_BASE, QEMU_PCI_VGA_IO_LO_SIZE);
+    ts_ones_place(ts, USB4_TS_ONES_VGA_IO_HI, io && vga,
+                  QEMU_PCI_VGA_IO_HI_BASE, QEMU_PCI_VGA_IO_HI_SIZE);
+}
+
+/*
+ * The all-ones regions are fallback decoders: they claim only what no
+ * other agent on the primary bus decodes. A closed window that overlaps
+ * another decoder (the bridge's own BARs, a sibling's BARs, another
+ * bridge's windows, VGA, the chipset's legacy and configuration ports)
+ * must not shadow it, or the guest could not even reach the config ports
+ * to fix the window. In the bus's address spaces, PCI BARs, bridge window
+ * aliases and VGA regions sit at priority 1, ISA devices, chipset ports
+ * (PIC, CF8/CFC) and the firmware ROMs at 0 (pc and q35). Any enabled
+ * region beats unassigned space, so a negative priority puts these below
+ * every one of them and still above nothing.
+ */
+#define TS_ONES_PRIORITY (-1)
+
+static void ts_ones_init(USB4TunnelSlot *ts)
+{
+    int i;
+
+    for (i = 0; i < USB4_TS_ONES_NUM; i++) {
+        MemoryRegion *mr = &ts->gate_ones[i];
+        g_autofree char *name =
+            g_strdup_printf("usb4-tunnel-gate-ones-%s", ts_ones_info[i].name);
+
+        memory_region_init_io(mr, OBJECT(ts->bridge),
+                              ts_ones_info[i].io ? &ts_ones_io_ops
+                                                 : &ts_ones_mem_ops,
+                              ts, name, 1);
+        memory_region_set_enabled(mr, false);
+        memory_region_add_subregion_overlap(ts_ones_parent(ts, i), 0, mr,
+                                            TS_ONES_PRIORITY);
+    }
+}
+
+static void ts_ones_release(USB4TunnelSlot *ts)
+{
+    int i;
+
+    for (i = 0; i < USB4_TS_ONES_NUM; i++) {
+        memory_region_del_subregion(ts_ones_parent(ts, i), &ts->gate_ones[i]);
+        object_unparent(OBJECT(&ts->gate_ones[i]));
+    }
+}
+
+void usb4_tunnel_slot_apply_window_gate(USB4TunnelSlot *ts)
+{
+    PCIBridgeWindows *w = &PCI_BRIDGE(ts->bridge)->windows;
+    int i;
+
+    if (ts->gate_closed) {
+        memory_region_set_enabled(&w->alias_pref_mem, false);
+        memory_region_set_enabled(&w->alias_mem, false);
+        memory_region_set_enabled(&w->alias_io, false);
+        for (i = 0; i < QEMU_PCI_VGA_NUM_REGIONS; i++) {
+            memory_region_set_enabled(&w->alias_vga[i], false);
+        }
+    }
+    ts_ones_sync(ts);
+}
+
+void usb4_tunnel_slot_update_gate(USB4TunnelSlot *ts)
+{
+    /*
+     * A guest slot command whose device side effects are still pending
+     * (removal, power change) holds the gate closed until the bottom half
+     * has applied them.
+     */
+    bool other = ts->tunnel_closed || ts->guest_unplug ||
+        ts->power_pending ||
+        (ts->ops->slot_blocks_access && ts->ops->slot_blocks_access(ts));
+    /*
+     * The test harness override (docs/HARNESS.md): "closed" is the whole
+     * stage 1 gate; "reads-fail" gates everything the CPU reaches (MMIO,
+     * I/O, config, INTx) but leaves the DMA alias open.
+     */
+    bool closed = other || ts->hgate != USB4_HGATE_NONE;
+    bool dma_closed = other || ts->hgate == USB4_HGATE_CLOSED;
+    bool changed = ts->gate_closed != closed;
+
+    if (!changed && ts->dma_closed == dma_closed) {
+        return;
+    }
+    /* T0 of the removal measurements (docs/HARNESS.md): host and vm ns. */
+    trace_usb4_tp_gate(usb4_tunnel_slot_name(ts), closed, !dma_closed,
+                       qemu_clock_get_ns(QEMU_CLOCK_HOST),
+                       qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL));
+    ts->gate_closed = closed;
+    ts->dma_closed = dma_closed;
+
+    memory_region_transaction_begin();
+    memory_region_set_enabled(&ts->gate_alias, !dma_closed);
+    if (!changed) {
+        /* the DMA alias only */
+    } else if (closed) {
+        usb4_tunnel_slot_apply_window_gate(ts);
+    } else {
+        /* Rebuild the windows from the bridge's current config. */
+        pci_bridge_update_mappings(PCI_BRIDGE(ts->bridge));
+        /* Remove the all-ones stand-ins so the windows forward again. */
+        usb4_tunnel_slot_apply_window_gate(ts);
+    }
+    memory_region_transaction_commit();
+
+    if (changed) {
+        pci_bus_set_access_gated(ts_sec_bus(ts), closed);
+    }
+}
+
+void usb4_tunnel_slot_set_harness_gate(USB4TunnelSlot *ts,
+                                       USB4HarnessGate mode)
+{
+    static const char *const stages[] = {
+        [USB4_HGATE_NONE] = "harness-reopened",
+        [USB4_HGATE_CLOSED] = "harness-gated",
+        [USB4_HGATE_READS_FAIL] = "harness-reads-fail",
+    };
+
+    if (ts->hgate == mode) {
+        return;
+    }
+    ts->hgate = mode;
+    usb4_tunnel_slot_update_gate(ts);
+    ts_event(ts, ts->ep ? ts->ep_gen : 0, stages[mode]);
+}
+
+/*
+ * Reset exit phase of the tunnel bridge types. A bridge reset rewrites
+ * the bridge's config (pci_bridge_reset() clears the bus numbers, base
+ * and limit registers and Bridge Control; the bus reset then clears
+ * Command) but does not rebuild the forwarding windows, and the gate may
+ * stay closed across the reset, so nothing else re-places the all-ones
+ * regions: stale aliases and stale all-ones would survive until the next
+ * config write. By the exit phase every hold phase (the bridge's own and
+ * its bus's) has run and the config is final; for an FLR
+ * (pci_device_reset()) the fork runs the generic PCI reset, which clears
+ * Command, before the exit phase too. Re-evaluate the gate, then
+ * rebuild the aliases and apply the gate and the all-ones regions in one
+ * memory transaction.
+ */
+static void ts_reset_exit(Object *obj, ResetType type)
+{
+    USB4TunnelSlot *ts = USB4_TUNNEL_TARGET_GET_CLASS(obj)->get_slot(obj);
+
+    if (!ts->bridge) {
+        return;     /* not realized */
+    }
+    usb4_tunnel_slot_update_gate(ts);
+    memory_region_transaction_begin();
+    pci_bridge_update_mappings(PCI_BRIDGE(ts->bridge));
+    usb4_tunnel_slot_apply_window_gate(ts);
+    memory_region_transaction_commit();
+}
+
+static void ts_tunnel_gate(USB4TunnelSlot *ts, bool closed)
+{
+    ts->tunnel_closed = closed;
+    usb4_tunnel_slot_update_gate(ts);
+}
+
+void usb4_tunnel_slot_domain_gate(USB4TunnelSlot *ts, bool closed)
+{
+    ts_tunnel_gate(ts, closed);
+}
+
+void usb4_tunnel_slot_event(USB4TunnelSlot *ts, uint64_t gen,
+                            const char *stage)
+{
+    ts_event(ts, gen, stage);
+}
+
+/* ------------------------------------------------------------------ */
+/* Endpoint lifecycle                                                   */
+/* ------------------------------------------------------------------ */
+
+static void ts_surprise_remove(USB4TunnelSlot *ts)
+{
+    trace_usb4_tp_surprise(usb4_tunnel_slot_name(ts), ts->ep_gen);
+    ts->ops->surprise_remove(ts);
+    if (ts->ep) {
+        /* Should not happen: the stock unplug path skipped it. */
+        error_report("%s: endpoint survived surprise removal",
+                     usb4_tunnel_slot_name(ts));
+    }
+}
+
+/*
+ * Remove the devices in the endpoint's slot without touching the slot's
+ * status registers (the guest's command already updated them). The
+ * bridge's unplug hook reports the endpoint to
+ * usb4_tunnel_slot_unplugged().
+ */
+static void ts_remove_slot_devices(USB4TunnelSlot *ts)
+{
+    PCIBus *bus = ts_sec_bus(ts);
+    int slot = PCI_SLOT(ts->ops->ep_devfn);
+
+    for (int fn = 0; fn < PCI_FUNC_MAX; fn++) {
+        PCIDevice *d = bus->devices[PCI_DEVFN(slot, fn)];
+
+        if (d) {
+            hotplug_handler_unplug(qdev_get_hotplug_handler(DEVICE(d)),
+                                   DEVICE(d), &error_abort);
+            object_unparent(OBJECT(d));
+        }
+    }
+}
+
+/*
+ * Stage 2: reset the endpoint, which drains its block I/O. False if the
+ * slot or its occupant changed while draining (see ts_running).
+ */
+static bool ts_quiesce(USB4TunnelSlot *ts)
+{
+    PCIDevice *ep = ts->ep;
+    uint64_t gen = ts->ep_gen;
+    bool ok;
+
+    trace_usb4_tp_quiesce(usb4_tunnel_slot_name(ts), gen);
+    object_ref(OBJECT(ep));
+    device_cold_reset(DEVICE(ep));
+    blk_drain_all();
+    ok = ts_alive(ts) && ts->ep == ep && ts->ep_gen == gen &&
+         ts->ep_state == EP_DOOMED;
+    object_unref(OBJECT(ep));
+    if (!ok) {
+        trace_usb4_tp_stale(usb4_tunnel_slot_name(ts), gen, "quiesce");
+        return false;
+    }
+    ts->ep_state = EP_QUIESCED;
+    /* Stage 2 complete (docs/HARNESS.md measurement events). */
+    trace_usb4_tp_cutoff(usb4_tunnel_slot_name(ts), gen,
+                         qemu_clock_get_ns(QEMU_CLOCK_HOST),
+                         qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL));
+    ts_event(ts, gen, "cutoff");
+    return true;
+}
+
+/*
+ * Create one device of @type with id "<bridge-id>-<suffix>" (anonymous if
+ * the bridge has none), at @devfn unless it is negative. @hot: the device
+ * occupies the tunnel slot and is announced with the slot's hot-plug
+ * event. Every other device of a dock is realized as present from the
+ * start: it sits behind the switch, there is no event of its own for it.
+ */
+static DeviceState *ts_new_dev(USB4TunnelSlot *ts, const char *type,
+                               const char *suffix, int devfn,
+                               bool hot, Error **errp)
+{
+    DeviceState *dev = qdev_new(type);
+    const char *bid = DEVICE(ts->bridge)->id;
+    bool ok;
+
+    if (devfn >= 0 &&
+        !object_property_set_int(OBJECT(dev), "addr", devfn, errp)) {
+        goto fail;
+    }
+    if (bid) {
+        ok = qdev_set_id(dev, g_strdup_printf("%s-%s", bid, suffix), errp);
+    } else {
+        ok = qdev_set_id(dev, NULL, errp);
+    }
+    if (!ok) {
+        goto fail;
+    }
+    if (!hot) {
+        dev->hotplugged = false;
+    }
+    return dev;
+
+fail:
+    object_unparent(OBJECT(dev));
+    object_unref(OBJECT(dev));
+    return NULL;
+}
+
+static void ts_drop_dev(DeviceState *dev)
+{
+    object_unparent(OBJECT(dev));
+    object_unref(OBJECT(dev));
+}
+
+/* Realize @dev on @bus; consumes the creation reference either way. */
+static bool ts_realize_dev(DeviceState *dev, BusState *bus, Error **errp)
+{
+    if (!qdev_realize(dev, bus, errp)) {
+        ts_drop_dev(dev);
+        return false;
+    }
+    object_unref(OBJECT(dev));
+    return true;
+}
+
+static uint32_t ts_eff_nn(USB4TunnelSlot *ts);
+
+/*
+ * The device's PCIe switch: a TI XIO3130 (QEMU x3130-upstream and
+ * xio3130-downstream ports), built when the device is a dock or has
+ * downstream USB4 ports (daisy chain). The upstream port is the device
+ * in the tunnel slot.
+ *
+ * - Dock: three downstream ports with native hot-plug off (the dock's
+ *   functions are fixed) and nvme, e1000e and qemu-xhci plus one USB
+ *   device behind them.
+ * - Otherwise: one such downstream port with the nvme. An asm2464 device
+ *   router (docs/captures/ORICO-ASM2464.md) gets the ASM2464's own port
+ *   identities (usb4-asm2464-usp / -dsp, 1b21:2463) instead of the
+ *   XIO3130's.
+ * - Then one usb4-tunnel-dsp per downstream USB4 port: a hot-plug
+ *   downstream port with its own access gate. It stands for the PCIe
+ *   Downstream adapter of that USB4 port; the PCIe tunnel of the device
+ *   router plugged into that port inserts its endpoint (or switch) there.
+ *
+ * Everything is realized in this same bottom half, under the BQL, before
+ * the guest can act on the slot's single presence-detect event, so the
+ * guest finds the complete tree when it enumerates.
+ *
+ * Gate coverage (ARCHITECTURE.md 4.4): a device below the switch takes
+ * its DMA address space from the nearest bus with a DMA hook, which is
+ * the tunnel bridge's secondary bus (gate_as), or a usb4-tunnel-dsp's
+ * secondary bus for whatever sits behind it; the config and INTx gate
+ * covers subordinate buses (pci_bus_access_gated()); the switch's
+ * windows nest inside the tunnel bridge's, which the gate disables.
+ */
+static bool ts_build_switch(USB4TunnelSlot *ts, DeviceState *up,
+                            const char *pfx, const char *drive,
+                            const char *serial, bool cold, Error **errp)
+{
+    static const char *const ep_types[] = { "nvme", "e1000e", "qemu-xhci" };
+    static const char *const ep_names[] = { "nvme", "nic", "xhci" };
+    /*
+     * Physical slot numbers must be unique per chassis: one chassis per
+     * root tunnel port, eight slots per tunnel depth.
+     */
+    uint8_t chassis = 0x80 | PCIE_SLOT(ts->bridge)->chassis;
+    unsigned slot0 = ts->depth * 8;
+    BusState *sw_bus = BUS(pci_bridge_get_sec_bus(PCI_BRIDGE(up)));
+    DeviceState *xhci = NULL, *ud;
+    g_autofree char *un = g_strdup_printf("%s-usb", pfx);
+    bool storage = ts->up_usb_drive && *ts->up_usb_drive;
+    unsigned nep = ts->up_dock ? ARRAY_SIZE(ep_types) : 1;
+    int i;
+
+    for (i = 0; i < nep; i++) {
+        g_autofree char *dsn = g_strdup_printf("%s-dp%d", pfx, i);
+        g_autofree char *epn = g_strdup_printf("%s-%s", pfx, ep_names[i]);
+        DeviceState *dp, *ep;
+        bool ok = true;
+
+        dp = ts_new_dev(ts, ts->up_asm2464 ? "usb4-asm2464-dsp"
+                                           : "xio3130-downstream",
+                        dsn, PCI_DEVFN(i, 0), false, errp);
+        if (!dp) {
+            return false;
+        }
+        if (!object_property_set_uint(OBJECT(dp), "chassis", chassis, errp) ||
+            !object_property_set_uint(OBJECT(dp), "slot", slot0 + i + 1,
+                                      errp) ||
+            !object_property_set_uint(OBJECT(dp), "port", i, errp) ||
+            !object_property_set_bool(OBJECT(dp), "hotplug", false, errp)) {
+            ts_drop_dev(dp);
+            return false;
+        }
+        if (!ts_realize_dev(dp, sw_bus, errp)) {
+            return false;
+        }
+        ep = ts_new_dev(ts, ep_types[i], epn, PCI_DEVFN(0, 0), false, errp);
+        if (!ep) {
+            return false;
+        }
+        if (i == 0) {
+            ok = (!drive || !*drive ||
+                  object_property_set_str(OBJECT(ep), "drive", drive,
+                                          errp)) &&
+                 object_property_set_str(OBJECT(ep), "serial",
+                                         serial && *serial ? serial :
+                                         "USB4EMU0001", errp);
+        } else if (i == 1) {
+            /* No option ROM: nothing boots from the dock's NIC. */
+            ok = object_property_set_str(OBJECT(ep), "romfile", "", errp) &&
+                 (!ts->up_nic_netdev || !*ts->up_nic_netdev ||
+                  object_property_set_str(OBJECT(ep), "netdev",
+                                          ts->up_nic_netdev, errp));
+        }
+        if (!ok) {
+            ts_drop_dev(ep);
+            return false;
+        }
+        if (i == 0 && ts_eff_nn(ts) &&
+            !object_property_set_uint(OBJECT(ep), "x-nn", ts_eff_nn(ts),
+                                      errp)) {
+            ts_drop_dev(ep);
+            return false;
+        }
+        if (!ts_realize_dev(ep, BUS(pci_bridge_get_sec_bus(PCI_BRIDGE(dp))),
+                            errp)) {
+            return false;
+        }
+        if (i == 0) {
+            usb4_harness_attach(ts, PCI_DEVICE(ep));
+        }
+        if (i == 2) {
+            xhci = ep;
+        }
+    }
+
+    /* Daisy chain: one gated hot-plug downstream port per USB4 port. */
+    for (unsigned k = 1; k <= ts->up_ndfp; k++) {
+        g_autofree char *dsn = g_strdup_printf("%s-usb4dp%u", pfx, k);
+        unsigned n = nep + k - 1;
+        DeviceState *dp;
+
+        dp = ts_new_dev(ts, TYPE_USB4_TUNNEL_DSP, dsn, PCI_DEVFN(n, 0),
+                        false, errp);
+        if (!dp) {
+            return false;
+        }
+        if (!object_property_set_uint(OBJECT(dp), "chassis", chassis, errp) ||
+            !object_property_set_uint(OBJECT(dp), "slot", slot0 + n + 1,
+                                      errp) ||
+            !object_property_set_uint(OBJECT(dp), "port", n, errp) ||
+            !object_property_set_str(OBJECT(dp), "usb4-device",
+                                     ts->up_dev_path, errp) ||
+            !object_property_set_uint(OBJECT(dp), "usb4-dport", k, errp) ||
+            !object_property_set_uint(OBJECT(dp), "x-depth", ts->depth + 1,
+                                      errp)) {
+            ts_drop_dev(dp);
+            return false;
+        }
+        if (!ts_realize_dev(dp, sw_bus, errp)) {
+            return false;
+        }
+    }
+
+    if (ts->up_dock) {
+        /* The USB device on the dock's xHCI: storage, else a tablet. */
+        ud = ts_new_dev(ts, storage ? "usb-storage" : "usb-tablet", un, -1,
+                        false, errp);
+        if (!ud) {
+            return false;
+        }
+        if (storage &&
+            !object_property_set_str(OBJECT(ud), "drive", ts->up_usb_drive,
+                                     errp)) {
+            ts_drop_dev(ud);
+            return false;
+        }
+        if (!ts_realize_dev(ud, QLIST_FIRST(&xhci->child_bus), errp)) {
+            return false;
+        }
+    }
+
+    /*
+     * Devices realized while the machine runs without being hot-plugged
+     * get no reset at realize. Reset the switch subtree once, now that it
+     * is complete, so the downstream ports see their slots populated and
+     * every function starts from its reset state. A cold switch is reset
+     * by the machine reset that follows machine-done.
+     */
+    if (!cold) {
+        device_cold_reset(up);
+    }
+    return true;
+}
+
+/*
+ * A drive (BlockBackend name or node name) is still in use, typically by
+ * the previous dock's endpoint whose finalization (which releases the
+ * backend) is deferred until RCU readers are done.
+ */
+static bool ts_drive_busy(const char *id)
+{
+    BlockBackend *blk;
+    BlockDriverState *bs;
+
+    if (!id || !*id) {
+        return false;
+    }
+    blk = blk_by_name(id);
+    if (blk) {
+        return blk_get_attached_dev(blk) != NULL;
+    }
+    bs = bdrv_find_node(id);
+    return bs && bdrv_has_blk(bs);
+}
+
+/* Number of Namespaces the next endpoint reports (0: nvme default). */
+static uint32_t ts_nn(USB4TunnelSlot *ts)
+{
+    return ts->up_nn ? ts->up_nn : ts->nvme_nn;
+}
+
+/* ts_insert() builds a PCIe switch (dock, ASM2464, daisy chain). */
+static bool ts_builds_switch(USB4TunnelSlot *ts)
+{
+    return (ts->up_dock || ts->up_ndfp || ts->up_asm2464) &&
+           ts->ops->dock_capable;
+}
+
+/*
+ * The x-nn the endpoint NVMe gets (0: NVMe's default). The direct path
+ * falls back to the tunnel port's nvme-nn; the switch path uses only the
+ * device router's (existing behaviour, kept: the port property is the
+ * fallback for a tunnel without a device router, and a switch is only
+ * built for one).
+ */
+static uint32_t ts_eff_nn(USB4TunnelSlot *ts)
+{
+    return ts_builds_switch(ts) ? ts->up_nn : ts_nn(ts);
+}
+
+/* The parameters ts_insert() builds the next endpoint from. */
+static const char *ts_eff_drive(USB4TunnelSlot *ts)
+{
+    return ts->up_drive ? ts->up_drive : ts->nvme_drive;
+}
+
+static const char *ts_eff_serial(USB4TunnelSlot *ts)
+{
+    return ts->up_serial ? ts->up_serial : ts->nvme_serial;
+}
+
+static const char *ts_eff_namespaces(USB4TunnelSlot *ts)
+{
+    return ts->up_namespaces ? ts->up_namespaces : ts->nvme_namespaces;
+}
+
+/*
+ * Everything that decides what ts_insert() puts behind this slot, in one
+ * string: the device router, the drive, serial, namespace layout (each
+ * nsid:backend pair) and namespace count, and the switch and dock
+ * parameters. Two endpoints with the same identity present the same
+ * device; keep this in step with ts_insert() and ts_take_device().
+ */
+char *usb4_tunnel_slot_identity(USB4TunnelSlot *ts)
+{
+    const char *drive = ts_eff_drive(ts);
+    const char *serial = ts_eff_serial(ts);
+    const char *ns = ts_eff_namespaces(ts);
+
+    return g_strdup_printf("dev=%s;drive=%s;serial=%s;ns=%s;nn=%u;dock=%d;"
+                           "asm2464=%d;nic=%s;usb=%s;ndfp=%u",
+                           ts->up_dev_path ? ts->up_dev_path : "",
+                           drive ? drive : "", serial ? serial : "",
+                           ns ? ns : "", ts_eff_nn(ts), ts->up_dock,
+                           ts->up_asm2464,
+                           ts->up_nic_netdev ? ts->up_nic_netdev : "",
+                           ts->up_usb_drive ? ts->up_usb_drive : "",
+                           ts->up_ndfp);
+}
+
+/* A drive (BlockBackend name or node name) exists. */
+static bool ts_drive_exists(const char *id)
+{
+    return blk_by_name(id) || bdrv_find_node(id);
+}
+
+/*
+ * Namespace layout (docs/HARNESS.md): @spec is "nsid:drive[;nsid:drive]".
+ * Validate all of it before anything is created: the syntax, NSIDs from
+ * 1 to the Number of Namespaces @nn (0: the nvme default) with none
+ * twice, no drive twice, and with @ep_drive (the endpoint's own drive=,
+ * which is NSID 1) neither NSID 1 nor that drive again. With @backends
+ * also that every drive exists. Drives still held by an old endpoint are
+ * not an error here (ts_ns_busy(): the insertion waits for them).
+ */
+static bool ts_ns_check(const char *spec, const char *ep_drive, uint32_t nn,
+                        bool backends, Error **errp)
+{
+    g_auto(GStrv) items = NULL;
+    g_autoptr(GHashTable) nsids = g_hash_table_new(NULL, NULL);
+    g_autoptr(GHashTable) drives = g_hash_table_new(g_str_hash,
+                                                    g_str_equal);
+    bool implicit = ep_drive && *ep_drive;
+
+    if (!spec || !*spec) {
+        return true;
+    }
+    if (!nn) {
+        nn = 256;
+    }
+    if (implicit) {
+        g_hash_table_add(nsids, GUINT_TO_POINTER(1));
+        g_hash_table_add(drives, (gpointer)ep_drive);
+    }
+    items = g_strsplit(spec, ";", -1);
+    for (int i = 0; items[i]; i++) {
+        /* The hash tables hold pointers into @items (freed after them). */
+        char *item = g_strstrip(items[i]);
+        char *colon = strchr(item, ':');
+        const char *drive = colon ? colon + 1 : NULL;
+        uint64_t nsid;
+
+        if (!*item) {
+            continue;
+        }
+        if (colon) {
+            *colon = 0;
+        }
+        if (!drive || !*drive || qemu_strtou64(item, NULL, 0, &nsid) ||
+            !nsid || nsid > 256) {
+            error_setg(errp, "nvme-namespaces: \"%s%s%s\" is not "
+                       "nsid:drive with nsid 1-256", item, colon ? ":" : "",
+                       drive ? drive : "");
+            return false;
+        }
+        if (nsid > nn) {
+            error_setg(errp, "nvme-namespaces: NSID %" PRIu64 " is above "
+                       "the Number of Namespaces (nvme-nn=%u)", nsid, nn);
+            return false;
+        }
+        if (g_hash_table_contains(nsids, GUINT_TO_POINTER(nsid))) {
+            error_setg(errp, "nvme-namespaces: NSID %" PRIu64 " is given "
+                       "twice%s", nsid, implicit && nsid == 1 ?
+                       " (the endpoint's drive= is NSID 1)" : "");
+            return false;
+        }
+        if (g_hash_table_contains(drives, drive)) {
+            error_setg(errp, "nvme-namespaces: drive \"%s\" is used twice",
+                       drive);
+            return false;
+        }
+        if (backends && !ts_drive_exists(drive)) {
+            error_setg(errp, "nvme-namespaces: drive \"%s\" not found",
+                       drive);
+            return false;
+        }
+        g_hash_table_add(nsids, GUINT_TO_POINTER(nsid));
+        g_hash_table_add(drives, (gpointer)drive);
+    }
+    return true;
+}
+
+/*
+ * Create one nvme-ns per entry of the validated layout @spec on the NVMe
+ * bus of @dev. They are recorded in ts->ns_devs and released after the
+ * endpoint is removed (ts_ns_release()).
+ */
+static bool ts_ns_create(USB4TunnelSlot *ts, const char *spec,
+                         DeviceState *dev, Error **errp)
+{
+    g_auto(GStrv) items = NULL;
+    const char *bid = DEVICE(ts->bridge)->id;
+    BusState *bus = QLIST_FIRST(&dev->child_bus);
+
+    if (!spec || !*spec) {
+        return true;
+    }
+    items = g_strsplit(spec, ";", -1);
+    for (int i = 0; items[i]; i++) {
+        g_auto(GStrv) kv = g_strsplit(g_strstrip(items[i]), ":", 2);
+        uint64_t nsid;
+        DeviceState *ns;
+
+        if (!kv[0] || !*kv[0]) {
+            continue;
+        }
+        if (qemu_strtou64(kv[0], NULL, 0, &nsid)) {
+            g_assert_not_reached();     /* ts_ns_check() accepted it */
+        }
+        ns = qdev_new("nvme-ns");
+        if (bid && !qdev_set_id(ns, g_strdup_printf("%s-ns%" PRIu64 "-%"
+                                                    PRIu64, bid, nsid,
+                                                    ts->ep_gen), errp)) {
+            object_unref(OBJECT(ns));
+            return false;
+        }
+        ns->hotplugged = false;
+        if (!object_property_set_str(OBJECT(ns), "drive", kv[1], errp) ||
+            !object_property_set_uint(OBJECT(ns), "nsid", nsid, errp)) {
+            ts_drop_dev(ns);
+            return false;
+        }
+        /* The creation reference is kept until ts_ns_release(). */
+        if (!qdev_realize(ns, bus, errp)) {
+            ts_drop_dev(ns);
+            return false;
+        }
+        trace_usb4_tp_namespace(usb4_tunnel_slot_name(ts), ts->ep_gen,
+                                nsid, kv[1]);
+        g_ptr_array_add(ts->ns_devs, ns);
+    }
+    return true;
+}
+
+/* A drive of the layout is still held by an old endpoint namespace. */
+static bool ts_ns_busy(const char *spec)
+{
+    g_auto(GStrv) items = NULL;
+
+    if (!spec || !*spec) {
+        return false;
+    }
+    items = g_strsplit(spec, ";", -1);
+    for (int i = 0; items[i]; i++) {
+        g_auto(GStrv) kv = g_strsplit(g_strstrip(items[i]), ":", 2);
+
+        if (kv[0] && kv[1] && ts_drive_busy(kv[1])) {
+            return true;
+        }
+    }
+    return false;
+}
+
+/*
+ * Unrealize and drop the namespaces of removed endpoints. Not from the
+ * unplug callback: the controller may still be realized there, and its
+ * unrealize refers to them.
+ */
+static void ts_ns_release(USB4TunnelSlot *ts)
+{
+    while (ts->ns_dead && ts->ns_dead->len) {
+        DeviceState *ns = g_ptr_array_steal_index(ts->ns_dead, 0);
+
+        object_unparent(OBJECT(ns));
+        object_unref(OBJECT(ns));
+    }
+}
+
+typedef enum {
+    TS_INSERT_OK,
+    TS_INSERT_RETRY,        /* a backend is still busy: try again */
+    TS_INSERT_FAILED,       /* reported; the slot stays empty */
+} TsInsertResult;
+
+/*
+ * Insert a fresh endpoint. A namespace layout is validated before the
+ * endpoint exists; if creating it fails all the same, the endpoint is
+ * taken away again, so the guest never keeps a partial layout.
+ */
+static TsInsertResult ts_insert(USB4TunnelSlot *ts, bool cold)
+{
+    const char *drive = ts_eff_drive(ts);
+    const char *serial = ts_eff_serial(ts);
+    const char *ns_spec = ts_eff_namespaces(ts);
+    const char *name = usb4_tunnel_slot_name(ts);
+    bool sw = ts_builds_switch(ts);
+    bool dock = ts->up_dock && sw;
+    g_autofree char *suffix = NULL;
+    DeviceState *dev;
+    Error *err = NULL;
+    uint64_t gen = ++ts->next_gen;
+
+    trace_usb4_tp_insert(name, gen, drive ? drive : "(none)",
+                         serial ? serial : "(none)", cold);
+    if ((ts->up_dock || ts->up_ndfp) && !sw) {
+        warn_report_once("%s: dock=on and downstream-ports need a PCIe "
+                         "tunnel port (usb4-tunnel-port); inserting the "
+                         "NVMe only", name);
+    }
+
+    /*
+     * A dock's backends are attached below the switch after the switch
+     * is announced, so wait for them to be free before inserting it (the
+     * caller retries); a single NVMe simply fails its realize instead.
+     */
+    if (sw && (ts_drive_busy(drive) ||
+               (dock && ts_drive_busy(ts->up_usb_drive)))) {
+        trace_usb4_tp_insert_failed(name, "dock drive still in use");
+        ts->next_gen--;
+        return TS_INSERT_RETRY;
+    }
+    ts_ns_release(ts);
+    if (!sw && !ts_ns_check(ns_spec, drive, ts_eff_nn(ts), true, &err)) {
+        ts->next_gen--;
+        goto failed;
+    }
+    if (!sw && ts_ns_busy(ns_spec)) {
+        trace_usb4_tp_insert_failed(name, "namespace drive still in use");
+        ts->next_gen--;
+        return TS_INSERT_RETRY;
+    }
+
+    suffix = g_strdup_printf("%s%" PRIu64,
+                             dock ? "dock" : sw ? "sw" : "nvme", gen);
+    dev = ts_new_dev(ts, !sw ? "nvme" : ts->up_asm2464 ? "usb4-asm2464-usp"
+                                                       : "x3130-upstream",
+                     suffix, ts->ops->ep_devfn, !cold, &err);
+    if (!dev) {
+        goto fail;
+    }
+    if (!sw &&
+        ((drive && *drive &&
+          !object_property_set_str(OBJECT(dev), "drive", drive, &err)) ||
+         !object_property_set_str(OBJECT(dev), "serial",
+                                  serial && *serial ? serial :
+                                  "USB4EMU0001", &err) ||
+         (ts_eff_nn(ts) &&
+          !object_property_set_uint(OBJECT(dev), "x-nn", ts_eff_nn(ts),
+                                    &err)))) {
+        ts_drop_dev(dev);
+        goto fail;
+    }
+
+    /* The endpoint is live as soon as plug runs; set state first. */
+    ts->ep = PCI_DEVICE(dev);
+    ts->ep_gen = gen;
+    ts->ep_state = EP_LIVE;
+    if (!ts_realize_dev(dev, BUS(ts_sec_bus(ts)), &err)) {
+        ts->ep = NULL;
+        ts->ep_state = EP_NONE;
+        trace_usb4_tp_insert_failed(name, error_get_pretty(err));
+        if (ts->insert_retries + 1 >= TS_INSERT_RETRIES) {
+            error_report_err(err);
+        } else {
+            error_free(err);
+        }
+        return TS_INSERT_RETRY;
+    }
+    if (!sw) {
+        usb4_harness_attach(ts, PCI_DEVICE(dev));
+        if (!ts_ns_create(ts, ns_spec, dev, &err)) {
+            /*
+             * Validated, and still failed (e.g. the image does not suit
+             * an nvme-ns). The endpoint is plugged: take it away again
+             * with the namespaces created so far (released after it, by
+             * ts_ns_release()), and keep the slot empty until the tunnel
+             * goes down and up again. The controller has not been enabled
+             * yet, so no namespace was ever attached to it.
+             */
+            if (cold) {
+                ts_remove_slot_devices(ts);
+            } else {
+                ts_surprise_remove(ts);
+            }
+            if (ts->ep) {
+                /* ts_surprise_remove() reported it already */
+                ts->ep = NULL;
+                ts->ep_state = EP_NONE;
+            }
+            ts->dismissed = true;
+            goto failed;
+        }
+    }
+    if (sw) {
+        if (dock) {
+            trace_usb4_tp_dock(name, gen,
+                               ts->up_nic_netdev ? ts->up_nic_netdev
+                                                 : "(none)",
+                               ts->up_usb_drive ? ts->up_usb_drive
+                                                : "(tablet)");
+        }
+        trace_usb4_tp_switch(name, gen, dock, ts->up_ndfp);
+        if (!ts_build_switch(ts, dev, suffix, drive, serial, cold, &err)) {
+            /*
+             * The switch is already announced. Keep the partial dock (it
+             * goes away with the switch on tunnel down), report the error.
+             */
+            trace_usb4_tp_insert_failed(name, error_get_pretty(err));
+            error_report_err(err);
+        }
+    }
+    /* Before the guest can reach it: restored configuration, if any. */
+    usb4_tunnel_bridge_restore_inserted(PCI_DEVICE(dev));
+    if (ts->ops->after_insert) {
+        ts->ops->after_insert(ts, cold);
+    }
+    usb4_tunnel_slot_update_gate(ts);
+    ts_event(ts, gen, "inserted");
+    return TS_INSERT_OK;
+
+fail:
+    trace_usb4_tp_insert_failed(name, error_get_pretty(err));
+    error_report_err(err);
+    return TS_INSERT_RETRY;
+
+failed:
+    trace_usb4_tp_insert_failed(name, error_get_pretty(err));
+    error_reportf_err(err, "%s: endpoint not inserted: ", name);
+    ts_event(ts, 0, "insert-failed");
+    return TS_INSERT_FAILED;
+}
+
+/* Lifecycle work of one slot; runs with ts_running == ts. */
+static void ts_bh_work(USB4TunnelSlot *ts)
+{
+    const char *name = usb4_tunnel_slot_name(ts);
+    Error *err = NULL;
+
+    ts_ns_release(ts);
+
+    /*
+     * Guest slot commands (ARCHITECTURE.md 4.4): the config write closed
+     * the gate and updated the slot registers; removal and power changes
+     * (which reset) run here, never from the register write. Removal is
+     * for the occupant the command saw (generation check).
+     */
+    if (ts->guest_unplug) {
+        ts->guest_unplug = false;
+        if (ts->ep && ts->ep_gen == ts->guest_unplug_gen) {
+            trace_usb4_tp_guest_unplug(name, ts->ep_gen, "remove");
+            ts_remove_slot_devices(ts);
+            if (!ts_alive(ts)) {
+                return;
+            }
+        }
+        usb4_tunnel_slot_update_gate(ts);
+    }
+    if (ts->power_pending) {
+        ts->power_pending = false;
+        if (ts->ops->apply_power) {
+            ts->ops->apply_power(ts);
+            if (!ts_alive(ts)) {
+                return;
+            }
+        }
+        usb4_tunnel_slot_update_gate(ts);
+        /* Only now is the guest's power command complete. */
+        if (ts->ops->power_done) {
+            ts->ops->power_done(ts);
+        }
+    }
+
+    /* Stages 2-4 for an endpoint whose tunnel went down. */
+    if (ts->ep && ts->ep_state != EP_LIVE) {
+        if (ts->ep_state == EP_DOOMED && !ts_quiesce(ts)) {
+            /* Changed under the drain: start over from the new state. */
+            if (ts_alive(ts)) {
+                ts_schedule(ts);
+            }
+            return;
+        }
+        if (ts->tunnel_up || ts->reason == USB4_TUNNEL_REASON_SURPRISE ||
+            (ts->reason == USB4_TUNNEL_REASON_ADMIN_DOWN &&
+             !ts->orderly_admin_down)) {
+            /*
+             * Surprise, or a reconnect while the old endpoint is still
+             * pending: force its removal so the slot is seen empty.
+             *
+             * Admin-down (the CM tore the tunnel down) is a link loss on
+             * real hardware, so by default it is reported as a surprise
+             * removal too. With orderly-admin-down=on it raises an eject
+             * request like USB4_TUNNEL_REASON_EJECT. Observed on Windows
+             * 11: an eject request for a gated endpoint with a mounted
+             * volume is not completed (the storage stack cannot flush),
+             * the eject timeout then forces removal, and Windows leaves
+             * the slot powered off with the power indicator on, a state
+             * in which it ignores the next insertion.
+             */
+            ts_surprise_remove(ts);
+        } else if (ts->ep_state == EP_QUIESCED) {
+            uint64_t gen = ts->ep_gen;
+
+            trace_usb4_tp_eject_request(name, gen);
+            ts->ep_state = EP_EJECTING;
+            ts->ops->request_eject(ts, &err);
+            if (err) {
+                warn_report_err(err);
+                err = NULL;
+                if (ts->ep) {
+                    ts_surprise_remove(ts);
+                }
+            } else if (ts->ep) {
+                ts_event(ts, gen, "eject-requested");
+                ts->eject_timer_gen = gen;
+                ts->eject_expired = false;
+                timer_mod(ts->eject_timer,
+                          qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) +
+                          ts->eject_timeout_ms);
+            }
+        } else if (ts->ep_state == EP_EJECTING && ts->eject_expired &&
+                   ts->eject_timer_gen == ts->ep_gen) {
+            /* The guest did not complete the eject in time. */
+            ts_surprise_remove(ts);
+        }
+        /* EP_EJECTING: otherwise wait for the guest or the timeout. */
+        if (!ts_alive(ts)) {
+            return;
+        }
+    }
+
+    /* Insertion of a fresh endpoint. */
+    if (!ts->ep && ts->tunnel_up && !ts->dismissed) {
+        if (ts->awaiting_ack) {
+            int64_t now = qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL);
+            int64_t deadline = ts->empty_since_ms + ts->settle_ms;
+
+            if (now < deadline) {
+                trace_usb4_tp_settle_wait(name, deadline - now);
+                timer_mod(ts->settle_timer, deadline);
+                return;
+            }
+            ts->awaiting_ack = false;
+            ts_event(ts, 0, "settle-timeout");
+        }
+        ts_tunnel_gate(ts, false);
+        ts_event(ts, 0, "gate-open");
+        TsInsertResult res = ts_insert(ts, false);
+
+        if (res != TS_INSERT_RETRY) {
+            ts->insert_retries = 0;
+        } else if (++ts->insert_retries < TS_INSERT_RETRIES) {
+            /*
+             * Typically the previous endpoint still holds the drive: it
+             * is unrealized but its finalization (which releases the
+             * block backend) is deferred until RCU readers are done.
+             */
+            timer_mod(ts->retry_timer,
+                      qemu_clock_get_ms(QEMU_CLOCK_REALTIME) +
+                      TS_INSERT_RETRY_MS);
+        } else {
+            ts->insert_retries = 0;
+            ts_event(ts, 0, "insert-failed");
+        }
+    }
+}
+
+static void ts_bh(void *opaque)
+{
+    USB4TunnelSlot *ts = opaque;
+    Object *bridge = OBJECT(ts->bridge);
+
+    trace_usb4_tp_bh(usb4_tunnel_slot_name(ts), ts->tunnel_up, ts->ep_state,
+                     ts->ep_gen, ts->awaiting_ack, ts->dismissed);
+    if (!ts->machine_ready ||
+        (ts->hold_deferred && !usb4_harness_has_work(ts))) {
+        return;
+    }
+    if (ts_running) {
+        /* Nested in another slot's draining step: run after it. */
+        trace_usb4_tp_parked(usb4_tunnel_slot_name(ts),
+                             usb4_tunnel_slot_name(ts_running));
+        if (!g_slist_find(ts_parked, ts)) {
+            ts_parked = g_slist_prepend(ts_parked, ts);
+        }
+        return;
+    }
+    ts_running = ts;
+    object_ref(bridge);
+    /* Test harness work first; x-hold-deferred does not hold it. */
+    usb4_harness_bh_work(ts);
+    if (ts_alive(ts) && !ts->hold_deferred) {
+        ts_bh_work(ts);
+    }
+    ts_running = NULL;
+    ts_unpark();
+    object_unref(bridge);       /* may finalize the bridge and @ts */
+}
+
+static void ts_eject_timeout(void *opaque)
+{
+    USB4TunnelSlot *ts = opaque;
+
+    trace_usb4_tp_eject_timeout(usb4_tunnel_slot_name(ts),
+                                ts->eject_timer_gen, ts->ep_gen);
+    /* Generation check: only act on the endpoint the timer was for. */
+    if (!ts->ep || ts->ep_gen != ts->eject_timer_gen ||
+        ts->ep_state != EP_EJECTING) {
+        return;
+    }
+    /* The removal itself is lifecycle work: from the bottom half. */
+    ts->eject_expired = true;
+    ts_schedule(ts);
+}
+
+static void ts_settle_timeout(void *opaque)
+{
+    ts_schedule(opaque);
+}
+
+/* Remember what the endpoint behind the tunnel to @dev is made of. */
+static void ts_take_device(USB4TunnelSlot *ts, USB4Device *dev)
+{
+    g_free(ts->up_drive);
+    g_free(ts->up_serial);
+    ts->up_drive = g_strdup(usb4_device_nvme_drive(dev));
+    ts->up_serial = g_strdup(usb4_device_nvme_serial(dev));
+    g_free(ts->up_namespaces);
+    ts->up_namespaces = g_strdup(usb4_device_nvme_namespaces(dev));
+    ts->up_nn = usb4_device_nvme_nn(dev);
+    g_free(ts->up_nic_netdev);
+    g_free(ts->up_usb_drive);
+    ts->up_dock = usb4_device_dock(dev);
+    /*
+     * The ASM2464's PCIe switch needs a PCIe tunnel port; on the i440FX
+     * tunnel bridge the NVMe sits directly behind the bridge as for any
+     * other device router.
+     */
+    ts->up_asm2464 = usb4_device_model(dev) == USB4_DEVICE_MODEL_ASM2464;
+    ts->up_nic_netdev = g_strdup(usb4_device_nic_netdev(dev));
+    ts->up_usb_drive = g_strdup(usb4_device_usb_drive(dev));
+    g_free(ts->up_dev_path);
+    ts->up_ndfp = usb4_device_downstream_ports(dev);
+    ts->up_dev_path = object_get_canonical_path(OBJECT(dev));
+}
+
+/*
+ * The device router on the host USB4 port whose PCIe Down adapter this
+ * bridge backs, or NULL. Used when the tunnel is forced rather than built
+ * by a CM; the bridge's nvme-drive/nvme-serial are the fallback.
+ */
+static USB4Device *ts_forced_device(USB4TunnelSlot *ts)
+{
+    PCIDevice *host = usb4_host_for_tunnel_port(ts->bridge);
+    USB4Device *dev = NULL;
+    unsigned port;
+
+    for (port = 1; host && !dev &&
+         port <= usb4_host_num_ports((USB4Host *)host); port++) {
+        if (OBJECT(usb4_host_get_port_tunnel((USB4Host *)host, port)) ==
+            OBJECT(ts->bridge)) {
+            dev = usb4_host_port_device((USB4Host *)host, port);
+        }
+    }
+    return dev;
+}
+
+void usb4_tunnel_slot_set_state(USB4TunnelSlot *ts, USB4Device *dev,
+                                USB4TunnelState st, USB4TunnelReason why)
+{
+    bool up = st == USB4_TUNNEL_UP;
+    static const char *const reasons[] = {
+        [USB4_TUNNEL_REASON_UP] = "up",
+        [USB4_TUNNEL_REASON_ADMIN_DOWN] = "admin-down",
+        [USB4_TUNNEL_REASON_EJECT] = "eject",
+        [USB4_TUNNEL_REASON_SURPRISE] = "surprise",
+    };
+
+    trace_usb4_tp_set_state(usb4_tunnel_slot_name(ts), up ? "up" : "down",
+                            why < ARRAY_SIZE(reasons) && reasons[why] ?
+                            reasons[why] : "?", ts->ep_state);
+
+    if (up) {
+        if (dev) {
+            ts_take_device(ts, dev);
+        }
+        if (!ts->tunnel_up) {
+            ts->dismissed = false;
+        }
+        ts->tunnel_up = true;
+        ts->reason = USB4_TUNNEL_REASON_UP;
+        ts_schedule(ts);
+        return;
+    }
+
+    /* Down: stage 1, synchronously, before returning to the caller. */
+    ts->tunnel_up = false;
+    ts->reason = why;
+    ts_tunnel_gate(ts, true);
+    if (ts->ep && ts->ep_state == EP_LIVE) {
+        ts->ep_state = EP_DOOMED;
+    }
+    ts_event(ts, ts->ep ? ts->ep_gen : 0, "gated");
+    ts_schedule(ts);
+}
+
+bool usb4_tunnel_slot_is_endpoint(USB4TunnelSlot *ts, DeviceState *dev)
+{
+    return ts->ep && dev == DEVICE(ts->ep);
+}
+
+void usb4_tunnel_slot_unplugged(USB4TunnelSlot *ts, DeviceState *dev,
+                                bool was_ours)
+{
+    if (!was_ours) {
+        return;
+    }
+    /*
+     * Removed while live: the guest ejected it (or device_del). Keep the
+     * slot empty until the tunnel goes down and up again.
+     */
+    if (ts->ep_state == EP_LIVE) {
+        ts->dismissed = true;
+    }
+    trace_usb4_tp_removed(usb4_tunnel_slot_name(ts), ts->ep_gen,
+                          ts->dismissed);
+    ts_event(ts, ts->ep_gen, "removed");
+    /* A harness gate override applies to the endpoint it was set for. */
+    if (ts->hgate != USB4_HGATE_NONE) {
+        ts->hgate = USB4_HGATE_NONE;
+        usb4_tunnel_slot_update_gate(ts);
+    }
+    usb4_harness_endpoint_gone(ts);
+    while (ts->ns_devs->len) {
+        g_ptr_array_add(ts->ns_dead,
+                        g_ptr_array_steal_index(ts->ns_devs, 0));
+    }
+    ts->ep = NULL;
+    ts->ep_state = EP_NONE;
+    timer_del(ts->eject_timer);
+    ts->eject_expired = false;
+    ts->awaiting_ack = true;
+    ts->empty_since_ms = qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL);
+    ts_schedule(ts);
+}
+
+void usb4_tunnel_slot_guest_unplug(USB4TunnelSlot *ts)
+{
+    trace_usb4_tp_guest_unplug(usb4_tunnel_slot_name(ts), ts->ep_gen,
+                               "gated");
+    ts->guest_unplug = true;
+    ts->guest_unplug_gen = ts->ep_gen;
+    usb4_tunnel_slot_update_gate(ts);
+    ts_schedule(ts);
+}
+
+void usb4_tunnel_slot_guest_power(USB4TunnelSlot *ts)
+{
+    trace_usb4_tp_guest_power(usb4_tunnel_slot_name(ts), ts->ep_gen);
+    ts->power_pending = true;
+    usb4_tunnel_slot_update_gate(ts);
+    ts_schedule(ts);
+}
+
+void usb4_tunnel_slot_empty_acked(USB4TunnelSlot *ts)
+{
+    if (!ts->awaiting_ack || ts->ep) {
+        return;
+    }
+    trace_usb4_tp_empty_ack(usb4_tunnel_slot_name(ts));
+    ts->awaiting_ack = false;
+    timer_del(ts->settle_timer);
+    ts_schedule(ts);
+}
+
+static void ts_machine_done(Notifier *n, void *opaque)
+{
+    USB4TunnelSlot *ts = container_of(n, USB4TunnelSlot, machine_done);
+
+    ts->machine_ready = true;
+    if (BUS(ts_sec_bus(ts))->hotplug_handler != HOTPLUG_HANDLER(ts->bridge)) {
+        warn_report("%s: secondary bus hot-plug is not handled by the "
+                    "bridge (ACPI PCI hot-plug active?); use -global "
+                    "ICH9-LPC.acpi-pci-hotplug-with-bridge-support=off (q35) "
+                    "or PIIX4_PM.acpi-pci-hotplug-with-bridge-support=off "
+                    "(i440FX)", usb4_tunnel_slot_name(ts));
+    }
+    if (ts->ops->machine_done) {
+        ts->ops->machine_done(ts);
+    }
+    /* Endpoint present at power-on: cold plug, no hot-plug event. */
+    if (ts->tunnel_up && !ts->ep) {
+        /*
+         * x-force-tunnel: every device router is realised by now, so take
+         * the endpoint's drive from the one on this bridge's USB4 port, as
+         * a runtime forced "up" does (it was unset at bridge realize).
+         */
+        USB4Device *dev = ts_forced_device(ts);
+
+        if (dev) {
+            ts_take_device(ts, dev);
+        }
+        ts_tunnel_gate(ts, false);
+        ts_insert(ts, true);
+    }
+}
+
+bool usb4_tunnel_slot_realize(USB4TunnelSlot *ts, PCIDevice *bridge,
+                              const USB4TunnelSlotOps *ops, Error **errp)
+{
+    PCIBus *iommu_bus = NULL, *abus;
+    MemoryRegion *upstream = get_system_memory();
+    int adevfn;
+
+    ts->bridge = bridge;
+    ts->ops = ops;
+    /* The bridge's own layout: everything but the backends. */
+    if (!ts_ns_check(ts->nvme_namespaces, ts->nvme_drive, ts->nvme_nn, false,
+                     errp)) {
+        return false;
+    }
+    ts->ns_devs = g_ptr_array_new();
+    ts->ns_dead = g_ptr_array_new();
+
+    pci_device_get_iommu_bus_devfn(bridge, &iommu_bus, &abus, &adevfn);
+    if (iommu_bus && iommu_bus->iommu_ops == &ts_gate_ops) {
+        /*
+         * Daisy chain: below another tunnel's gate. DMA goes through
+         * that gate too, so a closed outer tunnel also cuts this one.
+         */
+        upstream = &((USB4TunnelSlot *)iommu_bus->iommu_opaque)->gate_root;
+    } else if (iommu_bus && iommu_bus->iommu_ops) {
+        error_setg(errp, "%s cannot sit below a virtual IOMMU (its DMA "
+                   "gate replaces the bus DMA hook)",
+                   object_get_typename(OBJECT(bridge)));
+        return false;
+    }
+
+    memory_region_init(&ts->gate_root, OBJECT(bridge), "usb4-tunnel-gate",
+                       UINT64_MAX);
+    memory_region_init_alias(&ts->gate_alias, OBJECT(bridge),
+                             "usb4-tunnel-gate-dma", upstream, 0,
+                             memory_region_size(upstream));
+    memory_region_add_subregion(&ts->gate_root, 0, &ts->gate_alias);
+    address_space_init(&ts->gate_as, &ts->gate_root, "usb4-tunnel-gate");
+    pci_setup_iommu(ts_sec_bus(ts), &ts_gate_ops, ts);
+    ts_ones_init(ts);
+
+    ts->bh = qemu_bh_new_guarded(ts_bh, ts,
+                                 &DEVICE(bridge)->mem_reentrancy_guard);
+    ts->eject_timer = timer_new_ms(QEMU_CLOCK_VIRTUAL, ts_eject_timeout, ts);
+    ts->settle_timer = timer_new_ms(QEMU_CLOCK_VIRTUAL, ts_settle_timeout,
+                                    ts);
+    ts->retry_timer = timer_new_ms(QEMU_CLOCK_REALTIME, ts_settle_timeout,
+                                   ts);
+    ts->machine_done.notify = ts_machine_done;
+    qemu_add_machine_init_done_notifier(&ts->machine_done);
+
+    /* Closed until the tunnel comes up. */
+    ts->gate_closed = false;
+    ts_tunnel_gate(ts, true);
+    ts->tunnel_up = ts->force_tunnel;
+    usb4_harness_realize(ts);
+    return true;
+}
+
+void usb4_tunnel_slot_unrealize(USB4TunnelSlot *ts)
+{
+    if (!ts->bh) {
+        return;     /* never realized, or already released */
+    }
+    ts_parked = g_slist_remove(ts_parked, ts);
+    qemu_remove_machine_init_done_notifier(&ts->machine_done);
+    timer_free(ts->eject_timer);
+    timer_free(ts->settle_timer);
+    timer_free(ts->retry_timer);
+    qemu_bh_delete(ts->bh);
+    ts->bh = NULL;
+    /* An endpoint below goes away with the bridge's secondary bus. */
+    ts->ep = NULL;
+    ts->ep_state = EP_NONE;
+    usb4_harness_free(ts);
+    /* Namespaces still present go away with the subsystem bus. */
+    while (ts->ns_devs->len) {
+        object_unref(g_ptr_array_steal_index(ts->ns_devs, 0));
+    }
+    while (ts->ns_dead->len) {
+        object_unref(g_ptr_array_steal_index(ts->ns_dead, 0));
+    }
+    g_ptr_array_free(ts->ns_devs, true);
+    g_ptr_array_free(ts->ns_dead, true);
+    ts->ns_devs = ts->ns_dead = NULL;
+    address_space_destroy(&ts->gate_as);
+    ts_ones_release(ts);
+    g_free(ts->up_drive);
+    g_free(ts->up_serial);
+    g_free(ts->up_namespaces);
+    g_free(ts->up_nic_netdev);
+    g_free(ts->up_usb_drive);
+    g_free(ts->up_dev_path);
+}
+
+void usb4_tunnel_slot_finalize(USB4TunnelSlot *ts)
+{
+    /*
+     * A harness created by a property set on a bridge that was never
+     * realized, or failed to realize (unrealize did not run), or by a
+     * property access after unrealize.
+     */
+    usb4_harness_free(ts);
+}
+
+/* ------------------------------------------------------------------ */
+/* Entry points from the fabric and QOM                                 */
+/* ------------------------------------------------------------------ */
+
+static USB4TunnelSlot *ts_from_object(Object *obj)
+{
+    if (!obj || !object_dynamic_cast(obj, TYPE_USB4_TUNNEL_TARGET)) {
+        return NULL;
+    }
+    return USB4_TUNNEL_TARGET_GET_CLASS(obj)->get_slot(obj);
+}
+
+USB4TunnelSlot *usb4_tunnel_slot_from_object(Object *obj)
+{
+    return ts_from_object(obj);
+}
+
+void usb4_tunnel_port_set_state(USB4TunnelPort *p, USB4Device *dev,
+                                USB4TunnelState st, USB4TunnelReason why)
+{
+    USB4TunnelSlot *ts = ts_from_object(OBJECT(p));
+
+    /* A target being torn down takes no more transitions (review 2 #1). */
+    if (ts && ts_alive(ts)) {
+        usb4_tunnel_slot_set_state(ts, dev, st, why);
+    }
+}
+
+/*
+ * The bridge as the power domain of a whole controller (tb3-alpine-ridge
+ * with BIOS Assist, ICM-PROTOCOL.md R27): the slot's access gate covers
+ * config, INTx, the forwarding windows and the DMA (and so MSI) of every
+ * function below. The occupant present at that point (the controller's
+ * switch upstream port) becomes the slot's endpoint, so a guest command
+ * that turns the slot off removes it from the bottom half under the
+ * lifecycle serialization (review 2 #1), never inline.
+ */
+void usb4_tunnel_port_power_domain(USB4TunnelPort *p, bool powered)
+{
+    USB4TunnelSlot *ts = ts_from_object(OBJECT(p));
+    PCIDevice *occ;
+
+    if (!ts || !ts_alive(ts)) {
+        return;
+    }
+    occ = ts_sec_bus(ts)->devices[ts->ops->ep_devfn];
+    if (!ts->ep && occ) {
+        ts->ep = occ;
+        ts->ep_gen = ++ts->next_gen;
+        ts->ep_state = EP_LIVE;
+    }
+    if (ts->ops->domain_power) {
+        ts->ops->domain_power(ts, powered);
+        return;
+    }
+    ts_tunnel_gate(ts, !powered);
+}
+
+bool usb4_tunnel_port_power_cycling(USB4TunnelPort *p)
+{
+    USB4TunnelSlot *ts = p ? ts_from_object(OBJECT(p)) : NULL;
+
+    return ts && ts->power_cycling;
+}
+
+/*
+ * Machine reset (review 2 #5, #6): a tunnel the firmware CM built during
+ * the reset, or before this target existed, gets its endpoint as a cold
+ * insertion before guest firmware runs (from the reset's hold phase),
+ * with the slot powered as at power-on.
+ */
+void usb4_tunnel_port_cold_reconcile(USB4TunnelPort *p, USB4Device *dev)
+{
+    USB4TunnelSlot *ts = ts_from_object(OBJECT(p));
+    Object *bridge;
+
+    if (!ts || !ts_alive(ts) || !ts->machine_ready || ts_running) {
+        return;
+    }
+    if (ts->ep && ts->ep_state == EP_LIVE && !ts->guest_unplug) {
+        return;                 /* the live endpoint is the tunnel's */
+    }
+    bridge = OBJECT(ts->bridge);
+    object_ref(bridge);
+    if (ts->ep) {
+        /*
+         * Review 3 #2: an obsolete occupant (its tunnel went down, or the
+         * guest turned the slot off, and the deferred work has not run):
+         * the machine reset has already reset it, so finish its removal
+         * now as a surprise, under the lifecycle serialization, instead
+         * of leaving the replacement to wait for it and the settle time.
+         */
+        trace_usb4_tp_stale(usb4_tunnel_slot_name(ts), ts->ep_gen,
+                            "reset reconcile");
+        ts_running = ts;
+        blk_drain_all();
+        if (ts_alive(ts) && ts->ep) {
+            ts_surprise_remove(ts);
+        }
+        if (ts_alive(ts)) {
+            ts_ns_release(ts);
+        }
+        ts_running = NULL;
+        ts_unpark();
+        if (!ts_alive(ts) || ts->ep) {
+            object_unref(bridge);
+            return;
+        }
+        /*
+         * The removed endpoint releases its drive when it is finalized,
+         * after an RCU grace period; the replacement needs that drive
+         * now. The CPUs are stopped for the reset, so wait for it.
+         */
+        drain_call_rcu();
+        if (!ts_alive(ts)) {
+            object_unref(bridge);
+            return;
+        }
+    }
+    /*
+     * The reset also reset the slot registers: deferred guest commands
+     * and the eject, settle and retry timers of the old occupant are
+     * stale.
+     */
+    ts->guest_unplug = false;
+    ts->power_pending = false;
+    timer_del(ts->eject_timer);
+    ts->eject_expired = false;
+    timer_del(ts->settle_timer);
+    timer_del(ts->retry_timer);
+    ts->insert_retries = 0;
+    object_unref(bridge);
+    if (dev) {
+        ts_take_device(ts, dev);
+    }
+    if (!ts->tunnel_up) {
+        ts->dismissed = false;
+    }
+    ts->tunnel_up = true;
+    ts->reason = USB4_TUNNEL_REASON_UP;
+    ts->awaiting_ack = false;
+    ts_tunnel_gate(ts, false);
+    if (ts_insert(ts, true) != TS_INSERT_OK) {
+        return;
+    }
+    /*
+     * The bridge's own reset may already have found the slot empty and
+     * turned it off: redo the slot part of that reset, which powers a
+     * populated slot (PCIe Slot Control, or the SHPC slot state).
+     */
+    if (pci_is_express(ts->bridge) && ts->bridge->exp.exp_cap &&
+        (pci_get_word(ts->bridge->config + ts->bridge->exp.exp_cap +
+                      PCI_EXP_FLAGS) & PCI_EXP_FLAGS_SLOT)) {
+        pcie_cap_slot_reset(ts->bridge);
+    } else if (ts->bridge->shpc) {
+        shpc_reset(ts->bridge);
+    }
+    usb4_tunnel_slot_update_gate(ts);
+}
+
+uint16_t usb4_tunnel_port_rid(USB4TunnelPort *p)
+{
+    return p ? pci_get_bdf(PCI_DEVICE(p)) : 0;
+}
+
+char *usb4_tunnel_slot_get_tunnel(USB4TunnelSlot *ts)
+{
+    return g_strdup(ts->tunnel_up ? "up" : "down");
+}
+
+/* Debug/demo override of the tunnel state, independent of the CM. */
+void usb4_tunnel_slot_set_tunnel(USB4TunnelSlot *ts, const char *value,
+                                 Error **errp)
+{
+    if (!strcmp(value, "up")) {
+        /*
+         * Use the device router on this bridge's host USB4 port, if any, so
+         * a forced tunnel exposes the same drive as a CM-built one; the
+         * bridge's nvme-drive/nvme-serial are the fallback.
+         */
+        usb4_tunnel_slot_set_state(ts, ts_forced_device(ts), USB4_TUNNEL_UP,
+                                   USB4_TUNNEL_REASON_UP);
+    } else if (!strcmp(value, "down") || !strcmp(value, "admin-down")) {
+        usb4_tunnel_slot_set_state(ts, NULL, USB4_TUNNEL_DOWN,
+                                   USB4_TUNNEL_REASON_ADMIN_DOWN);
+    } else if (!strcmp(value, "eject")) {
+        usb4_tunnel_slot_set_state(ts, NULL, USB4_TUNNEL_DOWN,
+                                   USB4_TUNNEL_REASON_EJECT);
+    } else if (!strcmp(value, "surprise")) {
+        usb4_tunnel_slot_set_state(ts, NULL, USB4_TUNNEL_DOWN,
+                                   USB4_TUNNEL_REASON_SURPRISE);
+    } else {
+        error_setg(errp, "tunnel must be up, down, eject or surprise");
+    }
+}
+
+void usb4_tunnel_slot_set_hold(USB4TunnelSlot *ts, bool hold)
+{
+    ts->hold_deferred = hold;
+    if (!hold && ts->bh) {
+        ts_schedule(ts);
+    }
+}
+
+char *usb4_tunnel_slot_get_endpoint(USB4TunnelSlot *ts)
+{
+    static const char *const names[] = {
+        "none", "live", "doomed", "quiesced", "ejecting",
+    };
+
+    return g_strdup_printf("%s gen=%" PRIu64 " gate=%s%s%s%s",
+                           names[ts->ep_state], ts->ep_gen,
+                           ts->gate_closed ? "closed" : "open",
+                           ts->gate_closed && !ts->dma_closed ?
+                           " dma=open" : "",
+                           ts->awaiting_ack ? " awaiting-ack" : "",
+                           ts->dismissed ? " dismissed" : "");
+}
+
+static char *ts_prop_get_tunnel(Object *obj, Error **errp)
+{
+    return usb4_tunnel_slot_get_tunnel(ts_from_object(obj));
+}
+
+static void ts_prop_set_tunnel(Object *obj, const char *value, Error **errp)
+{
+    usb4_tunnel_slot_set_tunnel(ts_from_object(obj), value, errp);
+}
+
+static bool ts_prop_get_hold(Object *obj, Error **errp)
+{
+    return ts_from_object(obj)->hold_deferred;
+}
+
+static void ts_prop_set_hold(Object *obj, bool value, Error **errp)
+{
+    usb4_tunnel_slot_set_hold(ts_from_object(obj), value);
+}
+
+static char *ts_prop_get_endpoint(Object *obj, Error **errp)
+{
+    return usb4_tunnel_slot_get_endpoint(ts_from_object(obj));
+}
+
+static char *ts_prop_get_identity(Object *obj, Error **errp)
+{
+    return usb4_tunnel_slot_identity(ts_from_object(obj));
+}
+
+/*
+ * Not migratable yet. The slot state (tunnel and gate state, endpoint
+ * lifecycle and generation, deferred guest commands, the SHPC claim) is
+ * in no vmstate, and the PCI config load rebuilds the bridge windows
+ * with pci_bridge_update_mappings() directly, which would re-enable the
+ * forwarding aliases behind a closed gate. Block migration and savevm,
+ * as usb4-host does, until the slot state is migrated and the gate is
+ * re-applied after load.
+ */
+static const VMStateDescription ts_vmstate_unmigratable = {
+    .name = "usb4-tunnel-slot",
+    .unmigratable = 1,
+};
+
+/* Call last in the tunnel bridge type's class_init. */
+void usb4_tunnel_slot_class_init(ObjectClass *klass)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    ResettableClass *rc = RESETTABLE_CLASS(klass);
+
+    dc->vmsd = &ts_vmstate_unmigratable;
+    /* The parent bridges reset with a legacy hold only: no exit to chain. */
+    assert(!rc->phases.exit);
+    rc->phases.exit = ts_reset_exit;
+    object_class_property_add_str(klass, "tunnel", ts_prop_get_tunnel,
+                                  ts_prop_set_tunnel);
+    object_class_property_set_description(klass, "tunnel",
+        "Tunnel state: up, down (admin-down), eject or surprise. Writable "
+        "at runtime with qom-set to force the tunnel without the CM.");
+    object_class_property_add_bool(klass, "x-hold-deferred",
+                                   ts_prop_get_hold, ts_prop_set_hold);
+    object_class_property_add_str(klass, "endpoint", ts_prop_get_endpoint,
+                                  NULL);
+    /* debug and tests: usb4_tunnel_slot_identity() */
+    object_class_property_add_str(klass, "x-identity", ts_prop_get_identity,
+                                  NULL);
+    usb4_harness_class_init(klass);
+}
+
+static const TypeInfo usb4_tunnel_target_info = {
+    .name = TYPE_USB4_TUNNEL_TARGET,
+    .parent = TYPE_INTERFACE,
+    .class_size = sizeof(USB4TunnelTargetClass),
+};
+
+static void usb4_tunnel_target_register_types(void)
+{
+    type_register_static(&usb4_tunnel_target_info);
+}
+
+type_init(usb4_tunnel_target_register_types)
diff --git a/hw/usb4/usb4-tunnel-slot.h b/hw/usb4/usb4-tunnel-slot.h
new file mode 100644
index 0000000000000000000000000000000000000000..b4ce3471087c575cfb48b8fbc046e8bce537252a
--- /dev/null
+++ b/hw/usb4/usb4-tunnel-slot.h
@@ -0,0 +1,273 @@
+/*
+ * USB4 PCIe tunnel: the access gate and endpoint lifecycle shared by the
+ * gated bridge types (usb4-tunnel-port on q35, usb4-tunnel-bridge on
+ * i440FX).
+ *
+ * Copyright (c) 2026 usb4-emu contributors
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Written from scratch for the usb4-emu project; design in
+ * docs/ARCHITECTURE.md section 4.4.
+ */
+
+#ifndef HW_USB4_TUNNEL_SLOT_H
+#define HW_USB4_TUNNEL_SLOT_H
+
+#include "qemu/notify.h"
+#include "qemu/timer.h"
+#include "system/memory.h"
+#include "hw/pci/pci_device.h"
+#include "qom/object.h"
+#include "usb4-internal.h"
+
+/*
+ * QOM interface implemented by every device usb4_tunnel_port_set_state()
+ * accepts (the USB4TunnelPort handle is really an Object of either type).
+ */
+#define TYPE_USB4_TUNNEL_TARGET "usb4-tunnel-target"
+typedef struct USB4TunnelSlot USB4TunnelSlot;
+typedef struct USB4TunnelTargetClass {
+    InterfaceClass parent_class;
+    USB4TunnelSlot *(*get_slot)(Object *obj);
+} USB4TunnelTargetClass;
+DECLARE_CLASS_CHECKERS(USB4TunnelTargetClass, USB4_TUNNEL_TARGET,
+                       TYPE_USB4_TUNNEL_TARGET)
+
+typedef enum USB4EndpointState {
+    EP_NONE = 0,    /* slot empty */
+    EP_LIVE,        /* present, tunnel up */
+    EP_DOOMED,      /* gate closed by a down transition, not quiesced */
+    EP_QUIESCED,    /* reset and drained; past the guest-memory cutoff */
+    EP_EJECTING,    /* orderly removal requested, waiting for the guest */
+} USB4EndpointState;
+
+/*
+ * Test harness override of the access gate (docs/HARNESS.md), on top of
+ * the tunnel and slot state. Neither mode starts stages 2-4: the
+ * endpoint is not reset, quiesced or removed.
+ */
+typedef enum USB4HarnessGate {
+    USB4_HGATE_NONE = 0,    /* no override */
+    USB4_HGATE_CLOSED,      /* the whole gate closed (as stage 1) */
+    USB4_HGATE_READS_FAIL,  /* MMIO, config and INTx gated, DMA open */
+} USB4HarnessGate;
+
+typedef struct USB4Harness USB4Harness;
+
+/* Index into USB4TunnelSlot.gate_ones[]. */
+enum {
+    USB4_TS_ONES_MEM,
+    USB4_TS_ONES_PREF_MEM,
+    USB4_TS_ONES_IO,
+    USB4_TS_ONES_VGA_MEM,
+    USB4_TS_ONES_VGA_IO_LO,
+    USB4_TS_ONES_VGA_IO_HI,
+    USB4_TS_ONES_NUM,
+};
+
+typedef struct USB4TunnelSlotOps {
+    /* devfn of the endpoint on the secondary bus */
+    int ep_devfn;
+    /* The bridge can host a dock (PCIe switch); PCIe ports only. */
+    bool dock_capable;
+    /* Remove ts->ep without asking the guest; must end in unplugged(). */
+    void (*surprise_remove)(USB4TunnelSlot *ts);
+    /* Ask the guest to eject ts->ep (may complete synchronously). */
+    void (*request_eject)(USB4TunnelSlot *ts, Error **errp);
+    /* After a successful insertion. */
+    void (*after_insert)(USB4TunnelSlot *ts, bool cold);
+    /* Optional: the bridge's own slot state keeps the gate closed. */
+    bool (*slot_blocks_access)(USB4TunnelSlot *ts);
+    /* Optional: extra machine-done work. */
+    void (*machine_done)(USB4TunnelSlot *ts);
+    /* Optional: apply the guest's slot power to the devices below. */
+    void (*apply_power)(USB4TunnelSlot *ts);
+    /* Optional: after apply_power() and the gate update. */
+    void (*power_done)(USB4TunnelSlot *ts);
+    /*
+     * Optional: the bridge is the power domain of a controller
+     * (usb4_tunnel_port_power_domain()) and handles the power change
+     * itself, gating with usb4_tunnel_slot_domain_gate() (root-bus
+     * usb4-tunnel-bridge: ARCHITECTURE.md 4.4a).
+     */
+    void (*domain_power)(USB4TunnelSlot *ts, bool powered);
+} USB4TunnelSlotOps;
+
+struct USB4TunnelSlot {
+    PCIDevice *bridge;
+    const USB4TunnelSlotOps *ops;
+
+    /* properties (owned by the device, defined with these fields) */
+    char *nvme_drive;           /* used when the tunnel has no device */
+    char *nvme_serial;
+    char *nvme_namespaces;      /* "nsid:drive[;...]": nvme-ns children */
+    uint32_t nvme_nn;           /* nvme x-nn (0: default) */
+    bool force_tunnel;          /* tunnel up from machine start */
+    bool hold_deferred;         /* test hook: hold stages 2-4 */
+    uint32_t eject_timeout_ms;
+    uint32_t settle_ms;
+    bool orderly_admin_down;
+
+    /* access gate */
+    MemoryRegion gate_root;
+    MemoryRegion gate_alias;
+    AddressSpace gate_as;
+    /*
+     * Master-abort stand-ins for the forwarding windows (mem, prefetchable
+     * mem, I/O, VGA mem, VGA I/O lo/hi) on the primary bus: enabled only
+     * while the gate is closed, reads return all-ones, writes are dropped.
+     */
+    MemoryRegion gate_ones[USB4_TS_ONES_NUM];
+    bool tunnel_closed;         /* closed by the tunnel state */
+    bool gate_closed;           /* effective: tunnel or slot state */
+    bool dma_closed;            /* gate_alias disabled */
+    USB4HarnessGate hgate;      /* test harness override */
+    USB4Harness *harness;       /* test harness state, or NULL */
+
+    /* tunnel state as last reported */
+    bool tunnel_up;
+    USB4TunnelReason reason;
+    char *up_drive;             /* endpoint parameters for the next insert */
+    char *up_serial;
+    char *up_namespaces;
+    uint32_t up_nn;
+    bool up_dock;               /* insert a dock, not a single NVMe */
+    bool up_asm2464;            /* the ASM2464's switch, then the NVMe */
+    char *up_nic_netdev;
+    char *up_usb_drive;
+    /*
+     * Daisy chain: the device's downstream USB4 ports, each a hot-plug
+     * downstream port (usb4-tunnel-dsp) of the switch the tunnel brings
+     * up, and the device's QOM path they report to.
+     */
+    unsigned up_ndfp;
+    char *up_dev_path;
+    /* Tunnel bridges above this one (0 for a root port). */
+    unsigned depth;
+    unsigned power_retries;     /* hot insert not yet powered by guest */
+
+    /* endpoint lifecycle */
+    PCIDevice *ep;
+    GPtrArray *ns_devs;         /* nvme-ns children of the endpoint */
+    GPtrArray *ns_dead;         /* ... of a removed one, to release */
+    USB4EndpointState ep_state;
+    uint64_t ep_gen;
+    uint64_t next_gen;
+    bool dismissed;             /* guest/user removed it while up */
+    bool awaiting_ack;          /* slot went empty, guest has not acked */
+    int64_t empty_since_ms;
+    bool machine_ready;
+
+    QEMUBH *bh;
+    QEMUTimer *eject_timer;
+    uint64_t eject_timer_gen;
+    bool eject_expired;         /* eject timer fired for eject_timer_gen */
+    /* Guest slot commands whose device side effects wait for the BH */
+    bool guest_unplug;          /* slot turned off: remove the occupant */
+    uint64_t guest_unplug_gen;
+    bool power_pending;         /* slot power changed: apply_power() */
+    QEMUTimer *settle_timer;
+    QEMUTimer *retry_timer;     /* realtime: insert retry */
+    unsigned insert_retries;
+    Notifier machine_done;
+    /* The bridge is resetting its power domain (a controller power-up). */
+    bool power_cycling;
+};
+
+/* Call from the bridge's realize, after the parent realize. */
+bool usb4_tunnel_slot_realize(USB4TunnelSlot *ts, PCIDevice *bridge,
+                              const USB4TunnelSlotOps *ops, Error **errp);
+/* From every gated bridge type's unrealize/exit, before the parent's. */
+void usb4_tunnel_slot_unrealize(USB4TunnelSlot *ts);
+/* From every gated bridge type's instance_finalize. */
+void usb4_tunnel_slot_finalize(USB4TunnelSlot *ts);
+
+/*
+ * usb4-tunnel-port.c: slot mechanics of a PCIe bridge with a native
+ * hot-plug slot, shared by usb4-tunnel-port and usb4-tunnel-dsp.
+ */
+void usb4_pcie_slot_surprise_remove(USB4TunnelSlot *ts);
+void usb4_pcie_slot_request_eject(USB4TunnelSlot *ts, Error **errp);
+void usb4_pcie_slot_after_insert(USB4TunnelSlot *ts, bool cold);
+void usb4_pcie_slot_apply_power(USB4TunnelSlot *ts);
+void usb4_pcie_slot_power_done(USB4TunnelSlot *ts);
+/* Defer the device side effects of Slot Control writes (after realize). */
+void usb4_pcie_slot_defer_init(USB4TunnelSlot *ts);
+/* After a guest config write; @old_*: Slot Control/Status before it. */
+void usb4_pcie_slot_config_written(USB4TunnelSlot *ts, uint32_t addr,
+                                   uint32_t val, int len, uint16_t old_ctl,
+                                   uint16_t old_sta);
+
+#define TYPE_USB4_TUNNEL_DSP "usb4-tunnel-dsp"
+
+void usb4_tunnel_slot_set_state(USB4TunnelSlot *ts, USB4Device *dev,
+                                USB4TunnelState st, USB4TunnelReason why);
+/* Re-evaluate the effective gate (tunnel state and slot state). */
+void usb4_tunnel_slot_update_gate(USB4TunnelSlot *ts);
+/*
+ * Re-disable forwarding windows and re-place their all-ones stand-ins
+ * while gated (remove the stand-ins while open); call inside a
+ * transaction after any guest write to the bridge's config space.
+ */
+void usb4_tunnel_slot_apply_window_gate(USB4TunnelSlot *ts);
+/* Call from the hot-plug handler's unplug, after the parent's. */
+void usb4_tunnel_slot_unplugged(USB4TunnelSlot *ts, DeviceState *dev,
+                                bool was_ours);
+bool usb4_tunnel_slot_is_endpoint(USB4TunnelSlot *ts, DeviceState *dev);
+/* The guest acknowledged the empty slot (cleared its presence event). */
+void usb4_tunnel_slot_empty_acked(USB4TunnelSlot *ts);
+/*
+ * From a guest slot command (config/MMIO write): the slot was turned off
+ * with the occupant present, or its power changed. Gate now, act later.
+ */
+void usb4_tunnel_slot_guest_unplug(USB4TunnelSlot *ts);
+void usb4_tunnel_slot_guest_power(USB4TunnelSlot *ts);
+const char *usb4_tunnel_slot_name(USB4TunnelSlot *ts);
+/*
+ * What the slot's next (or current) endpoint presents: every parameter
+ * the insertion builds it from. Caller frees.
+ */
+char *usb4_tunnel_slot_identity(USB4TunnelSlot *ts);
+/* Close or open the gate as the tunnel state would (stage 1 only). */
+void usb4_tunnel_slot_domain_gate(USB4TunnelSlot *ts, bool closed);
+/*
+ * usb4-tunnel-bridge.c: a tunnel slot inserted @ep; in a tree that came
+ * back with root-hotplug=restore, give it the configuration of the
+ * function that stood there when the tree left (ARCHITECTURE.md 4.4a).
+ */
+void usb4_tunnel_bridge_restore_inserted(PCIDevice *ep);
+/* QMP USB4_TUNNEL_ENDPOINT for this bridge. */
+void usb4_tunnel_slot_event(USB4TunnelSlot *ts, uint64_t gen,
+                            const char *stage);
+/* The slot of a tunnel target object, or NULL. */
+USB4TunnelSlot *usb4_tunnel_slot_from_object(Object *obj);
+/* Schedule the slot's bottom half (no-op once unrealized). */
+void usb4_tunnel_slot_schedule(USB4TunnelSlot *ts);
+/*
+ * Take the lifecycle serialization of every tunnel slot (no slot's
+ * quiesce, removal or insertion runs until _end(); their bottom halves
+ * are parked) around a step that drains block I/O outside a slot bottom
+ * half. False if a lifecycle step is already running or @ts is gone.
+ * _end() drops the bridge reference _begin() took: it may finalize @ts.
+ */
+bool usb4_tunnel_slot_lifecycle_begin(USB4TunnelSlot *ts);
+void usb4_tunnel_slot_lifecycle_end(USB4TunnelSlot *ts);
+/* Harness gate override; synchronous like stage 1 (docs/HARNESS.md). */
+void usb4_tunnel_slot_set_harness_gate(USB4TunnelSlot *ts,
+                                       USB4HarnessGate mode);
+
+/* QOM property helpers for the "tunnel", "x-hold-deferred", "endpoint"
+ * properties. */
+char *usb4_tunnel_slot_get_tunnel(USB4TunnelSlot *ts);
+void usb4_tunnel_slot_set_tunnel(USB4TunnelSlot *ts, const char *value,
+                                 Error **errp);
+void usb4_tunnel_slot_set_hold(USB4TunnelSlot *ts, bool hold);
+char *usb4_tunnel_slot_get_endpoint(USB4TunnelSlot *ts);
+/*
+ * Registers the three properties on a class implementing the interface,
+ * the reset exit phase that rebuilds the windows, and the vmstate that
+ * blocks migration. Call last in class_init (after any legacy reset).
+ */
+void usb4_tunnel_slot_class_init(ObjectClass *klass);
+
+#endif
diff --git a/hw/usb4/usb4-tunnel.c b/hw/usb4/usb4-tunnel.c
new file mode 100644
index 0000000000000000000000000000000000000000..7bacec2b9cc1fb99611f4061056d659ffd1ab6d6
--- /dev/null
+++ b/hw/usb4/usb4-tunnel.c
@@ -0,0 +1,41 @@
+/*
+ * USB4 PCIe tunnel evaluator
+ *
+ * Copyright (c) 2026 usb4-emu contributors
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Written from scratch for the usb4-emu project. A pure function of the
+ * normalised fabric state, identical for both host profiles
+ * (docs/ARCHITECTURE.md section 4.3, Guide 5.2 and 5.3).
+ */
+#include "qemu/osdep.h"
+#include "usb4-internal.h"
+
+USB4TunnelState usb4_tunnel_evaluate(const USB4TunnelInputs *in)
+{
+    /* 1. The device router is attached and its lanes report link up. */
+    if (!in->device_attached || !in->lanes_up) {
+        return USB4_TUNNEL_DOWN;
+    }
+    /* 2. Both routers are ready_for_pcie (Spec Table 8-3 CV/PTO/CR). */
+    if (!in->host_ready_for_pcie || !in->device_ready_for_pcie) {
+        return USB4_TUNNEL_DOWN;
+    }
+    /* 3. A valid path in each direction through every hop (Guide 5.3.1). */
+    if (!in->path_down_valid || !in->path_up_valid) {
+        return USB4_TUNNEL_DOWN;
+    }
+    /* 4. Path Enable on both PCIe adapters (ADP_PCIE_CS_0.PE). */
+    if (!in->host_pcie_enabled || !in->dev_pcie_enabled) {
+        return USB4_TUNNEL_DOWN;
+    }
+    /*
+     * 4a. Daisy chain: the parent device router's own tunnel is up, so
+     * its PCIe switch and the PCIe Downstream adapter behind it exist.
+     */
+    if (!in->upstream_tunnel_up) {
+        return USB4_TUNNEL_DOWN;
+    }
+    /* 5. LTSSM leaves Detect: reported by the fabric once 1-4 hold. */
+    return USB4_TUNNEL_UP;
+}
diff --git a/hw/usb4/usb4-usb3.c b/hw/usb4/usb4-usb3.c
new file mode 100644
index 0000000000000000000000000000000000000000..a9daede466989b22bd2e78e5e635253920d16c97
--- /dev/null
+++ b/hw/usb4/usb4-usb3.c
@@ -0,0 +1,265 @@
+/*
+ * USB4 USB3 tunneling: QEMU USB devices behind a device router
+ *
+ * Copyright (c) 2026 usb4-emu contributors
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Written from scratch for the usb4-emu project.
+ *
+ * Model. On real hardware the host router's USB3 Gen X Down adapter for
+ * USB4 port p is wired to a SuperSpeed root port of the platform xHCI,
+ * and the device router's USB3 Gen X Upstream adapter feeds a USB hub in
+ * the enclosure. The USB3 link between the two only exists while the CM
+ * has a USB3 tunnel up (Guide 5.5). Here:
+ *
+ *  - the user creates the USB devices on a qemu-xhci port as usual
+ *    (-device usb-storage,bus=xhci.0,port=4,drive=...,id=stor0) and names
+ *    them on the device router (usb4-device,...,usb3-dev=stor0[:id2...]);
+ *  - those devices are kept detached from their port (usb_device_detach,
+ *    port stays claimed) except while the fabric reports the USB3 tunnel
+ *    to that device router up (usb4-fabric-usb3.c);
+ *  - attach/detach runs from a bottom half, never from the MMIO context
+ *    that changed the fabric state, and at system reset (the fabric is
+ *    reset at the same time, so every tunnel is down).
+ *
+ * The desired state is kept per USB device id, not per device router, so
+ * a pending bottom half after device_del of the router still converges
+ * on the latest state (a re-added router starts with its tunnel down).
+ *
+ * ACPI. Microsoft "USB4 ACPI requirements" asks for a _DSD on the
+ * tunnel-capable SuperSpeed root hub port of the xHCI with the
+ * device-properties UUID, "usb4-host-interface" (reference to the host
+ * interface ACPI node) and "usb4-port-number". usb4-host properties
+ * usb3-xhci=<qemu-xhci id> and usb3-port1/usb3-port2=<QEMU USB port n>
+ * select the port; qemu-xhci exposes QEMU USB port n as xHCI USB2 port n
+ * and SuperSpeed port p2 + n, so the SS port node gets _ADR p2 + n.
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/error-report.h"
+#include "qemu/main-loop.h"
+#include "hw/core/qdev.h"
+#include "hw/core/sysbus.h"
+#include "hw/pci/pci.h"
+#include "hw/pci/pci_bus.h"
+#include "hw/usb/usb.h"
+#include "hw/usb/xhci.h"
+#include "hw/usb4/usb4-acpi.h"
+#include "system/reset.h"
+#include "usb4-internal.h"
+#include "trace.h"
+
+/* USB device id -> GINT_TO_POINTER(1 + want_attached) */
+static GHashTable *usb3_want;
+static QEMUBH *usb3_bh;
+
+static void usb3_apply(void);
+
+static void usb3_reset(void *opaque)
+{
+    usb3_apply();
+}
+
+static void usb3_bh_cb(void *opaque)
+{
+    usb3_apply();
+}
+
+static void usb3_init(void)
+{
+    if (usb3_want) {
+        return;
+    }
+    usb3_want = g_hash_table_new_full(g_str_hash, g_str_equal, g_free, NULL);
+    usb3_bh = qemu_bh_new(usb3_bh_cb, NULL);
+    qemu_register_reset(usb3_reset, NULL);
+}
+
+static USBDevice *usb3_find(const char *id)
+{
+    DeviceState *ds = qdev_find_recursive(sysbus_get_default(), id);
+
+    if (!ds || !object_dynamic_cast(OBJECT(ds), TYPE_USB_DEVICE)) {
+        return NULL;
+    }
+    return USB_DEVICE(ds);
+}
+
+static void usb3_apply(void)
+{
+    GHashTableIter it;
+    gpointer key, val;
+
+    if (!usb3_want) {
+        return;
+    }
+    g_hash_table_iter_init(&it, usb3_want);
+    while (g_hash_table_iter_next(&it, &key, &val)) {
+        const char *id = key;
+        bool want = GPOINTER_TO_INT(val) - 1;
+        USBDevice *dev = usb3_find(id);
+        Error *err = NULL;
+
+        if (!dev || !DEVICE(dev)->realized || !dev->port) {
+            trace_usb4_usb3_apply(id, "not found (yet)");
+            continue;
+        }
+        if (want == dev->attached) {
+            continue;
+        }
+        if (want) {
+            usb_device_attach(dev, &err);
+            if (err) {
+                warn_report_err(err);
+                trace_usb4_usb3_apply(id, "attach failed");
+                continue;
+            }
+            trace_usb4_usb3_apply(id, "attached");
+        } else {
+            usb_device_detach(dev);
+            trace_usb4_usb3_apply(id, "detached");
+        }
+    }
+}
+
+static void usb3_set_want(USB4Device *d, bool attach)
+{
+    const char *list = usb4_device_usb3_devs(d);
+    g_auto(GStrv) ids = NULL;
+
+    if (!list || !*list) {
+        return;
+    }
+    usb3_init();
+    ids = g_strsplit(list, ":", -1);
+    for (unsigned i = 0; ids[i]; i++) {
+        if (!*ids[i]) {
+            continue;
+        }
+        g_hash_table_insert(usb3_want, g_strdup(ids[i]),
+                            GINT_TO_POINTER(1 + attach));
+        trace_usb4_usb3_want(ids[i], attach);
+    }
+    qemu_bh_schedule(usb3_bh);
+}
+
+void usb4_device_usb3_tunnel(USB4Device *d, USB4TunnelState st,
+                             USB4TunnelReason why)
+{
+    usb3_set_want(d, st == USB4_TUNNEL_UP);
+}
+
+void usb4_usb3_device_realized(USB4Device *d)
+{
+    /* A new device router starts with its USB3 tunnel down. */
+    usb3_set_want(d, false);
+}
+
+void usb4_usb3_device_unrealized(USB4Device *d)
+{
+    usb3_set_want(d, false);
+}
+
+/* ------------------------------------------------------------------ */
+/* ACPI: _DSD port mapping on the xHCI root hub SuperSpeed ports       */
+/* ------------------------------------------------------------------ */
+
+#define UUID_DEVICE_PROPERTIES "DAFFD814-6EBA-4D8C-8A91-BC9BBF4AA301"
+
+static int usb3_scan_host(Object *obj, void *opaque)
+{
+    GSList **l = opaque;
+
+    if (object_dynamic_cast(obj, TYPE_USB4_HOST)) {
+        *l = g_slist_append(*l, obj);
+    }
+    return 0;
+}
+
+static Aml *usb3_prop(const char *name, Aml *value)
+{
+    Aml *pkg = aml_package(2);
+
+    aml_append(pkg, aml_string("%s", name));
+    aml_append(pkg, value);
+    return pkg;
+}
+
+static void usb3_build_host(Aml *sb_scope, PCIDevice *host)
+{
+    g_autofree char *xid = object_property_get_str(OBJECT(host),
+                                                   "usb3-xhci", NULL);
+    g_autofree char *host_path = NULL;
+    g_autofree char *xhci_path = NULL;
+    DeviceState *xds;
+    PCIDevice *xhci;
+    Aml *scope, *rhub;
+    uint64_t p2;
+
+    if (!xid || !*xid) {
+        return;
+    }
+    xds = qdev_find_recursive(sysbus_get_default(), xid);
+    if (!xds || !object_dynamic_cast(OBJECT(xds), "pci-xhci")) {
+        warn_report("usb4-host: usb3-xhci=%s is not a PCI xHCI", xid);
+        return;
+    }
+    xhci = PCI_DEVICE(xds);
+    if (!pci_bus_is_root(pci_get_bus(xhci)) ||
+        !pci_bus_is_root(pci_get_bus(host))) {
+        warn_report("usb4-host: the host and usb3-xhci=%s must be on the "
+                    "root PCI bus for the USB3 _DSD port mapping", xid);
+        return;
+    }
+    p2 = object_property_get_uint(OBJECT(xhci), "p2", NULL);
+    host_path = g_strdup_printf("\\_SB.PCI0.S%.02X", host->devfn);
+    xhci_path = g_strdup_printf("\\_SB.PCI0.S%.02X", xhci->devfn);
+
+    /* The Device(Sxx) of the xHCI is emitted earlier in the same DSDT. */
+    scope = aml_scope("%s", xhci_path);
+    rhub = aml_device("RHUB");
+    aml_append(rhub, aml_name_decl("_ADR", aml_int(0)));
+    for (unsigned p = 1; p <= 2; p++) {
+        g_autofree char *prop = g_strdup_printf("usb3-port%u", p);
+        uint64_t n = object_property_get_uint(OBJECT(host), prop, NULL);
+        Aml *port, *upc, *dsd, *props;
+
+        if (!n) {
+            continue;
+        }
+        port = aml_device("SS%.02u", (unsigned)(p2 + n) % 100);
+        aml_append(port, aml_name_decl("_ADR", aml_int(p2 + n)));
+        /* ACPI 6.4 9.14 _UPC: connectable, USB Type-C USB2 + SS */
+        upc = aml_package(4);
+        aml_append(upc, aml_int(0xff));
+        aml_append(upc, aml_int(0x09));
+        aml_append(upc, aml_int(0));
+        aml_append(upc, aml_int(0));
+        aml_append(port, aml_name_decl("_UPC", upc));
+        dsd = aml_package(2);
+        aml_append(dsd, aml_touuid(UUID_DEVICE_PROPERTIES));
+        props = aml_package(2);
+        aml_append(props, usb3_prop("usb4-host-interface",
+                                    aml_name("%s", host_path)));
+        aml_append(props, usb3_prop("usb4-port-number", aml_int(p)));
+        aml_append(dsd, props);
+        aml_append(port, aml_name_decl("_DSD", dsd));
+        aml_append(rhub, port);
+        trace_usb4_usb3_acpi(xhci_path, (unsigned)(p2 + n), p, host_path);
+    }
+    aml_append(scope, rhub);
+    aml_append(sb_scope, scope);
+}
+
+void usb4_acpi_build_usb3(Aml *sb_scope)
+{
+    GSList *hosts = NULL, *l;
+
+    object_child_foreach_recursive(object_get_root(), usb3_scan_host,
+                                   &hosts);
+    for (l = hosts; l; l = l->next) {
+        usb3_build_host(sb_scope, PCI_DEVICE(l->data));
+    }
+    g_slist_free(hosts);
+}
