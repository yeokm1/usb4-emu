+    qom_set_str(qts, TP_PATH, "x-gate", "normal");
+    g_assert(buf_is(qts, RAM_BUF, PATTERN));
+    g_assert(nv_peek(&nv, 1, cid, NULL, NULL));
+    qtest_quit(qts);
+    unlink(img);
+}
