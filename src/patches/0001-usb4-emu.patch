+/* amd: host-domain picks one of the four router device IDs; DROM name */
+static void test_amd_identity(void)
+{
+    QTestState *qts = qtest_init("-nodefaults -machine pc "
+                                 "-device usb4-host,id=u4,addr=04.0,"
+                                 "host-model=amd,host-domain=3");
+    uint32_t v[18];
+    Ring0 r;
+
+    ring0_start(&r, qts);
+    g_assert_cmphex(rd1(&r, 0, CS_ROUTER, 0, 0), ==, 0x020b0438);
+    /* PCI side stays the emulator's identity */
+    g_assert_cmphex(cfg_readl(qts, 0, NHI_DEVFN, 0), ==, 0x00f41b36);
+    /* DROM Read, 16 dwords at 0: vendor ID in the UID's top bits */
+    memset(v, 0, sizeof(v));
+    v[16] = 0x00080000;
+    v[17] = 0x80000024;
+    ring0_write(&r, 0, CS_ROUTER, 0, 9, 18, v);
+    ring0_read(&r, 0, CS_ROUTER, 0, 9, 18, v);
+    g_assert_cmphex(v[17] & 0x4000ffff, ==, 0x24);
+    qtest_quit(qts);
+}
+
+/* Events of route @route since event number @from, as adapter | unplug << 8 */
+static bool saw_ev(Ring0 *r, unsigned from, uint64_t route, unsigned ev)
+{
+    for (unsigned i = from; i < r->hp; i++) {
+        if (r->ev_route[i % 32] == route && r->ev[i % 32] == ev) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static unsigned count_ev(Ring0 *r, unsigned from, uint64_t route)
+{
+    unsigned n = 0;
+
+    for (unsigned i = from; i < r->hp; i++) {
+        n += r->ev_route[i % 32] == route;
+    }
+    return n;
+}
+
+/* Collect pending events: a harmless read lets them in */
+static void settle(Ring0 *r)
+{
+    for (int i = 0; i < 4; i++) {
+        qtest_clock_step(r->qts, 20 * 1000 * 1000);
+        rd1(r, 0, CS_ROUTER, 0, 0);
+    }
+}
+
+static void host_enumerate(Ring0 *r)
+{
+    uint32_t v[4];
+
+    ring0_read(r, 0, CS_ROUTER, 0, 1, 4, v);
+    v[2] |= 1u << 31;
+    v[3] = (v[3] & ~0xff00u) | 0x1000;
+    ring0_write(r, 0, CS_ROUTER, 0, 1, 4, v);
+}
+
+/* Unlock host lane 0 of the port, Plug Events + 1 = @pe, configure */
+static void tb3_configure(Ring0 *r, uint64_t route, unsigned hlane,
+                          uint32_t pe)
+{
+    uint32_t v[4] = { 0x0612c105, (uint32_t)route, 1u << 31, 0x020000ff };
+
+    rmw(r, 0, CS_ADAPTER, hlane, 4, 1u << 31, 0);
+    wr1(r, route, CS_ROUTER, 0, 0x29, pe);
+    ring0_write(r, route, CS_ROUTER, 0, 1, 4, v);
+    settle(r);
+}
+
+/* Bond host port 1 with the TB3 router at route 1 */
+static void tb3_bond(Ring0 *r)
+{
+    unsigned l1 = adp_cap(r, 0, 1, CAP_LANE) + 1;
+    unsigned l2 = adp_cap(r, 0, 2, CAP_LANE) + 1;
+
+    rmw(r, 1, CS_ADAPTER, 1, 0x37, 0, 0x30);
+    rmw(r, 1, CS_ADAPTER, 2, 0x37, 0, 0x30);
+    rmw(r, 0, CS_ADAPTER, 1, l1, 0, 3u << 4);
+    rmw(r, 0, CS_ADAPTER, 2, l2, 0, 3u << 4);
+    rmw(r, 0, CS_ADAPTER, 1, l1, 0, 1u << 15);
+    settle(r);
+}
+
+/*
+ * Plug Events dword 1 disables (Linux tb_regs.h TB_PLUG_EVENTS_*): with
+ * bits 3 and 4 set the TB3 router sends no lane or DP OUT events, also
+ * not after bonding; with bit 4 only its lane 1 plug still comes; events
+ * flow again once the bits are cleared.
+ */
+static void test_events(void)
+{
+    QTestState *qts = qtest_init("-nodefaults -machine pc "
+                                 "-device usb4-host,id=u4,addr=04.0 "
+                                 "-device usb4-device,id=enc0,bus=u4.0,"
+                                 "port=1,dialect=tb3");
+    unsigned from;
+    Ring0 r;
+
+    ring0_start(&r, qts);
+    host_enumerate(&r);
+    settle(&r);
+
+    /* lane and DP OUT events disabled */
+    from = r.hp;
+    tb3_configure(&r, 1, 1, 0x4e19);
+    g_assert_cmpuint(count_ev(&r, from, 1), ==, 0);
+    from = r.hp;
+    tb3_bond(&r);
+    g_assert(saw_ev(&r, from, 0, 2 | 1 << 8));      /* host lane 1 unplug */
+    g_assert_cmpuint(count_ev(&r, from, 1), ==, 0);
+
+    /* a new dock with DP OUT events disabled: only its lane 1 plug */
+    qtest_qmp_assert_success(qts, "{'execute': 'device_del', 'arguments': "
+                             "{'id': 'enc0'}}");
+    settle(&r);
+    qtest_qmp_assert_success(qts, "{'execute': 'device_add', 'arguments': "
+                             "{'driver': 'usb4-device', 'bus': 'u4.0', "
+                             "'id': 'enc1', 'port': 1, 'dialect': 'tb3'}}");
+    settle(&r);
+    from = r.hp;
+    tb3_configure(&r, 1, 1, 0x4e15);
+    g_assert_cmpuint(count_ev(&r, from, 1), ==, 1);
+    g_assert(saw_ev(&r, from, 1, 2));
+
+    /* lane events disabled, then enabled again before bonding */
+    qtest_qmp_assert_success(qts, "{'execute': 'device_del', 'arguments': "
+                             "{'id': 'enc1'}}");
+    settle(&r);
+    qtest_qmp_assert_success(qts, "{'execute': 'device_add', 'arguments': "
+                             "{'driver': 'usb4-device', 'bus': 'u4.0', "
+                             "'id': 'enc2', 'port': 1, 'dialect': 'tb3'}}");
+    settle(&r);
+    from = r.hp;
+    tb3_configure(&r, 1, 1, 0x4e0d);
+    g_assert_cmpuint(count_ev(&r, from, 1), ==, 2);
+    g_assert(saw_ev(&r, from, 1, 9) && saw_ev(&r, from, 1, 10));
+    wr1(&r, 1, CS_ROUTER, 0, 0x29, 0x4e01);
+    from = r.hp;
+    tb3_bond(&r);
+    g_assert(saw_ev(&r, from, 1, 2 | 1 << 8));      /* TB3 lane 1 unplug */
+    qtest_quit(qts);
+}
+
+/*
+ * DMA port flash read (docs/ICM-PROTOCOL.md 5.2) on the dock's Host
+ * Interface adapter 5: @n dwords from flash byte @addr into @out.
+ */
+static void dma_read(Ring0 *r, uint64_t route, uint32_t addr, unsigned n,
+                     uint32_t *out)
+{
+    uint32_t in = (2u << 28) | ((n & 0xf) << 24) | (addr & 0xfffffc) | 1;
+
+    wr1(r, route, CS_ADAPTER, 5, 0x4f, in);
+    /* request bit cleared, outbound valid with the command, status 0 */
+    g_assert_cmphex(rd1(r, route, CS_ADAPTER, 5, 0x4f), ==, in & ~1u);
+    g_assert_cmphex(rd1(r, route, CS_ADAPTER, 5, 0x50), ==, 0x20000020);
+    ring0_read(r, route, CS_ADAPTER, 5, 0x3f, n, out);
+}
+
+/* Data window dwords as flash bytes: little-endian, as the port fills it */
+static void put_le32s(uint8_t *p, const uint32_t *v, unsigned nbytes)
+{
+    for (unsigned i = 0; i < nbytes; i++) {
+        p[i] = v[i / 4] >> (8 * (i % 4));
+    }
+}
+
+static uint8_t drom_crc8(const uint8_t *p, size_t n)
+{
+    uint8_t c = 0xff;
+
+    while (n--) {
+        c ^= *p++;
+        for (int b = 0; b < 8; b++) {
+            c = (c & 0x80) ? (uint8_t)((c << 1) ^ 0x07) : c << 1;
+        }
+    }
+    return c;
+}
+
+/*
+ * The TS3 Plus's DMA port under a software CM. Observed (Framework 13,
+ * linux-ts3plus): adapter 5 is Host Interface typed with dword 0
+ * 0x15788086, the outbound word reads 0 at power-on, and flash reads give
+ * the flash size dwords at 0x44 and NVM version 44.0 at 0x08. Windows'
+ * built-in CM reads the DROM from the flash at the offset of router dword
+ * 0x34 and the eGPU dword at 0x734, whose bit 8 must be clear for a
+ * dock (inferred from Windows' behaviour, docs/USB4-HOSTS.md 8).
+ */
+static void test_dma_port(void)
+{
+    QTestState *qts = qtest_init("-nodefaults -machine pc "
+                                 "-device usb4-host,id=u4,addr=04.0 "
+                                 "-device usb4-device,id=enc0,bus=u4.0,"
+                                 "port=1,dialect=tb3");
+    uint8_t drom[256];
+    uint32_t v[16], base;
+    unsigned len;
+    Ring0 r;
+
+    ring0_start(&r, qts);
+    host_enumerate(&r);
+    settle(&r);
+    tb3_configure(&r, 1, 1, 0x4e01);
+
+    ring0_read(&r, 1, CS_ADAPTER, 5, 0, 3, v);
+    g_assert_cmphex(v[0], ==, 0x15788086);
+    g_assert_cmphex(v[1] & 0xff, ==, 0x3e);
+    g_assert_cmphex(v[2], ==, 0x01000002);
+    g_assert_cmphex(rd1(&r, 1, CS_ADAPTER, 5, 0x3e), ==, 0x13010552);
+    g_assert_cmphex(rd1(&r, 1, CS_ADAPTER, 5, 0x50), ==, 0);
+
+    dma_read(&r, 1, 0x44, 2, v);
+    g_assert_cmphex(v[0], ==, 0xaaaa2b2d);
+    g_assert_cmphex(v[1], ==, 0x0428a804);
+    dma_read(&r, 1, 0x08, 1, v);
+    g_assert_cmphex(v[0], ==, 0x10440000);
+    dma_read(&r, 1, 0x734, 1, v);
+    g_assert_cmphex(v[0] & 0x100, ==, 0);
+
+    /* The DROM at the EEPROM offset: header, then the rest, CRCs valid */
+    base = rd1(&r, 1, CS_ROUTER, 0, 0x34);
+    g_assert_cmphex(base, ==, 0x210);
+    dma_read(&r, 1, base, 4, v);
+    put_le32s(drom, v, 16);
+    len = 13 + ((drom[14] | drom[15] << 8) & 0xfff);
+    g_assert_cmpuint(len, <=, sizeof(drom));
+    for (unsigned off = 16; off < len; off += 64) {
+        dma_read(&r, 1, base + off, 16, v);
+        put_le32s(drom + off, v, MIN(64, sizeof(drom) - off));
+    }
+    g_assert_cmphex(drom_crc8(drom + 1, 8), ==, drom[0]);
+    g_assert_cmphex(crc32c(drom + 13, len - 13), ==,
+                    drom[9] | drom[10] << 8 | drom[11] << 16 |
+                    (uint32_t)drom[12] << 24);
+
+    /* Other commands fail with an access error; reset clears outbound */
+    wr1(&r, 1, CS_ADAPTER, 5, 0x4f, (1u << 28) | 1);
+    g_assert_cmphex(rd1(&r, 1, CS_ADAPTER, 5, 0x50), ==, 0x20000012);
+    qtest_qmp_assert_success(qts, "{'execute': 'device_del', 'arguments': "
+                             "{'id': 'enc0'}}");
+    settle(&r);
+    qtest_qmp_assert_success(qts, "{'execute': 'device_add', 'arguments': "
+                             "{'driver': 'usb4-device', 'bus': 'u4.0', "
+                             "'id': 'enc1', 'port': 1, 'dialect': 'tb3'}}");
+    settle(&r);
+    tb3_configure(&r, 1, 1, 0x4e01);
+    g_assert_cmphex(rd1(&r, 1, CS_ADAPTER, 5, 0x50), ==, 0);
+    qtest_quit(qts);
+}
+
+/*
+ * Two default TB3 docks get two link controller UUIDs (what Linux shows
+ * as unique_id and bolt stores), neither the captured one, and keep them
+ * across a re-plug; lc-uuid=captured is covered by run_model().
+ */
+static void test_two_docks(void)
+{
+    QTestState *qts = qtest_init("-nodefaults -machine pc "
+                                 "-device usb4-host,id=u4,addr=04.0 "
+                                 "-device usb4-device,id=enc0,bus=u4.0,"
+                                 "port=1,dialect=tb3,serial=A "
+                                 "-device usb4-device,id=enc1,bus=u4.0,"
+                                 "port=2,dialect=tb3,serial=B");
+    uint32_t a[4], b[4], a2[4];
+    Ring0 r;
+
+    ring0_start(&r, qts);
+    rmw(&r, 0, CS_ADAPTER, 1, 4, 1u << 31, 0);
+    rmw(&r, 0, CS_ADAPTER, 3, 4, 1u << 31, 0);
+    ring0_read(&r, 1, CS_ROUTER, 0, 0x102, 4, a);
+    ring0_read(&r, 3, CS_ROUTER, 0, 0x102, 4, b);
+    g_assert(memcmp(a, b, sizeof(a)));
+    g_assert_cmphex(a[0], !=, 0x000003c6);
+    g_assert_cmphex(b[0], !=, 0x000003c6);
+    qtest_qmp_assert_success(qts, "{'execute': 'device_del', 'arguments': "
+                             "{'id': 'enc0'}}");
+    qtest_qmp_assert_success(qts, "{'execute': 'device_add', 'arguments': "
+                             "{'driver': 'usb4-device', 'bus': 'u4.0', "
+                             "'id': 'enc0', 'port': 1, 'dialect': 'tb3', "
+                             "'serial': 'A'}}");
+    rmw(&r, 0, CS_ADAPTER, 1, 4, 1u << 31, 0);
+    ring0_read(&r, 1, CS_ROUTER, 0, 0x102, 4, a2);
+    g_assert(!memcmp(a, a2, sizeof(a)));
+    qtest_quit(qts);
+}
+
+/*
+ * Two hosts, each with a default dock (no serial) on port 1: the docks'
+ * link controller UUIDs differ (review P2: the per-device seed alone has
+ * no host identity).
+ */
+static void test_two_hosts(void)
+{
+    QTestState *qts = qtest_init("-nodefaults -machine pc "
+                                 "-device usb4-host,id=u4,addr=04.0 "
+                                 "-device usb4-host,id=u5,addr=05.0 "
+                                 "-device usb4-device,bus=u4.0,port=1,"
+                                 "dialect=tb3 "
+                                 "-device usb4-device,bus=u5.0,port=1,"
+                                 "dialect=tb3");
+    uint32_t a[4], b[4];
+    Ring0 r;
+
+    nhi_devfn = 4 << 3;
+    ring0_start(&r, qts);
+    rmw(&r, 0, CS_ADAPTER, 1, 4, 1u << 31, 0);
+    ring0_read(&r, 1, CS_ROUTER, 0, 0x102, 4, a);
+    cfg_writel(qts, 0, 4 << 3, 0x04, 0);        /* host u4 off the bus */
+    nhi_devfn = 5 << 3;
+    ring0_start(&r, qts);
+    rmw(&r, 0, CS_ADAPTER, 1, 4, 1u << 31, 0);
+    ring0_read(&r, 1, CS_ROUTER, 0, 0x102, 4, b);
+    nhi_devfn = NHI_DEVFN;
+    g_assert(memcmp(a, b, sizeof(a)));
+    qtest_quit(qts);
+}
+
+/*
+ * A two-deep chain as in the linux-ts3plus-orico capture: the ASM2464
+ * (USB4 device router) behind the TB3 dock's downstream port, reached at
+ * route 0x301 once the dock is configured.
+ */
+static void test_chain(void)
+{
+    QTestState *qts = qtest_init("-nodefaults -machine pc "
+                                 "-device usb4-host,id=u4,addr=04.0 "
+                                 "-device usb4-device,id=enc0,bus=u4.0,"
+                                 "port=1,dialect=tb3,downstream-ports=1 "
+                                 "-device usb4-device,id=enc1,bus=u4.0,"
+                                 "parent=enc0,port=1,device-model=asm2464");
+    uint32_t v[5];
+    Ring0 r;
+
+    ring0_start(&r, qts);
+    host_enumerate(&r);
+    settle(&r);
+    tb3_configure(&r, 1, 1, 0x4e01);
+    ring0_read(&r, 0x301, CS_ROUTER, 0, 0, 5, v);
+    g_assert_cmphex(v[0], ==, 0x2463174c);
+    g_assert_cmphex(v[1], ==, 0x000101c0);
+    /* the dock's downstream lane is in CL0 */
+    g_assert_cmphex(rd1(&r, 1, CS_ADAPTER, 3, 0x37) >> 26, ==, 2);
+    qtest_quit(qts);
+}
+
+/* ------------------------------------------------------------------ */
+/* Chained PCIe tunnel: host -> TB3 dock -> ASM2464 -> NVMe (q35)       */
+/* ------------------------------------------------------------------ */
+
+#define CHAIN_BAR0      0xd0000000u     /* host interface, off the window */
+#define CHAIN_WIN       0xe0000000u     /* 1 MiB window down to the NVMe */
+#define CHAIN_WIN_REG   0xe000e000u
+#define NVME_CSTS       0x1c
+#define TP0             "/machine/peripheral/tp0"
+#define DOCK_DSP        "tp0-sw1-usb4dp1"   /* dock's PCIe Down 7, PCI side */
+#define DOCK_DSP_PATH   "/machine/peripheral/" DOCK_DSP
+/* PCI buses as the test numbers them */
+#define BUS_DOCK_USP    1   /* dock switch upstream port */
+#define BUS_DOCK_DSP    2   /* its downstream ports: NVMe slot, usb4dp1 */
+#define BUS_DOCK_NVME   3
+#define BUS_ASM_USP     4   /* behind usb4dp1: ASM2464 upstream port */
+#define BUS_ASM_DSP     5
+#define BUS_NVME        6
+
+/* Wait for USB4_TUNNEL_ENDPOINT @stage from the slot at @path */
+static uint64_t wait_ep_stage(QTestState *qts, const char *path,
+                              const char *stage)
+{
+    for (;;) {
+        QDict *ev = qtest_qmp_eventwait_ref(qts, "USB4_TUNNEL_ENDPOINT");
+        QDict *data = qdict_get_qdict(ev, "data");
+        bool match = !strcmp(qdict_get_str(data, "stage"), stage) &&
+                     !strcmp(qdict_get_str(data, "qom-path"), path);
+        uint64_t gen = qdict_get_int(data, "generation");
+
+        qobject_unref(ev);
+        if (match) {
+            return gen;
+        }
+    }
+}
+
+static char *slot_identity(QTestState *qts, const char *id)
+{
+    g_autofree char *path = g_strdup_printf("/machine/peripheral/%s", id);
+    QDict *rsp = qtest_qmp(qts, "{'execute': 'qom-get', 'arguments': "
+                           "{'path': %s, 'property': 'x-identity'}}", path);
+    char *s;
+
+    g_assert(qdict_haskey(rsp, "return"));
+    s = g_strdup(qdict_get_str(rsp, "return"));
+
+    qobject_unref(rsp);
+    return s;
+}
+
+static bool gate_open(QTestState *qts, const char *id)
+{
+    g_autofree char *st = endpoint_state(qts, id);
+
+    return strstr(st, "gate=open") != NULL;
+}
+
+/* The slot still exists and its gate is closed */
+static bool gate_closed(QTestState *qts, const char *id)
+{
+    g_autofree char *st = endpoint_state(qts, id);
+
+    return strstr(st, "gate=closed") != NULL;
+}
+
+/* Bus numbers and the one memory window of a bridge on the path */
+static void chain_bridge(QTestState *qts, int bus, int devfn, int sec,
+                         int sub)
+{
+    cfg_writel(qts, bus, devfn, 0x18, (sub << 16) | (sec << 8) | bus);
+    cfg_writel(qts, bus, devfn, 0x20, CHAIN_WIN_REG);
+    cfg_writel(qts, bus, devfn, 0x04, 0x0006);
+}
+
+/* PCIe capability (ID 10h) of a function */
+static int exp_cap(QTestState *qts, int bus, int devfn)
+{
+    int pos = cfg_readl(qts, bus, devfn, 0x34) & 0xfc;
+
+    while (pos) {
+        uint32_t h = cfg_readl(qts, bus, devfn, pos);
+
+        if ((h & 0xff) == 0x10) {
+            return pos;
+        }
+        pos = (h >> 8) & 0xfc;
+    }
+    g_assert_not_reached();
+}
+
+/* Slot Control: power on, power indicator on (as pciehp does) */
+static void slot_power(QTestState *qts, int bus, int devfn)
+{
+    cfg_writel(qts, bus, devfn, exp_cap(qts, bus, devfn) + 0x18, 0x0100);
+}
+
+/*
+ * The linux-ts3plus-orico capture (tests/captures/framework13-12th):
+ * intel-adl host, the TS3 Plus on host port 2 (lane adapter 3, router
+ * 3), the ORICO ASM2464 on the dock's downstream port (lane adapter 3,
+ * router 303). A software CM enumerates both routers and builds the two
+ * PCIe tunnels Linux built, with the HopIDs and credits of the capture
+ * (dmesg 34.65 s): 0:9 <-> 3:6, then 3:7 <-> 303:3.
+ */
+static QTestState *chain_start(Ring0 *r)
+{
+    QTestState *qts = qtest_init(
+        "-machine q35 -global ICH9-LPC.acpi-pci-hotplug-with-bridge-support"
+        "=off -drive if=none,id=disk0,file=null-co://,format=raw "
+        "-device usb4-tunnel-port,id=tp0,bus=pcie.0,addr=0x3,chassis=1,"
+        "settle-ms=200 "
+        "-device usb4-host,id=u4,bus=pcie.0,addr=0x4,tunnel-port2=tp0,"
+        "host-model=intel-adl "
+        "-device usb4-device,id=enc0,bus=u4.0,port=2,dialect=tb3,"
+        "downstream-ports=1,lc-uuid=captured "
+        "-device usb4-device,id=enc1,bus=u4.0,parent=enc0,port=1,"
+        "drive=disk0,serial=QTCHAIN,device-model=asm2464");
+    uint32_t v[5];
+    unsigned hpcie;
+    int i;
+
+    bar0 = CHAIN_BAR0;
+    ring0_start(r, qts);
+    host_enumerate(r);
+    settle(r);
+    /* the dock at route 3 (host lane adapter 3) */
+    tb3_configure(r, 3, 3, 0x4e01);
+    g_assert_cmphex(rd1(r, 3, CS_ROUTER, 0, 0), ==, 0x15d38086);
+    /* the dock's downstream lane (adapter 3) is in CL0 */
+    g_assert_cmphex(rd1(r, 3, CS_ADAPTER, 3, 0x37) >> 26, ==, 2);
+
+    /* the ASM2464 at route 0x303, depth 2 (captured writes at 34.368 s) */
+    ring0_read(r, 0x303, CS_ROUTER, 0, 0, 5, v);
+    g_assert_cmphex(v[0], ==, 0x2463174c);
+    v[0] = 0x002101c0;
+    v[1] = 0x303;
+    v[2] = 1u << 31;
+    v[3] = 0x2000100a;
+    ring0_write(r, 0x303, CS_ROUTER, 0, 1, 4, v);
+    wr1(r, 0x303, CS_ROUTER, 0, 5, 0x01000000);         /* PTO */
+    wr1(r, 0x303, CS_ROUTER, 0, 5, 0x81000000);         /* CV */
+    for (i = 0; i < 40 && !(rd1(r, 0x303, CS_ROUTER, 0, 6) & (1u << 25));
+         i++) {
+        qtest_clock_step(qts, 50 * 1000 * 1000);
+    }
+    g_assert_cmphex(rd1(r, 0x303, CS_ROUTER, 0, 6) & (1u << 25), ==,
+                    1u << 25);                          /* CR */
+
+    /*
+     * Bond the dock-ASM2464 link as the capture shows (34.38 s): Target
+     * Link Width dual on 3:3, 3:4, 303:1, 303:2, then LB on 3:3; the
+     * dock reports its lane 1 (adapter 4) unplugged and its lane 0 reads
+     * dual.
+     */
+    rmw(r, 3, CS_ADAPTER, 3, 0x37, 0, 0x30);
+    rmw(r, 3, CS_ADAPTER, 4, 0x37, 0, 0x30);
+    rmw(r, 0x303, CS_ADAPTER, 1, 0x81, 0, 0x30);
+    rmw(r, 0x303, CS_ADAPTER, 2, 0x81, 0, 0x30);
+    i = r->hp;
+    rmw(r, 3, CS_ADAPTER, 3, 0x37, 0, 1u << 15);
+    settle(r);
+    g_assert(saw_ev(r, i, 3, 4 | 1 << 8));
+    g_assert_cmphex(rd1(r, 3, CS_ADAPTER, 3, 0x37) & 0x03f08000, ==,
+                    0x00200000);                        /* dual, LB clear */
+
+    /* PCI side: the tunnel port's slot powered */
+    slot_power(qts, 0, 3 << 3);
+
+    /* PCIe tunnel 0:9 <-> 3:6 (Down 0:9 -> 0:3 -> 3:1 -> 3:6) */
+    hpcie = adp_cap(r, 0, 9, CAP_PROTO);
+    path8(r, 3, 1, 6, 32);
+    path8(r, 0, 9, 3, 0);
+    path8(r, 0, 3, 9, 64);
+    path8(r, 3, 6, 1, 0);
+    rmw(r, 3, CS_ADAPTER, 6, 0x39, 0, 1u << 31);
+    rmw(r, 0, CS_ADAPTER, 9, hpcie, 0, 1u << 31);
+    g_assert_cmphex(rd1(r, 3, CS_ADAPTER, 6, 0x39), ==, 0xc6210400);
+    wait_ep_stage(qts, TP0, "inserted");
+    g_assert(gate_open(qts, "tp0"));
+
+    /*
+     * The dock's PCIe switch: upstream port on bus 1, its downstream
+     * ports on bus 2 (device 0: the dock's own endpoint slot, device 1:
+     * the hot-plug port that stands for PCIe Down adapter 7).
+     */
+    chain_bridge(qts, 0, 3 << 3, BUS_DOCK_USP, BUS_NVME);
+    chain_bridge(qts, BUS_DOCK_USP, 0, BUS_DOCK_DSP, BUS_NVME);
+    cfg_writel(qts, BUS_DOCK_DSP, 0, 0x18,
+               (BUS_DOCK_NVME << 16) | (BUS_DOCK_NVME << 8) | BUS_DOCK_DSP);
+    chain_bridge(qts, BUS_DOCK_DSP, 1 << 3, BUS_ASM_USP, BUS_NVME);
+    slot_power(qts, BUS_DOCK_DSP, 1 << 3);
+    g_assert(!gate_open(qts, DOCK_DSP));       /* nothing behind it yet */
+    g_assert_cmphex(cfg_readl(qts, BUS_ASM_USP, 0, 0), ==, 0xffffffff);
+
+    /*
+     * PCIe tunnel 3:7 <-> 303:3: HopID 8 on 303:1, 3:7, 3:3 and 303:3,
+     * then PCIe Path Enable on 303:3 and 3:7 (captured order).
+     */
+    path8(r, 0x303, 1, 3, 64);
+    path8(r, 3, 7, 3, 0);
+    path8(r, 0x303, 3, 1, 0);
+    path8(r, 3, 3, 7, 32);
+    rmw(r, 0x303, CS_ADAPTER, 3, 9, 0, 1u << 31);
+    g_assert(!gate_open(qts, DOCK_DSP));       /* 3:7 not enabled yet */
+    rmw(r, 3, CS_ADAPTER, 7, 0x39, 0, 1u << 31);
+    wait_ep_stage(qts, DOCK_DSP_PATH, "inserted");
+    g_assert(gate_open(qts, DOCK_DSP));
+
+    /*
+     * Both slot identities (usb4_tunnel_slot_identity(), what restore
+     * records are keyed by) name the chain inputs: the dock with its
+     * downstream port at the tunnel port, the ASM2464 and its drive at
+     * the dock's port.
+     */
+    {
+        g_autofree char *id0 = slot_identity(qts, "tp0");
+        g_autofree char *id1 = slot_identity(qts, DOCK_DSP);
+
+        g_assert(strstr(id0, "/enc0;") && strstr(id0, "ndfp=1") &&
+                 strstr(id0, "asm2464=0"));
+        g_assert(strstr(id1, "/enc1;") && strstr(id1, "drive=disk0;") &&
+                 strstr(id1, "serial=QTCHAIN;") &&
+                 strstr(id1, "asm2464=1") && strstr(id1, "ndfp=0"));
+    }
+
+    /* ASM2464 switch behind the dock's port, then the NVMe */
+    g_assert_cmphex(cfg_readl(qts, BUS_ASM_USP, 0, 0), ==, 0x24631b21);
+    chain_bridge(qts, BUS_ASM_USP, 0, BUS_ASM_DSP, BUS_NVME);
+    chain_bridge(qts, BUS_ASM_DSP, 0, BUS_NVME, BUS_NVME);
+    g_assert_cmphex(cfg_readl(qts, BUS_NVME, 0, 0), ==, QEMU_NVME);
+    cfg_writel(qts, BUS_NVME, 0, 0x10, CHAIN_WIN);
+    cfg_writel(qts, BUS_NVME, 0, 0x14, 0);
+    cfg_writel(qts, BUS_NVME, 0, 0x04, 0x0006);
+    g_assert_cmphex(qtest_readl(qts, CHAIN_WIN + NVME_CSTS), ==, 0);
+    return qts;
+}
+
+/* Hold or release stages 2-4 of the slot at @path (x-hold-deferred) */
+static void hold_deferred(QTestState *qts, const char *path, bool hold)
+{
+    qtest_qmp_assert_success(qts, "{'execute': 'qom-set', 'arguments': "
+                             "{'path': %s, 'property': 'x-hold-deferred', "
+                             "'value': %i}}", path, hold);
+}
+
+/*
+ * Leaf first: device_del of the ASM2464 closes the dock port's gate in
+ * the same call (config, MMIO), the dock stays reachable; then device_del
+ * of the dock closes the tunnel port's gate.
+ */
+static void test_chain_pcie(void)
+{
+    Ring0 r;
+    QTestState *qts = chain_start(&r);
+
+    hold_deferred(qts, DOCK_DSP_PATH, true);
+    qtest_qmp_assert_success(qts, "{'execute': 'device_del', 'arguments': "
+                             "{'id': 'enc1'}}");
+    g_assert(gate_closed(qts, DOCK_DSP));
+    g_assert(gate_open(qts, "tp0"));
+    g_assert_cmphex(cfg_readl(qts, BUS_NVME, 0, 0), ==, 0xffffffff);
+    g_assert_cmphex(cfg_readl(qts, BUS_ASM_USP, 0, 0), ==, 0xffffffff);
+    g_assert_cmphex(qtest_readl(qts, CHAIN_WIN + NVME_CSTS), ==, 0xffffffff);
+    g_assert_cmphex(cfg_readl(qts, BUS_DOCK_USP, 0, 0), !=, 0xffffffff);
+    g_assert_cmphex(cfg_readl(qts, BUS_DOCK_DSP, 1 << 3, 0), !=, 0xffffffff);
+    /* the dock's PCIe Down adapter 7: no tunnel any more */
+    g_assert_cmphex(rd1(&r, 3, CS_ADAPTER, 7, 0x39), !=, 0xc6210400);
+    hold_deferred(qts, DOCK_DSP_PATH, false);
+    wait_ep_stage(qts, DOCK_DSP_PATH, "removed");
+    g_assert_cmphex(cfg_readl(qts, BUS_ASM_USP, 0, 0), ==, 0xffffffff);
+
+    hold_deferred(qts, TP0, true);
+    qtest_qmp_assert_success(qts, "{'execute': 'device_del', 'arguments': "
+                             "{'id': 'enc0'}}");
+    g_assert(gate_closed(qts, "tp0"));
+    g_assert_cmphex(cfg_readl(qts, BUS_DOCK_USP, 0, 0), ==, 0xffffffff);
+    hold_deferred(qts, TP0, false);
+    wait_ep_stage(qts, TP0, "removed");
+    bar0 = 0xe0000000u;
+    qtest_quit(qts);
+}
+
+/*
+ * Root first: device_del of the dock with the chained tunnel up closes
+ * both gates in the same call (the chained tunnel goes down first, leaf
+ * first), before either level is quiesced or removed. Stages 2-4 are
+ * held at the tunnel port, so the dock's switch, whose port is checked,
+ * is still there afterwards.
+ */
+static void test_chain_pcie_dock(void)
+{
+    Ring0 r;
+    QTestState *qts = chain_start(&r);
+
+    hold_deferred(qts, TP0, true);
+    qtest_qmp_assert_success(qts, "{'execute': 'device_del', 'arguments': "
+                             "{'id': 'enc0'}}");
+    g_assert(gate_closed(qts, "tp0"));
+    g_assert(gate_closed(qts, DOCK_DSP));
+    g_assert_cmphex(qtest_readl(qts, CHAIN_WIN + NVME_CSTS), ==, 0xffffffff);
+    g_assert_cmphex(cfg_readl(qts, BUS_NVME, 0, 0), ==, 0xffffffff);
+    g_assert_cmphex(cfg_readl(qts, BUS_DOCK_USP, 0, 0), ==, 0xffffffff);
+    hold_deferred(qts, TP0, false);
+    wait_ep_stage(qts, TP0, "removed");
+    bar0 = 0xe0000000u;
+    qtest_quit(qts);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    qtest_add_func("/usb4-tb3dev/bad-config", test_bad_config);
+    qtest_add_func("/usb4-tb3dev/minimal", test_minimal);
+    qtest_add_func("/usb4-tb3dev/intel-adl", test_intel_adl);
+    qtest_add_func("/usb4-tb3dev/amd", test_amd);
+    qtest_add_func("/usb4-tb3dev/amd-identity", test_amd_identity);
+    qtest_add_func("/usb4-tb3dev/events", test_events);
+    qtest_add_func("/usb4-tb3dev/dma-port", test_dma_port);
+    qtest_add_func("/usb4-tb3dev/two-docks", test_two_docks);
+    qtest_add_func("/usb4-tb3dev/two-hosts", test_two_hosts);
+    qtest_add_func("/usb4-tb3dev/chain", test_chain);
+    qtest_add_func("/usb4-tb3dev/chain-pcie", test_chain_pcie);
+    qtest_add_func("/usb4-tb3dev/chain-pcie-dock", test_chain_pcie_dock);
+    return g_test_run();
+}
diff --git a/tests/qtest/usb4-tunnel-test.c b/tests/qtest/usb4-tunnel-test.c
new file mode 100644
index 0000000000000000000000000000000000000000..3c9c2328bb6bd127a4423f8017828a45051f3ebd
--- /dev/null
+++ b/tests/qtest/usb4-tunnel-test.c
@@ -0,0 +1,2150 @@
+/*
+ * qtest for usb4-tunnel-port: forced tunnel up/down, access gate,
+ * deferred removal and fresh-endpoint generation.
+ *
+ * Copyright (c) 2026 usb4-emu contributors
+ * SPDX-License-Identifier: GPL-2.0-only
+ */
+
+#include "qemu/osdep.h"
+#include "libqtest.h"
+#include "qobject/qdict.h"
+
+#define TP_PATH "/machine/peripheral/tp0"
+#define TP_DEVFN (3 << 3)
+
+static uint32_t cfg_addr(int bus, int devfn, int off)
+{
+    return 0x80000000u | (bus << 16) | (devfn << 8) | (off & 0xfc);
+}
+
+static uint32_t cfg_readl(QTestState *qts, int bus, int devfn, int off)
+{
+    qtest_outl(qts, 0xcf8, cfg_addr(bus, devfn, off));
+    return qtest_inl(qts, 0xcfc);
+}
+
+static void cfg_writel(QTestState *qts, int bus, int devfn, int off,
+                       uint32_t val)
+{
+    qtest_outl(qts, 0xcf8, cfg_addr(bus, devfn, off));
+    qtest_outl(qts, 0xcfc, val);
+}
+
+/* Offset of the PCI Express capability of the port. */
+static int find_exp_cap(QTestState *qts)
+{
+    int pos = cfg_readl(qts, 0, TP_DEVFN, 0x34) & 0xfc;
+
+    while (pos) {
+        uint32_t hdr = cfg_readl(qts, 0, TP_DEVFN, pos);
+
+        if ((hdr & 0xff) == 0x10) {
+            return pos;
+        }
+        pos = (hdr >> 8) & 0xfc;
+    }
+    g_assert_not_reached();
+}
+
+static void set_tunnel(QTestState *qts, const char *state)
+{
+    qtest_qmp_assert_success(qts, "{'execute': 'qom-set', 'arguments': "
+                             "{'path': %s, 'property': 'tunnel', "
+                             "'value': %s}}", TP_PATH, state);
+}
+
+static void set_hold(QTestState *qts, bool hold)
+{
+    qtest_qmp_assert_success(qts, "{'execute': 'qom-set', 'arguments': "
+                             "{'path': %s, 'property': 'x-hold-deferred', "
+                             "'value': %i}}", TP_PATH, hold);
+}
+
+static char *endpoint_state(QTestState *qts)
+{
+    QDict *rsp = qtest_qmp(qts, "{'execute': 'qom-get', 'arguments': "
+                           "{'path': %s, 'property': 'endpoint'}}", TP_PATH);
+    char *s = g_strdup(qdict_get_str(rsp, "return"));
+
+    qobject_unref(rsp);
+    return s;
+}
+
+/* Wait for USB4_TUNNEL_ENDPOINT with the given stage. */
+static uint64_t wait_stage(QTestState *qts, const char *stage)
+{
+    for (;;) {
+        QDict *ev = qtest_qmp_eventwait_ref(qts, "USB4_TUNNEL_ENDPOINT");
+        QDict *data = qdict_get_qdict(ev, "data");
+        bool match = !strcmp(qdict_get_str(data, "stage"), stage);
+        uint64_t gen = qdict_get_int(data, "generation");
+
+        qobject_unref(ev);
+        if (match) {
+            return gen;
+        }
+    }
+}
+
+/* True if /machine/peripheral/@id exists. */
+static bool peripheral_exists(QTestState *qts, const char *id)
+{
+    g_autofree char *path = g_strdup_printf("/machine/peripheral/%s", id);
+    QDict *rsp = qtest_qmp(qts, "{'execute': 'qom-list', 'arguments': "
+                           "{'path': %s}}", path);
+    bool ok = qdict_haskey(rsp, "return");
+
+    qobject_unref(rsp);
+    return ok;
+}
+
+static char *make_img(void)
+{
+    char *img = NULL;
+    int fd = g_file_open_tmp("usb4-tunnel-XXXXXX", &img, NULL);
+
+    g_assert(fd >= 0);
+    g_assert(ftruncate(fd, 1024 * 1024) == 0);
+    close(fd);
+    return img;
+}
+
+static void test_force_tunnel(void)
+{
+    QTestState *qts;
+    g_autofree char *img = NULL;
+    int fd;
+    uint64_t gen1, gen2;
+    char *st;
+
+    fd = g_file_open_tmp("usb4-tunnel-XXXXXX", &img, NULL);
+    g_assert(fd >= 0);
+    g_assert(ftruncate(fd, 1024 * 1024) == 0);
+    close(fd);
+
+    qts = qtest_initf("-machine q35 "
+                      "-global ICH9-LPC.acpi-pci-hotplug-with-bridge-support=off "
+                      "-drive if=none,id=disk0,file=%s,format=raw "
+                      "-device usb4-tunnel-port,id=tp0,bus=pcie.0,addr=0x3,"
+                      "chassis=1,nvme-drive=disk0,nvme-serial=QT1,"
+                      "eject-timeout-ms=500,settle-ms=200,"
+                      "orderly-admin-down=on", img);
+
+    /* Bus numbers for the port: secondary 1, subordinate 1. */
+    cfg_writel(qts, 0, TP_DEVFN, 0x18, 0x00010100);
+    /*
+     * Power the slot on as a guest hot-plug driver would (Slot Control:
+     * power controller on, power indicator on). The empty slot comes out
+     * of reset powered off, and that state persists across insertions.
+     */
+    cfg_writel(qts, 0, TP_DEVFN, find_exp_cap(qts) + 0x18, 0x0100);
+
+    /* Gate closed and slot empty at start. */
+    st = endpoint_state(qts);
+    g_assert(g_str_has_prefix(st, "none"));
+    g_assert(strstr(st, "gate=closed"));
+    g_free(st);
+    g_assert_cmphex(cfg_readl(qts, 1, 0, 0), ==, 0xffffffff);
+
+    /* Up: a fresh nvme appears behind the port. */
+    set_tunnel(qts, "up");
+    gen1 = wait_stage(qts, "inserted");
+    g_assert_cmpuint(gen1, ==, 1);
+    g_assert_cmphex(cfg_readl(qts, 1, 0, 0), ==, 0x00101b36);
+
+    /*
+     * Down with the deferred stages held: the gate closes synchronously,
+     * config reads see all-ones, the endpoint still exists.
+     */
+    set_hold(qts, true);
+    set_tunnel(qts, "down");
+    g_assert_cmpuint(wait_stage(qts, "gated"), ==, gen1);
+    st = endpoint_state(qts);
+    g_assert(g_str_has_prefix(st, "doomed"));
+    g_free(st);
+    g_assert_cmphex(cfg_readl(qts, 1, 0, 0), ==, 0xffffffff);
+    cfg_writel(qts, 1, 0, 4, 0x6);  /* dropped */
+
+    /*
+     * Release: quiesce (cutoff), eject request; nobody answers it, so
+     * the eject timeout forces removal.
+     */
+    set_hold(qts, false);
+    g_assert_cmpuint(wait_stage(qts, "cutoff"), ==, gen1);
+    g_assert_cmpuint(wait_stage(qts, "eject-requested"), ==, gen1);
+    qtest_clock_step(qts, 600 * 1000 * 1000);   /* past eject-timeout-ms */
+    g_assert_cmpuint(wait_stage(qts, "removed"), ==, gen1);
+
+    /* Reconnect: a new generation, inserted after the settle timeout. */
+    set_tunnel(qts, "up");
+    qtest_clock_step(qts, 300 * 1000 * 1000);   /* past settle-ms */
+    wait_stage(qts, "settle-timeout");
+    gen2 = wait_stage(qts, "inserted");
+    g_assert_cmpuint(gen2, ==, 2);
+    g_assert_cmphex(cfg_readl(qts, 1, 0, 0), ==, 0x00101b36);
+    /* The dropped write did not reach the new endpoint either. */
+    g_assert_cmphex(cfg_readl(qts, 1, 0, 4) & 0x6, ==, 0);
+
+    /* Surprise removal. */
+    set_tunnel(qts, "surprise");
+    g_assert_cmpuint(wait_stage(qts, "removed"), ==, gen2);
+    g_assert_cmphex(cfg_readl(qts, 1, 0, 0), ==, 0xffffffff);
+
+    qtest_quit(qts);
+    unlink(img);
+}
+
+/*
+ * The guest powers the slot off with the power indicator off while the
+ * endpoint is present (its eject, or a removal of its own). The stock
+ * port would unrealize the endpoint inside that config write; here the
+ * write only gates and updates Slot Status, and the removal runs from the
+ * bottom half (held here to observe the state in between).
+ */
+static void test_slot_poweroff_deferred(void)
+{
+    g_autofree char *img = make_img();
+    QTestState *qts;
+    int exp;
+    uint32_t sl;
+    char *st;
+
+    qts = qtest_initf("-machine q35 "
+                      "-global ICH9-LPC.acpi-pci-hotplug-with-bridge-support=off "
+                      "-drive if=none,id=disk0,file=%s,format=raw "
+                      "-device usb4-tunnel-port,id=tp0,bus=pcie.0,addr=0x3,"
+                      "chassis=1,nvme-drive=disk0,nvme-serial=QT7,"
+                      "settle-ms=200", img);
+    cfg_writel(qts, 0, TP_DEVFN, 0x18, 0x00010100);
+    exp = find_exp_cap(qts);
+    cfg_writel(qts, 0, TP_DEVFN, exp + 0x18, 0x0100);
+    set_tunnel(qts, "up");
+    g_assert_cmpuint(wait_stage(qts, "inserted"), ==, 1);
+    g_assert_cmphex(cfg_readl(qts, 1, 0, 0), ==, 0x00101b36);
+
+    /* Slot Control: power controller off, power indicator off. */
+    set_hold(qts, true);
+    cfg_writel(qts, 0, TP_DEVFN, exp + 0x18, 0x0700);
+    g_assert(peripheral_exists(qts, "tp0-nvme1"));
+    g_assert_cmphex(cfg_readl(qts, 1, 0, 0), ==, 0xffffffff);
+    sl = cfg_readl(qts, 0, TP_DEVFN, exp + 0x18);
+    g_assert_cmphex((sl >> 16) & 0x40, ==, 0);          /* PDS clear */
+    g_assert_cmphex((sl >> 16) & 0x08, ==, 0x08);       /* PDC set */
+    st = endpoint_state(qts);
+    g_assert(strstr(st, "gate=closed"));
+    g_free(st);
+
+    set_hold(qts, false);
+    g_assert_cmpuint(wait_stage(qts, "removed"), ==, 1);
+    g_assert(!peripheral_exists(qts, "tp0-nvme1"));
+    /* The guest removed it while the tunnel was up: no reinsertion. */
+    st = endpoint_state(qts);
+    g_assert(g_str_has_prefix(st, "none"));
+    g_assert(strstr(st, "dismissed"));
+    g_free(st);
+    qtest_quit(qts);
+    unlink(img);
+}
+
+/*
+ * Slot power-on with the endpoint present: the power (which resets the
+ * endpoint) is applied from the bottom half, and Command Completed only
+ * follows it, so a guest polling CC never finds the endpoint gated.
+ */
+static void test_slot_poweron_cc(void)
+{
+    g_autofree char *img = make_img();
+    QTestState *qts;
+    int exp;
+
+    qts = qtest_initf("-machine q35 "
+                      "-global ICH9-LPC.acpi-pci-hotplug-with-bridge-support=off "
+                      "-drive if=none,id=disk0,file=%s,format=raw "
+                      "-device usb4-tunnel-port,id=tp0,bus=pcie.0,addr=0x3,"
+                      "chassis=1,nvme-drive=disk0,nvme-serial=QT8,"
+                      "settle-ms=200", img);
+    cfg_writel(qts, 0, TP_DEVFN, 0x18, 0x00010100);
+    exp = find_exp_cap(qts);
+    /* Inserted into the slot left powered off by reset. */
+    set_tunnel(qts, "up");
+    g_assert_cmpuint(wait_stage(qts, "inserted"), ==, 1);
+    /* Clear Command Completed (RW1C, Slot Status at +0x1a). */
+    qtest_outl(qts, 0xcf8, cfg_addr(0, TP_DEVFN, exp + 0x18));
+    qtest_outw(qts, 0xcfc + 2, 0x0010);
+    g_assert_cmphex(cfg_readl(qts, 0, TP_DEVFN, exp + 0x18) >> 16 & 0x10,
+                    ==, 0);
+
+    /* Power on, power indicator on; the bottom half is held. */
+    set_hold(qts, true);
+    cfg_writel(qts, 0, TP_DEVFN, exp + 0x18, 0x0100);
+    g_assert_cmphex(cfg_readl(qts, 0, TP_DEVFN, exp + 0x18) >> 16 & 0x10,
+                    ==, 0);
+    g_assert_cmphex(cfg_readl(qts, 1, 0, 0), ==, 0xffffffff);
+
+    /* Applied: then, and only then, the command completes. */
+    set_hold(qts, false);
+    g_assert_cmphex(cfg_readl(qts, 0, TP_DEVFN, exp + 0x18) >> 16 & 0x10,
+                    ==, 0x10);
+    g_assert_cmphex(cfg_readl(qts, 1, 0, 0), ==, 0x00101b36);
+
+    /* A command without a power change completes at once. */
+    qtest_outl(qts, 0xcf8, cfg_addr(0, TP_DEVFN, exp + 0x18));
+    qtest_outw(qts, 0xcfc + 2, 0x0010);
+    cfg_writel(qts, 0, TP_DEVFN, exp + 0x18, 0x0100 | 0x0008);
+    g_assert_cmphex(cfg_readl(qts, 0, TP_DEVFN, exp + 0x18) >> 16 & 0x10,
+                    ==, 0x10);
+    qtest_quit(qts);
+    unlink(img);
+}
+
+/* ---- usb4-tunnel-bridge (i440FX, SHPC) ---- */
+
+#define TB_PATH "/machine/peripheral/tb0"
+#define TB_DEVFN (5 << 3)
+#define EP_DEVFN (1 << 3)
+
+static void tb_set_tunnel(QTestState *qts, const char *state)
+{
+    qtest_qmp_assert_success(qts, "{'execute': 'qom-set', 'arguments': "
+                             "{'path': %s, 'property': 'tunnel', "
+                             "'value': %s}}", TB_PATH, state);
+}
+
+/* Issue an SHPC slot command through the config-space DWORD window. */
+static void tb_shpc_command(QTestState *qts, uint8_t code)
+{
+    int pos = cfg_readl(qts, 0, TB_DEVFN, 0x34) & 0xfc;
+    uint32_t hdr;
+
+    for (;;) {
+        g_assert(pos);
+        hdr = cfg_readl(qts, 0, TB_DEVFN, pos);
+        if ((hdr & 0xff) == 0x0c) {
+            break;
+        }
+        pos = (hdr >> 8) & 0xfc;
+    }
+    /* DWORD select = 5 (command register at 14h), then data. */
+    cfg_writel(qts, 0, TB_DEVFN, pos, (hdr & 0xffff) | (5 << 16));
+    cfg_writel(qts, 0, TB_DEVFN, pos + 4, code | (1 << 8) /* slot 1 */);
+}
+
+#define SHPC_ENABLE_PWR_ON  0x06  /* state Enabled, power LED on */
+#define SHPC_DISABLE_PWR_OFF 0x0f /* state Disabled, power LED off */
+#define SHPC_DISABLE        0x03  /* state Disabled, LEDs unchanged */
+
+/* tb0 on i440FX with secondary bus 1, plus @extra command line. */
+static QTestState *tb_start_extra(const char *img, bool autoenable,
+                                  const char *extra)
+{
+    QTestState *qts = qtest_initf(
+        "-machine pc "
+        "-global PIIX4_PM.acpi-pci-hotplug-with-bridge-support=off "
+        "-drive if=none,id=disk0,file=%s,format=raw "
+        "-device usb4-tunnel-bridge,id=tb0,bus=pci.0,addr=0x5,chassis_nr=1,"
+        "msi=off,nvme-drive=disk0,nvme-serial=QT2,settle-ms=200,"
+        "shpc-autoenable=%s %s", img, autoenable ? "on" : "off", extra);
+
+    cfg_writel(qts, 0, TB_DEVFN, 0x18, 0x00010100);
+    return qts;
+}
+
+static QTestState *tb_start(const char *img, bool autoenable)
+{
+    return tb_start_extra(img, autoenable, "");
+}
+
+static void test_bridge_slot_enable(void)
+{
+    g_autofree char *img = make_img();
+    QTestState *qts = tb_start(img, false);
+
+    tb_set_tunnel(qts, "up");
+    g_assert_cmpuint(wait_stage(qts, "inserted"), ==, 1);
+    /* Slot Disabled (stock SHPC): the gate stays closed. */
+    g_assert_cmphex(cfg_readl(qts, 1, EP_DEVFN, 0), ==, 0xffffffff);
+    /* The guest enables the slot by polled SHPC command. */
+    tb_shpc_command(qts, SHPC_ENABLE_PWR_ON);
+    g_assert_cmphex(cfg_readl(qts, 1, EP_DEVFN, 0), ==, 0x00101b36);
+    /* Tunnel down closes it again regardless of the slot. */
+    tb_set_tunnel(qts, "surprise");
+    g_assert_cmpuint(wait_stage(qts, "removed"), ==, 1);
+    g_assert_cmphex(cfg_readl(qts, 1, EP_DEVFN, 0), ==, 0xffffffff);
+    qtest_quit(qts);
+    unlink(img);
+}
+
+/* SHPC: Disabled with the power LED off removes from the bottom half. */
+static void test_bridge_disable_deferred(void)
+{
+    g_autofree char *img = make_img();
+    QTestState *qts = tb_start(img, true);
+
+    tb_set_tunnel(qts, "up");
+    g_assert_cmpuint(wait_stage(qts, "inserted"), ==, 1);
+    g_assert_cmphex(cfg_readl(qts, 1, EP_DEVFN, 0), ==, 0x00101b36);
+
+    qtest_qmp_assert_success(qts, "{'execute': 'qom-set', 'arguments': "
+                             "{'path': %s, 'property': 'x-hold-deferred', "
+                             "'value': true}}", TB_PATH);
+    tb_shpc_command(qts, SHPC_DISABLE_PWR_OFF);
+    g_assert(peripheral_exists(qts, "tb0-nvme1"));
+    g_assert_cmphex(cfg_readl(qts, 1, EP_DEVFN, 0), ==, 0xffffffff);
+
+    qtest_qmp_assert_success(qts, "{'execute': 'qom-set', 'arguments': "
+                             "{'path': %s, 'property': 'x-hold-deferred', "
+                             "'value': false}}", TB_PATH);
+    g_assert_cmpuint(wait_stage(qts, "removed"), ==, 1);
+    g_assert(!peripheral_exists(qts, "tb0-nvme1"));
+    qtest_quit(qts);
+    unlink(img);
+}
+
+static void test_bridge_autoenable(void)
+{
+    g_autofree char *img = make_img();
+    QTestState *qts = tb_start(img, true);
+
+    /* Unclaimed slot: reachable right after insertion. */
+    tb_set_tunnel(qts, "up");
+    g_assert_cmpuint(wait_stage(qts, "inserted"), ==, 1);
+    g_assert_cmphex(cfg_readl(qts, 1, EP_DEVFN, 0), ==, 0x00101b36);
+
+    /*
+     * Reconnect, and the guest disables the empty slot in between: that
+     * claims the slot, so the replacement stays inaccessible.
+     */
+    tb_set_tunnel(qts, "surprise");
+    g_assert_cmpuint(wait_stage(qts, "removed"), ==, 1);
+    tb_shpc_command(qts, SHPC_DISABLE);
+    tb_set_tunnel(qts, "up");
+    qtest_clock_step(qts, 300 * 1000 * 1000);   /* past settle-ms */
+    g_assert_cmpuint(wait_stage(qts, "inserted"), ==, 2);
+    g_assert_cmphex(cfg_readl(qts, 1, EP_DEVFN, 0), ==, 0xffffffff);
+
+    /* Until the guest enables it. */
+    tb_shpc_command(qts, SHPC_ENABLE_PWR_ON);
+    g_assert_cmphex(cfg_readl(qts, 1, EP_DEVFN, 0), ==, 0x00101b36);
+    qtest_quit(qts);
+    unlink(img);
+}
+
+/* ---- closed-gate windows read all-ones ---- */
+
+#define WIN_MEM     0xe0000000ull   /* 1 MiB memory window */
+#define WIN_MEM_REG 0xe000e000u     /* base/limit register for it */
+#define WIN_IO      0xc000          /* 4 KiB I/O window */
+#define WIN_IO_REG  0xc0c0u         /* I/O base/limit bytes for it */
+#define NVME_VS     0x08
+#define NVME_CC     0x14
+#define NVME_CSTS   0x1c
+#define NVME_CC_MARK 0x00460000u    /* CC.IOCQES 4, IOSQES 6, EN 0 */
+
+/*
+ * True if "info mtree" shows @name enabled (at @range, "base-last" in
+ * mtree's format, if not NULL). The all-ones regions are fallback
+ * decoders: priority -1, below every BAR, window and legacy port.
+ */
+static bool mtree_enabled(QTestState *qts, const char *name,
+                          const char *range)
+{
+    g_autofree char *out = qtest_hmp(qts, "info mtree");
+    g_autofree char *want = range ?
+        g_strdup_printf("%s (prio -1, i/o): %s", range, name) :
+        g_strdup_printf("): %s", name);
+    const char *p = out;
+
+    while ((p = strstr(p, want))) {
+        p += strlen(want);
+        if (*p == '\r' || *p == '\n') {
+            return true;
+        }
+    }
+    return false;
+}
+
+/* Program a bridge's memory and I/O windows and enable decoding. */
+static void bridge_windows(QTestState *qts, int bus, int devfn,
+                           uint32_t mem_reg)
+{
+    cfg_writel(qts, bus, devfn, 0x20, mem_reg);
+    cfg_writel(qts, bus, devfn, 0x1c, WIN_IO_REG);
+    cfg_writel(qts, bus, devfn, 0x04, 0x0007);
+}
+
+/* Map an NVMe endpoint's BAR0 at @addr and enable memory decoding. */
+static void nvme_map(QTestState *qts, int bus, int devfn, uint64_t addr)
+{
+    cfg_writel(qts, bus, devfn, 0x10, addr);
+    cfg_writel(qts, bus, devfn, 0x14, addr >> 32);
+    cfg_writel(qts, bus, devfn, 0x04, 0x0006);
+}
+
+/* Every read at @addr, of every size, sees a master abort. */
+static void assert_all_ones(QTestState *qts, uint64_t addr)
+{
+    g_assert_cmphex(qtest_readb(qts, addr), ==, 0xff);
+    g_assert_cmphex(qtest_readw(qts, addr), ==, 0xffff);
+    g_assert_cmphex(qtest_readl(qts, addr), ==, 0xffffffff);
+    g_assert_cmphex(qtest_readq(qts, addr), ==, UINT64_MAX);
+}
+
+/*
+ * True if the CPU's flat view of address space @as ("memory" or "I/O")
+ * in "info mtree -f" routes @addr to the region @name (a line "lo-hi
+ * (prio p, type): name..."). Other flat views (bus master and secondary
+ * bus address spaces) do not count: a region visible only there is not
+ * reached by a CPU access.
+ */
+static bool flat_routes(QTestState *qts, const char *as, uint64_t addr,
+                        const char *name)
+{
+    g_autofree char *out = qtest_hmp(qts, "info mtree -f");
+    g_autofree char *as_line = g_strdup_printf(" AS \"%s\",", as);
+    g_auto(GStrv) lines = g_strsplit(out, "\n", -1);
+    bool in_as = false;
+    int i;
+
+    for (i = 0; lines[i]; i++) {
+        const char *p = strstr(lines[i], "): ");
+        uint64_t lo, hi;
+
+        if (g_str_has_prefix(lines[i], "FlatView #")) {
+            in_as = false;      /* a new view: its AS lines follow */
+        } else if (g_str_has_prefix(lines[i], as_line)) {
+            in_as = true;
+        } else if (in_as && p &&
+                   sscanf(lines[i], " %" SCNx64 "-%" SCNx64, &lo, &hi) == 2 &&
+                   lo <= addr && addr <= hi && g_str_has_prefix(p + 3, name)) {
+            return true;
+        }
+    }
+    return false;
+}
+
+/*
+ * Unassigned x86 I/O reads all-ones as well, so the values alone do not
+ * show the I/O all-ones region at work; the flat view check does.
+ */
+static void assert_io_all_ones(QTestState *qts, uint16_t port)
+{
+    g_assert(flat_routes(qts, "I/O", port, "usb4-tunnel-gate-ones-io"));
+    /* Only the I/O view counts: memory at @port is something else. */
+    g_assert(!flat_routes(qts, "memory", port, "usb4-tunnel-gate-ones-io"));
+    g_assert_cmphex(qtest_inb(qts, port), ==, 0xff);
+    g_assert_cmphex(qtest_inw(qts, port), ==, 0xffff);
+    g_assert_cmphex(qtest_inl(qts, port), ==, 0xffffffff);
+}
+
+/* True if "info mtree" has an enabled line with both @a and @b. */
+static bool mtree_line(QTestState *qts, const char *a, const char *b)
+{
+    g_autofree char *out = qtest_hmp(qts, "info mtree");
+    g_auto(GStrv) lines = g_strsplit(out, "\n", -1);
+    int i;
+
+    for (i = 0; lines[i]; i++) {
+        if (strstr(lines[i], a) && strstr(lines[i], b) &&
+            !strstr(lines[i], "[disabled]")) {
+            return true;
+        }
+    }
+    return false;
+}
+
+#define MTREE_MEM_WIN "00000000e0000000-00000000e00fffff"
+#define MTREE_IO_WIN "000000000000c000-000000000000cfff"
+
+/*
+ * A surprise-removed endpoint reads all-ones through the closed gate, as
+ * behind a dropped PCIe link (a removal-aware NVMe driver sees CSTS ==
+ * 0xFFFFFFFF), and not the zeroes of unassigned memory.
+ */
+static void test_window_all_ones(void)
+{
+    g_autofree char *img = make_img();
+    QTestState *qts;
+    uint32_t vs;
+    uint64_t cap;
+
+    qts = qtest_initf("-machine q35 "
+                      "-global ICH9-LPC.acpi-pci-hotplug-with-bridge-support=off "
+                      "-drive if=none,id=disk0,file=%s,format=raw "
+                      "-device usb4-tunnel-port,id=tp0,bus=pcie.0,addr=0x3,"
+                      "chassis=1,nvme-drive=disk0,nvme-serial=QT1,"
+                      "settle-ms=200", img);
+    cfg_writel(qts, 0, TP_DEVFN, 0x18, 0x00010100);
+    cfg_writel(qts, 0, TP_DEVFN, find_exp_cap(qts) + 0x18, 0x0100);
+
+    /* Closed from the start: the programmed windows read all-ones. */
+    bridge_windows(qts, 0, TP_DEVFN, WIN_MEM_REG);
+    g_assert(mtree_enabled(qts, "usb4-tunnel-gate-ones-mem", MTREE_MEM_WIN));
+    g_assert(mtree_enabled(qts, "usb4-tunnel-gate-ones-io", MTREE_IO_WIN));
+    /* The prefetchable window is empty (limit < base): nothing there. */
+    g_assert(!mtree_enabled(qts, "usb4-tunnel-gate-ones-pref-mem", NULL));
+    assert_all_ones(qts, WIN_MEM);
+    assert_io_all_ones(qts, WIN_IO);
+
+    /* Up: the endpoint answers and the all-ones regions are gone. */
+    set_tunnel(qts, "up");
+    g_assert_cmpuint(wait_stage(qts, "inserted"), ==, 1);
+    g_assert(!mtree_enabled(qts, "usb4-tunnel-gate-ones-mem", NULL));
+    g_assert(!mtree_enabled(qts, "usb4-tunnel-gate-ones-io", NULL));
+    nvme_map(qts, 1, 0, WIN_MEM);
+    cap = qtest_readq(qts, WIN_MEM);
+    vs = qtest_readl(qts, WIN_MEM + NVME_VS);
+    g_assert_cmphex(cap, !=, 0);
+    g_assert_cmphex(cap, !=, UINT64_MAX);
+    g_assert_cmphex(vs, !=, 0);
+    g_assert_cmphex(vs, !=, 0xffffffff);
+    g_assert_cmphex(qtest_readl(qts, WIN_MEM + NVME_CSTS), ==, 0);
+
+    /* Surprise down, removal held: the endpoint exists, but is cut off. */
+    set_hold(qts, true);
+    set_tunnel(qts, "surprise");
+    g_assert_cmpuint(wait_stage(qts, "gated"), ==, 1);
+    g_assert_cmphex(qtest_readl(qts, WIN_MEM + NVME_CSTS), ==, 0xffffffff);
+    assert_all_ones(qts, WIN_MEM);
+    assert_all_ones(qts, WIN_MEM + NVME_VS);
+    qtest_writel(qts, WIN_MEM + NVME_CC, 1);         /* dropped */
+    qtest_writeq(qts, WIN_MEM + NVME_CC, 1);         /* dropped */
+    qtest_outl(qts, WIN_IO, 0);                      /* dropped */
+    g_assert_cmphex(qtest_readl(qts, WIN_MEM + NVME_CSTS), ==, 0xffffffff);
+    assert_io_all_ones(qts, WIN_IO);
+
+    /* The guest moves the window while closed: the all-ones follow it. */
+    cfg_writel(qts, 0, TP_DEVFN, 0x20, 0xe010e010);
+    g_assert(mtree_enabled(qts, "usb4-tunnel-gate-ones-mem",
+                           "00000000e0100000-00000000e01fffff"));
+    assert_all_ones(qts, WIN_MEM + 0x100000);
+    /* An empty window (limit < base) is not decoded at all. */
+    cfg_writel(qts, 0, TP_DEVFN, 0x20, 0x0000fff0);
+    g_assert(!mtree_enabled(qts, "usb4-tunnel-gate-ones-mem", NULL));
+    /* Memory decoding off: nothing forwarded, nothing to abort. */
+    cfg_writel(qts, 0, TP_DEVFN, 0x20, WIN_MEM_REG);
+    cfg_writel(qts, 0, TP_DEVFN, 0x04, 0x0001);
+    g_assert(!mtree_enabled(qts, "usb4-tunnel-gate-ones-mem", NULL));
+    g_assert(mtree_enabled(qts, "usb4-tunnel-gate-ones-io", MTREE_IO_WIN));
+    cfg_writel(qts, 0, TP_DEVFN, 0x04, 0x0007);
+    assert_all_ones(qts, WIN_MEM);
+
+    set_hold(qts, false);
+    g_assert_cmpuint(wait_stage(qts, "removed"), ==, 1);
+    assert_all_ones(qts, WIN_MEM);
+
+    /* Reconnect: the replacement is reachable through the windows. */
+    set_tunnel(qts, "up");
+    qtest_clock_step(qts, 300 * 1000 * 1000);   /* past settle-ms */
+    g_assert_cmpuint(wait_stage(qts, "inserted"), ==, 2);
+    g_assert(!mtree_enabled(qts, "usb4-tunnel-gate-ones-mem", NULL));
+    nvme_map(qts, 1, 0, WIN_MEM);
+    g_assert_cmphex(qtest_readq(qts, WIN_MEM), ==, cap);
+    g_assert_cmphex(qtest_readl(qts, WIN_MEM + NVME_VS), ==, vs);
+    /*
+     * The replacement is a fresh endpoint, so CC 0 here does not show
+     * that the writes dropped while closed missed the old one (it is
+     * gone). The i440FX bridge test checks that on an endpoint that
+     * survives the closed interval.
+     */
+    g_assert_cmphex(qtest_readl(qts, WIN_MEM + NVME_CC), ==, 0);
+    g_assert_cmphex(qtest_readl(qts, WIN_MEM + NVME_CSTS), ==, 0);
+
+    qtest_quit(qts);
+    unlink(img);
+}
