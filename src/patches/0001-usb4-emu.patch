+/* ---- migration ---- */
+
+/* Migration (and savevm) refuse to start while a tunnel bridge exists. */
+static void assert_migration_blocked(QTestState *qts)
+{
+    QDict *rsp = qtest_qmp(qts, "{'execute': 'migrate', 'arguments': "
+                           "{'uri': 'tcp:127.0.0.1:1'}}");
+    QDict *err = qdict_get_qdict(rsp, "error");
+
+    g_assert(err);
+    g_assert(strstr(qdict_get_str(err, "desc"), "non-migratable"));
+    g_assert(strstr(qdict_get_str(err, "desc"), "usb4-tunnel"));
+    qobject_unref(rsp);
+}
+
+static void test_tunnel_unmigratable(void)
+{
+    g_autofree char *img = make_img();
+    QTestState *qts;
+
+    qts = qtest_initf("-machine q35 "
+                      "-drive if=none,id=disk0,file=%s,format=raw "
+                      "-device usb4-tunnel-port,id=tp0,bus=pcie.0,addr=0x3,"
+                      "chassis=1,nvme-drive=disk0,nvme-serial=QT1", img);
+    assert_migration_blocked(qts);
+    qtest_quit(qts);
+
+    qts = tb_start(img, false);
+    assert_migration_blocked(qts);
+    qtest_quit(qts);
+    unlink(img);
+}
+
+static void run_qemu_img(const char **argv)
+{
+    int status;
+
+    g_assert(g_spawn_sync(NULL, (char **)argv, NULL,
+                          G_SPAWN_STDOUT_TO_DEV_NULL, NULL, NULL,
+                          NULL, NULL, &status, NULL));
+    g_assert_cmpint(status, ==, 0);     /* exited with 0 */
+}
+
+/* A 1 MiB qcow2 image (snapshots need it), or NULL without qemu-img. */
+static char *make_qcow2(void)
+{
+    const char *qemu_img = g_getenv("QTEST_QEMU_IMG");
+    char *img = NULL;
+    int fd;
+
+    if (!qemu_img) {
+        return NULL;
+    }
+    fd = g_file_open_tmp("usb4-tunnel-XXXXXX", &img, NULL);
+    g_assert(fd >= 0);
+    close(fd);
+    {
+        const char *argv[] = { qemu_img, "create", "-q", "-f", "qcow2",
+                               img, "1M", NULL };
+
+        run_qemu_img(argv);
+    }
+    return img;
+}
+
+/* The first byte of the current (not snapshot) content of a qcow2 image. */
+static uint8_t qcow2_byte0(const char *img)
+{
+    const char *qemu_img = g_getenv("QTEST_QEMU_IMG");
+    g_autofree char *raw = NULL;
+    g_autofree char *data = NULL;
+    int fd = g_file_open_tmp("usb4-tunnel-XXXXXX", &raw, NULL);
+    const char *argv[] = { qemu_img, "convert", "-f", "qcow2", "-O", "raw",
+                           img, raw, NULL };
+
+    g_assert(fd >= 0);
+    close(fd);
+    run_qemu_img(argv);
+    g_assert(g_file_get_contents(raw, &data, NULL, NULL));
+    unlink(raw);
+    return data[0];
+}
