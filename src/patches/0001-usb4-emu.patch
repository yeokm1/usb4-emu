+    g_assert_cmphex(qtest_readl(t->qts, cfg + 0x100) & 0xffff, ==, 0x0003);
+    g_assert_cmphex(qtest_readl(t->qts, cfg + 0x100) >> 20, ==, 0x10c);
+    g_assert_cmphex(qtest_readl(t->qts, cfg + 0x10c) & 0xfffff, ==, 0x10023);
+    g_assert_cmphex(qtest_readl(t->qts, cfg + 0x110), ==, 0x01001ec0);
+    g_assert_cmphex(qtest_readl(t->qts, cfg + 0x114), ==, 0x00000001);
+    t_stop(t);
