+/* Held commands are discarded by queue deletion and by a function reset. */
+static void test_held_discarded(void)
+{
+    g_autofree char *img = make_img();
+    g_autofree char *tok = NULL;
+    Nv nv;
+    QTestState *qts = tp_start(img, ",x-faults=\"at=fetch op=read lba=1 "
+                               "act=hold repeat=on\"", "", &nv);
+    uint16_t cid;
+
+    nv_bringup(&nv);
+    qtest_memset(qts, RAM_BUF, SENTINEL, 512);
+    nv_read(&nv, 1, 1, RAM_BUF);
+    g_assert_cmpuint(held_count(qts), ==, 1);
+    tok = qom_get_str(qts, TP_PATH, "x-release");
+
+    /* Delete I/O SQ 1: the held read goes, without a completion. */
+    nv_admin_ok(&nv, 0x00, 0, 0, 1, 0);
+    g_assert_cmpuint(held_count(qts), ==, 0);
+    qom_set_str(qts, TP_PATH, "x-release", tok);       /* a no-op now */
+    g_assert(!nv_poll(&nv, 1, -1, NULL, NULL, 50));
+    g_assert(buf_is(qts, RAM_BUF, SENTINEL));
+
+    /* A new SQ 1 works; hold again, then FLR. */
+    nv.sq_tail[1] = 0;
+    qtest_memset(qts, RAM_SQ1, 0, 0x1000);
+    nv_admin_ok(&nv, 0x01, 0, RAM_SQ1, ((QSIZE - 1) << 16) | 1,
+                (1 << 16) | 1);
+    cid = nv_read(&nv, 1, 0, RAM_BUF);
+    g_assert(nv_poll(&nv, 1, cid, NULL, NULL, 2000));
+    nv_read(&nv, 1, 1, RAM_BUF2);
+    g_assert_cmpuint(held_count(qts), ==, 1);
+    ep_flr(qts);
+    g_assert_cmpuint(held_count(qts), ==, 0);
+
+    /* After the reset the controller starts afresh. */
+    nv_reg_init(&nv, qts, WIN_MEM);
+    nv_bringup(&nv);
+    qtest_memset(qts, RAM_BUF, SENTINEL, 512);
+    cid = nv_read(&nv, 1, 0, RAM_BUF);
+    g_assert(nv_poll(&nv, 1, cid, NULL, NULL, 2000));
+    g_assert(buf_is(qts, RAM_BUF, PATTERN));
+    qtest_quit(qts);
+    unlink(img);
+}
