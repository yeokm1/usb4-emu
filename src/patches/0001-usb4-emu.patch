+/* ---- review fixes ---- */
+
+#define TB0_DEVFN       ((1 << 3) | 0)      /* tunnel bridge tb0 at 2:01.0 */
+#define EP_DEVFN        ((1 << 3) | 0)      /* its endpoint at 4:01.0 */
+#define NVME_BAR        0xe0100000u
+#define TB0_PATH        "/machine/peripheral/tb0"
+
+/*
+ * Step the clock until the endpoint behind tb0 answers config, or fail.
+ * Real time passes too: an insertion waiting for the previous endpoint
+ * to release its drive retries on the realtime clock.
+ */
+static bool wait_ep(QTestState *qts, bool present)
+{
+    for (int i = 0; i < 200; i++) {
+        uint32_t id = cfg_rd(qts, 4, EP_DEVFN, 0);
+
+        if ((id != 0xffffffff) == present) {
+            return true;
+        }
+        qtest_clock_step(qts, SEC(0.1));
+        g_usleep(20 * 1000);
+    }
+    return false;
+}
+
+/*
+ * configure(), then tb0 (2:01.0) to bus 4 with a window for the NVMe
+ * the pre-boot tunnel put behind it, and the NVMe's BAR0 and Command.
+ */
+static void configure_tunnel(QTestState *qts)
+{
+    configure(qts);
+    cfg_wr(qts, 2, TB0_DEVFN, 0x18, 0x00040402);
+    cfg_wr(qts, 2, TB0_DEVFN, 0x20, 0xe010e010);
+    cfg_wr(qts, 2, TB0_DEVFN, 0x04, 0x6);
+    g_assert_true(wait_ep(qts, true));
+    g_assert_cmphex(cfg_rd(qts, 4, EP_DEVFN, 0), ==, 0x00101b36);
+    cfg_wr(qts, 4, EP_DEVFN, 0x10, NVME_BAR);
+    cfg_wr(qts, 4, EP_DEVFN, 0x14, 0);
+    cfg_wr(qts, 4, EP_DEVFN, 0x04, 0x6);
+}
+
+/* SHPC of tb0 (2:01.0): config-space window (dword select at cap+2) */
+static uint32_t shpc_rd(QTestState *qts, int reg)
+{
+    int cap = cfg_rd(qts, 2, TB0_DEVFN, 0x34) & 0xfc;
+
+    while ((cfg_rd(qts, 2, TB0_DEVFN, cap) & 0xff) != 0x0c) {
+        cap = (cfg_rd(qts, 2, TB0_DEVFN, cap) >> 8) & 0xfc;
+    }
+    qtest_outl(qts, 0xcf8, 0x80000000 | (2 << 16) | (TB0_DEVFN << 8) |
+               (cap & ~3));
+    qtest_outb(qts, 0xcfc + 2, reg / 4);
+    return cfg_rd(qts, 2, TB0_DEVFN, cap + 4);
+}
+
+static void shpc_wr(QTestState *qts, int reg, uint32_t v)
+{
+    int cap = cfg_rd(qts, 2, TB0_DEVFN, 0x34) & 0xfc;
+
+    while ((cfg_rd(qts, 2, TB0_DEVFN, cap) & 0xff) != 0x0c) {
+        cap = (cfg_rd(qts, 2, TB0_DEVFN, cap) >> 8) & 0xfc;
+    }
+    qtest_outl(qts, 0xcf8, 0x80000000 | (2 << 16) | (TB0_DEVFN << 8) |
+               (cap & ~3));
+    qtest_outb(qts, 0xcfc + 2, reg / 4);
+    cfg_wr(qts, 2, TB0_DEVFN, cap + 4, v);
+}
+
+#define SHPC_CMD        0x14    /* code byte, target byte */
+#define SHPC_SLOT0      0x24    /* slot 0 status: state in bits 0-1 */
+#define SHPC_DISABLED   0x3
+#define SHPC_ENABLED    0x2
+
+/* Force tb0's tunnel (the debug override; a CM's approval in real use). */
+static void tb0_tunnel(QTestState *qts, const char *state)
+{
+    qtest_qmp_assert_success(qts, "{'execute': 'qom-set', 'arguments': "
+                             "{'path': %s, 'property': 'tunnel', "
+                             "'value': %s}}", TB0_PATH, state);
+}
+
+/*
+ * Review P1 #1: with root-hotplug=restore and a pre-boot tunnel, the
+ * departure resets the tree and removes the tunnelled NVMe. After the
+ * arrival the controller starts as after a power-up (no pre-boot), so
+ * the NVMe comes back only when the tunnel is up again, as a new
+ * object. It must get the configuration the old one had (keyed by
+ * position and model) before the guest reaches it, not come up
+ * unconfigured. Once that endpoint leaves again, the record is spent:
+ * the next one starts from reset.
+ */
+static void test_restore_replaced_endpoint(void)
+{
+    QTestState *qts = start(",root-hotplug=restore", ",preboot=on", true);
+
+    configure_tunnel(qts);
+    g_assert_cmphex(cfg_rd(qts, 4, EP_DEVFN, 0x10) & ~0xfu, ==, NVME_BAR);
+
+    set_present(qts, false);
+    g_assert_cmphex(cfg_rd(qts, 4, EP_DEVFN, 0), ==, 0xffffffff);
+    wait_stage(qts, "root-quiesced");
+    set_present(qts, true);
+    wait_stage(qts, "root-arrived");
+    g_assert_cmphex(cfg_rd(qts, 2, TB0_DEVFN, 0x18), ==, 0x00040402);
+    tb0_tunnel(qts, "up");
+    g_assert_true(wait_ep(qts, true));
+    g_assert_cmphex(cfg_rd(qts, 4, EP_DEVFN, 0x10), ==, NVME_BAR | 0x4);
+    g_assert_cmphex(cfg_rd(qts, 4, EP_DEVFN, 0x04) & 0x7, ==, 0x6);
+    /* NVMe CAP readable at the restored BAR */
+    g_assert_cmphex(qtest_readl(qts, NVME_BAR), !=, 0xffffffff);
+
+    /* the next replacement in that slot starts from reset */
+    tb0_tunnel(qts, "surprise");
+    g_assert_true(wait_ep(qts, false));
+    tb0_tunnel(qts, "up");
+    g_assert_true(wait_ep(qts, true));
+    g_assert_cmphex(cfg_rd(qts, 4, EP_DEVFN, 0x10), ==, 0x4);
+    qtest_quit(qts);
+}
+
+/*
+ * Review P1 #2: the guest disabled tb0's SHPC slot (the NVMe goes away
+ * and the slot is claimed). A present cycle in restore mode must bring
+ * the slot back Disabled and keep the NVMe unreachable, with
+ * shpc-autoenable not re-armed, until the guest enables the slot.
+ */
+static void test_restore_shpc_state(void)
+{
+    QTestState *qts = start(",root-hotplug=restore", ",preboot=on", true);
+
+    configure_tunnel(qts);
+    /* Set Slot State command: Disabled (code 0x3 << 0 in the state field) */
+    shpc_wr(qts, SHPC_CMD, (1 << 8) | SHPC_DISABLED);
+    qtest_clock_step(qts, SEC(1));
+    g_assert_true(wait_ep(qts, false));
+    g_assert_cmphex(shpc_rd(qts, SHPC_SLOT0) & 0x3, ==, SHPC_DISABLED);
+
+    set_present(qts, false);
+    wait_stage(qts, "root-quiesced");
+    set_present(qts, true);
+    wait_stage(qts, "root-arrived");
+    /* a new endpoint arrives in the disabled, claimed slot */
+    tb0_tunnel(qts, "up");
+    qtest_clock_step(qts, SEC(5));
+    g_assert_cmphex(shpc_rd(qts, SHPC_SLOT0) & 0x3, ==, SHPC_DISABLED);
+    g_assert_cmphex(cfg_rd(qts, 4, EP_DEVFN, 0), ==, 0xffffffff);
+
+    /* the guest enables it: the NVMe is reachable again */
+    shpc_wr(qts, SHPC_CMD, (1 << 8) | SHPC_ENABLED);
+    g_assert_true(wait_ep(qts, true));
+    qtest_quit(qts);
+}
+
+/*
+ * Review P2 #3: an eject while the tree is already down (after the
+ * Assist power-off, before the removal notification; or after present
+ * off) empties the slot and cancels the pending notification.
+ */
+static void test_eject_while_down(void)
+{
+    QTestState *qts = start(",root-hotplug=acpi",
+                            ",bios-assist=on,power-off-delay-ms=11000",
+                            true);
+
+    configure(qts);
+    qtest_qmp_device_del_send(qts, "d0");
+    qtest_clock_step(qts, SEC(12));         /* powered off, not notified */
+    g_assert_false(nhi_alive(qts));
+    g_assert_true(root_visible(qts));
+    gpe_take(qts);
+    qtest_outl(qts, PCIHP_SEL, 0);
+    qtest_outl(qts, PCIHP_EJ, SLOT_BIT);
+    g_assert_false(root_visible(qts));
+    qtest_clock_step(qts, SEC(10));         /* past the notification */
+    g_assert_false(gpe_take(qts));
+    g_assert_false(root_visible(qts));
+    qtest_quit(qts);
+
+    /* present off first (notified), then the guest's eject */
+    qts = start(",root-hotplug=acpi", "", true);
+    configure(qts);
+    set_present(qts, false);
+    wait_stage(qts, "root-removal-notified");
+    g_assert_true(root_visible(qts));
+    qtest_outl(qts, PCIHP_SEL, 0);
+    qtest_outl(qts, PCIHP_EJ, SLOT_BIT);
+    g_assert_false(root_visible(qts));
+    set_present(qts, true);
+    wait_stage(qts, "root-arrived");
+    g_assert_true(root_visible(qts));
+    g_assert_cmphex(cfg_rd(qts, 0, RP_DEVFN, 0x18), ==, 0);
+    qtest_quit(qts);
+}
+
+/* ---- DSDT (review P2 #4) ---- */
+
+/* The DSDT from fw_cfg "etc/acpi/tables" (all tables, as built). */
+static unsigned dsm_count_in(QTestState *qts)
+{
+    QFWCFG *fw = pc_fw_cfg_init(qts);
+    size_t len = qfw_cfg_get_file(fw, "etc/acpi/tables", NULL, 0);
+    g_autofree uint8_t *buf = g_malloc0(len);
+    unsigned n = 0;
+
+    g_assert_cmpuint(len, >, 0);
+    qfw_cfg_get_file(fw, "etc/acpi/tables", buf, len);
+    for (size_t i = 0; i + 4 <= len; i++) {
+        /* a _DSM method declaration: MethodOp (0x14), PkgLength, "_DSM" */
+        if (!memcmp(buf + i, "_DSM", 4) && i >= 3 &&
+            (buf[i - 2] == 0x14 || buf[i - 3] == 0x14)) {
+            n++;
+        }
+    }
+    pc_fw_cfg_uninit(fw);
+    qtest_quit(qts);
+    return n;
+}
+
+static unsigned dsm_count(const char *root_opts)
+{
+    return dsm_count_in(start(root_opts, "", false));
+}
+
+/*
+ * The root bridge as function 1 of slot 6, next to a multifunction
+ * device at 6.0, with acpi-index: only function 0 takes part in the
+ * hot-plug description.
+ */
+static unsigned dsm_count_fn1(const char *root_opts)
+{
+    return dsm_count_in(qtest_initf(
+        "-machine pc "
+        "-global PIIX4_PM.acpi-pci-hotplug-with-bridge-support=off "
+        "-device pci-testdev,bus=pci.0,addr=0x6.0,multifunction=on "
+        "-device usb4-tunnel-bridge,id=tbrp,bus=pci.0,addr=0x6.1,"
+        "chassis_nr=1,msi=off,acpi-index=7%s", root_opts));
+}
+
+/*
+ * A slot owner with acpi-index: its hot-plug description already has a
+ * _DSM; the static path must not add a second one to the same device.
+ */
+static void test_acpi_index_single_dsm(void)
+{
+    unsigned plain = dsm_count(",root-hotplug=acpi");
+    unsigned indexed = dsm_count(",root-hotplug=acpi,acpi-index=7");
+
+    g_assert_cmpuint(plain, >, 0);
+    g_assert_cmpuint(indexed, ==, plain);
+    /* not a slot owner: the static _DSM is still emitted */
+    g_assert_cmpuint(dsm_count(",acpi-index=7"), ==, dsm_count("") + 1);
+}
+
+/*
+ * Review N1: the endpoint from before the departure is still there
+ * (its removal held) when the tree comes back and the tunnel is up
+ * again. It must not consume the record; the replacement inserted once
+ * the held removal completes gets the old BAR and Command.
+ */
+static void test_restore_held_departure(void)
+{
+    QTestState *qts = start(",root-hotplug=restore", ",preboot=on", true);
+    QDict *rsp;
+
+    configure_tunnel(qts);
+    qtest_qmp_assert_success(qts, "{'execute': 'qom-set', 'arguments': "
+                             "{'path': %s, 'property': 'x-hold-deferred', "
+                             "'value': true}}", TB0_PATH);
+    set_present(qts, false);
+    wait_stage(qts, "root-quiesced");
+    set_present(qts, true);
+    wait_stage(qts, "root-arrived");
+    tb0_tunnel(qts, "up");
+    qtest_clock_step(qts, SEC(1));
+    qtest_qmp_assert_success(qts, "{'execute': 'qom-set', 'arguments': "
+                             "{'path': %s, 'property': 'x-hold-deferred', "
+                             "'value': false}}", TB0_PATH);
+    g_assert_true(wait_ep(qts, true));
+    rsp = qtest_qmp(qts, "{'execute': 'qom-get', 'arguments': "
+                    "{'path': %s, 'property': 'endpoint'}}", TB0_PATH);
+    g_assert_true(g_str_has_prefix(qdict_get_str(rsp, "return"), "live"));
+    g_assert_null(strstr(qdict_get_str(rsp, "return"), "gen=1 "));
+    qobject_unref(rsp);
+    g_assert_cmphex(cfg_rd(qts, 4, EP_DEVFN, 0x10), ==, NVME_BAR | 0x4);
+    g_assert_cmphex(cfg_rd(qts, 4, EP_DEVFN, 0x04) & 0x7, ==, 0x6);
+    qtest_quit(qts);
+}
+
+/*
+ * Review N2: while the tree is away, a different device router (another
+ * disk) takes the port. Its NVMe must start from reset, not inherit the
+ * departed disk's configuration.
+ */
+static void test_restore_other_device(void)
+{
+    QTestState *qts = start(",root-hotplug=restore", ",preboot=on", true);
+
+    configure_tunnel(qts);
+    set_present(qts, false);
+    wait_stage(qts, "root-quiesced");
+    qtest_qmp_device_del(qts, "d0");
+    qtest_qmp_device_add(qts, "usb4-device", "d1",
+                         "{'bus': 'u4.0', 'port': 1, 'dialect': 'tb3', "
+                         "'drive': 'disk1', 'serial': 'OTHER-DISK'}");
+    set_present(qts, true);
+    wait_stage(qts, "root-arrived");
+    /* the controller's own functions are back as they were */
+    g_assert_cmphex(cfg_rd(qts, 2, TB0_DEVFN, 0x18), ==, 0x00040402);
+    tb0_tunnel(qts, "up");
+    g_assert_true(wait_ep(qts, true));
+    g_assert_cmphex(cfg_rd(qts, 4, EP_DEVFN, 0x10), ==, 0x4);
+    g_assert_cmphex(cfg_rd(qts, 4, EP_DEVFN, 0x04) & 0x7, ==, 0);
+    qtest_quit(qts);
+}
+
+/*
+ * Review 3: the same router id on the same port, recreated while the
+ * tree is away with a namespace layout on another backend (no drive or
+ * serial either time). It presents a different disk and must start from
+ * reset.
+ */
+static void test_restore_other_namespaces(void)
+{
+    QTestState *qts = start_dev(",root-hotplug=restore", ",preboot=on",
+                                "nvme-namespaces=1:disk0");
+
+    configure_tunnel(qts);
+    set_present(qts, false);
+    wait_stage(qts, "root-quiesced");
+    qtest_qmp_device_del(qts, "d0");
+    qtest_qmp_device_add(qts, "usb4-device", "d0",
+                         "{'bus': 'u4.0', 'port': 1, 'dialect': 'tb3', "
+                         "'nvme-namespaces': '1:disk1'}");
+    set_present(qts, true);
+    wait_stage(qts, "root-arrived");
+    tb0_tunnel(qts, "up");
+    g_assert_true(wait_ep(qts, true));
+    g_assert_cmphex(cfg_rd(qts, 4, EP_DEVFN, 0x10), ==, 0x4);
+    g_assert_cmphex(cfg_rd(qts, 4, EP_DEVFN, 0x04) & 0x7, ==, 0);
+    qtest_quit(qts);
+
+    /* the same layout on the same backend does get its configuration */
+    qts = start_dev(",root-hotplug=restore", ",preboot=on",
+                    "nvme-namespaces=1:disk0");
+    configure_tunnel(qts);
+    set_present(qts, false);
+    wait_stage(qts, "root-quiesced");
+    qtest_qmp_device_del(qts, "d0");
+    qtest_qmp_device_add(qts, "usb4-device", "d0",
+                         "{'bus': 'u4.0', 'port': 1, 'dialect': 'tb3', "
+                         "'nvme-namespaces': '1:disk0'}");
+    set_present(qts, true);
+    wait_stage(qts, "root-arrived");
+    tb0_tunnel(qts, "up");
+    g_assert_true(wait_ep(qts, true));
+    g_assert_cmphex(cfg_rd(qts, 4, EP_DEVFN, 0x10), ==, NVME_BAR | 0x4);
+    qtest_quit(qts);
+}
+
+static char *qom_str(QTestState *qts, const char *path, const char *prop)
+{
+    QDict *rsp = qtest_qmp(qts, "{'execute': 'qom-get', 'arguments': "
+                           "{'path': %s, 'property': %s}}", path, prop);
+    char *v = g_strdup(qdict_get_str(rsp, "return"));
+
+    qobject_unref(rsp);
+    return v;
+}
+
+/*
+ * The identity of the endpoint behind a q35 tunnel port with nvme-nn
+ * @port_nn, for an ASM2464 router (a PCIe switch, then the NVMe) with
+ * nvme-nn @dev_nn, tunnelled by the pre-OS CM at power-on.
+ */
+static char *switch_identity(unsigned port_nn, unsigned dev_nn)
+{
+    QTestState *qts = qtest_initf(
+        "-nodefaults -machine q35 -global ICH9-LPC.acpi-pci-hotplug-with-"
+        "bridge-support=off -drive if=none,id=disk0,file=null-co://,"
+        "format=raw "
+        "-device usb4-tunnel-port,id=tp0,bus=pcie.0,addr=0x3,chassis=1,"
+        "settle-ms=200,nvme-nn=%u "
+        "-device usb4-host,id=u4,bus=pcie.0,addr=0x4,tunnel-port=tp0,"
+        "host-model=intel-adl,preos-cm=on "
+        "-device usb4-device,id=enc0,bus=u4.0,port=1,drive=disk0,"
+        "serial=QTORICO,device-model=asm2464,nvme-nn=%u", port_nn, dev_nn);
+    char *id = qom_str(qts, "/machine/peripheral/tp0", "x-identity");
+    g_autofree char *ep = qom_str(qts, "/machine/peripheral/tp0",
+                                  "endpoint");
+
+    g_assert_nonnull(strstr(ep, "live"));
+    qtest_quit(qts);
+    return id;
+}
+
+/*
+ * Review 4: the identity records the namespace count the build path
+ * actually gives the NVMe. Behind a switch only the router's nvme-nn
+ * counts (0: NVMe's default), not the tunnel port's fallback; on the
+ * direct path the port's nvme-nn is the fallback, as before.
+ */
+static void test_identity_nn(void)
+{
+    g_autofree char *dflt = switch_identity(8, 0);
+    g_autofree char *eight = switch_identity(8, 8);
+    g_autofree char *direct = NULL;
+    QTestState *qts;
+
+    g_assert_nonnull(strstr(dflt, ";nn=0;"));
+    g_assert_nonnull(strstr(eight, ";nn=8;"));
+    g_assert_cmpstr(dflt, !=, eight);
+
+    qts = qtest_init(
+        "-machine pc -drive if=none,id=disk0,file=null-co://,format=raw "
+        "-device usb4-tunnel-bridge,id=tb0,bus=pci.0,addr=0x5,chassis_nr=1,"
+        "msi=off,nvme-nn=8 "
+        "-device usb4-host,id=u4,bus=pci.0,addr=0x4,tunnel-port=tb0,"
+        "msi=off,msix=off "
+        "-device usb4-device,id=d0,bus=u4.0,port=1,drive=disk0");
+    qtest_qmp_assert_success(qts, "{'execute': 'qom-set', 'arguments': "
+                             "{'path': '/machine/peripheral/tb0', "
+                             "'property': 'tunnel', 'value': 'up'}}");
+    direct = qom_str(qts, "/machine/peripheral/tb0", "x-identity");
+    g_assert_nonnull(strstr(direct, ";nn=8;"));
+    qtest_quit(qts);
+}
+
+/*
+ * Review N3: an owner at a nonzero function is not in the hot-plug
+ * description, so it keeps its static acpi-index _DSM.
+ */
+static void test_acpi_index_fn1(void)
+{
+    g_assert_cmpuint(dsm_count_fn1(",root-hotplug=acpi"), ==,
+                     dsm_count_fn1(""));
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    qtest_add_func("/usb4-root-hotplug/surprise-gate", test_surprise_gate);
+    qtest_add_func("/usb4-root-hotplug/acpi-event-arrival",
+                   test_acpi_event_and_arrival);
+    qtest_add_func("/usb4-root-hotplug/restore", test_restore);
+    qtest_add_func("/usb4-root-hotplug/none", test_none);
+    qtest_add_func("/usb4-root-hotplug/r32-timing", test_r32_timing);
+    qtest_add_func("/usb4-root-hotplug/r32-replug-before-removal",
+                   test_r32_replug_before_removal);
+    qtest_add_func("/usb4-root-hotplug/guest-eject", test_guest_eject);
+    qtest_add_func("/usb4-root-hotplug/not-a-domain", test_not_a_domain);
+    qtest_add_func("/usb4-root-hotplug/restore-replaced-endpoint",
+                   test_restore_replaced_endpoint);
+    qtest_add_func("/usb4-root-hotplug/restore-shpc-state",
+                   test_restore_shpc_state);
+    qtest_add_func("/usb4-root-hotplug/eject-while-down",
+                   test_eject_while_down);
+    qtest_add_func("/usb4-root-hotplug/acpi-index-single-dsm",
+                   test_acpi_index_single_dsm);
+    qtest_add_func("/usb4-root-hotplug/restore-held-departure",
+                   test_restore_held_departure);
+    qtest_add_func("/usb4-root-hotplug/restore-other-device",
+                   test_restore_other_device);
+    qtest_add_func("/usb4-root-hotplug/acpi-index-fn1", test_acpi_index_fn1);
+    qtest_add_func("/usb4-root-hotplug/restore-other-namespaces",
+                   test_restore_other_namespaces);
+    qtest_add_func("/usb4-root-hotplug/identity-nn", test_identity_nn);
+    return g_test_run();
+}
diff --git a/tests/qtest/usb4-tb3dev-test.c b/tests/qtest/usb4-tb3dev-test.c
new file mode 100644
index 0000000000000000000000000000000000000000..69b17b61b47a8819a01045957949b609085c918f
--- /dev/null
+++ b/tests/qtest/usb4-tb3dev-test.c
@@ -0,0 +1,1170 @@
+/*
+ * qtest for a Thunderbolt 3 device router (usb4-device dialect=tb3) on a
+ * USB4 host (profile usb4-generic) with host-model minimal, intel-adl and
+ * amd, as a software connection manager drives it (the Framework 13
+ * capture with the CalDigit TS3 Plus, docs/CAPTURE-VS-LINUX.md ADL-38 to
+ * ADL-54), and the amd host model's identity (docs/USB4-HOSTS.md 7).
+ *
+ * Copyright (c) 2026 usb4-emu contributors
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Written from scratch for the usb4-emu project. Covers configuration
+ * checks, the TB3 router's power-on state, plug events and link
+ * controller writes, TBT3-Compatible Mode on the host's USB4 port, and
+ * a PCIe tunnel to the NVMe behind an i440FX tunnel bridge with removal
+ * by device_del. Register-level behaviour (lane bonding, hot plug
+ * events, the Router CS gap) is in tests/usb4/fabric-test.c.
+ */
+
+#include "qemu/osdep.h"
+#include "libqtest.h"
+#include "qobject/qdict.h"
+
+#define QEMU_NVME       0x00101b36u
+
+/* BAR0 registers, Spec 2.0 Table 12-10 (q35 chain test: elsewhere) */
+static uint32_t bar0 = 0xe0000000u;
+#define BAR0            bar0
+#define TX_RING(n)      (0x00000 + (n) * 0x10)
+#define RX_RING(n)      (0x08000 + (n) * 0x10)
+#define  RING_BASE_LO   0x0
+#define  RING_INDEX     0x8
+#define  RING_SIZE      0xc
+#define TX_CTRL(n)      (0x19800 + (n) * 0x20)
+#define RX_CTRL(n)      (0x29800 + (n) * 0x20)
+#define RING_VALID      (1u << 31)
+#define RING_RAW        (1u << 30)
+#define DESC_DD         (1u << 21)
+#define DESC_RS         (1u << 22)
+#define DESC_IE         (1u << 23)
+
+#define RING_N          8
+#define MEM_TX_RING     0x00100000u
+#define MEM_RX_RING     0x00101000u
+#define MEM_TX_BUF      0x00102000u     /* RING_N buffers of 256 bytes */
+#define MEM_RX_BUF      0x00104000u
+
+#define NHI_DEVFN       (4 << 3)
+
+/* Control packet PDFs (Spec Table 6-3) and config spaces (6.4.2.2) */
+#define PDF_READ        1
+#define PDF_WRITE       2
+#define PDF_NOTIFY      3
+#define PDF_HOTPLUG     5
+#define CS_PATH         0
+#define CS_ADAPTER      1
+#define CS_ROUTER       2
+
+#define CAP_LANE        1
+#define CAP_PROTO       4
+#define CAP_PORT        6
+
+static uint32_t cfg_addr(int bus, int devfn, int off)
+{
+    return 0x80000000u | (bus << 16) | (devfn << 8) | (off & 0xfc);
+}
+
+static uint32_t cfg_readl(QTestState *qts, int bus, int devfn, int off)
+{
+    qtest_outl(qts, 0xcf8, cfg_addr(bus, devfn, off));
+    return qtest_inl(qts, 0xcfc);
+}
+
+static void cfg_writel(QTestState *qts, int bus, int devfn, int off,
+                       uint32_t val)
+{
+    qtest_outl(qts, 0xcf8, cfg_addr(bus, devfn, off));
+    qtest_outl(qts, 0xcfc, val);
+}
+
+static void expect_error(QDict *rsp, const char *what)
+{
+    QDict *err = qdict_get_qdict(rsp, "error");
+
+    g_assert(err);
+    g_assert(strstr(qdict_get_str(err, "desc"), what));
+    qobject_unref(rsp);
+}
+
+static void test_bad_config(void)
+{
+    QTestState *qts = qtest_init("-nodefaults -machine pc "
+                                 "-device usb4-host,id=u4,addr=04.0");
+
+    /* amd: host-domain 0-3, usb4-generic only */
+    expect_error(qtest_qmp(qts, "{'execute': 'device_add', 'arguments': "
+                           "{'driver': 'usb4-host', 'addr': '05.0', "
+                           "'host-model': 'amd', 'host-domain': 4}}"),
+                 "host-domain 0..3");
+    expect_error(qtest_qmp(qts, "{'execute': 'device_add', 'arguments': "
+                           "{'driver': 'usb4-host', 'addr': '05.0', "
+                           "'host-model': 'amd', "
+                           "'profile': 'tb3-alpine-ridge'}}"),
+                 "usb4-generic profile only");
+    /* a TB3 device router is welcome on a USB4 host */
+    qtest_qmp_assert_success(qts, "{'execute': 'device_add', 'arguments': "
+                             "{'driver': 'usb4-device', 'bus': 'u4.0', "
+                             "'id': 'enc0', 'dialect': 'tb3'}}");
+    /* lc-uuid: derived or captured, TB3 routers only */
+    expect_error(qtest_qmp(qts, "{'execute': 'device_add', 'arguments': "
+                           "{'driver': 'usb4-device', 'bus': 'u4.0', "
+                           "'port': 2, 'lc-uuid': 'captured'}}"),
+                 "lc-uuid must be");
+    expect_error(qtest_qmp(qts, "{'execute': 'device_add', 'arguments': "
+                           "{'driver': 'usb4-device', 'bus': 'u4.0', "
+                           "'port': 2, 'dialect': 'tb3', 'lc-uuid': 'x'}}"),
+                 "lc-uuid must be");
+    qtest_quit(qts);
+
+    /* lc-uuid=captured is refused behind a firmware CM */
+    qts = qtest_init("-nodefaults -machine pc "
+                     "-device usb4-host,id=tb,addr=05.0,"
+                     "profile=tb3-alpine-ridge");
+    expect_error(qtest_qmp(qts, "{'execute': 'device_add', 'arguments': "
+                           "{'driver': 'usb4-device', 'bus': 'tb.0', "
+                           "'dialect': 'tb3', 'lc-uuid': 'captured'}}"),
+                 "needs a profile=usb4-generic host");
+    qtest_quit(qts);
+}
+
+/* ------------------------------------------------------------------ */
+/* Ring 0 control packets                                               */
+/* ------------------------------------------------------------------ */
+
+static uint32_t crc32c(const uint8_t *p, size_t n)
+{
+    uint32_t c = 0xffffffffu;
+
+    while (n--) {
+        c ^= *p++;
+        for (int b = 0; b < 8; b++) {
+            c = (c >> 1) ^ ((c & 1) ? 0x82f63b78u : 0);
+        }
+    }
+    return c ^ 0xffffffffu;
+}
+
+static void put_be32(uint8_t *p, uint32_t v)
+{
+    p[0] = v >> 24;
+    p[1] = v >> 16;
+    p[2] = v >> 8;
+    p[3] = v;
+}
+
+static uint32_t get_be32(const uint8_t *p)
+{
+    return ((uint32_t)p[0] << 24) | (p[1] << 16) | (p[2] << 8) | p[3];
+}
+
+static void desc_write(QTestState *qts, uint64_t d, uint64_t addr,
+                       uint32_t dw2)
+{
+    qtest_writel(qts, d, (uint32_t)addr);
+    qtest_writel(qts, d + 4, addr >> 32);
+    qtest_writel(qts, d + 8, dw2);
+    qtest_writel(qts, d + 12, 0);
+}
+
+/* devfn of the host interface ring0_start() programs */
+static int nhi_devfn = NHI_DEVFN;
+
+typedef struct Ring0 {
+    QTestState *qts;
+    unsigned tx, rx;        /* next descriptor */
+    unsigned hp;            /* hot plug events acknowledged */
+    /* the last 32 of them: route, adapter | unplug << 8 */
+    uint64_t ev_route[32];
+    unsigned ev[32];
+} Ring0;
+
+static void ring0_start(Ring0 *r, QTestState *qts)
+{
+    r->qts = qts;
+    r->tx = r->rx = r->hp = 0;
+    cfg_writel(qts, 0, nhi_devfn, 0x10, BAR0);
+    cfg_writel(qts, 0, nhi_devfn, 0x04, 0x6);
+    qtest_writel(qts, BAR0 + TX_RING(0) + RING_BASE_LO, MEM_TX_RING);
+    qtest_writel(qts, BAR0 + TX_RING(0) + RING_SIZE, RING_N);
+    qtest_writel(qts, BAR0 + TX_CTRL(0), RING_VALID | RING_RAW);
+    qtest_writel(qts, BAR0 + RX_RING(0) + RING_BASE_LO, MEM_RX_RING);
+    qtest_writel(qts, BAR0 + RX_RING(0) + RING_SIZE, RING_N | (256 << 16));
+    qtest_writel(qts, BAR0 + RX_CTRL(0), RING_VALID | RING_RAW);
+}
+
+static void ring0_send(Ring0 *r, unsigned pdf, const uint32_t *dw,
+                       unsigned ndw)
+{
+    QTestState *qts = r->qts;
+    uint64_t txd = MEM_TX_RING + 16 * r->tx, txb = MEM_TX_BUF + 256 * r->tx;
+    uint8_t f[256];
+    unsigned flen;
+
+    for (unsigned i = 0; i < ndw; i++) {
+        put_be32(f + 4 * i, dw[i]);
+    }
+    put_be32(f + 4 * ndw, crc32c(f, 4 * ndw));
+    flen = 4 * ndw + 4;
+    qtest_memwrite(qts, txb, f, flen);
+    desc_write(qts, txd, txb, flen | (pdf << 12) | DESC_RS);
+    r->tx = (r->tx + 1) % RING_N;
+    qtest_writel(qts, BAR0 + TX_RING(0) + RING_INDEX, r->tx << 16);
+}
+
+/* Post one RX buffer; returns its slot. */
+static unsigned ring0_post(Ring0 *r)
+{
+    unsigned slot = r->rx;
+
+    desc_write(r->qts, MEM_RX_RING + 16 * slot, MEM_RX_BUF + 256 * slot,
+               DESC_RS | DESC_IE);
+    r->rx = (r->rx + 1) % RING_N;
+    qtest_writel(r->qts, BAR0 + RX_RING(0) + RING_INDEX, r->rx);
+    return slot;
+}
+
+/*
+ * One request on ring 0, its answer back. Hot plug events that arrive
+ * first (Spec 6.8) are acknowledged (HP_ACK, Table 6-12) and counted.
+ * Returns the answer's PDF and fills @rsp / *len.
+ */
+static unsigned ring0_xfer(Ring0 *r, unsigned pdf, uint64_t route,
+                           unsigned cs, unsigned adp, unsigned off,
+                           unsigned n, const uint32_t *wdata, uint8_t *rsp,
+                           unsigned *len)
+{
+    QTestState *qts = r->qts;
+    uint32_t dw[64];
+    unsigned ndw = 3;
+
+    dw[0] = route >> 32;
+    dw[1] = (uint32_t)route;
+    dw[2] = off | (n << 13) | (adp << 19) | (cs << 25);
+    if (pdf == PDF_WRITE) {
+        memcpy(&dw[3], wdata, 4 * n);
+        ndw += n;
+    }
+    for (;;) {
+        unsigned slot = ring0_post(r), rpdf;
+        uint64_t rxd = MEM_RX_RING + 16 * slot;
+        uint32_t dw2;
+
+        if (ndw) {
+            ring0_send(r, pdf, dw, ndw);
+            ndw = 0;
+        }
+        dw2 = qtest_readl(qts, rxd + 8);
+        g_assert_cmphex(dw2 & DESC_DD, ==, DESC_DD);
+        *len = dw2 & 0xfff;
+        qtest_memread(qts, MEM_RX_BUF + 256 * slot, rsp, *len);
+        g_assert_cmphex(get_be32(rsp + *len - 4), ==,
+                        crc32c(rsp, *len - 4));
+        rpdf = (dw2 >> 12) & 0xf;
+        if (rpdf != PDF_HOTPLUG) {
+            return rpdf;
+        }
+        /* Acknowledge: route, then event 7 with the adapter and PG */
+        {
+            uint32_t a[3] = {
+                get_be32(rsp) & 0x7fffffffu, get_be32(rsp + 4),
+                7 | ((get_be32(rsp + 8) & 0x3f) << 8) |
+                ((get_be32(rsp + 8) >> 31 ? 3u : 2u) << 30),
+            };
+
+            ring0_send(r, PDF_NOTIFY, a, 3);
+            r->ev_route[r->hp % 32] = ((uint64_t)(a[0] & 0xffffff) << 32) |
+                                      a[1];
+            r->ev[r->hp % 32] = (get_be32(rsp + 8) & 0x3f) |
+                                (get_be32(rsp + 8) >> 31 << 8);
+            r->hp++;
+        }
+    }
+}
+
+static void ring0_read(Ring0 *r, uint64_t route, unsigned cs, unsigned adp,
+                       unsigned off, unsigned n, uint32_t *out)
+{
+    uint8_t rsp[256];
+    unsigned len;
+
+    g_assert_cmpuint(ring0_xfer(r, PDF_READ, route, cs, adp, off, n, NULL,
+                                rsp, &len), ==, PDF_READ);
+    g_assert_cmpuint(len, ==, 16 + 4 * n);
+    for (unsigned i = 0; i < n; i++) {
+        out[i] = get_be32(rsp + 12 + 4 * i);
+    }
+}
+
+static uint32_t rd1(Ring0 *r, uint64_t route, unsigned cs, unsigned adp,
+                    unsigned off)
+{
+    uint32_t v;
+
+    ring0_read(r, route, cs, adp, off, 1, &v);
+    return v;
+}
+
+static void ring0_write(Ring0 *r, uint64_t route, unsigned cs, unsigned adp,
+                        unsigned off, unsigned n, const uint32_t *in)
+{
+    uint8_t rsp[256];
+    unsigned len;
+
+    g_assert_cmpuint(ring0_xfer(r, PDF_WRITE, route, cs, adp, off, n, in,
+                                rsp, &len), ==, PDF_WRITE);
+}
+
+static void wr1(Ring0 *r, uint64_t route, unsigned cs, unsigned adp,
+                unsigned off, uint32_t v)
+{
+    ring0_write(r, route, cs, adp, off, 1, &v);
+}
+
+static void rmw(Ring0 *r, uint64_t route, unsigned cs, unsigned adp,
+                unsigned off, uint32_t clr, uint32_t set)
+{
+    wr1(r, route, cs, adp, off, (rd1(r, route, cs, adp, off) & ~clr) | set);
+}
+
+/* Capability @id in an adapter's chain (Guide 3.2.2) */
+static unsigned adp_cap(Ring0 *r, uint64_t route, unsigned adp, unsigned id)
+{
+    unsigned ptr = rd1(r, route, CS_ADAPTER, adp, 1) & 0xff;
+
+    for (int n = 0; ptr && n < 16; n++) {
+        uint32_t h = rd1(r, route, CS_ADAPTER, adp, ptr);
+
+        if (((h >> 8) & 0xff) == id) {
+            return ptr;
+        }
+        ptr = h & 0xff;
+    }
+    g_assert_not_reached();
+}
+
+/* Path entry (Spec Table 8-22): @adp HopID 8 -> @out HopID 8 */
+static void path8(Ring0 *r, uint64_t route, unsigned adp, unsigned out,
+                  unsigned credits)
+{
+    uint32_t e[2] = {
+        8 | (out << 11) | (credits << 17) | (1u << 31),
+        1 | (3 << 8) | (credits ? 1u << 24 : (1u << 25 | 1u << 27)),
+    };
+
+    ring0_write(r, route, CS_PATH, adp, 16, 2, e);
+}
+
+/*
+ * The slot's "endpoint" property, or "(gone)" when the slot device no
+ * longer exists (qom-get answers with an error, e.g. a dock switch port
+ * removed with its switch).
+ */
+static char *endpoint_state(QTestState *qts, const char *id)
+{
+    g_autofree char *path = g_strdup_printf("/machine/peripheral/%s", id);
+    QDict *rsp = qtest_qmp(qts, "{'execute': 'qom-get', 'arguments': "
+                           "{'path': %s, 'property': 'endpoint'}}", path);
+    char *s;
+
+    s = g_strdup(qdict_haskey(rsp, "return") ?
+                 qdict_get_str(rsp, "return") : "(gone)");
+
+    qobject_unref(rsp);
+    return s;
+}
+
+/*
+ * i440FX, TB3 router on port 1 of a usb4-generic host with @model: the
+ * software CM steps of the Framework capture over ring 0, then the PCIe
+ * tunnel to the NVMe behind the tunnel bridge, then device_del.
+ */
+static void run_model(const char *model, uint32_t host_id)
+{
+    QTestState *qts = qtest_initf(
+        "-nodefaults -machine pc -global PIIX4_PM.acpi-pci-hotplug-with-"
+        "bridge-support=off -drive if=none,id=disk0,file=null-co://,"
+        "format=raw "
+        "-device usb4-tunnel-bridge,id=tp0,bus=pci.0,addr=0x5,chassis_nr=1,"
+        "shpc-autoenable=on,msi=off,settle-ms=200 "
+        "-device usb4-host,id=u4,bus=pci.0,addr=0x4,tunnel-port=tp0,"
+        "msi=off,msix=off,host-model=%s "
+        "-device usb4-device,id=enc0,bus=u4.0,port=1,drive=disk0,"
+        "serial=QTTB3,dialect=tb3,lc-uuid=captured", model);
+    static const uint32_t lc_uuid[4] = {
+        0x000003c6, 0x18879000, 0x30efca23, 0x26d04222,
+    };
+    unsigned hport, hpd = 0, hpcie;
+    uint32_t v[8];
+    char *st;
+    Ring0 r;
+
+    ring0_start(&r, qts);
+    g_assert_cmphex(rd1(&r, 0, CS_ROUTER, 0, 0), ==, host_id);
+    /* Enumerate the host router (Guide 3.2.1): Valid, CMUV 1.0 */
+    ring0_read(&r, 0, CS_ROUTER, 0, 1, 4, v);
+    v[2] |= 1u << 31;
+    v[3] = (v[3] & ~0xff00u) | 0x1000;
+    ring0_write(&r, 0, CS_ROUTER, 0, 1, 4, v);
+
+    /* TBT3-Compatible Mode on host USB4 port 1 (observed 0x00003301) */
+    hport = adp_cap(&r, 0, 1, CAP_PORT);
+    v[0] = rd1(&r, 0, CS_ADAPTER, 1, hport + 18);
+    g_assert_cmphex(v[0] & 0x6ff, ==, 0x201);           /* TCM, ver 01h */
+    g_assert_cmphex(v[0] & (1u << 13), ==, 1u << 13);   /* Router Detected */
+    rmw(&r, 0, CS_ADAPTER, 1, 4, 1u << 31, 0);          /* clear Lock */
+
+    /* Power-on state, then switch.c tb_switch_configure */
+    ring0_read(&r, 1, CS_ROUTER, 0, 0, 5, v);
+    g_assert_cmphex(v[0], ==, 0x15d38086);
+    g_assert_cmphex(v[1], ==, 0x0602c005);
+    g_assert_cmphex(v[4], ==, 0x0200000a);
+    v[0] = 0x0612c105;
+    v[1] = 1;
+    v[2] = 1u << 31;
+    v[3] = 0x020000ff;
+    ring0_write(&r, 1, CS_ROUTER, 0, 1, 4, v);
+    /* tb_plug_events_active(sw, true) */
+    g_assert_cmphex(rd1(&r, 1, CS_ROUTER, 0, 0x29), ==, 0x4e05);
+    wr1(&r, 1, CS_ROUTER, 0, 0x29, 0x4e01);
+    g_assert_cmphex(rd1(&r, 1, CS_ROUTER, 0, 0x29), ==, 0x4e01);
+    /* lc.c: UUID and SX_CTRL */
+    ring0_read(&r, 1, CS_ROUTER, 0, 0x102, 4, v);
+    g_assert(!memcmp(v, lc_uuid, sizeof(lc_uuid)));
+    g_assert_cmphex(rd1(&r, 1, CS_ROUTER, 0, 0x1a9), ==, 0x160);
+    wr1(&r, 1, CS_ROUTER, 0, 0x1a9, 0x40010160);
+    g_assert_cmphex(rd1(&r, 1, CS_ROUTER, 0, 0x1a9), ==, 0x40010160);
+    /* Plug events from the TB3 router (ADL-39) were acknowledged */
+    g_assert_cmpuint(r.hp, >=, 3);
+
+    /* PCIe tunnel: host PCIe Down of port 1 <-> TB3 PCIe Up (adapter 6) */
+    for (unsigned a = 3; a < 16 && !hpd; a++) {
+        uint8_t rsp[256];
+        unsigned len;
+
+        if (ring0_xfer(&r, PDF_READ, 0, CS_ADAPTER, a, 2, 1, NULL, rsp,
+                       &len) == PDF_READ &&
+            (get_be32(rsp + 12) & 0xffffff) == 0x100101) {
+            hpd = a;
+        }
+    }
+    g_assert(hpd);
+    hpcie = adp_cap(&r, 0, hpd, CAP_PROTO);
+    g_assert_cmphex(rd1(&r, 1, CS_ADAPTER, 6, 2), ==, 0x01100102);
+    path8(&r, 0, hpd, 1, 0);
+    path8(&r, 1, 1, 6, 32);
+    path8(&r, 1, 6, 1, 0);
+    path8(&r, 0, 1, hpd, 64);
+    rmw(&r, 1, CS_ADAPTER, 6, 0x39, 0, 1u << 31);
+    rmw(&r, 0, CS_ADAPTER, hpd, hpcie, 0, 1u << 31);
+    g_assert_cmphex(rd1(&r, 1, CS_ADAPTER, 6, 0x39), ==, 0xc6210400);
+
+    qtest_clock_step(qts, 300 * 1000 * 1000);           /* past settle-ms */
+    st = endpoint_state(qts, "tp0");
+    g_assert(strstr(st, "gate=open"));
+    g_free(st);
+    cfg_writel(qts, 0, 5 << 3, 0x18, 0x00010100);
+    g_assert_cmphex(cfg_readl(qts, 1, 1 << 3, 0), ==, QEMU_NVME);
+
+    /* device_del: the gate closes at once (AGENTS.md "Gate before...") */
+    qtest_qmp_assert_success(qts, "{'execute': 'device_del', 'arguments': "
+                             "{'id': 'enc0'}}");
+    st = endpoint_state(qts, "tp0");
+    g_assert(strstr(st, "gate=closed"));
+    g_free(st);
+    g_assert_cmphex(cfg_readl(qts, 1, 1 << 3, 0), ==, 0xffffffff);
+    qtest_quit(qts);
+}
+
+static void test_minimal(void)
+{
+    run_model("minimal", 0x404046f4);
+}
