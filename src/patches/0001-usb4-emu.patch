+#!/bin/sh
+# Build and run the standalone USB4 fabric test with the MSYS2 UCRT64
+# toolchain (or any gcc with glib-2.0 development files).
+#   scripts/msys2-shell.sh "/d/.../src/qemu/tests/usb4/run-fabric-test.sh"
+# Copyright (c) 2026 usb4-emu contributors. SPDX-License-Identifier: GPL-2.0-only
+set -e
+here="$(cd "$(dirname "$0")" && pwd)"
+top="$here/../.."
+out="${OUT:-$here/build}"
+mkdir -p "$out/trace"
+python3 "$here/gen-trace-stub.py" "$top/hw/usb4/trace-events" \
+    "$out/trace/trace-hw_usb4.h"
+gcc -std=gnu11 -O1 -g -Wall -Wextra -Wno-unused-parameter \
+    -Wno-sign-compare -Wno-missing-field-initializers \
+    -I"$here/stub" -I"$out" -I"$top/include" -I"$top" -I"$top/hw/usb4" \
+    $(pkg-config --cflags glib-2.0) \
+    "$here/fabric-test.c" \
+    "$top/hw/usb4/usb4-ctl.c" "$top/hw/usb4/usb4-fabric.c" \
+    "$top/hw/usb4/usb4-router.c" "$top/hw/usb4/usb4-router-tb3.c" \
+    "$top/hw/usb4/usb4-router-adl.c" "$top/hw/usb4/usb4-router-asm.c" \
+    "$top/hw/usb4/usb4-router-img.c" "$top/hw/usb4/usb4-router-asm2464.c" \
+    "$top/hw/usb4/usb4-preos.c" \
+    "$top/hw/usb4/usb4-drom.c" \
+    "$top/hw/usb4/usb4-tunnel.c" "$top/hw/usb4/usb4-fabric-usb3.c" \
+    $(pkg-config --libs glib-2.0) -o "$out/fabric-test"
+"$out/fabric-test"
diff --git a/tests/usb4/run-tb3-conformance.sh b/tests/usb4/run-tb3-conformance.sh
new file mode 100644
index 0000000000000000000000000000000000000000..94c48f2f4cf2a4e010e3a538558c237801943906
--- /dev/null
+++ b/tests/usb4/run-tb3-conformance.sh
@@ -0,0 +1,21 @@
+#!/bin/sh
+# Device router conformance check of the TB3 device router preset
+# (usb4-device dialect=tb3 on a usb4-generic host, docs/USB4-HOSTS.md 8):
+# replay the Linux software CM's requests to the host router (route 0)
+# and the CalDigit TS3 Plus (route 3) on domain 1 of the Framework 13
+# capture (tests/captures/framework13-12th/linux-ts3plus, extracted)
+# against intel-adl with a tb3 device router, and compare every answer.
+# The device router's figures are reported separately. ADL_VERBOSE /
+# ADL_TOP as for run-adl-conformance.sh; ASM_MIN_MATCH=pct fails when the
+# device router's share of matching dwords is below pct.
+#   scripts/msys2-shell.sh ".../tests/usb4/run-tb3-conformance.sh <dir>"
+# Copyright (c) 2026 usb4-emu contributors. SPDX-License-Identifier: GPL-2.0-only
+set -e
+here="$(cd "$(dirname "$0")" && pwd)"
+cap="${1:-$TB3_CAPTURE}"
+if [ -z "$cap" ]; then
+    echo "usage: $0 <extracted capture dir>" >&2
+    exit 2
+fi
+exec "$here/run-adl-conformance.sh" "$cap" --routes 0,3 --domains 1 \
+    --device-model tb3
