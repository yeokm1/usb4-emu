+static void test_overflow(void)
+{
+    T *t = t_start("pc", NULL);
+    uint32_t dw2;
+
+    rings_setup(t, 4, 4);
+    /* Shrink the RX data buffer to 16 bytes: a 20-byte frame overflows */
+    wr(t, RX_RING(0) + RING_SIZE, 4 | (16 << 16));
+    wr(t, RX_CTRL(0), RING_VALID | RING_RAW);
+    t->rx_ci = t->rx_next = 0;
+    rx_post(t, 1);
+    tx_queue(t, 0x55, 20, 1);
+    tx_doorbell(t);
+    dw2 = desc_dw2(t, t->rx_ring, 0);
+    g_assert_cmphex(dw2 & DESC_DD, ==, DESC_DD);
+    g_assert_cmphex(dw2 & (1u << 22), ==, 1u << 22);  /* Buffer Overflow */
+    g_assert_cmpuint(dw2 & 0xfff, ==, 16);
+    t_stop(t);
+}
