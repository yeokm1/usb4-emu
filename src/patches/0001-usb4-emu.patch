+/* Hook 1: hold at fetch, released by delay=; drop and override at complete. */
+static void test_hold_drop_override(void)
+{
+    g_autofree char *img = make_img();
+    Nv nv;
+    QTestState *qts;
+    uint16_t st, cid;
+    uint32_t dw0;
+
+    qts = tp_start(img, ",x-faults=\"at=fetch op=read lba=1 act=hold "
+                   "delay=500; at=complete op=read lba=8-15 act=drop; "
+                   "at=complete op=identify nth=2 status=0x6; "
+                   "at=complete op=abort dw0=1\"", "", &nv);
+    nv_bringup(&nv);
+
+    /* LBA 0 does not match the hold rule. */
+    qtest_memset(qts, RAM_BUF, SENTINEL, 512);
+    cid = nv_read(&nv, 1, 0, RAM_BUF);
+    g_assert(nv_poll(&nv, 1, cid, NULL, &st, 2000));
+    g_assert_cmphex(st, ==, 0);
+
+    /* LBA 1 is held before it executes: no data, no completion. */
+    qtest_memset(qts, RAM_BUF2, SENTINEL, 512);
+    cid = nv_read(&nv, 1, 1, RAM_BUF2);
+    g_assert(!nv_poll(&nv, 1, -1, NULL, NULL, 100));
+    g_assert(buf_is(qts, RAM_BUF2, SENTINEL));
+    g_assert(str_has(qts, TP_PATH, "x-harness-state", "held=1"));
+    /* The delay runs on the virtual clock. */
+    qtest_clock_step(qts, 499 * 1000 * 1000);
+    g_assert(!nv_poll(&nv, 1, -1, NULL, NULL, 50));
+    qtest_clock_step(qts, 2 * 1000 * 1000);
+    g_assert(nv_poll(&nv, 1, cid, NULL, &st, 2000));
+    g_assert_cmphex(st, ==, 0);
+    g_assert(buf_is(qts, RAM_BUF2, PATTERN1));
+
+    /* An overlapping range: the data moves but the completion is dropped. */
+    qtest_memset(qts, RAM_BUF, SENTINEL, 512);
+    nv_read(&nv, 1, 12, RAM_BUF);
+    g_assert(wait_buf(qts, RAM_BUF, 0));
+    g_assert(!nv_poll(&nv, 1, -1, NULL, NULL, 100));
+
+    /* Identify: the first passes, the second fails (status override). */
+    nv_admin_ok(&nv, 0x06, 0, RAM_ID, 1, 0);
+    cid = nv_submit(&nv, 0, 0x06, 0, RAM_ID, 1, 0, 0);
+    g_assert(nv_poll(&nv, 0, cid, NULL, &st, 2000));
+    g_assert_cmphex(st, ==, 0x6);
+
+    /* Abort reports "not aborted" (Dword 0 bit 0 = 1). */
+    cid = nv_submit(&nv, 0, 0x08, 0, 0, (0xffff << 16) | 1, 0, 0);
+    g_assert(nv_poll(&nv, 0, cid, &dw0, &st, 2000));
+    g_assert_cmphex(dw0 & 1, ==, 1);
+    qtest_quit(qts);
+    unlink(img);
+}
