+/*
+ * preos-cm=on: the emulated firmware CM tunnels a device attached before
+ * the OS takes over, leaves no hot plug event pending, and keeps the
+ * tunnel up across a power-on reset (docs/USB4-HOSTS.md).
+ */
+static USB4Device predev = { .serial = "PREOS01" };
+
+/* asm4242 defaults, as the usb4-host properties set them */
+#define ASM_CFG_DEFAULT { .adp_dp = 5, .adp_hi = 7, .adp_pcie = 8, \
+    .adp_usb3 = 10, .quirk_pending = true, .quirk_credits = true, \
+    .nvm_version = 0x200011, .nvm_date = 0x250708 }
+
+static void test_preos_model(USB4HostModel model)
+{
+    USB4FabricConfig cfg = {
+        .profile = USB4_PROFILE_USB4_GENERIC, .dialect = USB4_DIALECT_USB4,
+        .router_vendor_id = 0x1234, .router_device_id = 0x5678,
+        .num_usb4_ports = 2, .preos_cm = true, .host_model = model,
+        .asm4242 = ASM_CFG_DEFAULT,
+    };
+    USB4Fabric *saved = fab;
+    unsigned calls;
+
+    fab = usb4_fabric_new((USB4Host *)&fake_host, &cfg);
+    tp_state = USB4_TUNNEL_DOWN;
+    CHECK(usb4_fabric_attach(fab, 1, &predev, NULL), "preos attach");
+    CHECK(tp_state == USB4_TUNNEL_UP && tp_dev == &predev,
+          "preos: tunnel up at attach (model %d)", model);
+    CHECK(usb4_router_enumerated(fab->hr), "preos: host enumerated");
+    CHECK(fab->hr->ports[0].bonded, "preos: lanes bonded");
+    rx_flush_hp();
+    advance(100);
+    {
+        unsigned before = n_hpev;
+
+        rx_flush_hp();
+        CHECK(n_hpev == before, "preos: no hot plug event left pending");
+    }
+    calls = tp_calls;
+    usb4_fabric_reset(fab);
+    CHECK(tp_state == USB4_TUNNEL_UP && tp_calls == calls,
+          "preos: tunnel kept across power-on reset without a flap");
+    /* After the OS took over, a new device is the OS CM's business. */
+    usb4_fabric_preos_end(fab);
+    usb4_fabric_detach(fab, 1);
+    CHECK(tp_state == USB4_TUNNEL_DOWN, "preos: down on detach");
+    CHECK(usb4_fabric_attach(fab, 1, &predev, NULL), "re-attach");
+    CHECK(tp_state == USB4_TUNNEL_DOWN, "preos: OS CM in charge after end");
+    usb4_fabric_free(fab);
+    fab = saved;
+}
