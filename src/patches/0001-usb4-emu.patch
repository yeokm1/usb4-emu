+/*
+ * Several held reads released at once while a completion rule takes the
+ * tunnel down: the release drains block I/O inside the slots' lifecycle
+ * serialization, so the surprise removal runs only after it is done.
+ */
+static void test_release_vs_surprise(void)
+{
+    g_autofree char *img = make_img();
+    Nv nv;
+    QTestState *qts = tp_start(img, ",x-faults=\"at=fetch op=read act=hold "
+                               "tag=h repeat=on;at=complete op=read "
+                               "act=surprise\"", "", &nv);
+
+    nv_bringup(&nv);
+    for (int i = 0; i < 8; i++) {
+        nv_read(&nv, 1, i, RAM_BUF + i * 512);
+    }
+    g_assert_cmpuint(held_count(qts), ==, 8);
+    /*
+     * The first completion closes the gate during the release; without
+     * the serialization the removal would run nested in the release's
+     * drain and the release would go on with a freed controller.
+     */
+    qom_set_str(qts, TP_PATH, "x-release", "tag:h");
+    g_assert(str_has(qts, TP_PATH, "endpoint", "gate=closed"));
+    g_assert_cmpuint(wait_stage(qts, "removed"), ==, 1);
+    g_assert(str_has(qts, TP_PATH, "endpoint", "none"));
+    g_assert(str_has(qts, TP_PATH, "x-harness-state", "nvme=no held=0"));
+    qtest_quit(qts);
+    unlink(img);
+}
