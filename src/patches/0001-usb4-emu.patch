+/*
+ * R10 with the observed timing (ICM-PROTOCOL.md 13.3, R2): the ORICO's
+ * tunnel link is up 89 ms after the approve request, the response comes
+ * after 383 ms; a second approve meanwhile fails; an unplug before the
+ * response fails the approve.
+ */
+static void test_approve_timing(void)
+{
+    uint32_t w[64];
+    unsigned id;
+    T *t = t_start_dev(",approve-link-ms=89,approve-resp-ms=383", NULL,
+                       NULL);
+
+    icm_bind(t, w);
+    orico_add(t);
+    g_assert_cmpuint(icm_expect(t, PDF_ICM_EVENT, w), ==, 61);
+    id = (w[5] >> 8) & 0xff;
+    {
+        uint32_t cmd[6] = { 0x00000004, 0x70912700, 0x174c608e,
+                            0xffffffff, 0xffffffff, 0x10 | (id << 8) };
+
+        icm_cmd(t, cmd, 6);
+        icm_expect_none(t);
+        g_assert_false(gate_open(t->qts));
+        qtest_clock_step(t->qts, 88 * 1000 * 1000);
+        g_assert_false(gate_open(t->qts));
+        qtest_clock_step(t->qts, 2 * 1000 * 1000);
+        g_assert_true(gate_open(t->qts));
+        icm_cmd(t, cmd, 6);
+        icm_expect(t, PDF_ICM_RESP, w);
+        g_assert_cmphex(w[0], ==, 0x01000104);
+        qtest_clock_step(t->qts, 292 * 1000 * 1000);
+        icm_expect_none(t);
+        qtest_clock_step(t->qts, 2 * 1000 * 1000);
+        g_assert_cmpuint(icm_expect(t, PDF_ICM_RESP, w), ==, 6);
+        g_assert_cmphex(w[0], ==, 0x01000004);
+    }
+
+    /* unplugged while the approve is processed: the approve fails */
+    qtest_qmp_device_del_send(t->qts, "d0");
+    icm_expect(t, PDF_ICM_EVENT, w);
+    orico_add(t);
+    icm_expect(t, PDF_ICM_EVENT, w);
+    id = (w[5] >> 8) & 0xff;
+    {
+        uint32_t cmd[6] = { 0x00000004, 0x70912700, 0x174c608e,
+                            0xffffffff, 0xffffffff, 0x10 | (id << 8) };
+
+        icm_cmd(t, cmd, 6);
+        qtest_qmp_device_del_send(t->qts, "d0");
+        icm_expect(t, PDF_ICM_EVENT, w);
+        qtest_clock_step(t->qts, 400 * 1000 * 1000);
+        icm_expect(t, PDF_ICM_RESP, w);
+        g_assert_cmphex(w[0], ==, 0x01000104);
+        g_assert_false(gate_open(t->qts));
+    }
+
+    /*
+     * Unplugged and a replacement plugged in before the tunnel step: the
+     * pending approve belongs to the old connection and must neither
+     * tunnel the new device nor report success.
+     */
+    orico_add(t);
+    icm_expect(t, PDF_ICM_EVENT, w);
+    id = (w[5] >> 8) & 0xff;
+    {
+        uint32_t cmd[6] = { 0x00000004, 0x70912700, 0x174c608e,
+                            0xffffffff, 0xffffffff, 0x10 | (id << 8) };
+
+        icm_cmd(t, cmd, 6);
+        qtest_clock_step(t->qts, 10 * 1000 * 1000);
+        qtest_qmp_device_del_send(t->qts, "d0");
+        icm_expect(t, PDF_ICM_EVENT, w);
+        orico_add(t);
+        icm_expect(t, PDF_ICM_EVENT, w);
+        qtest_clock_step(t->qts, 400 * 1000 * 1000);
+        icm_expect(t, PDF_ICM_RESP, w);
+        g_assert_cmphex(w[0], ==, 0x01000104);
+        g_assert_false(gate_open(t->qts));
+        icm_expect_none(t);
+    }
+
+    /*
+     * Disconnect PCIe paths (mailbox 0x06) during the approve: the
+     * tunnel stays down, before and after the link step, and the
+     * approve fails.
+     */
+    qtest_qmp_device_del_send(t->qts, "d0");
+    icm_expect(t, PDF_ICM_EVENT, w);
+    orico_add(t);
+    icm_expect(t, PDF_ICM_EVENT, w);
+    id = (w[5] >> 8) & 0xff;
+    {
+        uint32_t cmd[6] = { 0x00000004, 0x70912700, 0x174c608e,
+                            0xffffffff, 0xffffffff, 0x10 | (id << 8) };
+
+        icm_cmd(t, cmd, 6);
+        qtest_clock_step(t->qts, 10 * 1000 * 1000);
+        g_assert_cmphex(mailbox(t, 0x06), ==, 0x06);
+        qtest_clock_step(t->qts, 100 * 1000 * 1000);
+        g_assert_false(gate_open(t->qts));
+        qtest_clock_step(t->qts, 300 * 1000 * 1000);
+        icm_expect(t, PDF_ICM_RESP, w);
+        g_assert_cmphex(w[0], ==, 0x01000104);
+        g_assert_false(gate_open(t->qts));
+
+        /* after the link step and before the response: the same */
+        cmd[0] = 0x00000004;
+        icm_cmd(t, cmd, 6);
+        qtest_clock_step(t->qts, 100 * 1000 * 1000);
+        g_assert_true(gate_open(t->qts));
+        g_assert_cmphex(mailbox(t, 0x06), ==, 0x06);
+        g_assert_false(gate_open(t->qts));
+        qtest_clock_step(t->qts, 300 * 1000 * 1000);
+        icm_expect(t, PDF_ICM_RESP, w);
+        g_assert_cmphex(w[0], ==, 0x01000104);
+        g_assert_false(gate_open(t->qts));
+    }
+    t_stop(t);
+}
