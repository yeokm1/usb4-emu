+/* ------------------------------------------------------------------ */
+/* Ring helpers                                                         */
+/* ------------------------------------------------------------------ */
+
+static inline uint64_t ring_base(USB4Ring *r)
+{
+    return ((uint64_t)r->base_hi << 32) | r->base_lo;
+}
+
+static inline bool ring_valid(USB4Ring *r)
+{
+    return (r->ctrl & RING_CTRL_VALID) && r->size;
+}
+
+static inline unsigned ring_next(USB4Ring *r, unsigned idx)
+{
+    return (idx + 1) % r->size;
+}
+
+/* RX descriptors posted by the guest and not yet used (Spec 12.4.2). */
+static unsigned rx_unused(USB4Ring *r)
+{
+    if (!r->size) {
+        return 0;
+    }
+    return (r->ci + r->size - r->pi) % r->size;
+}
+
+static void usb4_host_eval_vacancy(USB4Host *s, unsigned n)
+{
+    USB4Ring *r = &s->rx[n];
+    unsigned thr, unused;
+    bool st = false;
+
+    if (ring_valid(r)) {
+        /* Spec 12.5.1 and Table 12-36. */
+        thr = (s->vac_ctrl[n / 8] >> (4 * (n % 8))) & 0xf;
+        unused = rx_unused(r);
+        st = thr == 0 ? unused == 0 : unused <= (1u << (thr - 1));
+        if (st != r->vacancy) {
+            trace_usb4_host_vacancy(n, unused, st);
+        }
+    }
+    if (st && !r->vacancy) {
+        r->vacancy = true;
+        usb4_host_set_status(s, CAUSE_VACANCY(s, n));
+    }
+    r->vacancy = st;
+}
+
+static void usb4_host_ring_reset_indices(USB4Ring *r, const char *dir,
+                                         unsigned n, const char *why)
+{
+    r->pi = 0;
+    r->ci = 0;
+    r->frame_len = 0;
+    trace_usb4_host_ring_index_reset(dir, n, why);
+}
