+/*
+ * R8 (ICM-PROTOCOL.md 6.2, 13.5): after driver ready the firmware holds
+ * config requests while it announces attached devices, then serves
+ * them: 2.77 s at the first driver ready under BIOS Assist (R4), the
+ * ready-hold-ms value on later ones (580 ms with the dock, 6.2), at once
+ * with nothing to announce. Under Assist and pre-boot the ORICO's link
+ * is one lane (R4: flags 0x88).
+ */
+static void test_ready_hold(void)
+{
+    uint32_t w[64];
+    unsigned n;
+    T *t = t_start_assist_dev(",bios-assist=on,preboot=on",
+                              "-device usb4-device,id=d0,bus=u4.0,port=1,"
+                              "dialect=usb4,device-model=asm2464,"
+                              "drive=disk0");
+
+    icm_bind(t, w);
+    g_assert_cmphex(w[0], ==, 0x01002203);
+    host_poll_send(t);
+    qtest_clock_step(t->qts, 2700 * 1000 * 1000LL);
+    icm_expect_none(t);
+    qtest_clock_step(t->qts, 100 * 1000 * 1000LL);
+    n = icm_expect(t, PDF_ICM_EVENT, w);
+    check_connected_orico(w, n, 0x88, 0x0d11);
+    /* then the held poll is answered */
+    g_assert_cmpuint(icm_expect(t, 1, w), ==, 4);
+    g_assert_cmphex(w[3], ==, 0x15c08086);
+
+    /* a rebind: no hold by default (ready-hold-ms=0) */
+    rings_stop(t);
+    mailbox(t, 0x07);
+    icm_bind(t, w);
+    n = icm_expect(t, PDF_ICM_EVENT, w);
+    check_connected_orico(w, n, 0x88, 0x0d11);
+    t_stop(t);
+
+    /* Assist off: no first hold, the rebind hold as configured */
+    t = t_start(",ready-hold-ms=580", true);
+    icm_bind(t, w);
+    icm_expect(t, PDF_ICM_EVENT, w);
+    rings_stop(t);
+    mailbox(t, 0x07);
+    icm_bind(t, w);
+    host_poll_send(t);
+    qtest_clock_step(t->qts, 500 * 1000 * 1000LL);
+    icm_expect_none(t);
+    qtest_clock_step(t->qts, 100 * 1000 * 1000LL);
+    g_assert_cmpuint(icm_expect(t, PDF_ICM_EVENT, w), ==, 61);
+    g_assert_cmpuint(icm_expect(t, 1, w), ==, 4);
+    t_stop(t);
+
+    /* nothing to announce: answered at once (6.6) */
+    t = t_start(",first-ready-hold-ms=2770", false);
+    icm_bind(t, w);
+    host_poll_send(t);
+    g_assert_cmpuint(icm_expect(t, 1, w), ==, 4);
+    t_stop(t);
+}
