+/*
+ * intel-adl sideband reads (Spec 4.1.1.3.1): every byte the response
+ * Length advertises in PORT_CS_2-17 holds register data, none of it is
+ * left over from what the CM wrote there before.
+ */
+static void adl_sb_read(unsigned target, unsigned idx, unsigned reg,
+                        unsigned len, const uint8_t *want, unsigned wlen)
+{
+    uint32_t fill[16], c1, data[16];
+    unsigned rlen;
+
+    memset(fill, 0xaa, sizeof(fill));
+    CHECK(wr(HOST, USB4_CS_ADAPTER, 1, 0x92, 16, fill) == 0, "fill");
+    wr1(HOST, USB4_CS_ADAPTER, 1, 0x91, reg | (len << 8) | (target << 16) |
+        (idx << 20) | (1u << 31));
+    advance(5);
+    c1 = rd1(HOST, USB4_CS_ADAPTER, 1, 0x91);
+    rlen = (c1 >> 8) & 0xff;
+    CHECK(!(c1 & (3u << 25 | 1u << 31)) && rlen >= len,
+          "adl sb reg %u: c1 %08x", reg, c1);
+    rd(HOST, USB4_CS_ADAPTER, 1, 0x92, 16, data);
+    for (unsigned i = 0; i < rlen && i < 64; i++) {
+        uint8_t b = data[i / 4] >> (8 * (i % 4));
+
+        CHECK(b == (i < wlen ? want[i] : 0),
+              "adl sb tgt %u reg %u len %u: byte %u = %02x", target, reg,
+              len, i, b);
+    }
+}
+
+static void test_adl_sideband(void)
+{
+    USB4FabricConfig cfg = {
+        .profile = USB4_PROFILE_USB4_GENERIC, .dialect = USB4_DIALECT_USB4,
+        .num_usb4_ports = 2, .host_model = USB4_HOST_MODEL_INTEL_ADL,
+    };
+    static const uint8_t pid[] = { 0x3e, 0x46 }, rtpid[] = { 0xee, 0x15 };
+    USB4Fabric *saved = fab;
+
+    fab = usb4_fabric_new((USB4Host *)&fake_host, &cfg);
+    adl_sb_read(0, 0, 1, 1, pid, 2);        /* local Product ID, 1 byte */
+    adl_sb_read(0, 0, 1, 4, pid, 2);
+    CHECK(usb4_fabric_attach(fab, 1, &predev, NULL), "adl attach");
+    adl_sb_read(2, 1, 1, 1, rtpid, 2);      /* retimer Product ID */
+    usb4_fabric_free(fab);
+    fab = saved;
+}
+
+static void test_preos(void)
+{
+    test_preos_model(USB4_HOST_MODEL_MINIMAL);
+    test_preos_model(USB4_HOST_MODEL_INTEL_ADL);
+    test_preos_model(USB4_HOST_MODEL_ASM4242);
+}
