+/*
+ * qtest for usb4-device device-model=asm2464: the ASMedia ASM2464PD USB4
+ * device router of an ORICO AAGM2-U4 NVMe enclosure, reproduced from a
+ * capture (docs/captures/ORICO-ASM2464.md).
+ *
+ * Copyright (c) 2026 usb4-emu contributors
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Written from scratch for the usb4-emu project. Covers configuration
+ * checks, the router identity, DROM and router operations over ring 0
+ * through a host interface, the ASM2464's PCIe switch identity behind a
+ * q35 tunnel port, and the NVMe directly behind an i440FX tunnel bridge.
+ * Register-level behaviour (layout, images, sideband, Router Ready, the
+ * reconnect delay after a Downstream Port Reset) is in
+ * tests/usb4/fabric-test.c, and the replay of the captured Linux CM in
+ * tests/usb4/run-asm2464-conformance.sh.
+ */
+
+#include "qemu/osdep.h"
+#include "libqtest.h"
+#include "qobject/qdict.h"
+
+#define ASM2464_PORT    0x24631b21u     /* switch ports and subsystem */
+#define QEMU_NVME       0x00101b36u
+
+/* BAR0 registers, Spec 2.0 Table 12-10 */
+#define BAR0            0xe0000000u
+#define TX_RING(n)      (0x00000 + (n) * 0x10)
+#define RX_RING(n)      (0x08000 + (n) * 0x10)
+#define  RING_BASE_LO   0x0
+#define  RING_INDEX     0x8
+#define  RING_SIZE      0xc
+#define TX_CTRL(n)      (0x19800 + (n) * 0x20)
+#define RX_CTRL(n)      (0x29800 + (n) * 0x20)
+#define RING_VALID      (1u << 31)
+#define RING_RAW        (1u << 30)
+#define DESC_DD         (1u << 21)
+#define DESC_RS         (1u << 22)
+#define DESC_IE         (1u << 23)
+
+#define RING_N          8
+#define MEM_TX_RING     0x00100000u
+#define MEM_RX_RING     0x00101000u
+#define MEM_TX_BUF      0x00102000u     /* RING_N buffers of 256 bytes */
+#define MEM_RX_BUF      0x00104000u
+
+#define NHI_DEVFN       (4 << 3)
+
+/* Control packet PDFs (Spec Table 6-3) and config spaces (6.4.2.2) */
+#define PDF_READ        1
+#define PDF_WRITE       2
+#define PDF_NOTIFY      3
+#define CS_ADAPTER      1
+#define CS_ROUTER       2
+
+static uint32_t cfg_addr(int bus, int devfn, int off)
+{
+    return 0x80000000u | (bus << 16) | (devfn << 8) | (off & 0xfc);
+}
+
+static uint32_t cfg_readl(QTestState *qts, int bus, int devfn, int off)
+{
+    qtest_outl(qts, 0xcf8, cfg_addr(bus, devfn, off));
+    return qtest_inl(qts, 0xcfc);
+}
+
+static void cfg_writel(QTestState *qts, int bus, int devfn, int off,
+                       uint32_t val)
+{
+    qtest_outl(qts, 0xcf8, cfg_addr(bus, devfn, off));
+    qtest_outl(qts, 0xcfc, val);
+}
+
+static void expect_error(QDict *rsp)
+{
+    g_assert(qdict_haskey(rsp, "error"));
+    qobject_unref(rsp);
+}
+
+static void test_bad_config(void)
+{
+    QTestState *qts = qtest_init("-nodefaults -machine pc "
+                                 "-device usb4-host,id=u4,addr=04.0 "
+                                 "-device usb4-host,id=tb,addr=05.0,"
+                                 "profile=tb3-alpine-ridge");
+
+    expect_error(qtest_qmp(qts, "{'execute': 'device_add', 'arguments': "
+                           "{'driver': 'usb4-device', 'bus': 'u4.0', "
+                           "'device-model': 'asm9999'}}"));
+    expect_error(qtest_qmp(qts, "{'execute': 'device_add', 'arguments': "
+                           "{'driver': 'usb4-device', 'bus': 'u4.0', "
+                           "'device-model': 'asm2464', 'dialect': 'tb3'}}"));
+    expect_error(qtest_qmp(qts, "{'execute': 'device_add', 'arguments': "
+                           "{'driver': 'usb4-device', 'bus': 'u4.0', "
+                           "'device-model': 'asm2464', "
+                           "'downstream-ports': 1}}"));
+    expect_error(qtest_qmp(qts, "{'execute': 'device_add', 'arguments': "
+                           "{'driver': 'usb4-device', 'bus': 'u4.0', "
+                           "'device-model': 'asm2464', 'dock': true}}"));
+    /* good ones, also behind the Alpine Ridge firmware CM (P14s) */
+    qtest_qmp_assert_success(qts, "{'execute': 'device_add', 'arguments': "
+                             "{'driver': 'usb4-device', 'bus': 'u4.0', "
+                             "'id': 'enc0', 'device-model': 'asm2464'}}");
+    qtest_qmp_assert_success(qts, "{'execute': 'device_add', 'arguments': "
+                             "{'driver': 'usb4-device', 'bus': 'tb.0', "
+                             "'id': 'enc1', 'device-model': 'asm2464'}}");
+    qtest_quit(qts);
+}
+
+/* ------------------------------------------------------------------ */
+/* Ring 0 control packets                                               */
+/* ------------------------------------------------------------------ */
+
+static uint32_t crc32c(const uint8_t *p, size_t n)
+{
+    uint32_t c = 0xffffffffu;
+
+    while (n--) {
+        c ^= *p++;
+        for (int b = 0; b < 8; b++) {
+            c = (c >> 1) ^ ((c & 1) ? 0x82f63b78u : 0);
+        }
+    }
+    return c ^ 0xffffffffu;
+}
+
+static void put_be32(uint8_t *p, uint32_t v)
+{
+    p[0] = v >> 24;
+    p[1] = v >> 16;
+    p[2] = v >> 8;
+    p[3] = v;
+}
+
+static uint32_t get_be32(const uint8_t *p)
+{
+    return ((uint32_t)p[0] << 24) | (p[1] << 16) | (p[2] << 8) | p[3];
+}
+
+static void desc_write(QTestState *qts, uint64_t d, uint64_t addr,
+                       uint32_t dw2)
+{
+    qtest_writel(qts, d, (uint32_t)addr);
+    qtest_writel(qts, d + 4, addr >> 32);
+    qtest_writel(qts, d + 8, dw2);
+    qtest_writel(qts, d + 12, 0);
+}
+
+typedef struct Ring0 {
+    QTestState *qts;
+    unsigned tx, rx;        /* next descriptor */
+} Ring0;
+
+static void ring0_start(Ring0 *r, QTestState *qts)
+{
+    r->qts = qts;
+    r->tx = r->rx = 0;
+    cfg_writel(qts, 0, NHI_DEVFN, 0x10, BAR0);
+    cfg_writel(qts, 0, NHI_DEVFN, 0x04, 0x6);
+    qtest_writel(qts, BAR0 + TX_RING(0) + RING_BASE_LO, MEM_TX_RING);
+    qtest_writel(qts, BAR0 + TX_RING(0) + RING_SIZE, RING_N);
+    qtest_writel(qts, BAR0 + TX_CTRL(0), RING_VALID | RING_RAW);
+    qtest_writel(qts, BAR0 + RX_RING(0) + RING_BASE_LO, MEM_RX_RING);
+    qtest_writel(qts, BAR0 + RX_RING(0) + RING_SIZE, RING_N | (256 << 16));
+    qtest_writel(qts, BAR0 + RX_CTRL(0), RING_VALID | RING_RAW);
+}
+
+/*
+ * One request on ring 0, its first answer back. Returns the answer's PDF
+ * and fills @rsp (big-endian bytes) / *len.
+ */
+static unsigned ring0_xfer(Ring0 *r, unsigned pdf, uint64_t route,
+                           unsigned cs, unsigned adp, unsigned off,
+                           unsigned n, const uint32_t *wdata, uint8_t *rsp,
+                           unsigned *len)
+{
+    QTestState *qts = r->qts;
+    uint64_t rxd = MEM_RX_RING + 16 * r->rx, txd = MEM_TX_RING + 16 * r->tx;
+    uint64_t rxb = MEM_RX_BUF + 256 * r->rx, txb = MEM_TX_BUF + 256 * r->tx;
+    uint8_t f[256];
+    unsigned ndw = 3, flen;
+    uint32_t dw2;
+
+    desc_write(qts, rxd, rxb, DESC_RS | DESC_IE);
+    r->rx = (r->rx + 1) % RING_N;
+    qtest_writel(qts, BAR0 + RX_RING(0) + RING_INDEX, r->rx);
+
+    put_be32(f, route >> 32);
+    put_be32(f + 4, (uint32_t)route);
+    put_be32(f + 8, off | (n << 13) | (adp << 19) | (cs << 25));
+    if (pdf == PDF_WRITE) {
+        for (unsigned i = 0; i < n; i++) {
+            put_be32(f + 12 + 4 * i, wdata[i]);
+        }
+        ndw += n;
+    }
+    put_be32(f + 4 * ndw, crc32c(f, 4 * ndw));
+    flen = 4 * ndw + 4;
+    qtest_memwrite(qts, txb, f, flen);
+    desc_write(qts, txd, txb, flen | (pdf << 12) | DESC_RS);
+    r->tx = (r->tx + 1) % RING_N;
+    qtest_writel(qts, BAR0 + TX_RING(0) + RING_INDEX, r->tx << 16);
+
+    dw2 = qtest_readl(qts, rxd + 8);
+    g_assert_cmphex(dw2 & DESC_DD, ==, DESC_DD);
+    *len = dw2 & 0xfff;
+    qtest_memread(qts, rxb, rsp, *len);
+    g_assert_cmphex(get_be32(rsp + *len - 4), ==, crc32c(rsp, *len - 4));
+    return (dw2 >> 12) & 0xf;
+}
+
+static void ring0_read(Ring0 *r, uint64_t route, unsigned cs, unsigned adp,
+                       unsigned off, unsigned n, uint32_t *out)
+{
+    uint8_t rsp[256];
+    unsigned len;
+
+    g_assert_cmpuint(ring0_xfer(r, PDF_READ, route, cs, adp, off, n, NULL,
+                                rsp, &len), ==, PDF_READ);
+    g_assert_cmpuint(len, ==, 16 + 4 * n);
+    for (unsigned i = 0; i < n; i++) {
+        out[i] = get_be32(rsp + 12 + 4 * i);
+    }
+}
+
+static void ring0_write(Ring0 *r, uint64_t route, unsigned cs, unsigned adp,
+                        unsigned off, unsigned n, const uint32_t *in)
+{
+    uint8_t rsp[256];
+    unsigned len;
+
+    g_assert_cmpuint(ring0_xfer(r, PDF_WRITE, route, cs, adp, off, n, in,
+                                rsp, &len), ==, PDF_WRITE);
+}
+
+/*
+ * Ring 0 with a minimal host and the asm2464 on USB4 port 1 (route 1):
+ * identity, adapter types, the DROM through DROM Read, Buffer Allocation
+ * and NVM Sector Size as captured.
+ */
+static void test_ring0(void)
+{
+    QTestState *qts = qtest_init("-nodefaults -machine pc "
+                                 "-device usb4-host,id=u4,addr=04.0 "
+                                 "-device usb4-device,id=enc0,bus=u4.0,"
+                                 "port=1,device-model=asm2464");
+    static const uint8_t drom[] = {
+        0x5e, 0x00, 0x27, 0x91, 0x70, 0x8e, 0x60, 0x4c, 0x17, 0x38, 0x4a,
+        0xab, 0xda, 0x01, 0x49, 0x00, 0xb8, 0x00, 0x63, 0x24, 0xe3, 0x02,
+    };
+    uint32_t v[18];
+    Ring0 r;
+
+    ring0_start(&r, qts);
+    /* Clear Lock on the host's lane adapter 1 (Guide 3.2.1) */
+    ring0_read(&r, 0, CS_ADAPTER, 1, 4, 1, v);
+    v[0] &= ~(1u << 31);
+    ring0_write(&r, 0, CS_ADAPTER, 1, 4, 1, v);
+
+    ring0_read(&r, 1, CS_ROUTER, 0, 0, 9, v);
+    g_assert_cmphex(v[0], ==, 0x2463174c);              /* 174c:2463 */
+    g_assert_cmphex(v[1], ==, 0x000101c0);              /* Max Adapter 4 */
+    g_assert_cmphex(v[4], ==, 0x2000000a);
+    g_assert_cmphex(v[7], ==, 0x174c608e);              /* UID */
+    g_assert_cmphex(v[8], ==, 0x70912700);
+    ring0_read(&r, 1, CS_ROUTER, 0, 0xc0, 1, v);
+    g_assert_cmphex(v[0], ==, 0x43200328);              /* TMU at 0xc0 */
+
+    /* Enumerate (route 1, depth 1) */
+    v[0] = 0x001101c0;
+    v[1] = 1;
+    v[2] = 1u << 31;
+    v[3] = 0x2000100a;
+    ring0_write(&r, 1, CS_ROUTER, 0, 1, 4, v);
+    ring0_read(&r, 1, CS_ADAPTER, 3, 0, 3, v);
+    g_assert_cmphex(v[0], ==, 0);                       /* ADP_CS_0 */
+    g_assert_cmphex(v[2], ==, 0x01100102);              /* PCIe Up */
+    ring0_read(&r, 1, CS_ADAPTER, 3, 9, 1, v);
+    g_assert_cmphex(v[0], ==, 0x000e0400);
+
+    /* DROM Read, 16 dwords at 0 (Spec 8.3.1.2.3) */
+    memset(v, 0, sizeof(v));
+    v[16] = 0x00080000;
+    v[17] = 0x80000024;
+    ring0_write(&r, 1, CS_ROUTER, 0, 9, 18, v);
+    ring0_read(&r, 1, CS_ROUTER, 0, 9, 18, v);
+    g_assert_cmphex(v[17], ==, 0x00000024);
+    for (unsigned i = 0; i < sizeof(drom); i++) {
+        g_assert_cmphex((v[i / 4] >> (8 * (i % 4))) & 0xff, ==, drom[i]);
+    }
+    /* Buffer Allocation Request: PCIe 64 */
+    v[16] = 0;
+    v[17] = 0x80000033;
+    ring0_write(&r, 1, CS_ROUTER, 0, 25, 2, v + 16);
+    ring0_read(&r, 1, CS_ROUTER, 0, 9, 18, v);
+    g_assert_cmphex(v[16], ==, 1);
+    g_assert_cmphex(v[0], ==, 0x00400004);
+    /* NVM Sector Size: status 2 */
+    v[17] = 0x80000025;
+    ring0_write(&r, 1, CS_ROUTER, 0, 26, 1, v + 17);
+    ring0_read(&r, 1, CS_ROUTER, 0, 26, 1, v);
+    g_assert_cmphex(v[0], ==, 0x02000025);
+    qtest_quit(qts);
+}
+
+/* ------------------------------------------------------------------ */
+/* PCI side                                                             */
+/* ------------------------------------------------------------------ */
+
+static char *endpoint_state(QTestState *qts, const char *id)
+{
+    g_autofree char *path = g_strdup_printf("/machine/peripheral/%s", id);
+    QDict *rsp = qtest_qmp(qts, "{'execute': 'qom-get', 'arguments': "
+                           "{'path': %s, 'property': 'endpoint'}}", path);
+    char *s = g_strdup(qdict_get_str(rsp, "return"));
+
+    qobject_unref(rsp);
+    return s;
+}
+
+/* Offset of the PCI Express capability (ID 0x10), 0 if none */
+static int exp_cap(QTestState *qts, int bus, int devfn)
+{
+    int pos = cfg_readl(qts, bus, devfn, 0x34) & 0xfc;
+
+    while (pos && (cfg_readl(qts, bus, devfn, pos) & 0xff) != 0x10) {
+        pos = (cfg_readl(qts, bus, devfn, pos) >> 8) & 0xfc;
+    }
+    return pos;
+}
+
+/* Subsystem IDs from the Subsystem ID capability (ID 0x0d) */
+static uint32_t ssvid(QTestState *qts, int bus, int devfn)
+{
+    int pos = cfg_readl(qts, bus, devfn, 0x34) & 0xfc;
+
+    while (pos) {
+        uint32_t hdr = cfg_readl(qts, bus, devfn, pos);
+
+        if ((hdr & 0xff) == 0x0d) {
+            return cfg_readl(qts, bus, devfn, pos + 4);
+        }
+        pos = (hdr >> 8) & 0xfc;
+    }
+    return 0;
+}
+
+/*
+ * q35, pre-OS CM tunnel: tunnel port (bus 0 dev 3) -> ASM2464 upstream
+ * port 1b21:2463 (bus 1) -> downstream port 1b21:2463 (bus 2, no
+ * hot-plug) -> NVMe (bus 3), as on the real enclosure.
+ */
+static void test_switch_q35(void)
+{
+    QTestState *qts = qtest_init(
+        "-nodefaults -machine q35 -global ICH9-LPC.acpi-pci-hotplug-with-"
+        "bridge-support=off -drive if=none,id=disk0,file=null-co://,"
+        "format=raw "
+        "-device usb4-tunnel-port,id=tp0,bus=pcie.0,addr=0x3,chassis=1,"
+        "settle-ms=200 "
+        "-device usb4-host,id=u4,bus=pcie.0,addr=0x4,tunnel-port=tp0,"
+        "host-model=intel-adl,preos-cm=on "
+        "-device usb4-device,id=enc0,bus=u4.0,port=1,drive=disk0,"
+        "serial=QTORICO,device-model=asm2464");
+    g_autofree char *st = endpoint_state(qts, "tp0");
+    int pos;
+
+    g_assert(strstr(st, "gate=open"));
+    cfg_writel(qts, 0, 3 << 3, 0x18, 0x00030100);
+    g_assert_cmphex(cfg_readl(qts, 1, 0, 0), ==, ASM2464_PORT);
+    g_assert_cmphex(cfg_readl(qts, 1, 0, 0x08), ==, 0x06040000);  /* rev 0 */
+    g_assert_cmphex(ssvid(qts, 1, 0), ==, ASM2464_PORT);
+    cfg_writel(qts, 1, 0, 0x18, 0x00030201);
+    g_assert_cmphex(cfg_readl(qts, 2, 0, 0), ==, ASM2464_PORT);
+    g_assert_cmphex(ssvid(qts, 2, 0), ==, ASM2464_PORT);
+    /* Downstream port: Slot Capabilities without Hot-Plug Capable */
+    pos = cfg_readl(qts, 2, 0, 0x34) & 0xfc;
+    while (pos && (cfg_readl(qts, 2, 0, pos) & 0xff) != 0x10) {
+        pos = (cfg_readl(qts, 2, 0, pos) >> 8) & 0xfc;
+    }
+    g_assert(pos);
+    g_assert_cmphex(cfg_readl(qts, 2, 0, pos + 0x14) & (1u << 6), ==, 0);
+    g_assert_cmphex(cfg_readl(qts, 2, 1 << 3, 0), ==, 0xffffffff);
+    cfg_writel(qts, 2, 0, 0x18, 0x00030302);
+    g_assert_cmphex(cfg_readl(qts, 3, 0, 0), ==, QEMU_NVME);
+
+    /*
+     * Link registers as captured (P14s R2/R4 06:00.0, 07:00.0, 08:00.0):
+     * Link Capabilities, Link Status (high half of +0x10), Link
+     * Capabilities 2, Link Control 2 and Status 2.
+     */
+    pos = exp_cap(qts, 1, 0);
+    g_assert_cmphex(cfg_readl(qts, 1, 0, pos + 0x0c), ==, 0x01436811);
+    g_assert_cmphex(cfg_readl(qts, 1, 0, pos + 0x10) >> 16, ==, 0x1011);
+    g_assert_cmphex(cfg_readl(qts, 1, 0, pos + 0x2c), ==, 0x018f1e1e);
+    g_assert_cmphex(cfg_readl(qts, 1, 0, pos + 0x30), ==, 0x00010004);
+    pos = exp_cap(qts, 2, 0);
+    g_assert_cmphex(cfg_readl(qts, 2, 0, pos + 0x0c), ==, 0x007b6844);
+    /* 8 GT/s x2 from the endpoint, Slot Clock, DL Link Active */
+    g_assert_cmphex(cfg_readl(qts, 2, 0, pos + 0x10) >> 16, ==, 0x3023);
+    g_assert_cmphex(cfg_readl(qts, 2, 0, pos + 0x2c), ==, 0x018f1e1e);
+    g_assert_cmphex(cfg_readl(qts, 2, 0, pos + 0x30), ==, 0x001f0004);
+    pos = exp_cap(qts, 3, 0);
+    g_assert_cmphex(cfg_readl(qts, 3, 0, pos + 0x0c), ==, 0x00476843);
+    g_assert_cmphex(cfg_readl(qts, 3, 0, pos + 0x10) >> 16, ==, 0x1023);
+    g_assert_cmphex(cfg_readl(qts, 3, 0, pos + 0x2c), ==, 0x0000000e);
+    g_assert_cmphex(cfg_readl(qts, 3, 0, pos + 0x30), ==, 0x001e0003);
+    qtest_quit(qts);
+}
+
+/*
+ * i440FX: no PCIe switch on a conventional tunnel bridge; the NVMe sits
+ * in SHPC slot 1 behind it, as for every other device router.
+ */
+static void test_bridge_pc(void)
+{
+    QTestState *qts = qtest_init(
+        "-nodefaults -machine pc -global PIIX4_PM.acpi-pci-hotplug-with-"
+        "bridge-support=off -drive if=none,id=disk0,file=null-co://,"
+        "format=raw "
+        "-device usb4-tunnel-bridge,id=tp0,bus=pci.0,addr=0x5,chassis_nr=1,"
+        "shpc-autoenable=on,msi=off,settle-ms=200 "
+        "-device usb4-host,id=u4,bus=pci.0,addr=0x4,tunnel-port=tp0,"
+        "preos-cm=on,msi=off,msix=off "
+        "-device usb4-device,id=enc0,bus=u4.0,port=1,drive=disk0,"
+        "serial=QTORICO,device-model=asm2464");
+    g_autofree char *st = endpoint_state(qts, "tp0");
+
+    g_assert(strstr(st, "gate=open"));
+    cfg_writel(qts, 0, 5 << 3, 0x18, 0x00010100);
+    g_assert_cmphex(cfg_readl(qts, 1, 1 << 3, 0), ==, QEMU_NVME);
+    qtest_quit(qts);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    qtest_add_func("/usb4-asm2464/bad-config", test_bad_config);
+    qtest_add_func("/usb4-asm2464/ring0", test_ring0);
+    qtest_add_func("/usb4-asm2464/switch-q35", test_switch_q35);
+    qtest_add_func("/usb4-asm2464/bridge-pc", test_bridge_pc);
+    return g_test_run();
+}
