+/* Capability @id of the endpoint at 01:00.0. */
+static int ep_cap(QTestState *qts, int id)
+{
+    int pos = cfg_readl(qts, 1, 0, 0x34) & 0xfc;
+
+    while (pos) {
+        uint32_t hdr = cfg_readl(qts, 1, 0, pos);
+
+        if ((hdr & 0xff) == id) {
+            return pos;
+        }
+        pos = (hdr >> 8) & 0xfc;
+    }
+    g_assert_not_reached();
+}
+
+/* Map the endpoint's BAR0 at WIN_MEM again (after a reset cleared it). */
+static void ep_map(QTestState *qts)
+{
+    cfg_writel(qts, 1, 0, 0x10, (uint32_t)WIN_MEM);
+    cfg_writel(qts, 1, 0, 0x14, WIN_MEM >> 32);
+    cfg_writel(qts, 1, 0, 0x04, 0x0006);
+}
+
+/* Function Level Reset of the endpoint, then map BAR0 again. */
+static void ep_flr(QTestState *qts)
+{
+    int devctl = ep_cap(qts, 0x10) + 8;
+    uint32_t v = cfg_readl(qts, 1, 0, devctl);
+
+    cfg_writel(qts, 1, 0, devctl, v | (1 << 15));     /* Initiate FLR */
+    ep_map(qts);
+}
+
+/* Held commands in x-harness-state ("held=N"). */
+static unsigned held_count(QTestState *qts)
+{
+    g_autofree char *s = qom_get_str(qts, TP_PATH, "x-harness-state");
+    const char *p = strstr(s, "held="), *end;
+    unsigned long n;
+
+    g_assert(p);
+    g_assert(!qemu_strtoul(p + 5, &end, 10, &n));
+    return n;
+}
