+/* ---- the all-ones regions are fallback decoders ---- */
+
+#define SIB_DEVFN   (6 << 3)        /* pci-testdev on the primary bus */
+#define BR1_DEVFN   (7 << 3)        /* another pci-bridge, secondary bus 2 */
+#define SHPC_BAR    0xe0000000ull   /* tb0's own BAR0 (SHPC registers) */
+#define SIB_MEM     0xe0010000ull
+#define SIB_IO      0xc100
+#define BR1_MEM     0xe0100000ull   /* br1 window 0xe0100000-0xe01fffff */
+#define BR1_IO      0xd000          /* br1 window 0xd000-0xdfff */
+#define PIC1_IMR    0x21
+
+#define TESTDEV_ARGS \
+    "-device pci-testdev,bus=pci.0,addr=0x6,membar=4096,membar-backed=on " \
+    "-device pci-bridge,id=br1,bus=pci.0,addr=0x7,chassis_nr=2,shpc=off," \
+    "msi=off " \
+    "-device pci-testdev,bus=br1,addr=0x1,membar=4096,membar-backed=on"
+
+/* pci-testdev: I/O BAR1 at @io, RAM-backed 64-bit BAR2 at @mem. */
+static void testdev_map(QTestState *qts, int bus, int devfn, uint64_t mem,
+                        uint16_t io)
+{
+    cfg_writel(qts, bus, devfn, 0x14, io);
+    cfg_writel(qts, bus, devfn, 0x18, mem);
+    cfg_writel(qts, bus, devfn, 0x1c, mem >> 32);
+    cfg_writel(qts, bus, devfn, 0x04, 0x0003);
+}
+
+/*
+ * Every legitimate decoder under tb0's closed windows answers for
+ * itself: tb0's own SHPC BAR at @shpc_bar (whose NSLOTS dword is
+ * @shpc), the sibling device's BARs, and the device behind br1's
+ * windows. pci-testdev's I/O BAR reads 0, unlike the all-ones region.
+ */
+static void check_decoders(QTestState *qts, uint64_t shpc_bar,
+                           uint32_t shpc)
+{
+    g_assert_cmphex(qtest_readl(qts, shpc_bar + 0x0c), ==, shpc);
+    g_assert_cmphex(qtest_readl(qts, SIB_MEM), ==, 0x11223344);
+    g_assert_cmphex(qtest_readl(qts, BR1_MEM), ==, 0x55667788);
+    g_assert_cmphex(qtest_inl(qts, SIB_IO), ==, 0);
+    g_assert_cmphex(qtest_inl(qts, BR1_IO), ==, 0);
+}
+
+/*
+ * A closed window that overlaps other decoders on the primary bus (a
+ * guest mistake, or a window being reprogrammed) must not shadow them:
+ * the all-ones regions only claim what nobody else decodes, in either
+ * programming order. Otherwise the bridge's own registers and legacy
+ * ports (PIC, CF8/CFC) vanish and the guest cannot even fix the window.
+ */
+static void test_bridge_ones_fallback(void)
+{
+    g_autofree char *img = make_img();
+    QTestState *qts = tb_start_extra(img, false, TESTDEV_ARGS);
+    uint32_t shpc, id;
+
+    /* The decoders first. */
+    cfg_writel(qts, 0, TB_DEVFN, 0x10, SHPC_BAR);
+    cfg_writel(qts, 0, TB_DEVFN, 0x14, 0);
+    cfg_writel(qts, 0, TB_DEVFN, 0x04, 0x0002);
+    shpc = qtest_readl(qts, SHPC_BAR + 0x0c);
+    g_assert_cmphex(shpc, !=, 0);
+    g_assert_cmphex(shpc, !=, 0xffffffff);
+    testdev_map(qts, 0, SIB_DEVFN, SIB_MEM, SIB_IO);
+    cfg_writel(qts, 0, BR1_DEVFN, 0x18, 0x00020200);
+    cfg_writel(qts, 0, BR1_DEVFN, 0x20, 0xe010e010);
+    cfg_writel(qts, 0, BR1_DEVFN, 0x1c, 0xd0d0);
+    cfg_writel(qts, 0, BR1_DEVFN, 0x04, 0x0007);
+    testdev_map(qts, 2, 1 << 3, BR1_MEM, BR1_IO);
+    qtest_writel(qts, SIB_MEM, 0x11223344);
+    qtest_writel(qts, BR1_MEM, 0x55667788);
+    check_decoders(qts, SHPC_BAR, shpc);
+
+    /*
+     * Then tb0's windows (gate closed, slot never enabled) over all of
+     * them: memory 0xe0000000-0xe01fffff, I/O 0xc000-0xdfff.
+     */
+    cfg_writel(qts, 0, TB_DEVFN, 0x20, 0xe010e000);
+    cfg_writel(qts, 0, TB_DEVFN, 0x1c, 0xd0c0);
+    cfg_writel(qts, 0, TB_DEVFN, 0x04, 0x0007);
+    g_assert(mtree_enabled(qts, "usb4-tunnel-gate-ones-mem",
+                           "00000000e0000000-00000000e01fffff"));
+    g_assert(mtree_enabled(qts, "usb4-tunnel-gate-ones-io",
+                           "000000000000c000-000000000000dfff"));
+    check_decoders(qts, SHPC_BAR, shpc);
+    /* What nobody else decodes still aborts. */
+    assert_all_ones(qts, SHPC_BAR + 0x20000);
+    assert_io_all_ones(qts, 0xc800);
+    /* Writes reach the decoders too. */
+    qtest_writel(qts, SIB_MEM + 4, 0x99aabbcc);
+    g_assert_cmphex(qtest_readl(qts, SIB_MEM + 4), ==, 0x99aabbcc);
+
+    /* The other order: decoders enabled or moved under the windows. */
+    cfg_writel(qts, 0, SIB_DEVFN, 0x04, 0);
+    assert_all_ones(qts, SIB_MEM);
+    cfg_writel(qts, 0, SIB_DEVFN, 0x04, 0x0003);
+    cfg_writel(qts, 0, BR1_DEVFN, 0x04, 0);
+    assert_all_ones(qts, BR1_MEM);
+    cfg_writel(qts, 0, BR1_DEVFN, 0x04, 0x0007);
+    cfg_writel(qts, 0, TB_DEVFN, 0x10, SHPC_BAR + 0x30000);
+    assert_all_ones(qts, SHPC_BAR);
+    check_decoders(qts, SHPC_BAR + 0x30000, shpc);
+
+    /*
+     * Legacy I/O: a closed I/O window over 0x0000-0x0fff leaves the PIC
+     * and the configuration ports alone, so the guest can still read
+     * and reprogram the bridge.
+     */
+    id = cfg_readl(qts, 0, TB_DEVFN, 0);
+    cfg_writel(qts, 0, TB_DEVFN, 0x1c, 0x0000);
+    g_assert(mtree_enabled(qts, "usb4-tunnel-gate-ones-io",
+                           "0000000000000000-0000000000000fff"));
+    qtest_outb(qts, PIC1_IMR, 0x5a);
+    g_assert_cmphex(qtest_inb(qts, PIC1_IMR), ==, 0x5a);
+    qtest_outb(qts, PIC1_IMR, 0xa5);
+    g_assert_cmphex(qtest_inb(qts, PIC1_IMR), ==, 0xa5);
+    g_assert_cmphex(cfg_readl(qts, 0, TB_DEVFN, 0), ==, id);
+    cfg_writel(qts, 0, TB_DEVFN, 0x1c, WIN_IO_REG);
+    g_assert_cmphex(cfg_readl(qts, 0, TB_DEVFN, 0x1c) & 0xffff, ==,
+                    WIN_IO_REG);
+    g_assert(mtree_enabled(qts, "usb4-tunnel-gate-ones-io", MTREE_IO_WIN));
+
+    qtest_quit(qts);
+    unlink(img);
+}
+
+/* The same on q35 under a closed usb4-tunnel-port. */
+static void test_port_ones_fallback(void)
+{
+    g_autofree char *img = make_img();
+    QTestState *qts;
+    uint32_t id;
+
+    qts = qtest_initf("-machine q35 "
+                      "-global ICH9-LPC.acpi-pci-hotplug-with-bridge-support=off "
+                      "-drive if=none,id=disk0,file=%s,format=raw "
+                      "-device usb4-tunnel-port,id=tp0,bus=pcie.0,addr=0x3,"
+                      "chassis=1,nvme-drive=disk0,nvme-serial=QT1 "
+                      "-device pci-testdev,bus=pcie.0,addr=0x6,membar=4096,"
+                      "membar-backed=on", img);
+    cfg_writel(qts, 0, TP_DEVFN, 0x18, 0x00010100);
+
+    /* Window first, then the sibling's BARs under it. */
+    bridge_windows(qts, 0, TP_DEVFN, WIN_MEM_REG);
+    assert_all_ones(qts, SIB_MEM);
+    testdev_map(qts, 0, SIB_DEVFN, SIB_MEM, SIB_IO);
+    qtest_writel(qts, SIB_MEM, 0x11223344);
+    g_assert_cmphex(qtest_readl(qts, SIB_MEM), ==, 0x11223344);
+    g_assert_cmphex(qtest_inl(qts, SIB_IO), ==, 0);
+    assert_all_ones(qts, SIB_MEM + 0x1000);
+
+    /* Legacy I/O and the configuration ports. */
+    id = cfg_readl(qts, 0, TP_DEVFN, 0);
+    cfg_writel(qts, 0, TP_DEVFN, 0x1c, 0x0000);
+    g_assert(mtree_enabled(qts, "usb4-tunnel-gate-ones-io",
+                           "0000000000000000-0000000000000fff"));
+    qtest_outb(qts, PIC1_IMR, 0x5a);
+    g_assert_cmphex(qtest_inb(qts, PIC1_IMR), ==, 0x5a);
+    g_assert_cmphex(cfg_readl(qts, 0, TP_DEVFN, 0), ==, id);
+    cfg_writel(qts, 0, TP_DEVFN, 0x1c, WIN_IO_REG);
+    g_assert_cmphex(cfg_readl(qts, 0, TP_DEVFN, 0x1c) & 0xffff, ==,
+                    WIN_IO_REG);
+
+    qtest_quit(qts);
+    unlink(img);
+}
+
+/* ---- reset rebuilds the window mappings ---- */
+
+#define MTREE_ALIAS_MEM "alias pci_bridge_mem"
+
+/* Nothing of the bridge's old windows survives a reset. */
+static void assert_windows_gone(QTestState *qts)
+{
+    g_assert(!mtree_enabled(qts, "usb4-tunnel-gate-ones-mem", NULL));
+    g_assert(!mtree_enabled(qts, "usb4-tunnel-gate-ones-io", NULL));
+    g_assert(!mtree_line(qts, MTREE_MEM_WIN, MTREE_ALIAS_MEM));
+    /* Unassigned memory: zeroes, not all-ones. */
+    g_assert_cmphex(qtest_readl(qts, WIN_MEM + NVME_CSTS), ==, 0);
+    g_assert(!flat_routes(qts, "I/O", WIN_IO, "usb4-tunnel-gate-ones-io"));
+}
+
+/*
+ * Machine reset clears the bridge's command register and windows. The
+ * mappings follow at once, with the gate closed (no stale all-ones) and
+ * open (no stale forwarding alias), before any later config write.
+ */
+static void test_port_reset_windows(void)
+{
+    g_autofree char *img = make_img();
+    QTestState *qts;
+
+    qts = qtest_initf("-machine q35 "
+                      "-global ICH9-LPC.acpi-pci-hotplug-with-bridge-support=off "
+                      "-drive if=none,id=disk0,file=%s,format=raw "
+                      "-device usb4-tunnel-port,id=tp0,bus=pcie.0,addr=0x3,"
+                      "chassis=1,nvme-drive=disk0,nvme-serial=QT1,"
+                      "settle-ms=200", img);
+
+    /* Closed. */
+    cfg_writel(qts, 0, TP_DEVFN, 0x18, 0x00010100);
+    bridge_windows(qts, 0, TP_DEVFN, WIN_MEM_REG);
+    g_assert(mtree_enabled(qts, "usb4-tunnel-gate-ones-mem", MTREE_MEM_WIN));
+    assert_all_ones(qts, WIN_MEM);
+    qtest_system_reset(qts);
+    assert_windows_gone(qts);
+
+    /* Open. */
+    cfg_writel(qts, 0, TP_DEVFN, 0x18, 0x00010100);
+    cfg_writel(qts, 0, TP_DEVFN, find_exp_cap(qts) + 0x18, 0x0100);
+    set_tunnel(qts, "up");
+    g_assert_cmpuint(wait_stage(qts, "inserted"), ==, 1);
+    bridge_windows(qts, 0, TP_DEVFN, WIN_MEM_REG);
+    nvme_map(qts, 1, 0, WIN_MEM);
+    g_assert_cmphex(qtest_readl(qts, WIN_MEM + NVME_CSTS), ==, 0);
+    g_assert(mtree_line(qts, MTREE_MEM_WIN, MTREE_ALIAS_MEM));
+    qtest_system_reset(qts);
+    assert_windows_gone(qts);
+
+    qtest_quit(qts);
+    unlink(img);
+}
+
+/* The same for the i440FX tunnel bridge (SHPC reset closes the slot). */
+static void test_bridge_reset_windows(void)
+{
+    g_autofree char *img = make_img();
+    QTestState *qts = tb_start(img, true);
+
+    /* Closed. */
+    bridge_windows(qts, 0, TB_DEVFN, WIN_MEM_REG);
+    assert_all_ones(qts, WIN_MEM);
+    qtest_system_reset(qts);
+    assert_windows_gone(qts);
+
+    /* Open: slot autoenabled on insertion. */
+    cfg_writel(qts, 0, TB_DEVFN, 0x18, 0x00010100);
+    tb_set_tunnel(qts, "up");
+    g_assert_cmpuint(wait_stage(qts, "inserted"), ==, 1);
+    bridge_windows(qts, 0, TB_DEVFN, WIN_MEM_REG);
+    nvme_map(qts, 1, EP_DEVFN, WIN_MEM);
+    g_assert_cmphex(qtest_readl(qts, WIN_MEM + NVME_CSTS), ==, 0);
+    g_assert(mtree_line(qts, MTREE_MEM_WIN, MTREE_ALIAS_MEM));
+    qtest_system_reset(qts);
+    assert_windows_gone(qts);
+
+    qtest_quit(qts);
+    unlink(img);
+}
