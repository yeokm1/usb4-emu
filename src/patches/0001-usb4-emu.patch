+static char *endpoint_state(QTestState *qts)
+{
+    QDict *rsp = qtest_qmp(qts, "{'execute': 'qom-get', 'arguments': "
+                           "{'path': %s, 'property': 'endpoint'}}", TP_PATH);
+    char *s = g_strdup(qdict_get_str(rsp, "return"));
