+/* T3-T6, R10, R22: a device on port 1 at security level user */
+static void test_device_user(void)
+{
+    uint32_t w[64], uuid[4], v;
+    unsigned n, id, id2;
+    T *t = t_start(NULL, true);
+
+    icm_bind(t, w);
+    n = icm_expect(t, PDF_ICM_EVENT, w);
+    id = check_connected(w, n, 1, 0x0811, uuid);
+    icm_expect_none(t);
+    g_assert_false(gate_open(t->qts));
+
+    /* the client reads the router at the event's route, no get route */
+    g_assert_cmpuint(cfg_read(t, 1, 2, 0, 0, &v), ==, PDF_READ);
+    g_assert_cmphex(v, ==, 0x15d38086);
+
+    /* T6: wrong route or stale id fails, nothing changes */
+    approve(t, uuid, 3, id, w);
+    g_assert_cmphex(w[0], ==, 0x01000104);
+    approve(t, uuid, 1, id + 1, w);
+    g_assert_cmphex(w[0], ==, 0x01000104);
+    g_assert_false(gate_open(t->qts));
+
+    /* approve brings the tunnel up before the response */
+    approve(t, uuid, 1, id, w);
+    g_assert_cmphex(w[0], ==, 0x01000004);
+    g_assert_true(gate_open(t->qts));
+    approve(t, uuid, 1, id, w);
+    g_assert_cmphex(w[0], ==, 0x01000004);
+
+    /* driver unloads, rebind re-announces approved, tunnel kept */
+    rings_stop(t);
+    g_assert_cmphex(mailbox(t, 0x07), ==, 0x07);
+    icm_bind(t, w);
+    n = icm_expect(t, PDF_ICM_EVENT, w);
+    id2 = check_connected(w, n, 1, 0x0911, uuid);
+    g_assert_cmpuint(id2, !=, id);
+    g_assert_true(gate_open(t->qts));
+
+    /* mailbox 0x06 closes the gate synchronously (R3, R22) */
+    g_assert_cmphex(mailbox(t, 0x06), ==, 0x06);
+    g_assert_false(gate_open(t->qts));
+
+    /* T5: device disconnected carries the route string */
+    qtest_qmp_device_del_send(t->qts, "d0");
+    n = icm_expect(t, PDF_ICM_EVENT, w);
+    g_assert_cmpuint(n, ==, 3);
+    g_assert_cmphex(w[0], ==, 0x01000004);
+    g_assert_cmphex(w[1], ==, 0);
+    g_assert_cmphex(w[2], ==, 1);
+    t_stop(t);
+}
