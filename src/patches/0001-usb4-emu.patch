+/*
+ * The slot opens a (replacement) endpoint after its settle time
+ * (ARCHITECTURE.md 4.4), so advance the virtual clock until it does.
+ */
+static bool gate_opens(QTestState *qts)
+{
+    for (int i = 0; i < 50; i++) {
+        if (gate_open(qts)) {
+            return true;
+        }
+        qtest_clock_step(qts, 100 * 1000 * 1000);
+    }
+    return false;
+}
