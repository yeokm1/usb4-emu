+static uint32_t crc32c(const uint8_t *p, size_t n)
+{
+    uint32_t c = 0xffffffffu;
+
+    while (n--) {
+        c ^= *p++;
+        for (int b = 0; b < 8; b++) {
+            c = (c >> 1) ^ ((c & 1) ? 0x82f63b78u : 0);
+        }
+    }
+    return c ^ 0xffffffffu;
+}
+
+static void put_be32(uint8_t *p, uint32_t v)
+{
+    p[0] = v >> 24;
+    p[1] = v >> 16;
+    p[2] = v >> 8;
+    p[3] = v;
+}
+
+static uint32_t get_be32(const uint8_t *p)
+{
+    return ((uint32_t)p[0] << 24) | (p[1] << 16) | (p[2] << 8) | p[3];
+}
+
+static void desc_write(QTestState *qts, uint64_t d, uint64_t addr,
+                       uint32_t dw2)
+{
+    qtest_writel(qts, d, (uint32_t)addr);
+    qtest_writel(qts, d + 4, addr >> 32);
+    qtest_writel(qts, d + 8, dw2);
+    qtest_writel(qts, d + 12, 0);
+}
+
+/*
+ * Read Router CS dwords 0-1 of the host router (route 0) over ring 0
+ * (Spec 6.4.2, raw mode Spec 12.1) and check the identity 174c:2428.
+ */
+static void test_ring0_router_id(void)
+{
+    QTestState *qts = nhi_start("pc", "");
+    uint8_t f[16], r[64];
+    uint32_t dw2;
+
+    /* rings of 4 descriptors, RX buffers of 256 bytes */
+    qtest_writel(qts, BAR0 + TX_RING(0) + RING_BASE_LO, MEM_TX_RING);
+    qtest_writel(qts, BAR0 + TX_RING(0) + RING_SIZE, 4);
+    qtest_writel(qts, BAR0 + TX_CTRL(0), RING_VALID | RING_RAW);
+    qtest_writel(qts, BAR0 + RX_RING(0) + RING_BASE_LO, MEM_RX_RING);
+    qtest_writel(qts, BAR0 + RX_RING(0) + RING_SIZE, 4 | (256 << 16));
+    qtest_writel(qts, BAR0 + RX_CTRL(0), RING_VALID | RING_RAW);
+    desc_write(qts, MEM_RX_RING, MEM_RX_BUF, DESC_RS | DESC_IE);
+    qtest_writel(qts, BAR0 + RX_RING(0) + RING_INDEX, 1);
+
+    /* Read Request: route 0, Router CS, address 0, 2 dwords, seq 1 */
+    put_be32(f, 0);
+    put_be32(f + 4, 0);
+    put_be32(f + 8, (2 << 13) | (2 << 25) | (1 << 27));
+    put_be32(f + 12, crc32c(f, 12));
+    qtest_memwrite(qts, MEM_TX_BUF, f, sizeof(f));
+    desc_write(qts, MEM_TX_RING, MEM_TX_BUF, 16 | (1 << 12) | DESC_RS);
+    qtest_writel(qts, BAR0 + TX_RING(0) + RING_INDEX, 1 << 16);
+
+    dw2 = qtest_readl(qts, MEM_RX_RING + 8);
+    g_assert_cmphex(dw2 & DESC_DD, ==, DESC_DD);
+    g_assert_cmpuint((dw2 >> 12) & 0xf, ==, 1);      /* Read Response */
+    g_assert_cmpuint(dw2 & 0xfff, ==, 24);
+    qtest_memread(qts, MEM_RX_BUF, r, 24);
+    g_assert_cmphex(get_be32(r + 12), ==, 0x2428174c);
+    /* ROUTER_CS_1: Upstream Adapter 7, Max Adapter 11 (inferred layout) */
+    g_assert_cmphex((get_be32(r + 16) >> 8) & 0x3f, ==, 7);
+    g_assert_cmphex((get_be32(r + 16) >> 14) & 0x3f, ==, 11);
+    g_assert_cmphex(get_be32(r + 20), ==, crc32c(r, 20));
+
+    /*
+     * USB4 (non-Intel) clearing rule: with Disable ISR Auto-Clear set a
+     * read leaves the status, only the explicit clear register clears.
+     */
+    qtest_writel(qts, BAR0 + HI_CONTROL, DISABLE_ISR_AUTOCLR);
+    g_assert_cmphex(qtest_readl(qts, BAR0 + ISR0) & (1u << 16), !=, 0);
+    g_assert_cmphex(qtest_readl(qts, BAR0 + ISR0) & (1u << 16), !=, 0);
+    qtest_writel(qts, BAR0 + ISC0, 1u << 16);
+    g_assert_cmphex(qtest_readl(qts, BAR0 + ISR0) & (1u << 16), ==, 0);
+    qtest_quit(qts);
+}
+
+/*
+ * Quirk b: a TX ring other than ring 0 with E2E flow control never gets
+ * its descriptors completed; without E2E, or with the quirk off, it does.
+ */
+static unsigned tx1_send(QTestState *qts, uint32_t ctrl)
+{
+    qtest_writel(qts, BAR0 + TX_CTRL(1), 0);
+    qtest_writel(qts, BAR0 + TX_RING(1) + RING_BASE_LO, MEM_TX1_RING);
+    qtest_writel(qts, BAR0 + TX_RING(1) + RING_SIZE, 4);
+    qtest_writel(qts, BAR0 + TX_CTRL(1), RING_VALID | ctrl);
+    desc_write(qts, MEM_TX1_RING, MEM_TX_BUF, 64 | (1 << 12) | DESC_RS);
+    qtest_writel(qts, BAR0 + TX_RING(1) + RING_INDEX, 1 << 16);
+    return qtest_readl(qts, BAR0 + TX_RING(1) + RING_INDEX) & 0xffff;
+}
+
+static void test_quirk_tx_e2e(void)
+{
+    QTestState *qts = nhi_start("pc", "");
+
+    g_assert_cmpuint(tx1_send(qts, RING_E2E), ==, 0);
+    g_assert_cmphex(qtest_readl(qts, MEM_TX1_RING + 8) & DESC_DD, ==, 0);
+    g_assert_cmpuint(tx1_send(qts, 0), ==, 1);
+    qtest_quit(qts);
+
+    qts = nhi_start("pc", ",asm-quirk-tx-e2e=off");
+    g_assert_cmpuint(tx1_send(qts, RING_E2E), ==, 1);
+    g_assert_cmphex(qtest_readl(qts, MEM_TX1_RING + 8) & DESC_DD, ==,
+                    DESC_DD);
+    qtest_quit(qts);
+}
+
+/* ------------------------------------------------------------------ */
+/* Switch topology with a PCIe tunnel (pre-OS CM)                       */
+/* ------------------------------------------------------------------ */
+
+/*
+ * q35: CPU root port -> USP 1b21:2421 -> DSP 0/1 tunnels, DSP 2 xHCI,
+ * DSP 3 host interface (AM5-USB4.md 2.2). Buses as a firmware would
+ * number them here: root port 1, internal 2, DSPs 3-6.
+ */
+static void test_switch_q35(void)
+{
+    QTestState *qts = qtest_init(
+        "-nodefaults -machine q35 -global ICH9-LPC.acpi-pci-hotplug-with-bridge-"
+        "support=off -drive if=none,id=disk0,file=null-co://,format=raw "
+        "-device pcie-root-port,id=rp,bus=pcie.0,addr=0x2,chassis=1,"
+        "bus-reserve=100 "
+        "-device usb4-asm-usp,id=usp,bus=rp "
+        "-device usb4-asm-tunnel-dsp,id=tp0,bus=usp,addr=0.0,chassis=2,"
+        "slot=0,settle-ms=200 "
+        "-device usb4-asm-tunnel-dsp,id=tp1,bus=usp,addr=1.0,chassis=3,"
+        "slot=1,usb4-port=1,settle-ms=200 "
+        "-device usb4-asm-dsp,id=d2,bus=usp,addr=2.0,chassis=4,slot=2 "
+        "-device usb4-asm-dsp,id=d3,bus=usp,addr=3.0,chassis=5,slot=3 "
+        "-device usb4-asm-xhci,id=xhci,bus=d2 "
+        "-device usb4-host,id=u4,bus=d3,host-model=asm4242,"
+        "tunnel-port=tp0,tunnel-port2=tp1,preos-cm=on "
+        "-device usb4-device,id=enc0,bus=u4.0,port=1,drive=disk0,"
+        "serial=QTASM");
+    g_autofree char *st = NULL;
+
+    bridge_buses(qts, 0, 2 << 3, 1, 6);
+    bridge_buses(qts, 1, 0, 2, 6);
+    for (int d = 0; d < 4; d++) {
+        bridge_buses(qts, 2, d << 3, 3 + d, 3 + d);
+    }
+    g_assert_cmphex(cfg_readl(qts, 1, 0, 0), ==, ASM_USP);
+    for (int d = 0; d < 4; d++) {
+        g_assert_cmphex(cfg_readl(qts, 2, d << 3, 0), ==, ASM_DSP);
+        g_assert_cmphex(cfg_readl(qts, 2, d << 3, 0x08) >> 8, ==, 0x060400);
+    }
+    g_assert_cmphex(cfg_readl(qts, 5, 0, 0), ==, ASM_XHCI);
+    g_assert_cmphex(cfg_readl(qts, 5, 0, 0x08), ==, 0x0c033001);
+    g_assert_cmphex(cfg_readl(qts, 6, 0, 0), ==, ASM_NHI);
+    /* The pre-OS CM tunnelled port 1: NVMe behind DSP 0, DSP 1 empty */
+    st = endpoint_state(qts, "tp0");
+    g_assert(strstr(st, "gate=open"));
+    g_assert_cmphex(cfg_readl(qts, 3, 0, 0), ==, QEMU_NVME);
+    g_assert_cmphex(cfg_readl(qts, 4, 0, 0), ==, 0xffffffff);
+
+    /*
+     * The tunnel DSP reports Data Link Layer Link Active and signals a
+     * tunnel loss as DLLSC, which is what Linux pciehp waits for.
+     */
+    {
+        int exp = find_exp_cap(qts, 2, 0);
+        uint32_t ctl;
+
+        g_assert(cfg_readl(qts, 2, 0, exp + 0x0c) & (1u << 20));  /* DLLLARC */
+        g_assert(cfg_readl(qts, 2, 0, exp + 0x10) & (1u << 29));  /* DLLLA */
+        /* Cold insertion (pre-OS CM at power-on) is no link change */
+        g_assert(!(cfg_readl(qts, 2, 0, exp + 0x18) & (1u << 24)));
+        ctl = cfg_readl(qts, 2, 0, exp + 0x18) & 0xffff;
+        cfg_writel(qts, 2, 0, exp + 0x18, ctl | (1u << 12));      /* DLLSCE */
+        g_assert(cfg_readl(qts, 2, 0, exp + 0x18) & (1u << 12));
+        qtest_qmp_device_del_send(qts, "enc0");
+        for (int i = 0; i < 200; i++) {     /* removal runs from a BH */
+            if (cfg_readl(qts, 2, 0, exp + 0x18) & (1u << 24)) {
+                break;
+            }
+            g_usleep(10 * 1000);
+        }
+        g_assert(cfg_readl(qts, 2, 0, exp + 0x18) & (1u << 24));  /* DLLSC */
+        g_assert(!(cfg_readl(qts, 2, 0, exp + 0x10) & (1u << 29)));
+
+        /*
+         * Not acknowledged: a secondary bus reset from the switch's
+         * upstream port resets the DSP's slot, stale link change included.
+         */
+        cfg_writel(qts, 1, 0, 0x3c, 0x00400000);
+        cfg_writel(qts, 1, 0, 0x3c, 0);
+        g_assert_cmphex((cfg_readl(qts, 2, 0, exp + 0x18) >> 16) & 0x011f, ==,
+                        0);
+    }
+    qtest_quit(qts);
+}
+
+/* ------------------------------------------------------------------ */
+/* ACPI: USB4 _DSD port mapping of the switch's tunnel DSPs             */
+/* ------------------------------------------------------------------ */
+
+/*
+ * The DSDT as the firmware gets it (fw_cfg "etc/acpi/tables", before the
+ * table loader patches pointers, which the DSDT body does not contain).
+ */
+static uint8_t *fetch_dsdt(QTestState *qts, size_t *len)
+{
+    QFWCFG *fw_cfg = pc_fw_cfg_init(qts);
+    size_t cap = 1024 * 1024, n;
+    g_autofree uint8_t *blob = g_malloc0(cap);
+    uint8_t *dsdt = NULL;
+
+    n = qfw_cfg_get_file(fw_cfg, "etc/acpi/tables", blob, cap);
+    g_assert(n > 0 && n <= cap);
+    for (size_t i = 0; i + 36 <= n; i++) {
+        uint32_t l = blob[i + 4] | (blob[i + 5] << 8) | (blob[i + 6] << 16) |
+                     ((uint32_t)blob[i + 7] << 24);
+
+        if (!memcmp(blob + i, "DSDT", 4) && l >= 36 && i + l <= n) {
+            *len = l;
+            dsdt = g_memdup2(blob + i, l);
+            break;
+        }
+    }
+    pc_fw_cfg_uninit(fw_cfg);
+    g_assert(dsdt);
+    return dsdt;
+}
+
+/* AML PkgLength (ACPI 6.4 20.2.4) at @p: its value, @size its bytes. */
+static uint32_t aml_pkglen(const uint8_t *p, int *size)
+{
+    int extra = p[0] >> 6;
+    uint32_t len = extra ? p[0] & 0x0f : p[0] & 0x3f;
+
+    for (int i = 0; i < extra; i++) {
+        len |= (uint32_t)p[1 + i] << (4 + 8 * i);
+    }
+    *size = 1 + extra;
+    return len;
+}
+
+typedef struct AmlDevice {
+    size_t start, end;      /* extent of the DefDevice package */
+    char name[5];
+} AmlDevice;
+
+/* Every DefDevice (ExtOpPrefix 0x5B, DeviceOp 0x82) with a NameSeg name. */
+static GArray *aml_devices(const uint8_t *aml, size_t len)
+{
+    GArray *devs = g_array_new(false, false, sizeof(AmlDevice));
+
+    for (size_t i = 36; i + 8 < len; i++) {
+        AmlDevice d = { 0 };
+        uint32_t plen;
+        int sz;
+
+        if (aml[i] != 0x5b || aml[i + 1] != 0x82) {
+            continue;
+        }
+        plen = aml_pkglen(aml + i + 2, &sz);
+        d.start = i + 2;
+        d.end = i + 2 + plen;
+        if (d.end > len) {
+            continue;
+        }
+        memcpy(d.name, aml + i + 2 + sz, 4);
+        if (!g_ascii_isupper(d.name[0]) && d.name[0] != '_') {
+            continue;
+        }
+        g_array_append_val(devs, d);
+    }
+    return devs;
+}
+
+/*
+ * "S10.S00": the Device nesting at @off, ACPI names with '_' trimmed
+ * (PCI devices sit in a separate Scope(\_SB.PCI0), not under PCI0).
+ */
+static char *aml_scope_at(GArray *devs, size_t off)
+{
+    GString *s = g_string_new("");
+
+    for (guint i = 0; i < devs->len; i++) {
+        AmlDevice *d = &g_array_index(devs, AmlDevice, i);
+
+        if (d->start <= off && off < d->end) {
+            g_string_append_printf(s, "%s%.*s", s->len ? "." : "",
+                                   d->name[3] == '_' ? 3 : 4, d->name);
+        }
+    }
+    return g_string_free(s, false);
+}
+
+static const uint8_t *aml_find(const uint8_t *from, const uint8_t *end,
+                               const char *str)
+{
+    size_t n = strlen(str) + 1;
+
+    for (const uint8_t *p = from; p + n <= end; p++) {
+        if (!memcmp(p, str, n)) {
+            return p;
+        }
+    }
+    return NULL;
+}
+
+/* NameString with RootChar and MultiNamePrefix, as aml_name() emits it */
+static char *aml_namestring(const uint8_t *p)
+{
+    GString *s = g_string_new("\\");
+
+    g_assert_cmphex(p[0], ==, '\\');
+    if (p[1] == 0x2f) {
+        for (int i = 0; i < p[2]; i++) {
+            const char *seg = (const char *)p + 3 + 4 * i;
+
+            g_string_append_printf(s, "%s%.*s", i ? "." : "",
+                                   seg[3] == '_' ? 3 : 4, seg);
+        }
+    } else {
+        g_assert_cmphex(p[1], ==, 0x2e);    /* DualNamePrefix */
+        g_string_append_printf(s, "%.4s.%.*s", p + 2,
+                               p[9] == '_' ? 3 : 4, p + 6);
+    }
+    return g_string_free(s, false);
+}
+
+/* ByteData-sized integer object: ZeroOp, OneOp or BytePrefix */
+static int aml_small_int(const uint8_t *p)
+{
+    switch (p[0]) {
+    case 0x00:
+        return 0;
+    case 0x01:
+        return 1;
+    case 0x0a:
+        return p[1];
+    }
+    g_assert_not_reached();
+}
+
+static int cmp_str(gconstpointer a, gconstpointer b)
+{
+    return strcmp(*(char *const *)a, *(char *const *)b);
+}
+
+/*
+ * Every Name(_DSD, ...) in @aml as "scope: host=<path> port=<n>" (or
+ * "scope: no-host" without a usb4-host-interface), sorted.
+ */
+static GPtrArray *usb4_dsds(const uint8_t *aml, size_t len)
+{
+    g_autoptr(GArray) devs = aml_devices(aml, len);
+    GPtrArray *out = g_ptr_array_new_with_free_func(g_free);
+    static const uint8_t name_dsd[] = { 0x08, '_', 'D', 'S', 'D', 0x12 };
+
+    for (size_t i = 36; i + sizeof(name_dsd) < len; i++) {
+        g_autofree char *scope = NULL, *host = NULL;
+        const uint8_t *pkg, *end, *h, *n;
+        uint32_t plen;
+        int sz;
+
+        if (memcmp(aml + i, name_dsd, sizeof(name_dsd))) {
+            continue;
+        }
+        scope = aml_scope_at(devs, i);
+        pkg = aml + i + sizeof(name_dsd);
+        plen = aml_pkglen(pkg, &sz);
+        end = pkg + plen;
+        h = aml_find(pkg, end, "usb4-host-interface");
+        if (!h) {
+            g_ptr_array_add(out, g_strdup_printf("%s: no-host", scope));
+            continue;
+        }
+        n = aml_find(pkg, end, "usb4-port-number");
+        g_assert(n);
+        host = aml_namestring(h + sizeof("usb4-host-interface"));
+        g_ptr_array_add(out, g_strdup_printf("%s: host=%s port=%d", scope,
+                        host,
+                        aml_small_int(n + sizeof("usb4-port-number"))));
+    }
+    g_ptr_array_sort(out, cmp_str);
+    return out;
+}
+
+/* True if the DSDT has Device nodes along @path ("S10.S00..."). */
+static bool aml_has_device_path(const uint8_t *aml, size_t len,
+                                const char *path)
+{
+    g_autoptr(GArray) devs = aml_devices(aml, len);
+
+    for (guint i = 0; i < devs->len; i++) {
+        AmlDevice *d = &g_array_index(devs, AmlDevice, i);
+        g_autofree char *scope = aml_scope_at(devs, d->start);
+
+        if (!strcmp(scope, path)) {
+            return true;
+        }
+    }
+    return false;
+}
+
+/*
+ * q35 with the ASM4242 switch behind root port 02.0 (\_SB.PCI0.S10), a
+ * device router with a downstream USB4 port on USB4 port 1 (its
+ * usb4-tunnel-dsp is a daisy-chain port), and an Alpine Ridge switch on
+ * root port 1c.0 whose tunnel DSP belongs to the tb3 host. Only the two
+ * ASM4242 tunnel DSPs get the USB4 _DSD, each with its own port number
+ * and a host reference that resolves to the host interface behind
+ * switch DSP 3 (\_SB.PCI0.S10.S00.S18.S00).
+ */
+static void test_acpi_dsd(void)
+{
+    QTestState *qts = qtest_init(
+        "-nodefaults -machine q35 -global ICH9-LPC.acpi-pci-hotplug-with-bridge-"
+        "support=off -drive if=none,id=disk0,file=null-co://,format=raw "
+        "-drive if=none,id=disk1,file=null-co://,format=raw "
+        "-device pcie-root-port,id=rp,bus=pcie.0,addr=0x2,chassis=1,"
+        "bus-reserve=100 "
+        "-device usb4-asm-usp,id=usp,bus=rp "
+        "-device usb4-asm-tunnel-dsp,id=tp0,bus=usp,addr=0.0,chassis=2,"
+        "slot=0,usb4-port=0,settle-ms=200 "
+        "-device usb4-asm-tunnel-dsp,id=tp1,bus=usp,addr=1.0,chassis=3,"
+        "slot=1,usb4-port=1,settle-ms=200 "
+        "-device usb4-asm-dsp,id=d2,bus=usp,addr=2.0,chassis=4,slot=2 "
+        "-device usb4-asm-dsp,id=d3,bus=usp,addr=3.0,chassis=5,slot=3 "
+        "-device usb4-asm-xhci,id=xhci,bus=d2 "
+        "-device usb4-host,id=u4,bus=d3,host-model=asm4242,"
+        "tunnel-port=tp0,tunnel-port2=tp1,preos-cm=on "
+        "-device usb4-device,id=enc0,bus=u4.0,port=1,drive=disk0,"
+        "serial=QTASM,downstream-ports=1 "
+        "-device usb4-tunnel-port,id=tbrp,bus=pcie.0,addr=1c.0,chassis=10,"
+        "usb4-dvsec=off "
+        "-device usb4-tb3-usp,id=tbusp,bus=tbrp "
+        "-device usb4-tb3-dsp,id=tbd0,bus=tbusp,addr=0.0,chassis=11,slot=0 "
+        "-device usb4-tb3-tunnel-dsp,id=tbtp,bus=tbusp,addr=1.0,chassis=12,"
+        "slot=1 "
+        "-device usb4-host,id=tb,bus=tbd0,tunnel-port=tbtp,"
+        "profile=tb3-alpine-ridge "
+        "-device usb4-device,id=tbdev,bus=tb.0,port=1,dialect=tb3,"
+        "drive=disk1");
+    g_autofree char *st = endpoint_state(qts, "tp0");
+    g_autoptr(GPtrArray) dsds = NULL;
+    g_autofree uint8_t *dsdt = NULL;
+    size_t len;
+
+    /* The pre-OS CM tunnelled the device router at power-on. */
+    g_assert(strstr(st, "gate=open"));
+    dsdt = fetch_dsdt(qts, &len);
+    /* Its switch is described: the daisy-chain DSP has a node */
+    g_assert(aml_has_device_path(dsdt, len, "S10.S00.S00.S00.S08"));
+    g_assert(aml_has_device_path(dsdt, len, "S10.S00.S18.S00"));
+    g_assert(aml_has_device_path(dsdt, len, "SE0.S00.S08"));
+
+    dsds = usb4_dsds(dsdt, len);
+    for (guint i = 0; i < dsds->len; i++) {
+        g_test_message("_DSD %s", (char *)dsds->pdata[i]);
+    }
+    g_assert_cmpuint(dsds->len, ==, 3);
+    g_assert_cmpstr(dsds->pdata[0], ==, "S10.S00.S00: "
+                    "host=\\_SB.PCI0.S10.S00.S18.S00 port=0");
+    g_assert_cmpstr(dsds->pdata[1], ==, "S10.S00.S08: "
+                    "host=\\_SB.PCI0.S10.S00.S18.S00 port=1");
+    /* The tb3 host's root port: hot-plug in D3 and external, no host */
+    g_assert_cmpstr(dsds->pdata[2], ==, "SE0: no-host");
+    qtest_quit(qts);
+}
+
+/*
+ * i440FX: the conventional PCI stand-in for legacy guests. Bridges carry
+ * the switch port IDs; the tunnels are SHPC bridges with autoenable.
+ */
+static void test_switch_pc(void)
+{
+    QTestState *qts = qtest_init(
+        "-nodefaults -machine pc -global PIIX4_PM.acpi-pci-hotplug-with-bridge-"
+        "support=off -drive if=none,id=disk0,file=null-co://,format=raw "
+        "-device pci-bridge,id=rp,bus=pci.0,addr=0x5,chassis_nr=1,shpc=off,"
+        "msi=off "
+        "-device usb4-asm-pci-usp,id=usp,bus=rp,addr=0x1,chassis_nr=2,"
+        "shpc=off,msi=off "
+        "-device usb4-asm-tunnel-bridge,id=tp0,bus=usp,addr=0x0,"
+        "chassis_nr=3,shpc-autoenable=on,msi=off,settle-ms=200 "
+        "-device usb4-asm-tunnel-bridge,id=tp1,bus=usp,addr=0x1,"
+        "chassis_nr=4,shpc-autoenable=on,msi=off,settle-ms=200 "
+        "-device usb4-asm-pci-bridge,id=d2,bus=usp,addr=0x2,chassis_nr=5,"
+        "shpc=off,msi=off "
+        "-device usb4-asm-pci-bridge,id=d3,bus=usp,addr=0x3,chassis_nr=6,"
+        "shpc=off,msi=off "
+        "-device usb4-asm-xhci,id=xhci,bus=d2,addr=0x0,msi=off,msix=off "
+        "-device usb4-host,id=u4,bus=d3,addr=0x0,host-model=asm4242,"
+        "tunnel-port=tp0,tunnel-port2=tp1,preos-cm=on,msi=off,msix=off "
+        "-device usb4-device,id=enc0,bus=u4.0,port=1,drive=disk0,"
+        "serial=QTASM");
+    g_autofree char *st = NULL;
+
+    bridge_buses(qts, 0, 5 << 3, 1, 6);
+    bridge_buses(qts, 1, 1 << 3, 2, 6);
+    for (int d = 0; d < 4; d++) {
+        bridge_buses(qts, 2, d << 3, 3 + d, 3 + d);
+    }
+    g_assert_cmphex(cfg_readl(qts, 1, 1 << 3, 0), ==, ASM_USP);
+    for (int d = 0; d < 4; d++) {
+        g_assert_cmphex(cfg_readl(qts, 2, d << 3, 0), ==, ASM_DSP);
+    }
+    g_assert_cmphex(cfg_readl(qts, 5, 0, 0), ==, ASM_XHCI);
+    g_assert_cmphex(cfg_readl(qts, 6, 0, 0), ==, ASM_NHI);
+    /* INTx only: no MSI capability, pin INTA# */
+    g_assert_cmphex((cfg_readl(qts, 6, 0, 0x3c) >> 8) & 0xff, ==, 1);
+    st = endpoint_state(qts, "tp0");
+    g_assert(strstr(st, "gate=open"));
+    /* SHPC slot 1 of the tunnel bridge */
+    g_assert_cmphex(cfg_readl(qts, 3, 1 << 3, 0), ==, QEMU_NVME);
+    g_assert_cmphex(cfg_readl(qts, 4, 1 << 3, 0), ==, 0xffffffff);
+    qtest_quit(qts);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    qtest_add_func("/usb4-asm4242/identity", test_identity);
+    qtest_add_func("/usb4-asm4242/no-intx", test_no_intx);
+    qtest_add_func("/usb4-asm4242/bad-layout", test_bad_layout);
+    qtest_add_func("/usb4-asm4242/ring0-router-id", test_ring0_router_id);
+    qtest_add_func("/usb4-asm4242/quirk-tx-e2e", test_quirk_tx_e2e);
+    qtest_add_func("/usb4-asm4242/switch-q35", test_switch_q35);
+    qtest_add_func("/usb4-asm4242/switch-pc", test_switch_pc);
+    qtest_add_func("/usb4-asm4242/acpi-dsd", test_acpi_dsd);
+    return g_test_run();
+}
diff --git a/tests/qtest/usb4-harness-test.c b/tests/qtest/usb4-harness-test.c
new file mode 100644
index 0000000000000000000000000000000000000000..8b610390e49792c33471465b076e6db393a4d40a
--- /dev/null
+++ b/tests/qtest/usb4-harness-test.c
@@ -0,0 +1,1589 @@
+/*
+ * qtest for the usb4-emu test harness (docs/HARNESS.md): NVMe fault
+ * rules, harness gate overrides, controller timing faults, lost INTx,
+ * the debug port, namespace layouts and the measurement trace events.
+ *
+ * Copyright (c) 2026 usb4-emu contributors
+ * SPDX-License-Identifier: GPL-2.0-only
+ */
+
+#include "qemu/osdep.h"
+#include "libqtest.h"
+#include "qemu/cutils.h"
+#include "qobject/qdict.h"
+
+#define TP_PATH     "/machine/peripheral/tp0"
+#define TP_DEVFN    (3 << 3)
+#define TB_PATH     "/machine/peripheral/tb0"
+#define TB_DEVFN    (5 << 3)
+#define TB_EP_DEVFN (1 << 3)
+#define WIN_MEM     0xe0000000ull
+#define WIN_MEM_REG 0xe000e000u
+#define DBG_PORT    0x5a0           /* usb4-debug-port default */
+
+#define NVME_CC     0x14
+#define NVME_CSTS   0x1c
+#define NVME_AQA    0x24
+#define NVME_ASQ    0x28
+#define NVME_ACQ    0x30
+#define NVME_CC_ON  0x00460001u     /* IOCQES 4, IOSQES 6, EN */
+
+#define QSIZE       16
+#define RAM_ASQ     0x100000ull
+#define RAM_ACQ     0x101000ull
+#define RAM_SQ1     0x102000ull
+#define RAM_CQ1     0x103000ull
+#define RAM_ID      0x104000ull
+#define RAM_BUF     0x110000ull
+#define RAM_BUF2    0x111000ull
+
+#define PATTERN     0xa5            /* sector 0 of the image */
+#define PATTERN1    0x3c            /* sector 1 */
+#define SENTINEL    0x5a
+
+static uint32_t cfg_addr(int bus, int devfn, int off)
+{
+    return 0x80000000u | (bus << 16) | (devfn << 8) | (off & 0xfc);
+}
+
+static uint32_t cfg_readl(QTestState *qts, int bus, int devfn, int off)
+{
+    qtest_outl(qts, 0xcf8, cfg_addr(bus, devfn, off));
+    return qtest_inl(qts, 0xcfc);
+}
+
+static void cfg_writel(QTestState *qts, int bus, int devfn, int off,
+                       uint32_t val)
+{
+    qtest_outl(qts, 0xcf8, cfg_addr(bus, devfn, off));
+    qtest_outl(qts, 0xcfc, val);
+}
+
+static int find_exp_cap(QTestState *qts)
+{
+    int pos = cfg_readl(qts, 0, TP_DEVFN, 0x34) & 0xfc;
+
+    while (pos) {
+        uint32_t hdr = cfg_readl(qts, 0, TP_DEVFN, pos);
+
+        if ((hdr & 0xff) == 0x10) {
+            return pos;
+        }
+        pos = (hdr >> 8) & 0xfc;
+    }
+    g_assert_not_reached();
+}
+
+static void qom_set_str(QTestState *qts, const char *path, const char *prop,
+                        const char *val)
+{
+    qtest_qmp_assert_success(qts, "{'execute': 'qom-set', 'arguments': "
+                             "{'path': %s, 'property': %s, 'value': %s}}",
+                             path, prop, val);
+}
+
+static void qom_set_int(QTestState *qts, const char *path, const char *prop,
+                        int64_t val)
+{
+    qtest_qmp_assert_success(qts, "{'execute': 'qom-set', 'arguments': "
+                             "{'path': %s, 'property': %s, 'value': %"
+                             PRId64 "}}", path, prop, val);
+}
+
+static void qom_set_bool(QTestState *qts, const char *path, const char *prop,
+                         bool val)
+{
+    qtest_qmp_assert_success(qts, "{'execute': 'qom-set', 'arguments': "
+                             "{'path': %s, 'property': %s, 'value': %i}}",
+                             path, prop, val);
+}
+
+static char *qom_get_str(QTestState *qts, const char *path, const char *prop)
+{
+    QDict *rsp = qtest_qmp(qts, "{'execute': 'qom-get', 'arguments': "
+                           "{'path': %s, 'property': %s}}", path, prop);
+    char *s = g_strdup(qdict_get_str(rsp, "return"));
+
+    qobject_unref(rsp);
+    return s;
+}
+
+static bool str_has(QTestState *qts, const char *path, const char *prop,
+                    const char *needle)
+{
+    g_autofree char *s = qom_get_str(qts, path, prop);
+
+    return strstr(s, needle) != NULL;
+}
+
+static uint64_t wait_stage(QTestState *qts, const char *stage)
+{
+    for (;;) {
+        QDict *ev = qtest_qmp_eventwait_ref(qts, "USB4_TUNNEL_ENDPOINT");
+        QDict *data = qdict_get_qdict(ev, "data");
+        bool match = !strcmp(qdict_get_str(data, "stage"), stage);
+        uint64_t gen = qdict_get_int(data, "generation");
+
+        qobject_unref(ev);
+        if (match) {
+            return gen;
+        }
+    }
+}
+
+/* Wait for USB4_HARNESS; returns its trigger (caller frees). */
+static char *wait_fired(QTestState *qts, char **actions)
+{
+    QDict *ev = qtest_qmp_eventwait_ref(qts, "USB4_HARNESS");
+    QDict *data = qdict_get_qdict(ev, "data");
+    char *trig = g_strdup(qdict_get_str(data, "trigger"));
+
+    if (actions) {
+        *actions = g_strdup(qdict_get_str(data, "actions"));
+    }
+    qobject_unref(ev);
+    return trig;
+}
+
+/* A 1 MiB raw image; sector 0 is PATTERN, sector 1 PATTERN1. */
+static char *make_img(void)
+{
+    char *img = NULL;
+    int fd = g_file_open_tmp("usb4-harness-XXXXXX", &img, NULL);
+    uint8_t sec[1024];
+
+    g_assert(fd >= 0);
+    g_assert(ftruncate(fd, 1024 * 1024) == 0);
+    memset(sec, PATTERN, 512);
+    memset(sec + 512, PATTERN1, 512);
+    g_assert(write(fd, sec, sizeof(sec)) == sizeof(sec));
+    close(fd);
+    return img;
+}
+
+/* ---- a minimal NVMe driver over qtest ---- */
+
+typedef struct Nv {
+    QTestState *qts;
+    uint64_t bar;
+    uint64_t sq[2], cq[2];
+    uint16_t sq_tail[2], cq_head[2];
+    uint8_t phase[2];
+    uint16_t cid;
+} Nv;
+
+static void nv_reg_init(Nv *nv, QTestState *qts, uint64_t bar)
+{
+    memset(nv, 0, sizeof(*nv));
+    nv->qts = qts;
+    nv->bar = bar;
+    nv->sq[0] = RAM_ASQ;
+    nv->cq[0] = RAM_ACQ;
+    nv->sq[1] = RAM_SQ1;
+    nv->cq[1] = RAM_CQ1;
+    nv->phase[0] = nv->phase[1] = 1;
+}
+
+static uint32_t nv_csts(Nv *nv)
+{
+    return qtest_readl(nv->qts, nv->bar + NVME_CSTS);
+}
+
+/* Admin queues and CC.EN; RDY is not waited for. */
+static void nv_enable(Nv *nv)
+{
+    QTestState *qts = nv->qts;
+
+    qtest_memset(qts, RAM_ASQ, 0, 0x2000);
+    nv->sq_tail[0] = nv->cq_head[0] = 0;
+    nv->phase[0] = 1;
+    qtest_writel(qts, nv->bar + NVME_AQA,
+                 ((QSIZE - 1) << 16) | (QSIZE - 1));
+    qtest_writeq(qts, nv->bar + NVME_ASQ, RAM_ASQ);
+    qtest_writeq(qts, nv->bar + NVME_ACQ, RAM_ACQ);
+    qtest_writel(qts, nv->bar + NVME_CC, NVME_CC_ON);
+}
+
+static uint16_t nv_submit(Nv *nv, int q, uint8_t opc, uint32_t nsid,
+                          uint64_t prp1, uint32_t c10, uint32_t c11,
+                          uint32_t c12)
+{
+    uint32_t sqe[16] = { 0 };
+    uint16_t cid = ++nv->cid;
+
+    sqe[0] = opc | ((uint32_t)cid << 16);
+    sqe[1] = nsid;
+    sqe[6] = prp1;
+    sqe[7] = prp1 >> 32;
+    sqe[10] = c10;
+    sqe[11] = c11;
+    sqe[12] = c12;
+    qtest_memwrite(nv->qts, nv->sq[q] + nv->sq_tail[q] * 64, sqe,
+                   sizeof(sqe));
+    nv->sq_tail[q] = (nv->sq_tail[q] + 1) % QSIZE;
+    qtest_writel(nv->qts, nv->bar + 0x1000 + q * 8, nv->sq_tail[q]);
+    return cid;
+}
+
+/*
+ * The next CQE of @q is in memory (no doorbell). It must be for command
+ * @cid (unless @cid is negative) of submission queue @q.
+ */
+static bool nv_peek(Nv *nv, int q, int cid, uint32_t *dw0, uint16_t *status)
+{
+    uint32_t cqe[4];
+
+    qtest_memread(nv->qts, nv->cq[q] + nv->cq_head[q] * 16, cqe,
+                  sizeof(cqe));
+    if (((cqe[3] >> 16) & 1) != nv->phase[q]) {
+        return false;
+    }
+    g_assert_cmpuint(cqe[2] >> 16, ==, q);                  /* SQ ID */
+    if (cid >= 0) {
+        g_assert_cmpuint(cqe[3] & 0xffff, ==, cid);         /* CID */
+    }
+    if (dw0) {
+        *dw0 = cqe[0];
+    }
+    if (status) {
+        *status = cqe[3] >> 17;
+    }
+    return true;
+}
+
+/*
+ * Wait (bounded) for the next CQE of @q, which must be for @cid (any if
+ * negative); consume it and ring the doorbell.
+ */
+static bool nv_poll(Nv *nv, int q, int cid, uint32_t *dw0, uint16_t *status,
+                    int tries)
+{
+    for (int i = 0; i < tries; i++) {
+        if (nv_peek(nv, q, cid, dw0, status)) {
+            nv->cq_head[q] = (nv->cq_head[q] + 1) % QSIZE;
+            if (!nv->cq_head[q]) {
+                nv->phase[q] ^= 1;
+            }
+            qtest_writel(nv->qts, nv->bar + 0x1000 + q * 8 + 4,
+                         nv->cq_head[q]);
+            return true;
+        }
+        g_usleep(1000);
+    }
+    return false;
+}
+
+static void nv_admin_ok(Nv *nv, uint8_t opc, uint32_t nsid, uint64_t prp1,
+                        uint32_t c10, uint32_t c11)
+{
+    uint16_t st = 0xffff;
+    uint16_t cid = nv_submit(nv, 0, opc, nsid, prp1, c10, c11, 0);
+
+    g_assert(nv_poll(nv, 0, cid, NULL, &st, 2000));
+    g_assert_cmphex(st, ==, 0);
+}
+
+/* Enable, wait for RDY, create I/O queue pair 1 (CQ with INTx). */
+static void nv_bringup(Nv *nv)
+{
+    nv_enable(nv);
+    g_assert_cmphex(nv_csts(nv) & 1, ==, 1);
+    qtest_memset(nv->qts, RAM_SQ1, 0, 0x2000);
+    nv_admin_ok(nv, 0x05, 0, RAM_CQ1, ((QSIZE - 1) << 16) | 1, 0x3);
+    nv_admin_ok(nv, 0x01, 0, RAM_SQ1, ((QSIZE - 1) << 16) | 1,
+                (1 << 16) | 1);
+}
+
+/* Read one 512-byte sector @lba of NSID @nsid into @buf. */
+static uint16_t nv_read(Nv *nv, uint32_t nsid, uint64_t lba, uint64_t buf)
+{
+    return nv_submit(nv, 1, 0x02, nsid, buf, lba, lba >> 32, 0);
+}
+
+static bool buf_is(QTestState *qts, uint64_t addr, uint8_t val)
+{
+    uint8_t b[512];
+
+    qtest_memread(qts, addr, b, sizeof(b));
+    for (int i = 0; i < sizeof(b); i++) {
+        if (b[i] != val) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool wait_buf(QTestState *qts, uint64_t addr, uint8_t val)
+{
+    for (int i = 0; i < 2000; i++) {
+        if (buf_is(qts, addr, val)) {
+            return true;
+        }
+        g_usleep(1000);
+    }
+    return false;
+}
+
+/*
+ * q35 with a usb4-tunnel-port tp0 (secondary bus 1, slot powered, memory
+ * window at WIN_MEM), the tunnel up and the NVMe BAR0 mapped.
+ */
+static QTestState *tp_start(const char *img, const char *tp_extra,
+                            const char *extra, Nv *nv)
+{
+    QTestState *qts = qtest_initf(
+        "-machine q35 "
+        "-global ICH9-LPC.acpi-pci-hotplug-with-bridge-support=off "
+        "-drive if=none,id=disk0,file=%s,format=raw "
+        "-device usb4-tunnel-port,id=tp0,bus=pcie.0,addr=0x3,chassis=1,"
+        "nvme-drive=disk0,nvme-serial=QTH,settle-ms=200%s %s",
+        img, tp_extra, extra);
+
+    cfg_writel(qts, 0, TP_DEVFN, 0x18, 0x00010100);
+    cfg_writel(qts, 0, TP_DEVFN, find_exp_cap(qts) + 0x18, 0x0100);
+    cfg_writel(qts, 0, TP_DEVFN, 0x20, WIN_MEM_REG);
+    cfg_writel(qts, 0, TP_DEVFN, 0x04, 0x0006);
+    qom_set_str(qts, TP_PATH, "tunnel", "up");
+    wait_stage(qts, "inserted");
+    cfg_writel(qts, 1, 0, 0x10, (uint32_t)WIN_MEM);
+    cfg_writel(qts, 1, 0, 0x14, WIN_MEM >> 32);
+    cfg_writel(qts, 1, 0, 0x04, 0x0006);
+    nv_reg_init(nv, qts, WIN_MEM);
+    return qts;
+}
+
+/*
+ * Hook 1: the Nth matching command, at fetch, closes the tunnel gate
+ * synchronously (surprise removal with the endpoint reset in stage 2).
+ */
+static void test_fetch_surprise(void)
+{
+    g_autofree char *img = make_img();
+    g_autofree char *trig = NULL, *acts = NULL;
+    Nv nv;
+    QTestState *qts = tp_start(img, ",x-faults=\"at=fetch op=read nth=2 "
+                               "act=surprise\"", "", &nv);
+    uint16_t cid;
+
+    nv_bringup(&nv);
+    qtest_memset(qts, RAM_BUF, SENTINEL, 512);
+    cid = nv_read(&nv, 1, 0, RAM_BUF);
+    g_assert(nv_poll(&nv, 1, cid, NULL, NULL, 2000));
+    g_assert(buf_is(qts, RAM_BUF, PATTERN));
+
+    /* The second read fires the rule as it is fetched. */
+    qom_set_bool(qts, TP_PATH, "x-hold-deferred", true);
+    qtest_memset(qts, RAM_BUF2, SENTINEL, 512);
+    nv_read(&nv, 1, 1, RAM_BUF2);
+    trig = wait_fired(qts, &acts);
+    g_assert_cmpstr(trig, ==, "fetch");
+    g_assert_cmpstr(acts, ==, "surprise");
+    g_assert_cmpuint(wait_stage(qts, "gated"), ==, 1);
+    g_assert(str_has(qts, TP_PATH, "endpoint", "doomed"));
+    /* Fetched with the DMA path already closed: nothing lands. */
+    g_assert(!nv_poll(&nv, 1, -1, NULL, NULL, 100));
+    g_assert(buf_is(qts, RAM_BUF2, SENTINEL));
+    g_assert_cmphex(nv_csts(&nv), ==, 0xffffffff);
+
+    /* Stages 2-4: endpoint reset (cutoff), then removal. */
+    qom_set_bool(qts, TP_PATH, "x-hold-deferred", false);
+    g_assert_cmpuint(wait_stage(qts, "cutoff"), ==, 1);
+    g_assert_cmpuint(wait_stage(qts, "removed"), ==, 1);
+    g_assert(str_has(qts, TP_PATH, "x-harness-state", "rule0=2/1"));
+    qtest_quit(qts);
+    unlink(img);
+}
