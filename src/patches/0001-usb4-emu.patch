+#
+# @qom-path: path to the usb4-tunnel-port in the QOM tree
+#
+# @generation: endpoint instance generation number (0 if none)
+#
+# @stage: one of "gated" (access gate closed), "cutoff" (endpoint
+#     quiesced; guest memory no longer changes on its behalf),
+#     "eject-requested", "removed", "settle-timeout", "inserted",
+#     "insert-failed" (gave up retrying the endpoint realize),
