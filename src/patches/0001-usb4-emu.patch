new file mode 100644
index 0000000000000000000000000000000000000000..e51e0822f77d21e1b7267d49059d3869e387fd58
--- /dev/null
+++ b/tests/usb4/adl-conformance.c
@@ -0,0 +1,772 @@
+/*
+ * Real host conformance check for the intel-adl host model: replay the
+ * Linux software CM's host router (route 0) requests captured on a
+ * Framework Laptop 13 (12th gen) against the fabric, and compare every
+ * answer with the one the real Alder Lake-P host router gave. With a
+ * version 2 replay (adl-replay.py --routes) the device router's requests
+ * are replayed too, against the device model the replay names (asm2464:
+ * docs/captures/ORICO-ASM2464.md; tb3: the TB3 device router on a USB4
+ * host, docs/USB4-HOSTS.md 8), and reported separately. A replay with a
+ * chained device router (adl-replay.py --chain, the linux-ts3plus-orico
+ * capture) plugs that model in behind the first device router; every
+ * router is also reported on its own, with its hot plug events.
+ *
+ * Copyright (c) 2026 usb4-emu contributors
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Build and run: tests/usb4/run-adl-conformance.sh <capture dir>
+ * (the replay script comes from tests/usb4/adl-replay.py). See
+ * docs/USB4-HOSTS.md for what is compared and how to read the result.
+ */
+#define FABRIC_TEST_NO_MAIN
+#include "fabric-test.c"
+
+typedef struct Miss {
+    uint64_t route;
+    unsigned cs, adp, off;
+    unsigned count;
+    uint32_t want, got;     /* first example */
+    double t;
+} Miss;
+
+#define MAX_MISS 4096
+static Miss miss[MAX_MISS];
+static unsigned n_miss;
+/* Statistics per router class: [0] host router, [1] device routers */
+typedef struct Stats {
+    unsigned long rd_req, rd_req_ok, rd_dw, rd_dw_ok;
+    unsigned long wr_req, wr_req_ok;
+    unsigned long vs_dw, vs_dw_ok;  /* vendor-specific, captured storage */
+    unsigned long hdr, hdr_ok;      /* response headers (DW2, no SN) */
+} Stats;
+static Stats st[2];
+/*
+ * The same per router, keyed by (domain, route), with its own hot plug
+ * events: the model's not yet matched, in order (ev_q), and counters.
+ */
+#define MAX_RT 16
+#define EVQ 64
+typedef struct DevEv {
+    uint8_t adp;
+    bool unplug;
+} DevEv;
+static struct {
+    int dom;
+    uint64_t route;
+    Stats s;
+    unsigned long ev_cap, ev_ok, ev_model, ev_extra;
+    DevEv ev_q[EVQ];
+    unsigned n_evq;
+} rt[MAX_RT];
+static unsigned n_rt;
+static int cur_dom = -1;            /* domain being replayed */
+static unsigned long ev_cnt, ev_ok, ev_extra;
+static bool v2;                     /* replay format version 2 */
+
+/* The router at @route (by position), or NULL */
+static USB4Router *router_at(uint64_t route)
+{
+    if (!route) {
+        return fab->hr;
+    }
+    for (unsigned d = 0; d < fab->ndr; d++) {
+        if (fab->dr[d]->phys_route == route) {
+            return fab->dr[d];
+        }
+    }
+    return NULL;
+}
+
+static unsigned rt_index(uint64_t route)
+{
+    unsigned i;
+
+    for (i = 0; i < n_rt && (rt[i].route != route || rt[i].dom != cur_dom);
+         i++) {
+    }
+    if (i == n_rt && n_rt < MAX_RT) {
+        rt[n_rt].dom = cur_dom;
+        rt[n_rt++].route = route;
+    }
+    return MIN(i, MAX_RT - 1);
+}
+
+/*
+ * A new connection epoch (domain start, cable change, host power cycle):
+ * model events still waiting for a captured one can no longer be
+ * matched, they count as extra.
+ */
+static void ev_epoch(void)
+{
+    for (unsigned i = 0; i < n_rt; i++) {
+        rt[i].ev_extra += rt[i].n_evq;
+        rt[i].n_evq = 0;
+    }
+}
+
+/*
+ * A cable change on host USB4 port @port: a new epoch for the routers
+ * behind it only (first route byte: its lane adapters, 2 * port - 1 and
+ * 2 * port), in the current domain.
+ */
+static void ev_epoch_port(unsigned port)
+{
+    for (unsigned i = 0; i < n_rt; i++) {
+        unsigned adp = rt[i].route & 0xff;
+
+        if (rt[i].dom == cur_dom && rt[i].route &&
+            (adp == 2 * port - 1 || adp == 2 * port)) {
+            rt[i].ev_extra += rt[i].n_evq;
+            rt[i].n_evq = 0;
+        }
+    }
+}
+
+/* rt[] statistics of @route += @now - @before (Stats is all counters) */
+static void rt_add(uint64_t route, const Stats *now, const Stats *before)
+{
+    unsigned long *d = (unsigned long *)&rt[rt_index(route)].s;
+    const unsigned long *a = (const unsigned long *)now;
+    const unsigned long *b = (const unsigned long *)before;
+
+    for (unsigned i = 0; i < sizeof(Stats) / sizeof(long); i++) {
+        d[i] += a[i] - b[i];
+    }
+}
+
+/* Is this dword captured storage (no USB4 semantics in the model)? */
+static bool vendor_specific(uint64_t route, unsigned cs, unsigned adp,
+                            unsigned off)
+{
+    USB4Router *r = router_at(route);
+    USB4Adapter *a;
+    unsigned ioff;
+
+    if (!r || !r->img) {
+        return false;
+    }
+    if (cs == USB4_CS_ROUTER) {
+        return !usb4_router_img_rtr_map(r, off, &ioff);
+    }
+    if (cs != USB4_CS_ADAPTER) {
+        return false;
+    }
+    a = usb4_router_adapter(r, adp);
+    return a && a->xcs && !usb4_router_img_map(a, off, &ioff);
+}
+static int verbose;
+
+static void note_miss(uint64_t route, unsigned cs, unsigned adp,
+                      unsigned off, uint32_t want, uint32_t got, double t)
+{
+    for (unsigned i = 0; i < n_miss; i++) {
+        if (miss[i].route == route && miss[i].cs == cs &&
+            miss[i].adp == adp && miss[i].off == off) {
+            miss[i].count++;
+            return;
+        }
+    }
+    if (n_miss < MAX_MISS) {
+        miss[n_miss++] = (Miss){ route, cs, adp, off, 1, want, got, t };
+    }
+}
+
+/* Model hot plug events not yet matched to a captured event */
+static struct { unsigned adp; bool unplug; } mev[256];
+static unsigned n_mev;
+static uint32_t rsp_dw2;            /* DW2 of the last read/write response */
+static unsigned long dev_ev_cnt;    /* device router events, acknowledged */
+/* The R/W record being compared: its router and the counters before */
+static Stats rw_before;
+static uint64_t rw_route;
+static bool rw_pending;
+
+static void take_frame(Frame *f, int *err, uint32_t *data, unsigned n,
+                       bool *got)
+{
+    if (f->pdf == USB4_PDF_HOTPLUG && ((f->dw[0] & 0xffffff) || f->dw[1])) {
+        /*
+         * A device router's event (the TB3 dock sends some): the replay
+         * compares host router events only, so acknowledge it at once,
+         * as the Linux CM did, and count it.
+         */
+        uint32_t dw[3] = { f->dw[0] & 0xffffff, f->dw[1],
+                           USB4_HP_ACK | ((f->dw[2] & 0x3f) << 8) |
+                           ((f->dw[2] >> 31 ? 3u : 2u) << 30) };
+
+        uint64_t route = ((uint64_t)(f->dw[0] & 0xffffff) << 32) | f->dw[1];
+        unsigned i = rt_index(route);
+
+        dev_ev_cnt++;
+        rt[i].ev_model++;
+        if (rt[i].n_evq == EVQ) {
+            /* the oldest can no longer be matched in order */
+            memmove(&rt[i].ev_q[0], &rt[i].ev_q[1],
+                    --rt[i].n_evq * sizeof(DevEv));
+            rt[i].ev_extra++;
+        }
+        rt[i].ev_q[rt[i].n_evq].adp = f->dw[2] & 0x3f;
+        rt[i].ev_q[rt[i].n_evq].unplug = f->dw[2] >> 31;
+        rt[i].n_evq++;
+        send_raw(USB4_PDF_NOTIFY, dw, 3, false);
+        return;
+    }
+    if (f->pdf == USB4_PDF_HOTPLUG) {
+        /* A resend of the event still waiting for its ack (Spec 6.8) */
+        for (unsigned j = 0; j < n_mev; j++) {
+            if (mev[j].adp == (f->dw[2] & 0x3f) &&
+                mev[j].unplug == (f->dw[2] >> 31)) {
+                return;
+            }
+        }
+        if (n_mev < ARRAY_SIZE(mev)) {
+            mev[n_mev].adp = f->dw[2] & 0x3f;
+            mev[n_mev].unplug = f->dw[2] >> 31;
+            n_mev++;
+        }
+        return;
+    }
+    if (f->pdf == USB4_PDF_NOTIFY) {
+        *err = f->dw[2] & 0xff;
+        *got = true;
+        return;
+    }
+    if (f->pdf == USB4_PDF_READ && data) {
+        memcpy(data, &f->dw[3], MIN(n, f->ndw - 3) * 4);
+    }
+    rsp_dw2 = f->dw[2];
+    *got = true;
+}
+
+static void drain(void);
+
+/*
+ * Acknowledge model events the capture does not have, as the CM would,
+ * so the router stops resending them (Spec 6.8); counted as extra.
+ */
+static void ack_extra(unsigned n)
+{
+    while (n-- && n_mev) {
+        uint32_t dw[3] = { 0, 0, USB4_HP_ACK | (mev[0].adp << 8) |
+                           ((mev[0].unplug ? 3u : 2u) << 30) };
+
+        memmove(&mev[0], &mev[1], --n_mev * sizeof(mev[0]));
+        ev_extra++;
+        send_raw(USB4_PDF_NOTIFY, dw, 3, false);
+        drain();
+    }
+}
+
+static void drain(void)
+{
+    Frame *f;
+    int err;
+    bool got;
+
+    while ((f = rx_pop())) {
+        take_frame(f, &err, NULL, 0, &got);
+    }
+}
+
+/* Returns -1 no answer, 0 answered, >0 error notification code + 1 */
+static int xfer(uint8_t pdf, uint64_t route, unsigned cs, unsigned adp,
+                unsigned off, unsigned n, uint32_t *data)
+{
+    uint32_t dw[64];
+    unsigned ndw = 3;
+    int err = -1;
+    bool got = false;
+    Frame *f;
+
+    dw[0] = route >> 32;
+    dw[1] = (uint32_t)route;
+    dw[2] = usb4_req_dw3(off, n, adp, cs, 0);
+    if (pdf == USB4_PDF_WRITE) {
+        memcpy(&dw[3], data, n * 4);
+        ndw += n;
+    }
+    send_raw(pdf, dw, ndw, false);
+    while ((f = rx_pop())) {
+        take_frame(f, &err, data, n, &got);
+    }
+    if (!got) {
+        return -1;
+    }
+    return err >= 0 ? err + 1 : 0;
+}
+
+static USB4Device adl_dev[2] = {
+    { .serial = "ADLDEV1" }, { .serial = "ADLDEV2" },
+};
+static USB4DeviceModel dev_model;
+static USB4Dialect dev_dialect;     /* tb3: the TB3 device router preset */
+static bool present[2];
+/* A device router chained behind the first one (D record, "303:asm2464") */
+static USB4Device chain_dev = { .serial = "ADLCHAIN" };
+static uint64_t chain_route;
+
+/* Plug the chained device router in behind the one on host port @port */
+static void plug_chain(unsigned port)
+{
+    USB4Router *pr = router_at(chain_route & 0xff);
+    unsigned adp = (chain_route >> 8) & 0xff;
+
+    if (!chain_route || (chain_route & 0xff) != (port == 1 ? 1 : 3) || !pr) {
+        return;
+    }
+    for (unsigned i = 1; i < pr->nports; i++) {
+        if (pr->ports[i].lane[0] && pr->ports[i].lane[0]->num == adp) {
+            usb4_fabric_attach_chained(fab, &adl_dev[port - 1], i, &chain_dev,
+                                       NULL);
+            return;
+        }
+    }
+}
+
+static void plug(unsigned port, bool on)
+{
+    if (on && !present[port - 1]) {
+        adl_dev[port - 1].model = dev_model;
+        adl_dev[port - 1].dialect = dev_dialect;
+        /* the replayed dock: its captured link controller UUID */
+        adl_dev[port - 1].lc_captured = dev_dialect == USB4_DIALECT_TB3;
+        adl_dev[port - 1].ndfp = chain_route ? 1 : 0;
+        usb4_fabric_attach(fab, port, &adl_dev[port - 1], NULL);
+        plug_chain(port);
+    } else if (!on && present[port - 1]) {
+        usb4_fabric_detach(fab, port);
+    }
+    if (on != present[port - 1]) {
+        ev_epoch_port(port);
+    }
+    present[port - 1] = on;
+}
+
+static void run(FILE *fp)
+{
+    char line[4096];
+    int64_t base = 0;
+    int dom = -1;
+
+    while (fgets(line, sizeof(line), fp)) {
+        char *tok[80];
+        unsigned nt = 0;
+        double t;
+
+        for (char *p = strtok(line, " \n"); p && nt < 80;
+             p = strtok(NULL, " \n")) {
+            tok[nt++] = p;
+        }
+        if (!nt) {
+            continue;
+        }
+        if (tok[0][0] == 'V') {
+            v2 = atoi(tok[1]) >= 2;
+            continue;
+        }
+        if (tok[0][0] == 'D') {
+            USB4FabricConfig cfg = {
+                .profile = USB4_PROFILE_USB4_GENERIC,
+                .dialect = USB4_DIALECT_USB4,
+                .router_vendor_id = 0x1b36, .router_device_id = 0x00f4,
+                .num_usb4_ports = 2,
+                .host_model = USB4_HOST_MODEL_INTEL_ADL,
+            };
+
+            if (fab) {
+                usb4_fabric_free(fab);
+            }
+            dom = atoi(tok[1]);
+            cur_dom = dom;
+            cfg.host_domain = dom;
+            dev_model = nt > 2 && !strcmp(tok[2], "asm2464") ?
+                        USB4_DEVICE_MODEL_ASM2464 : USB4_DEVICE_MODEL_DEFAULT;
+            dev_dialect = nt > 2 && !strcmp(tok[2], "tb3") ?
+                          USB4_DIALECT_TB3 : USB4_DIALECT_USB4;
+            chain_route = 0;
+            if (nt > 3 && strchr(tok[3], ':')) {
+                const char *m = strchr(tok[3], ':') + 1;
+
+                chain_route = strtoull(tok[3], NULL, 16);
+                chain_dev.model = !strcmp(m, "asm2464") ?
+                                  USB4_DEVICE_MODEL_ASM2464 :
+                                  USB4_DEVICE_MODEL_DEFAULT;
+                chain_dev.dialect = !strcmp(m, "tb3") ? USB4_DIALECT_TB3
+                                                      : USB4_DIALECT_USB4;
+            }
+            ev_epoch();
+            fab = usb4_fabric_new((USB4Host *)&fake_host, &cfg);
+            present[0] = present[1] = false;
+            n_mev = 0;
+            advance(10);
+            base = now_ms;
+            drain();
+            continue;
+        }
+        if (tok[0][0] == 'P') {
+            plug(atoi(tok[1]), atoi(tok[2]));
+            advance(1);
+            drain();
+            n_mev = 0;
+            base = now_ms;
+            continue;
+        }
+        if (tok[0][0] == 'I') {
+            uint32_t data[60];
+            unsigned n = nt - 4;
+
+            for (unsigned i = 0; i < n; i++) {
+                data[i] = strtoul(tok[4 + i], NULL, 16);
+            }
+            xfer(USB4_PDF_WRITE, 0, atoi(tok[1]), atoi(tok[2]), atoi(tok[3]),
+                 n, data);
+            /* The earlier CM has seen and acknowledged its events. */
+            for (int k = 0; k < 20; k++) {
+                advance(1);
+                drain();
+                while (n_mev) {
+                    uint32_t dw[3] = { 0, 0, USB4_HP_ACK | (mev[0].adp << 8) |
+                                       ((mev[0].unplug ? 3u : 2u) << 30) };
+
+                    send_raw(USB4_PDF_NOTIFY, dw, 3, false);
+                    memmove(&mev[0], &mev[1], --n_mev * sizeof(mev[0]));
+                    drain();
+                }
+            }
+            base = now_ms;
+            continue;
+        }
+        t = atof(tok[1]);
+        if ((int64_t)t + base > now_ms) {
+            advance((int64_t)t + base - now_ms);
+        }
+        drain();
+        switch (tok[0][0]) {
+        case 'R': case 'W': {
+            bool rd = tok[0][0] == 'R';
+            unsigned b = v2 ? 3 : 2;
+            uint64_t route = v2 ? strtoull(tok[2], NULL, 16) : 0;
+            unsigned cs = strtoul(tok[b], NULL, 10);
+            unsigned adp = strtoul(tok[b + 1], NULL, 10);
+            unsigned off = strtoul(tok[b + 2], NULL, 10);
+            unsigned n = strtoul(tok[b + 3], NULL, 10), k = b + 4;
+            uint32_t data[64] = { 0 };
+            int r, want_err = 0;
+            Stats *s = &st[route != 0];
+            rw_before = *s;
+            rw_route = route;
+            rw_pending = true;
+
+            if (!rd) {
+                for (unsigned i = 0; i < n; i++) {
+                    data[i] = strtoul(tok[k++], NULL, 16);
+                }
+            }
+            r = xfer(rd ? USB4_PDF_READ : USB4_PDF_WRITE, route, cs, adp, off,
+                     n, data);
+            if (!strcmp(tok[k], "ERR")) {
+                want_err = atoi(tok[k + 1]) + 1;
+            } else if (r == 0 && !strncmp(tok[k], "OK/", 3)) {
+                /*
+                 * Response header: Address, Length, Adapter Num and
+                 * Configuration Space (Table 6-3); the Sequence Number
+                 * differs (the replay sends 0).
+                 */
+                unsigned int want = 0;
+                uint32_t mask = ~(3u << 27);
+
+                sscanf(tok[k] + 3, "%x", &want);
+                s->hdr++;
+                if (!((want ^ rsp_dw2) & mask)) {
+                    s->hdr_ok++;
+                } else {
+                    note_miss(route, cs | 0x400, adp, off, want & mask,
+                              rsp_dw2 & mask, t);
+                    if (verbose) {
+                        printf("d%d %.3f r%" PRIx64 " %s cs%u adp%u off "
+                               "0x%x: header want %08x got %08x\n", dom, t,
+                               route, rd ? "read" : "write", cs, adp, off,
+                               want & mask, rsp_dw2 & mask);
+                    }
+                }
+            }
+            if (!rd) {
+                s->wr_req++;
+                if (r == want_err) {
+                    s->wr_req_ok++;
+                } else {
+                    note_miss(route, cs, adp, off, want_err, r, t);
+                    if (verbose) {
+                        printf("d%d %.3f r%" PRIx64 " write cs%u adp%u off "
+                               "0x%x: want %d got %d\n", dom, t, route, cs,
+                               adp, off, want_err, r);
+                    }
+                }
+                break;
+            }
+            s->rd_req++;
+            if (want_err || r) {
+                s->rd_dw += n;
+                if (r == want_err) {
+                    s->rd_req_ok++;
+                    s->rd_dw_ok += n;
+                } else {
+                    note_miss(route, cs | 0x100, adp, off, want_err, r, t);
+                    if (verbose) {
+                        printf("d%d %.3f r%" PRIx64 " read cs%u adp%u off "
+                               "0x%x: want err %d got %d\n", dom, t, route,
+                               cs, adp, off, want_err, r);
+                    }
+                }
+                break;
+            }
+            {
+                bool all = true;
+
+                for (unsigned i = 0; i < n; i++) {
+                    uint32_t want = strtoul(tok[k + 1 + i], NULL, 16);
+
+                    s->rd_dw++;
+                    if (vendor_specific(route, cs, adp, off + i)) {
+                        s->vs_dw++;
+                        s->vs_dw_ok += want == data[i];
+                    }
+                    if (want == data[i]) {
+                        s->rd_dw_ok++;
+                    } else {
+                        all = false;
+                        note_miss(route, cs, adp, off + i, want, data[i], t);
+                        if (verbose) {
+                            printf("d%d %.3f r%" PRIx64 " cs%u adp%u off "
+                                   "0x%x: want %08x got %08x\n", dom, t,
+                                   route, cs, adp, off + i, want, data[i]);
+                        }
+                    }
+                }
+                s->rd_req_ok += all;
+            }
+            break;
+        }
+        case 'F': {
+            /*
+             * A device router's event: matched in order against that
+             * router's model events of the current epoch. Model events
+             * passed over to reach the match are extra and dropped, so
+             * a reversed pair matches once, not twice.
+             */
+            uint64_t route = strtoull(tok[2], NULL, 16);
+            unsigned adp = atoi(tok[3]), j;
+            bool unplug = atoi(tok[4]), found = false;
+            unsigned i = rt_index(route);
+
+            rt[i].ev_cap++;
+            for (j = 0; j < rt[i].n_evq; j++) {
+                if (rt[i].ev_q[j].adp == adp &&
+                    rt[i].ev_q[j].unplug == unplug) {
+                    rt[i].ev_extra += j;
+                    rt[i].n_evq -= j + 1;
+                    memmove(&rt[i].ev_q[0], &rt[i].ev_q[j + 1],
+                            rt[i].n_evq * sizeof(DevEv));
+                    rt[i].ev_ok++;
+                    found = true;
+                    break;
+                }
+            }
+            if (!found) {
+                note_miss(route, 0x200, adp, unplug, 1, 0, t);
+                if (verbose) {
+                    printf("d%d %.3f r%" PRIx64 " event adp %u unplug %d: "
+                           "not from the model\n", dom, t, route, adp,
+                           unplug);
+                }
+            }
+            break;
+        }
+        case 'E': {
+            unsigned adp = atoi(tok[2]);
+            bool unplug = atoi(tok[3]);
+
+            ev_cnt++;
+            if (!n_mev && (adp == 1 || adp == 3) &&
+                present[adp / 2] == unplug) {
+                /* A cable change the capture shows: apply it. */
+                plug(adp / 2 + 1, !unplug);
+                advance(1);
+                drain();
+            }
+            for (unsigned j = 0; j < n_mev && j < 3; j++) {
+                if (mev[j].adp == adp && mev[j].unplug == unplug) {
+                    /* events the model sent before this one are extra */
+                    ack_extra(j);
+                    memmove(&mev[0], &mev[1], --n_mev * sizeof(mev[0]));
+                    ev_ok++;
+                    adp = 0;
+                    break;
+                }
+            }
+            if (!adp) {
+                break;
+            } else {
+                note_miss(0, 0x200, adp, unplug, 1, n_mev ? mev[0].adp : 0,
+                          t);
+                if (verbose) {
+                    printf("d%d %.3f event adp %u unplug %d: model %s %u\n",
+                           dom, t, adp, unplug, n_mev ? "has" : "none",
+                           n_mev ? mev[0].adp : 0);
+                }
+            }
+            break;
+        }
+        case 'S':
+            /* Platform power cycle (runtime D3cold) of the host router */
+            ev_epoch();
+            usb4_fabric_reset(fab);
+            drain();
+            break;
+        case 'A': {
+            uint32_t dw[3] = { 0, 0, USB4_HP_ACK | (atoi(tok[2]) << 8) |
+                               ((atoi(tok[3]) ? 3u : 2u) << 30) };
+
+            send_raw(USB4_PDF_NOTIFY, dw, 3, false);
+            drain();
+            break;
+        }
+        default:
+            break;
+        }
+        if (rw_pending) {
+            rt_add(rw_route, &st[rw_route != 0], &rw_before);
+            rw_pending = false;
+        }
+        if (n_mev > 3) {
+            ack_extra(n_mev - 3);
+        }
+    }
+}
+
+static int cmp_miss(const void *a, const void *b)
+{
+    return (int)((const Miss *)b)->count - (int)((const Miss *)a)->count;
+}
+
+int main(int argc, char **argv)
+{
+    FILE *fp;
+    unsigned top;
+    double pct;
+
+    if (argc < 2 || !(fp = fopen(argv[1], "r"))) {
+        fprintf(stderr, "usage: %s <replay file>\n", argv[0]);
+        return 2;
+    }
+    usb4_test_trace = getenv("USB4_TRACE") != NULL;
+    verbose = getenv("ADL_VERBOSE") != NULL;
+    run(fp);
+    fclose(fp);
+
+    qsort(miss, n_miss, sizeof(miss[0]), cmp_miss);
+    top = getenv("ADL_TOP") ? atoi(getenv("ADL_TOP")) : 40;
+    printf("Mismatching registers (%scs adp off: count, first want/got):\n",
+           v2 ? "route " : "");
+    for (unsigned i = 0; i < n_miss && i < top; i++) {
+        const char *what = miss[i].cs & 0x400 ? "hdr" :
+                           miss[i].cs & 0x200 ? "event" :
+                           miss[i].cs & 0x100 ? "error" : "dword";
+        char rt[24] = "";
+
+        if (v2) {
+            snprintf(rt, sizeof(rt), "r%" PRIx64 " ", miss[i].route);
+        }
+        printf("  %-5s %scs%u adp%-2u 0x%03x: %4u x  want %08x got %08x "
+               "(t=%.0f ms)\n", what, rt, miss[i].cs & 0xff, miss[i].adp,
+               miss[i].off, miss[i].count, miss[i].want, miss[i].got,
+               miss[i].t);
+    }
+    for (unsigned c = 0; c < 2; c++) {
+        Stats *s = &st[c];
+        double p = s->rd_dw ? 100.0 * s->rd_dw_ok / s->rd_dw : 0;
+
+        if (!s->rd_req && !s->wr_req) {
+            continue;
+        }
+        if (v2) {
+            printf("%s:\n", c ? "device routers" : "host router");
+        }
+        printf("reads: %lu requests, %lu fully matching; %lu dwords, %lu "
+               "matching (%.1f%%)\n", s->rd_req, s->rd_req_ok, s->rd_dw,
+               s->rd_dw_ok, p);
+        printf("  USB4-defined registers: %lu dwords, %lu matching "
+               "(%.1f%%); vendor-specific: %lu dwords, %lu matching "
+               "(%.1f%%)\n", s->rd_dw - s->vs_dw, s->rd_dw_ok - s->vs_dw_ok,
+               s->rd_dw > s->vs_dw ? 100.0 * (s->rd_dw_ok - s->vs_dw_ok) /
+                                     (s->rd_dw - s->vs_dw) : 0,
+               s->vs_dw, s->vs_dw_ok,
+               s->vs_dw ? 100.0 * s->vs_dw_ok / s->vs_dw : 0);
+        printf("writes: %lu requests, %lu with the captured outcome\n",
+               s->wr_req, s->wr_req_ok);
+        printf("response headers: %lu compared, %lu matching\n", s->hdr,
+               s->hdr_ok);
+    }
+    printf("hot plug events: %lu captured, %lu matched, %lu extra from "
+           "the model\n", ev_cnt, ev_ok, ev_extra);
+    if (dev_ev_cnt) {
+        printf("device router hot plug events: %lu from the model, "
+               "acknowledged%s\n", dev_ev_cnt,
+               v2 ? "" : ", not compared");
+    }
+    /* Per router, by domain and route */
+    ev_epoch();
+    for (unsigned i = 0; i < n_rt; i++) {
+        Stats *s = &rt[i].s;
+
+        printf("d%d router %" PRIx64 ": reads %lu/%lu dwords (%.1f%%), "
+               "writes %lu/%lu, headers %lu/%lu", rt[i].dom, rt[i].route,
+               s->rd_dw_ok, s->rd_dw,
+               s->rd_dw ? 100.0 * s->rd_dw_ok / s->rd_dw : 0,
+               s->wr_req_ok, s->wr_req, s->hdr_ok, s->hdr);
+        if (rt[i].route) {
+            printf(", hot plug events %lu captured, %lu matched, %lu from "
+                   "the model (%lu extra)", rt[i].ev_cap, rt[i].ev_ok,
+                   rt[i].ev_model, rt[i].ev_extra);
+        }
+        printf("\n");
+    }
+    {
+        /* ADL_MIN_MATCH: all routers; ASM_MIN_MATCH: device routers */
+        unsigned long dw = st[0].rd_dw + st[1].rd_dw;
+        unsigned long ok = st[0].rd_dw_ok + st[1].rd_dw_ok;
+
+        pct = dw ? 100.0 * ok / dw : 0;
+    }
+    /*
+     * A threshold needs traffic to judge: no compared reads (a replay
+     * without that router) fails rather than passes.
+     */
+    if (getenv("ASM_MIN_MATCH") && !st[1].rd_dw) {
+        printf("FAIL: ASM_MIN_MATCH set but no device router reads were "
+               "compared\n");
+        return 1;
+    }
+    if (getenv("ASM_MIN_MATCH") &&
+        100.0 * st[1].rd_dw_ok / st[1].rd_dw < atof(getenv("ASM_MIN_MATCH"))) {
+        printf("FAIL: device routers below ASM_MIN_MATCH=%s%%\n",
+               getenv("ASM_MIN_MATCH"));
+        return 1;
+    }
+    /* Response headers are exact: with a threshold, any mismatch fails */
+    if ((getenv("ADL_MIN_MATCH") || getenv("ASM_MIN_MATCH")) &&
+        (st[0].hdr != st[0].hdr_ok || st[1].hdr != st[1].hdr_ok)) {
+        printf("FAIL: response header mismatches\n");
+        return 1;
+    }
+    if (getenv("ADL_MIN_MATCH") && !st[0].rd_dw) {
+        printf("FAIL: ADL_MIN_MATCH set but no host router reads were "
+               "compared\n");
+        return 1;
+    }
+    if (getenv("ADL_MIN_MATCH") && pct < atof(getenv("ADL_MIN_MATCH"))) {
+        printf("FAIL: below ADL_MIN_MATCH=%s%%\n", getenv("ADL_MIN_MATCH"));
+        return 1;
+    }
+    return 0;
+}
diff --git a/tests/usb4/adl-replay.py b/tests/usb4/adl-replay.py
new file mode 100644
index 0000000000000000000000000000000000000000..48253a8e59efc7ca6c6de980fdcb2c7e9dd4fcd7
--- /dev/null
+++ b/tests/usb4/adl-replay.py
@@ -0,0 +1,238 @@
+#!/usr/bin/env python3
+# Extract the Linux software CM's conversation with the host router (route
+# 0) and, optionally, device routers from a Framework 13 (12th gen)
+# capture's tracepoint log, as a replay script for
+# tests/usb4/adl-conformance.c (docs/USB4-HOSTS.md,
+# docs/captures/ORICO-ASM2464.md).
+#
+#   python3 tests/usb4/adl-replay.py <extracted capture dir> <out file> \
+#       [--routes 0,3] [--domains 1] [--device-model asm2464] \
+#       [--chain 303:asm2464]
+#
+# Without options: route 0 of both domains, format version 1 (as for the
+# intel-adl check). With --routes listing a device router, format version
+# 2: every R/W record carries the route (hex) after the time, and the D
+# record names the device router model the replay attaches. --chain adds
+# a device router of the given model, plugged in at the given route behind
+# the first device router (a daisy chain, linux-ts3plus-orico).
+#
+# Output, one record per line, times in ms from the domain's first record:
+#   V 2                        format version 2 (absent: version 1)
+#   D <domain> [<model> [<route>:<model>]]   start of a domain, with the
+#                              device router model and a chained one
+#   P <usb4 port> <0|1>        device present on that port at the start
+#   R <t> [<route>] <cs> <adp> <off> <len> OK/<hdr> <dw>...
+#                              read and its answer
+#   R <t> [<route>] <cs> <adp> <off> <len> ERR <code>   read answered by error
+#   W <t> [<route>] <cs> <adp> <off> <len> <dw>... OK/<hdr>|ERR <code>
+#   (<hdr>: the answer's DW2 in hex, Address, Length, Adapter Num and
+#   Configuration Space of the response header, Spec Table 6-3)
+#   E <t> <adp> <unplug>       hot plug event sent by the host router
+#   F <t> <route> <adp> <unplug>  (version 2) hot plug event sent by a
+#                              device router
+#   A <t> <adp> <unplug>       hot plug acknowledgment sent by the CM
+#   X <t>                      request with no answer in the trace
+#   I <cs> <adp> <off> <dw>... state left by an earlier CM, written first
+#   S <t>                      platform power cycle (host router and all
+#                              routers behind it)
+# Version 2 also recovers the complete second record of the few trace
+# lines that hold two records (the first one is truncated and lost).
+# Copyright (c) 2026 usb4-emu contributors
+# SPDX-License-Identifier: GPL-2.0-only
+
+import os
+import re
+import sys
+
+TRACE = re.compile(r'\s([\d.]+): (tb_\w+): (.*)')
+KV = re.compile(r'(\w+)=(\[[^\]]*\]|[^,]+)')
+REC = re.compile(r'\s[\d.]+: tb_\w+: ')
+
+
+def records(path, last_record=False):
+    for line in open(path):
+        if last_record:
+            starts = [m.start() for m in REC.finditer(line)]
+            if not starts:
+                continue
+            line = line[starts[-1]:]
+        m = TRACE.search(line)
+        if not m:
+            continue
+        f = dict(KV.findall(m.group(3)))
+        f['t'] = float(m.group(1))
+        f['k'] = m.group(2)
+        try:
+            if 'data' in f:
+                f['data'] = [int(x, 16) for x in
+                             f['data'].strip('[]').split(',') if x.strip()]
+            for k in ('offset', 'len', 'port', 'config', 'domain'):
+                if k in f:
+                    f[k] = int(f[k], 0)
+            f['route'] = int(f['route'], 16) if 'route' in f else None
+        except ValueError:
+            if not last_record:
+                raise
+            continue
+        yield f
+
+
+def opts(argv):
+    o = {'routes': [0], 'domains': [0, 1], 'model': None, 'chain': None}
+    i = 0
+    while i < len(argv):
+        if argv[i] == '--routes':
+            o['routes'] = [int(x, 16) for x in argv[i + 1].split(',')]
+        elif argv[i] == '--domains':
+            o['domains'] = [int(x) for x in argv[i + 1].split(',')]
+        elif argv[i] == '--device-model':
+            o['model'] = argv[i + 1]
+        elif argv[i] == '--chain':
+            o['chain'] = argv[i + 1]
+        else:
+            raise SystemExit('unknown option ' + argv[i])
+        i += 2
+    return o
+
+
+def main():
+    cap, out = sys.argv[1], sys.argv[2]
+    o = opts(sys.argv[3:])
+    v2 = o['routes'] != [0]
+    recs = [f for f in records(os.path.join(cap, 'trace-thunderbolt.txt'),
+                               last_record=v2)
+            if f['route'] in o['routes']]
+    lines = ['V 2'] if v2 else []
+    # Every requested domain and route must have traffic: a typo or the
+    # wrong capture would otherwise compare nothing and pass.
+    for dom in o['domains']:
+        if not any(f.get('domain') == dom for f in recs):
+            raise SystemExit('domain %d: no records for routes %s' %
+                             (dom, ','.join('%x' % r for r in o['routes'])))
+    for route in o['routes']:
+        if not any(f['route'] == route and f.get('domain') in o['domains']
+                   for f in recs):
+            raise SystemExit('route %x: no records in domains %s' %
+                             (route, ','.join(map(str, o['domains']))))
+    for dom in o['domains']:
+        rs = [f for f in recs if f.get('domain') == dom]
+        t0 = rs[0]['t']
+        lines.append('D %d' % dom + (' ' + o['model'] if o['model'] else '') +
+                     (' ' + o['chain'] if o['chain'] else ''))
+        # Device presence at the start: first read of ADP_CS_4 (Plugged,
+        # bit 30) of each lane 0 adapter (1: port 1, 3: port 2).
+        for port, adp in ((1, 1), (2, 3)):
+            pres = 0
+            for f in rs:
+                if (f['k'] == 'tb_rx' and f['type'] == 'TB_CFG_PKG_READ' and
+                        f['route'] == 0 and
+                        f['config'] == 1 and f['port'] == adp and
+                        f['offset'] <= 4 < f['offset'] + f['len']):
+                    pres = (f['data'][3 + 4 - f['offset']] >> 30) & 1
+                    break
+            lines.append('P %d %d' % (port, pres))
+        pending = []    # requests awaiting their answer, in order
+        out_recs = []
+
+        def ms(f):
+            return '%.3f' % ((f['t'] - t0) * 1000)
+
+        for f in rs:
+            k, ty = f['k'], f.get('type')
+            if k == 'tb_event':
+                if f['route'] == 0:
+                    out_recs.append(['E %s %d %d' % (ms(f), f['port'],
+                                     int(f.get('unplug', '0'), 0))])
+                elif v2:
+                    out_recs.append(['F %s %x %d %d' % (
+                        ms(f), f['route'], f['port'],
+                        int(f.get('unplug', '0'), 0))])
+                continue
+            if k == 'tb_tx' and ty == 'TB_CFG_PKG_ERROR':
+                if f['route'] == 0:
+                    dw2 = f['data'][2]
+                    out_recs.append(['A %s %d %d' % (ms(f), (dw2 >> 8) & 0x3f,
+                                     1 if (dw2 >> 30) == 3 else 0)])
+                continue
+            if k == 'tb_tx' and ty in ('TB_CFG_PKG_READ', 'TB_CFG_PKG_WRITE'):
+                cs, adp = f['config'], f['port']
+                if cs == 2:
+                    adp = 0
+                head = '%s %s%s %d %d %d %d' % (
+                    'R' if ty == 'TB_CFG_PKG_READ' else 'W', ms(f),
+                    ' %x' % f['route'] if v2 else '', cs, adp,
+                    f['offset'], f['len'])
+                if ty == 'TB_CFG_PKG_WRITE':
+                    head += ' ' + ' '.join('%x' % x for x in
+                                           f['data'][3:3 + f['len']])
+                rec = [head, None]
+                out_recs.append(rec)
+                pending.append((f, rec))
+                continue
+            if k != 'tb_rx':
+                continue
+            # Match the answer to the oldest pending request it fits.
+            for i, (q, rec) in enumerate(pending):
+                if v2 and q['route'] != f['route']:
+                    continue
+                if ty == 'TB_CFG_PKG_ERROR':
+                    if f['port'] != q['port'] and q['config'] != 2:
+                        continue
+                    rec[1] = 'ERR %d' % int(f.get('error', '0'), 0)
+                elif (ty == q['type'] and f['offset'] == q['offset'] and
+                      f['len'] == q['len'] and f['config'] == q['config'] and
+                      (f['port'] == q['port'] or q['config'] == 2)):
+                    # Keep the response header (Adapter Num included);
+                    # outside Router CS it names the requested adapter,
+                    # so a lost answer does not shift the others.
+                    rec[1] = 'OK/%x' % f['data'][2]
+                    if ty == 'TB_CFG_PKG_READ':
+                        rec[1] += ' ' + ' '.join(
+                            '%x' % x for x in f['data'][3:3 + f['len']])
+                else:
+                    continue
+                del pending[i]
+                break
+        # The previous CM instance left the router configured when it was
+        # not powered off before the trace (observed on domain 1): seed
+        # ROUTER_CS_1-4 from their first reads.
+        first = {}
+        for f in rs:
+            if (f['k'] == 'tb_rx' and f.get('type') == 'TB_CFG_PKG_READ' and
+                    f['route'] == 0 and f['config'] == 2 and
+                    f['offset'] == 0 and f['len'] >= 5):
+                first = {i: f['data'][3 + i] for i in range(1, 5)}
+                break
+        if first.get(3, 0) >> 31:
+            lines.append('I 2 0 1 %x %x %x %x' % (first[1], first[2],
+                                                  first[3], first[4]))
+        # A host router that was told to sleep and then left alone is
+        # powered off by the platform (runtime D3cold): every Enter Sleep
+        # write followed by a pause of 5 ms or more is a power cycle.
+        recs2 = []
+        armed = False
+        c = 3 if v2 else 2      # index of the cs field in a W record
+        for i, rec in enumerate(out_recs):
+            recs2.append(rec)
+            h = rec[0].split()
+            if (h[0] == 'W' and (not v2 or h[2] == '0') and
+                    h[c] == '2' and h[c + 2] == '5'):
+                armed = bool(int(h[c + 4], 16) & 1)
+            if (armed and i + 1 < len(out_recs) and
+                    float(out_recs[i + 1][0].split()[1]) - float(h[1]) >= 5):
+                recs2.append(['S %.3f' % (float(h[1]) + 1)])
+                armed = False
+        out_recs = recs2
+        for rec in out_recs:
+            if len(rec) == 1:
+                lines.append(rec[0])
+            elif rec[1] is None:
+                lines.append('X ' + rec[0].split()[1])
+            else:
+                lines.append(rec[0] + ' ' + rec[1])
+    with open(out, 'w', newline='\n') as fp:
+        fp.write('\n'.join(lines) + '\n')
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tests/usb4/fabric-test.c b/tests/usb4/fabric-test.c
new file mode 100644
index 0000000000000000000000000000000000000000..e8fdb6484139800e77838d41a97ef6f13ae4ccd8
--- /dev/null
+++ b/tests/usb4/fabric-test.c
@@ -0,0 +1,2720 @@
+/*
+ * Standalone test for the USB4 fabric: a minimal software connection
+ * manager driving usb4-ctl.c, usb4-fabric.c, usb4-router.c,
+ * usb4-drom.c and usb4-tunnel.c through ring 0 frames.
+ *
+ * Copyright (c) 2026 usb4-emu contributors
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Build and run: tests/usb4/run-fabric-test.sh (MSYS2 gcc + glib).
+ * Set USB4_TRACE=1 to print the fabric trace events.
+ */
+#include "qemu/osdep.h"
+#include "hw/usb4/usb4-fabric-int.h"
+
+int usb4_test_trace;
+static int failures, checks;
+
+#define CHECK(cond, ...) do { \
+    checks++; \
+    if (!(cond)) { \
+        failures++; \
+        fprintf(stderr, "FAIL %s:%d: %s: ", __FILE__, __LINE__, #cond); \
+        fprintf(stderr, __VA_ARGS__); \
+        fputc('\n', stderr); \
+    } \
+} while (0)
+
+/* ------------------------------------------------------------------ */
+/* Fakes for the neighbours of the fabric                               */
+/* ------------------------------------------------------------------ */
+
+struct USB4Device {
+    const char *serial;
+    void *router;
+    unsigned ndfp;          /* downstream USB4 ports */
+    int tp;                 /* fake tunnel target behind its PCIe Down */
+    USB4Dialect dialect;
+    USB4DeviceModel model;
+    uint64_t uid;
+    bool lc_captured;       /* tb3: lc-uuid=captured */
+};
+
+typedef struct Frame {
+    uint8_t pdf;
+    unsigned ndw;
+    uint32_t dw[64];
+} Frame;
+
+#define RXQ 256
+static Frame rxq[RXQ];
+static unsigned rx_head, rx_tail;
+static int fake_host, fake_tp;
+
+void usb4_host_rx_frame(USB4Host *h, uint8_t pdf, const uint8_t *frame,
+                        size_t len)
+{
+    Frame *f = &rxq[rx_tail % RXQ];
+
+    CHECK(usb4_ctl_frame_crc_ok(frame, len), "rx frame CRC");
+    CHECK(len % 4 == 0 && len >= 12 && len <= USB4_CTL_MAX_FRAME,
+          "rx len %zu", len);
+    f->pdf = pdf;
+    f->ndw = len / 4 - 1;
+    for (unsigned i = 0; i < f->ndw; i++) {
+        f->dw[i] = usb4_get_be32(frame + 4 * i);
+    }
+    CHECK(f->dw[0] & 0x80000000u, "CM bit set in upstream packet");
+    rx_tail++;
+}
