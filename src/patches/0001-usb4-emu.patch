+/* qom-set that must fail; returns the error description (caller frees). */
+static char *qom_set_err(QTestState *qts, const char *path, const char *prop,
+                         const char *val)
+{
+    QDict *rsp = qtest_qmp(qts, "{'execute': 'qom-set', 'arguments': "
+                           "{'path': %s, 'property': %s, 'value': %s}}",
+                           path, prop, val);
+    QDict *err = qdict_get_qdict(rsp, "error");
+    char *desc;
+
+    g_assert(err);
+    desc = g_strdup(qdict_get_str(err, "desc"));
+    qobject_unref(rsp);
+    return desc;
+}
