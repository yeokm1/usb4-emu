index 0000000000000000000000000000000000000000..7800a3bc216509a4f6de106c44024c4c8feaf3c5
--- /dev/null
+++ b/tests/usb4/gen-adl-data.py
@@ -0,0 +1,300 @@
+#!/usr/bin/env python3
+# Generate hw/usb4/usb4-adl-data.h, the register images of the captured
+# Intel Alder Lake-P integrated USB4 host router, from the Framework 13
+# (12th gen) Linux capture (tests/captures/framework13-12th/linux-ts3plus,
+# extracted).
+#
+#   python3 tests/usb4/gen-adl-data.py <extracted capture dir> \
+#       hw/usb4/usb4-adl-data.h
+#
+# Image rule (docs/USB4-HOSTS.md): the debugfs dump of domain 0 (no device
+# ever attached) in snap-1-initial is the base; every dword the Linux CM
+# read in the trace before it first wrote that dword overrides it, so the
+# image is the state right after the host router reset that precedes the
+# trace. Identity (router ID, UUID) is captured per domain.
+#
+# Copyright (c) 2026 usb4-emu contributors
+# SPDX-License-Identifier: GPL-2.0-only
+
+import os
+import re
+import sys
+
+CAP_LANE, CAP_TMU, CAP_PROTO, CAP_VS, CAP_PORT = 1, 3, 4, 5, 6
+CS_PATH, CS_ADP, CS_RTR, CS_CNT = 0, 1, 2, 3
+
+
+def read_regs(path):
+    """debugfs regs: offset rel cap vs value -> {off: (cap, rel, val)}."""
+    out = {}
+    for line in open(path):
+        if line.startswith('#') or not line.strip():
+            continue
+        f = line.split()
+        out[int(f[0], 16)] = (int(f[2], 16), int(f[1]), int(f[-1], 16))
+    return out
+
+
+def read_path(path):
+    out = {}
+    for line in open(path):
+        if line.startswith('#') or not line.strip():
+            continue
+        f = line.split()
+        out[int(f[0], 16)] = int(f[-1], 16)
+    return out
+
+
+def read_sb(path):
+    out = []
+    for line in open(path):
+        if line.startswith('#') or not line.strip():
+            continue
+        f = line.split()
+        out.append((int(f[0], 16), bytes(int(x, 16) for x in f[1:])))
+    return out
+
+
+TRACE = re.compile(r'\s([\d.]+): (tb_\w+): (.*)')
+KV = re.compile(r'(\w+)=(\[[^\]]*\]|[^,]+)')
+
+
+def trace_records(path):
+    for line in open(path):
+        m = TRACE.search(line)
+        if not m:
+            continue
+        f = dict(KV.findall(m.group(3)))
+        f['k'] = m.group(2)
+        if 'data' in f:
+            f['data'] = [int(x, 16) for x in f['data'].strip('[]').split(',')
+                         if x.strip()]
+        for k in ('offset', 'len', 'port', 'config', 'domain'):
+            if k in f:
+                f[k] = int(f[k], 0)
+        if 'route' in f:
+            f['route'] = int(f['route'], 16)
+        yield f
+
+
+def first_reads(trace, domain):
+    """{(cs, adp, off): value} read before the first write to that dword."""
+    written, first = set(), {}
+    for f in trace_records(trace):
+        if f.get('route') != 0 or f.get('domain') != domain:
+            continue
+        if f.get('type') not in ('TB_CFG_PKG_READ', 'TB_CFG_PKG_WRITE'):
+            continue
+        cs = f['config']
+        adp = 0 if cs == CS_RTR else f['port']
+        if f['k'] == 'tb_tx' and f['type'] == 'TB_CFG_PKG_WRITE':
+            for i in range(f['len']):
+                written.add((cs, adp, f['offset'] + i))
+        elif f['k'] == 'tb_rx' and f['type'] == 'TB_CFG_PKG_READ':
+            for i, v in enumerate(f['data'][3:3 + f['len']]):
+                key = (cs, adp, f['offset'] + i)
+                if key not in written and key not in first:
+                    first[key] = v
+    return first
+
+
+def caps(regs):
+    """{cap_id: (first offset, length)} from a debugfs dump."""
+    out = {}
+    for off in sorted(regs):
+        cap, rel, _ = regs[off]
+        if cap == 0 or cap == CAP_VS:
+            continue
+        if rel == 0:
+            out[cap] = [off, 1]
+        elif cap in out and off == out[cap][0] + out[cap][1]:
+            out[cap][1] += 1
+    return {k: tuple(v) for k, v in out.items()}
+
+
+def kind_of(adp_cs2, is_lane):
+    t = adp_cs2 & 0xffffff
+    return {
+        0x000001: 'USB4_ADP_LANE',
+        0x000002: 'USB4_ADP_HI',
+        0x100101: 'USB4_ADP_PCIE_DOWN',
+        0x200101: 'USB4_ADP_USB3_DOWN',
+        0x0e0101: 'USB4_ADP_DP_IN',
+    }[t]
+
+
+def regs_c(name, items):
+    s = 'static const USB4AdlReg %s[] = {\n' % name
+    row = []
+    for off, val in items:
+        row.append('{ 0x%03x, 0x%08x },' % (off, val))
+        if len(row) == 3:
+            s += '    ' + ' '.join(row) + '\n'
+            row = []
+    if row:
+        s += '    ' + ' '.join(row) + '\n'
+    if not items:
+        s += '    { 0, 0 },\n'
+    return s + '};\n'
+
+
+def bytes_c(b):
+    s = ''
+    for i in range(0, len(b), 12):
+        s += '    ' + ' '.join('0x%02x,' % x for x in b[i:i + 12]) + '\n'
+    return s
+
+
+def main():
+    cap_dir, out_path = sys.argv[1], sys.argv[2]
+    snap = os.path.join(cap_dir, 'snap-1-initial', 'debugfs-thunderbolt')
+    snap5 = os.path.join(cap_dir, 'snap-5-plugged', 'debugfs-thunderbolt')
+    trace = os.path.join(cap_dir, 'trace-thunderbolt.txt')
+    d0 = os.path.join(snap, '0-0')
+    fr = first_reads(trace, 0)
+
+    o = []
+    o.append('''/*
+ * Intel Alder Lake-P integrated USB4 host router register images
+ *
+ * Copyright (c) 2026 usb4-emu contributors
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * GENERATED by tests/usb4/gen-adl-data.py from the Framework Laptop 13
+ * (12th gen) capture tests/captures/framework13-12th/linux-ts3plus
+ * (observed data, docs/USB4-HOSTS.md). Base: debugfs dump of host router
+ * 0-0 in snap-1-initial; dwords the Linux CM read before writing them
+ * are taken from the trace (the state after the host router reset).
+ * Only non-zero dwords are listed. Do not edit by hand.
+ */
+
+/* Image types: usb4-fabric-int.h (USB4Img*) */
+typedef USB4ImgReg USB4AdlReg;
+typedef USB4ImgCap USB4AdlCap;
+typedef USB4ImgAdapter USB4AdlAdapter;
+typedef USB4ImgSB USB4AdlSB;
+''')
+
+    # Router CS
+    rregs = read_regs(os.path.join(d0, 'regs'))
+    img = {off: v[2] for off, v in rregs.items()}
+    for (cs, adp, off), v in fr.items():
+        if cs == CS_RTR:
+            img[off] = v
+    # Router operation Data, Metadata and Opcode (ROUTER_CS_9-26) hold
+    # what earlier operations left; they read 0 after a power cycle
+    # (observed in the trace).
+    for off in range(9, 27):
+        img[off] = 0
+    rsize = max(rregs) + 1
+    o.append('/* Router CS of host router 0-0 (%u dwords) */' % rsize)
+    o.append('#define ADL_RTR_CS_SIZE 0x%x' % rsize)
+    o.append(regs_c('adl_rtr_regs',
+                    [(k, img[k]) for k in sorted(img) if img[k] and k > 0]))
+
+    # Identity per domain: ROUTER_CS_0, ROUTER_CS_7/8 (UUID)
+    o.append('/* Per domain (0: NHI 00:0d.2, 1: NHI 00:0d.3) identity */')
+    o.append('static const struct { uint32_t cs0, cs7, cs8; } adl_ident[2] = {')
+    for d in (0, 1):
+        rr = read_regs(os.path.join(snap, '%d-0' % d, 'regs'))
+        o.append('    { 0x%08x, 0x%08x, 0x%08x },' %
+                 (rr[0][2], rr[7][2], rr[8][2]))
+    o.append('};\n')
+
+    # Adapters
+    nmax = (img[1] >> 14) & 0x3f
+    ents = []
+    for n in range(1, nmax + 1):
+        pdir = os.path.join(d0, 'port%d' % n)
+        if not os.path.isdir(pdir):
+            ents.append(None)
+            continue
+        regs = read_regs(os.path.join(pdir, 'regs'))
+        aimg = {off: v[2] for off, v in regs.items()}
+        for (cs, adp, off), v in fr.items():
+            if cs == CS_ADP and adp == n:
+                aimg[off] = v
+        cp = caps(regs)
+        kind = kind_of(aimg[2], False)
+        size = max(regs) + 1
+        pth = read_path(os.path.join(pdir, 'path'))
+        pimg = dict(pth)
+        for (cs, adp, off), v in fr.items():
+            if cs == CS_PATH and adp == n:
+                pimg[off] = v
+        pimg = {k: v for k, v in pimg.items() if v}
+        ents.append((n, kind, aimg, cp, size, pimg))
+        o.append(regs_c('adl_adp%d_cs' % n,
+                        [(k, aimg[k]) for k in sorted(aimg) if aimg[k]]))
+        o.append(regs_c('adl_adp%d_path' % n, sorted(pimg.items())))
+
+    # Pairing: lanes 2p-1/2p = port p; protocol adapters of one type in
+    # increasing order pair with ports 1, 2, ... (Guide 3.2.2)
+    o.append('#define ADL_MAX_ADAPTER %d' % nmax)
+    o.append('#define ADL_UPSTREAM_ADAPTER %d' % ((img[1] >> 8) & 0x3f))
+    o.append('static const USB4AdlAdapter adl_adapters[ADL_MAX_ADAPTER + 1]'
+             ' = {')
+    seen = {}
+    for e in ents:
+        if e is None:
+            continue
+        n, kind, aimg, cp, size, pimg = e
+        if kind == 'USB4_ADP_LANE':
+            port, lane = (n + 1) // 2, (n + 1) % 2
+        else:
+            seen[kind] = seen.get(kind, 0) + 1
+            port, lane = (seen[kind] if kind != 'USB4_ADP_HI' else 0), 0
+        cs5 = aimg.get(5, 0)
+        cs1 = aimg.get(1, 0)
+        cntsets = (cs1 >> 8) & 0x7ff if cs1 & (1 << 19) else 0
+
+        def cap(c):
+            v = cp.get(c)
+            return '{ 0x%02x, %d }' % v if v else '{ 0, 0 }'
+        o.append('    [%d] = {' % n)
+        o.append('        .kind = %s, .usb4_port = %d, .lane = %d,' %
+                 (kind, port, lane))
+        o.append('        .max_hop = %d, .cs_size = 0x%x, .counter_sets = %d,'
+                 % (cs5 & 0x7ff, size, cntsets))
+        o.append('        .lane_cap = %s, .tmu_cap = %s,' %
+                 (cap(CAP_LANE), cap(CAP_TMU)))
+        o.append('        .port_cap = %s, .proto_cap = %s,' %
+                 (cap(CAP_PORT), cap(CAP_PROTO)))
+        o.append('        .cs = adl_adp%d_cs, .ncs = ARRAY_SIZE(adl_adp%d_cs),'
+                 % (n, n))
+        o.append('        .path = adl_adp%d_path, .npath = %d,' %
+                 (n, len(pimg)))
+        o.append('    },')
+    o.append('};\n')
+
+    # Sideband registers of the host USB4 ports (lane 0 adapters)
+    for n in (1, 3):
+        sb = read_sb(os.path.join(d0, 'port%d' % n, 'sb_regs'))
+        o.append('static const USB4AdlSB adl_port%d_sb[] = {' % ((n + 1) // 2))
+        for reg, data in sb:
+            o.append('    { 0x%02x, %d, { %s } },' %
+                     (reg, len(data), ', '.join('0x%02x' % x for x in data)))
+        o.append('};')
+    o.append('')
+
+    # On-board retimer (index 1) seen on domain 1 port 2
+    rt = [d for d in os.listdir(snap5) if d.startswith('1-0_')]
+    sb = read_sb(os.path.join(snap5, rt[0], 'sb_regs'))
+    o.append('/* On-board retimer 8087:15ee, %s in snap-5-plugged */' % rt[0])
+    o.append('static const USB4AdlSB adl_retimer_sb[] = {')
+    for reg, data in sb:
+        o.append('    { 0x%02x, %d, { %s } },' %
+                 (reg, len(data), ', '.join('0x%02x' % x for x in data)))
+    o.append('};\n')
+
+    # Host router DROM
+    drom = open(os.path.join(d0, 'drom'), 'rb').read()
+    o.append('static const uint8_t adl_host_drom[%d] = {' % len(drom))
+    o.append(bytes_c(drom) + '};')
+
+    with open(out_path, 'w', newline='\n') as fp:
+        fp.write('\n'.join(o) + '\n')
+
+
+if __name__ == '__main__':
+    main()
