+/* R11: check a device-connected event and return its id */
+static unsigned check_connected(const uint32_t *w, unsigned n, bool approved,
+                                bool exact, uint32_t *uuid)
+{
+    uint8_t blk[55 * 4];
+    unsigned pos = 0;
+
+    static const uint32_t names[] = {
+        /* "CalDigit, Inc." and "TS3 Plus", as captured (T:9) */
+        0x61430111, 0x6769446c, 0x202c7469, 0x2e636e49, 0x54020b00,
+        0x50203353, 0x0073756c,
+    };
+
+    g_assert_cmpuint(n, ==, 61);
+    g_assert_cmphex(w[0], ==, 0x0100b103);
+    g_assert_cmphex(w[3], ==, 0xffffffff);
+    g_assert_cmphex(w[4], ==, 0xffffffff);
+    g_assert_cmphex(w[5] & 0xff, ==, 0x10);
+    /* link info without the boot bit 10, checked by the caller */
+    g_assert_cmphex((w[5] >> 16) & ~0x400u, ==, approved ? 0x0911 : 0x0811);
+    if (exact) {
+        for (unsigned i = 0; i < ARRAY_SIZE(names); i++) {
+            g_assert_cmphex(w[6 + i], ==, names[i]);
+        }
+        g_assert_cmphex(w[13] & 0xffff, ==, 0x1008);
+        g_assert_cmphex(w[15], ==, 0x00001202);
+    }
+    /* name block: vendor, model, Intel entry, 0x12, then zeros (4.4) */
+    for (unsigned i = 0; i < 55; i++) {
+        stl_le_p(blk + 4 * i, w[6 + i]);
+    }
+    for (unsigned k = 0; k < 4; k++) {
+        static const uint8_t type[] = { 0x01, 0x02, 0x10, 0x12 };
+
+        g_assert_cmpuint(blk[pos], >=, 2);
+        g_assert_cmphex(blk[pos + 1], ==, type[k]);
+        if (k < 2) {
+            g_assert_cmpuint(blk[pos + blk[pos] - 1], ==, 0);
+        }
+        pos += blk[pos];
+    }
+    for (; pos < sizeof(blk); pos++) {
+        g_assert_cmphex(blk[pos], ==, 0);
+    }
+    memcpy(uuid, &w[1], 16);
+    return (w[5] >> 8) & 0xff;
+}
+
+/* Control packet on ring 0 (Spec Table 6-2), answered or failing. */
+static void ctl_req(T *t, bool write, uint64_t route, unsigned cs,
+                    unsigned adp, unsigned addr, unsigned n, uint32_t *data)
+{
+    uint32_t f[3 + 64], w[64];
+    unsigned got;
+
+    f[0] = route >> 32;
+    f[1] = (uint32_t)route;
+    f[2] = addr | (n << 13) | (adp << 19) | (cs << 25);
+    if (write) {
+        memcpy(&f[3], data, n * 4);
+    }
+    tx_frame(t, write ? 2 : 1, f, write ? 3 + n : 3);
+    got = icm_expect(t, write ? 2 : 1, w);
+    g_assert_cmpuint(got, ==, write ? 3 : 3 + n);
+    if (!write) {
+        memcpy(data, &w[3], n * 4);
+    }
+}
+
+/*
+ * ICM-PROTOCOL.md 13.3, R2-T:81.411: the ORICO's device-connected event,
+ * word for word apart from the connection id and the link info.
+ */
+static void check_connected_orico(const uint32_t *w, unsigned n,
+                                  unsigned flags, unsigned info)
+{
+    static const uint32_t names[] = {
+        0x5341010a, 0x6964654d, 0x02070061, 0x78363432, 0xb8100800,
+        0x11246300, 0x00000002,
+    };
+
+    g_assert_cmpuint(n, ==, 61);
+    g_assert_cmphex(w[0], ==, 0x01000003 | (flags << 8));
+    g_assert_cmphex(w[1], ==, 0x70912700);
+    g_assert_cmphex(w[2], ==, 0x174c608e);
+    g_assert_cmphex(w[3], ==, 0xffffffff);
+    g_assert_cmphex(w[4], ==, 0xffffffff);
+    g_assert_cmphex(w[5] & 0xff, ==, 0x10);
+    g_assert_cmphex(w[5] >> 16, ==, info);
+    for (unsigned i = 0; i < 55; i++) {
+        g_assert_cmphex(w[6 + i], ==, i < ARRAY_SIZE(names) ? names[i] : 0);
+    }
+}
+
+/*
+ * A USB4 device router behind the Alpine Ridge firmware CM: the event
+ * (13.3), get route, the router as the client reads it, the DROM Read
+ * and NVM Sector Size router operations forwarded (13.3), and approve
+ * building the PCIe tunnel (R10).
+ */
+static void test_usb4_device(void)
+{
+    static const uint8_t drom[] = {
+        0x5e, 0x00, 0x27, 0x91, 0x70, 0x8e, 0x60, 0x4c, 0x17, 0x38, 0x4a,
+        0xab, 0xda, 0x01, 0x49, 0x00, 0xb8, 0x00, 0x63, 0x24, 0xe3, 0x02,
+    };
+    uint32_t w[64], v[18], cmd[6];
+    unsigned n, id;
+    T *t = t_start_dev(NULL, NULL, NULL);
+
+    /*
+     * Plugged while the driver is ready, as at R1-T:151.727 (at power-on
+     * with pre-boot off it would have fallen back to USB, R33).
+     */
+    icm_bind(t, w);
+    icm_expect_none(t);
+    qtest_qmp_device_add(t->qts, "usb4-device", "d0",
+                         "{'bus': 'u4.0', 'port': 1, 'dialect': 'usb4', "
+                         "'device-model': 'asm2464', 'drive': 'disk0', "
+                         "'serial': 'QTICM'}");
+    n = icm_expect(t, PDF_ICM_EVENT, w);
+    check_connected_orico(w, n, 0xa8, 0x0811);
+    id = (w[5] >> 8) & 0xff;
+    icm_expect_none(t);
+
+    cmd[0] = 0x0000000a;
+    cmd[1] = 0x00110000;
+    icm_cmd(t, cmd, 2);
+    icm_expect(t, PDF_ICM_RESP, w);
+    g_assert_cmphex(w[0], ==, 0x0100000a);
+    g_assert_cmphex(w[3], ==, 1);
+
+    /* router header as read in R2 (13.3) */
+    ctl_req(t, false, 1, 2, 0, 0, 5, v);
+    g_assert_cmphex(v[0], ==, 0x2463174c);
+    g_assert_cmphex(v[1], ==, 0x001101c0);
+    g_assert_cmphex(v[2], ==, 0x00000001);
+    g_assert_cmphex(v[3], ==, 0x80000000);
+    g_assert_cmphex(v[4], ==, 0x200000fe);
+
+    /* DROM Read through ROUTER_CS_9-26, opcode 0x24 (Spec 8.3.1.2.3) */
+    memset(v, 0, sizeof(v));
+    v[16] = 0x00080000;
+    v[17] = 0x80000024;
+    ctl_req(t, true, 1, 2, 0, 9, 18, v);
+    ctl_req(t, false, 1, 2, 0, 9, 18, v);
+    g_assert_cmphex(v[17], ==, 0x00000024);
+    for (unsigned i = 0; i < sizeof(drom); i++) {
+        g_assert_cmphex((v[i / 4] >> (8 * (i % 4))) & 0xff, ==, drom[i]);
+    }
+    /* NVM Sector Size completes with status 2, as on the Framework */
+    v[0] = 0x80000025;
+    ctl_req(t, true, 1, 2, 0, 26, 1, v);
+    ctl_req(t, false, 1, 2, 0, 26, 1, v);
+    g_assert_cmphex(v[0], ==, 0x02000025);
+    g_assert_false(gate_open(t->qts));
+
+    /* approve with the event's UUID words (R2-T:130.757 layout) */
+    cmd[0] = 0x00000004;
+    cmd[1] = 0x70912700;
+    cmd[2] = 0x174c608e;
+    cmd[3] = 0xffffffff;
+    cmd[4] = 0xffffffff;
+    cmd[5] = 0x10 | (id << 8);
+    icm_cmd(t, cmd, 6);
+    g_assert_cmpuint(icm_expect(t, PDF_ICM_RESP, w), ==, 6);
+    g_assert_cmphex(w[0], ==, 0x01000004);
+    g_assert_true(gate_open(t->qts));
+    wait_stage(t->qts, "inserted");
+
+    /* unplug: device disconnected for link 1 depth 1 */
+    qtest_qmp_device_del_send(t->qts, "d0");
+    n = icm_expect(t, PDF_ICM_EVENT, w);
+    g_assert_cmpuint(n, ==, 2);
+    g_assert_cmphex(w[1], ==, 0x00110000);
+    g_assert_false(gate_open(t->qts));
+    t_stop(t);
+}
+
+/* ---- USB fallback of an unapproved USB4 device (R33, 13.1) ---- */
+
+#define USB_FB          "/machine/peripheral/u4-usb1"
+#define TB_XHCI         "-device usb4-tb3-xhci,id=tbx,bus=pcie.0,addr=0x5"
+#define SEC             (1000 * 1000 * 1000LL)
+
+static bool qom_realized(QTestState *qts, const char *path)
+{
+    QDict *rsp = qtest_qmp(qts, "{'execute': 'qom-get', 'arguments': "
+                           "{'path': %s, 'property': 'realized'}}", path);
+    bool ok = qdict_haskey(rsp, "return") && qdict_get_bool(rsp, "return");
+
+    qobject_unref(rsp);
+    return ok;
+}
+
+/* The fallback device sits on the TB xHCI (R1-D:161.956, bus 4) */
+static bool usb_fallback_on_xhci(QTestState *qts)
+{
+    QDict *rsp;
+    bool ok;
+
+    qtest_clock_step(qts, 1000 * 1000);     /* the host's bottom half */
+    if (!qom_realized(qts, USB_FB)) {
+        return false;
+    }
+    rsp = qtest_qmp(qts, "{'execute': 'qom-get', 'arguments': "
+                    "{'path': %s, 'property': 'parent_bus'}}", USB_FB);
+    ok = strstr(qdict_get_str(rsp, "return"), "tbx") != NULL;
+    qobject_unref(rsp);
+    return ok;
+}
+
+static char *qom_type(QTestState *qts, const char *path)
+{
+    QDict *rsp = qtest_qmp(qts, "{'execute': 'qom-get', 'arguments': "
+                           "{'path': %s, 'property': 'type'}}", path);
+    char *type = g_strdup(qdict_get_try_str(rsp, "return"));
+
+    qobject_unref(rsp);
+    return type;
+}
+
+/*
+ * usb-fallback=uas: the stand-in carries the ORICO's captured USB and
+ * SCSI identity (R1-D:1.524, 1.633757), at SuperSpeed on QEMU's xHCI.
+ */
+static void check_uas_identity(QTestState *qts)
+{
+    g_autofree char *type = qom_type(qts, USB_FB);
+    g_autofree char *usb = qtest_hmp(qts, "info usb");
+    g_autofree char *qtree = qtest_hmp(qts, "info qtree");
+
+    g_assert_cmpstr(type, ==, "usb-uas");
+    g_assert_nonnull(strstr(usb, "Speed 5000 Mb/s, Product ASM246X series"));
+    g_assert_nonnull(strstr(qtree, "dev: scsi-hd"));
+    g_assert_nonnull(strstr(qtree, "vendor = \"ASMT\""));
+    g_assert_nonnull(strstr(qtree, "product = \"ASM246X\""));
+}
+
+/* The named -drive outlives every fallback device (share-rw, R33). */
+static void check_drive_kept(QTestState *qts)
+{
+    QDict *rsp = qtest_qmp(qts, "{'execute': 'query-block'}");
+    QList *l = qdict_get_qlist(rsp, "return");
+    QListEntry *e;
+    bool found = false;
+
+    QLIST_FOREACH_ENTRY(l, e) {
+        QDict *b = qobject_to(QDict, qlist_entry_obj(e));
+        const char *dev = qdict_get_try_str(b, "device");
+
+        found |= dev && !strcmp(dev, "disk0") && qdict_haskey(b, "inserted");
+    }
+    qobject_unref(rsp);
+    g_assert_true(found);
+}
+
+static void orico_add(T *t)
+{
+    qtest_qmp_device_add(t->qts, "usb4-device", "d0",
+                         "{'bus': 'u4.0', 'port': 1, 'dialect': 'usb4', "
+                         "'device-model': 'asm2464', 'drive': 'disk0', "
+                         "'serial': 'QTICM'}");
+}
+
+static uint32_t approve_orico(T *t, unsigned id)
+{
+    uint32_t w[64], cmd[6] = {
+        0x00000004, 0x70912700, 0x174c608e, 0xffffffff, 0xffffffff,
+    };
+
+    cmd[5] = 0x10 | (id << 8);
+    icm_cmd(t, cmd, 6);
+    g_assert_cmpuint(icm_expect(t, PDF_ICM_RESP, w), ==, 6);
+    return w[0];
+}
+
+static void test_usb_fallback(void)
+{
+    uint32_t w[64], cmd[2] = { 0x0000000a, 0x00110000 };
+    unsigned n, id;
+    T *t = t_start_dev(",xhci=tbx", ORICO_DEV, TB_XHCI);
+
+    /*
+     * Pre-boot off: the ORICO is a USB disk on the TB xHCI before the OS
+     * (R1-D:1.51) and the first driver ready announces nothing.
+     */
+    g_assert_true(usb_fallback_on_xhci(t->qts));
+    check_uas_identity(t->qts);
+    icm_bind(t, w);
+    icm_expect_none(t);
+    icm_cmd(t, cmd, 2);
+    icm_expect(t, PDF_ICM_RESP, w);
+    g_assert_cmphex(w[0], ==, 0x0100010a);
+    g_assert_false(gate_open(t->qts));
+
+    /* unplug takes the USB device with it */
+    qtest_qmp_device_del_send(t->qts, "d0");
+    icm_expect_none(t);
+    g_assert_false(usb_fallback_on_xhci(t->qts));
+    check_drive_kept(t->qts);
+
+    /*
+     * Plugged at run time: announced, not approved; 9.385 s later device
+     * disconnected without an unplug, then the USB device (R1-T:151.727
+     * to 161.112).
+     */
+    orico_add(t);
+    n = icm_expect(t, PDF_ICM_EVENT, w);
+    check_connected_orico(w, n, 0xa8, 0x0811);
+    id = (w[5] >> 8) & 0xff;
+    qtest_clock_step(t->qts, 9 * SEC);
+    icm_expect_none(t);
+    g_assert_false(usb_fallback_on_xhci(t->qts));
+    qtest_clock_step(t->qts, SEC / 2);
+    g_assert_cmpuint(icm_expect(t, PDF_ICM_EVENT, w), ==, 2);
+    g_assert_cmphex(w[0], ==, 0x01000004);
+    g_assert_cmphex(w[1], ==, 0x00110000);
+    g_assert_true(usb_fallback_on_xhci(t->qts));
+    /* hot-added: attached only together with its disk */
+    check_uas_identity(t->qts);
+    /* too late: the device is gone from the Thunderbolt side */
+    g_assert_cmphex(approve_orico(t, id), ==, 0x01000104);
+    g_assert_false(gate_open(t->qts));
+
+    /* re-plugged and approved in time: tunnel, no fallback */
+    qtest_qmp_device_del_send(t->qts, "d0");
+    g_assert_false(usb_fallback_on_xhci(t->qts));
+    orico_add(t);
+    n = icm_expect(t, PDF_ICM_EVENT, w);
+    id = (w[5] >> 8) & 0xff;
+    qtest_clock_step(t->qts, 5 * SEC);
+    g_assert_cmphex(approve_orico(t, id), ==, 0x01000004);
+    g_assert_true(gate_open(t->qts));
+    qtest_clock_step(t->qts, 20 * SEC);
+    icm_expect_none(t);
+    g_assert_true(gate_open(t->qts));
+    g_assert_false(usb_fallback_on_xhci(t->qts));
+    t_stop(t);
+
+    /* a TB3 device router (the dock) waits for approval indefinitely */
+    t = t_start_dev(",xhci=tbx", "dialect=tb3,drive=disk0,serial=QTICM",
+                    TB_XHCI);
+    icm_bind(t, w);
+    g_assert_cmpuint(icm_expect(t, PDF_ICM_EVENT, w), ==, 61);
+    qtest_clock_step(t->qts, 20 * SEC);
+    icm_expect_none(t);
+    g_assert_false(usb_fallback_on_xhci(t->qts));
+    t_stop(t);
+
+    /* usb-fallback-ms=0 turns the fallback off */
+    t = t_start_dev(",xhci=tbx,usb-fallback-ms=0", ORICO_DEV, TB_XHCI);
+    icm_bind(t, w);
+    g_assert_cmpuint(icm_expect(t, PDF_ICM_EVENT, w), ==, 61);
+    qtest_clock_step(t->qts, 20 * SEC);
+    icm_expect_none(t);
+    g_assert_false(usb_fallback_on_xhci(t->qts));
+    t_stop(t);
+
+    /* pre-boot on: tunnelled at power-on instead (R2), no USB device */
+    t = t_start_dev(",xhci=tbx,preboot=on", ORICO_DEV, TB_XHCI);
+    g_assert_true(gate_opens(t->qts));
+    g_assert_false(usb_fallback_on_xhci(t->qts));
+    icm_bind(t, w);
+    n = icm_expect(t, PDF_ICM_EVENT, w);
+    check_connected_orico(w, n, 0xa8, 0x0d11);
+    t_stop(t);
+}
+
+/*
+ * R33 at a machine reset (review P1): an approved, tunnelled ORICO with
+ * pre-boot off is in USB mode after the power-on, and its USB disk must
+ * appear once the NVMe endpoint has released the drive, whatever the
+ * order of the two.
+ */
+static void test_usb_fallback_reset(void)
+{
+    uint32_t w[64];
+    unsigned id;
+    bool on = false;
+    T *t = t_start_dev(",xhci=tbx", NULL, TB_XHCI);
+
+    icm_bind(t, w);
+    orico_add(t);
+    icm_expect(t, PDF_ICM_EVENT, w);
+    id = (w[5] >> 8) & 0xff;
+    g_assert_cmphex(approve_orico(t, id), ==, 0x01000004);
+    wait_stage(t->qts, "inserted");
+    g_assert_false(usb_fallback_on_xhci(t->qts));
+
+    qtest_qmp_assert_success(t->qts, "{'execute': 'system_reset'}");
+    qtest_qmp_eventwait(t->qts, "RESET");
+    for (int i = 0; i < 50 && !on; i++) {
+        on = usb_fallback_on_xhci(t->qts);
+        qtest_clock_step(t->qts, 100 * 1000 * 1000);
+    }
+    g_assert_true(on);
+    check_uas_identity(t->qts);
+    g_assert_false(gate_open(t->qts));
+
+    /* and again: a second reset keeps it */
+    qtest_qmp_assert_success(t->qts, "{'execute': 'system_reset'}");
+    qtest_qmp_eventwait(t->qts, "RESET");
+    on = false;
+    for (int i = 0; i < 50 && !on; i++) {
+        on = usb_fallback_on_xhci(t->qts);
+        qtest_clock_step(t->qts, 100 * 1000 * 1000);
+    }
+    g_assert_true(on);
+    t_stop(t);
+}
+
+/* i440FX (the legacy Windows machine) with the ORICO in USB mode */
+static QTestState *pc_fallback_start(const char *host_opts)
+{
+    QTestState *qts;
+    bool on = false;
+
+    qts = qtest_initf("-machine pc "
+                      "-global PIIX4_PM.acpi-pci-hotplug-with-bridge-"
+                      "support=off "
+                      "-drive if=none,id=disk0,file=null-co://,format=raw "
+                      "-device usb4-tunnel-bridge,id=tp0,bus=pci.0,"
+                      "addr=0x5,chassis_nr=1,msi=off,settle-ms=200 "
+                      "-device usb4-host,id=u4,bus=pci.0,addr=0x4,"
+                      "tunnel-port=tp0,profile=tb3-alpine-ridge,msi=off,"
+                      "msix=off,xhci=tbx%s "
+                      "-device usb4-tb3-xhci,id=tbx,bus=pci.0,addr=0x6 "
+                      "-device usb4-device,id=d0,bus=u4.0,port=1,%s",
+                      host_opts, ORICO_DEV);
+    for (int i = 0; i < 50 && !on; i++) {
+        on = usb_fallback_on_xhci(qts);
+    }
+    g_assert_true(on);
+    return qts;
+}
