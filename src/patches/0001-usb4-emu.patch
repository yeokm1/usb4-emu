+/*
+ * R2: BAR0 values with the firmware running (ICM-PROTOCOL.md 2.1, 13.5).
+ * At power-on the outbound mailbox reads 0x800003f0 and DMA misc
+ * 0x01000012 (Windows 98 A1P1_OR PCIDUMPN, the P14s ORICO runs R1-R4,
+ * mmio dumps "-1-initial"); the low nibble becomes 5 once the NHI has
+ * been in D3 (R1 watch at 145.874), and DMA misc bit 2 is the client's
+ * auto-clear enable (R7), so 0x01000016 is a value seen after a client
+ * bound.
+ */
+#define TB3_AR_FW_STS               0x800001a1u
+#define TB3_AR_OUTMAIL              0x800003f0u
+#define TB3_AR_OUTMAIL_AFTER_D3     0x00000005u
+#define TB3_AR_DMA_MISC             0x01000012u
+#define TB3_AR_DMA_MISC_AUTO_CLEAR  (1u << 2)    /* R7 */
+/*
+ * Interrupt Throttling Rate (Spec Table 12-34): both captured Intel hosts
+ * read Interval (bits 15:0) 0x1f4 in every entry, whatever the client
+ * wrote (CAPTURE-VS-LINUX.md AR-7, ADL-10, contradiction C1).
+ */
+#define INTEL_ITR_INTERVAL          0x000001f4u
+#define TB3_INMAIL_ERROR            (1u << 30)   /* R3 */
+#define TB3_INMAIL_REQUEST          (1u << 31)
+/* R1: MSI-X in BAR1, 4 KiB, table at 0, PBA at 0xfa0 */
+#define TB3_AR_BAR1_SIZE            0x1000
+#define TB3_AR_MSIX_PBA             0xfa0
+
+/* USB4 DVSEC (USB4 DVSEC Specification 1.0 section 3, 4). */
+#define USB4_DVSEC_OFFSET       0x10c
+#define USB4_DVSEC_LEN          0x10
+#define USB4_DVSEC_VENDOR_USBIF 0x1ec0
+#define USB4_DVSEC_ID_USBIF     0x01
+#define USB4_DVSEC_PORT_NHI     0x0
+#define USB4_DSN_OFFSET         0x100
