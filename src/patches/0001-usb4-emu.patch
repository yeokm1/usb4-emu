+/*
+ * R30, R33 (ICM-PROTOCOL.md 13.1): which controller functions the
+ * firmware shows under BIOS Assist, per attached device and pre-boot.
+ */
+static void test_assist_functions(void)
+{
+    QTestState *qts;
+
+    /*
+     * Assist on, pre-boot off, the ORICO: NHI hidden, the xHCI present
+     * but without resources (W98 A1P0_OR command 0, BARs 0, line 0xff;
+     * R3-D:1.148), the ORICO a USB device on it, unusable.
+     */
+    qts = switch_start(",bios-assist=on", "dialect=usb4,device-model=asm2464");
+    g_assert_cmphex(cfg_rd(qts, 3, 0, 0), ==, 0xffffffff);
+    g_assert_cmphex(cfg_rd(qts, 5, 0, 0), ==, 0x15c18086);
+    g_assert_false(xhci_bar0_sizable(qts));
+    cfg_wr(qts, 5, 0, 0x04, 0x0007);
+    g_assert_cmphex(cfg_rd(qts, 5, 0, 0x04) & 0x7, ==, 0);
+    g_assert_cmphex(cfg_rd(qts, 5, 0, 0x3c) & 0xff, ==, 0xff);
+    g_assert_true(usb_fallback_on_xhci(qts));
+    /* the NHI stays hidden for the session */
+    qtest_clock_step(qts, 30 * SEC);
+    g_assert_cmphex(cfg_rd(qts, 3, 0, 0), ==, 0xffffffff);
+    qtest_quit(qts);
+
+    /* the same with the TS3 Plus dock: NHI present, xHCI hidden (12.3) */
+    qts = switch_start(",bios-assist=on", "dialect=tb3");
+    g_assert_cmphex(cfg_rd(qts, 3, 0, 0), ==, 0x15bf8086);
+    g_assert_cmphex(cfg_rd(qts, 5, 0, 0), ==, 0xffffffff);
+    qtest_quit(qts);
+
+    /* Assist on, pre-boot on, the ORICO: NHI present, xHCI hidden (R4) */
+    qts = switch_start(",bios-assist=on,preboot=on",
+                       "dialect=usb4,device-model=asm2464");
+    g_assert_cmphex(cfg_rd(qts, 3, 0, 0), ==, 0x15bf8086);
+    g_assert_cmphex(cfg_rd(qts, 5, 0, 0), ==, 0xffffffff);
+    g_assert_false(usb_fallback_on_xhci(qts));
+    qtest_quit(qts);
+
+    /*
+     * Assist off, pre-boot off, the ORICO: both present, the xHCI usable
+     * with the ORICO on it (R1)
