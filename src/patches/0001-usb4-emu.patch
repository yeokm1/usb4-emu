+ */
+const char *usb4_fabric_hop8_path_check(USB4Router *sr, USB4Adapter *src,
+                                        USB4Adapter *dst);
+
+/*
+ * usb4-icm.c, called by the fabric when an ICM is attached
+ * (docs/ARCHITECTURE.md 4.2: in the AR profile the ICM consumes hot
+ * plug events internally, no native hot plug packet reaches the guest).
+ */
+void usb4_icm_hotplug(USB4ICM *icm, USB4Router *r, unsigned adapter,
+                      bool unplug);
+/* Power-on / host router reset: the firmware re-enumerates the fabric. */
+void usb4_icm_reset(USB4ICM *icm);
+
+/* usb4-fabric-usb3.c: inputs of the USB3 Gen X tunnel of router @r */
+void usb4_fabric_usb3_inputs(USB4Router *r, USB4TunnelInputs *in,
+                             const char **why_down, const char **why_up);
+
+#endif /* HW_USB4_FABRIC_INT_H */
diff --git a/hw/usb4/usb4-fabric-usb3.c b/hw/usb4/usb4-fabric-usb3.c
new file mode 100644
index 0000000000000000000000000000000000000000..ed7a7352dd7566835d05a69e004538efb869bf95
--- /dev/null
+++ b/hw/usb4/usb4-fabric-usb3.c
@@ -0,0 +1,80 @@
+/*
+ * USB4 fabric - USB3 Gen X tunnel evaluation
+ *
+ * Copyright (c) 2026 usb4-emu contributors
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Written from scratch for the usb4-emu project from the USB4
+ * Connection Manager Guide 2.0 ("Guide") section 5.5 and the USB4
+ * Specification 2.0 ("Spec") Table 8-14 and section 9.1.2.
+ *
+ * Each device router's USB3 tunnel runs from the USB3 Gen X Down adapter
+ * its parent router (host, or a device router in a daisy chain) pairs
+ * with the port the router hangs off, to its own USB3 Gen X Up adapter.
+ * It is up when the conditions the PCIe tunnel evaluator checks hold for
+ * that pair (usb4_tunnel_evaluate()):
+ *
+ *  1. router connected to the host, lane 0 of its upstream link in CL0;
+ *  2. parent ready (host router: enumerated; device router: as below);
+ *     the router itself Configuration Valid, Configuration Ready and
+ *     USB3 Tunneling On (ROUTER_CS_5.UTO, Guide 3.2.3: "must set USB3
+ *     Tunneling");
+ *  3. HopID 8 paths both ways with buffers at each lane ingress (Guide
+ *     5.5.1 steps 2-3, Table 5-4);
+ *  4. ADP_USB3_GX_CS_0.Path Enable on both adapters (Guide 5.5.1 steps
+ *     4-5; teardown clears it first, Guide 5.5.2);
+ *  5. in a daisy chain, the parent's own USB3 tunnel is up (its internal
+ *     USB3 hub is reachable).
+ *
+ * The fabric evaluates it together with the PCIe tunnel
+ * (usb4_fabric_reevaluate()).
+ * Transitions are reported to the device router object
+ * (usb4_device_usb3_tunnel()), which attaches or detaches the QEMU USB
+ * devices behind the enclosure from a bottom half.
+ */
+#include "qemu/osdep.h"
+#include "usb4-fabric-int.h"
+#include "trace.h"
+
+/* CV, CR and UTO set: the router may carry a USB3 tunnel. */
+static bool usb3_ready(USB4Router *r)
+{
+    return usb4_router_enumerated(r) &&
+           (r->cs[5] & (1u << 31)) &&          /* CV */
+           (r->cs[5] & (1u << 25)) &&          /* UTO */
+           (r->cs[6] & (1u << 25));            /* CR */
+}
+
+void usb4_fabric_usb3_inputs(USB4Router *r, USB4TunnelInputs *in,
+                             const char **why_down, const char **why_up)
+{
+    USB4Port *dfp = r->up_port->partner;
+    USB4Router *pr = dfp ? dfp->router : NULL;
+    USB4Adapter *pdown = pr ? usb4_router_find_kind(pr, USB4_ADP_USB3_DOWN,
+                                                    dfp->index) : NULL;
+    USB4Adapter *dup = usb4_router_find_kind(r, USB4_ADP_USB3_UP, 1);
+
+    memset(in, 0, sizeof(*in));
+    *why_down = *why_up = "not connected";
+    in->device_attached = usb4_fabric_router_connected(r);
+    in->lanes_up = usb4_lane_up(r->up_port->lane[0]);
+    in->device_ready_for_pcie = usb3_ready(r);
+    in->dev_pcie_enabled = dup && (dup->cs[USB4_ADP_CAP_USB3] & (1u << 31));
+    if (!pr) {
+        return;
+    }
+    in->host_ready_for_pcie = pr->is_host ? usb4_router_enumerated(pr)
+                                          : usb3_ready(pr);
+    in->host_pcie_enabled = pdown &&
+        (pdown->cs[USB4_ADP_CAP_USB3] & (1u << 31));
+    in->upstream_tunnel_up = pr->is_host ||
+                             pr->usb3.state == USB4_TUNNEL_UP;
+    if (!dup) {
+        *why_down = *why_up = "device router has no USB3 Up adapter";
+    } else if (pdown) {
+        *why_down = usb4_fabric_hop8_path_check(pr, pdown, dup);
+        *why_up = usb4_fabric_hop8_path_check(r, dup, pdown);
+        in->path_down_valid = !*why_down;
+        in->path_up_valid = !*why_up;
+    }
+}
diff --git a/hw/usb4/usb4-fabric.c b/hw/usb4/usb4-fabric.c
new file mode 100644
index 0000000000000000000000000000000000000000..2bf9a09e71bb853b43fb92bc7e660919a6d1cb63
--- /dev/null
+++ b/hw/usb4/usb4-fabric.c
@@ -0,0 +1,1503 @@
+/*
+ * USB4 fabric: router tree, control packet routing and processing,
+ * hot plug events, attach/detach and PCIe tunnel evaluation
+ *
+ * Copyright (c) 2026 usb4-emu contributors
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Written from scratch for the usb4-emu project from the USB4
+ * Specification 2.0 ("Spec") chapter 6 and the USB4 Connection Manager
+ * Guide 2.0 ("Guide") chapters 3 to 5. See docs/ARCHITECTURE.md 4.2/4.3.
+ */
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "usb4-fabric-int.h"
+#include "trace.h"
+
+/* ------------------------------------------------------------------ */
+/* Packets towards the Connection Manager                               */
+/* ------------------------------------------------------------------ */
+
+/*
+ * Route String of a packet a router sends to the CM (Spec 6.4.2.2): the
+ * router's TopologyID with the CM bit set; 0 for notifications from an
+ * uninitialized router.
+ */
+static uint64_t upstream_route(USB4Router *r)
+{
+    uint64_t topo = usb4_router_enumerated(r) ? usb4_router_topology(r) : 0;
+
+    return topo | USB4_ROUTE_CM_BIT;
+}
+
+static void send_notification(USB4Router *r, unsigned event, unsigned info,
+                              unsigned pg)
+{
+    uint64_t route = upstream_route(r);
+    uint32_t dw[3];
+
+    /*
+     * Spec Table 6-6. Sequence bit stays 0: no notification that this
+     * model sends requires an acknowledgment.
+     */
+    dw[0] = route >> 32;
+    dw[1] = (uint32_t)route;
+    dw[2] = (event & 0xff) | ((info & 0x3f) << 8) | ((pg & 3) << 30);
+    trace_usb4_ctl_notify(route, usb4_ctl_event_name(event), event, info);
+    usb4_ctl_send(r->fabric->host, USB4_PDF_NOTIFY, dw, 3);
+}
+
+void usb4_fabric_notify(USB4Router *r, unsigned event, unsigned info)
+{
+    send_notification(r, event, info, USB4_PG_NONE);
+}
+
+/* ------------------------------------------------------------------ */
+/* Hot Plug Event machine, Spec 6.8 and Guide 4.3                       */
+/* ------------------------------------------------------------------ */
+
+#define HP_FAST_RETRIES  100
+#define HP_SLOW_MS       100
+
+static void hp_send_head(USB4Router *r)
+{
+    USB4HPEvent *e = &r->hpq[0];
+    uint64_t route = upstream_route(r);
+    uint32_t dw[3];
+    unsigned timeout = r->cs[4] & 0xff;
+
+    /* Spec Table 6-9 */
+    dw[0] = route >> 32;
+    dw[1] = (uint32_t)route;
+    dw[2] = (e->adapter & 0x3f) | (e->unplug ? 1u << 31 : 0);
+    trace_usb4_hotplug_send(route, e->adapter, e->unplug, r->hp_retries);
+    usb4_ctl_send(r->fabric->host, USB4_PDF_HOTPLUG, dw, 3);
+
+    /*
+     * Retransmit every Notification Timeout ms until acknowledged
+     * (Spec 6.8). After HP_FAST_RETRIES unanswered copies the model
+     * slows down to keep traces readable; a CM must not depend on the
+     * retransmit cadence.
+     */
+    if (!timeout) {
+        timeout = 10;
+    }
+    usb4_timer_mod_ms(r->hp_timer,
+                      r->hp_retries < HP_FAST_RETRIES ? timeout : HP_SLOW_MS);
+}
+
+static void hp_kick(USB4Router *r)
+{
+    if (r->hp_outstanding || !r->hpq_len || !usb4_router_enumerated(r)) {
+        return;
+    }
+    r->hp_outstanding = true;
+    r->hp_retries = 0;
+    hp_send_head(r);
+}
+
+void usb4_fabric_hp_timer(void *opaque)
+{
+    USB4Router *r = opaque;
+
+    if (!r->hp_outstanding) {
+        return;
+    }
+    r->hp_retries++;
+    hp_send_head(r);
+}
+
+void usb4_fabric_hp_event(USB4Router *r, unsigned adapter, bool unplug)
+{
+    unsigned first = r->hp_outstanding ? 1 : 0;
+
+    if (r->fabric->icm) {
+        /* AR profile: the firmware CM consumes the event (ARCH 4.2). */
+        usb4_icm_hotplug(r->fabric->icm, r, adapter, unplug);
+        return;
+    }
+
+    /*
+     * Spec 6.8 implementation note: a plug and an unplug for the same
+     * adapter that are both still unsent cancel each other out.
+     */
+    for (unsigned i = r->hpq_len; i-- > first;) {
+        if (r->hpq[i].adapter == adapter) {
+            if (r->hpq[i].unplug != unplug) {
+                memmove(&r->hpq[i], &r->hpq[i + 1],
+                        (r->hpq_len - i - 1) * sizeof(r->hpq[0]));
+                r->hpq_len--;
+                trace_usb4_hotplug_cancel(usb4_router_topology(r), adapter,
+                                          unplug);
+                return;
+            }
+            break;
+        }
+    }
+    if (r->hpq_len == USB4_HP_QUEUE) {
+        trace_usb4_hotplug_overflow(usb4_router_topology(r), adapter, unplug);
+        return;
+    }
+    r->hpq[r->hpq_len].adapter = adapter;
+    r->hpq[r->hpq_len].unplug = unplug;
+    r->hpq_len++;
+    trace_usb4_hotplug_queue(usb4_router_topology(r), adapter, unplug,
+                             r->hpq_len);
+    if (!r->fabric->in_tx) {
+        hp_kick(r);
+    }
+}
+
+static void hp_ack(USB4Router *r, unsigned adapter, unsigned pg)
+{
+    bool match = r->hp_outstanding && r->hpq[0].adapter == adapter &&
+                 (pg == USB4_PG_UNPLUG) == r->hpq[0].unplug;
+
+    trace_usb4_hotplug_ack(usb4_router_topology(r), adapter, pg, match);
+    if (!match) {
+        return;     /* already acknowledged or unknown: ignore (6.8) */
+    }
+    usb4_timer_del(r->hp_timer);
+    r->hp_outstanding = false;
+    memmove(&r->hpq[0], &r->hpq[1], (r->hpq_len - 1) * sizeof(r->hpq[0]));
+    r->hpq_len--;
+    hp_kick(r);
+}
+
+/*
+ * Bring the reported plug state of the DFP lane adapters of @p in line
+ * with the lane states: a lane in CL0 that entered Training from CLd is
+ * reported plugged (Spec 4.2.1.x, 6.8.1.1); a lane that leaves CL0, or
+ * lane 1 after a successful bonding (Spec 4.1.2.3), is reported
+ * unplugged. Nothing is reported by an uninitialized router (6.8.1.2)
+ * or for an adapter with Disable Hot Plug Events set.
+ */
+static void hp_reconcile(USB4Port *p)
+{
+    USB4Router *r = p->router;
+
+    if (!p->dfp) {
+        return;
+    }
+    for (int l = 0; l < 2; l++) {
+        USB4Adapter *a = p->lane[l];
+        bool plugged = usb4_lane_up(a) && !(l == 1 && p->bonded);
+
+        if (!usb4_router_enumerated(r)) {
+            a->reported_plugged = false;
+            continue;
+        }
+        if (plugged == a->reported_plugged) {
+            continue;
+        }
+        a->reported_plugged = plugged;
+        if ((a->cs[5] & (1u << 31)) ||
+            (r->dialect == USB4_DIALECT_TB3 &&
+             !usb4_router_tb3_hp_enabled(r, a))) {
+            trace_usb4_hotplug_suppressed(usb4_router_topology(r), a->num,
+                                          !plugged);
+            continue;
+        }
+        usb4_fabric_hp_event(r, a->num, !plugged);
+    }
+}
+
+/*
+ * Router just became Enumerated: report every connected DFP adapter
+ * (Spec 6.8.1.2).
+ */
+void usb4_fabric_hp_enumerated(USB4Router *r)
+{
+    for (unsigned i = 0; i < r->nports; i++) {
+        hp_reconcile(&r->ports[i]);
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* Link state changes                                                   */
+/* ------------------------------------------------------------------ */
+
+static void port_link_changed(USB4Port *dfp, bool was_up, bool up)
+{
+    USB4Router *r = dfp->router;
+
+    if (was_up && !up) {
+        /*
+         * Disconnect: Lock set (Table 8-9); the device router behind the
+         * port enters Uninitialized Unplugged and restores all of its
+         * configuration spaces (Spec 6.3.1).
+         */
+        dfp->bonded = false;
+        if (r->dialect != USB4_DIALECT_TB3) {
+            /* tb3 lane adapters have no Lock bit (ICM-PROTOCOL.md 5.1) */
+            dfp->lane[0]->cs[4] |= 1u << 31;
+            dfp->lane[1]->cs[4] |= 1u << 31;
+        }
+        if (dfp->partner) {
+            dfp->partner->bonded = false;
+            usb4_router_reset(dfp->partner->router);
+            if (dfp->partner->router->asm2464) {
+                usb4_router_asm2464_link_lost(dfp->partner->router);
+            }
+        }
+        trace_usb4_link(usb4_router_topology(r), dfp->index, "down");
+    } else if (!was_up && up) {
+        /* Lane Initialization: Gen 2/3 lanes come up unbonded (7.3). */
+        dfp->bonded = false;
+        dfp->partner->bonded = false;
+        trace_usb4_link(usb4_router_topology(r), dfp->index, "up");
+    }
+}
+
+/* Re-check one downstream facing port's link and hot plug state. */
+static void sync_dfp(USB4Port *dfp)
+{
+    bool up = usb4_port_link_up(dfp);
+    bool was_up = dfp->link_cached;
+
+    dfp->link_cached = up;
+    if (was_up != up) {
+        port_link_changed(dfp, was_up, up);
+    }
+    hp_reconcile(dfp);
+}
+
+/*
+ * Bring every DFP in the fabric in line with its link. Parents precede
+ * children in f->dr[], so a link that drops resets the router below it
+ * before that router's own downstream links are looked at (Spec 6.3.1:
+ * a device router whose UFP disconnects drops all its lanes to CLd).
+ */
+static void sync_links(USB4Fabric *f)
+{
+    for (unsigned i = 0; i < f->hr->nports; i++) {
+        sync_dfp(&f->hr->ports[i]);
+    }
+    for (unsigned d = 0; d < f->ndr; d++) {
+        USB4Router *r = f->dr[d];
+
+        for (unsigned i = 1; i < r->nports; i++) {
+            sync_dfp(&r->ports[i]);
+        }
+    }
+}
+
+void usb4_fabric_port_changed(USB4Port *p)
+{
+    USB4Fabric *f = p->router->fabric;
+
+    sync_links(f);
+    usb4_fabric_reevaluate(f, USB4_TUNNEL_REASON_SURPRISE);
+}
+
+/*
+ * A USB4 device router that is not given a PCIe tunnel falls back to USB
+ * (docs/ICM-PROTOCOL.md 13.1): to the fabric its USB4 link is down, as
+ * after an unplug, though the device stays attached.
+ */
+void usb4_fabric_set_usb_mode(USB4Router *r, bool on, bool quiet)
+{
+    USB4Port *ufp = r->up_port;
+
+    if (r->is_host || !ufp || ufp->usb_mode == on) {
+        return;
+    }
+    ufp->usb_mode = on;
+    trace_usb4_router_state(r->phys_route, "usb-mode", on);
+    if (!quiet) {
+        usb4_fabric_port_changed(ufp);
+    } else if (ufp->partner) {
+        ufp->partner->link_cached = usb4_port_link_up(ufp->partner);
+    }
+}
+
+bool usb4_fabric_port_usb_mode(USB4Fabric *f, unsigned port)
+{
+    USB4Port *q;
+
+    if (!f || port < 1 || port > f->hr->nports) {
+        return false;
+    }
+    q = f->hr->ports[port - 1].partner;
+    return q && q->usb_mode;
+}
+
+/* ------------------------------------------------------------------ */
+/* Tunnel evaluation, docs/ARCHITECTURE.md 4.3                          */
+/* ------------------------------------------------------------------ */
+
+static bool path_entry(USB4Adapter *a, unsigned hop, uint32_t *dw0,
+                       uint32_t *dw1)
+{
+    if (!a || hop == 0 || hop > a->max_hop) {
+        return false;
+    }
+    *dw0 = a->path[2 * hop];
+    *dw1 = a->path[2 * hop + 1];
+    return *dw0 & (1u << 31);           /* PATH_CS_0.Valid */
+}
+
+#define PATH_OUT_HOP(dw0)  ((dw0) & 0x7f)
+#define PATH_OUT_ADP(dw0)  (((dw0) >> 11) & 0x3f)
+#define PATH_CREDITS(dw0)  (((dw0) >> 17) & 0x7f)
+#define PATH_ISE(dw1)      (((dw1) >> 26) & 1)
+
+/*
+ * Follow one PCIe path (Guide 5.3.1, Table 5-2) or USB3 Gen X path
+ * (Guide 5.5.1, Table 5-4) from the HopID 8 entry
+ * of PCIe adapter @src in router @sr to PCIe adapter @dst, hop by hop:
+ * each egress is a lane 0 adapter whose link is up, each lane ingress
+ * entry for the HopID used on that link is valid with buffers
+ * allocated, and the last hop egresses to @dst with HopID 8. A Guide
+ * PCIe or USB3 path crosses exactly one link, but transit lane hops are
+ * followed too. Returns NULL if valid, else why not (for traces).
+ */
+const char *usb4_fabric_hop8_path_check(USB4Router *sr, USB4Adapter *src,
+                                        USB4Adapter *dst)
+{
+    USB4Router *rt = sr;
+    USB4Adapter *in = src, *out;
+    unsigned hop = USB4_PCIE_HOPID;
+    uint32_t e0, e1;
+
+    for (unsigned n = 0; n < 2 * USB4_MAX_DEPTH + 2; n++) {
+        if (!path_entry(in, hop, &e0, &e1)) {
+            return in == src ? "protocol adapter HopID 8 entry not valid"
+                             : "lane adapter ingress entry not valid";
+        }
+        if (in != src && !PATH_CREDITS(e0) && !PATH_ISE(e1)) {
+            return "no buffers allocated at lane adapter ingress";
+        }
+        out = usb4_router_adapter(rt, PATH_OUT_ADP(e0));
+        hop = PATH_OUT_HOP(e0);
+        if (out && out == dst) {
+            return hop == USB4_PCIE_HOPID ? NULL
+                   : "egress to the protocol adapter is not HopID 8";
+        }
+        if (!out || out->kind != USB4_ADP_LANE || out->lane != 0) {
+            return in == src ? "protocol adapter egress is not a lane 0 "
+                               "adapter"
+                   : "lane adapter egress is not the protocol adapter";
+        }
+        if (hop < 8) {
+            return "HopID below 8 on a link";
+        }
+        if (!usb4_lane_up(out)) {
+            return "egress link down";
+        }
+        in = out->port->partner->lane[0];
+        rt = in->port->router;
+    }
+    return "path loops";
+}
+
+/* The router @r hangs off, or NULL when unplugged. */
+USB4Router *usb4_fabric_parent_router(USB4Router *r)
+{
+    USB4Port *dfp = r->up_port ? r->up_port->partner : NULL;
+
+    return dfp ? dfp->router : NULL;
+}
+
+/* @r is linked to the host router through every level. */
+bool usb4_fabric_router_connected(USB4Router *r)
+{
+    while (r && !r->is_host) {
+        r = usb4_fabric_parent_router(r);
+    }
+    return r != NULL;
+}
+
+/*
+ * Inputs of the PCIe tunnel of device router @r: from the PCIe Down
+ * adapter its parent pairs with the DFP @r is plugged into, to @r's PCIe
+ * Up adapter. The "host" inputs refer to that parent router, which is
+ * the host router or (daisy chain) another device router.
+ */
+static void tunnel_inputs(USB4Router *r, USB4TunnelInputs *in,
+                          const char **why_down, const char **why_up)
+{
+    USB4Port *dfp = r->up_port->partner;
+    USB4Router *pr = dfp ? dfp->router : NULL;
+    USB4Adapter *pdown = pr ? usb4_router_find_kind(pr, USB4_ADP_PCIE_DOWN,
+                                                    dfp->index) : NULL;
+    USB4Adapter *dup = usb4_router_find_kind(r, USB4_ADP_PCIE_UP, 1);
+
+    memset(in, 0, sizeof(*in));
+    *why_down = *why_up = "not connected";
+    in->device_attached = usb4_fabric_router_connected(r);
+    in->lanes_up = usb4_lane_up(r->up_port->lane[0]);
+    in->device_ready_for_pcie = usb4_router_ready_for_pcie(r);
+    in->dev_pcie_enabled = dup &&
+        (dup->cs[usb4_adapter_pcie_cap(dup)] & (1u << 31));
+    if (!pr) {
+        return;
+    }
+    in->host_ready_for_pcie = usb4_router_ready_for_pcie(pr);
+    in->host_pcie_enabled = pdown &&
+        (pdown->cs[usb4_adapter_pcie_cap(pdown)] & (1u << 31));
+    in->upstream_tunnel_up = pr->is_host ||
+                             pr->tunnel.state == USB4_TUNNEL_UP;
+    if (pdown && dup) {
+        *why_down = usb4_fabric_hop8_path_check(pr, pdown, dup);
+        *why_up = usb4_fabric_hop8_path_check(r, dup, pdown);
+        in->path_down_valid = !*why_down;
+        in->path_up_valid = !*why_up;
+    }
+}
+
+/*
+ * Tunnel target behind the PCIe Down adapter @r's tunnel starts at: a
+ * host port's tunnel port or, in a daisy chain, what the parent device
+ * exposes for its downstream port. A tunnel going down after the cable
+ * was pulled uses the DFP it came up through.
+ */
+static USB4TunnelPort *tunnel_target(USB4Fabric *f, USB4Router *r)
+{
+    USB4Port *dfp = r->up_port->partner;
+
+    if (!dfp) {
+        dfp = r->tunnel_dfp;
+    }
+    if (!dfp || !f->host) {
+        return NULL;
+    }
+    if (dfp->router->is_host) {
+        return usb4_host_get_port_tunnel(f->host, dfp->index);
+    }
+    return dfp->router->dev ?
+           usb4_device_get_pcie_down_target(dfp->router->dev,
+                                            dfp->index - 1) : NULL;
+}
+
+static void tunnel_fire(USB4Fabric *f, USB4Router *r)
+{
+    USB4TunnelTrack *t = &r->tunnel;
+    USB4TunnelPort *tp;
+
+    trace_usb4_tunnel_transition(r->phys_route,
+                                 t->state == USB4_TUNNEL_UP ? "up" : "down",
+                                 t->reason);
+    if (t->state == USB4_TUNNEL_UP) {
+        r->tunnel_dfp = r->up_port->partner;
+    }
+    tp = tunnel_target(f, r);
+    if (tp) {
+        usb4_tunnel_port_set_state(tp, t->dev, t->state, t->reason);
+    }
+    if (t->state == USB4_TUNNEL_DOWN) {
+        t->dev = NULL;
+        r->tunnel_dfp = NULL;
+    }
+}
+
+static void usb3_fire(USB4Router *r)
+{
+    USB4TunnelTrack *t = &r->usb3;
+
+    trace_usb4_usb3_transition(r->phys_route,
+                               t->state == USB4_TUNNEL_UP ? "up" : "down",
+                               t->reason);
+    if (t->dev) {
+        usb4_device_usb3_tunnel(t->dev, t->state, t->reason);
+    }
+    if (t->state == USB4_TUNNEL_DOWN) {
+        t->dev = NULL;
+    }
+}
+
+/*
+ * Evaluate one kind of tunnel (PCIe, or USB3 Gen X when @usb3) of every
+ * device router, parents first so a child sees its parent's new state.
+ * Down transitions are then signalled leaf first and up transitions
+ * parent first, so the consumer never sees a child tunnel up below a
+ * parent tunnel that is down.
+ */
+static void reevaluate_kind(USB4Fabric *f, bool usb3, USB4TunnelReason why)
+{
+    for (unsigned d = 0; d < f->ndr; d++) {
+        USB4Router *r = f->dr[d];
+        USB4TunnelTrack *t = usb3 ? &r->usb3 : &r->tunnel;
+        USB4TunnelInputs in;
+        USB4TunnelState st;
+        const char *wd, *wu;
+
+        if (usb3) {
+            usb4_fabric_usb3_inputs(r, &in, &wd, &wu);
+        } else {
+            tunnel_inputs(r, &in, &wd, &wu);
+        }
+        if (memcmp(&in, &t->last, sizeof(in)) || wd != t->why_down ||
+            wu != t->why_up) {
+            t->last = in;
+            t->why_down = wd;
+            t->why_up = wu;
+            if (usb3) {
+                trace_usb4_usb3_inputs(r->phys_route, in.device_attached,
+                                       in.lanes_up, in.host_ready_for_pcie,
+                                       in.device_ready_for_pcie,
+                                       in.path_down_valid, in.path_up_valid,
+                                       in.host_pcie_enabled,
+                                       in.dev_pcie_enabled,
+                                       in.upstream_tunnel_up);
+                trace_usb4_usb3_path(r->phys_route, wd ? wd : "ok",
+                                     wu ? wu : "ok");
+            } else {
+                trace_usb4_tunnel_inputs(r->phys_route, in.device_attached,
+                                         in.lanes_up, in.host_ready_for_pcie,
+                                         in.device_ready_for_pcie,
+                                         in.path_down_valid,
+                                         in.path_up_valid,
+                                         in.host_pcie_enabled,
+                                         in.dev_pcie_enabled,
+                                         in.upstream_tunnel_up);
+                trace_usb4_tunnel_path(r->phys_route, wd ? wd : "ok",
+                                       wu ? wu : "ok");
+            }
+        }
+        st = usb4_tunnel_evaluate(&in);
+        t->prev = t->state;
+        if (st == t->state) {
+            continue;
+        }
+        t->state = st;
+        if (st == USB4_TUNNEL_UP) {
+            t->dev = r->dev;
+            t->reason = USB4_TUNNEL_REASON_UP;
+            if (!usb3) {
+                r->pcie_trained = true;     /* tb3 PCIe adapters' bit 19 */
+            }
+        } else if (!in.device_attached || !in.lanes_up) {
+            t->reason = USB4_TUNNEL_REASON_SURPRISE;
+        } else {
+            t->reason = why;
+        }
+    }
+    for (unsigned d = f->ndr; d-- > 0;) {
+        USB4Router *r = f->dr[d];
+        USB4TunnelTrack *t = usb3 ? &r->usb3 : &r->tunnel;
+
+        if (t->prev != t->state && t->state == USB4_TUNNEL_DOWN) {
+            t->prev = t->state;
+            if (usb3) {
+                usb3_fire(r);
+            } else {
+                tunnel_fire(f, r);
+            }
+        }
+    }
+    for (unsigned d = 0; d < f->ndr; d++) {
+        USB4Router *r = f->dr[d];
+        USB4TunnelTrack *t = usb3 ? &r->usb3 : &r->tunnel;
+
+        if (t->prev != t->state && t->state == USB4_TUNNEL_UP) {
+            t->prev = t->state;
+            if (usb3) {
+                usb3_fire(r);
+            } else {
+                tunnel_fire(f, r);
+            }
+        }
+    }
+}
+
+void usb4_fabric_reevaluate(USB4Fabric *f, USB4TunnelReason why)
+{
+    if (f->eval_hold) {
+        return;     /* usb4_fabric_reset() evaluates once at the end */
+    }
+    reevaluate_kind(f, false, why);
+    reevaluate_kind(f, true, why);
+}
+
+/*
+ * ADP_PCIE_CS_0 LTSSM and ADP_USB3_GX_CS_4 link state: is the tunnel
+ * through this protocol adapter up? An Up adapter carries its router's
+ * own tunnel; a Down adapter the tunnel of the router on its port.
+ */
+bool usb4_fabric_adapter_up(USB4Router *r, USB4Adapter *a)
+{
+    bool usb3 = a->kind == USB4_ADP_USB3_UP || a->kind == USB4_ADP_USB3_DOWN;
+    USB4Router *c;
+    USB4Port *p;
+
+    if (a->kind == USB4_ADP_PCIE_UP || a->kind == USB4_ADP_USB3_UP) {
+        c = r->is_host ? NULL : r;
+    } else if ((a->kind == USB4_ADP_PCIE_DOWN ||
+                a->kind == USB4_ADP_USB3_DOWN) &&
+               a->usb4_port && a->usb4_port <= r->nports) {
+        p = r->ports[a->usb4_port - 1].partner;
+        c = p ? p->router : NULL;
+    } else {
+        return false;
+    }
+    return c && (usb3 ? c->usb3.state : c->tunnel.state) == USB4_TUNNEL_UP;
+}
+
+USB4TunnelState usb4_fabric_chained_tunnel(USB4Fabric *f, USB4Device *parent,
+                                           unsigned dport,
+                                           USB4Device **child)
+{
+    USB4Router *pr = parent ? usb4_device_get_router(parent) : NULL;
+    USB4Port *p;
+
+    *child = NULL;
+    if (!f || !pr || dport < 1 || dport > pr->ndfp) {
+        return USB4_TUNNEL_DOWN;
+    }
+    p = pr->ports[dport].partner;
+    if (!p || p->router->tunnel.state != USB4_TUNNEL_UP) {
+        return USB4_TUNNEL_DOWN;
+    }
+    *child = p->router->tunnel.dev;
+    return USB4_TUNNEL_UP;
+}
+
+USB4TunnelState usb4_fabric_tunnel_state(USB4Fabric *f, unsigned port)
+{
+    USB4Port *p;
+
+    if (!f || port < 1 || port > f->hr->nports) {
+        return USB4_TUNNEL_DOWN;
+    }
+    p = f->hr->ports[port - 1].partner;
+    return p ? p->router->tunnel.state : USB4_TUNNEL_DOWN;
+}
+
+/* ------------------------------------------------------------------ */
+/* Control packet routing and processing, Spec 6.4.3                    */
+/* ------------------------------------------------------------------ */
+
+typedef struct USB4Req {
+    uint8_t pdf;
+    uint64_t route;
+    const uint32_t *dw;
+    unsigned ndw;            /* dwords excluding CRC */
+    size_t len;              /* frame bytes including CRC */
+} USB4Req;
+
+/*
+ * Follow the Route String from the host router (Spec 6.4.3.2). Returns
+ * the target router, or NULL if the packet was consumed by an error
+ * notification or dropped. *uninit is set when the target is an
+ * Uninitialized device router.
+ */
+static USB4Router *route_down(USB4Fabric *f, const USB4Req *q, bool *uninit)
+{
+    USB4Router *r = f->hr;
+
+    *uninit = false;
+    for (unsigned hops = 0; hops <= USB4_MAX_DEPTH + 1; hops++) {
+        unsigned depth, num;
+        USB4Adapter *a;
+
+        if (!usb4_router_enumerated(r)) {
+            if (r->is_host) {
+                /*
+                 * Spec: only Router CS requests are processed before the
+                 * host router is enumerated. The model is lenient for the
+                 * host router and traces it.
+                 */
+                trace_usb4_route_lenient(q->route);
+            } else {
+                *uninit = true;
+                return r;
+            }
+        }
+        depth = usb4_router_depth(r);
+        if (depth > 6) {
+            trace_usb4_route_drop(q->route, "bad depth");
+            return NULL;
+        }
+        num = usb4_route_level(q->route, depth);
+        if (num == 0) {
+            return r;
+        }
+        a = usb4_router_adapter(r, num);
+        if (!a || a->kind != USB4_ADP_LANE) {
+            /* Protocol (or nonexistent) adapter in the route */
+            send_notification(r, USB4_ERR_ADP, num, USB4_PG_NONE);
+            return NULL;
+        }
+        if (!a->port->dfp || !usb4_lane_up(a)) {
+            send_notification(r, USB4_ERR_CONN, num, USB4_PG_NONE);
+            return NULL;
+        }
+        if (a->port->lane[0]->cs[4] & (1u << 31)) {
+            send_notification(r, USB4_ERR_LOCK, num, USB4_PG_NONE);
+            return NULL;
+        }
+        r = a->port->partner->router;
+    }
+    trace_usb4_route_drop(q->route, "too deep");
+    return NULL;
+}
+
+static void send_response(USB4Router *r, const USB4Req *q, bool uninit,
+                          const uint32_t *data, unsigned n)
+{
+    uint32_t dw[3 + 60];
+    uint32_t dw3 = q->dw[2] & ~(0x7u << 29);
+    uint64_t route;
+
+    /*
+     * Spec 6.4.2.2: enumerated routers answer with their TopologyID,
+     * uninitialized ones with the Route String of the request.
+     */
+    route = uninit ? (q->route & USB4_ROUTE_TOPO_MASK)
+                   : usb4_router_topology(r);
+    route |= USB4_ROUTE_CM_BIT;
+    if (USB4_REQ_CS(dw3) == USB4_CS_ROUTER &&
+        !((r->img || usb4_router_tb3_sw_cm(r)) &&
+          q->pdf == USB4_PDF_WRITE)) {
+        /*
+         * Table 6-3: Adapter Num = adapter the request arrived on. The
+         * captured routers (intel-adl, asm2464, and the TB3 dock of the
+         * Framework capture) answer a Router CS write with the request's
+         * Adapter Num (0) instead, and only reads with the Upstream
+         * Adapter (observed).
+         */
+        dw3 = (dw3 & ~(0x3fu << 19)) | ((uint32_t)r->upstream_adapter << 19);
+    }
+    dw[0] = route >> 32;
+    dw[1] = (uint32_t)route;
+    dw[2] = dw3;
+    if (n) {
+        memcpy(&dw[3], data, n * 4);
+    }
+    usb4_ctl_send(r->fabric->host, q->pdf, dw, 3 + n);
+}
+
+/*
+ * Under a firmware CM (ICM-PROTOCOL.md R31), is this guest write to
+ * state the firmware owns: a path entry, or the protocol capability of a
+ * PCIe adapter (Path Enable)? The firmware's own programming goes
+ * through usb4_router_write() directly and is not filtered.
+ */
+static bool fw_owned_write(USB4Fabric *f, USB4Router *r, unsigned cs,
+                           unsigned adp, unsigned addr, unsigned size)
+{
+    USB4Adapter *a;
+    unsigned cap;
+
+    if (!f->icm) {
+        return false;
+    }
+    if (cs == USB4_CS_PATH) {
+        return true;
+    }
+    if (cs != USB4_CS_ADAPTER) {
+        return false;
+    }
+    a = usb4_router_adapter(r, adp);
+    if (!a || (a->kind != USB4_ADP_PCIE_DOWN && a->kind != USB4_ADP_PCIE_UP)) {
+        return false;
+    }
+    cap = usb4_adapter_pcie_cap(a);
+    return cap >= addr && cap < addr + size;
+}
+
+static void handle_request(USB4Fabric *f, const USB4Req *q)
+{
+    uint32_t dw3 = q->dw[2];
+    unsigned addr = USB4_REQ_ADDR(dw3), size = USB4_REQ_SIZE(dw3);
+    unsigned adp = USB4_REQ_ADP(dw3), cs = USB4_REQ_CS(dw3);
+    bool uninit;
+    USB4Router *r;
+    uint32_t data[64];
+
+    r = route_down(f, q, &uninit);
+    if (!r) {
+        return;
+    }
+    if (uninit && cs != USB4_CS_ROUTER) {
+        trace_usb4_route_drop(q->route, "uninitialized router, not router CS");
+        return;
+    }
+    if (cs == USB4_CS_ROUTER) {
+        adp = 0;
+    }
+    /* Spec 6.4.3.3, in the order given there */
+    if (cs != USB4_CS_ROUTER && adp > r->max_adapter) {
+        send_notification(r, USB4_ERR_ADP, adp, USB4_PG_NONE);
+        return;
+    }
+    if (q->pdf == USB4_PDF_WRITE) {
+        if (size == 0) {
+            send_response(r, q, uninit, NULL, 0);
+            return;
+        }
+        if (cs != USB4_CS_ROUTER && !usb4_router_adapter(r, adp)) {
+            send_notification(r, USB4_ERR_ADDR, adp, USB4_PG_NONE);
+            return;
+        }
+        if (q->len != (size_t)(size + 4) * 4) {
+            send_notification(r, USB4_ERR_LEN, adp, USB4_PG_NONE);
+            return;
+        }
+        if (fw_owned_write(f, r, cs, adp, addr, size)) {
+            /*
+             * ICM-PROTOCOL.md R31: the firmware CM owns paths and
+             * protocol adapter enables. The write is answered so a
+             * probing CM does not stall, but has no effect.
+             */
+            trace_usb4_fw_owned_write(usb4_router_topology(r),
+                                      usb4_ctl_cs_name(cs), adp, addr, size);
+            send_response(r, q, uninit, NULL, 0);
+            return;
+        }
+        if (!usb4_router_write(r, cs, adp, addr, size, &q->dw[3])) {
+            trace_usb4_req_range(usb4_router_topology(r),
+                                 usb4_ctl_cs_name(cs), adp, addr, size,
+                                 usb4_router_cs_size(r, cs, adp));
+            send_notification(r, USB4_ERR_ADDR, adp, USB4_PG_NONE);
+            return;
+        }
+        send_response(r, q, uninit, NULL, 0);
+        return;
+    }
+
+    /* Read Request */
+    if (cs != USB4_CS_ROUTER && !usb4_router_adapter(r, adp)) {
+        send_notification(r, USB4_ERR_ADDR, adp, USB4_PG_NONE);
+        return;
+    }
+    if (size > 60) {
+        send_notification(r, USB4_ERR_LEN, adp, USB4_PG_NONE);
+        return;
+    }
+    if (!usb4_router_read(r, cs, adp, addr, size, data)) {
+        trace_usb4_req_range(usb4_router_topology(r), usb4_ctl_cs_name(cs),
+                             adp, addr, size, usb4_router_cs_size(r, cs, adp));
+        send_notification(r, USB4_ERR_ADDR, adp, USB4_PG_NONE);
+        return;
+    }
+    send_response(r, q, uninit, data, size);
+}
+
+static void handle_notification(USB4Fabric *f, const USB4Req *q)
+{
+    uint32_t dw3 = q->dw[2];
+    unsigned event = dw3 & 0xff, info = (dw3 >> 8) & 0x3f;
+    unsigned pg = dw3 >> 30;
+    bool uninit;
+    USB4Router *r;
+
+    if (q->ndw < 3) {
+        trace_usb4_route_drop(q->route, "short notification");
+        return;
+    }
+    r = route_down(f, q, &uninit);
+    if (!r || uninit) {
+        return;
+    }
+    if (event == USB4_HP_ACK) {
+        hp_ack(r, info, pg);
+    } else {
+        trace_usb4_ctl_notify_from_cm(q->route, usb4_ctl_event_name(event),
+                                      event, info);
+    }
+}
+
+void usb4_fabric_tx_frame(USB4Fabric *f, uint8_t pdf,
+                          const uint8_t *frame, size_t len)
+{
+    uint32_t dw[USB4_CTL_MAX_FRAME / 4];
+    char hex[USB4_CTL_MAX_FRAME / 4 * 9 + 1];
+    USB4Req q;
+    unsigned ndw;
+
+    if (!f) {
+        return;
+    }
+    if (len < 12 || (len & 3) || len > USB4_CTL_MAX_FRAME) {
+        trace_usb4_ctl_tx_bad(pdf, (unsigned)len, "bad length");
+        return;
+    }
+    if (!usb4_ctl_frame_crc_ok(frame, len)) {
+        trace_usb4_ctl_tx_bad(pdf, (unsigned)len, "bad CRC");
+        return;
+    }
+    if (f->cfg_hold && (pdf == USB4_PDF_READ || pdf == USB4_PDF_WRITE)) {
+        if (f->nheld == ARRAY_SIZE(f->held)) {
+            /*
+             * Not reached from the host, which checks
+             * usb4_fabric_tx_ready() first and leaves the descriptor
+             * pending; any other caller must do the same.
+             */
+            trace_usb4_ctl_tx_bad(pdf, (unsigned)len,
+                                  "hold queue full, caller ignored "
+                                  "backpressure: refused");
+            return;
+        }
+        f->held[f->nheld].pdf = pdf;
+        f->held[f->nheld].len = len;
+        memcpy(f->held[f->nheld].data, frame, len);
+        f->nheld++;
+        trace_usb4_ctl_tx_bad(pdf, (unsigned)len, "held: firmware CM busy");
+        return;
+    }
+    ndw = len / 4 - 1;
+    for (unsigned i = 0; i < ndw; i++) {
+        dw[i] = usb4_get_be32(frame + 4 * i);
+    }
+    q.pdf = pdf;
+    q.route = ((uint64_t)dw[0] << 32) | dw[1];
+    q.dw = dw;
+    q.ndw = ndw;
+    q.len = len;
+
+    usb4_ctl_hexdump(hex, sizeof(hex), dw, ndw);
+    if ((pdf == USB4_PDF_READ || pdf == USB4_PDF_WRITE) && ndw >= 3) {
+        trace_usb4_ctl_tx_req(usb4_ctl_pdf_name(pdf), q.route,
+                              usb4_ctl_cs_name(USB4_REQ_CS(dw[2])),
+                              USB4_REQ_ADP(dw[2]), USB4_REQ_ADDR(dw[2]),
+                              USB4_REQ_SIZE(dw[2]), USB4_REQ_SEQ(dw[2]), hex);
+    } else {
+        trace_usb4_ctl_tx(usb4_ctl_pdf_name(pdf), pdf, q.route,
+                          (unsigned)len, hex);
+    }
+
+    if (q.route & USB4_ROUTE_CM_BIT) {
+        trace_usb4_route_drop(q.route, "CM bit set in downstream packet");
+        return;
+    }
+
+    f->in_tx = true;
+    switch (pdf) {
+    case USB4_PDF_READ:
+        if (ndw != 3) {
+            trace_usb4_route_drop(q.route, "read request length");
+            break;
+        }
+        handle_request(f, &q);
+        break;
+    case USB4_PDF_WRITE:
+        if (ndw < 3) {
+            trace_usb4_route_drop(q.route, "write request length");
+            break;
+        }
+        handle_request(f, &q);
+        break;
+    case USB4_PDF_NOTIFY:
+        handle_notification(f, &q);
+        break;
+    case USB4_PDF_NOTIFY_ACK:
+    case USB4_PDF_NOTIFY_ACK_ENH:
+        /* No notification sent by this model requires an ack (6.6). */
+        break;
+    default:
+        trace_usb4_route_drop(q.route, "unsupported PDF");
+        break;
+    }
+    f->in_tx = false;
+
+    /*
+     * Events raised while handling the request go out after its
+     * response.
+     */
+    hp_kick(f->hr);
+    for (unsigned d = 0; d < f->ndr; d++) {
+        hp_kick(f->dr[d]);
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* Fabric lifecycle                                                     */
+/* ------------------------------------------------------------------ */
+
+/*
+ * Derive a Spec 8.2.1.1.1 UUID: Vendor ID[63:48], Component ID[47:4],
+ * Router ID[3:0] = 0.
+ */
+static uint64_t make_uuid(uint16_t vendor, const uint8_t *seed, size_t len)
+{
+    uint64_t h = 0xcbf29ce484222325ULL;   /* FNV-1a */
+
+    for (size_t i = 0; i < len; i++) {
+        h ^= seed[i];
+        h *= 0x100000001b3ULL;
+    }
+    return ((uint64_t)vendor << 48) | ((h << 4) & 0x0000fffffffffff0ULL);
+}
+
+USB4Fabric *usb4_fabric_new(USB4Host *h, const USB4FabricConfig *cfg)
+{
+    USB4Fabric *f = g_new0(USB4Fabric, 1);
+    unsigned nports = cfg->num_usb4_ports;
+    USB4Router *r;
+
+    if (nports < 1) {
+        nports = 1;
+    }
+    if (nports > USB4_MAX_PORTS) {
+        nports = USB4_MAX_PORTS;
+    }
+    f->host = h;
+    f->cfg = *cfg;
+    f->cfg.num_usb4_ports = nports;
+
+    if (cfg->dialect == USB4_DIALECT_TB3) {
+        /*
+         * docs/ICM-PROTOCOL.md 5.1, R17: Alpine Ridge host router with
+         * one USB4 (Thunderbolt) port; Titan Ridge with one or two
+         * (ICM-TITAN-RIDGE.md 4, cfg->tb3_host). The EEPROM DROM's UID
+         * carries the DROM vendor ID in its top 16 bits, as captured.
+         */
+        r = usb4_router_new_tb3(f, true, 0, NULL);
+        f->cfg.num_usb4_ports = nports = r->nports;
+        r->vendor_id = cfg->router_vendor_id;
+        r->product_id = cfg->router_device_id;
+        r->drom_vendor_id = USB4_TB3_DROM_VENDOR;
+        r->drom_model_id = USB4_TB3_DROM_MODEL_HOST;
+        r->uuid = make_uuid(r->drom_vendor_id, cfg->uuid.data,
+                            sizeof(cfg->uuid.data));
+        r->vendor_name = "QEMU";
+        r->model_name = "Thunderbolt 3 Host Router";
+        usb4_drom_build_tb3(r);
+    } else {
+        r = usb4_router_new(f, true, nports, NULL);
+        if (r->adl) {
+            /* intel-adl: captured identity and DROM (usb4-router-adl.c) */
+            f->cfg.num_usb4_ports = nports = r->nports;
+        } else {
+            if (r->asm4242) {
+                /*
+                 * asm4242: published router identity from the host
+                 * (usb4-router-asm.c); the real DROM content is [unk], so
+                 * the names say what this is.
+                 */
+                f->cfg.num_usb4_ports = nports = r->nports;
+            }
+            r->vendor_id = cfg->router_vendor_id;
+            r->product_id = cfg->router_device_id;
+            r->uuid = make_uuid(r->vendor_id, cfg->uuid.data,
+                                sizeof(cfg->uuid.data));
+            r->vendor_name = "QEMU";
+            r->model_name = r->asm4242 ? "USB4 Host Router (asm4242 preset)"
+                            : cfg->host_model == USB4_HOST_MODEL_AMD ?
+                              "USB4 Host Router (amd preset)"
+                            : "USB4 Host Router";
+            usb4_drom_build(r);
+        }
+    }
+    f->hr = r;
+    f->preos_window = cfg->preos_cm;
+    usb4_router_reset(r);
+    trace_usb4_fabric_new(nports, r->vendor_id, r->product_id, r->uuid);
+    return f;
+}
+
+void usb4_fabric_free(USB4Fabric *f)
+{
+    if (!f) {
+        return;
+    }
+    for (unsigned d = 0; d < f->ndr; d++) {
+        usb4_router_free(f->dr[d]);
+    }
+    usb4_router_free(f->hr);
+    g_free(f);
+}
+
+void usb4_fabric_reset(USB4Fabric *f)
+{
+    if (!f) {
+        return;
+    }
+    /*
+     * Spec 6.10: all configuration spaces to defaults, every DFP
+     * disconnected; attached devices retrain afterwards.
+     */
+    trace_usb4_fabric_reset();
+    /*
+     * With an ICM the firmware re-establishes the fabric within the same
+     * reset (ARCHITECTURE.md 4.2b), so tunnels are evaluated once, after
+     * it: a tunnel the firmware rebuilds does not flap down and up.
+     */
+    f->eval_hold = f->icm != NULL || f->cfg.preos_cm;
+    f->cfg_hold = false;
+    f->nheld = 0;
+    usb4_router_reset(f->hr);
+    for (unsigned d = 0; d < f->ndr; d++) {
+        usb4_router_reset(f->dr[d]);
+    }
+    for (unsigned d = 0; d <= f->ndr; d++) {
+        USB4Router *r = d ? f->dr[d - 1] : f->hr;
+
+        for (unsigned i = 0; i < r->nports; i++) {
+            r->ports[i].dpr = false;
+        }
+    }
+    for (unsigned d = 0; d <= f->ndr; d++) {
+        USB4Router *r = d ? f->dr[d - 1] : f->hr;
+
+        for (unsigned i = 0; i < r->nports; i++) {
+            if (r->ports[i].dfp) {
+                r->ports[i].link_cached = usb4_port_link_up(&r->ports[i]);
+            }
+        }
+    }
+    if (f->icm) {
+        usb4_icm_reset(f->icm);
+    }
+    /* preos-cm: the platform firmware's CM runs again after power-on */
+    f->preos_window = f->cfg.preos_cm;
+    usb4_fabric_preos_cm(f);
+    f->eval_hold = false;
+    usb4_fabric_reevaluate(f, USB4_TUNNEL_REASON_SURPRISE);
+}
+
+void usb4_fabric_preos_end(USB4Fabric *f)
+{
+    if (f && f->preos_window) {
+        f->preos_window = false;
+        trace_usb4_preos_end();
+    }
+}
+
+bool usb4_fabric_tx_ready(USB4Fabric *f, uint8_t pdf)
+{
+    return !f || !f->cfg_hold || f->nheld < ARRAY_SIZE(f->held) ||
+           (pdf != USB4_PDF_READ && pdf != USB4_PDF_WRITE);
+}
+
+void usb4_fabric_cfg_hold(USB4Fabric *f, bool on)
+{
+    if (!f) {
+        return;
+    }
+    f->cfg_hold = on;
+    while (!on && f->nheld && !f->cfg_hold) {
+        uint8_t frame[USB4_CTL_MAX_FRAME];
+        uint8_t pdf = f->held[0].pdf;
+        size_t len = f->held[0].len;
+
+        memcpy(frame, f->held[0].data, len);
+        memmove(&f->held[0], &f->held[1],
+                (f->nheld - 1) * sizeof(f->held[0]));
+        f->nheld--;
+        usb4_fabric_tx_frame(f, pdf, frame, len);
+    }
+    if (!on) {
+        /* descriptors left pending by backpressure go out now */
+        usb4_host_tx_resume(f->host);
+    }
+}
+
+void usb4_fabric_set_icm(USB4Fabric *f, USB4ICM *icm)
+{
+    if (f) {
+        f->icm = icm;
+    }
+}
+
+void usb4_fabric_host_reset(USB4Fabric *f)
+{
+    if (!f) {
+        return;
+    }
+    /*
+     * Host interface reset: unacknowledged hot plug events are dropped;
+     * the CM rediscovers attached routers by scanning adapter state
+     * (Guide 3.1.1). Router state is not affected.
+     */
+    trace_usb4_fabric_host_reset(f->hr->hpq_len);
+    f->nheld = 0;       /* requests of the old rings are not answered */
+    for (unsigned d = 0; d <= f->ndr; d++) {
+        USB4Router *r = d ? f->dr[d - 1] : f->hr;
+
+        usb4_timer_del(r->hp_timer);
+        r->hpq_len = 0;
+        r->hp_outstanding = false;
+    }
+}
+
+void usb4_fabric_set_pcie_down_rid(USB4Fabric *f, unsigned port,
+                                   uint16_t rid)
+{
+    if (f && port >= 1 && port <= USB4_MAX_PORTS) {
+        f->pcie_rid[port] = rid;
+    }
+}
+
+/*
+ * Plug device router @d into downstream facing port @dfp of an attached
+ * router (host router, or a device router for a daisy chain).
+ */
+static bool attach_at(USB4Fabric *f, USB4Port *dfp, USB4Device *d,
+                      Error **errp)
+{
+    USB4Router *pr = dfp->router, *r;
+    const char *serial;
+    uint8_t seed[96];
+    int n;
+
+    if (dfp->partner) {
+        error_setg(errp, "usb4: USB4 port %u of router 0x%" PRIx64
+                   " already has a device router", dfp->index,
+                   pr->phys_route);
+        return false;
+    }
+    if (f->ndr == USB4_MAX_ROUTERS) {
+        error_setg(errp, "usb4: too many device routers");
+        return false;
+    }
+    if (pr->phys_depth >= USB4_MAX_DEPTH) {
+        error_setg(errp, "usb4: daisy chain deeper than %u routers",
+                   USB4_MAX_DEPTH);
+        return false;
+    }
+    if (usb4_device_dialect(d) == USB4_DIALECT_TB3) {
+        /*
+         * docs/ICM-PROTOCOL.md R21: a TB3 device router with an Intel
+         * router ID (8086:15d3 as captured), no CV/CR handshake.
+         */
+        r = usb4_router_new_tb3(f, false, usb4_device_downstream_ports(d),
+                                d);
+        r->vendor_id = 0x8086;
+        r->product_id = 0x15d3;
+        r->drom_vendor_id = USB4_TB3_DROM_VENDOR;
+        r->drom_model_id = USB4_TB3_DROM_MODEL_DEVICE;
+    } else {
+        r = usb4_router_new(f, false, usb4_device_downstream_ports(d), d);
+        if (!r->asm2464) {
+            r->vendor_id = 0x46f4;      /* QEMU's USB vendor ID */
+            r->product_id = 0x0004;
+        }
+    }
+    r->phys_depth = pr->phys_depth + 1;
+    /* Route String by position: Spec 6.4.2.2, one byte per level */
+    r->phys_route = pr->phys_route |
+                    ((uint64_t)dfp->lane[0]->num << (8 * pr->phys_depth));
+    serial = usb4_device_nvme_serial(d);
+    if (pr->is_host) {
+        n = snprintf((char *)seed, sizeof(seed), "usb4-dev-%u-%s",
+                     dfp->index, serial ? serial : "");
+    } else {
+        n = snprintf((char *)seed, sizeof(seed), "usb4-dev-%016" PRIx64
+                     "-%u-%s", pr->uuid, dfp->index, serial ? serial : "");
+    }
+    r->vendor_name = usb4_device_vendor_name(d);
+    r->model_name = usb4_device_model_name(d);
+    if (r->dialect == USB4_DIALECT_TB3) {
+        /* DROM UID: DROM vendor ID in bits 63:48 (captured 5.3) */
+        r->uuid = make_uuid(r->drom_vendor_id, seed,
+                            MIN((size_t)n, sizeof(seed)));
+        usb4_drom_build_tb3(r);
+    } else if (r->asm2464) {
+        /* Captured identity and DROM; the UID only if asked for */
+        r->uuid = usb4_device_uid(d) ? usb4_device_uid(d)
+                                     : usb4_router_asm2464_uid();
+        usb4_router_asm2464_drom(r);
+    } else {
+        r->uuid = usb4_device_uid(d) ? usb4_device_uid(d)
+                                     : make_uuid(r->vendor_id, seed,
+                                                 MIN((size_t)n, sizeof(seed)));
+        usb4_drom_build(r);
+    }
+    usb4_router_reset(r);
+
+    f->dr[f->ndr++] = r;
+    r->ports[0].partner = dfp;
+    dfp->partner = &r->ports[0];
+    usb4_device_set_router(d, r);
+    trace_usb4_attach(r->phys_route, r->uuid, r->ndfp);
+    usb4_fabric_port_changed(dfp);
+    if (f->preos_window) {
+        /* Before the OS takes over, the firmware CM configures it. */
+        usb4_fabric_preos_cm(f);
+    }
+    return true;
+}
+
+bool usb4_fabric_attach(USB4Fabric *f, unsigned port, USB4Device *d,
+                        Error **errp)
+{
+    if (!f) {
+        error_setg(errp, "usb4: no fabric");
+        return false;
+    }
+    if (port < 1 || port > f->hr->nports) {
+        error_setg(errp, "usb4: port %u out of range 1..%u", port,
+                   f->hr->nports);
+        return false;
+    }
+    return attach_at(f, &f->hr->ports[port - 1], d, errp);
+}
+
+bool usb4_fabric_attach_chained(USB4Fabric *f, USB4Device *parent,
+                                unsigned dport, USB4Device *d, Error **errp)
+{
+    USB4Router *pr = parent ? usb4_device_get_router(parent) : NULL;
+
+    if (!f || !pr) {
+        error_setg(errp, "usb4: parent device router is not attached");
+        return false;
+    }
+    if (dport < 1 || dport > pr->ndfp) {
+        error_setg(errp, "usb4: downstream port %u out of range 1..%u",
+                   dport, pr->ndfp);
+        return false;
+    }
+    return attach_at(f, &pr->ports[dport], d, errp);
+}
+
+/*
+ * Unplug @r and every router below it. The cable drops first: @r enters
+ * Uninitialized Unplugged (Spec 6.3.1) so it sends nothing more, the
+ * links below it go to CLd, the parent reports the hot unplug, and
+ * every tunnel in the subtree goes down (surprise, leaf first) closing
+ * its gate while the device objects still exist. Then the routers are
+ * freed, leaf first.
+ */
+static void detach_router(USB4Fabric *f, USB4Router *r)
+{
+    USB4Router *sub[USB4_MAX_ROUTERS];
+    USB4Port *dfp = r->up_port->partner;
+    unsigned n = 0;
+
+    /* f->dr[] is parent-first, so one pass collects the subtree. */
+    for (unsigned d = 0; d < f->ndr; d++) {
+        USB4Router *x = f->dr[d];
+        bool in = x == r;
+
+        for (unsigned i = 0; !in && i < n; i++) {
+            in = usb4_fabric_parent_router(x) == sub[i];
+        }
+        if (in) {
+            sub[n++] = x;
+        }
+    }
+    trace_usb4_attach(r->phys_route, 0, n);
+    r->up_port->partner = NULL;
+    if (dfp) {
+        dfp->partner = NULL;
+    }
+    usb4_router_reset(r);
+    sync_links(f);
+    usb4_fabric_reevaluate(f, USB4_TUNNEL_REASON_SURPRISE);
+
+    for (unsigned i = n; i-- > 0;) {
+        USB4Router *x = sub[i];
+        unsigned d;
+
+        for (d = 0; d < f->ndr && f->dr[d] != x; d++) {
+        }
+        memmove(&f->dr[d], &f->dr[d + 1], (f->ndr - d - 1) * sizeof(f->dr[0]));
+        f->ndr--;
+        for (unsigned p = 0; p < x->nports; p++) {
+            if (x->ports[p].partner) {
+                x->ports[p].partner->partner = NULL;
+                x->ports[p].partner = NULL;
+            }
+        }
+        if (x->dev) {
+            usb4_device_set_router(x->dev, NULL);
+        }
+        usb4_router_free(x);
+    }
+}
+
+void usb4_fabric_detach(USB4Fabric *f, unsigned port)
+{
+    USB4Port *q;
+
+    if (!f || port < 1 || port > f->hr->nports) {
+        return;
+    }
+    q = f->hr->ports[port - 1].partner;
+    if (q) {
+        detach_router(f, q->router);
+    }
+}
+
+void usb4_fabric_detach_device(USB4Fabric *f, USB4Device *d)
+{
+    USB4Router *r = d ? usb4_device_get_router(d) : NULL;
+
+    if (f && r) {
+        detach_router(f, r);
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* In-emulator configuration access (emulated ICM)                      */
+/* ------------------------------------------------------------------ */
+
+/*
+ * Resolve @route like a control packet (Spec 6.4.3.2) without sending
+ * anything: no notifications, no responses. NULL if the route does not
+ * lead to a router or crosses a link that is down or locked.
+ */
+static USB4Router *cfg_route(USB4Fabric *f, uint64_t route, bool *uninit)
+{
+    USB4Router *r = f->hr;
+
+    *uninit = false;
+    for (unsigned hops = 0; hops <= USB4_MAX_DEPTH + 1; hops++) {
+        unsigned num;
+        USB4Adapter *a;
+
+        if (!r->is_host && !usb4_router_enumerated(r)) {
+            *uninit = true;
+            return r;
+        }
+        num = usb4_route_level(route, usb4_router_depth(r));
+        if (num == 0) {
+            return r;
+        }
+        a = usb4_router_adapter(r, num);
+        if (!a || a->kind != USB4_ADP_LANE || !a->port->dfp ||
+            !usb4_lane_up(a) || (a->port->lane[0]->cs[4] & (1u << 31))) {
+            return NULL;
+        }
+        r = a->port->partner->router;
+    }
+    return NULL;
+}
+
+static USB4Router *cfg_target(USB4Fabric *f, uint64_t route, unsigned cs,
+                              unsigned adp, unsigned n)
+{
+    bool uninit;
+    USB4Router *r;
+
+    if (!f || n == 0 || n > 60) {
+        return NULL;
+    }
+    r = cfg_route(f, route & USB4_ROUTE_TOPO_MASK, &uninit);
+    if (!r || (uninit && cs != USB4_CS_ROUTER)) {
+        return NULL;
+    }
+    if (cs != USB4_CS_ROUTER && !usb4_router_adapter(r, adp)) {
+        return NULL;
+    }
+    return r;
+}
+
+bool usb4_fabric_cfg_read(USB4Fabric *f, uint64_t route, unsigned cs,
+                          unsigned adp, unsigned off, unsigned n,
+                          uint32_t *out)
+{
+    USB4Router *r = cfg_target(f, route, cs, adp, n);
+    bool ok = r && usb4_router_read(r, cs, cs == USB4_CS_ROUTER ? 0 : adp,
+                                    off, n, out);
+
+    trace_usb4_cfg_internal("read", route, usb4_ctl_cs_name(cs), adp, off,
+                            n, ok);
+    return ok;
+}
+
+bool usb4_fabric_cfg_write(USB4Fabric *f, uint64_t route, unsigned cs,
+                           unsigned adp, unsigned off, unsigned n,
+                           const uint32_t *in)
+{
+    USB4Router *r = cfg_target(f, route, cs, adp, n);
+    bool ok = r && usb4_router_write(r, cs, cs == USB4_CS_ROUTER ? 0 : adp,
+                                     off, n, in);
+
+    trace_usb4_cfg_internal("write", route, usb4_ctl_cs_name(cs), adp, off,
+                            n, ok);
+    return ok;
+}
