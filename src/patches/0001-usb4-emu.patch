+static void test_hi_reset(void)
+{
+    T *t = t_start("pc", NULL);
+
+    rings_setup(t, 8, 8);
+    rx_post(t, 1);
+    tx_queue(t, 1, 12, 1);
+    tx_queue(t, 2, 12, 1);
+    tx_doorbell(t);                 /* second frame waits in the FIFO */
+    wr(t, IMS0, CAUSE_RX0);
+    wr(t, HI_CONTROL, DISABLE_ISR_AUTOCLR);
+    g_assert_cmphex(isr0(t), !=, 0);
+
+    /* Spec 12.6.3.1.3: registers back to default */
+    wr(t, HI_RESET, 1);
+    g_assert_cmphex(rd(t, HI_RESET), ==, 0);
+    g_assert_cmphex(isr0(t), ==, 0);
+    g_assert_cmphex(rd(t, IMR0), ==, 0);
+    g_assert_cmphex(rd(t, HI_CONTROL), ==, 0);
+    g_assert_cmphex(rd(t, TX_RING(0) + RING_BASE_LO), ==, 0);
+    g_assert_cmphex(rd(t, RX_RING(0) + RING_SIZE), ==, 0);
+    g_assert_cmphex(rd(t, TX_CTRL(0)), ==, 0);
+    g_assert_cmphex(rd(t, RX_CTRL(0)), ==, 0);
+    g_assert_cmphex(rd(t, RX_RING(0) + RING_INDEX), ==, 0);
+
+    /* The queued frame was cancelled by the reset */
+    rings_setup(t, 8, 8);
+    rx_post(t, 4);
+    g_assert_cmpuint(rx_pi(t), ==, 0);
+    g_assert_cmphex(isr0(t), ==, 0);
+    /* And the interface works again */
+    tx_queue(t, 0x77, 8, 3);
+    tx_doorbell(t);
+    rx_expect(t, 0x77, 8, 3);
+    t_stop(t);
+}
