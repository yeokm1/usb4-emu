+/* @port is the tunnel target of a usb4-generic host (usb4-tunnel-dsp). */
+bool usb4_acpi_port_has_generic_host(PCIDevice *port);
+
+/*
+ * usb4-usb3.c: Scope(<xHCI>) { Device(RHUB) { Device(SSnn) { _DSD } } }
+ * mapping the xHCI SuperSpeed root ports named by usb4-host usb3-xhci /
+ * usb3-port1 / usb3-port2 to the host interface. Called from
+ * usb4_acpi_build_sb().
+ */
+void usb4_acpi_build_usb3(Aml *sb_scope);
+
+#endif
