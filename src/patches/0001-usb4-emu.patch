+/*
+ * Run QEMU with @dev and expect it to refuse to start with @msg (exit
+ * status 1, not a crash).
+ */
+static void expect_start_error(const char *dev, const char *msg)
+{
+    const char *qemu = g_getenv("QTEST_QEMU_BINARY");
+    const char *argv[] = {
+        qemu, "-machine", "q35", "-display", "none", "-audio", "none",
+        "-nodefaults", "-device", dev, NULL,
+    };
