+/* ------------------------------------------------------------------ */
+/* Minimal connection manager                                           */
+/* ------------------------------------------------------------------ */
+
+static USB4Fabric *fab;
+static unsigned seq;
+
+/* Hot plug events received while waiting for responses */
+typedef struct HPEv {
+    uint64_t route;
+    unsigned adp;
+    bool unplug;
+} HPEv;
+static HPEv hpev[64];
+static unsigned n_hpev;
+static uint32_t last_rsp_dw2;   /* DW2 of the last matching response */
+
+static void send_raw(uint8_t pdf, const uint32_t *dw, unsigned ndw,
+                     bool corrupt)
+{
+    uint8_t frame[USB4_CTL_MAX_FRAME];
+    size_t len;
+
+    for (unsigned i = 0; i < ndw; i++) {
+        usb4_put_be32(frame + 4 * i, dw[i]);
+    }
+    len = usb4_ctl_frame_seal(frame, ndw * 4);
+    if (corrupt) {
+        frame[len - 1] ^= 1;
+    }
+    usb4_fabric_tx_frame(fab, pdf, frame, len);
+}
+
+static Frame *rx_pop(void)
+{
+    return rx_head == rx_tail ? NULL : &rxq[rx_head++ % RXQ];
+}
+
+static void rx_flush_hp(void)
+{
+    Frame *f;
+
+    while ((f = rx_pop())) {
+        if (f->pdf == USB4_PDF_HOTPLUG) {
+            hpev[n_hpev % 64].route = ((uint64_t)(f->dw[0] & 0xffffff) << 32) |
+                                      f->dw[1];
+            hpev[n_hpev % 64].adp = f->dw[2] & 0x3f;
+            hpev[n_hpev % 64].unplug = f->dw[2] >> 31;
+            n_hpev++;
+        } else {
+            CHECK(0, "unexpected frame pdf %u", f->pdf);
+        }
+    }
+}
+
+/*
+ * Issue a read or write and collect the reply. Returns 0 for a matching
+ * response, 0x100 | event for an error notification, -1 for no reply.
+ */
+static int cm_xfer(uint8_t pdf, uint64_t route, unsigned cs, unsigned adp,
+                   unsigned addr, unsigned n, uint32_t *buf)
+{
+    uint32_t dw[64];
+    unsigned s = (seq++) & 3, ndw = 3;
+    int ret = -1;
+    Frame *f;
+
+    dw[0] = route >> 32;
+    dw[1] = (uint32_t)route;
+    dw[2] = usb4_req_dw3(addr, n, adp, cs, s);
+    if (pdf == USB4_PDF_WRITE) {
+        memcpy(&dw[3], buf, n * 4);
+        ndw += n;
+    }
+    send_raw(pdf, dw, ndw, false);
+    while ((f = rx_pop())) {
+        if (f->pdf == USB4_PDF_HOTPLUG) {
+            hpev[n_hpev % 64].route = ((uint64_t)(f->dw[0] & 0xffffff) << 32) |
+                                      f->dw[1];
+            hpev[n_hpev % 64].adp = f->dw[2] & 0x3f;
+            hpev[n_hpev % 64].unplug = f->dw[2] >> 31;
+            n_hpev++;
+            continue;
+        }
+        if (f->pdf == USB4_PDF_NOTIFY) {
+            ret = 0x100 | (f->dw[2] & 0xff);
+            continue;
+        }
+        CHECK(f->pdf == pdf, "response pdf %u", f->pdf);
+        CHECK(USB4_REQ_SEQ(f->dw[2]) == s, "sequence number");
+        CHECK(USB4_REQ_ADDR(f->dw[2]) == addr, "address echo");
+        CHECK(USB4_REQ_SIZE(f->dw[2]) == n, "size echo");
+        CHECK(USB4_REQ_CS(f->dw[2]) == cs, "cs echo");
+        last_rsp_dw2 = f->dw[2];
+        if (pdf == USB4_PDF_READ) {
+            CHECK(f->ndw == 3 + n, "read response length %u", f->ndw);
+            memcpy(buf, &f->dw[3], n * 4);
+        }
+        ret = 0;
+    }
+    return ret;
+}
+
+static int rd(uint64_t route, unsigned cs, unsigned adp, unsigned addr,
+              unsigned n, uint32_t *buf)
+{
+    return cm_xfer(USB4_PDF_READ, route, cs, adp, addr, n, buf);
+}
+
+static int wr(uint64_t route, unsigned cs, unsigned adp, unsigned addr,
+              unsigned n, uint32_t *buf)
+{
+    return cm_xfer(USB4_PDF_WRITE, route, cs, adp, addr, n, buf);
+}
+
+/* rd() into array @arr, refused at build time when @n does not fit */
+#define rd_arr(route, cs, adp, addr, n, arr) ({                        \
+            G_STATIC_ASSERT((n) <= G_N_ELEMENTS(arr));                   \
+            rd(route, cs, adp, addr, n, arr);                            \
+        })
+
+static uint32_t rd1(uint64_t route, unsigned cs, unsigned adp, unsigned addr)
+{
+    uint32_t v = 0xdeadbeef;
+    int r = rd(route, cs, adp, addr, 1, &v);
+
+    CHECK(r == 0, "read route %" PRIx64 " cs %u adp %u addr 0x%x -> %d",
+          route, cs, adp, addr, r);
+    return v;
+}
+
+static void wr1(uint64_t route, unsigned cs, unsigned adp, unsigned addr,
+                uint32_t v)
+{
+    int r = wr(route, cs, adp, addr, 1, &v);
+
+    CHECK(r == 0, "write route %" PRIx64 " cs %u adp %u addr 0x%x -> %d",
+          route, cs, adp, addr, r);
+}
+
+static void rmw(uint64_t route, unsigned cs, unsigned adp, unsigned addr,
+                uint32_t clr, uint32_t set)
+{
+    wr1(route, cs, adp, addr, (rd1(route, cs, adp, addr) & ~clr) | set);
+}
+
+static void hp_ack(uint64_t route, unsigned adp, bool unplug)
+{
+    uint32_t dw[3] = { route >> 32, (uint32_t)route,
+                       USB4_HP_ACK | (adp << 8) |
+                       ((unplug ? 3u : 2u) << 30) };
+
+    send_raw(USB4_PDF_NOTIFY, dw, 3, false);
+}
+
+/* Wait for the next hot plug event, acknowledge it and check it. */
+static void expect_hp(uint64_t route, unsigned adp, bool unplug)
+{
+    unsigned before = n_hpev;
+
+    for (int i = 0; i < 50 && n_hpev == before; i++) {
+        rx_flush_hp();
+        if (n_hpev == before) {
+            advance(1);
+        }
+    }
+    CHECK(n_hpev > before, "no hot plug event (want adp %u unplug %d)", adp,
+          unplug);
+    if (n_hpev > before) {
+        HPEv *e = &hpev[before % 64];
+        CHECK(e->route == route && e->adp == adp && e->unplug == unplug,
+              "hot plug event route %" PRIx64 " adp %u unplug %d, want adp %u"
+              " unplug %d", e->route, e->adp, e->unplug, adp, unplug);
+        hp_ack(route, adp, unplug);
+        rx_flush_hp();
+        n_hpev = before;    /* consumed, retransmitted copies dropped */
+    }
+}
+
+static void expect_no_hp(void)
+{
+    unsigned before = n_hpev;
+
+    rx_flush_hp();
+    advance(30);
+    rx_flush_hp();
+    CHECK(n_hpev == before, "unexpected hot plug event adp %u unplug %d",
+          hpev[before % 64].adp, hpev[before % 64].unplug);
+    n_hpev = before;
+}
+
+/* Router Operation (Guide 9.1). Returns ROUTER_CS_26 after completion. */
+static uint32_t router_op(uint64_t route, unsigned op, uint32_t meta,
+                          uint32_t *data)
+{
+    uint32_t regs[18];
+
+    memset(regs, 0, sizeof(regs));
+    regs[16] = meta;
+    regs[17] = op | (1u << 31);
+    CHECK(wr(route, USB4_CS_ROUTER, 0, 9, 18, regs) == 0, "router op write");
+    CHECK(rd(route, USB4_CS_ROUTER, 0, 9, 18, regs) == 0, "router op read");
+    CHECK(!(regs[17] & (1u << 31)), "operation still valid");
+    if (data) {
+        memcpy(data, regs, 17 * 4);     /* data[0..15] + metadata */
+    }
+    return regs[17];
+}
+
+/* USB4 Port Capability sideband access (Spec 4.1.1.3.2). */
+static uint32_t sb_access(uint64_t route, unsigned lane0, unsigned target,
+                          unsigned idx, unsigned reg, unsigned len, bool wnr,
+                          uint32_t *data)
+{
+    unsigned p = USB4_ADP_CAP_PORT;
+    uint32_t c1;
+
+    if (wnr) {
+        CHECK(wr(route, USB4_CS_ADAPTER, lane0, p + 2, (len + 3) / 4,
+                 data) == 0, "SB data write");
+    }
+    c1 = reg | (len << 8) | (target << 16) | (idx << 20) |
+         (wnr ? 1u << 24 : 0) | (1u << 31);
+    wr1(route, USB4_CS_ADAPTER, lane0, p + 1, c1);
+    c1 = rd1(route, USB4_CS_ADAPTER, lane0, p + 1);
+    CHECK(!(c1 & (1u << 31)), "SB access pending");
+    if (!wnr && data) {
+        rd(route, USB4_CS_ADAPTER, lane0, p + 2, 16, data);
+    }
+    return c1;
+}
