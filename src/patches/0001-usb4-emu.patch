@@ -0,0 +1,296 @@
+/*
+ * ASMedia ASM4242 PCI topology: the controller's PCIe switch and xHCI
+ *
+ * Copyright (c) 2026 usb4-emu contributors
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Written from scratch for the usb4-emu project from public lspci dumps
+ * only (docs/research/AM5-USB4.md 2.1, 2.2; no capture exists). Below a
+ * CPU root port the ASM4242 presents a PCIe switch: upstream port
+ * 1b21:2421 and four downstream ports 1b21:2423, all revision 01
+ * ([pub], high). Device 0 carries a USB4 PCIe tunnel ([pub]: a dock's
+ * bridges appeared there), device 1 is assumed to carry the second one
+ * ([inf]), device 2 leads to the xHCI 1b21:2426 and device 3 to the host
+ * interface 1b21:2425 (usb4-host host-model=asm4242) ([pub]).
+ *
+ * These types only change identity, like usb4-tb3-switch.c. They are
+ * composed on the command line (scripts/run-linux.sh HOST_MODEL=asm4242
+ * TOPOLOGY=switch, docs/USB4-HOSTS.md 5):
+ *
+ *   q35:    pcie-root-port -> usb4-asm-usp -> usb4-asm-tunnel-dsp (0.0,
+ *           1.0), usb4-asm-dsp (2.0, usb4-asm-xhci), usb4-asm-dsp (3.0,
+ *           usb4-host)
+ *   i440FX: pci-bridge -> usb4-asm-pci-usp -> usb4-asm-tunnel-bridge
+ *           (two), usb4-asm-pci-bridge (xHCI), usb4-asm-pci-bridge
+ *           (usb4-host). A conventional PCI stand-in: Windows 98 has no
+ *           notion of a PCIe switch.
+ *
+ * The xHCI subsystem ID and the root-port-to-switch layout beyond the
+ * dumps are [inf]. Firmware bus and window padding per downstream port
+ * cannot be reproduced on these IDs (SeaBIOS and OVMF honour QEMU's
+ * reservation hint only on Red Hat bridge IDs), so the run scripts pad
+ * the root port above the switch instead (docs/USB4-HOSTS.md 5).
+ *
+ * The ASM2464PD USB4 device controller (usb4-device device-model=asm2464,
+ * docs/captures/ORICO-ASM2464.md) has a PCIe switch of its own behind its
+ * PCIe Upstream adapter: an upstream port and one downstream port, both
+ * 1b21:2463 revision 00 with subsystem 1b21:2463 in a Subsystem ID
+ * capability, the downstream port without hot-plug, the NVMe behind it
+ * (observed, lspci of 7d:00.0 / 7e:00.0). The tunnel slot builds it on
+ * q35 (usb4-tunnel-slot.c); these are its two port types.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/module.h"
+#include "qapi/error.h"
+#include "hw/pci/pci.h"
+#include "hw/pci/pci_device.h"
+#include "hw/core/qdev.h"
+#include "hw/core/hotplug.h"
+#include "hw/pci/pcie.h"
+#include "hw/usb/xhci.h"
+#include "hw/pci-bridge/pci_bridge_dev.h"
+#include "hw/pci-bridge/xio3130_downstream.h"
+
+#define ASM_VENDOR          0x1b21
+#define ASM_USP_DEVICE      0x2421
+#define ASM_DSP_DEVICE      0x2423
+#define ASM_XHCI_DEVICE     0x2426
+#define ASM_REVISION        0x01
+#define ASM2464_DEVICE      0x2463  /* switch ports and subsystem */
+#define ASM2464_REVISION    0x00
+/* x3130-upstream / xio3130-downstream Subsystem ID capability offset */
+#define XIO3130_SSVID_OFFSET 0x80
+
+static void asm_ids(ObjectClass *klass, uint16_t device, const char *desc)
+{
+    PCIDeviceClass *k = PCI_DEVICE_CLASS(klass);
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    k->vendor_id = ASM_VENDOR;
+    k->device_id = device;
+    k->revision = ASM_REVISION;
+    dc->desc = desc;
+    dc->user_creatable = true;
+}
+
+static void asm_usp_class_init(ObjectClass *klass, const void *data)
+{
+    asm_ids(klass, ASM_USP_DEVICE,
+            "ASM4242 PCIe switch upstream port (1b21:2421)");
+}
+
+static void asm_dsp_class_init(ObjectClass *klass, const void *data)
+{
+    asm_ids(klass, ASM_DSP_DEVICE,
+            "ASM4242 PCIe switch downstream port (1b21:2423)");
+}
+
+static void asm_xhci_class_init(ObjectClass *klass, const void *data)
+{
+    PCIDeviceClass *k = PCI_DEVICE_CLASS(klass);
+
+    asm_ids(klass, ASM_XHCI_DEVICE, "ASM4242 integrated xHCI (1b21:2426)");
+    /* [inf] by analogy with the host interface's 1b21:2425 */
+    k->subsystem_vendor_id = ASM_VENDOR;
+    k->subsystem_id = ASM_XHCI_DEVICE;
+}
+
+/*
+ * ASM2464 switch ports: identity, and the subsystem IDs in the Subsystem
+ * ID capability that the XIO3130 ports carry with zeros.
+ */
+static DeviceRealize asm2464_usp_parent_realize, asm2464_dsp_parent_realize;
+
+static void asm2464_ssvid(DeviceState *dev)
+{
+    PCIDevice *d = PCI_DEVICE(dev);
+
+    pci_set_word(d->config + XIO3130_SSVID_OFFSET + PCI_SSVID_VENDOR_ID,
+                 ASM_VENDOR);
+    pci_set_word(d->config + XIO3130_SSVID_OFFSET + PCI_SSVID_DEVICE_ID,
+                 ASM2464_DEVICE);
+}
+
+/*
+ * PCIe link registers of the ASM2464's switch and of the link to its
+ * endpoint, as captured [obs]: P14s R2 and R4 (06:00.0, 07:00.0 and
+ * 08:00.0, lspci -xxxx and -vvv) and the Framework (7d:00.0, 7e:00.0
+ * and 7f:00.0, the same except the endpoint link at x4);
+ * docs/captures/P14S-ORICO-2026-10-15.md 4.2.
+ *
+ * - Upstream port, to the host's PCIe tunnel: Link Capabilities
+ *   0x01436811 (Port 1, 2.5 GT/s, x1, ASPM L1, L1 exit < 64 us, ASPM
+ *   optionality compliance), Link Status 2.5 GT/s x1 with Slot Clock,
+ *   Link Capabilities 2 0x018f1e1e (2.5-16 GT/s, retimer presence
+ *   detect), Target Link Speed 16 GT/s, Link Status 2 0x0001.
+ * - Downstream port: 0x007b6844 (Port 0, 16 GT/s, x4, ASPM L1, surprise
+ *   down, Data Link Layer Link Active and bandwidth notification
+ *   reporting), Link Capabilities 2 as above, Target 16 GT/s, Link
+ *   Status 2 0x001f (equalization complete). Its Link Status follows
+ *   the endpoint (QEMU's pcie_sync_bridge_lnk()), with Slot Clock and,
+ *   once the endpoint is plugged, Data Link Layer Link Active.
+ * - Endpoint (the SK hynix P31 in the ORICO, here QEMU's nvme):
+ *   0x00476843 (Port 0, 8 GT/s, x4, ASPM L1, Clock PM), Link Status
+ *   8 GT/s x2 with Slot Clock as in both P14s runs (the Framework
+ *   trained x4), Link Capabilities 2 0x0000000e, Target 8 GT/s, Link
+ *   Status 2 0x001e.
+ *
+ * Link Control belongs to the guest (the captured values are Linux's
+ * ASPM and Common Clock settings) and keeps QEMU's write mask, so ASPM
+ * is advertised but stays disabled. The host side of the tunnel above
+ * the upstream port is not changed here. These ports exist only on q35
+ * (usb4-tunnel-slot.c); the i440FX tunnel bridge is unaffected.
+ */
+#define ASM2464_USP_LNKCAP      0x01436811u
+#define ASM2464_USP_LNKSTA      0x1011u
+#define ASM2464_USP_LNKSTA2     0x0001u
+#define ASM2464_DSP_LNKCAP      0x007b6844u
+#define ASM2464_DSP_LNKSTA2     0x001fu
+#define ASM2464_LNKCAP2         0x018f1e1eu
+#define ASM2464_LNKCTL2_16GT    0x0004u
+#define ASM2464_EP_LNKCAP       0x00476843u
+#define ASM2464_EP_LNKSTA       0x1023u
+#define ASM2464_EP_LNKCAP2      0x0000000eu
+#define ASM2464_EP_LNKCTL2      0x0003u
+#define ASM2464_EP_LNKSTA2      0x001eu
+
+static void asm2464_link(PCIDevice *d, uint32_t lnkcap, uint32_t lnkcap2,
+                         uint16_t lnkctl2, uint16_t lnksta2)
+{
+    uint8_t *exp = d->config + d->exp.exp_cap;
+
+    pci_set_long(exp + PCI_EXP_LNKCAP, lnkcap);
+    pci_set_long(exp + PCI_EXP_LNKCAP2, lnkcap2);
+    pci_set_word(exp + PCI_EXP_LNKCTL2, lnkctl2);
+    pci_set_word(exp + PCI_EXP_LNKSTA2, lnksta2);
+}
+
+static void asm2464_usp_realize(DeviceState *dev, Error **errp)
+{
+    ERRP_GUARD();
+    PCIDevice *d = PCI_DEVICE(dev);
+
+    asm2464_usp_parent_realize(dev, errp);
+    if (!*errp) {
+        asm2464_ssvid(dev);
+        asm2464_link(d, ASM2464_USP_LNKCAP, ASM2464_LNKCAP2,
+                     ASM2464_LNKCTL2_16GT, ASM2464_USP_LNKSTA2);
+        pci_set_word(d->config + d->exp.exp_cap + PCI_EXP_LNKSTA,
+                     ASM2464_USP_LNKSTA);
+    }
+}
+
+static void asm2464_dsp_realize(DeviceState *dev, Error **errp)
+{
+    ERRP_GUARD();
+    PCIDevice *d = PCI_DEVICE(dev);
+
+    asm2464_dsp_parent_realize(dev, errp);
+    if (!*errp) {
+        asm2464_ssvid(dev);
+        asm2464_link(d, ASM2464_DSP_LNKCAP, ASM2464_LNKCAP2,
+                     ASM2464_LNKCTL2_16GT, ASM2464_DSP_LNKSTA2);
+        pci_word_test_and_set_mask(d->config + d->exp.exp_cap +
+                                   PCI_EXP_LNKSTA, PCI_EXP_LNKSTA_SLC);
+    }
+}
+
+/*
+ * An endpoint plugged below the downstream port comes up with the
+ * captured link, before the port's own plug handling (which sets Data
+ * Link Layer Link Active, since the port reports it).
+ */
+static void (*asm2464_dsp_parent_plug)(HotplugHandler *, DeviceState *,
+                                       Error **);
+
+static void asm2464_dsp_plug(HotplugHandler *hh, DeviceState *dev,
+                             Error **errp)
+{
+    PCIDevice *ep = (PCIDevice *)object_dynamic_cast(OBJECT(dev),
+                                                     TYPE_PCI_DEVICE);
+
+    if (ep && pci_is_express(ep) && ep->exp.exp_cap &&
+        pcie_cap_get_type(ep) == PCI_EXP_TYPE_ENDPOINT) {
+        asm2464_link(ep, ASM2464_EP_LNKCAP, ASM2464_EP_LNKCAP2,
+                     ASM2464_EP_LNKCTL2, ASM2464_EP_LNKSTA2);
+        pci_set_word(ep->config + ep->exp.exp_cap + PCI_EXP_LNKSTA,
+                     ASM2464_EP_LNKSTA);
+    }
+    asm2464_dsp_parent_plug(hh, dev, errp);
+}
+
+static void asm2464_port_ids(ObjectClass *klass, const char *desc)
+{
+    PCIDeviceClass *k = PCI_DEVICE_CLASS(klass);
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    k->vendor_id = ASM_VENDOR;
+    k->device_id = ASM2464_DEVICE;
+    k->revision = ASM2464_REVISION;
+    dc->desc = desc;
+    dc->user_creatable = false;     /* built by the tunnel slot */
+}
+
+static void asm2464_usp_class_init(ObjectClass *klass, const void *data)
+{
+    asm2464_port_ids(klass, "ASM2464PD PCIe switch upstream port "
+                     "(1b21:2463)");
+    device_class_set_parent_realize(DEVICE_CLASS(klass), asm2464_usp_realize,
+                                    &asm2464_usp_parent_realize);
+}
+
+static void asm2464_dsp_class_init(ObjectClass *klass, const void *data)
+{
+    HotplugHandlerClass *hc = HOTPLUG_HANDLER_CLASS(klass);
+
+    asm2464_port_ids(klass, "ASM2464PD PCIe switch downstream port "
+                     "(1b21:2463)");
+    device_class_set_parent_realize(DEVICE_CLASS(klass), asm2464_dsp_realize,
+                                    &asm2464_dsp_parent_realize);
+    asm2464_dsp_parent_plug = hc->plug;
+    hc->plug = asm2464_dsp_plug;
+}
+
+static const TypeInfo asm_switch_types[] = {
+    {
+        .name = "usb4-asm-usp",
+        .parent = "x3130-upstream",
+        .class_init = asm_usp_class_init,
+    }, {
+        .name = "usb4-asm-dsp",
+        .parent = TYPE_XIO3130_DOWNSTREAM,
+        .class_init = asm_dsp_class_init,
+    }, {
+        /* the gated hot-plug downstream port of a USB4 PCIe tunnel */
+        .name = "usb4-asm-tunnel-dsp",
+        .parent = "usb4-tunnel-dsp",
+        .class_init = asm_dsp_class_init,
+    }, {
+        .name = "usb4-asm-pci-usp",
+        .parent = TYPE_PCI_BRIDGE_DEV,
+        .class_init = asm_usp_class_init,
+    }, {
+        .name = "usb4-asm-pci-bridge",
+        .parent = TYPE_PCI_BRIDGE_DEV,
+        .class_init = asm_dsp_class_init,
+    }, {
+        .name = "usb4-asm-tunnel-bridge",
+        .parent = "usb4-tunnel-bridge",
+        .class_init = asm_dsp_class_init,
+    }, {
+        .name = "usb4-asm-xhci",
+        .parent = TYPE_QEMU_XHCI,
+        .class_init = asm_xhci_class_init,
+    }, {
+        .name = "usb4-asm2464-usp",
+        .parent = "x3130-upstream",
+        .class_init = asm2464_usp_class_init,
+    }, {
+        .name = "usb4-asm2464-dsp",
+        .parent = TYPE_XIO3130_DOWNSTREAM,
+        .class_init = asm2464_dsp_class_init,
+    },
+};
+
+DEFINE_TYPES(asm_switch_types)
