+/*
+ * loadvm of a snapshot taken before the tunnel bridge existed fails,
+ * like migration, and fails before it rolls the disks back to the
+ * snapshot or resets the machine: guest state and disk are untouched.
+ */
+static void test_tunnel_loadvm_blocked(void)
+{
+    g_autofree char *img = make_qcow2();
+    g_autofree char *out = NULL;
+    QTestState *qts;
+
+    if (!img) {
+        g_test_skip("QTEST_QEMU_IMG not set");
+        return;
+    }
+
+    /* The old snapshot: disk content 0xaa, VM state of a plain machine. */
+    qts = qtest_initf("-machine q35 "
+                      "-drive if=none,id=disk0,file=%s,format=qcow2", img);
+    g_free(qtest_hmp(qts, "qemu-io disk0 \"write -q -P 0xaa 0 512\""));
+    out = qtest_hmp(qts, "savevm old");
+    g_assert_cmpstr(out, ==, "");
+    qtest_quit(qts);
+    g_clear_pointer(&out, g_free);
+
+    qts = qtest_initf("-machine q35 "
+                      "-global ICH9-LPC.acpi-pci-hotplug-with-bridge-support=off "
+                      "-drive if=none,id=disk0,file=%s,format=qcow2 "
+                      "-device usb4-tunnel-port,id=tp0,bus=pcie.0,addr=0x3,"
+                      "chassis=1,nvme-drive=disk0,nvme-serial=QT1", img);
+    /* Guest-visible markers: bus numbers (reset clears them), disk. */
+    cfg_writel(qts, 0, TP_DEVFN, 0x18, 0x00010100);
+    g_free(qtest_hmp(qts, "qemu-io disk0 \"write -q -P 0xbb 0 512\""));
+
+    out = qtest_hmp(qts, "loadvm old");
+    g_assert(strstr(out, "non-migratable"));
+    g_assert(strstr(out, "usb4-tunnel"));
+
+    g_assert_cmphex(cfg_readl(qts, 0, TP_DEVFN, 0x18), ==, 0x00010100);
+    qtest_quit(qts);
+    g_assert_cmphex(qcow2_byte0(img), ==, 0xbb);    /* not rolled back */
+    unlink(img);
+}
