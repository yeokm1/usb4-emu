+#
+# Since: 11.2
+#
+# .. qmp-example::
+#
+#     <- { "event": "USB4_HARNESS",
+#          "data": { "qom-path": "/machine/peripheral/tp0", "rule": 0,
+#                    "trigger": "fetch", "token": 12,
+#                    "actions": "surprise" },
+#          "timestamp": { "seconds": 1265044230, "microseconds": 450486 } }
+##
+{ 'event': 'USB4_HARNESS',
