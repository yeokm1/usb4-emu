+/* ------------------------------------------------------------------ */
+/* Interrupts (Spec 12.5, 12.6.3.4) and the profile clearing rules      */
+/* ------------------------------------------------------------------ */
+
+/*
+ * Profile layer, docs/ARCHITECTURE.md section 4.1: does a read of the
+ * Interrupt Status register clear the bits read?
+ *  - usb4-generic: yes unless Disable ISR Auto-Clear is set (Spec Table
+ *    12-28, Table 12-14 bit 17).
+ *  - tb3-alpine-ridge: always read-to-clear (ICM-PROTOCOL.md 2.5, R6).
+ *    Delivery clears only an MSI-X message's cause while the Intel
+ *    auto-clear bit (DMA misc bit 2) is set (R7), see usb4_host_notify().
+ * Delivery never clears status otherwise.
+ */
+static bool usb4_host_isr_read_clears(USB4Host *s)
+{
+    if (s->profile == USB4_PROFILE_TB3_ALPINE_RIDGE) {
+        return true;
+    }
+    return !(s->hi_control & HI_CONTROL_DISABLE_ISR_AUTO_CLEAR);
+}
+
+/*
+ * Intel MSI-X auto-clear (ICM-PROTOCOL.md 2.5, R7): while DMA misc bit 2
+ * is set, sending a cause's MSI-X message clears its status bit. Always
+ * on the TB3 profile; on intel-adl only with intel-autoclear=on, since
+ * the emulator PCI identity makes clients take the Spec path (Disable
+ * ISR Auto-Clear and the ISC register) and bit 2 is vendor defined in
+ * Spec Table 12-14 (CAPTURE-VS-LINUX.md ADL-8).
+ */
+static bool usb4_host_intel_autoclear(USB4Host *s)
+{
+    return (s->profile == USB4_PROFILE_TB3_ALPINE_RIDGE ||
+            s->intel_autoclear) &&
+           (s->hi_control & TB3_AR_DMA_MISC_AUTO_CLEAR);
+}
+
+static void usb4_host_update_intx(USB4Host *s)
+{
+    PCIDevice *pd = PCI_DEVICE(s);
+    int level = 0;
+    int i;
+
+    /*
+     * INTx is level triggered, asserted while any unmasked status bit is
+     * set (ARCHITECTURE.md section 5), and only when neither MSI nor MSI-X
+     * is enabled.
+     */
+    if (!msix_enabled(pd) && !msi_enabled(pd)) {
+        for (i = 0; i < USB4_HI_ISR_DWORDS; i++) {
+            if (s->isr[i] & s->imr[i]) {
+                level = 1;
+                break;
+            }
+        }
+    }
+    if (!pd->config[PCI_INTERRUPT_PIN]) {
+        return;                 /* intx=off: no INTx pin at all */
+    }
+    if (level != s->intx_level) {
+        s->intx_level = level;
+        trace_usb4_host_irq_intx(level);
+    }
+    pci_set_irq(pd, level);
+}
+
+static unsigned usb4_host_cause_vector(USB4Host *s, unsigned cause)
+{
+    /* Spec 12.6.3.4.8: 4 bits per cause, 8 causes per DW. */
+    return (s->ivar[cause / 8] >> (4 * (cause % 8))) & 0xf;
+}
+
+/* Send a message for one unmasked cause (Spec 12.5.2, 12.5.3). */
+static void usb4_host_notify(USB4Host *s, unsigned cause)
+{
+    PCIDevice *pd = PCI_DEVICE(s);
+
+    if (msix_enabled(pd)) {
+        unsigned vec = usb4_host_cause_vector(s, cause);
+
+        if (vec < USB4_HI_MSIX_VECTORS) {
+            trace_usb4_host_irq_notify("msix", vec, cause);
+            msix_notify(pd, vec);
+            if (usb4_host_intel_autoclear(s) && !msix_is_masked(pd, vec)) {
+                /* R7: sending the message clears the ring's bit. */
+                s->isr[cause / 32] &= ~(1u << (cause % 32));
+                trace_usb4_host_irq_status_clear(cause / 32,
+                                                 1u << (cause % 32),
+                                                 "MSI-X auto-clear");
+            }
+        }
+    } else if (msi_enabled(pd)) {
+        /* Spec 12.5.3: all causes share the single MSI vector. */
+        trace_usb4_host_irq_notify("msi", 0, cause);
+        msi_notify(pd, 0);
+    }
+    /* INTx is handled by usb4_host_update_intx(). */
+}
+
+/*
+ * MSI-X vector use notifier: QEMU's MSI-X core calls it when a vector
+ * becomes unmasked (entry or function mask) and then delivers the
+ * vector's pending message itself, bypassing usb4_host_notify(). Under
+ * the Intel auto-clear rule (ARCHITECTURE.md 4.1, ICM-PROTOCOL.md R7)
+ * that delivery clears the status of the causes it stands for: every
+ * pending, unmasked cause routed to the vector.
+ */
+static int usb4_host_msix_use(PCIDevice *pd, unsigned vector, MSIMessage msg)
+{
+    USB4Host *s = USB4_HOST(pd);
+
+    if (!usb4_host_intel_autoclear(s) || !msix_is_pending(pd, vector)) {
+        return 0;
+    }
+    for (unsigned cause = 0; cause < 3 * s->paths; cause++) {
+        uint32_t bit = 1u << (cause % 32);
+
+        if ((s->isr[cause / 32] & s->imr[cause / 32] & bit) &&
+            usb4_host_cause_vector(s, cause) == vector) {
+            s->isr[cause / 32] &= ~bit;
+            trace_usb4_host_irq_status_clear(cause / 32, bit,
+                                             "MSI-X auto-clear (unmask)");
+        }
+    }
+    return 0;
+}
+
+static void usb4_host_msix_release(PCIDevice *pd, unsigned vector)
+{
+}
+
+static void usb4_host_set_status(USB4Host *s, unsigned cause)
+{
+    unsigned w = cause / 32;
+    uint32_t bit = 1u << (cause % 32);
+    bool unmasked;
+
+    if (cause >= 3 * s->paths) {
+        return;                 /* ring beyond the reported ring count */
+    }
+    unmasked = s->imr[w] & bit;
+
+    s->isr[w] |= bit;
+    trace_usb4_host_irq_status_set(cause, unmasked, s->isr[0], s->isr[1]);
+    if (unmasked) {
+        usb4_host_notify(s, cause);
+    }
+    usb4_host_update_intx(s);
+}
+
+/* Newly unmasked causes that are already pending get a message. */
+static void usb4_host_mask_changed(USB4Host *s, unsigned w, uint32_t old)
+{
+    uint32_t fire = s->imr[w] & ~old & s->isr[w];
+
+    while (fire) {
+        unsigned b = ctz32(fire);
+
+        fire &= ~(1u << b);
+        if (w * 32 + b < 3 * s->paths) {
+            usb4_host_notify(s, w * 32 + b);
+        }
+    }
+    usb4_host_update_intx(s);
+}
