new file mode 100644
index 0000000000000000000000000000000000000000..a5a0ef89b56ced5c64b6ba5e6c9c290508feb6bd
--- /dev/null
+++ b/tests/qtest/usb4-asm4242-test.c
@@ -0,0 +1,708 @@
+/*
+ * qtest for host-model=asm4242: the ASMedia ASM4242 USB4 host of AM5
+ * X870 boards, modelled from public sources (docs/USB4-HOSTS.md 5,
+ * docs/research/AM5-USB4.md 7).
+ *
+ * Copyright (c) 2026 usb4-emu contributors
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Written from scratch for the usb4-emu project. Covers the PCI identity
+ * of every function, the switch topology on q35 and its conventional PCI
+ * stand-in on i440FX with a PCIe tunnel brought up by the pre-OS CM, the
+ * router identity seen over ring 0, the USB4 interrupt clearing rule,
+ * INTx, and quirk b (Tx E2E). Router-level behaviour (layout, router
+ * operations, quirks a and c) is in tests/usb4/fabric-test.c.
+ */
+
+#include "qemu/osdep.h"
+#include "libqtest.h"
+#include "libqos/fw_cfg.h"
+#include "qobject/qdict.h"
+
+#define ASM_NHI         0x24251b21u
+#define ASM_USP         0x24211b21u
+#define ASM_DSP         0x24231b21u
+#define ASM_XHCI        0x24261b21u
+#define QEMU_NVME       0x00101b36u
+
+/* BAR0 registers, Spec 2.0 Table 12-10 */
+#define BAR0            0xe0000000u
+#define TX_RING(n)      (0x00000 + (n) * 0x10)
+#define RX_RING(n)      (0x08000 + (n) * 0x10)
+#define  RING_BASE_LO   0x0
+#define  RING_BASE_HI   0x4
+#define  RING_INDEX     0x8
+#define  RING_SIZE      0xc
+#define TX_CTRL(n)      (0x19800 + (n) * 0x20)
+#define RX_CTRL(n)      (0x29800 + (n) * 0x20)
+#define RING_VALID      (1u << 31)
+#define RING_RAW        (1u << 30)
+#define RING_E2E        (1u << 28)
+#define ISR0            0x37800
+#define ISC0            0x37808
+#define HI_CONTROL      0x39864
+#define DISABLE_ISR_AUTOCLR (1u << 17)
+#define DESC_DD         (1u << 21)
+#define DESC_RS         (1u << 22)
+#define DESC_IE         (1u << 23)
+#define CAUSE_TX(n)     (1u << (n))
+
+/* Guest memory used for rings and buffers (below the 128 MiB default) */
+#define MEM_TX_RING     0x00100000u
+#define MEM_RX_RING     0x00101000u
+#define MEM_TX_BUF      0x00102000u
+#define MEM_RX_BUF      0x00103000u
+#define MEM_TX1_RING    0x00104000u
+
+static uint32_t cfg_addr(int bus, int devfn, int off)
+{
+    return 0x80000000u | (bus << 16) | (devfn << 8) | (off & 0xfc);
+}
+
+static uint32_t cfg_readl(QTestState *qts, int bus, int devfn, int off)
+{
+    qtest_outl(qts, 0xcf8, cfg_addr(bus, devfn, off));
+    return qtest_inl(qts, 0xcfc);
+}
+
+static void cfg_writel(QTestState *qts, int bus, int devfn, int off,
+                       uint32_t val)
+{
+    qtest_outl(qts, 0xcf8, cfg_addr(bus, devfn, off));
+    qtest_outl(qts, 0xcfc, val);
+}
+
+/* Primary/secondary/subordinate bus numbers of a bridge */
+static void bridge_buses(QTestState *qts, int bus, int devfn, int sec,
+                         int sub)
+{
+    cfg_writel(qts, bus, devfn, 0x18, bus | (sec << 8) | (sub << 16));
+}
+
+/* Offset of the PCI Express capability of a device */
+static int find_exp_cap(QTestState *qts, int bus, int devfn)
+{
+    int pos = cfg_readl(qts, bus, devfn, 0x34) & 0xfc;
+
+    while (pos) {
+        uint32_t hdr = cfg_readl(qts, bus, devfn, pos);
+
+        if ((hdr & 0xff) == 0x10) {
+            return pos;
+        }
+        pos = (hdr >> 8) & 0xfc;
+    }
+    g_assert_not_reached();
+}
+
+static char *endpoint_state(QTestState *qts, const char *id)
+{
+    g_autofree char *path = g_strdup_printf("/machine/peripheral/%s", id);
+    QDict *rsp = qtest_qmp(qts, "{'execute': 'qom-get', 'arguments': "
+                           "{'path': %s, 'property': 'endpoint'}}", path);
+    char *s = g_strdup(qdict_get_str(rsp, "return"));
+
+    qobject_unref(rsp);
+    return s;
+}
+
+/* ------------------------------------------------------------------ */
+/* Host interface on the root bus: identity, INTx, rings                */
+/* ------------------------------------------------------------------ */
+
+#define NHI_DEVFN       (4 << 3)
+
+static QTestState *nhi_start(const char *machine, const char *extra)
+{
+    QTestState *qts = qtest_initf("-nodefaults -machine %s -device usb4-host,"
+                                  "id=u4,addr=04.0,host-model=asm4242%s",
+                                  machine, extra);
+
+    cfg_writel(qts, 0, NHI_DEVFN, 0x10, BAR0);
+    cfg_writel(qts, 0, NHI_DEVFN, 0x04, 0x6);    /* memory, bus master */
+    return qts;
+}
+
+static void test_identity_model(const char *machine)
+{
+    QTestState *qts = nhi_start(machine, "");
+
+    g_assert_cmphex(cfg_readl(qts, 0, NHI_DEVFN, 0x00), ==, ASM_NHI);
+    /* class 0C0340, revision 01 */
+    g_assert_cmphex(cfg_readl(qts, 0, NHI_DEVFN, 0x08), ==, 0x0c034001);
+    g_assert_cmphex(cfg_readl(qts, 0, NHI_DEVFN, 0x2c), ==, ASM_NHI);
+    g_assert_cmphex((cfg_readl(qts, 0, NHI_DEVFN, 0x3c) >> 8) & 0xff, ==, 1);
+    qtest_quit(qts);
+}
+
+static void test_identity(void)
+{
+    test_identity_model("pc");
+    test_identity_model("q35");
+}
+
+static void test_no_intx(void)
+{
+    QTestState *qts = nhi_start("pc", ",intx=off");
+
+    g_assert_cmphex((cfg_readl(qts, 0, NHI_DEVFN, 0x3c) >> 8) & 0xff, ==, 0);
+    qtest_quit(qts);
+}
