+/*
+ * Hook 6 on q35: a stage code written to the debug port fires its rule
+ * before the write returns; markers are counted.
+ */
+static void test_debug_port_q35(void)
+{
+    g_autofree char *img = make_img();
+    g_autofree char *trig = NULL;
+    Nv nv;
+    QTestState *qts = tp_start(img, ",x-faults=\"at=stage code=0x77 "
+                               "act=surprise\"",
+                               "-device usb4-debug-port,id=dbg", &nv);
+
+    g_assert_cmphex(qtest_inl(qts, DBG_PORT), ==, 0x42443455);
+    qom_set_bool(qts, TP_PATH, "x-hold-deferred", true);
