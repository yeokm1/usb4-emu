+/*
+ * Tokens of a removed endpoint never name a command of its replacement,
+ * and a released command completes with its own CID.
+ */
+static void test_token_isolation(void)
+{
+    g_autofree char *img = make_img();
+    g_autofree char *t1 = NULL, *t2 = NULL;
+    Nv nv;
+    QTestState *qts = tp_start(img, ",x-faults=\"at=fetch op=read act=hold "
+                               "repeat=on\"", "", &nv);
+    uint16_t cid, st;
+
+    nv_bringup(&nv);
+    nv_read(&nv, 1, 0, RAM_BUF);
+    t1 = qom_get_str(qts, TP_PATH, "x-release");
+    g_assert_cmpstr(t1, !=, "");
+
+    qom_set_str(qts, TP_PATH, "tunnel", "surprise");
+    g_assert_cmpuint(wait_stage(qts, "removed"), ==, 1);
+    g_assert(str_has(qts, TP_PATH, "x-harness-state", "held=0"));
+    qom_set_str(qts, TP_PATH, "tunnel", "up");
+    qtest_clock_step(qts, 300 * 1000 * 1000);
+    /* Generation 2 or later: the old drive may still be busy at first. */
+    g_assert_cmpuint(wait_stage(qts, "inserted"), >=, 2);
+    ep_map(qts);
+    nv_reg_init(&nv, qts, WIN_MEM);
+    nv.cid = 0x40;                  /* CIDs distinct from the first run */
+    nv_bringup(&nv);
+    qtest_memset(qts, RAM_BUF2, SENTINEL, 512);
+    cid = nv_read(&nv, 1, 1, RAM_BUF2);
+    t2 = qom_get_str(qts, TP_PATH, "x-release");
+    g_assert_cmpstr(t2, !=, t1);
+
+    /* The old token names nothing now. */
+    qom_set_str(qts, TP_PATH, "x-release", t1);
+    g_assert_cmpuint(held_count(qts), ==, 1);
+    g_assert(!nv_poll(&nv, 1, -1, NULL, NULL, 50));
+    g_assert(buf_is(qts, RAM_BUF2, SENTINEL));
+    qom_set_str(qts, TP_PATH, "x-release", t2);
+    g_assert(nv_poll(&nv, 1, cid, NULL, &st, 2000));
+    g_assert_cmphex(st, ==, 0);
+    g_assert(buf_is(qts, RAM_BUF2, PATTERN1));
+    qtest_quit(qts);
+    unlink(img);
+}
