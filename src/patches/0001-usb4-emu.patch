+static void usb4_host_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    PCIDeviceClass *k = PCI_DEVICE_CLASS(klass);
+    ResettableClass *rc = RESETTABLE_CLASS(klass);
+    HotplugHandlerClass *hc = HOTPLUG_HANDLER_CLASS(klass);
+
+    k->realize = usb4_host_realize;
+    k->exit = usb4_host_exit;
+    k->config_read = usb4_host_read_config;
+    k->config_write = usb4_host_write_config;
+    k->vendor_id = PCI_VENDOR_ID_REDHAT;
+    k->device_id = PCI_DEVICE_ID_REDHAT_USB4_HOST;
+    k->class_id = PCI_CLASS_SERIAL_USB4;
+    k->revision = 1;
+    rc->phases.hold = usb4_host_reset_hold;
+    hc->unplug = usb4_host_unplug;
+    dc->desc = "USB4 / Thunderbolt 3 host interface";
+    dc->vmsd = &usb4_host_vmstate;
+    device_class_set_props(dc, usb4_host_properties);
+    set_bit(DEVICE_CATEGORY_USB, dc->categories);
+}
+
+static void usb4_host_instance_init(Object *obj)
+{
+    /* Hybrid device: express on a PCIe bus, conventional elsewhere. */
+    PCI_DEVICE(obj)->cap_present |= QEMU_PCI_CAP_EXPRESS;
+    /* R28: platform force power, settable at run time with qom-set */
+    object_property_add_bool(obj, "force-power", usb4_host_get_force_power,
+                             usb4_host_set_force_power);
+}
+
+static const TypeInfo usb4_host_info = {
+    .name = TYPE_USB4_HOST,
+    .parent = TYPE_PCI_DEVICE,
+    .instance_size = sizeof(USB4Host),
+    .class_init = usb4_host_class_init,
+    .instance_init = usb4_host_instance_init,
+    .interfaces = (const InterfaceInfo[]) {
+        { INTERFACE_PCIE_DEVICE },
+        { INTERFACE_CONVENTIONAL_PCI_DEVICE },
+        { TYPE_HOTPLUG_HANDLER },
+        { }
+    },
+};
+
+static void usb4_host_register_types(void)
+{
+    type_register_static(&usb4_host_info);
+}
+
+type_init(usb4_host_register_types)
diff --git a/hw/usb4/usb4-icm.c b/hw/usb4/usb4-icm.c
new file mode 100644
index 0000000000000000000000000000000000000000..60ecb678f7936951cc5f562b0d510a2b6a9a74f3
--- /dev/null
+++ b/hw/usb4/usb4-icm.c
@@ -0,0 +1,1287 @@
+/*
+ * Emulated Intel Alpine Ridge / Titan Ridge firmware connection manager
+ * ("ICM")
+ *
+ * Copyright (c) 2026 usb4-emu contributors
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Written from scratch for the usb4-emu project from the clean-room
+ * description docs/ICM-PROTOCOL.md (requirement numbers R1-R22 are cited
+ * below) and the P14s Gen 1 capture in tests/captures/p14s-gen1/. Path
+ * programming follows the USB4 Connection Manager Guide 2.0 section 5.3
+ * (PCIe tunnel, Table 5-2) through the fabric's own config space API, so
+ * the shared tunnel evaluator sees exactly what a software CM would
+ * write (docs/ARCHITECTURE.md 4.2b).
+ *
+ * Scope: one level of device routers below the host router (depth 1),
+ * the Alpine Ridge message set of ICM-PROTOCOL.md section 4 and the
+ * Titan Ridge message set of docs/ICM-TITAN-RIDGE.md section 3 (inferred
+ * from the Linux ICM client, drivers/thunderbolt/icm.c and tb_msgs.h at
+ * the commit pinned in docs/REFERENCES.md; requirements T1-T12 cited as
+ * "TR Tn"). The two dialects differ only in message layouts: approve,
+ * pre-boot, boot ACL, mailbox and fabric programming are shared.
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/bswap.h"
+#include "usb4-fabric-int.h"
+#include "trace.h"
+
+/* ICM message codes, ICM-PROTOCOL.md 4 */
+enum {
+    ICM_CMD_DRIVER_READY = 0x03,
+    ICM_CMD_APPROVE = 0x04,
+    ICM_CMD_GET_ROUTE = 0x0a,
+    ICM_CMD_BOOT_ACL = 0x18,
+    ICM_EV_DEVICE_CONNECTED = 0x03,
+    ICM_EV_DEVICE_DISCONNECTED = 0x04,
+};
+
+/* NHI mailbox commands, ICM-PROTOCOL.md 2.3 */
+enum {
+    ICM_MBOX_SAVE_DEVICES = 0x05,
+    ICM_MBOX_DISCONNECT_PCIE = 0x06,
+    ICM_MBOX_DRIVER_UNLOADS = 0x07,
+    ICM_MBOX_DISCONNECT_PA = 0x10,
+    ICM_MBOX_DISCONNECT_PB = 0x11,
+    ICM_MBOX_ALLOW_ALL = 0x23,
+};
+
+#define ICM_FLAG_ERROR          0x01    /* response flags bit 0, 4.8 */
+#define ICM_ACL_WRITE           0x80    /* boot ACL flags bit 7, 4.6 */
+#define ICM_DR_FLAGS            0xe2    /* driver-ready flags, 4.1 */
+#define ICM_DR_FLAGS_ASSIST     0x22    /* under BIOS Assist, 13.5 */
+#define ICM_DR_FLAG_RTD3        0x40
+#define ICM_ROM_VERSION         0x60    /* observed, 4.1 */
+#define ICM_RAM_VERSION         0x0b
+#define ICM_DC_FLAGS            0xb1    /* device-connected flags, R11 */
+/*
+ * A USB4 device router (ICM-PROTOCOL.md 13.3): dual lane, 20 Gb/s, level
+ * field 1, bit 0 clear; single lane under Assist and pre-boot.
+ */
+#define ICM_DC_FLAGS_USB4       0xa8
+#define ICM_DC_FLAGS_USB4_X1    0x88
+#define ICM_NOTIFY_TIMEOUT_USB4 0xfe    /* ROUTER_CS_4 as read, 13.3 */
+#define ICM_CONN_KEY            0x10    /* observed key, R11 */
+#define ICM_DC_WORDS            61      /* device connected length, 4.4 */
+#define ICM_NAME_WORDS          55      /* name block, words 6-60 */
+#define ICM_ACL_SLOTS           16
+
+/* Titan Ridge layouts, docs/ICM-TITAN-RIDGE.md 3 (all inferred) */
+#define ICM_TR_DR_WORDS         4       /* driver-ready response, TR T2 */
+#define ICM_TR_PROTO_VERSION    2       /* below 3: no USB4 proxy, TR T2 */
+#define ICM_TR_DC_WORDS         63      /* device connected, TR T4 */
+#define ICM_TR_DD_WORDS         3       /* device disconnected, TR T5 */
+#define ICM_TR_APPROVE_WORDS    8       /* approve request/response, T6 */
+
+/* Link info (ICM-PROTOCOL.md 4.4): link, depth, approved, unknown bit 11 */
+#define LINK_INFO(link, depth)  (((link) & 7) | (((depth) & 0xf) << 4))
+#define LINK_APPROVED           (1u << 8)
+#define LINK_BOOT               (1u << 10)
+#define LINK_BIT11              (1u << 11)
+
+/* One host USB4 port and what the firmware knows about its device. */
+typedef struct ICMPort {
+    bool present;       /* device router enumerated by the firmware */
+    bool approved;      /* PCIe paths programmed (R10, R22) */
+    bool announced;     /* device connected sent since the driver ready */
+    bool boot;          /* announced with the boot bit (R25) */
+    bool usb4;          /* USB4 device router, not TB3 (13.3) */
+    bool single_lane;   /* announced as one lane (13.3) */
+    uint8_t conn_id;    /* id of the last announcement */
+    uint8_t link;       /* host lane adapter number (= route, R9) */
+    uint64_t route;     /* route string of the device router (TR T4) */
+    /*
+     * Connection generation: a fresh value at every plug, unplug and
+     * explicit tunnel disconnect, so that work started for one
+     * connection (a delayed approve) cannot act on another.
+     */
+    uint64_t gen;
+    uint8_t uuid[16];   /* event UUID, kept for the disconnect */
+} ICMPort;
+
+/* R33: the per-port USB fallback timer (not cleared with the port state) */
+typedef struct ICMFallback {
+    USB4ICM *icm;
+    unsigned port;
+    USB4Timer *timer;
+} ICMFallback;
+
+struct USB4ICM {
+    USB4Fabric *f;
+    USB4ICMConfig cfg;
+    bool driver_ready;  /* between driver ready and mailbox 0x07 (R12) */
+    bool power_on;      /* machine power-on: pre-boot window (R25) */
+    bool next_reset_hot; /* next reset is a controller power-up (R27) */
+    bool silent;        /* empty under BIOS Assist: commands unanswered, R32 */
+    bool first_ready;   /* no driver ready since power-on (13.5) */
+    bool holding;       /* announcing: config requests held (6.2) */
+    USB4Timer *ready_timer;
+    /* an approve in progress with approve-link-ms / approve-resp-ms */
+    bool ap_active;
+    unsigned ap_port;
+    uint64_t ap_gen;    /* the port's connection generation at the request */
+    unsigned ap_len;
+    uint32_t ap_req[ICM_TR_APPROVE_WORDS];
+    USB4Timer *ap_link_timer;
+    USB4Timer *ap_resp_timer;
+    uint8_t last_id;
+    uint64_t gen;       /* last connection generation handed out */
+    ICMPort port[USB4_MAX_PORTS + 1];
+    ICMFallback fb[USB4_MAX_PORTS + 1];
+    uint32_t acl[2 * ICM_ACL_SLOTS];
+};
+
+/* ------------------------------------------------------------------ */
+/* Frames                                                               */
+/* ------------------------------------------------------------------ */
+
+static uint32_t icm_header(unsigned code, unsigned flags)
+{
+    /* ICM-PROTOCOL.md 3.1; R16: packet index 0, packet count 1. */
+    return (code & 0xff) | ((flags & 0xff) << 8) | (1u << 24);
+}
+
+static bool icm_tr(USB4ICM *icm)
+{
+    return icm->cfg.dialect == USB4_ICM_DIALECT_TR;
+}
+
+static void icm_send(USB4ICM *icm, uint8_t pdf, const uint32_t *dw,
+                     unsigned ndw)
+{
+    /*
+     * R5: ICM payloads carry no route string; the words are sent most
+     * significant byte first with a CRC-32C trailer (ICM-PROTOCOL.md 3).
+     */
+    usb4_ctl_send(icm->f->host, pdf, dw, ndw);
+}
+
+/* ------------------------------------------------------------------ */
+/* Fabric access, as a software CM would do it                          */
+/* ------------------------------------------------------------------ */
+
+static USB4Router *icm_port_router(USB4ICM *icm, unsigned p)
+{
+    USB4Router *hr = icm->f->hr;
+    USB4Port *q;
+
+    if (p < 1 || p > hr->nports) {
+        return NULL;
+    }
+    q = hr->ports[p - 1].partner;
+    return q ? q->router : NULL;
+}
+
+static void icm_rmw(USB4Router *r, unsigned cs, unsigned adp, unsigned off,
+                    uint32_t clear, uint32_t set)
+{
+    uint32_t v;
+
+    if (!usb4_router_read(r, cs, adp, off, 1, &v)) {
+        return;
+    }
+    v = (v & ~clear) | set;
+    usb4_router_write(r, cs, adp, off, 1, &v);
+}
+
+/*
+ * Offset of the protocol adapter capability (ID 4) of @a, found by
+ * walking the adapter capability chain from ADP_CS_1 (Spec 8.2.2): the
+ * same walk works on usb4 and tb3 adapters (ICM-PROTOCOL.md 5.1, the PCIe
+ * capability at 0x39). 0 if none.
+ */
+static unsigned icm_pcie_cap(USB4Router *r, USB4Adapter *a)
+{
+    uint32_t v;
+    unsigned off;
+
+    if (!usb4_router_read(r, USB4_CS_ADAPTER, a->num, 1, 1, &v)) {
+        return 0;
+    }
+    off = v & 0xff;
+    for (unsigned n = 0; off && n < 16; n++) {
+        if (!usb4_router_read(r, USB4_CS_ADAPTER, a->num, off, 1, &v)) {
+            return 0;
+        }
+        if (((v >> 8) & 0xff) == USB4_CAP_PROTO) {
+            return off;
+        }
+        off = v & 0xff;
+    }
+    return 0;
+}
+
+static void icm_path_enable(USB4Router *r, USB4Adapter *a, bool on)
+{
+    unsigned cap = a ? icm_pcie_cap(r, a) : 0;
+
+    if (cap) {
+        /* ADP_PCIE_CS_0 Path Enable (Guide 5.3.1 step 3) */
+        icm_rmw(r, USB4_CS_ADAPTER, a->num, cap, 1u << 31,
+                on ? 1u << 31 : 0);
+    }
+}
+
+static void icm_path_entry(USB4Router *r, USB4Adapter *in, unsigned hop,
+                           USB4Adapter *out, bool lane_ingress)
+{
+    uint32_t dw[2];
+
+    /*
+     * PATH_CS_0/1 for a PCIe path, Guide Table 5-2: priority 3,
+     * weight 1, ingress and egress flow control, no shared buffering;
+     * credits are allocated at lane adapter ingress only. HopID 8 on
+     * both protocol adapters and on the link.
+     */
+    dw[0] = (1u << 31) | USB4_PCIE_HOPID | ((uint32_t)out->num << 11) |
+            (lane_ingress ? 16u << 17 : 0);
+    dw[1] = 1 | (3u << 8) | (1u << 24) | (1u << 25);
+    usb4_router_write(r, USB4_CS_PATH, in->num, 2 * hop, 2, dw);
+}
+
+static void icm_path_clear(USB4Router *r, USB4Adapter *a)
+{
+    uint32_t dw[2] = { 0, 0 };
+
+    if (a) {
+        usb4_router_write(r, USB4_CS_PATH, a->num, 2 * USB4_PCIE_HOPID, 2,
+                          dw);
+    }
+}
+
+/*
+ * Approve (R10): build the PCIe tunnel between the host PCIe Down adapter
+ * of port @p and the device router's PCIe Up adapter, in the order of
+ * Guide 5.3.1: paths in both directions, then Path Enable on both PCIe
+ * adapters. The fabric's evaluator brings the tunnel up synchronously.
+ */
+static bool icm_tunnel_up(USB4ICM *icm, unsigned p)
+{
+    USB4Router *hr = icm->f->hr, *dr = icm_port_router(icm, p);
+    USB4Adapter *hdown, *hlane, *dlane, *dup;
+
+    if (!dr) {
+        return false;
+    }
+    hdown = usb4_router_find_kind(hr, USB4_ADP_PCIE_DOWN, p);
+    hlane = hr->ports[p - 1].lane[0];
+    dlane = dr->up_port->lane[0];
+    dup = usb4_router_find_kind(dr, USB4_ADP_PCIE_UP, 1);
+    if (!hdown || !hlane || !dlane || !dup) {
+        trace_usb4_icm_state(p, "approve: missing PCIe adapter");
+        return false;
+    }
+    /* downstream: host PCIe Down -> host lane -> device lane -> PCIe Up */
+    icm_path_entry(dr, dlane, USB4_PCIE_HOPID, dup, true);
+    icm_path_entry(hr, hdown, USB4_PCIE_HOPID, hlane, false);
+    /* upstream: PCIe Up -> device lane -> host lane -> host PCIe Down */
+    icm_path_entry(hr, hlane, USB4_PCIE_HOPID, hdown, true);
+    icm_path_entry(dr, dup, USB4_PCIE_HOPID, dlane, false);
+    icm_path_enable(dr, dup, true);
+    icm_path_enable(hr, hdown, true);
+    /*
+     * Judge the programmed paths directly rather than the evaluated
+     * tunnel state, which is held while usb4_fabric_reset() runs.
+     */
+    return !usb4_fabric_hop8_path_check(hr, hdown, dup) &&
+           !usb4_fabric_hop8_path_check(dr, dup, hdown);
+}
+
+/*
+ * Tear down the PCIe tunnel of port @p (mailbox 0x06, unplug). The
+ * first write that invalidates the tunnel closes the access gate inside
+ * the same call (ARCHITECTURE.md 4.4); the rest is cleanup.
+ */
+static void icm_tunnel_down(USB4ICM *icm, unsigned p)
+{
+    USB4Router *hr = icm->f->hr, *dr = icm_port_router(icm, p);
+    USB4Adapter *hdown = usb4_router_find_kind(hr, USB4_ADP_PCIE_DOWN, p);
+
+    icm_path_enable(hr, hdown, false);
+    icm_path_clear(hr, hdown);
+    icm_path_clear(hr, hr->ports[p - 1].lane[0]);
+    if (dr) {
+        USB4Adapter *dup = usb4_router_find_kind(dr, USB4_ADP_PCIE_UP, 1);
+
+        icm_path_enable(dr, dup, false);
+        icm_path_clear(dr, dup);
+        icm_path_clear(dr, dr->up_port->lane[0]);
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* Events                                                               */
+/* ------------------------------------------------------------------ */
+
+static unsigned icm_name_entry(uint8_t *blk, unsigned pos, unsigned type,
+                               const uint8_t *data, unsigned len)
+{
+    /* ICM-PROTOCOL.md 4.4: length (incl. 2 header bytes), type, data */
+    if (pos + 2 + len > ICM_NAME_WORDS * 4 - 1) {
+        return pos;
+    }
+    blk[pos] = len + 2;
+    blk[pos + 1] = type;
+    memcpy(blk + pos + 2, data, len);
+    return pos + 2 + len;
+}
+
+static unsigned icm_name_string(uint8_t *blk, unsigned pos, unsigned type,
+                                const char *s)
+{
+    char buf[64];
+
+    snprintf(buf, sizeof(buf), "%s", s ? s : "");
+    return icm_name_entry(blk, pos, type, (const uint8_t *)buf,
+                          strlen(buf) + 1);
+}
+
+/*
+ * DROM identity of a device router for the name block entry 0x10: the
+ * firmware builds it from the DROM's vendor and model IDs, also for a
+ * non-Intel USB4 router (ICM-PROTOCOL.md 13.3, the ORICO's b8 00 63 24).
+ */
+static void icm_drom_ids(USB4Router *r, uint16_t *vid, uint16_t *mid)
+{
+    if (!usb4_drom_ids(r, vid, mid)) {
+        *vid = r->drom_vendor_id;
+        *mid = r->drom_model_id;
+    }
+}
+
+/*
+ * Name block string entry @type (1 vendor, 2 model) from the DROM's
+ * ASCII entry of the same type (the ORICO's "ASMedia", "246x" in
+ * R2-T:81.411 are its DROM strings), else the configured name.
+ */
+static unsigned icm_name_drom(uint8_t *blk, unsigned pos, unsigned type,
+                              USB4Router *r, const char *fallback)
+{
+    char buf[64];
+    unsigned len;
+    const uint8_t *s = usb4_drom_entry(r, type, &len);
+
+    if (!s) {
+        return icm_name_string(blk, pos, type, fallback);
+    }
+    len = MIN(len, sizeof(buf) - 1);
+    memcpy(buf, s, len);
+    buf[len] = 0;
+    return icm_name_string(blk, pos, type, buf);
+}
+
+static uint8_t icm_next_id(USB4ICM *icm)
+{
+    /* R11: fresh id per announcement, never one still announced. */
+    for (unsigned tries = 0; tries < 256; tries++) {
+        bool used = false;
+
+        icm->last_id++;
+        if (!icm->last_id) {
+            continue;
+        }
+        for (unsigned p = 1; p <= USB4_MAX_PORTS; p++) {
+            used |= icm->port[p].announced &&
+                    icm->port[p].conn_id == icm->last_id;
+        }
+        if (!used) {
+            break;
+        }
+    }
+    return icm->last_id;
+}
+
+/* Device connected, R11, layout ICM-PROTOCOL.md 4.4 */
+static void icm_announce(USB4ICM *icm, unsigned p)
+{
+    ICMPort *ip = &icm->port[p];
+    USB4Router *dr = icm_port_router(icm, p);
+    uint32_t dw[ICM_TR_DC_WORDS] = { 0 };
+    /* AR: name block at word 6; TR: at word 8 after the route (TR T4) */
+    unsigned nb = icm_tr(icm) ? 8 : 6;
+    uint8_t blk[ICM_NAME_WORDS * 4] = { 0 };
+    uint8_t vs[6];
+    uint16_t vid, mid, info;
+    unsigned pos = 0, flags;
+
+    if (!dr || !icm->driver_ready) {
+        return;
+    }
+    ip->conn_id = icm_next_id(icm);
+    ip->announced = true;
+    info = LINK_INFO(ip->link, 1) | LINK_BIT11 |
+           (ip->approved ? LINK_APPROVED : 0) |
+           (ip->boot ? LINK_BOOT : 0);
+
+    /* R11 for a TB3 router; 13.3 for a USB4 router */
+    flags = !ip->usb4 ? ICM_DC_FLAGS :
+            ip->single_lane ? ICM_DC_FLAGS_USB4_X1 : ICM_DC_FLAGS_USB4;
+    dw[0] = icm_header(ICM_EV_DEVICE_CONNECTED, flags);
+    for (unsigned i = 0; i < 4; i++) {
+        dw[1 + i] = ldl_le_p(ip->uuid + 4 * i);
+    }
+    if (icm_tr(icm)) {
+        /*
+         * TR T4: route string high and low word, then connection id in
+         * bits 7:0 and link info in bits 31:16; no connection key.
+         */
+        dw[5] = ip->route >> 32;
+        dw[6] = (uint32_t)ip->route;
+        dw[7] = ip->conn_id | ((uint32_t)info << 16);
+    } else {
+        dw[5] = ICM_CONN_KEY | ((uint32_t)ip->conn_id << 8) |
+                ((uint32_t)info << 16);
+    }
+
+    icm_drom_ids(dr, &vid, &mid);
+    pos = icm_name_drom(blk, pos, 0x01, dr, dr->vendor_name);
+    pos = icm_name_drom(blk, pos, 0x02, dr, dr->model_name);
+    /*
+     * Intel entry: vendor, model, unknown byte (observed 0x11), flags
+     * (bit 0 RTD3). A USB4 router has flags bit 1 set and no type 0x12
+     * entry after it (ICM-PROTOCOL.md 13.3, R2-T:81.411); the TB3 dock
+     * has both as in 4.4.
+     */
+    stw_le_p(vs, vid);
+    stw_le_p(vs + 2, mid);
+    vs[4] = 0x11;
+    vs[5] = (dr->rtd3 ? 0x01 : 0x00) | (ip->usb4 ? 0x02 : 0x00);
+    pos = icm_name_entry(blk, pos, 0x10, vs, sizeof(vs));
+    if (!ip->usb4) {
+        pos = icm_name_entry(blk, pos, 0x12, NULL, 0);
+    }
+    for (unsigned i = 0; i < ICM_NAME_WORDS; i++) {
+        dw[nb + i] = ldl_le_p(blk + 4 * i);
+    }
+    trace_usb4_icm_connected(ip->link, ip->conn_id,
+                             icm_tr(icm) ? 0 : ICM_CONN_KEY,
+                             ip->approved, dr->uuid);
+    icm_send(icm, USB4_PDF_ICM_EVENT, dw,
+             icm_tr(icm) ? ICM_TR_DC_WORDS : ICM_DC_WORDS);
+}
+
+/* Device disconnected, R13, ICM-PROTOCOL.md 4.5 */
+static void icm_announce_gone(USB4ICM *icm, unsigned p)
+{
+    ICMPort *ip = &icm->port[p];
+    uint32_t dw[2];
+
+    if (!ip->announced || !icm->driver_ready) {
+        ip->announced = false;
+        return;
+    }
+    ip->announced = false;
+    trace_usb4_icm_disconnected(ip->link);
+    if (icm_tr(icm)) {
+        uint32_t tr[ICM_TR_DD_WORDS];
+
+        /* TR T5: route string high and low */
+        tr[0] = icm_header(ICM_EV_DEVICE_DISCONNECTED, 0);
+        tr[1] = ip->route >> 32;
+        tr[2] = (uint32_t)ip->route;
+        icm_send(icm, USB4_PDF_ICM_EVENT, tr, ICM_TR_DD_WORDS);
+        return;
+    }
+    dw[0] = icm_header(ICM_EV_DEVICE_DISCONNECTED, 0);
+    dw[1] = (uint32_t)LINK_INFO(ip->link, 1) << 16;
+    icm_send(icm, USB4_PDF_ICM_EVENT, dw, 2);
+}
+
+/* ------------------------------------------------------------------ */
+/* Plug and unplug                                                      */
+/* ------------------------------------------------------------------ */
+
+/* R25: is the device in the boot ACL (bytes 0-7 of its UUID)? */
+static bool icm_in_acl(USB4ICM *icm, ICMPort *ip)
+{
+    uint32_t a = ldl_le_p(ip->uuid), b = ldl_le_p(ip->uuid + 4);
+
+    for (unsigned i = 0; i < ICM_ACL_SLOTS; i++) {
+        if (icm->acl[2 * i] == a && icm->acl[2 * i + 1] == b) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static void icm_uuid_of(USB4Router *dr, uint8_t uuid[16])
+{
+    uint32_t uid[2];
+
+    if (dr->dialect == USB4_DIALECT_TB3) {
+        /*
+         * R11: bytes 0-7 the DROM UID (little endian), bytes 8-15 ones,
+         * as the device router reports it (identity consistency, ARCH
+         * 4.2).
+         */
+        usb4_router_tb3_uuid(dr, uuid);
+        return;
+    }
+    /*
+     * USB4 router (ICM-PROTOCOL.md 13.3): event words 1-2 are the router
+     * UID high then low, ROUTER_CS_8 then ROUTER_CS_7 (Spec Table 8-3),
+     * the opposite of the TB3 order; words 3-4 all ones.
+     */
+    if (!usb4_router_read(dr, USB4_CS_ROUTER, 0, 7, 2, uid)) {
+        uid[0] = dr->uuid >> 32;
+        uid[1] = (uint32_t)dr->uuid;
+    }
+    stl_le_p(uuid, uid[1]);
+    stl_le_p(uuid + 4, uid[0]);
+    memset(uuid + 8, 0xff, 8);
+}
+
+/*
+ * Would the firmware approve @dr at power-on without a client (security
+ * none, or pre-boot, R22, R25)?
+ */
+static bool icm_preboot_approves(USB4ICM *icm, USB4Router *dr)
+{
+    ICMPort tmp;
+
+    if (icm->cfg.security == 0) {
+        return true;
+    }
+    if (!icm->cfg.preboot) {
+        return false;
+    }
+    if (!icm->cfg.preboot_acl_only) {
+        return true;
+    }
+    icm_uuid_of(dr, tmp.uuid);
+    return icm_in_acl(icm, &tmp);
+}
+
+/*
+ * R33 (ICM-PROTOCOL.md 13.1): a USB4 device router that the firmware
+ * announced but nobody approved leaves the Thunderbolt link about 9.4 s
+ * later (device disconnected without an unplug, R1-T:151.727 to
+ * 161.112) and comes back as a USB 3 device on the controller's xHCI.
+ * A TB3 router (the dock) waits for approval indefinitely (6.4).
+ */
+static bool icm_falls_back(USB4ICM *icm, USB4Router *dr)
+{
+    return icm->cfg.usb_fallback_ms && dr->dialect != USB4_DIALECT_TB3;
+}
+
+static void icm_fallback_timer(void *opaque)
+{
+    ICMFallback *fb = opaque;
+    USB4ICM *icm = fb->icm;
+    ICMPort *ip = &icm->port[fb->port];
+    USB4Router *dr = icm_port_router(icm, fb->port);
+
+    if (!dr || !ip->present || ip->approved) {
+        return;
+    }
+    trace_usb4_icm_state(fb->port, "not approved in time: USB fallback");
+    /* The link drops: icm_unplug() announces the departure (13.1). */
+    usb4_fabric_set_usb_mode(dr, true, false);
+    usb4_host_usb_mode_changed(icm->f->host);
+}
+
+/*
+ * A device router came up on host port @p: the firmware enumerates it
+ * (route = host lane adapter, depth 1, ICM-PROTOCOL.md 4.2), tunnels it
+ * at once under security none (R22) and announces it if a driver is
+ * ready (R12).
+ */
+static void icm_plug(USB4ICM *icm, unsigned p, USB4Adapter *lane)
+{
+    ICMPort *ip = &icm->port[p];
+    USB4Router *dr = icm_port_router(icm, p);
+    uint32_t v;
+
+    if (!dr || ip->present) {
+        return;
+    }
+    ip->present = true;
+    ip->gen = ++icm->gen;
+    ip->approved = false;
+    ip->boot = false;
+    ip->announced = false;
+    ip->usb4 = dr->dialect != USB4_DIALECT_TB3;
+    ip->single_lane = false;
+    ip->link = lane->num;
+    /* depth 1: the route string is the host lane adapter (4.2, TR T4) */
+    ip->route = lane->num;
+    icm_uuid_of(dr, ip->uuid);
+
+    /* Clear Lock on the DFP lane adapter if the dialect has one. */
+    icm_rmw(icm->f->hr, USB4_CS_ADAPTER, lane->num, 4, 1u << 31, 0);
+    /* Router CS 1-3: depth, route, configured (Guide 3.2.1 analogue) */
+    icm_rmw(dr, USB4_CS_ROUTER, 0, 1, 7u << 20, 1u << 20);
+    v = lane->num;
+    usb4_router_write(dr, USB4_CS_ROUTER, 0, 2, 1, &v);
+    v = 1u << 31;
+    usb4_router_write(dr, USB4_CS_ROUTER, 0, 3, 1, &v);
+    if (ip->usb4) {
+        /*
+         * A USB4 router (ICM-PROTOCOL.md 13.3): the client reads
+         * Notification Timeout 254 ms in ROUTER_CS_4, set by the
+         * firmware. PCIe tunneling and Configuration Valid as a
+         * software CM sets them (Guide 3.2.3), so the router reports
+         * Configuration Ready before any tunnel (Spec 6.7).
+         */
+        icm_rmw(dr, USB4_CS_ROUTER, 0, 4, 0xff, ICM_NOTIFY_TIMEOUT_USB4);
+        icm_rmw(dr, USB4_CS_ROUTER, 0, 5, 0, 1u << 24);
+        icm_rmw(dr, USB4_CS_ROUTER, 0, 5, 0, 1u << 31);
+    }
+    trace_usb4_icm_state(p, "device router enumerated");
+
+    /*
+     * R25: with pre-boot support on, every announcement carries the boot
+     * bit, also for a device plugged after power-on and not approved
+     * (R2-T:130.710, 0x0c110210; ICM-PROTOCOL.md 13.2).
+     */
+    ip->boot = icm->cfg.preboot;
+    if (icm->cfg.security == 0) {
+        ip->approved = icm_tunnel_up(icm, p);
+        trace_usb4_icm_state(p, ip->approved ? "auto-approved"
+                                             : "auto-approve failed");
+    } else if (icm->cfg.preboot && icm->power_on &&
+               (!icm->cfg.preboot_acl_only || icm_in_acl(icm, ip))) {
+        /*
+         * R25: at machine power-on the firmware approves every attached
+         * device and tunnels it before the guest firmware scans PCI. The
+         * boot ACL is not the criterion: the ORICO was tunnelled while
+         * absent from it (ICM-PROTOCOL.md 13.2, P14S-ORICO 2.3).
+         * preboot-acl-only keeps the earlier ACL-only model.
+         */
+        ip->approved = icm_tunnel_up(icm, p);
+        trace_usb4_icm_state(p, ip->approved ? "pre-boot approved"
+                                             : "pre-boot approve failed");
+        /*
+         * The ORICO's pre-boot link under BIOS Assist is one lane (R4:
+         * flags 0x88, sysfs 1 lane; ICM-PROTOCOL.md 13.3).
+         */
+        ip->single_lane = ip->usb4 && icm->cfg.bios_assist && ip->approved;
+    }
+    if (!ip->approved && icm_falls_back(icm, dr)) {
+        /* R33: approve within the window or lose the device to USB */
+        usb4_timer_mod_ms(icm->fb[p].timer, icm->cfg.usb_fallback_ms);
+    }
+    icm_announce(icm, p);
+}
+
+static void icm_unplug(USB4ICM *icm, unsigned p)
+{
+    ICMPort *ip = &icm->port[p];
+
+    if (!ip->present) {
+        return;
+    }
+    usb4_timer_del(icm->fb[p].timer);
+    /* Host side of the tunnel; the device router has reset itself. */
+    icm_tunnel_down(icm, p);
+    icm_announce_gone(icm, p);
+    ip->present = false;
+    ip->gen = ++icm->gen;       /* a pending approve no longer applies */
+    ip->approved = false;       /* re-plug needs a new approve, 7 */
+    ip->boot = false;
+    trace_usb4_icm_state(p, "device router gone");
+}
+
+void usb4_icm_hotplug(USB4ICM *icm, USB4Router *r, unsigned adapter,
+                      bool unplug)
+{
+    USB4Adapter *a = usb4_router_adapter(r, adapter);
+
+    if (!r->is_host || !a || a->kind != USB4_ADP_LANE || a->lane != 0) {
+        /* Lane 1 events and deeper routers: nothing to announce. */
+        trace_usb4_icm_hotplug(r->phys_route, adapter, unplug, "ignored");
+        return;
+    }
+    trace_usb4_icm_hotplug(r->phys_route, adapter, unplug,
+                           unplug ? "unplug" : "plug");
+    if (unplug) {
+        icm_unplug(icm, a->port->index);
+    } else {
+        icm_plug(icm, a->port->index, a);
+    }
+}
+
+void usb4_icm_next_reset_hot(USB4ICM *icm)
+{
+    icm->next_reset_hot = true;
+}
+
+void usb4_icm_set_silent(USB4ICM *icm, bool silent)
+{
+    if (icm && icm->silent != silent) {
+        icm->silent = silent;
+        trace_usb4_icm_silent(silent);
+    }
+}
+
+bool usb4_icm_parse_boot_acl(const char *list, uint32_t acl[32],
+                             Error **errp)
+{
+    g_auto(GStrv) items = NULL;
+    unsigned n = 0;
+
+    memset(acl, 0xff, 32 * sizeof(uint32_t));
+    if (!list || !*list) {
+        return true;
+    }
+    items = g_strsplit(list, ";", -1);
+    for (char **it = items; *it; it++) {
+        QemuUUID u;
+
+        if (!**it) {
+            continue;
+        }
+        if (n == ICM_ACL_SLOTS || qemu_uuid_parse(*it, &u) < 0) {
+            error_setg(errp, "boot-acl: bad or too many UUIDs at '%s' "
+                       "(up to 16, separated by ';')", *it);
+            return false;
+        }
+        /* sysfs unique_id order: string byte k is UUID byte k (4.6) */
+        acl[2 * n] = ldl_le_p(u.data);
+        acl[2 * n + 1] = ldl_le_p(u.data + 4);
+        n++;
+    }
+    return true;
+}
+
+void usb4_icm_reset(USB4ICM *icm)
+{
+    uint32_t v = 1u << 31;
+
+    trace_usb4_icm_reset();
+    /*
+     * A machine reset is a power-on of the controller (R25); a power-up
+     * of the controller alone (R27) is not.
+     */
+    icm->power_on = !icm->next_reset_hot;
+    icm->next_reset_hot = false;
+    icm->driver_ready = false;
+    usb4_timer_del(icm->ready_timer);
+    icm->holding = false;       /* the fabric reset drops its hold */
+    usb4_timer_del(icm->ap_link_timer);
+    usb4_timer_del(icm->ap_resp_timer);
+    icm->ap_active = false;
+    if (icm->power_on) {
+        icm->first_ready = true;
+    }
+    icm->silent = false;        /* a powered-up firmware answers (R32) */
+    for (unsigned p = 0; p <= USB4_MAX_PORTS; p++) {
+        memset(&icm->port[p], 0, sizeof(icm->port[p]));
+        usb4_timer_del(icm->fb[p].timer);
+    }
+    /*
+     * R33 at machine power-on: every USB4 device router starts on its
+     * USB4 link again. One that no client can approve (no pre-boot) has
+     * fallen back to USB before the OS runs, as in the P14s pre-boot-off
+     * runs (ICM-PROTOCOL.md 13.1, R1-D:1.51): the model skips the 9.4 s
+     * the real firmware spends in POST. A controller power-up (R27) keeps
+     * the mode the device is in.
+     */
+    for (unsigned p = 1; icm->power_on && p <= icm->f->hr->nports; p++) {
+        USB4Router *dr = icm_port_router(icm, p);
+
+        if (!dr) {
+            continue;
+        }
+        usb4_fabric_set_usb_mode(dr, false, true);
+        if (icm_falls_back(icm, dr) && !icm_preboot_approves(icm, dr)) {
+            trace_usb4_icm_state(p, "USB fallback before the OS");
+            usb4_fabric_set_usb_mode(dr, true, true);
+        }
+    }
+    /*
+     * Firmware running at power-on (ICM-PROTOCOL.md 2.1): the host
+     * router is configured, route 0 (captured header dword 3
+     * 0x80000000). Enumerating it reports attached ports, which come
+     * back here as plug events.
+     */
+    usb4_router_write(icm->f->hr, USB4_CS_ROUTER, 0, 3, 1, &v);
+    /*
+     * A tb3 host router comes out of reset already configured, so the
+     * write above may not be a 0 -> 1 transition: report the attached
+     * ports explicitly (a no-op for ports already reported).
+     */
+    usb4_fabric_hp_enumerated(icm->f->hr);
+    /* The pre-boot window closes with the power-on reset (R25). */
+    icm->power_on = false;
+}
+
+/* ------------------------------------------------------------------ */
+/* Commands                                                             */
+/* ------------------------------------------------------------------ */
+
+static void icm_reply_error(USB4ICM *icm, const uint32_t *req, unsigned ndw)
+{
+    uint32_t dw[USB4_CTL_MAX_FRAME / 4];
+
+    /* R15: the request with the error flag, index 0, count 1. */
+    ndw = MIN(ndw, ARRAY_SIZE(dw));
+    memcpy(dw, req, ndw * 4);
+    dw[0] = icm_header(req[0], ((req[0] >> 8) & 0xff) | ICM_FLAG_ERROR);
+    icm_send(icm, USB4_PDF_ICM_RESP, dw, ndw);
+}
+
+/* Announce every attached router not yet announced, in adapter order */
+static void icm_announce_all(USB4ICM *icm)
+{
+    for (unsigned p = 1; p <= icm->f->hr->nports; p++) {
+        if (icm->port[p].present && !icm->port[p].announced) {
+            icm_announce(icm, p);
+        }
+    }
+}
+
+static void icm_driver_ready(USB4ICM *icm)
+{
+    uint32_t dw[ICM_TR_DR_WORDS] = { 0 };
+    uint32_t hold;
+    bool any = false;
+    /*
+     * R8: flags 0xe2 with bit 6 (RTD3) from the property. Under BIOS
+     * Assist the firmware answers 0x22, bits 7 and 6 clear (R4-T:86.764,
+     * ICM-PROTOCOL.md 13.5; CAPTURE-VS-LINUX.md AR-27).
+     */
+    unsigned flags = (icm->cfg.bios_assist ? ICM_DR_FLAGS_ASSIST
+                                           : ICM_DR_FLAGS) &
+                     ~ICM_DR_FLAG_RTD3;
+
+    if (icm->cfg.rtd3) {
+        flags |= ICM_DR_FLAG_RTD3;
+    }
+    dw[0] = icm_header(ICM_CMD_DRIVER_READY, flags);
+    if (icm_tr(icm)) {
+        uint32_t info;
+
+        /*
+         * TR T2: info in bits 31:16 of word 1 (security level 2:0,
+         * protocol version 6:4, boot ACL count 12:7, no separate
+         * "supported" bit), NVM version word, NHI device ID in the low
+         * half of word 3. RTD3 stays flags bit 6.
+         */
+        info = (icm->cfg.security & 7) | (ICM_TR_PROTO_VERSION << 4) |
+               ((uint32_t)(icm->cfg.boot_acl_slots & 0x3f) << 7);
+        dw[1] = info << 16;
+        dw[2] = icm->cfg.nvm_version;
+        dw[3] = icm->cfg.device_id;
+    } else {
+        /* R8, ICM-PROTOCOL.md 4.1: captured 0x0100e203 0x28010b60 */
+        dw[1] = ICM_ROM_VERSION | (ICM_RAM_VERSION << 8) |
+                ((uint32_t)(icm->cfg.security & 0xf) << 16);
+        if (icm->cfg.boot_acl_slots) {
+            dw[1] |= ((uint32_t)(icm->cfg.boot_acl_slots & 0x1f) << 23) |
+                     (1u << 29);
+        }
+    }
+    trace_usb4_icm_driver_ready(icm->cfg.security, icm->cfg.rtd3,
+                                icm->cfg.boot_acl_slots);
+    icm_send(icm, USB4_PDF_ICM_RESP, dw, icm_tr(icm) ? ICM_TR_DR_WORDS : 2);
+
+    /* R8, R12: then announce every attached router, in adapter order. */
+    icm->driver_ready = true;
+    for (unsigned p = 1; p <= USB4_MAX_PORTS; p++) {
+        icm->port[p].announced = false;
+    }
+    if (icm->holding) {
+        return;             /* a repeated driver ready: still announcing */
+    }
+    hold = icm->first_ready ? icm->cfg.first_ready_hold_ms
+                            : icm->cfg.ready_hold_ms;
+    icm->first_ready = false;
+    for (unsigned p = 1; p <= icm->f->hr->nports; p++) {
+        any |= icm->port[p].present;
+    }
+    if (hold && any) {
+        /*
+         * ICM-PROTOCOL.md 6.2, 13.5: the host router answers only once
+         * the attached devices are announced (580 ms on a rebind with
+         * the dock, 2.77 s at the first driver ready under BIOS Assist
+         * with the pre-boot ORICO; at once with nothing to announce).
+         */
+        icm->holding = true;
+        usb4_fabric_cfg_hold(icm->f, true);
+        usb4_timer_mod_ms(icm->ready_timer, hold);
+        return;
+    }
+    icm_announce_all(icm);
+}
+
+static void icm_ready_timer(void *opaque)
+{
+    USB4ICM *icm = opaque;
+
+    if (!icm->holding) {
+        return;
+    }
+    icm->holding = false;
+    if (icm->driver_ready) {
+        icm_announce_all(icm);
+    }
+    usb4_fabric_cfg_hold(icm->f, false);
+}
+
+static void icm_hold_end(USB4ICM *icm)
+{
+    usb4_timer_del(icm->ready_timer);
+    if (icm->holding) {
+        icm->holding = false;
+        usb4_fabric_cfg_hold(icm->f, false);
+    }
+}
+
+static void icm_get_route(USB4ICM *icm, const uint32_t *req, unsigned ndw)
+{
+    uint32_t dw[4] = { 0 };
+    unsigned info, link, depth;
+
+    if (ndw < 2) {
+        icm_reply_error(icm, req, ndw);
+        return;
+    }
+    info = req[1] >> 16;
+    link = info & 7;
+    depth = (info >> 4) & 0xf;
+    dw[1] = req[1];
+    /* R9: depth 1 only, route = link (host lane adapter number) */
+    for (unsigned p = 1; p <= icm->f->hr->nports; p++) {
+        if (depth == 1 && icm->port[p].present &&
+            icm->port[p].link == link) {
+            dw[0] = icm_header(ICM_CMD_GET_ROUTE, 0);
+            dw[3] = link;
+            trace_usb4_icm_get_route(link, depth, link, true);
+            icm_send(icm, USB4_PDF_ICM_RESP, dw, 4);
+            return;
+        }
+    }
+    trace_usb4_icm_get_route(link, depth, 0, false);
+    dw[0] = icm_header(ICM_CMD_GET_ROUTE, ICM_FLAG_ERROR);
+    icm_send(icm, USB4_PDF_ICM_RESP, dw, 4);
+}
+
+/*
+ * Does the pending approve still apply: the same connection it was
+ * requested for, not unplugged, re-plugged or disconnected since?
+ */
+static bool icm_approve_valid(USB4ICM *icm)
+{
+    ICMPort *ip = &icm->port[icm->ap_port];
+
+    return icm->ap_active && ip->present && ip->gen == icm->ap_gen;
+}
+
+static void icm_approve_link(void *opaque)
+{
+    USB4ICM *icm = opaque;
+    ICMPort *ip = &icm->port[icm->ap_port];
+
+    if (!icm_approve_valid(icm)) {
+        if (icm->ap_active) {
+            trace_usb4_icm_approve(ip->link, "connection changed, dropped");
+        }
+        return;
+    }
+    if (!ip->approved) {
+        ip->approved = icm_tunnel_up(icm, icm->ap_port);
+        trace_usb4_icm_approve(ip->link, ip->approved ? "tunnel up"
+                                                      : "fabric failure");
+    }
+}
+
+static void icm_approve_resp(void *opaque)
+{
+    USB4ICM *icm = opaque;
+    ICMPort *ip = &icm->port[icm->ap_port];
+    uint32_t dw[ICM_TR_APPROVE_WORDS];
+    bool ok;
+
+    if (!icm->ap_active) {
+        return;
+    }
+    usb4_timer_del(icm->ap_link_timer);
+    icm_approve_link(icm);
+    ok = icm_approve_valid(icm) && ip->approved;
+    icm->ap_active = false;
+    memcpy(dw, icm->ap_req, icm->ap_len * 4);
+    dw[0] = icm_header(ICM_CMD_APPROVE, ok ? 0 : ICM_FLAG_ERROR);
+    icm_send(icm, USB4_PDF_ICM_RESP, dw, icm->ap_len);
+}
+
+static void icm_approve(USB4ICM *icm, const uint32_t *req, unsigned ndw)
+{
+    uint32_t dw[ICM_TR_APPROVE_WORDS];
+    unsigned key, id, len = icm_tr(icm) ? ICM_TR_APPROVE_WORDS : 6;
+    uint64_t route = 0;
+    const char *res = "unknown device";
+    bool ok = false;
+
+    if (icm->ap_active) {
+        /* one command at a time (3): a second approve meanwhile fails */
+        icm_reply_error(icm, req, ndw);
+        return;
+    }
+    if (ndw < len) {
+        icm_reply_error(icm, req, ndw);
+        return;
+    }
+    if (icm_tr(icm)) {
+        /* TR T6: UUID, route high, route low, connection id; no key */
+        route = ((uint64_t)req[5] << 32) | req[6];
+        key = ICM_CONN_KEY;
+        id = req[7] & 0xff;
+    } else {
+        key = req[5] & 0xff;
+        id = (req[5] >> 8) & 0xff;
+    }
+    for (unsigned p = 1; p <= icm->f->hr->nports; p++) {
+        ICMPort *ip = &icm->port[p];
+        bool match = ip->present;
+
+        for (unsigned i = 0; match && i < 4; i++) {
+            match = req[1 + i] == ldl_le_p(ip->uuid + 4 * i);
+        }
+        if (!match) {
+            continue;
+        }
+        if (key != ICM_CONN_KEY || id != ip->conn_id) {
+            res = "stale key or connection id";
+        } else if (icm_tr(icm) && route != ip->route) {
+            res = "wrong route";
+        } else if (ip->approved) {
+            res = "already approved";
+            ok = true;
+        } else if (icm->cfg.approve_link_ms || icm->cfg.approve_resp_ms) {
+            /*
+             * R10 with the observed timing (ICM-PROTOCOL.md 4.3, 13.3):
+             * the tunnel comes up while the approve is processed, the
+             * response follows; the client allows 10 s.
+             */
+            trace_usb4_icm_approve(ip->link, "in progress");
+            usb4_timer_del(icm->fb[p].timer);          /* R33 */
+            icm->ap_active = true;
+            icm->ap_port = p;
+            icm->ap_gen = ip->gen;
+            icm->ap_len = len;
+            memcpy(icm->ap_req, req, len * 4);
+            usb4_timer_mod_ms(icm->ap_link_timer, icm->cfg.approve_link_ms);
+            usb4_timer_mod_ms(icm->ap_resp_timer,
+                              MAX(icm->cfg.approve_resp_ms,
+                                  icm->cfg.approve_link_ms));
+            return;
+        } else {
+            ip->approved = icm_tunnel_up(icm, p);
+            ok = ip->approved;
+            res = ok ? "tunnel up" : "fabric failure";
+            if (ok) {
+                usb4_timer_del(icm->fb[p].timer);      /* R33 */
+            }
+        }
+        trace_usb4_icm_approve(ip->link, res);
+        break;
+    }
+    if (!ok && !strcmp(res, "unknown device")) {
+        trace_usb4_icm_approve(0, res);
+    }
+    /* R10, TR T6: the request words, flags 0 or the error flag */
+    memcpy(dw, req, len * 4);
+    dw[0] = icm_header(ICM_CMD_APPROVE, ok ? 0 : ICM_FLAG_ERROR);
+    icm_send(icm, USB4_PDF_ICM_RESP, dw, len);
+}
+
+static void icm_boot_acl(USB4ICM *icm, const uint32_t *req, unsigned ndw)
+{
+    uint32_t dw[1 + 2 * ICM_ACL_SLOTS] = { 0 };
+    unsigned flags = (req[0] >> 8) & 0xff;
+
+    /*
+     * R14, ICM-PROTOCOL.md 4.6: a write carries the whole list in one
+     * packet (33 words, packet index and count 0 as observed). A partial
+     * or multi-packet write is refused with the error flag and leaves
+     * the stored ACL untouched.
+     */
+    if (flags & ICM_ACL_WRITE) {
+        if (ndw != 1 + 2 * ICM_ACL_SLOTS || (req[0] >> 16)) {
+            trace_usb4_icm_bad_frame(ndw * 4, "boot ACL write not a full "
+                                     "single packet");
+            icm_reply_error(icm, req, ndw);
+            return;
+        }
+        memcpy(icm->acl, &req[1], sizeof(icm->acl));
+        dw[0] = icm_header(ICM_CMD_BOOT_ACL, ICM_ACL_WRITE);
+    } else {
+        memcpy(&dw[1], icm->acl, sizeof(icm->acl));
+        dw[0] = icm_header(ICM_CMD_BOOT_ACL, 0);
+    }
+    trace_usb4_icm_boot_acl(!!(flags & ICM_ACL_WRITE));
+    icm_send(icm, USB4_PDF_ICM_RESP, dw, ARRAY_SIZE(dw));
+}
+
+void usb4_icm_tx_frame(USB4ICM *icm, const uint8_t *frame, size_t len)
+{
+    uint32_t dw[USB4_CTL_MAX_FRAME / 4];
+    char hex[USB4_CTL_MAX_FRAME / 4 * 9 + 1];
+    unsigned ndw;
+
+    if (!icm) {
+        return;
+    }
+    if (len < 8 || (len & 3) || len > USB4_CTL_MAX_FRAME) {
+        trace_usb4_icm_bad_frame((unsigned)len, "bad length");
+        return;
+    }
+    /*
+     * ICM-PROTOCOL.md 3: the host appends a CRC-32C trailer, the same
+     * as on control packets (the Linux client's commands all matched it
+     * in the M2 runs). A frame with a bad CRC is dropped unanswered, as
+     * the fabric drops bad control packets (ARCHITECTURE.md 4.2).
+     */
+    if (!usb4_ctl_frame_crc_ok(frame, len)) {
+        trace_usb4_icm_bad_frame((unsigned)len, "CRC mismatch, dropped");
+        return;
+    }
+    ndw = len / 4 - 1;
+    for (unsigned i = 0; i < ndw; i++) {
+        dw[i] = ldl_be_p(frame + 4 * i);
+    }
+    usb4_ctl_hexdump(hex, sizeof(hex), dw, ndw);
+    trace_usb4_icm_cmd(dw[0] & 0xff, (dw[0] >> 8) & 0xff, ndw, hex);
+    if (icm->silent) {
+        /*
+         * R32: with BIOS Assist on, from the last device's departure
+         * until the platform powers the controller off, the firmware
+         * leaves every command unanswered (ICM-PROTOCOL.md 12.3).
+         */
+        trace_usb4_icm_cmd_dropped(dw[0] & 0xff, "firmware silent (R32)");
+        return;
+    }
+
+    switch (dw[0] & 0xff) {
+    case ICM_CMD_DRIVER_READY:
+        icm_driver_ready(icm);
+        break;
+    case ICM_CMD_GET_ROUTE:
+        if (icm_tr(icm)) {
+            /* TR T7: events carry the route; no get route */
+            icm_reply_error(icm, dw, ndw);
+        } else {
+            icm_get_route(icm, dw, ndw);
+        }
+        break;
+    case ICM_CMD_APPROVE:
+        icm_approve(icm, dw, ndw);
+        break;
+    case ICM_CMD_BOOT_ACL:
+        if (icm->cfg.boot_acl_slots) {
+            icm_boot_acl(icm, dw, ndw);
+        } else {
+            icm_reply_error(icm, dw, ndw);
+        }
+        break;
+    default:
+        /* R15: 0x01, 0x05, 0x06, 0x10, 0x11, 0x20 and unknown codes */
+        icm_reply_error(icm, dw, ndw);
+        break;
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* NHI mailbox, R3                                                      */
+/* ------------------------------------------------------------------ */
+
+bool usb4_icm_mailbox(USB4ICM *icm, uint8_t cmd, uint32_t data)
+{
+    bool ok = true;
+
+    switch (cmd) {
+    case ICM_MBOX_DRIVER_UNLOADS:
+        /* Stop sending events; tunnels and approvals stay (2.3). */
+        icm->driver_ready = false;
+        for (unsigned p = 0; p <= USB4_MAX_PORTS; p++) {
+            icm->port[p].announced = false;
+        }
+        /*
+         * Last: ending the hold serves the held requests and resumes the
+         * TX ring at once, which may carry a driver ready queued behind
+         * them. It then finds the unload complete and announces into
+         * consistent bookkeeping (review: a later disconnect must not
+         * be suppressed).
+         */
+        icm_hold_end(icm);
+        break;
+    case ICM_MBOX_DISCONNECT_PCIE:
+        /* Every PCIe tunnel down through the synchronous gate (R22). */
+        /*
+         * Every host port, whatever the approval bookkeeping says: no
+         * PCIe tunnel may survive this command.
+         */
+        for (unsigned p = 1; p <= icm->f->hr->nports; p++) {
+            icm_tunnel_down(icm, p);
+            icm->port[p].approved = false;
+            icm->port[p].boot = false;
+            /* an approve in progress must not rebuild the tunnel */
+            icm->port[p].gen = ++icm->gen;
+        }
+        break;
+    case ICM_MBOX_SAVE_DEVICES:
+    case ICM_MBOX_ALLOW_ALL:
+    case ICM_MBOX_DISCONNECT_PA:
+    case ICM_MBOX_DISCONNECT_PB:
+        break;
+    default:
+        ok = false;
+        break;
+    }
+    trace_usb4_icm_mailbox(cmd, data, ok);
+    return ok;
+}
+
+/* ------------------------------------------------------------------ */
+/* Lifecycle                                                            */
+/* ------------------------------------------------------------------ */
+
+USB4ICM *usb4_icm_new(USB4Fabric *f, const USB4ICMConfig *cfg)
+{
+    USB4ICM *icm;
+
+    if (!f) {
+        return NULL;
+    }
+    icm = g_new0(USB4ICM, 1);
+    icm->f = f;
+    icm->cfg = *cfg;
+    icm->ready_timer = usb4_timer_new(icm_ready_timer, icm);
+    icm->ap_link_timer = usb4_timer_new(icm_approve_link, icm);
+    icm->ap_resp_timer = usb4_timer_new(icm_approve_resp, icm);
+    icm->first_ready = true;
+    for (unsigned p = 0; p <= USB4_MAX_PORTS; p++) {
+        icm->fb[p].icm = icm;
+        icm->fb[p].port = p;
+        icm->fb[p].timer = usb4_timer_new(icm_fallback_timer, &icm->fb[p]);
+    }
+    if (icm->cfg.boot_acl_slots > ICM_ACL_SLOTS) {
+        icm->cfg.boot_acl_slots = ICM_ACL_SLOTS;
+    }
+    /*
+     * R14, R26: 16 slots, empty or from the boot-acl property; guest
+     * writes persist for the life of the process (not reset).
+     */
+    memcpy(icm->acl, cfg->boot_acl, sizeof(icm->acl));
+    /* Devices attached at realize see the power-on window too (R25). */
+    icm->power_on = true;
+    usb4_fabric_set_icm(f, icm);
+    return icm;
+}
+
+void usb4_icm_free(USB4ICM *icm)
+{
+    if (icm) {
+        usb4_fabric_set_icm(icm->f, NULL);
+        for (unsigned p = 0; p <= USB4_MAX_PORTS; p++) {
+            usb4_timer_free(icm->fb[p].timer);
+        }
+        usb4_timer_free(icm->ready_timer);
+        usb4_timer_free(icm->ap_link_timer);
+        usb4_timer_free(icm->ap_resp_timer);
+        g_free(icm);
+    }
+}
diff --git a/hw/usb4/usb4-internal.h b/hw/usb4/usb4-internal.h
