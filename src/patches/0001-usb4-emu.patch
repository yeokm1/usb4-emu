+static void test_tb3_host(void)
+{
+    /* Captured values, docs/ICM-PROTOCOL.md 5.1 */
+    static const uint32_t hdr[5] = {
+        0x15c08086, 0x01014305, 0x00000000, 0x80000000, 0x020000fe,
+    };
+    static const struct { unsigned off; uint32_t v; } chain[] = {
+        { 0x05, 0x03200320 }, { 0x20, 0x07000528 }, { 0x28, 0x35010563 },
+        { 0x63, 0x08020579 }, { 0x79, 0x320305ac }, { 0xac, 0x220405cf },
+        { 0xcf, 0x110505ff }, { 0xff, 0x00060500 },
+    };
+    static const uint32_t plug[13] = {
+        0x35010563, 0x00005281, 0x00000000, 0x00ff0000, 0x0002018a,
+        0xe4454321, 0x00000000, 0x00000000, 0x93563562, 0x00007ffe,
+        0x00000000, 0x00000000, 0x00000210,
+    };
+    static const uint32_t lc_uuid[4] = {
+        0x000001cd, 0x88808200, 0x8a6159a0, 0x0220a110,
+    };
+    static const uint32_t adp_type[6] = {
+        0, 0x01000001, 0x01000001, 0, 0x01100101, 0x010e0101,
+    };
+    static const uint32_t pcie_hdr[6] = {
+        0x15c08086, 0x01080239, 0x01100101, 0x80400008, 0x00800000,
+        0x00004008,
+    };
+    uint32_t v[60];
+    uint8_t ee[9];
+    USB4Router *hr = fab->hr;
+
+    CHECK(rd(HOST, USB4_CS_ROUTER, 0, 0, 5, v) == 0 &&
+          !memcmp(v, hdr, sizeof(hdr)), "tb3 host header %08x %08x %08x "
+          "%08x %08x", v[0], v[1], v[2], v[3], v[4]);
+    CHECK(USB4_REQ_ADP(last_rsp_dw2) == 3, "reply adapter %u (R17)",
+          USB4_REQ_ADP(last_rsp_dw2));
+    for (unsigned i = 0; i < ARRAY_SIZE(chain); i++) {
+        CHECK(rd1(HOST, USB4_CS_ROUTER, 0, chain[i].off) == chain[i].v,
+              "capability header at 0x%x", chain[i].off);
+    }
+    CHECK((rd1(HOST, USB4_CS_ROUTER, 0, 0x100) & 0xffff) == 0,
+          "link controller ends the chain");
+    CHECK(rd(HOST, USB4_CS_ROUTER, 0, 0x28, 13, v) == 0 &&
+          !memcmp(v, plug, sizeof(plug)), "plug events capability");
+    CHECK(rd(HOST, USB4_CS_ROUTER, 0, 0x102, 4, v) == 0 &&
+          !memcmp(v, lc_uuid, sizeof(lc_uuid)), "link controller UUID");
+    /* Captured: a 60-dword read at 0x1b3 fails with code 2, 1 dword not */
+    CHECK(rd(HOST, USB4_CS_ROUTER, 0, 0x1b3, 60, v) == 0x102,
+          "read past the router space");
+    CHECK(rd(HOST, USB4_CS_ROUTER, 0, 0x1b3, 1, v) == 0, "read 0x1b3");
+    for (unsigned a = 1; a <= 5; a++) {
+        CHECK(rd1(HOST, USB4_CS_ADAPTER, a, 2) == adp_type[a],
+              "host adapter %u type (R18)", a);
+        CHECK(USB4_REQ_ADP(last_rsp_dw2) == a, "adapter reply echo");
+    }
+    CHECK(rd(HOST, USB4_CS_ADAPTER, 4, 0, 6, v) == 0 &&
+          !memcmp(v, pcie_hdr, sizeof(pcie_hdr)), "PCIe down header");
+    CHECK(rd1(HOST, USB4_CS_ADAPTER, 4, 0x39) == 0x01260400,
+          "idle PCIe adapter capability");
+    CHECK(rd1(HOST, USB4_CS_ADAPTER, 1, 0x0a) == 0x00000336 &&
+          rd1(HOST, USB4_CS_ADAPTER, 1, 0x36) == 0x003c013e &&
+          rd1(HOST, USB4_CS_ADAPTER, 1, 0x3e) == 0x10000500,
+          "lane capability chain");
+    CHECK(rd1(HOST, USB4_CS_ADAPTER, 5, 0x39) == 0x0000044f, "DP IN cap");
+    /* Unlinked lane, captured snapshot 7 */
+    CHECK(rd1(HOST, USB4_CS_ADAPTER, 1, 0x37) == 0x1c14001c &&
+          rd1(HOST, USB4_CS_ADAPTER, 1, 4) == 0x03c00000, "lane unlinked");
+    CHECK(rd(HOST, USB4_CS_ADAPTER, 3, 9, 1, v) == 0x102,
+          "NHI adapter has no DMA port (ARCHITECTURE 4.2)");
+
+    /* EEPROM: CRC-8 and UID at 0x210 (R19) */
+    ee_read(HOST, 0x210, ee, sizeof(ee));
+    CHECK(!memcmp(ee, hr->drom, sizeof(ee)), "host EEPROM UID bytes");
+    CHECK(usb4_drom_crc8(ee + 1, 8) == ee[0], "host EEPROM UID CRC-8");
+    CHECK(((uint64_t)ee[8] << 8 | ee[7]) == USB4_TB3_DROM_VENDOR,
+          "UID carries the DROM vendor ID");
+    CHECK(rd1(HOST, USB4_CS_ROUTER, 0, TB3_EE) == 0x0002018a,
+          "EEPROM control idle again");
+}
