+/* ---- daisy chain: usb4-device downstream-ports behind the tunnel ---- */
+
+#define DSP_PATH "/machine/peripheral/tp0-sw1-usb4dp1"
+
+static void dsp_set_tunnel(QTestState *qts, const char *state)
+{
+    qtest_qmp_assert_success(qts, "{'execute': 'qom-set', 'arguments': "
+                             "{'path': %s, 'property': 'tunnel', "
+                             "'value': %s}}", DSP_PATH, state);
+}
+
+static void dsp_set_hold(QTestState *qts, bool hold)
+{
+    qtest_qmp_assert_success(qts, "{'execute': 'qom-set', 'arguments': "
+                             "{'path': %s, 'property': 'x-hold-deferred', "
+                             "'value': %i}}", DSP_PATH, hold);
+}
+
+/*
+ * usb4-tunnel-port with a usb4-device switch behind it, bus numbers
+ * programmed: upstream port (bus 1), downstream port 0 with the NVMe
+ * (bus 3), usb4-tunnel-dsp for USB4 port 1 (bus 4, empty).
+ */
+static QTestState *switch_start(const char *img)
+{
+    QTestState *qts;
+
+    qts = qtest_initf("-machine q35 "
+                      "-global ICH9-LPC.acpi-pci-hotplug-with-bridge-support=off "
+                      "-drive if=none,id=disk0,file=%s,format=raw "
+                      "-device usb4-tunnel-port,id=tp0,bus=pcie.0,addr=0x3,"
+                      "chassis=1,settle-ms=200 "
+                      "-device usb4-host,id=u4,bus=pcie.0,addr=0x4,"
+                      "tunnel-port=tp0 "
+                      "-device usb4-device,id=enc0,bus=u4.0,port=1,"
+                      "drive=disk0,serial=QTC,downstream-ports=1", img);
+
+    cfg_writel(qts, 0, TP_DEVFN, 0x18, 0x00050100);
+    cfg_writel(qts, 0, TP_DEVFN, find_exp_cap(qts) + 0x18, 0x0100);
+    set_tunnel(qts, "up");
+    g_assert_cmpuint(wait_stage(qts, "inserted"), ==, 1);
+
+    /*
+     * The device's switch: upstream port (bus 1), downstream port 0 with
+     * the NVMe (bus 3), usb4-tunnel-dsp for USB4 port 1 (bus 4, empty).
+     */
+    g_assert_cmphex(cfg_readl(qts, 1, 0, 0), ==, 0x8232104c);
+    cfg_writel(qts, 1, 0, 0x18, 0x00050201);
+    g_assert_cmphex(cfg_readl(qts, 2, 0, 0), ==, 0x8233104c);
+    cfg_writel(qts, 2, 0, 0x18, 0x00030302);
+    g_assert_cmphex(cfg_readl(qts, 3, 0, 0), ==, 0x00101b36);
+    g_assert_cmphex(cfg_readl(qts, 2, 1 << 3, 0), ==, 0x8233104c);
+    cfg_writel(qts, 2, 1 << 3, 0x18, 0x00040402);
+    g_assert(peripheral_exists(qts, "tp0-sw1-usb4dp1"));
+    g_assert_cmphex(cfg_readl(qts, 4, 0, 0), ==, 0xffffffff);
+    return qts;
+}
+
+static void test_chain_switch(void)
+{
+    g_autofree char *img = make_img();
+    QTestState *qts = switch_start(img);
+
+    /*
+     * Memory windows: 0xe0000000-0xe01fffff through the tunnel port and
+     * the switch's upstream port, the upper half through the DSP.
+     */
+    bridge_windows(qts, 0, TP_DEVFN, 0xe010e000);
+    bridge_windows(qts, 1, 0, 0xe010e000);
+    bridge_windows(qts, 2, 1 << 3, 0xe010e010);
+    assert_all_ones(qts, WIN_MEM + 0x100000);     /* DSP gate closed */
+
+    /* Chained tunnel up (forced): an endpoint behind the DSP. */
+    cfg_writel(qts, 2, 1 << 3, 0x90 + 0x18, 0x0100);
+    dsp_set_tunnel(qts, "up");
+    g_assert_cmpuint(wait_stage(qts, "inserted"), ==, 1);
+    g_assert_cmphex(cfg_readl(qts, 4, 0, 0), ==, 0x00101b36);
+    nvme_map(qts, 4, 0, WIN_MEM + 0x100000);
+    g_assert_cmphex(qtest_readl(qts, WIN_MEM + 0x100000 + NVME_CSTS), ==, 0);
+
+    /* Chained tunnel down: only the DSP's gate closes. */
+    dsp_set_hold(qts, true);
+    dsp_set_tunnel(qts, "surprise");
+    g_assert_cmpuint(wait_stage(qts, "gated"), ==, 1);
+    g_assert_cmphex(cfg_readl(qts, 4, 0, 0), ==, 0xffffffff);
+    g_assert_cmphex(cfg_readl(qts, 3, 0, 0), ==, 0x00101b36);
+    g_assert_cmphex(qtest_readl(qts, WIN_MEM + 0x100000 + NVME_CSTS), ==,
+                    0xffffffff);
+    assert_all_ones(qts, WIN_MEM + 0x100000);
+
+    /* The outer tunnel goes: the switch and the DSP with it. */
+    set_tunnel(qts, "surprise");
+    g_assert_cmpuint(wait_stage(qts, "removed"), ==, 1);
+    g_assert(!peripheral_exists(qts, "tp0-sw1-usb4dp1"));
+    g_assert(!peripheral_exists(qts, "tp0-sw1-nvme"));
+
+    qtest_quit(qts);
+    unlink(img);
+}
+
+#define DSP_MEM     (WIN_MEM + 0x100000)
+#define MTREE_DSP_WIN "00000000e0100000-00000000e01fffff"
+
+/* Windows down to the DSP, its slot powered and its tunnel up. */
+static void chain_dsp_up(QTestState *qts, uint64_t gen)
+{
+    bridge_windows(qts, 0, TP_DEVFN, 0xe010e000);
+    bridge_windows(qts, 1, 0, 0xe010e000);
+    bridge_windows(qts, 2, 1 << 3, 0xe010e010);
+    cfg_writel(qts, 2, 1 << 3, 0x90 + 0x18, 0x0100);
+    dsp_set_tunnel(qts, "up");
+    g_assert_cmpuint(wait_stage(qts, "inserted"), ==, gen);
+    nvme_map(qts, 4, 0, DSP_MEM);
+    g_assert_cmphex(qtest_readl(qts, DSP_MEM + NVME_CSTS), ==, 0);
+}
+
+/*
+ * The outer tunnel's gate closes while the DSP's stays open: the nested
+ * endpoint is cut off at the tunnel port, reads all-ones there, and its
+ * config space reads all-ones too.
+ */
+static void test_chain_nested_gate(void)
+{
+    g_autofree char *img = make_img();
+    QTestState *qts = switch_start(img);
+
+    chain_dsp_up(qts, 1);
+    set_hold(qts, true);
+    set_tunnel(qts, "surprise");
+    g_assert_cmpuint(wait_stage(qts, "gated"), ==, 1);
+    g_assert(peripheral_exists(qts, "tp0-sw1-usb4dp1"));
+    /* The DSP's own gate is still open: its stand-ins stay off. */
+    g_assert(!mtree_line(qts, MTREE_DSP_WIN, "usb4-tunnel-gate-ones"));
+    g_assert(mtree_enabled(qts, "usb4-tunnel-gate-ones-mem",
+                           "00000000e0000000-00000000e01fffff"));
+    g_assert_cmphex(qtest_readl(qts, DSP_MEM + NVME_CSTS), ==, 0xffffffff);
+    assert_all_ones(qts, DSP_MEM);
+    g_assert_cmphex(cfg_readl(qts, 4, 0, 0), ==, 0xffffffff);
+    qtest_writel(qts, DSP_MEM + NVME_CC, 1);         /* dropped */
+
+    set_hold(qts, false);
+    g_assert_cmpuint(wait_stage(qts, "removed"), ==, 1);
+    g_assert(!peripheral_exists(qts, "tp0-sw1-usb4dp1"));
+    assert_all_ones(qts, DSP_MEM);
+    qtest_quit(qts);
+    unlink(img);
+}
+
+/* Secondary bus reset from the switch's upstream port: resets the DSP. */
+static void chain_sbr(QTestState *qts)
+{
+    cfg_writel(qts, 1, 0, 0x3c, 0x00400000);
+    cfg_writel(qts, 1, 0, 0x3c, 0);
+}
+
+/*
+ * A usb4-tunnel-dsp reset (secondary bus reset above it) rebuilds its
+ * mappings: no stale all-ones with the gate closed, no stale forwarding
+ * alias with the gate open.
+ */
+static void test_chain_dsp_reset(void)
+{
+    g_autofree char *img = make_img();
+    QTestState *qts = switch_start(img);
+
+    /* Closed. */
+    bridge_windows(qts, 0, TP_DEVFN, 0xe010e000);
+    bridge_windows(qts, 1, 0, 0xe010e000);
+    bridge_windows(qts, 2, 1 << 3, 0xe010e010);
+    g_assert(mtree_enabled(qts, "usb4-tunnel-gate-ones-mem", MTREE_DSP_WIN));
+    assert_all_ones(qts, DSP_MEM);
+    chain_sbr(qts);
+    g_assert(!mtree_line(qts, MTREE_DSP_WIN, "usb4-tunnel-gate-ones"));
+    g_assert_cmphex(qtest_readl(qts, DSP_MEM + NVME_CSTS), ==, 0);
+
+    /* Open. */
+    cfg_writel(qts, 2, 1 << 3, 0x18, 0x00040402);
+    chain_dsp_up(qts, 1);
+    g_assert(mtree_line(qts, MTREE_DSP_WIN, MTREE_ALIAS_MEM));
+    chain_sbr(qts);
+    g_assert(!mtree_line(qts, MTREE_DSP_WIN, MTREE_ALIAS_MEM));
+    g_assert(!mtree_line(qts, MTREE_DSP_WIN, "usb4-tunnel-gate-ones"));
+    g_assert_cmphex(qtest_readl(qts, DSP_MEM + NVME_CSTS), ==, 0);
+
+    qtest_quit(qts);
+    unlink(img);
+}
+
+/* Function Level Reset of the DSP (it advertises FLR, as xio3130 does). */
+static void chain_dsp_flr(QTestState *qts)
+{
+    cfg_writel(qts, 2, 1 << 3, 0x90 + 0x08, 0x8000);
+}
+
+#define MTREE_LOW_MEM "0000000000000000-00000000000fffff"
+#define MTREE_LOW_IO "0000000000000000-0000000000000fff"
+
+/*
+ * An FLR of a usb4-tunnel-dsp clears its windows and, last, its Command
+ * register (pci_device_reset() runs the device reset before the generic
+ * PCI reset). The mappings follow the final state: decoding is off, so
+ * no forwarding alias over the cleared (zero) windows with the gate open
+ * and no all-ones stand-ins with it closed.
+ */
+static void test_chain_dsp_flr(void)
+{
+    g_autofree char *img = make_img();
+    QTestState *qts = switch_start(img);
+
+    /* Closed. */
+    bridge_windows(qts, 0, TP_DEVFN, 0xe010e000);
+    bridge_windows(qts, 1, 0, 0xe010e000);
+    bridge_windows(qts, 2, 1 << 3, 0xe010e010);
+    g_assert(mtree_enabled(qts, "usb4-tunnel-gate-ones-mem", MTREE_DSP_WIN));
+    chain_dsp_flr(qts);
+    g_assert_cmphex(cfg_readl(qts, 2, 1 << 3, 0x04) & 0xffff, ==, 0);
+    g_assert(!mtree_line(qts, MTREE_DSP_WIN, "usb4-tunnel-gate-ones"));
+    g_assert(!mtree_line(qts, MTREE_LOW_MEM, "usb4-tunnel-gate-ones"));
+    g_assert(!mtree_line(qts, MTREE_LOW_IO, "usb4-tunnel-gate-ones"));
+
+    /* Open. */
+    cfg_writel(qts, 2, 1 << 3, 0x18, 0x00040402);
+    chain_dsp_up(qts, 1);
+    g_assert(mtree_line(qts, MTREE_DSP_WIN, MTREE_ALIAS_MEM));
+    chain_dsp_flr(qts);
+    g_assert_cmphex(cfg_readl(qts, 2, 1 << 3, 0x04) & 0xffff, ==, 0);
+    g_assert(!mtree_line(qts, MTREE_DSP_WIN, MTREE_ALIAS_MEM));
+    g_assert(!mtree_line(qts, MTREE_LOW_MEM, MTREE_ALIAS_MEM));
+    g_assert(!mtree_line(qts, MTREE_LOW_IO, "alias pci_bridge_io"));
+    g_assert(!mtree_line(qts, MTREE_LOW_MEM, "usb4-tunnel-gate-ones"));
+    g_assert_cmphex(qtest_readl(qts, DSP_MEM + NVME_CSTS), ==, 0);
+
+    qtest_quit(qts);
+    unlink(img);
+}
+
+/* ---- Data Link Layer State Changed on hot insertion and reset ---- */
+
+#define SLTCTL_HPIE     (1u << 5)
+#define SLTCTL_PWR_IND_ON 0x0100u
+#define SLTCTL_DLLSCE   (1u << 12)
+#define SLTSTA_PDC      (1u << 3)
+#define SLTSTA_DLLSC    (1u << 8)
+#define SLTSTA_EVENTS   0x011fu     /* RW1C status bits (ABP..DLLSC) */
+#define LNKSTA_DLLLA    (1u << 13)
+
+/* Slot Status of the slot at @bus/@devfn (PCI Express capability @exp). */
+static uint16_t slot_status(QTestState *qts, int bus, int devfn, int exp)
+{
+    return cfg_readl(qts, bus, devfn, exp + 0x18) >> 16;
+}
+
+/*
+ * Only link-change interrupts: Hot-Plug Interrupt Enable and Data Link
+ * Layer State Changed Enable, no Presence Detect Changed or Attention
+ * Button Pressed enables (what pciehp leaves on a port with an
+ * attention button, docs/LINUX-TEST.md). Slot powered, indicator on.
+ */
+static void slot_link_irq_only(QTestState *qts, int bus, int devfn, int exp)
+{
+    cfg_writel(qts, bus, devfn, exp + 0x18,
+               SLTCTL_PWR_IND_ON | SLTCTL_HPIE | SLTCTL_DLLSCE);
+}
+
+/*
+ * Acknowledge the pending slot events (RW1C) with a 16-bit write to Slot
+ * Status only: a Slot Control write would complete a command, and the
+ * port ignores a write that also clears events which were not pending.
+ */
+static void slot_ack(QTestState *qts, int bus, int devfn, int exp)
+{
+    uint16_t sta = slot_status(qts, bus, devfn, exp) & SLTSTA_EVENTS;
+
+    qtest_outl(qts, 0xcf8, cfg_addr(bus, devfn, exp + 0x18));
+    qtest_outw(qts, 0xcfc + 2, sta);
+    g_assert_cmphex(slot_status(qts, bus, devfn, exp) & SLTSTA_EVENTS, ==,
+                    0);
+}
+
+static bool link_active(QTestState *qts, int bus, int devfn, int exp)
+{
+    return (cfg_readl(qts, bus, devfn, exp + 0x10) >> 16) & LNKSTA_DLLLA;
+}
+
+/*
+ * Hot insertion on the tunnel root port signals the link coming up as
+ * DLLSC (PCIe Base 4.0 7.5.3.11), so a guest with only link-change
+ * interrupts enabled sees it; so does a reinsertion after a surprise
+ * removal.
+ */
+static void test_port_dllsc_insert(void)
+{
+    g_autofree char *img = make_img();
+    QTestState *qts;
+    int exp;
+
+    qts = qtest_initf("-machine q35 "
+                      "-global ICH9-LPC.acpi-pci-hotplug-with-bridge-support=off "
+                      "-drive if=none,id=disk0,file=%s,format=raw "
+                      "-device usb4-tunnel-port,id=tp0,bus=pcie.0,addr=0x3,"
+                      "chassis=1,nvme-drive=disk0,nvme-serial=QTL,"
+                      "settle-ms=200", img);
+    exp = find_exp_cap(qts);
+    cfg_writel(qts, 0, TP_DEVFN, 0x18, 0x00010100);
+    slot_link_irq_only(qts, 0, TP_DEVFN, exp);
+    g_assert_cmphex(slot_status(qts, 0, TP_DEVFN, exp) & SLTSTA_DLLSC, ==, 0);
+
+    set_tunnel(qts, "up");
+    g_assert_cmpuint(wait_stage(qts, "inserted"), ==, 1);
+    g_assert(link_active(qts, 0, TP_DEVFN, exp));
+    g_assert_cmphex(slot_status(qts, 0, TP_DEVFN, exp) & SLTSTA_DLLSC, ==,
+                    SLTSTA_DLLSC);
+    slot_ack(qts, 0, TP_DEVFN, exp);
+
+    set_tunnel(qts, "surprise");
+    g_assert_cmpuint(wait_stage(qts, "removed"), ==, 1);
+    g_assert(!link_active(qts, 0, TP_DEVFN, exp));
+    g_assert_cmphex(slot_status(qts, 0, TP_DEVFN, exp) & SLTSTA_DLLSC, ==,
+                    SLTSTA_DLLSC);
+    slot_ack(qts, 0, TP_DEVFN, exp);
+
+    set_tunnel(qts, "up");
+    qtest_clock_step(qts, 300 * 1000 * 1000);   /* past settle-ms */
+    g_assert_cmpuint(wait_stage(qts, "inserted"), ==, 2);
+    g_assert(link_active(qts, 0, TP_DEVFN, exp));
+    g_assert_cmphex(slot_status(qts, 0, TP_DEVFN, exp) & SLTSTA_DLLSC, ==,
+                    SLTSTA_DLLSC);
+    qtest_quit(qts);
+    unlink(img);
+}
+
+#define SLTCTL_PWR_IND_OFF 0x0300u
+#define SLTCTL_PCC      (1u << 10)
+#define SLTSTA_ABP      (1u << 0)
+
+/* Bitmask of the asserted q35 PIRQ inputs (IOAPIC GSIs 16 to 23). */
+static unsigned pirq_level(QTestState *qts)
+{
+    unsigned m = 0;
+
+    for (int i = 0; i < 8; i++) {
+        m |= qtest_get_irq(qts, 16 + i) << i;
+    }
+    return m;
+}
+
+/*
+ * The tunnel root port without MSI signals its hot-plug interrupt on
+ * INTx (PCIe Base 4.0 6.7.3.4), a level that follows the pending,
+ * enabled slot events. With only HPIE and DLLSCE enabled it goes up on
+ * insertion, surprise removal and reinsertion, and down when the guest
+ * clears DLLSC.
+ *
+ * Then the already-pending path: an orderly removal (eject request, the
+ * guest powers the slot off) leaves Attention Button Pressed and
+ * Presence Detect Changed set and reports no link change. A reinsertion
+ * that finds both still pending has no new presence event to signal,
+ * but the link coming up is new, and that alone must raise the line.
+ */
+static void test_port_dllsc_intx(void)
+{
+    g_autofree char *img = make_img();
+    QTestState *qts;
+    unsigned line;
+    int exp;
+
+    qts = qtest_initf("-machine q35 "
+                      "-global ICH9-LPC.acpi-pci-hotplug-with-bridge-support=off "
+                      "-drive if=none,id=disk0,file=%s,format=raw "
+                      "-device usb4-tunnel-port,id=tp0,bus=pcie.0,addr=0x3,"
+                      "chassis=1,nvme-drive=disk0,nvme-serial=QTL,"
+                      "settle-ms=200,orderly-admin-down=on", img);
+    qtest_irq_intercept_in(qts, "ioapic");
+    exp = find_exp_cap(qts);
+    cfg_writel(qts, 0, TP_DEVFN, 0x18, 0x00010100);
+    slot_link_irq_only(qts, 0, TP_DEVFN, exp);
+    g_assert_cmphex(pirq_level(qts), ==, 0);
+
+    set_tunnel(qts, "up");
+    g_assert_cmpuint(wait_stage(qts, "inserted"), ==, 1);
+    line = pirq_level(qts);
+    g_assert_cmphex(line, !=, 0);
+    g_assert_cmphex(line & (line - 1), ==, 0);      /* one INTx line */
+    slot_ack(qts, 0, TP_DEVFN, exp);
+    g_assert_cmphex(pirq_level(qts), ==, 0);
+
+    set_tunnel(qts, "surprise");
+    g_assert_cmpuint(wait_stage(qts, "removed"), ==, 1);
+    g_assert_cmphex(pirq_level(qts), ==, line);
+    slot_ack(qts, 0, TP_DEVFN, exp);
+    g_assert_cmphex(pirq_level(qts), ==, 0);
+
+    set_tunnel(qts, "up");
+    qtest_clock_step(qts, 300 * 1000 * 1000);   /* past settle-ms */
+    g_assert_cmpuint(wait_stage(qts, "inserted"), ==, 2);
+    g_assert_cmphex(pirq_level(qts), ==, line);
+    slot_ack(qts, 0, TP_DEVFN, exp);
+    g_assert_cmphex(pirq_level(qts), ==, 0);
+
+    /* orderly removal: the guest answers the eject by powering off */
+    set_tunnel(qts, "down");
+    g_assert_cmpuint(wait_stage(qts, "eject-requested"), ==, 2);
+    g_assert_cmphex(slot_status(qts, 0, TP_DEVFN, exp) & SLTSTA_ABP, ==,
+                    SLTSTA_ABP);
+    g_assert_cmphex(pirq_level(qts), ==, 0);        /* ABPE is off */
+    cfg_writel(qts, 0, TP_DEVFN, exp + 0x18, SLTCTL_PWR_IND_OFF |
+               SLTCTL_PCC | SLTCTL_HPIE | SLTCTL_DLLSCE);
+    g_assert_cmpuint(wait_stage(qts, "removed"), ==, 2);
+    g_assert(!link_active(qts, 0, TP_DEVFN, exp));
+    g_assert_cmphex(slot_status(qts, 0, TP_DEVFN, exp) &
+                    (SLTSTA_ABP | SLTSTA_PDC | SLTSTA_DLLSC), ==,
+                    SLTSTA_ABP | SLTSTA_PDC);
+    g_assert_cmphex(pirq_level(qts), ==, 0);
+
+    /* slot powered again, PDC and ABP left pending: the link change */
+    slot_link_irq_only(qts, 0, TP_DEVFN, exp);
+    g_assert_cmphex(pirq_level(qts), ==, 0);
+    set_tunnel(qts, "up");
+    qtest_clock_step(qts, 300 * 1000 * 1000);   /* past settle-ms */
+    g_assert_cmpuint(wait_stage(qts, "inserted"), ==, 3);
+    g_assert(link_active(qts, 0, TP_DEVFN, exp));
+    g_assert_cmphex(slot_status(qts, 0, TP_DEVFN, exp) & SLTSTA_DLLSC, ==,
+                    SLTSTA_DLLSC);
+    g_assert_cmphex(pirq_level(qts), ==, line);
+    slot_ack(qts, 0, TP_DEVFN, exp);
+    g_assert_cmphex(pirq_level(qts), ==, 0);
+    qtest_quit(qts);
+    unlink(img);
+}
+
+#define DSP_DEVFN       (1 << 3)
+#define DSP_MSI         0x70        /* xio3130 MSI capability */
+#define DSP_EXP         0x90        /* xio3130 PCI Express capability */
+#define MSI_ADDR        0x00200000u /* guest RAM: catches the MSI write */
+#define MSI_DATA        0x4242u
+
+/*
+ * Point the chained DSP's MSI at guest RAM and enable bus mastering on
+ * the path up (tunnel port, switch upstream port, DSP): a hot-plug
+ * interrupt then shows up as MSI_DATA at MSI_ADDR.
+ */
+static void dsp_msi_to_ram(QTestState *qts)
+{
+    uint32_t cmd;
+
+    cmd = cfg_readl(qts, 0, TP_DEVFN, 0x04) & 0xffff;
+    cfg_writel(qts, 0, TP_DEVFN, 0x04, cmd | 0x4);
+    cmd = cfg_readl(qts, 1, 0, 0x04) & 0xffff;
+    cfg_writel(qts, 1, 0, 0x04, cmd | 0x4);
+    cmd = cfg_readl(qts, 2, DSP_DEVFN, 0x04) & 0xffff;
+    cfg_writel(qts, 2, DSP_DEVFN, 0x04, cmd | 0x4);
+    g_assert_cmphex(cfg_readl(qts, 2, DSP_DEVFN, DSP_MSI) & 0xff, ==, 0x05);
+    cfg_writel(qts, 2, DSP_DEVFN, DSP_MSI + 4, MSI_ADDR);
+    cfg_writel(qts, 2, DSP_DEVFN, DSP_MSI + 8, 0);      /* 64-bit address */
+    cfg_writel(qts, 2, DSP_DEVFN, DSP_MSI + 12, MSI_DATA);
+    cfg_writel(qts, 2, DSP_DEVFN, DSP_MSI,
+               (cfg_readl(qts, 2, DSP_DEVFN, DSP_MSI) & 0xffff) | (1u << 16));
+    qtest_writel(qts, MSI_ADDR, 0);
+}
+
+/*
+ * Count the DSP's MSI writes step by step: before each step the message
+ * data gets a value of its own (MSI_DATA plus a sequence number) and the
+ * target is cleared, so a message seen after the step was written in
+ * it, not left over from an earlier one. dsp_msi_written() returns the
+ * number of messages the step wrote (0 or 1: a step is one slot event).
+ */
+static unsigned dsp_msi_seq;
+
+static void dsp_msi_arm(QTestState *qts)
+{
+    dsp_msi_seq++;
+    cfg_writel(qts, 2, DSP_DEVFN, DSP_MSI + 12, MSI_DATA + dsp_msi_seq);
+    qtest_writel(qts, MSI_ADDR, 0);
+}
+
+static unsigned dsp_msi_written(QTestState *qts)
+{
+    uint32_t v = qtest_readl(qts, MSI_ADDR) & 0xffff;
+
+    g_assert(v == 0 || v == MSI_DATA + dsp_msi_seq);
+    return v != 0;
+}
+
+/*
+ * The same on a usb4-tunnel-dsp of a device router, checked down to the
+ * interrupt: with only HPIE and DLLSCE enabled, insertion, surprise
+ * removal and reinsertion each raise the slot's MSI, as a distinct
+ * write. MSI is sent on the transition to an interrupt being pending
+ * (PCIe Base 4.0 6.7.3.4): an acknowledgment sends nothing, and neither
+ * does a link change while DLLSC is still pending.
+ */
+static void test_chain_dsp_dllsc_insert(void)
+{
+    g_autofree char *img = make_img();
+    QTestState *qts = switch_start(img);
+    unsigned msgs = 0;
+
+    g_assert_cmphex(cfg_readl(qts, 2, DSP_DEVFN, DSP_EXP) & 0xff, ==, 0x10);
+    dsp_msi_seq = 0;
+    dsp_msi_to_ram(qts);
+    dsp_msi_arm(qts);
+    slot_link_irq_only(qts, 2, DSP_DEVFN, DSP_EXP);
+    g_assert_cmpuint(dsp_msi_written(qts), ==, 0);
+
+    dsp_msi_arm(qts);
+    dsp_set_tunnel(qts, "up");
+    g_assert_cmpuint(wait_stage(qts, "inserted"), ==, 1);
+    g_assert(link_active(qts, 2, DSP_DEVFN, DSP_EXP));
+    g_assert_cmphex(slot_status(qts, 2, DSP_DEVFN, DSP_EXP) & SLTSTA_DLLSC,
+                    ==, SLTSTA_DLLSC);
+    msgs += dsp_msi_written(qts);
+    g_assert_cmpuint(msgs, ==, 1);
+    dsp_msi_arm(qts);
+    slot_ack(qts, 2, DSP_DEVFN, DSP_EXP);
+    g_assert_cmpuint(dsp_msi_written(qts), ==, 0);
+
+    dsp_msi_arm(qts);
+    dsp_set_tunnel(qts, "surprise");
+    g_assert_cmpuint(wait_stage(qts, "removed"), ==, 1);
+    g_assert(!link_active(qts, 2, DSP_DEVFN, DSP_EXP));
+    g_assert_cmphex(slot_status(qts, 2, DSP_DEVFN, DSP_EXP) & SLTSTA_DLLSC,
+                    ==, SLTSTA_DLLSC);
+    msgs += dsp_msi_written(qts);
+    g_assert_cmpuint(msgs, ==, 2);
+
+    /* reinsertion with the removal's DLLSC still pending: no new MSI */
+    dsp_msi_arm(qts);
+    dsp_set_tunnel(qts, "up");
+    qtest_clock_step(qts, 2500ll * 1000 * 1000);   /* past settle-ms */
+    g_assert_cmpuint(wait_stage(qts, "inserted"), ==, 2);
+    g_assert(link_active(qts, 2, DSP_DEVFN, DSP_EXP));
+    g_assert_cmphex(slot_status(qts, 2, DSP_DEVFN, DSP_EXP) & SLTSTA_DLLSC,
+                    ==, SLTSTA_DLLSC);
+    g_assert_cmpuint(dsp_msi_written(qts), ==, 0);
+    dsp_msi_arm(qts);
+    slot_ack(qts, 2, DSP_DEVFN, DSP_EXP);
+    g_assert_cmpuint(dsp_msi_written(qts), ==, 0);
+
+    /* with everything acknowledged the next link change interrupts */
+    dsp_msi_arm(qts);
+    dsp_set_tunnel(qts, "surprise");
+    g_assert_cmpuint(wait_stage(qts, "removed"), ==, 2);
+    g_assert_cmphex(slot_status(qts, 2, DSP_DEVFN, DSP_EXP) & SLTSTA_DLLSC,
+                    ==, SLTSTA_DLLSC);
+    msgs += dsp_msi_written(qts);
+    g_assert_cmpuint(msgs, ==, 3);
+    qtest_quit(qts);
+    unlink(img);
+}
+
+/*
+ * A surprise removal the guest never acknowledged leaves DLLSC (and
+ * PDC) pending; a secondary bus reset above the DSP resets its slot and
+ * clears every slot event, the link change included (PCIe Base 4.0
+ * 7.5.3.11: RW1C status bits default to 0).
+ */
+static void test_chain_dsp_dllsc_reset(void)
+{
+    g_autofree char *img = make_img();
+    QTestState *qts = switch_start(img);
+
+    slot_link_irq_only(qts, 2, DSP_DEVFN, DSP_EXP);
+    dsp_set_tunnel(qts, "up");
+    g_assert_cmpuint(wait_stage(qts, "inserted"), ==, 1);
+    slot_ack(qts, 2, DSP_DEVFN, DSP_EXP);
+    dsp_set_tunnel(qts, "surprise");
+    g_assert_cmpuint(wait_stage(qts, "removed"), ==, 1);
+    g_assert_cmphex(slot_status(qts, 2, DSP_DEVFN, DSP_EXP) &
+                    (SLTSTA_DLLSC | SLTSTA_PDC), ==,
+                    SLTSTA_DLLSC | SLTSTA_PDC);
+
+    chain_sbr(qts);
+    g_assert_cmphex(slot_status(qts, 2, DSP_DEVFN, DSP_EXP) & SLTSTA_EVENTS,
+                    ==, 0);
+    qtest_quit(qts);
+    unlink(img);
+}
+
+static void dev_del(QTestState *qts, const char *id)
+{
+    qtest_qmp_assert_success(qts, "{'execute': 'device_del', 'arguments': "
+                             "{'id': %s}}", id);
+}
+
+static char *qom_get_str(QTestState *qts, const char *path,
+                         const char *prop)
+{
+    QDict *rsp = qtest_qmp(qts, "{'execute': 'qom-get', 'arguments': "
+                           "{'path': %s, 'property': %s}}", path, prop);
+    char *v = g_strdup(qdict_get_str(rsp, "return"));
+
+    qobject_unref(rsp);
+    return v;
+}
+
+/*
+ * A switch downstream port (usb4-tunnel-dsp) whose removal was held
+ * while its usb4-device was deleted and re-created with the same id on
+ * another host port must not unregister the replacement's tunnel target.
+ */
+static void test_chain_stale_dsp(void)
+{
+    g_autofree char *img = make_img();
+    g_autofree char *img1 = make_img();
+    QTestState *qts;
+    char *v;
+
+    qts = qtest_initf("-machine q35 "
+                      "-global ICH9-LPC.acpi-pci-hotplug-with-bridge-support=off "
+                      "-drive if=none,id=disk0,file=%s,format=raw "
+                      "-drive if=none,id=disk1,file=%s,format=raw "
+                      "-device usb4-tunnel-port,id=tp0,bus=pcie.0,addr=0x3,"
+                      "chassis=1,settle-ms=200 "
+                      "-device usb4-tunnel-port,id=tp1,bus=pcie.0,addr=0x5,"
+                      "chassis=2,settle-ms=200 "
+                      "-device usb4-host,id=u4,bus=pcie.0,addr=0x4,"
+                      "tunnel-port=tp0,tunnel-port2=tp1 "
+                      "-device usb4-device,id=X,bus=u4.0,port=1,"
+                      "drive=disk0,serial=QTS,downstream-ports=1", img, img1);
+
+    cfg_writel(qts, 0, TP_DEVFN, 0x18, 0x00050100);
+    cfg_writel(qts, 0, TP_DEVFN, find_exp_cap(qts) + 0x18, 0x0100);
+    set_tunnel(qts, "up");
+    g_assert_cmpuint(wait_stage(qts, "inserted"), ==, 1);
+    v = qom_get_str(qts, "/machine/peripheral/X", "x-pcie-down");
+    g_assert_cmpstr(v, ==, "/machine/peripheral/tp0-sw1-usb4dp1");
+    g_free(v);
+
+    /*
+     * tp0's switch stays (held) while X moves to host port 2, with another
+     * drive: the held endpoint still owns disk0.
+     */
+    set_hold(qts, true);
+    set_tunnel(qts, "surprise");
+    g_assert_cmpuint(wait_stage(qts, "gated"), ==, 1);
+    dev_del(qts, "X");
+    qtest_qmp_assert_success(qts, "{'execute': 'device_add', 'arguments': "
+                             "{'driver': 'usb4-device', 'id': 'X', "
+                             "'bus': 'u4.0', 'port': 2, 'drive': 'disk1', "
+                             "'serial': 'QTS', 'downstream-ports': 1}}");
+    qtest_qmp_assert_success(qts, "{'execute': 'qom-set', 'arguments': "
+                             "{'path': '/machine/peripheral/tp1', "
+                             "'property': 'tunnel', 'value': 'up'}}");
+    g_assert_cmpuint(wait_stage(qts, "inserted"), ==, 1);
+    v = qom_get_str(qts, "/machine/peripheral/X", "x-pcie-down");
+    g_assert_cmpstr(v, ==, "/machine/peripheral/tp1-sw1-usb4dp1");
+    g_free(v);
+
+    /* The old switch goes; the replacement keeps its registration. */
+    set_hold(qts, false);
+    g_assert_cmpuint(wait_stage(qts, "removed"), ==, 1);
+    g_assert(!peripheral_exists(qts, "tp0-sw1-usb4dp1"));
+    v = qom_get_str(qts, "/machine/peripheral/X", "x-pcie-down");
+    g_assert_cmpstr(v, ==, "/machine/peripheral/tp1-sw1-usb4dp1");
+    g_free(v);
+
+    qtest_quit(qts);
+    unlink(img);
+    unlink(img1);
+}
