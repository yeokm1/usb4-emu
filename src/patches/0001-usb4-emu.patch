+/* Wait for USB4_TUNNEL_ENDPOINT stage @a or @b; true for @a. */
+static bool wait_stage2(QTestState *qts, const char *a, const char *b)
+{
+    for (;;) {
+        QDict *ev = qtest_qmp_eventwait_ref(qts, "USB4_TUNNEL_ENDPOINT");
+        const char *st = qdict_get_str(qdict_get_qdict(ev, "data"), "stage");
+        bool is_a = !strcmp(st, a), is_b = !strcmp(st, b);
+
+        qobject_unref(ev);
+        if (is_a || is_b) {
+            return is_a;
+        }
+    }
+}
