+/* Hook 4: RDY set and clear delays, SHST delay, CFS, hung controller. */
+static void test_timing(void)
+{
+    g_autofree char *img = make_img();
+    Nv nv;
+    QTestState *qts = tp_start(img, ",x-rdy-set-delay-ms=2000,"
+                               "x-rdy-clear-delay-ms=50,x-marker-doorbell="
+                               "0x1ff8", "", &nv);
+
+    /* RDY set 2 s after CC.EN=1. */
+    nv_enable(&nv);
+    g_assert_cmphex(nv_csts(&nv), ==, 0);
+    qtest_clock_step(qts, 1999 * 1000 * 1000ll);
+    g_assert_cmphex(nv_csts(&nv), ==, 0);
+    qtest_clock_step(qts, 2 * 1000 * 1000);
+    g_assert_cmphex(nv_csts(&nv), ==, 1);
+
+    /* RDY clears 50 ms after CC.EN=0. */
+    qtest_writel(qts, WIN_MEM + NVME_CC, 0);
+    g_assert_cmphex(nv_csts(&nv), ==, 1);
+    qtest_clock_step(qts, 50 * 1000 * 1000);
+    g_assert_cmphex(nv_csts(&nv), ==, 0);
+
+    /* Never: RDY set never, then (re-enabled) never clears. */
+    qom_set_int(qts, TP_PATH, "x-rdy-set-delay-ms", -1);
+    nv_enable(&nv);
+    qtest_clock_step(qts, 10 * 1000 * 1000 * 1000ll);
+    g_assert_cmphex(nv_csts(&nv), ==, 0);
+    qom_set_int(qts, TP_PATH, "x-rdy-set-delay-ms", 0);
+    g_assert_cmphex(nv_csts(&nv), ==, 1);
+    qom_set_int(qts, TP_PATH, "x-rdy-clear-delay-ms", -1);
+    qtest_writel(qts, WIN_MEM + NVME_CC, 0);
+    qtest_clock_step(qts, 10 * 1000 * 1000 * 1000ll);
+    g_assert_cmphex(nv_csts(&nv), ==, 1);
+    qom_set_int(qts, TP_PATH, "x-rdy-clear-delay-ms", 0);
+    g_assert_cmphex(nv_csts(&nv), ==, 0);
+
+    /* Shutdown: SHST reads "occurring" for 100 ms. */
+    qom_set_int(qts, TP_PATH, "x-shst-delay-ms", 100);
+    nv_enable(&nv);
+    qtest_writel(qts, WIN_MEM + NVME_CC, NVME_CC_ON | (1 << 14));
+    g_assert_cmphex((nv_csts(&nv) >> 2) & 3, ==, 1);
+    qtest_clock_step(qts, 100 * 1000 * 1000);
+    g_assert_cmphex((nv_csts(&nv) >> 2) & 3, ==, 2);
+
+    /* CFS on demand. */
+    qom_set_bool(qts, TP_PATH, "x-cfs", true);
+    g_assert_cmphex(nv_csts(&nv) & 2, ==, 2);
+    qom_set_bool(qts, TP_PATH, "x-cfs", false);
+    g_assert_cmphex(nv_csts(&nv) & 2, ==, 0);
+
+    /* Marker doorbell: traced and dropped (no invalid-doorbell event). */
+    qtest_writel(qts, WIN_MEM + 0x1ff8, 0x1234);
+    g_assert(str_has(qts, TP_PATH, "x-harness-state", "markers=1"));
+
+    /* Hung, stuck: CSTS frozen, writes dropped; config still answers. */
+    qtest_writel(qts, WIN_MEM + NVME_CC, 0);
+    nv_enable(&nv);
+    g_assert_cmphex(nv_csts(&nv), ==, 1);
+    qom_set_str(qts, TP_PATH, "x-hang", "stuck");
+    qtest_writel(qts, WIN_MEM + NVME_CC, 0);
+    g_assert_cmphex(nv_csts(&nv), ==, 1);
+    g_assert_cmphex(cfg_readl(qts, 1, 0, 0), ==, 0x00101b36);
+    /* Hung, all-ones MMIO. */
+    qom_set_str(qts, TP_PATH, "x-hang", "ones");
+    g_assert_cmphex(nv_csts(&nv), ==, 0xffffffff);
+    g_assert_cmphex(qtest_readl(qts, WIN_MEM + 0x8), ==, 0xffffffff);
+    g_assert_cmphex(cfg_readl(qts, 1, 0, 0), ==, 0x00101b36);
+    qom_set_str(qts, TP_PATH, "x-hang", "off");
+    g_assert_cmphex(qtest_readl(qts, WIN_MEM + NVME_CC), ==, NVME_CC_ON);
+    qtest_quit(qts);
+    unlink(img);
+}
