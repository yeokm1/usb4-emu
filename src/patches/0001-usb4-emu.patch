+static void test_crc(void)
+{
+    /* Spec Appendix A.2 Table A-1 */
+    static const uint32_t ex1[] = { 0, 0, 0x04002000 };
+    static const uint32_t ex2[] = { 0x80000000, 0, 0x04282000, 0x15788086 };
+    uint8_t b[16];
+
+    for (int i = 0; i < 3; i++) {
+        usb4_put_be32(b + 4 * i, ex1[i]);
+    }
+    CHECK(usb4_crc32c(b, 12) == 0x2FC967AC, "A.2 example 1 %08x",
+          usb4_crc32c(b, 12));
+    for (int i = 0; i < 4; i++) {
+        usb4_put_be32(b + 4 * i, ex2[i]);
+    }
+    CHECK(usb4_crc32c(b, 16) == 0x5A9B0181, "A.2 example 2 %08x",
+          usb4_crc32c(b, 16));
+
+    /* DROM spec Appendix B.1 example: CRC32 0303D4F4h over 102 bytes */
+    static const char *const lines[] = {
+        "03", "0066", "C702", "C802", "4100008D05", "4100008E05",
+        "00726F646E657620636972656E65670111",
+        "006C65646F6D20636972656E65670210", "090803",
+        "04000000080012000980870410090F",
+        "003400330032003100" "2D00440043004204090A14",
+        "0000049383039282029181010B0E",
+    };
+    uint8_t drom[128];
+    size_t n = 0;
+    for (unsigned i = 0; i < ARRAY_SIZE(lines); i++) {
+        uint8_t tmp[32];
+        size_t k = 0;
+        for (const char *s = lines[i]; *s; s++) {
+            unsigned v;
+            if (*s == ' ') {
+                continue;
+            }
+            sscanf(s, "%2x", &v);
+            tmp[k++] = v;
+            s++;
+        }
+        while (k) {
+            drom[n++] = tmp[--k];      /* listed most significant first */
+        }
+    }
+    CHECK(n == 102, "DROM example length %zu", n);
+    CHECK(usb4_drom_crc32(drom, n) == 0x0303D4F4, "DROM example CRC %08x",
+          usb4_drom_crc32(drom, n));
+    /* DROM spec Appendix B.2 example: CRC8 93h over the UUID bytes */
+    static const uint8_t uuid[] = { 0x00, 0xbc, 0xfd, 0x45, 0x76, 0x1f,
+                                    0x87, 0x80 };
+    CHECK(usb4_drom_crc8(uuid, 8) == 0x93, "DROM CRC8 %02x",
+          usb4_drom_crc8(uuid, 8));
+}
+
+static void test_evaluator(void)
+{
+    USB4TunnelInputs in = { true, true, true, true, true, true, true, true,
+                            true };
+    bool *f = (bool *)&in;
+
+    CHECK(usb4_tunnel_evaluate(&in) == USB4_TUNNEL_UP, "all inputs");
+    for (unsigned i = 0; i < sizeof(in) / sizeof(bool); i++) {
+        USB4TunnelInputs t = in;
+        ((bool *)&t)[i] = false;
+        CHECK(usb4_tunnel_evaluate(&t) == USB4_TUNNEL_DOWN, "input %u", i);
+    }
+    (void)f;
+}
