+/*
+ * The P14s switch with the NHI at 3:0.0 and the xHCI at 5:0.0 (buses as
+ * in test_power_mmio(), xHCI DSP 2:2.0 -> bus 5), and the given device.
+ */
+static QTestState *switch_start(const char *host_opts, const char *dev)
+{
+    QTestState *qts = qtest_initf(
+        "-machine q35 -global ICH9-LPC.acpi-pci-hotplug-with-bridge-"
+        "support=off -drive if=none,id=disk0,file=null-co://,format=raw "
+        "-device usb4-tunnel-port,id=tbrp,bus=pcie.0,addr=1c.0,chassis=1,"
+        "usb4-dvsec=off "
+        "-device usb4-tb3-usp,id=tbusp,bus=tbrp "
+        "-device usb4-tb3-dsp,id=tbd0,bus=tbusp,addr=0.0,chassis=2,slot=0 "
+        "-device usb4-tb3-tunnel-dsp,id=tp0,bus=tbusp,addr=1.0,chassis=3,"
+        "slot=1 "
+        "-device usb4-tb3-dsp,id=tbd2,bus=tbusp,addr=2.0,chassis=4,slot=2 "
+        "-device usb4-host,id=u4,bus=tbd0,tunnel-port=tp0,xhci=tbx,"
+        "profile=tb3-alpine-ridge%s "
+        "-device usb4-tb3-xhci,id=tbx,bus=tbd2,addr=0.0 "
+        "-device usb4-device,id=d0,bus=u4.0,port=1,drive=disk0,%s",
+        host_opts, dev);
+
+    cfg_wr(qts, 0, RP_DEVFN, 0x18, 0x00050100);
+    cfg_wr(qts, 1, 0, 0x18, 0x00050201);
+    cfg_wr(qts, 2, QPCI_DEVFN(0, 0), 0x18, 0x00030302);
+    cfg_wr(qts, 2, QPCI_DEVFN(1, 0), 0x18, 0x00040402);
+    cfg_wr(qts, 2, QPCI_DEVFN(2, 0), 0x18, 0x00050502);
+    return qts;
+}
