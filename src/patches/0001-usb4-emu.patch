+/* T8: adapter layout of the 4C and 2C host routers */
+static void test_adapters(void)
+{
+    static const struct {
+        unsigned adp;
+        uint32_t type4c, type2c;    /* port dword 2, 0 = absent */
+    } exp[] = {
+        { 1, 0x01000001, 0x01000001 },
+        { 2, 0x01000001, 0x01000001 },
+        { 3, 0x01000001, 0 },
+        { 4, 0x01000001, 0 },
+        { 6, 0, 0 },
+        { 7, 0, 0 },
+        { 8, 0x01100101, 0x01100101 },
+        { 9, 0x01100101, 0 },
+        { 10, 0x010e0101, 0x010e0101 },
+        { 11, 0x010e0101, 0 },
+    };
+
+    for (int c = 0; c < 2; c++) {
+        T *t = t_start(c ? ",ports=1" : NULL, false);
+        uint32_t v;
+
+        rings_setup(t);
+        for (unsigned i = 0; i < ARRAY_SIZE(exp); i++) {
+            uint32_t want = c ? exp[i].type2c : exp[i].type4c;
+            unsigned pdf = cfg_read(t, 0, 1, exp[i].adp, 2, &v);
+
+            if (want) {
+                g_assert_cmpuint(pdf, ==, PDF_READ);
+                g_assert_cmphex(v, ==, want);
+            } else {
+                /* not implemented: error packet (ICM-PROTOCOL.md 5) */
+                g_assert_cmpuint(pdf, ==, PDF_ERROR);
+            }
+        }
+        /*
+         * NHI adapter 5: present but not NHI-typed without the DMA port
+         * (ARCHITECTURE.md 4.2 deviation, shared with Alpine Ridge).
+         */
+        g_assert_cmpuint(cfg_read(t, 0, 1, 5, 2, &v), ==, PDF_READ);
+        g_assert_cmphex(v & 0xffffff, ==, 0);
+        t_stop(t);
+    }
+}
