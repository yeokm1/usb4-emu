+/*
+ * tb3-alpine-ridge, ICM-PROTOCOL.md R7: with the Intel auto-clear bit set
+ * (DMA misc bit 2, set by the client), sending a ring's MSI-X message
+ * clears the ring's status bit. That includes the message the MSI-X core
+ * sends by itself when a vector with a pending message is unmasked.
+ */
+static void test_msix_autoclear_pending(void)
+{
+    T *t = t_start("pc", ",profile=tb3-alpine-ridge");
+    const uint32_t rx0 = 1u << 12;          /* 12 paths: RX ring 0 */
+    uint64_t msg = guest_alloc(&t->alloc, 4);
+    uint32_t e1;
+
+    qpci_msix_enable(t->dev);
+    e1 = t->dev->msix_table_off + 16;
+    qpci_io_writel(t->dev, t->dev->msix_table_bar, e1, (uint32_t)msg);
+    qpci_io_writel(t->dev, t->dev->msix_table_bar, e1 + 4, msg >> 32);
+    qpci_io_writel(t->dev, t->dev->msix_table_bar, e1 + 8, 0x1234);
+    qpci_io_writel(t->dev, t->dev->msix_table_bar, e1 + 12, 1); /* masked */
+    wr(t, IVAR0 + 4, 1u << 16);             /* cause 12 -> vector 1 */
+    wr(t, 0x39864, 0x01000016);             /* DMA misc auto-clear (R7) */
+    wr(t, IMS0, rx0);
+    rings_setup(t, 8, 8);
+    rx_post(t, 2);
+    qtest_writel(t->qts, msg, 0);
+    tx_queue(t, 0x5150, 8, 1);
+    tx_doorbell(t);
+    g_assert_cmpuint(rx_pi(t), ==, 1);
+    g_assert_cmphex(qtest_readl(t->qts, msg), ==, 0);       /* pending */
+
+    /* Unmask: the pending message goes out and clears the status. */
+    qpci_io_writel(t->dev, t->dev->msix_table_bar, e1 + 12, 0);
+    g_assert_cmphex(qtest_readl(t->qts, msg), ==, 0x1234);
+    g_assert_cmphex(isr0(t) & rx0, ==, 0);
+    t_stop(t);
+}
+
+/*
+ * Interrupt Throttling Rate (Spec Table 12-34): the minimal and asm4242
+ * hosts store writes (no ASM4242 throttle data); intel-adl follows the
+ * captured hardware, whose Interval reads 0x1f4 regardless of writes
+ * (CAPTURE-VS-LINUX.md ADL-10, C1), unless itr-fixed=off.
+ */
+static void test_itr(void)
+{
+    T *t = t_start("pc", NULL);
+
+    g_assert_cmphex(rd(t, ITR0), ==, 0);
+    wr(t, ITR0 + 4, 0x00000123);
+    g_assert_cmphex(rd(t, ITR0 + 4), ==, 0x123);
+    t_stop(t);
+
+    t = t_start("pc", ",host-model=intel-adl");
+    for (unsigned v = 0; v < 16; v++) {
+        g_assert_cmphex(rd(t, ITR0 + 4 * v), ==, 0x1f4);
+    }
+    wr(t, ITR0, 0);
+    wr(t, ITR0 + 4, 0xffffffff);
+    g_assert_cmphex(rd(t, ITR0), ==, 0x1f4);
+    g_assert_cmphex(rd(t, ITR0 + 4), ==, 0x1f4);
+    t_stop(t);
+
+    t = t_start("pc", ",host-model=intel-adl,itr-fixed=off");
+    wr(t, ITR0, 0);
+    g_assert_cmphex(rd(t, ITR0), ==, 0);
+    t_stop(t);
+
+    t = t_start("pc", ",itr-fixed=on");
+    wr(t, ITR0, 0);
+    g_assert_cmphex(rd(t, ITR0), ==, 0x1f4);
+    t_stop(t);
+
+    t = t_start("pc", ",host-model=asm4242");
+    g_assert_cmphex(rd(t, ITR0), ==, 0);
+    wr(t, ITR0 + 4, 0x00000123);
+    g_assert_cmphex(rd(t, ITR0 + 4), ==, 0x123);
+    t_stop(t);
+}
+
+/*
+ * intel-adl with intel-autoclear=on (CAPTURE-VS-LINUX.md ADL-8): while
+ * the guest sets Host Interface Control bit 2, sending a cause's MSI-X
+ * message clears its status bit, as on the captured hardware. Reads are
+ * made non-destructive (Disable ISR Auto-Clear) so only delivery can
+ * clear. Default off: the bit is then vendor defined and ignored.
+ */
+static void adl_autoclear_case(const char *opts, bool clears)
+{
+    T *t = t_start("pc", opts);
+    const uint32_t rx0 = 1u << 12;          /* 12 paths: RX ring 0 */
+    uint64_t msg = guest_alloc(&t->alloc, 4);
+    uint8_t cap = qpci_find_capability(t->dev, PCI_CAP_ID_MSIX, 0);
+    uint32_t e1;
+
+    /* MSI-X table in BAR0, as test_msix() */
+    e1 = (qpci_config_readl(t->dev, cap + PCI_MSIX_TABLE) &
+          ~PCI_MSIX_FLAGS_BIRMASK) + 16;
+    wr(t, e1 + PCI_MSIX_ENTRY_LOWER_ADDR, (uint32_t)msg);
+    wr(t, e1 + PCI_MSIX_ENTRY_UPPER_ADDR, msg >> 32);
+    wr(t, e1 + PCI_MSIX_ENTRY_DATA, 0x1234);
+    wr(t, e1 + PCI_MSIX_ENTRY_VECTOR_CTRL, 0);
+    qpci_config_writew(t->dev, cap + PCI_MSIX_FLAGS,
+                       qpci_config_readw(t->dev, cap + PCI_MSIX_FLAGS) |
+                       PCI_MSIX_FLAGS_ENABLE);
+    wr(t, IVAR0 + 4, 1u << 16);             /* cause 12 -> vector 1 */
+    wr(t, 0x39864, 0x01000016);             /* DMA misc auto-clear (R7) */
+    wr(t, IMS0, rx0);
+    wr(t, HI_CONTROL, DISABLE_ISR_AUTOCLR | (1u << 2));
+    /* Spec Table 12-30: ISS raises the cause as if it occurred */
+    qtest_writel(t->qts, msg, 0);
+    wr(t, ISS0, rx0);
+    g_assert_cmphex(qtest_readl(t->qts, msg), ==, 0x1234);
+    g_assert_cmphex(isr0(t) & rx0, ==, clears ? 0 : rx0);
+
+    /* bit 2 clear: delivery never clears */
+    wr(t, ISC0, 0xffffffff);
+    wr(t, HI_CONTROL, DISABLE_ISR_AUTOCLR);
+    qtest_writel(t->qts, msg, 0);
+    wr(t, ISS0, rx0);
+    g_assert_cmphex(qtest_readl(t->qts, msg), ==, 0x1234);
+    g_assert_cmphex(isr0(t) & rx0, ==, rx0);
+    t_stop(t);
+}
+
+/* device_add of usb4-host must fail because of intel-autoclear=on */
+static void adl_autoclear_refused(QTestState *qts, const char *profile,
+                                  const char *model, unsigned ports)
+{
+    QDict *rsp = qtest_qmp(qts, "{'execute': 'device_add', 'arguments': "
+                           "{'driver': 'usb4-host', 'profile': %s, "
+                           "'host-model': %s, 'ports': %u, "
+                           "'intel-autoclear': true}}", profile, model, ports);
+    QDict *err = qdict_get_qdict(rsp, "error");
+
+    g_assert_nonnull(err);
+    g_assert_nonnull(strstr(qdict_get_str(err, "desc"), "intel-autoclear"));
+    qobject_unref(rsp);
+}
+
+static void test_adl_autoclear(void)
+{
+    QTestState *qts;
+
+    adl_autoclear_case(",host-model=intel-adl,intel-autoclear=on", true);
+    adl_autoclear_case(",host-model=intel-adl", false);
+
+    /*
+     * Only on usb4-generic with intel-adl. The TB3 profiles always apply
+     * R7, so the property would be ignored there: refuse it instead.
+     */
+    qts = qtest_init("-nodefaults -machine pc");
+    adl_autoclear_refused(qts, "usb4-generic", "minimal", 2);
+    adl_autoclear_refused(qts, "usb4-generic", "asm4242", 2);
+    adl_autoclear_refused(qts, "tb3-alpine-ridge", "minimal", 2);
+    adl_autoclear_refused(qts, "tb3-titan-ridge", "minimal", 2);
+    adl_autoclear_refused(qts, "tb3-titan-ridge", "minimal", 1);
+    qtest_quit(qts);
+}
+
+#define ADL_OPTS             ",host-model=intel-adl,intel-autoclear=on"
+#define ADL_TX0              (1u << 0)      /* 12 paths: TX ring 0 */
+#define ADL_RX0              (1u << 12)     /* 12 paths: RX ring 0 */
+#define ADL_AUTOCLR          (1u << 2)      /* Host Interface Control */
+
+/* Program MSI-X table entry @v (table in BAR0, as test_msix()). */
+static void msix_entry(T *t, unsigned v, uint64_t addr, uint32_t data,
+                       bool masked)
+{
+    uint8_t cap = qpci_find_capability(t->dev, PCI_CAP_ID_MSIX, 0);
+    uint32_t e = (qpci_config_readl(t->dev, cap + PCI_MSIX_TABLE) &
+                  ~PCI_MSIX_FLAGS_BIRMASK) + v * 16;
+
+    wr(t, e + PCI_MSIX_ENTRY_LOWER_ADDR, (uint32_t)addr);
+    wr(t, e + PCI_MSIX_ENTRY_UPPER_ADDR, addr >> 32);
+    wr(t, e + PCI_MSIX_ENTRY_DATA, data);
+    wr(t, e + PCI_MSIX_ENTRY_VECTOR_CTRL, masked);
+}
+
+/* One looped-back frame: completes TX ring 0 and RX ring 0. */
+static void adl_frame(T *t, uint32_t seed)
+{
+    tx_queue(t, seed, 8, 1);
+    tx_doorbell(t);
+    rx_expect(t, seed, 8, 1);
+    rx_post(t, 1);
+}
+
+/*
+ * ADL-8 auto-clear on descriptor completion, not only ISS: the RX ring 0
+ * completion's MSI-X message clears its status bit, while TX ring 0,
+ * routed to a masked vector, keeps its status (the message is pending)
+ * until the unmask delivers it. A cause masked in IMR sends nothing and
+ * keeps its status. Reads are non-destructive throughout.
+ */
+static void test_adl_autoclear_completion(void)
+{
+    T *t = t_start("pc", ADL_OPTS);
+    uint64_t msg = guest_alloc(&t->alloc, 8);
+    uint8_t cap = qpci_find_capability(t->dev, PCI_CAP_ID_MSIX, 0);
+
+    msix_entry(t, 0, msg, 0x1000, true);
+    msix_entry(t, 1, msg + 4, 0x1001, false);
+    qpci_config_writew(t->dev, cap + PCI_MSIX_FLAGS,
+                       qpci_config_readw(t->dev, cap + PCI_MSIX_FLAGS) |
+                       PCI_MSIX_FLAGS_ENABLE);
+    wr(t, IVAR0 + 4, 1u << 16);             /* cause 12 -> vector 1 */
+    wr(t, IMS0, ADL_TX0 | ADL_RX0);         /* cause 0 -> vector 0 */
+    wr(t, HI_CONTROL, DISABLE_ISR_AUTOCLR | ADL_AUTOCLR);
+    rings_setup(t, 8, 8);
+    rx_post(t, 4);
+    qtest_writel(t->qts, msg, 0);
+    qtest_writel(t->qts, msg + 4, 0);
+
+    adl_frame(t, 0x100);
+    g_assert_cmphex(qtest_readl(t->qts, msg + 4), ==, 0x1001);
+    g_assert_cmphex(qtest_readl(t->qts, msg), ==, 0);       /* pending */
+    g_assert_cmphex(isr0(t) & (ADL_TX0 | ADL_RX0), ==, ADL_TX0);
+    g_assert_cmphex(isr0(t) & (ADL_TX0 | ADL_RX0), ==, ADL_TX0);
+
+    /* unmask vector 0: the pending message goes out and clears TX0 */
+    msix_entry(t, 0, msg, 0x1000, false);
+    g_assert_cmphex(qtest_readl(t->qts, msg), ==, 0x1000);
+    g_assert_cmphex(isr0(t) & (ADL_TX0 | ADL_RX0), ==, 0);
+
+    /* RX0 masked in IMR: no message, the status stays for polling */
+    wr(t, IMC0, ADL_RX0);
+    qtest_writel(t->qts, msg, 0);
+    qtest_writel(t->qts, msg + 4, 0);
+    adl_frame(t, 0x200);
+    g_assert_cmphex(qtest_readl(t->qts, msg + 4), ==, 0);
+    g_assert_cmphex(qtest_readl(t->qts, msg), ==, 0x1000);
+    g_assert_cmphex(isr0(t) & (ADL_TX0 | ADL_RX0), ==, ADL_RX0);
+    /* unmasking it sends the message, which clears the status */
+    wr(t, IMS0, ADL_RX0);
+    g_assert_cmphex(qtest_readl(t->qts, msg + 4), ==, 0x1001);
+    g_assert_cmphex(isr0(t) & (ADL_TX0 | ADL_RX0), ==, 0);
+    t_stop(t);
+}
+
+/*
+ * ADL-8 is an MSI-X rule: with MSI or INTx delivery the status of a
+ * delivered cause is preserved even with Host Interface Control bit 2
+ * set, until the guest clears it (ISC, reads non-destructive).
+ */
+static void test_adl_autoclear_msi_intx(void)
+{
+    T *t = t_start("pc", ADL_OPTS);
+    uint8_t cap = qpci_find_capability(t->dev, PCI_CAP_ID_MSI, 0);
+    uint64_t target = guest_alloc(&t->alloc, 16);
+    QPCIDevice *piix;
+    uint16_t ctrl;
+
+    /* MSI to RAM, as test_msi() */
+    g_assert(cap);
+    ctrl = qpci_config_readw(t->dev, cap + PCI_MSI_FLAGS);
+    g_assert(ctrl & PCI_MSI_FLAGS_64BIT);
+    qpci_config_writel(t->dev, cap + PCI_MSI_ADDRESS_LO, (uint32_t)target);
+    qpci_config_writel(t->dev, cap + PCI_MSI_ADDRESS_HI, target >> 32);
+    qpci_config_writew(t->dev, cap + PCI_MSI_DATA_64, 0x4d53);
+    qpci_config_writew(t->dev, cap + PCI_MSI_FLAGS,
+                       ctrl | PCI_MSI_FLAGS_ENABLE);
+    wr(t, HI_CONTROL, DISABLE_ISR_AUTOCLR | ADL_AUTOCLR);
+    wr(t, IMS0, ADL_RX0);
+    rings_setup(t, 8, 8);
+    rx_post(t, 4);
+    qtest_writel(t->qts, target, 0);
+    adl_frame(t, 0x300);
+    g_assert_cmphex(qtest_readl(t->qts, target), ==, 0x4d53);
+    g_assert_cmphex(isr0(t) & ADL_RX0, ==, ADL_RX0);
+    g_assert_cmphex(isr0(t) & ADL_RX0, ==, ADL_RX0);
+    wr(t, ISC0, 0xffffffff);
+    t_stop(t);
+
+    /* INTx: slot 4 INTA# -> PIRQD -> IRQ 11, as test_intx() */
+    t = t_start("pc", ADL_OPTS);
+    piix = qpci_device_find(t->bus, QPCI_DEVFN(1, 0));
+    qpci_config_writeb(piix, 0x63, 11);
+    g_free(piix);
+    qtest_irq_intercept_in(t->qts, "ioapic");
+    wr(t, HI_CONTROL, DISABLE_ISR_AUTOCLR | ADL_AUTOCLR);
+    wr(t, IMS0, ADL_RX0);
+    rings_setup(t, 8, 8);
+    rx_post(t, 4);
+    g_assert(!qtest_get_irq(t->qts, 11));
+    adl_frame(t, 0x400);
+    g_assert(qtest_get_irq(t->qts, 11));
+    g_assert_cmphex(isr0(t) & ADL_RX0, ==, ADL_RX0);
+    g_assert(qtest_get_irq(t->qts, 11));
+    wr(t, ISC0, ADL_RX0);
+    g_assert(!qtest_get_irq(t->qts, 11));
+    t_stop(t);
+}
+
+static void test_polling(void)
+{
+    T *t = t_start("pc", ",msi=off,msix=off");
+    unsigned i, guard;
+
+    /* No interrupts anywhere: indices and DD bits alone drive the loop. */
+    rings_setup(t, 16, 16);
+    rx_post(t, 15);
+    for (i = 0; i < 40; i++) {
+        tx_queue(t, 0xc0de0000 + i * 8, 16, 2);
+        tx_doorbell(t);
+        for (guard = 0; guard < 100 && rx_pi(t) == t->rx_next; guard++) {
+            /* would spin */
+        }
+        g_assert_cmpuint(rx_pi(t), ==, (t->rx_next + 1) % 16);
+        rx_expect(t, 0xc0de0000 + i * 8, 16, 2);
+        g_assert_cmpuint(tx_ci(t), ==, t->tx_pi);
+        rx_post(t, 1);
+    }
+    t_stop(t);
+}
+
+static void test_ring_disable(void)
+{
+    T *t = t_start("pc", NULL);
+
+    rings_setup(t, 8, 8);
+    rx_post(t, 3);
+    wr(t, RX_CTRL(0), 0);
+    /* RX ring disabled: the looped-back frame is discarded (12.4.2) */
+    tx_queue(t, 1, 8, 1);
+    tx_doorbell(t);
+    g_assert_cmpuint(tx_ci(t), ==, 1);
+    g_assert_cmphex(desc_dw2(t, t->rx_ring, 0) & DESC_DD, ==, 0);
+    /* TX ring disabled: doorbell does nothing */
+    wr(t, TX_CTRL(0), 0);
+    tx_queue(t, 2, 8, 1);
+    tx_doorbell(t);
+    g_assert_cmpuint(tx_ci(t), ==, 0);
+    t_stop(t);
+}
+
+static void test_vacancy(void)
+{
+    T *t = t_start("pc", NULL);
+
+    /*
+     * Spec 12.5.1: threshold 0 means "no unused descriptors". An enabled
+     * RX ring with nothing posted reports vacancy and raises the cause.
+     */
+    rings_setup(t, 8, 8);
+    g_assert_cmphex(rd(t, 0x19400) & 1, ==, 1);
+    g_assert_cmphex(rd(t, ISR0 + 4) & 1, ==, 1);   /* cause 32 */
+    rx_post(t, 4);
+    g_assert_cmphex(rd(t, 0x19400) & 1, ==, 0);
+    /* Threshold 3: vacancy when unused <= 4 descriptors (Table 12-36) */
+    wr(t, 0x18c00, 3);
+    g_assert_cmphex(rd(t, 0x19400) & 1, ==, 1);
+    g_assert_cmphex(rd(t, ISR0 + 4) & 1, ==, 1);   /* cause 32 */
+    rx_post(t, 2);
+    g_assert_cmphex(rd(t, 0x19400) & 1, ==, 0);
+    t_stop(t);
+}
+
+static void test_hotplug(void)
+{
+    QTestState *qts = qtest_init("-nodefaults -machine pc "
+                                 "-device usb4-host,id=u4,addr=04.0 "
+                                 "-device usb4-device,id=d1,bus=u4.0,port=1");
+
+    qtest_qmp_device_add(qts, "usb4-device", "d2",
+                         "{'bus': 'u4.0', 'port': 2, 'drive': 'none0'}");
+    qtest_qmp_device_del(qts, "d2");
+    qtest_qmp_device_del(qts, "d1");
+    /* Port is free again */
+    qtest_qmp_device_add(qts, "usb4-device", "d3",
+                         "{'bus': 'u4.0', 'port': 1}");
+    qtest_quit(qts);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+
+    qtest_add_func("/usb4-host/identity", test_identity);
+    qtest_add_func("/usb4-host/identity-q35", test_identity_q35);
+    qtest_add_func("/usb4-host/loopback", test_loopback);
+    qtest_add_func("/usb4-host/wraparound", test_wraparound);
+    qtest_add_func("/usb4-host/rx-exhaustion", test_rx_exhaustion);
+    qtest_add_func("/usb4-host/ordering", test_ordering);
+    qtest_add_func("/usb4-host/rx-dma-error", test_rx_dma_error);
+    qtest_add_func("/usb4-host/rx-overflow", test_overflow);
+    qtest_add_func("/usb4-host/hi-reset", test_hi_reset);
+    qtest_add_func("/usb4-host/isr-autoclear", test_isr_autoclear);
+    qtest_add_func("/usb4-host/isr-noautoclear", test_isr_noautoclear);
+    qtest_add_func("/usb4-host/intx", test_intx);
+    qtest_add_func("/usb4-host/msi", test_msi);
+    qtest_add_func("/usb4-host/msix", test_msix);
+    qtest_add_func("/usb4-host/polling", test_polling);
+    qtest_add_func("/usb4-host/itr", test_itr);
+    qtest_add_func("/usb4-host/adl-autoclear", test_adl_autoclear);
+    qtest_add_func("/usb4-host/adl-autoclear-completion",
+                   test_adl_autoclear_completion);
+    qtest_add_func("/usb4-host/adl-autoclear-msi-intx",
+                   test_adl_autoclear_msi_intx);
+    qtest_add_func("/usb4-host/msix-autoclear-pending",
+                   test_msix_autoclear_pending);
+    qtest_add_func("/usb4-host/ring-disable", test_ring_disable);
+    qtest_add_func("/usb4-host/vacancy", test_vacancy);
+    qtest_add_func("/usb4-host/hotplug", test_hotplug);
+
+    return g_test_run();
+}
diff --git a/tests/qtest/usb4-icm-test.c b/tests/qtest/usb4-icm-test.c
new file mode 100644
index 0000000000000000000000000000000000000000..44a01a0e45ff736c93c1d2cb92ce44c3cc8f3000
--- /dev/null
+++ b/tests/qtest/usb4-icm-test.c
@@ -0,0 +1,2296 @@
+/*
+ * QTest for the tb3-alpine-ridge profile of usb4-host and its emulated
+ * firmware connection manager (ICM)
+ *
+ * Copyright (c) 2026 usb4-emu contributors
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Written from scratch for the usb4-emu project from the clean-room
+ * description docs/ICM-PROTOCOL.md; expected values are those of the
+ * P14s Gen 1 capture (tests/captures/p14s-gen1/). The guest side is
+ * driven by polling only: MSI, MSI-X and INTx are never enabled.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/bswap.h"
+#include "libqtest.h"
+#include "libqos/pci.h"
+#include "libqos/pci-pc.h"
+#include "libqos/malloc-pc.h"
+#include "hw/pci/pci_regs.h"
+#include "qobject/qdict.h"
+#include "qobject/qlist.h"
+
+#define DEVFN                QPCI_DEVFN(4, 0)
+#define TP_PATH              "/machine/peripheral/tp0"
+
+/* BAR0, ICM-PROTOCOL.md 2.1 */
+#define TX_RING(n)           (0x00000 + (n) * 0x10)
+#define RX_RING(n)           (0x08000 + (n) * 0x10)
+#define  RING_BASE_LO        0x0
+#define  RING_BASE_HI        0x4
+#define  RING_INDEX          0x8
+#define  RING_SIZE           0xc
+#define TX_CTRL(n)           (0x19800 + (n) * 0x20)
+#define RX_CTRL(n)           (0x29800 + (n) * 0x20)
+#define RX_PDF(n)            (0x29804 + (n) * 0x20)
+#define RING_VALID           (1u << 31)
+#define RING_RAW             (1u << 30)
+#define ISR0                 0x37800
+#define IMR0                 0x38200
+#define ITR0                 0x38c00
+#define HI_CAPS              0x39640
+#define HI_RESET             0x39858
+#define DMA_MISC             0x39864
+#define INMAIL_DATA          0x39900
+#define INMAIL_CMD           0x39904
+#define OUTMAIL              0x3990c
+#define FW_STS               0x39944
+
+#define PDF_ICM_EVENT        10
+#define PDF_ICM_CMD          11
+#define PDF_ICM_RESP         12
+
+#define DESC_DD              (1u << 21)
+#define DESC_RS              (1u << 22)
+#define DESC_IE              (1u << 23)
+
+#define RING_N               16
+#define BUF_SIZE             256
+
+typedef struct T {
+    QTestState *qts;
+    QPCIBus *bus;
+    QPCIDevice *dev;
+    QPCIBar bar;
+    QGuestAllocator alloc;
+    uint64_t tx_ring, rx_ring, tx_buf, rx_buf;
+    unsigned tx_pi, rx_ci, rx_next;
+    char *img;
+} T;
+
+static uint32_t rd(T *t, uint32_t off)
+{
+    return qpci_io_readl(t->dev, t->bar, off);
+}
+
+static void wr(T *t, uint32_t off, uint32_t v)
+{
+    qpci_io_writel(t->dev, t->bar, off, v);
+}
+
+static const char *dialect(void)
+{
+    const char *d = getenv("USB4_ICM_TEST_DIALECT");
+
+    return d ? d : "tb3";
+}
+
+/*
+ * @dev_opts: the usb4-device properties after "bus=u4.0,port=1," (NULL:
+ * no device), @extra: more command line.
+ */
+static T *t_start_dev(const char *host_opts, const char *dev_opts,
+                      const char *extra)
+{
+    T *t = g_new0(T, 1);
+    int fd = g_file_open_tmp("usb4-icm-XXXXXX", &t->img, NULL);
+    g_autofree char *dev = NULL;
+
+    g_assert(fd >= 0);
+    g_assert(ftruncate(fd, 1024 * 1024) == 0);
+    close(fd);
+    if (dev_opts) {
+        dev = g_strdup_printf("-device usb4-device,id=d0,bus=u4.0,port=1,"
+                              "%s %s", dev_opts, extra ? extra : "");
+    } else if (extra) {
+        dev = g_strdup(extra);
+    }
+    t->qts = qtest_initf("-machine q35 "
+                         "-global ICH9-LPC.acpi-pci-hotplug-with-bridge-"
+                         "support=off "
+                         "-drive if=none,id=disk0,file=%s,format=raw "
+                         "-device usb4-tunnel-port,id=tp0,bus=pcie.0,"
+                         "addr=0x3,chassis=1,settle-ms=200 "
+                         "-device usb4-host,id=u4,bus=pcie.0,addr=0x4,"
+                         "tunnel-port=tp0,profile=tb3-alpine-ridge%s %s",
+                         t->img, host_opts ? host_opts : "",
+                         dev ? dev : "");
+    pc_alloc_init(&t->alloc, t->qts, ALLOC_NO_FLAGS);
+    t->bus = qpci_new_pc(t->qts, &t->alloc);
+    t->dev = qpci_device_find(t->bus, DEVFN);
+    g_assert(t->dev);
+    qpci_device_enable(t->dev);
+    t->bar = qpci_iomap(t->dev, 0, NULL);
+    return t;
+}
+
+static T *t_start(const char *host_opts, bool with_device)
+{
+    /* default names: qtest command lines cannot carry spaces */
+    g_autofree char *dev = g_strdup_printf("dialect=%s,drive=disk0,"
+                                           "serial=QTICM", dialect());
+
+    return t_start_dev(host_opts, with_device ? dev : NULL, NULL);
+}
+
+/* The ORICO's ASM2464 (P14S-ORICO-2026-10-15.md) behind the AR host */
+#define ORICO_DEV "dialect=usb4,device-model=asm2464,drive=disk0," \
+                  "serial=QTICM"
+
+static void t_stop(T *t)
+{
+    g_free(t->dev);
+    qpci_free_pc(t->bus);
+    alloc_destroy(&t->alloc);
+    qtest_quit(t->qts);
+    if (t->img) {
+        unlink(t->img);
+    }
+    g_free(t->img);
+    g_free(t);
+}
+
+/* ---- ring 0, raw mode, as the Linux client sets it up (2.1, 6.1) ---- */
+
+static void desc_write(T *t, uint64_t ring, unsigned i, uint64_t addr,
+                       uint32_t dw2)
+{
+    uint64_t d = ring + i * 16;
+
+    qtest_writel(t->qts, d, (uint32_t)addr);
+    qtest_writel(t->qts, d + 4, addr >> 32);
+    qtest_writel(t->qts, d + 8, dw2);
+    qtest_writel(t->qts, d + 12, 0);
+}
+
+static void rx_post(T *t, unsigned n)
+{
+    while (n--) {
+        desc_write(t, t->rx_ring, t->rx_ci, t->rx_buf + t->rx_ci * BUF_SIZE,
+                   DESC_RS | DESC_IE);
+        t->rx_ci = (t->rx_ci + 1) % RING_N;
+    }
+    wr(t, RX_RING(0) + RING_INDEX, t->rx_ci);
+}
+
+static void rings_setup(T *t)
+{
+    if (!t->tx_ring) {
+        t->tx_ring = guest_alloc(&t->alloc, RING_N * 16);
+        t->rx_ring = guest_alloc(&t->alloc, RING_N * 16);
+        t->tx_buf = guest_alloc(&t->alloc, RING_N * BUF_SIZE);
+        t->rx_buf = guest_alloc(&t->alloc, RING_N * BUF_SIZE);
+    }
+    t->tx_pi = t->rx_ci = t->rx_next = 0;
+    wr(t, TX_RING(0) + RING_BASE_LO, (uint32_t)t->tx_ring);
+    wr(t, TX_RING(0) + RING_BASE_HI, t->tx_ring >> 32);
+    wr(t, TX_RING(0) + RING_SIZE, RING_N);
+    wr(t, TX_CTRL(0), RING_VALID | RING_RAW);
+    wr(t, RX_RING(0) + RING_BASE_LO, (uint32_t)t->rx_ring);
+    wr(t, RX_RING(0) + RING_BASE_HI, t->rx_ring >> 32);
+    wr(t, RX_RING(0) + RING_SIZE, RING_N | (BUF_SIZE << 16));
+    wr(t, RX_PDF(0), 0xffffffff);
+    wr(t, RX_CTRL(0), RING_VALID | RING_RAW);
+    /* Interrupt enables as captured, though nothing is ever delivered */
+    wr(t, IMR0, (1u << 0) | (1u << 12));
+    rx_post(t, RING_N - 1);
+}
+
+static void rings_stop(T *t)
+{
+    wr(t, IMR0, 0);
+    wr(t, TX_CTRL(0), 0);
+    wr(t, RX_CTRL(0), 0);
+}
+
+static uint32_t crc32c(const uint8_t *p, size_t n)
+{
+    uint32_t c = 0xffffffff;
+
+    while (n--) {
+        c ^= *p++;
+        for (int b = 0; b < 8; b++) {
+            c = (c >> 1) ^ ((c & 1) ? 0x82f63b78 : 0);
+        }
+    }
+    return ~c;
+}
+
+/* Send an ICM command: words MSB first, CRC-32C trailer (3, 0). */
+static void tx_frame_crc(T *t, unsigned pdf, const uint32_t *w, unsigned n,
+                         bool bad_crc)
+{
+    uint8_t buf[BUF_SIZE];
+    uint64_t b = t->tx_buf + t->tx_pi * BUF_SIZE;
+
+    for (unsigned i = 0; i < n; i++) {
+        stl_be_p(buf + 4 * i, w[i]);
+    }
+    stl_be_p(buf + 4 * n, crc32c(buf, 4 * n) ^ (bad_crc ? 1 : 0));
+    qtest_memwrite(t->qts, b, buf, 4 * n + 4);
+    desc_write(t, t->tx_ring, t->tx_pi, b,
+               (4 * n + 4) | (pdf << 12) | DESC_RS | DESC_IE);
+    t->tx_pi = (t->tx_pi + 1) % RING_N;
+    wr(t, TX_RING(0) + RING_INDEX, t->tx_pi << 16);
+}
+
+static void tx_frame(T *t, unsigned pdf, const uint32_t *w, unsigned n)
+{
+    tx_frame_crc(t, pdf, w, n, false);
+}
+
+static void icm_cmd(T *t, const uint32_t *w, unsigned n)
+{
+    tx_frame(t, PDF_ICM_CMD, w, n);
+}
+
+/*
+ * Poll for the next received frame (no interrupts): returns its PDF and
+ * fills @w with the words, CRC checked. Returns 0 if none arrived.
+ */
+static unsigned icm_recv(T *t, uint32_t *w, unsigned *n)
+{
+    unsigned i = t->rx_next, len, pdf;
+    uint32_t dw2;
+    uint8_t buf[BUF_SIZE];
+
+    /* Polling truth: the producer index moved past our descriptor. */
+    if (((rd(t, RX_RING(0) + RING_INDEX) >> 16) & 0xffff) == i) {
+        return 0;
+    }
+    dw2 = qtest_readl(t->qts, t->rx_ring + i * 16 + 8);
+    g_assert_cmphex(dw2 & DESC_DD, ==, DESC_DD);
+    len = dw2 & 0xfff;
+    pdf = (dw2 >> 12) & 0xf;
+    g_assert_cmpuint(len, >=, 8);
+    qtest_memread(t->qts, t->rx_buf + i * BUF_SIZE, buf, len);
+    g_assert_cmphex(crc32c(buf, len - 4), ==, (uint32_t)ldl_be_p(buf + len - 4));
+    *n = len / 4 - 1;
+    for (unsigned k = 0; k < *n; k++) {
+        w[k] = (uint32_t)ldl_be_p(buf + 4 * k);
+    }
+    t->rx_next = (i + 1) % RING_N;
+    rx_post(t, 1);
+    return pdf;
+}
+
+static unsigned icm_expect(T *t, unsigned pdf, uint32_t *w)
+{
+    unsigned n = 0, got = icm_recv(t, w, &n);
+
+    g_assert_cmpuint(got, ==, pdf);
+    return n;
+}
+
+static void icm_expect_none(T *t)
+{
+    uint32_t w[64];
+    unsigned n;
+
+    g_assert_cmpuint(icm_recv(t, w, &n), ==, 0);
+}
+
+static uint32_t mailbox(T *t, uint8_t cmd)
+{
+    wr(t, INMAIL_DATA, 0);
+    wr(t, INMAIL_CMD, (1u << 31) | cmd);
+    return rd(t, INMAIL_CMD);
+}
+
+/* Bind sequence of ICM-PROTOCOL.md 6.1 up to the driver-ready response. */
+static void icm_bind(T *t, uint32_t *resp)
+{
+    uint32_t dr = 0x00000003;
+
+    g_assert_cmphex(rd(t, FW_STS) & 0x80000001, ==, 0x80000001);
+    g_assert_cmphex((rd(t, OUTMAIL) >> 8) & 0xf, ==, 3);
+    rings_setup(t);
+    g_assert_cmphex(mailbox(t, 0x23), ==, 0x23);
+    icm_cmd(t, &dr, 1);
+    g_assert_cmpuint(icm_expect(t, PDF_ICM_RESP, resp), ==, 2);
+}
+
+/* ---- tests ---- */
+
+static void test_identity(void)
+{
+    T *t = t_start(NULL, false);
+
+    /* R1 */
+    g_assert_cmphex(qpci_config_readw(t->dev, PCI_VENDOR_ID), ==, 0x8086);
+    g_assert_cmphex(qpci_config_readw(t->dev, PCI_DEVICE_ID), ==, 0x15bf);
+    g_assert_cmphex(qpci_config_readb(t->dev, PCI_REVISION_ID), ==, 1);
+    g_assert_cmphex(qpci_config_readl(t->dev, PCI_CLASS_REVISION) >> 8,
+                    ==, 0x088000);
+    g_assert_cmphex(qpci_config_readw(t->dev, PCI_SUBSYSTEM_VENDOR_ID), ==,
+                    0x17aa);
+    g_assert_cmphex(qpci_config_readw(t->dev, PCI_SUBSYSTEM_ID), ==, 0x22b0);
+    g_assert_cmphex(qpci_config_readb(t->dev, PCI_INTERRUPT_PIN), ==, 1);
+    /* R2 */
+    g_assert_cmphex(rd(t, HI_CAPS), ==, 0x0000000c);
+    g_assert_cmphex(rd(t, FW_STS), ==, 0x800001a1);
+    /* power-on values (ICM-PROTOCOL.md 13.5, W98 A1P1_OR PCIDUMPN) */
+    g_assert_cmphex(rd(t, OUTMAIL), ==, 0x800003f0);
+    g_assert_cmphex(rd(t, DMA_MISC), ==, 0x01000012);
+    g_assert_cmphex(rd(t, ITR0), ==, 0x1f4);
+    g_assert_cmphex(rd(t, ITR0 + 15 * 4), ==, 0x1f4);
+    /* C1: Interval stays 0x1f4 whatever is written, as captured */
+    wr(t, ITR0, 0);
+    wr(t, ITR0 + 4, 0x12345678);
+    g_assert_cmphex(rd(t, ITR0), ==, 0x1f4);
+    g_assert_cmphex(rd(t, ITR0 + 4), ==, 0x1f4);
+    g_assert_cmphex(rd(t, INMAIL_CMD), ==, 0);
+    /* R3: supported codes complete, the code stays, bit 30 otherwise */
+    g_assert_cmphex(mailbox(t, 0x23), ==, 0x23);
+    g_assert_cmphex(mailbox(t, 0x07), ==, 0x07);
+    g_assert_cmphex(mailbox(t, 0x05), ==, 0x05);
+    g_assert_cmphex(mailbox(t, 0x10), ==, 0x10);
+    g_assert_cmphex(mailbox(t, 0x42), ==, 0x40000042);
+    /* firmware status is not writable (R4) */
+    wr(t, FW_STS, 0x40000006);
+    g_assert_cmphex(rd(t, FW_STS), ==, 0x800001a1);
+    /* binds and unbinds keep 0xf0 (R1-R4 mmio/-1 to -3) */
+    g_assert_cmphex(rd(t, OUTMAIL), ==, 0x800003f0);
+    /* after the NHI's first D3 the low nibble reads 5 (R1-W:145.874) */
+    {
+        uint8_t pm = qpci_find_capability(t->dev, PCI_CAP_ID_PM, 0);
+
+        g_assert_cmpuint(pm, !=, 0);
+        qpci_config_writew(t->dev, pm + PCI_PM_CTRL, 3);
+        qpci_config_writew(t->dev, pm + PCI_PM_CTRL, 0);
+        qpci_device_enable(t->dev);
+        g_assert_cmphex(rd(t, OUTMAIL), ==, 0x800003f5);
+        /* a device reset is a power-on again */
+        qtest_qmp_assert_success(t->qts, "{'execute': 'system_reset'}");
+        qtest_qmp_eventwait(t->qts, "RESET");
+        qpci_device_enable(t->dev);
+        qpci_iounmap(t->dev, t->bar);
+        t->bar = qpci_iomap(t->dev, 0, NULL);
+        g_assert_cmphex(rd(t, OUTMAIL), ==, 0x800003f0);
+    }
+    t_stop(t);
+}
