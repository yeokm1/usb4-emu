+/*
+ * asm4242 host model (docs/USB4-HOSTS.md 5): identity, inferred layout,
+ * router operations and quirks a and c, from public sources only.
+ */
+static USB4Fabric *asm_fabric(const USB4AsmConfig *ac)
+{
+    USB4FabricConfig cfg = {
+        .profile = USB4_PROFILE_USB4_GENERIC, .dialect = USB4_DIALECT_USB4,
+        .router_vendor_id = 0x174c, .router_device_id = 0x2428,
+        .num_usb4_ports = 2, .host_model = USB4_HOST_MODEL_ASM4242,
+        .asm4242 = *ac,
+    };
+
+    return usb4_fabric_new((USB4Host *)&fake_host, &cfg);
+}
+
+/* Program and tear down Host Interface path @hop; returns PATH_CS_1. */
+static uint32_t asm_hi_path_cycle(unsigned hi, unsigned hop)
+{
+    uint32_t e[2] = { 0x80000000u | (1u << 11) | 8, 0x00000301 };
+
+    CHECK(wr(HOST, USB4_CS_PATH, hi, 2 * hop, 2, e) == 0, "HI path write");
+    CHECK(!(rd1(HOST, USB4_CS_PATH, hi, 2 * hop + 1) & (1u << 28)),
+          "PP clear while valid");
+    e[0] &= ~(1u << 31);
+    CHECK(wr(HOST, USB4_CS_PATH, hi, 2 * hop, 2, e) == 0, "HI path clear");
+    advance(600);           /* longer than a CM's drain timeout */
+    return rd1(HOST, USB4_CS_PATH, hi, 2 * hop + 1);
+}
+
+static void test_asm4242(void)
+{
+    USB4AsmConfig ac = ASM_CFG_DEFAULT;
+    USB4Fabric *saved = fab;
+    uint32_t v[16], data[17], cs26;
+    static const uint32_t types[] = { 0, 0x01000001, 0x01000001, 0x01000001,
+                                      0x01000001, 0x010e0101, 0x010e0101,
+                                      0x01000002, 0x01100101, 0x01100101,
+                                      0x01200101, 0x01200101 };
+    static const uint8_t dp_caps[] = { USB4_CAP_PROTO };
+
+    CHECK(usb4_asm_config_check(&ac, NULL), "asm default layout valid");
+    ac.adp_usb3 = 9;
+    CHECK(!usb4_asm_config_check(&ac, NULL), "asm overlap rejected");
+    ac.adp_usb3 = 10;
+    ac.adp_hi = 3;
+    CHECK(!usb4_asm_config_check(&ac, NULL), "asm lane clash rejected");
+    ac.adp_hi = 7;
+
+    fab = asm_fabric(&ac);
+    CHECK(rd(HOST, USB4_CS_ROUTER, 0, 0, 5, v) == 0, "asm DW0-4");
+    CHECK(v[0] == 0x2428174c, "asm router id %08x", v[0]);
+    CHECK(((v[1] >> 8) & 0x3f) == 7, "asm upstream adapter");
+    CHECK(((v[1] >> 14) & 0x3f) == 11, "asm max adapter");
+    CHECK((v[4] >> 24) == USB4_VERSION_1_0, "asm USB4 1.0 router");
+    enumerate_router(HOST, 0);
+    for (unsigned a = 1; a <= 11; a++) {
+        CHECK(rd(HOST, USB4_CS_ADAPTER, a, 0, 6, v) == 0, "asm adp %u", a);
+        CHECK(v[2] == types[a], "asm adp %u type %08x", a, v[2]);
+        if (a <= 4) {
+            CHECK(((v[4] >> 20) & 0x3ff) == 174, "asm lane buffers %u",
+                  (v[4] >> 20) & 0x3ff);
+        } else if (a <= 6) {
+            walk_caps(HOST, USB4_CS_ADAPTER, a, v[1] & 0xff, dp_caps, 1);
+            CHECK((v[5] & 0x7f) == 9, "DP IN Max HopID");
+        }
+    }
+    CHECK(rd(HOST, USB4_CS_ADAPTER, 12, 0, 1, v) == (0x100 | USB4_ERR_ADP),
+          "asm adapter 12 beyond max");
+
+    /* Buffer Allocation: baMaxHI 32 (quirk c) */
+    router_op(HOST, 0x33, 0, data);
+    CHECK((data[16] & 0xff) == 5 && data[4] == 0x00200005,
+          "asm baMaxHI %08x", data[4]);
+    /* NVM: sector size, version and date dwords (ASMedia offsets) */
+    cs26 = router_op(HOST, 0x25, 0, data);
+    CHECK(!(cs26 & (1u << 30)) && !((cs26 >> 24) & 0x3f) &&
+          data[16] == 0x1000, "asm NVM sector size %08x", data[16]);
+    router_op(HOST, 0x22, (0x28 / 4) << 2 | (1u << 24), data);
+    CHECK(data[0] == 0x00110020, "asm NVM version dword %08x", data[0]);
+    router_op(HOST, 0x22, (0x1c / 4) << 2 | (1u << 24), data);
+    CHECK(data[0] == 0x00080725, "asm NVM date dword %08x", data[0]);
+    /* DP resource operations on the DP IN adapters only */
+    cs26 = router_op(HOST, 0x10, 5, data);
+    CHECK(!(cs26 & (1u << 30)) && !((cs26 >> 24) & 0x3f), "DP query 5");
+    cs26 = router_op(HOST, 0x10, 7, data);
+    CHECK(((cs26 >> 24) & 0x3f) == 1, "DP query on HI fails");
+    cs26 = router_op(HOST, 0x21, 0, data);
+    CHECK(cs26 & (1u << 30), "NVM authenticate not supported");
+
+    /* Quirk a: HI path Pending Packets never clears after teardown */
+    CHECK(asm_hi_path_cycle(7, 1) & (1u << 28), "asm PP stuck");
+    CHECK(rd1(HOST, USB4_CS_PATH, 7, 3) & (1u << 28), "asm PP still stuck");
+    {
+        uint32_t e[2] = { 0x80000000u | (1u << 11) | 8, 0x00000301 };
+
+        CHECK(wr(HOST, USB4_CS_PATH, 7, 2, 2, e) == 0, "HI path again");
+        CHECK(!(rd1(HOST, USB4_CS_PATH, 7, 3) & (1u << 28)),
+              "PP clear when valid again");
+    }
+    /* a lane adapter path drains as usual */
+    {
+        uint32_t e[2] = { 0x80000000u | (7u << 11) | 1, 0x01000301 };
+
+        CHECK(wr(HOST, USB4_CS_PATH, 1, 16, 2, e) == 0, "lane path");
+        e[0] &= ~(1u << 31);
+        CHECK(wr(HOST, USB4_CS_PATH, 1, 16, 2, e) == 0, "lane path clear");
+        CHECK(!(rd1(HOST, USB4_CS_PATH, 1, 17) & (1u << 28)),
+              "lane path drains");
+    }
+    /* Torn down again: stuck once more, until the router is reset */
+    {
+        uint32_t e[2] = { (1u << 11) | 8, 0x00000301 };
+
+        CHECK(wr(HOST, USB4_CS_PATH, 7, 2, 2, e) == 0, "HI path clear again");
+        advance(600);
+        CHECK(rd1(HOST, USB4_CS_PATH, 7, 3) & (1u << 28),
+              "asm PP stuck again");
+    }
+    usb4_fabric_reset(fab);
+    CHECK(!(rd1(HOST, USB4_CS_PATH, 7, 3) & (1u << 28)), "PP clear at reset");
+    usb4_fabric_free(fab);
+
+    /* Quirks off, no DP IN, another layout, no NVM */
+    ac = (USB4AsmConfig){ .adp_dp = 0, .adp_hi = 5, .adp_pcie = 6,
+                          .adp_usb3 = 12 };
+    CHECK(usb4_asm_config_check(&ac, NULL), "asm alt layout valid");
+    fab = asm_fabric(&ac);
+    CHECK(rd(HOST, USB4_CS_ROUTER, 0, 1, 1, v) == 0, "asm alt DW1");
+    CHECK(((v[0] >> 8) & 0x3f) == 5 && ((v[0] >> 14) & 0x3f) == 13,
+          "asm alt upstream/max %08x", v[0]);
+    enumerate_router(HOST, 0);
+    CHECK(rd(HOST, USB4_CS_ADAPTER, 8, 0, 1, v) == (0x100 | USB4_ERR_ADDR),
+          "asm alt gap adapter 8 not implemented (as adl 10-11)");
+    CHECK(rd1(HOST, USB4_CS_ADAPTER, 7, 2) == 0x01100101, "asm alt PCIe 2");
+    CHECK(rd1(HOST, USB4_CS_ADAPTER, 13, 2) == 0x01200101, "asm alt USB3 2");
+    CHECK(((rd1(HOST, USB4_CS_ADAPTER, 1, 4) >> 20) & 0x3ff) == 120,
+          "lane buffers without quirk c");
+    router_op(HOST, 0x33, 0, data);
+    CHECK(data[4] == 0x000e0005, "baMaxHI without quirk c %08x", data[4]);
+    cs26 = router_op(HOST, 0x25, 0, data);
+    CHECK(cs26 & (1u << 30), "no NVM: sector size not supported");
+    CHECK(!(asm_hi_path_cycle(5, 1) & (1u << 28)),
+          "PP drains without quirk a");
+    usb4_fabric_free(fab);
+    fab = saved;
+}
+
+#ifndef FABRIC_TEST_NO_MAIN
+/*
+ * asm2464 device model (docs/captures/ORICO-ASM2464.md): the captured
+ * ASMedia ASM2464PD on USB4 port 2 of an intel-adl host (domain 1, route
+ * 3, as in the capture). Offsets are the captured ones.
+ */
+static USB4Device asmdev = { .serial = "ORICO01",
+                             .model = USB4_DEVICE_MODEL_ASM2464 };
+#define ASMD 3ULL
+
+static uint32_t asm2464_sb(unsigned target, unsigned idx, unsigned reg,
+                           bool wnr, uint32_t op, uint32_t *data)
+{
+    uint32_t c1;
+
+    if (wnr) {
+        wr1(ASMD, USB4_CS_ADAPTER, 1, 0xc2, op);
+    }
+    wr1(ASMD, USB4_CS_ADAPTER, 1, 0xc1, reg | (4 << 8) | (target << 16) |
+        (idx << 20) | (wnr ? 1u << 24 : 0) | (1u << 31));
+    for (int i = 0; i < 200; i++) {
+        c1 = rd1(ASMD, USB4_CS_ADAPTER, 1, 0xc1);
+        if (!(c1 & (1u << 31))) {
+            break;
+        }
+        advance(1);
+    }
+    if (data) {
+        *data = rd1(ASMD, USB4_CS_ADAPTER, 1, 0xc2);
+    }
+    return c1;
+}
+
+static void test_asm2464(void)
+{
+    USB4FabricConfig cfg = {
+        .profile = USB4_PROFILE_USB4_GENERIC, .dialect = USB4_DIALECT_USB4,
+        .num_usb4_ports = 2, .host_model = USB4_HOST_MODEL_INTEL_ADL,
+        .host_domain = 1,
+    };
+    static const uint8_t drom_head[] = {
+        0x5e, 0x00, 0x27, 0x91, 0x70, 0x8e, 0x60, 0x4c, 0x17, 0x38, 0x4a,
+        0xab, 0xda, 0x01, 0x49, 0x00, 0xb8, 0x00, 0x63, 0x24,
+    };
+    static const uint8_t rtr_caps[] = { USB4_CAP_TMU, USB4_CAP_VS,
+                                        USB4_CAP_VS, USB4_CAP_VS };
+    static const uint8_t lane0_caps[] = { USB4_CAP_TMU, USB4_CAP_LANE,
+                                          USB4_CAP_PORT };
+    static const uint8_t lane1_caps[] = { USB4_CAP_TMU, USB4_CAP_LANE };
+    static const uint8_t pcie_caps[] = { USB4_CAP_PROTO };
+    USB4Fabric *saved = fab;
+    USB4Router *r;
+    uint32_t v[21], data[17], c1, d;
+    uint8_t drom[20];
+
+    fab = usb4_fabric_new((USB4Host *)&fake_host, &cfg);
+    enumerate_router(HOST, 0);
+    expect_hp(HOST, 5, false);      /* intel-adl: DP IN on enumeration */
+    expect_hp(HOST, 6, false);
+    CHECK(usb4_fabric_attach(fab, 2, &asmdev, NULL), "asm2464 attach");
+    expect_hp(HOST, 3, false);
+    expect_hp(HOST, 4, false);
+    rmw(HOST, USB4_CS_ADAPTER, 3, 4, 1u << 31, 0);  /* clear Lock */
+    r = asmdev.router;
+    CHECK(r && r->asm2464, "asm2464 router model");
+
+    /* Identity and layout before enumeration (first reads, observed) */
+    CHECK(rd_arr(ASMD, USB4_CS_ROUTER, 0, 0, 9, v) == 0, "asm2464 DW0-8");
+    CHECK(v[0] == 0x2463174c, "router id %08x", v[0]);
+    CHECK(v[1] == 0x000101c0, "ROUTER_CS_1 %08x", v[1]);
+    CHECK(v[4] == 0x2000000a && v[5] == 0 && v[6] == 0,
+          "ROUTER_CS_4-6 %08x %08x %08x", v[4], v[5], v[6]);
+    CHECK(v[7] == 0x174c608e && v[8] == 0x70912700, "UID %08x %08x", v[7],
+          v[8]);
+    /* Enumeration: Router Ready a few ms later (observed 0 at 0.4 ms) */
+    v[0] = 0x001101c0;
+    v[1] = (uint32_t)ASMD;
+    v[2] = 1u << 31;
+    v[3] = 0x2000100a;
+    CHECK(wr(ASMD, USB4_CS_ROUTER, 0, 1, 4, v) == 0, "enumerate");
+    /*
+     * Captured routers answer a Router CS write with the request's
+     * Adapter Num (0) and a read with the Upstream Adapter (observed).
+     */
+    CHECK(USB4_REQ_ADP(last_rsp_dw2) == 0, "asm2464 write reply adapter %u",
+          USB4_REQ_ADP(last_rsp_dw2));
+    rd1(ASMD, USB4_CS_ROUTER, 0, 5);
+    CHECK(USB4_REQ_ADP(last_rsp_dw2) == 1, "asm2464 read reply adapter %u",
+          USB4_REQ_ADP(last_rsp_dw2));
+    wr1(HOST, USB4_CS_ROUTER, 0, 4, rd1(HOST, USB4_CS_ROUTER, 0, 4));
+    CHECK(USB4_REQ_ADP(last_rsp_dw2) == 0, "intel-adl write reply adapter %u",
+          USB4_REQ_ADP(last_rsp_dw2));
+    rd1(HOST, USB4_CS_ROUTER, 0, 5);
+    CHECK(USB4_REQ_ADP(last_rsp_dw2) == fab->hr->upstream_adapter,
+          "intel-adl read reply adapter %u", USB4_REQ_ADP(last_rsp_dw2));
+    CHECK(rd1(ASMD, USB4_CS_ROUTER, 0, 6) == 0, "RR not yet");
+    advance(10);
+    CHECK(rd1(ASMD, USB4_CS_ROUTER, 0, 6) == 0x01000000, "RR");
+
+    walk_caps(ASMD, USB4_CS_ROUTER, 0, rd1(ASMD, USB4_CS_ROUTER, 0, 1) & 0xff,
+              rtr_caps, 4);
+    CHECK(rd1(ASMD, USB4_CS_ROUTER, 0, 0xc0) == 0x43200328, "TMU at 0xc0");
+    CHECK(rd(ASMD, USB4_CS_ROUTER, 0, 0x1ff, 1, v) == 0, "Router CS 0x1ff");
+    CHECK(rd(ASMD, USB4_CS_ROUTER, 0, 0x200, 1, v) == (0x100 | USB4_ERR_ADDR),
+          "Router CS ends at 0x1ff");
+    for (unsigned a = 1; a <= 3; a++) {
+        static const uint32_t types[] = { 0, 0x01000001, 0x01000001,
+                                          0x01100102 };
+
+        CHECK(rd_arr(ASMD, USB4_CS_ADAPTER, a, 0, 6, v) == 0, "adp %u", a);
+        CHECK(v[0] == 0 && v[2] == types[a], "adp %u CS0 %08x CS2 %08x", a,
+              v[0], v[2]);
+        walk_caps(ASMD, USB4_CS_ADAPTER, a, v[1] & 0xff,
+                  a == 1 ? lane0_caps : a == 2 ? lane1_caps : pcie_caps,
+                  a == 1 ? 3 : a == 2 ? 2 : 1);
+        if (a < 3) {
+            CHECK(v[4] == 0x44200000, "lane ADP_CS_4 %08x (66 buffers)", v[4]);
+            CHECK((v[5] & 0x7ff) == 27, "lane Max HopID 27");
+        }
+    }
+    CHECK(rd1(ASMD, USB4_CS_ADAPTER, 4, 0) == 0, "adapter 4 ADP_CS_0 0");
+    CHECK(rd(ASMD, USB4_CS_ADAPTER, 5, 0, 1, v) == (0x100 | USB4_ERR_ADP),
+          "adapter 5 beyond Max Adapter");
+    CHECK(rd1(ASMD, USB4_CS_ADAPTER, 1, 0x80) == 0x003c01c0,
+          "LANE_ADP_CS_0: Gen 2/3, x1/x2, no CL0s/CL1/CL2");
+    CHECK(rd1(ASMD, USB4_CS_ADAPTER, 1, 0x81) == 0x4814001c,
+          "LANE_ADP_CS_1 %08x", rd1(ASMD, USB4_CS_ADAPTER, 1, 0x81));
+    CHECK(rd1(ASMD, USB4_CS_ADAPTER, 1, 0xd2) == 0x00003110,
+          "PORT_CS_18 %08x (no Cable Gen 3 Support)",
+          rd1(ASMD, USB4_CS_ADAPTER, 1, 0xd2));
+    CHECK(rd1(ASMD, USB4_CS_ADAPTER, 1, 0xd3) == 0x00040006, "PORT_CS_19");
+    CHECK(rd1(ASMD, USB4_CS_ADAPTER, 3, 9) == 0x000e0400,
+          "ADP_PCIE_CS_0 idle with RST");
+    CHECK(rd1(ASMD, USB4_CS_PATH, 1, 0) == 0x00040000, "lane path 0");
+    CHECK(rd1(ASMD, USB4_CS_PATH, 3, 16) == 0x00000008, "PCIe HopID 8");
+    CHECK(rd_arr(ASMD, USB4_CS_COUNTERS, 1, 0, 21, v) == 0, "7 counter sets");
+    CHECK(rd_arr(ASMD, USB4_CS_COUNTERS, 3, 0, 3, v) == 0, "1 counter set");
+
+    /* Router operations as observed */
+    router_op(ASMD, 0x33, 0, data);
+    CHECK(data[16] == 1 && data[0] == 0x00400004,
+          "Buffer Allocation meta %08x data %08x", data[16], data[0]);
+    router_op(ASMD, 0x24, 0x00080000, data);    /* 16 dwords at 0 */
+    for (unsigned i = 0; i < sizeof(drom); i++) {
+        drom[i] = data[i / 4] >> (8 * (i % 4));
+    }
+    CHECK(!memcmp(drom, drom_head, sizeof(drom)), "DROM header");
+    router_op(ASMD, 0x24, (21 << 2) | (1 << 15), data);  /* bytes 84-87 */
+    CHECK(data[0] == 0x02235ac0, "DROM tail %08x", data[0]);
+    CHECK(router_op(ASMD, 0x25, 0, NULL) == 0x02000025,
+          "NVM Sector Size: status 2");
+    CHECK((router_op(ASMD, 0x26, 0, NULL) >> 30) == 1, "unknown op: ONS");
+
+    /* Configuration Valid -> Configuration Ready at once */
+    wr1(ASMD, USB4_CS_ROUTER, 0, 5, 0x03000000);
+    wr1(ASMD, USB4_CS_ROUTER, 0, 5, 0x83000000);
+    CHECK(rd1(ASMD, USB4_CS_ROUTER, 0, 6) == 0x03000000, "CR");
+
+    /* Sideband: local IDs, Debug Configuration not defined */
+    c1 = asm2464_sb(0, 0, 0, false, 0, &d);
+    CHECK(c1 == 0x00000400 && d == 0x174c, "SB vendor %08x %08x", c1, d);
+    c1 = asm2464_sb(0, 0, 1, false, 0, &d);
+    CHECK(c1 == 0x00000401 && d == 0x2463, "SB product %08x %08x", c1, d);
+    c1 = asm2464_sb(0, 0, 5, false, 0, NULL);
+    CHECK(c1 == 0x04000005, "SB Debug Configuration RC %08x", c1);
+    /* The host's on-board retimer from the device side: index 1 only */
+    c1 = asm2464_sb(2, 1, 8, true, 0x5453414c, NULL);       /* LAST */
+    CHECK(c1 == 0x01120408, "RT LAST %08x", c1);
+    c1 = asm2464_sb(2, 1, 9, false, 0, &d);
+    CHECK(c1 == 0x00120409 && d == 0, "RT LAST metadata %08x %08x", c1, d);
+    c1 = asm2464_sb(2, 2, 8, false, 0, NULL);
+    CHECK(c1 == 0x02220408, "RT index 2: NR, no RC, Length kept %08x", c1);
+
+    /* Downstream Port Reset: the router comes back about 590 ms later */
+    wr1(HOST, USB4_CS_ADAPTER, 3, 0xa3, 0x0004000f);
+    expect_hp(HOST, 3, true);
+    expect_hp(HOST, 4, true);
+    advance(12);
+    wr1(HOST, USB4_CS_ADAPTER, 3, 0xa3, 0x0004000e);
+    advance(300);
+    CHECK(!(rd1(HOST, USB4_CS_ADAPTER, 3, 4) & (1u << 30)),
+          "link still down 300 ms after DPR release");
+    rx_flush_hp();
+    n_hpev = 0;             /* retransmissions of the acknowledged unplugs */
+    advance(400);
+    CHECK(rd1(HOST, USB4_CS_ADAPTER, 3, 4) & (1u << 30), "link back");
+    expect_hp(HOST, 3, false);
+    expect_hp(HOST, 4, false);
+    rmw(HOST, USB4_CS_ADAPTER, 3, 4, 1u << 31, 0);
+    CHECK(rd1(ASMD, USB4_CS_ROUTER, 0, 1) == 0x000101c0 &&
+          !rd1(ASMD, USB4_CS_ROUTER, 0, 9), "router reset by the DPR");
+    CHECK(rd1(ASMD, USB4_CS_ROUTER, 0, 7) == 0x174c608e, "same UID");
+
+    usb4_fabric_detach(fab, 2);
+    expect_hp(HOST, 3, true);
+    expect_hp(HOST, 4, true);       /* not bonded: lane 1 reports too */
+    asmdev.uid = 0x1122334455667788ULL;
+    CHECK(usb4_fabric_attach(fab, 2, &asmdev, NULL), "asm2464 uid");
+    expect_hp(HOST, 3, false);
+    expect_hp(HOST, 4, false);
+    rmw(HOST, USB4_CS_ADAPTER, 3, 4, 1u << 31, 0);
+    CHECK(rd1(ASMD, USB4_CS_ROUTER, 0, 7) == 0x11223344 &&
+          rd1(ASMD, USB4_CS_ROUTER, 0, 8) == 0x55667788, "uid property");
+    router_op(ASMD, 0x24, 0x00008000 | (0 << 2), data);
+    CHECK((data[0] & 0xff) == usb4_drom_crc8(asmdev.router ?
+          ((USB4Router *)asmdev.router)->drom + 1 : drom, 8) &&
+          ((data[0] >> 8) & 0xff) == 0x88, "DROM UID and CRC-8 follow uid");
+    asmdev.uid = 0;
+    usb4_fabric_free(fab);
+
+    /* The pre-OS CM tunnels the asm2464 like any USB4 device router */
+    cfg.preos_cm = true;
+    fab = usb4_fabric_new((USB4Host *)&fake_host, &cfg);
+    tp_state = USB4_TUNNEL_DOWN;
+    CHECK(usb4_fabric_attach(fab, 1, &asmdev, NULL), "preos asm2464 attach");
+    CHECK(tp_state == USB4_TUNNEL_UP && tp_dev == &asmdev,
+          "preos: asm2464 tunnel up");
+    CHECK(rd1(1, USB4_CS_ADAPTER, 3, 9) == 0x8c010400,
+          "ADP_PCIE_CS_0 in L0 %08x", rd1(1, USB4_CS_ADAPTER, 3, 9));
+    /*
+     * A power-on reset while the router is recovering from a Downstream
+     * Port Reset: the reset ends the recovery, the link comes back at
+     * once and the pre-OS CM tunnels the router again.
+     */
+    wr1(HOST, USB4_CS_ADAPTER, 1, 0xa3, 0x0004000f);
+    CHECK(tp_state == USB4_TUNNEL_DOWN, "preos: asm2464 down on DPR");
+    advance(12);
+    wr1(HOST, USB4_CS_ADAPTER, 1, 0xa3, 0x0004000e);
+    advance(100);
+    usb4_fabric_reset(fab);
+    rx_flush_hp();
+    advance(700);
+    rx_flush_hp();
+    CHECK(tp_state == USB4_TUNNEL_UP && tp_dev == &asmdev,
+          "preos: asm2464 tunnel up after reset during DPR recovery");
+    CHECK(usb4_router_enumerated(asmdev.router),
+          "preos: asm2464 enumerated after reset during DPR recovery");
+    usb4_fabric_free(fab);
+    fab = saved;
+}
+
+/*
+ * A Thunderbolt 3 device router on a USB4 host (usb4-generic profile),
+ * enumerated the way the Linux software CM did on the Framework 13 with
+ * the TS3 Plus (docs/CAPTURE-VS-LINUX.md ADL-38..ADL-54): power-on
+ * state, plug events and link controller configuration, lane bonding,
+ * the PCIe tunnel through PCIe Up adapter 6, and surprise removal.
+ */
+static USB4Device tb3sw = { .serial = "TB3SW01", .dialect = USB4_DIALECT_TB3,
+                             .lc_captured = true };
+
+/*
+ * Acknowledge every hot plug event received since @mark (n_hpev before
+ * the requests that cause them) and within ~20 ms after.
+ */
+static unsigned collect_hp_from(unsigned mark, HPEv *out, unsigned max)
+{
+    unsigned n = 0;
+
+    for (int t = 0; t < 20; t++) {
+        rx_flush_hp();
+        for (unsigned i = mark; i < n_hpev; i++) {
+            HPEv *e = &hpev[i % 64];
+
+            hp_ack(e->route, e->adp, e->unplug);
+            if (n < max) {
+                out[n++] = *e;
+            }
+        }
+        n_hpev = mark;
+        advance(1);
+    }
+    return n;
+}
+
+#define collect_hp(ev, max) collect_hp_from(n_hpev, ev, max)
+
+static bool saw_hp(const HPEv *ev, unsigned n, uint64_t route, unsigned adp,
+                   bool unplug)
+{
+    for (unsigned i = 0; i < n; i++) {
+        if (ev[i].route == route && ev[i].adp == adp &&
+            ev[i].unplug == unplug) {
+            return true;
+        }
+    }
+    return false;
+}
+
+/* Capability @id in an adapter's chain (Guide 3.2.2), 0: none */
+static unsigned adp_cap(uint64_t route, unsigned adp, unsigned id)
+{
+    unsigned ptr = rd1(route, USB4_CS_ADAPTER, adp, 1) & 0xff;
+
+    for (int n = 0; ptr && n < 16; n++) {
+        uint32_t h = rd1(route, USB4_CS_ADAPTER, adp, ptr);
+
+        if (((h >> 8) & 0xff) == id) {
+            return ptr;
+        }
+        ptr = h & 0xff;
+    }
+    return 0;
+}
+
+/* Router VSE capability @vsec as Linux switch.c tb_switch_find_vse_cap */
+static unsigned tb3_vsec(uint64_t route, unsigned vsec)
+{
+    unsigned ptr = rd1(route, USB4_CS_ROUTER, 0, 1) & 0xff;
+
+    for (int n = 0; ptr && n < 16; n++) {
+        uint32_t h = rd1(route, USB4_CS_ROUTER, 0, ptr);
+        bool lng = !(h & 0xff) && !(h >> 24);
+
+        if (((h >> 8) & 0xff) == 5 && ((h >> 16) & 0xff) == vsec) {
+            return ptr;
+        }
+        ptr = lng ? rd1(route, USB4_CS_ROUTER, 0, ptr + 1) & 0xffff
+                  : h & 0xff;
+    }
+    return 0;
+}
+
+static void test_tb3_sw_model(USB4HostModel model, uint16_t rvid,
+                              uint16_t rdid)
+{
+    USB4FabricConfig cfg = {
+        .profile = USB4_PROFILE_USB4_GENERIC, .dialect = USB4_DIALECT_USB4,
+        .router_vendor_id = rvid, .router_device_id = rdid,
+        .num_usb4_ports = 2, .host_model = model,
+    };
+    static const uint32_t lc_uuid[4] = {
+        0x000003c6, 0x18879000, 0x30efca23, 0x26d04222,
+    };
+    USB4Fabric *saved = fab;
+    unsigned hlane, hport, hpd = 0, hpcie, pe, lc, n, mark;
+    uint32_t v[8], data[17], cs26;
+    HPEv ev[16];
+    Error *err = NULL;
+    USB4Router *r;
+
+    fab = usb4_fabric_new((USB4Host *)&fake_host, &cfg);
+    rx_flush_hp();
+    enumerate_router(HOST, 0);
+    collect_hp(ev, ARRAY_SIZE(ev));
+    CHECK(rd1(HOST, USB4_CS_ROUTER, 0, 0) == (rvid | (uint32_t)rdid << 16),
+          "model %d host router ID %08x", model,
+          rd1(HOST, USB4_CS_ROUTER, 0, 0));
+
+    /* (i) PCIe Downstream Entry Mapping: intel-adl has no observed answer */
+    memset(data, 0, sizeof(data));
+    data[16] = 0x30 | (1u << 31);       /* Opcode, Operation Valid */
+    CHECK(wr(HOST, USB4_CS_ROUTER, 0, 26, 1, &data[16]) == 0, "op 0x30");
+    advance(2);                         /* intel-adl completes after 1 ms */
+    cs26 = rd1(HOST, USB4_CS_ROUTER, 0, 26);
+    CHECK(!(cs26 & (1u << 31)), "op 0x30 completed");
+    CHECK(!!(cs26 & (1u << 30)) == (model == USB4_HOST_MODEL_INTEL_ADL),
+          "model %d: op 0x30 not supported only on intel-adl (%08x)", model,
+          cs26);
+
+    tp_calls = 0;
+    tp_state = USB4_TUNNEL_DOWN;
+    CHECK(usb4_fabric_attach(fab, 1, &tb3sw, &err), "attach tb3 on usb4");
+    r = tb3sw.router;
+    CHECK(r && r->dialect == USB4_DIALECT_TB3 && usb4_router_tb3_sw_cm(r),
+          "tb3 router under a software CM");
+    n = collect_hp(ev, ARRAY_SIZE(ev));
+    CHECK(saw_hp(ev, n, HOST, 1, false) && saw_hp(ev, n, HOST, 2, false),
+          "host lane plug events");
+
+    /* Host side: TBT3-Compatible Mode on the USB4 port (observed 0x3301) */
+    hlane = adp_cap(HOST, 1, USB4_CAP_LANE);
+    hport = adp_cap(HOST, 1, USB4_CAP_PORT);
+    CHECK(hlane && hport, "host lane and port capabilities");
+    v[0] = rd1(HOST, USB4_CS_ADAPTER, 1, hport + 18);
+    CHECK((v[0] & (1u << 9)) && (v[0] & 0xff) == 0x01 &&
+          !(v[0] & (1u << 10 | 1u << 20)) && (v[0] & (1u << 13)),
+          "model %d PORT_CS_18 %08x", model, v[0]);
+    if (model == USB4_HOST_MODEL_INTEL_ADL) {
+        CHECK(v[0] == 0x00003301, "intel-adl PORT_CS_18 as captured %08x",
+              v[0]);
+        CHECK(((rd1(HOST, USB4_CS_ADAPTER, 1, 4) >> 20) & 0x3ff) == 60,
+              "intel-adl: 60 buffers before bonding with a TB3 partner");
+    }
+    rmw(HOST, USB4_CS_ADAPTER, 1, 4, 1u << 31, 0);        /* clear Lock */
+
+    /* Power-on state as the Framework capture shows it */
+    CHECK(rd(DEV1, USB4_CS_ROUTER, 0, 0, 5, v) == 0, "tb3 DW0-4");
+    CHECK(v[0] == 0x15d38086 && v[1] == 0x0602c005 && v[2] == 0 &&
+          v[3] == 0 && v[4] == 0x0200000a,
+          "power-on header %08x %08x %08x %08x %08x", v[0], v[1], v[2],
+          v[3], v[4]);
+    pe = tb3_vsec(DEV1, 1);
+    lc = tb3_vsec(DEV1, 6);
+    CHECK(pe == 0x28 && lc == 0xff, "plug events 0x%x, LC 0x%x", pe, lc);
+
+    /* switch.c tb_switch_configure: DW1-4 */
+    v[0] = 0x0612c105;
+    v[1] = 1;
+    v[2] = 1u << 31;
+    v[3] = 0x020000ff;
+    mark = n_hpev;
+    CHECK(wr(DEV1, USB4_CS_ROUTER, 0, 1, 4, v) == 0, "configure");
+    CHECK(rd(DEV1, USB4_CS_ROUTER, 0, 1, 4, v) == 0 && v[0] == 0x0612c105 &&
+          v[1] == 1 && v[2] == 0x80000000 && v[3] == 0x020000ff,
+          "configured %08x %08x %08x %08x", v[0], v[1], v[2], v[3]);
+    n = collect_hp_from(mark, ev, ARRAY_SIZE(ev));
+    CHECK(n == 3 && saw_hp(ev, n, DEV1, 9, false) &&
+          saw_hp(ev, n, DEV1, 2, false) && saw_hp(ev, n, DEV1, 10, false),
+          "plug events 9, 2, 10 after configuration (%u)", n);
+
+    /* tb_plug_events_active(sw, true) */
+    v[0] = rd1(DEV1, USB4_CS_ROUTER, 0, pe + 1);
+    CHECK(v[0] == 0x4e05, "plug events power-on %08x", v[0]);
+    wr1(DEV1, USB4_CS_ROUTER, 0, pe + 1, v[0] & 0xffffff83);
+    CHECK(rd1(DEV1, USB4_CS_ROUTER, 0, pe + 1) == 0x4e01, "plug events on");
+
+    /* lc.c: UUID, descriptor, SX_CTRL of both port blocks */
+    CHECK(rd(DEV1, USB4_CS_ROUTER, 0, lc + 3, 4, v) == 0 &&
+          !memcmp(v, lc_uuid, sizeof(lc_uuid)), "link controller UUID");
+    CHECK(rd1(DEV1, USB4_CS_ROUTER, 0, lc + 2) == 0x01001402, "LC desc");
+    CHECK(rd1(DEV1, USB4_CS_ROUTER, 0, 0x1a9) == 0x160 &&
+          rd1(DEV1, USB4_CS_ROUTER, 0, 0x2a9) == 0x160, "SX_CTRL power-on");
+    CHECK(rd1(DEV1, USB4_CS_ROUTER, 0, 0x23d) == 0x02c00010,
+          "port 3 LC CS_42: no USB plugged (ADL-52)");
+    CHECK(rd(DEV1, USB4_CS_ROUTER, 0, 0x1ed, 1, v) == (0x100 | USB4_ERR_ADDR),
+          "gap 0x1ed not accessible");
+    CHECK(rd(DEV1, USB4_CS_ROUTER, 0, 0x1e8, 8, v) ==
+          (0x100 | USB4_ERR_ADDR), "read across the gap fails");
+    CHECK(rd(DEV1, USB4_CS_ROUTER, 0, 0x2ed, 1, v) == (0x100 | USB4_ERR_ADDR),
+          "0x2ed not accessible");
+
+    /* Adapters before bonding */
+    CHECK(rd1(DEV1, USB4_CS_ADAPTER, 1, 0x37) == 0x0814001c &&
+          rd1(DEV1, USB4_CS_ADAPTER, 1, 4) == 0x03c00000 &&
+          rd1(DEV1, USB4_CS_ADAPTER, 2, 4) == 0x03c00000 &&
+          (rd1(DEV1, USB4_CS_ADAPTER, 1, 3) & 0xff) == 0x3c,
+          "single lanes %08x", rd1(DEV1, USB4_CS_ADAPTER, 1, 0x37));
+    CHECK(rd1(DEV1, USB4_CS_ADAPTER, 6, 0x39) == 0x012e0400,
+          "PCIe Up at power-on %08x", rd1(DEV1, USB4_CS_ADAPTER, 6, 0x39));
+    CHECK(rd1(DEV1, USB4_CS_ADAPTER, 6, 2) == 0x01100102, "PCIe Up type");
+
+    /* switch.c tb_switch_lane_bonding_enable (ADL-44, ADL-46) */
+    rmw(DEV1, USB4_CS_ADAPTER, 1, 0x37, 0, 0x30);
+    rmw(DEV1, USB4_CS_ADAPTER, 2, 0x37, 0, 0x30);
+    CHECK(rd1(DEV1, USB4_CS_ADAPTER, 1, 0x37) == 0x0814003c, "target x2");
+    rmw(HOST, USB4_CS_ADAPTER, 1, hlane + 1, 0, 3u << 4);
+    rmw(HOST, USB4_CS_ADAPTER, 2, adp_cap(HOST, 2, USB4_CAP_LANE) + 1, 0,
+        3u << 4);
+    mark = n_hpev;
+    rmw(HOST, USB4_CS_ADAPTER, 1, hlane + 1, 0, 1u << 15);
+    n = collect_hp_from(mark, ev, ARRAY_SIZE(ev));
+    CHECK(saw_hp(ev, n, HOST, 2, true) && saw_hp(ev, n, DEV1, 2, true),
+          "lane 1 unplug on both ends after bonding (%u events)", n);
+    CHECK(((rd1(HOST, USB4_CS_ADAPTER, 1, hlane + 1) >> 20) & 0x3f) == 2,
+          "host x2");
+    CHECK(rd1(DEV1, USB4_CS_ADAPTER, 1, 0x37) == 0x0824003c &&
+          rd1(DEV1, USB4_CS_ADAPTER, 1, 4) == 0x07800000 &&
+          rd1(DEV1, USB4_CS_ADAPTER, 2, 4) == 0 &&
+          (rd1(DEV1, USB4_CS_ADAPTER, 1, 3) & 0xff) == 0x78, "bonded lanes");
+    if (model == USB4_HOST_MODEL_INTEL_ADL) {
+        CHECK(((rd1(HOST, USB4_CS_ADAPTER, 1, 4) >> 20) & 0x3ff) == 120,
+              "intel-adl: 120 buffers once bonded");
+    }
+
+    /* tb_switch_configure_link: SX_CTRL L1C | UPSTREAM (ADL-43) */
+    rmw(DEV1, USB4_CS_ROUTER, 0, 0x1a9, 0, (1u << 16) | (1u << 30));
+    CHECK(rd1(DEV1, USB4_CS_ROUTER, 0, 0x1a9) == 0x40010160,
+          "SX_CTRL configured");
+    rmw(HOST, USB4_CS_ADAPTER, 1, hport + 19, 0, 1u << 2);    /* PC */
+
+    /* PCIe tunnel (ADL-50, ADL-51) */
+    for (unsigned a = 1; a <= r->fabric->hr->max_adapter && !hpd; a++) {
+        if (rd(HOST, USB4_CS_ADAPTER, a, 2, 1, v) == 0 &&
+            (v[0] & 0xffffff) == 0x100101) {
+            hpd = a;
+        }
+    }
+    hpcie = hpd ? adp_cap(HOST, hpd, USB4_CAP_PROTO) : 0;
+    CHECK(hpd && hpcie, "host PCIe Down adapter %u cap 0x%x", hpd, hpcie);
+    program_path(HOST, hpd, 8, 1, 8, 0, false);
+    program_path(DEV1, 1, 8, 6, 8, 32, true);
+    program_path(DEV1, 6, 8, 1, 8, 0, false);
+    program_path(HOST, 1, 8, hpd, 8, 64, true);
+    rmw(DEV1, USB4_CS_ADAPTER, 6, 0x39, 0, 1u << 31);
+    CHECK(tp_state == USB4_TUNNEL_DOWN, "down with one Path Enable");
+    rmw(HOST, USB4_CS_ADAPTER, hpd, hpcie, 0, 1u << 31);
+    CHECK(tp_state == USB4_TUNNEL_UP && tp_dev == &tb3sw,
+          "model %d: PCIe tunnel to the TB3 router", model);
+    CHECK(rd1(DEV1, USB4_CS_ADAPTER, 6, 0x39) == 0xc6210400,
+          "PCIe Up with the tunnel up");
+    rmw(HOST, USB4_CS_ADAPTER, hpd, hpcie, 1u << 31, 0);
+    CHECK(tp_state == USB4_TUNNEL_DOWN &&
+          tp_reason == USB4_TUNNEL_REASON_ADMIN_DOWN, "admin down");
+    CHECK(rd1(DEV1, USB4_CS_ADAPTER, 6, 0x39) == 0x81260400 &&
+          rd1(DEV1, USB4_CS_ADAPTER, 7, 0x39) == 0x01260400,
+          "PCIe adapters out of reset once trained (%08x)",
+          rd1(DEV1, USB4_CS_ADAPTER, 6, 0x39));
+    rmw(HOST, USB4_CS_ADAPTER, hpd, hpcie, 0, 1u << 31);
+    CHECK(tp_state == USB4_TUNNEL_UP, "up again");
+
+    /* Unplug (ADL-54) */
+    usb4_fabric_detach(fab, 1);
+    CHECK(tp_state == USB4_TUNNEL_DOWN &&
+          tp_reason == USB4_TUNNEL_REASON_SURPRISE, "surprise removal");
+    collect_hp(ev, ARRAY_SIZE(ev));
+    CHECK(rd(DEV1, USB4_CS_ROUTER, 0, 0, 1, v) == (0x100 | USB4_ERR_CONN),
+          "gone");
+
+    /* A second session starts from power-on again, own uid */
+    tb3sw.uid = 0x1122334455667788ULL;
+    CHECK(usb4_fabric_attach(fab, 1, &tb3sw, &err), "re-attach");
+    collect_hp(ev, ARRAY_SIZE(ev));
+    rmw(HOST, USB4_CS_ADAPTER, 1, 4, 1u << 31, 0);
+    CHECK(rd1(DEV1, USB4_CS_ROUTER, 0, 1) == 0x0602c005 &&
+          rd1(DEV1, USB4_CS_ROUTER, 0, 0x1a9) == 0x160 &&
+          rd1(DEV1, USB4_CS_ROUTER, 0, 0x29) == 0x4e05, "power-on again");
+    CHECK(rd(DEV1, USB4_CS_ROUTER, 0, lc + 3, 4, v) == 0 &&
+          v[0] == 0x55667788 && v[1] == 0x11223344 && v[2] == lc_uuid[2],
+          "uid replaces LC UUID dwords 0-1");
+    usb4_fabric_detach(fab, 1);
+    tb3sw.uid = 0;
+    rx_flush_hp();
+    usb4_fabric_free(fab);
+    fab = saved;
+}
+
+/* Bond host port 1 with the TB3 router at DEV1 (switch.c lane bonding) */
+static void tb3_bond(void)
+{
+    rmw(DEV1, USB4_CS_ADAPTER, 1, 0x37, 0, 0x30);
+    rmw(DEV1, USB4_CS_ADAPTER, 2, 0x37, 0, 0x30);
+    rmw(HOST, USB4_CS_ADAPTER, 1, USB4_ADP_CAP_LANE + 1, 0, 3u << 4);
+    rmw(HOST, USB4_CS_ADAPTER, 2, USB4_ADP_CAP_LANE + 1, 0, 3u << 4);
+    rmw(HOST, USB4_CS_ADAPTER, 1, USB4_ADP_CAP_LANE + 1, 0, 1u << 15);
+}
+
+/*
+ * Attach @d at port 1, unlock, write Plug Events + 1 = @pe, then
+ * configure it; returns the hot plug events seen in @ev.
+ */
+static unsigned tb3_configure_with_pe(USB4Device *d, uint32_t pe, HPEv *ev,
+                                      unsigned max)
+{
+    uint32_t v[4] = { 0x0612c105, 1, 1u << 31, 0x020000ff };
+    unsigned mark;
+
+    CHECK(usb4_fabric_attach(fab, 1, d, NULL), "attach");
+    collect_hp(ev, max);
+    rmw(HOST, USB4_CS_ADAPTER, 1, 4, 1u << 31, 0);
+    wr1(DEV1, USB4_CS_ROUTER, 0, 0x29, pe);
+    mark = n_hpev;
+    CHECK(wr(DEV1, USB4_CS_ROUTER, 0, 1, 4, v) == 0, "configure");
+    return collect_hp_from(mark, ev, max);
+}
+
+/*
+ * Plug Events dword 1 disables (Linux tb_regs.h TB_PLUG_EVENTS_*): bit 3
+ * lane adapter events, bit 4 DP OUT events; clearing them enables again.
+ * And the link controller UUID: derived per device by default, the
+ * captured one with lc-uuid=captured.
+ */
+static USB4Device tb3a = { .serial = "TB3A", .dialect = USB4_DIALECT_TB3 };
+static USB4Device tb3b = { .serial = "TB3B", .dialect = USB4_DIALECT_TB3 };
+
+static void test_tb3_sw_events_uuid(void)
+{
+    USB4FabricConfig cfg = {
+        .profile = USB4_PROFILE_USB4_GENERIC, .dialect = USB4_DIALECT_USB4,
+        .router_vendor_id = 0x1234, .router_device_id = 0x5678,
+        .num_usb4_ports = 2,
+    };
+    USB4Fabric *saved = fab;
+    uint32_t ua[4], ub[4], ua2[4];
+    HPEv ev[16];
+    unsigned n, mark;
+
+    fab = usb4_fabric_new((USB4Host *)&fake_host, &cfg);
+    rx_flush_hp();
+    enumerate_router(HOST, 0);
+    collect_hp(ev, ARRAY_SIZE(ev));
+
+    /* Lane and DP OUT events disabled: nothing from the TB3 router */
+    n = tb3_configure_with_pe(&tb3a, 0x4e19, ev, ARRAY_SIZE(ev));
+    CHECK(n == 0, "lane and DP OUT events disabled: %u events", n);
+    mark = n_hpev;
+    tb3_bond();
+    n = collect_hp_from(mark, ev, ARRAY_SIZE(ev));
+    CHECK(saw_hp(ev, n, HOST, 2, true) && !saw_hp(ev, n, DEV1, 2, true),
+          "bonding: host lane 1 unplug only (%u events)", n);
+    usb4_fabric_detach(fab, 1);
+    collect_hp(ev, ARRAY_SIZE(ev));
+
+    /* DP OUT only disabled: lane 1 plug comes, 9 and 10 do not */
+    n = tb3_configure_with_pe(&tb3a, 0x4e15, ev, ARRAY_SIZE(ev));
+    CHECK(n == 1 && saw_hp(ev, n, DEV1, 2, false),
+          "DP OUT events disabled: %u events", n);
+    usb4_fabric_detach(fab, 1);
+    collect_hp(ev, ARRAY_SIZE(ev));
+
+    /* Lane events disabled at configuration, enabled again before bonding */
+    n = tb3_configure_with_pe(&tb3a, 0x4e0d, ev, ARRAY_SIZE(ev));
+    CHECK(n == 2 && saw_hp(ev, n, DEV1, 9, false) &&
+          saw_hp(ev, n, DEV1, 10, false) && !saw_hp(ev, n, DEV1, 2, false),
+          "lane events disabled: %u events", n);
+    wr1(DEV1, USB4_CS_ROUTER, 0, 0x29, 0x4e01);
+    mark = n_hpev;
+    tb3_bond();
+    n = collect_hp_from(mark, ev, ARRAY_SIZE(ev));
+    CHECK(saw_hp(ev, n, DEV1, 2, true),
+          "lane events enabled again: lane 1 unplug after bonding");
+
+    /* Link controller UUIDs of two default docks: distinct, stable */
+    CHECK(rd(DEV1, USB4_CS_ROUTER, 0, 0x102, 4, ua) == 0, "UUID a");
+    CHECK(usb4_fabric_attach(fab, 2, &tb3b, NULL), "attach b");
+    collect_hp(ev, ARRAY_SIZE(ev));
+    rmw(HOST, USB4_CS_ADAPTER, 3, 4, 1u << 31, 0);
+    CHECK(rd(3, USB4_CS_ROUTER, 0, 0x102, 4, ub) == 0, "UUID b");
+    CHECK(memcmp(ua, ub, sizeof(ua)), "two docks, two link controller UUIDs");
+    CHECK(ua[0] != 0x000003c6 && ub[0] != 0x000003c6 &&
+          ua[0] != (uint32_t)((USB4Router *)tb3a.router)->uuid,
+          "derived, neither captured nor the DROM UID");
+    usb4_fabric_detach(fab, 1);
+    collect_hp(ev, ARRAY_SIZE(ev));
+    CHECK(usb4_fabric_attach(fab, 1, &tb3a, NULL), "re-attach a");
+    collect_hp(ev, ARRAY_SIZE(ev));
+    rmw(HOST, USB4_CS_ADAPTER, 1, 4, 1u << 31, 0);
+    CHECK(rd(DEV1, USB4_CS_ROUTER, 0, 0x102, 4, ua2) == 0 &&
+          !memcmp(ua, ua2, sizeof(ua)), "stable across a re-plug");
+    usb4_fabric_detach(fab, 1);
+    collect_hp(ev, ARRAY_SIZE(ev));
+    tb3a.lc_captured = true;
+    CHECK(usb4_fabric_attach(fab, 1, &tb3a, NULL), "attach a captured");
+    collect_hp(ev, ARRAY_SIZE(ev));
+    rmw(HOST, USB4_CS_ADAPTER, 1, 4, 1u << 31, 0);
+    CHECK(rd(DEV1, USB4_CS_ROUTER, 0, 0x102, 4, ua2) == 0 &&
+          ua2[0] == 0x000003c6 && ua2[1] == 0x18879000 &&
+          ua2[2] == 0x30efca23 && ua2[3] == 0x26d04222,
+          "lc-uuid=captured");
+    tb3a.lc_captured = false;
+    usb4_fabric_detach(fab, 1);
+    usb4_fabric_detach(fab, 2);
+    rx_flush_hp();
+    usb4_fabric_free(fab);
+    fab = saved;
+}
+
+static void test_tb3_sw(void)
+{
+    test_tb3_sw_model(USB4_HOST_MODEL_MINIMAL, 0x1234, 0x5678);
+    test_tb3_sw_model(USB4_HOST_MODEL_INTEL_ADL, 0x8087, 0x463e);
+    test_tb3_sw_model(USB4_HOST_MODEL_AMD, 0x0438, 0x0208);
+    test_tb3_sw_events_uuid();
+}
+
+int main(int argc, char **argv)
+{
+    USB4FabricConfig cfg = {
+        .profile = USB4_PROFILE_USB4_GENERIC, .dialect = USB4_DIALECT_USB4,
+        .router_vendor_id = 0x1234, .router_device_id = 0x5678,
+        .num_usb4_ports = 2,
+    };
+
+    usb4_test_trace = getenv("USB4_TRACE") != NULL;
+    test_crc();
+    test_evaluator();
+    test_drom_long_names();
+    fab = usb4_fabric_new((USB4Host *)&fake_host, &cfg);
+    test_host_router();
+    test_device();
+    test_boot_attached();
+    test_chain();
+    usb4_fabric_free(fab);
+    test_tb3();
+    test_tb3_sw();
+    test_preos();
+    test_adl_sideband();
+    test_asm4242();
+    test_asm2464();
+
+    printf("%d checks, %d failures\n", checks, failures);
+    return failures ? 1 : 0;
+}
+#endif /* FABRIC_TEST_NO_MAIN */
diff --git a/tests/usb4/gen-adl-data.py b/tests/usb4/gen-adl-data.py
