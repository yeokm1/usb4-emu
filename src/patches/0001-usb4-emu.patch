+static void test_rx_exhaustion(void)
+{
+    T *t = t_start("pc", NULL);
+    unsigned i;
+
+    rings_setup(t, 8, 8);
+    rx_post(t, 2);
+    for (i = 0; i < 5; i++) {
+        tx_queue(t, 0x100 * (i + 1), 12, 1);
+    }
+    tx_doorbell(t);
+    /* All TX done, only two RX descriptors used, rest held in the FIFO */
+    g_assert_cmpuint(tx_ci(t), ==, 5);
+    g_assert_cmpuint(rx_pi(t), ==, 2);
+    rx_expect(t, 0x100, 12, 1);
+    rx_expect(t, 0x200, 12, 1);
+    /* Refill: the queued frames arrive in order */
+    rx_post(t, 2);
+    g_assert_cmpuint(rx_pi(t), ==, 4);
+    rx_post(t, 3);
+    g_assert_cmpuint(rx_pi(t), ==, 5);
+    rx_expect(t, 0x300, 12, 1);
+    rx_expect(t, 0x400, 12, 1);
+    rx_expect(t, 0x500, 12, 1);
+    /* Descriptor 5 and 6 are posted but unused */
+    g_assert_cmphex(desc_dw2(t, t->rx_ring, 5) & DESC_DD, ==, 0);
+    t_stop(t);
+}
