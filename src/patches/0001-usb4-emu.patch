+static void test_intx(void)
+{
+    T *t = t_start("pc", NULL);
+    QPCIDevice *piix = qpci_device_find(t->bus, QPCI_DEVFN(1, 0));
+
+    /* Slot 4 INTA# -> PIRQD on PIIX3 (pc_pci_slot_get_pirq); -> IRQ 11 */
+    qpci_config_writeb(piix, 0x63, 11);
+    g_free(piix);
+    qtest_irq_intercept_in(t->qts, "ioapic");
+
+    rings_setup(t, 8, 8);
+    rx_post(t, 4);
+    /* Masked: status set, line stays low */
+    tx_queue(t, 1, 8, 1);
+    tx_doorbell(t);
+    g_assert(!qtest_get_irq(t->qts, 11));
+    g_assert_cmphex(isr0(t), ==, CAUSE_TX0 | CAUSE_RX0);
+    /* Unmask RX0 */
+    wr(t, IMS0, CAUSE_RX0);
+    g_assert_cmphex(rd(t, IMR0), ==, CAUSE_RX0);
+    tx_queue(t, 2, 8, 1);
+    tx_doorbell(t);
+    g_assert(qtest_get_irq(t->qts, 11));
+    /* Level: stays asserted until status is cleared (read-to-clear) */
+    g_assert(qtest_get_irq(t->qts, 11));
+    g_assert_cmphex(isr0(t), ==, CAUSE_TX0 | CAUSE_RX0);
+    g_assert(!qtest_get_irq(t->qts, 11));
+    /* No-auto-clear mode: ISC deasserts */
+    wr(t, HI_CONTROL, DISABLE_ISR_AUTOCLR);
+    tx_queue(t, 3, 8, 1);
+    tx_doorbell(t);
+    g_assert(qtest_get_irq(t->qts, 11));
+    isr0(t);
+    g_assert(qtest_get_irq(t->qts, 11));
+    wr(t, ISC0, CAUSE_RX0);
+    g_assert(!qtest_get_irq(t->qts, 11));
+    /* Unmasking a pending cause asserts; masking deasserts */
+    wr(t, ISS0, CAUSE_TX0);
+    g_assert(!qtest_get_irq(t->qts, 11));
+    wr(t, IMS0, CAUSE_TX0);
+    g_assert(qtest_get_irq(t->qts, 11));
+    wr(t, IMC0, CAUSE_TX0);
+    g_assert(!qtest_get_irq(t->qts, 11));
+    t_stop(t);
+}
