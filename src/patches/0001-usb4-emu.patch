+/*
+ * usb-fallback (R33): UAS by default on every machine type, i440FX
+ * included (xhci98 has a UAS driver for Windows 98 to 7); bot is QEMU's
+ * Bulk-Only usb-storage, an opt-in for guests without a UAS driver;
+ * anything else is refused.
+ */
+static void test_usb_fallback_bot(void)
+{
+    T *t = t_start_dev(",xhci=tbx,usb-fallback=bot", ORICO_DEV, TB_XHCI);
+    g_autofree char *type = NULL;
+    QTestState *qts;
+    QDict *rsp;
+
+    g_assert_true(usb_fallback_on_xhci(t->qts));
+    type = qom_type(t->qts, USB_FB);
+    g_assert_cmpstr(type, ==, "usb-storage");
+    qtest_qmp_device_del_send(t->qts, "d0");
+    g_assert_false(usb_fallback_on_xhci(t->qts));
+    check_drive_kept(t->qts);
+    t_stop(t);
+
+    /*
+     * i440FX default: UAS, behind the TB xHCI on conventional PCI. The
+     * xHCI has INTx (pin A), used whenever MSI and MSI-X are off.
+     */
+    qts = pc_fallback_start("");
+    check_uas_identity(qts);
+    qtest_outl(qts, 0xcf8, 0x80000000u | (6 << 11) | PCI_INTERRUPT_LINE);
+    g_assert_cmphex((qtest_inl(qts, 0xcfc) >> 8) & 0xff, ==, 1);
+    qtest_qmp_device_del_send(qts, "d0");
+    g_assert_false(usb_fallback_on_xhci(qts));
+    check_drive_kept(qts);
+    qtest_quit(qts);
+
+    /* i440FX with explicit bot */
+    qts = pc_fallback_start(",usb-fallback=bot");
+    g_free(type);
+    type = qom_type(qts, USB_FB);
+    g_assert_cmpstr(type, ==, "usb-storage");
+    rsp = qtest_qmp(qts, "{'execute': 'device_add', 'arguments': "
+                    "{'driver': 'usb4-host', 'bus': 'pci.0', 'id': 'u5', "
+                    "'profile': 'tb3-alpine-ridge', "
+                    "'usb-fallback': 'nope'}}");
+    g_assert_true(qdict_haskey(rsp, "error"));
+    g_assert_nonnull(strstr(qdict_get_str(qdict_get_qdict(rsp, "error"),
+                                          "desc"), "usb-fallback"));
+    qobject_unref(rsp);
+    /* validated on every profile, and refused where nothing falls back */
+    rsp = qtest_qmp(qts, "{'execute': 'device_add', 'arguments': "
+                    "{'driver': 'usb4-host', 'bus': 'pci.0', 'id': 'u5', "
+                    "'profile': 'usb4-generic', 'usb-fallback': 'nope'}}");
+    g_assert_true(qdict_haskey(rsp, "error"));
+    g_assert_nonnull(strstr(qdict_get_str(qdict_get_qdict(rsp, "error"),
+                                          "desc"), "uas or bot"));
+    qobject_unref(rsp);
+    rsp = qtest_qmp(qts, "{'execute': 'device_add', 'arguments': "
+                    "{'driver': 'usb4-host', 'bus': 'pci.0', 'id': 'u5', "
+                    "'profile': 'usb4-generic', 'usb-fallback': 'uas'}}");
+    g_assert_true(qdict_haskey(rsp, "error"));
+    g_assert_nonnull(strstr(qdict_get_str(qdict_get_qdict(rsp, "error"),
+                                          "desc"), "TB3 profile"));
+    qobject_unref(rsp);
+    qtest_quit(qts);
+}
