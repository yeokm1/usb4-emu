+/*
+ * Hook 3, case (i): close and reopen without the endpoint reset; the
+ * delayed transfer is held through the CC.EN=0 write and released only
+ * when the driver has seen RDY=0.
+ */
+static void test_reopen_rdy0_ack(void)
+{
+    g_autofree char *img = make_img();
+    Nv nv;
+    QTestState *qts = tp_start(img, ",x-faults=\"at=fetch op=read act=hold "
+                               "release=rdy0-ack\"", "", &nv);
+
+    nv_bringup(&nv);
+    qtest_memset(qts, RAM_BUF, SENTINEL, 512);
+    nv_read(&nv, 1, 0, RAM_BUF);
+    g_assert(!nv_poll(&nv, 1, -1, NULL, NULL, 50));
+
+    qom_set_str(qts, TP_PATH, "x-gate", "closed");
+    g_assert_cmpuint(wait_stage(qts, "harness-gated"), ==, 1);
+    g_assert(str_has(qts, TP_PATH, "endpoint", "live gen=1 gate=closed"));
+    g_assert_cmphex(nv_csts(&nv), ==, 0xffffffff);
+    qom_set_str(qts, TP_PATH, "x-gate", "normal");
+    wait_stage(qts, "harness-reopened");
+
+    /* The first read after reopen shows the old controller (violation). */
+    g_assert_cmphex(qtest_readl(qts, WIN_MEM + NVME_CC), ==, NVME_CC_ON);
+    g_assert_cmphex(nv_csts(&nv), ==, 1);
+    g_assert(buf_is(qts, RAM_BUF, SENTINEL));
+
+    /* CC.EN=0: deferred while the command is held. */
+    qtest_writel(qts, WIN_MEM + NVME_CC, NVME_CC_ON & ~1);
+    g_assert(str_has(qts, TP_PATH, "x-harness-state", "defer=pending"));
+    g_assert(buf_is(qts, RAM_BUF, SENTINEL));
+    g_assert_cmphex(qtest_readl(qts, WIN_MEM + NVME_CC), ==,
+                    NVME_CC_ON & ~1);
+    /* This read is the acknowledgement: RDY=0. */
+    g_assert_cmphex(nv_csts(&nv) & 1, ==, 0);
+    /* Then the transfer lands and the disable takes effect. */
+    g_assert(wait_buf(qts, RAM_BUF, PATTERN));
+    for (int i = 0; i < 2000 &&
+         !str_has(qts, TP_PATH, "x-harness-state", "defer=no"); i++) {
+        g_usleep(1000);
+    }
+    g_assert(str_has(qts, TP_PATH, "x-harness-state", "held=0"));
+    g_assert(str_has(qts, TP_PATH, "x-harness-state", "defer=no"));
+    /* The controller saw the disable now (QEMU's reset clears all of CC). */
+    g_assert_cmphex(qtest_readl(qts, WIN_MEM + NVME_CC) & 1, ==, 0);
+    g_assert_cmphex(nv_csts(&nv), ==, 0);
+    qtest_quit(qts);
+    unlink(img);
+}
