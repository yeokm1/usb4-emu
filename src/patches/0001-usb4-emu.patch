+/*
+ * R32 with BIOS Assist (ICM-PROTOCOL.md 13.4): the last device leaves;
+ * the controller powers off power-off-delay-ms later (registers
+ * all-ones, the root port still there) and the platform removes it
+ * removal-notify-ms after that (15.4 s in all on the P14s). A plug
+ * powers it up as a fresh arrival.
+ */
+static void test_r32_timing(void)
+{
+    QTestState *qts = start(",root-hotplug=acpi",
+                            ",bios-assist=on,power-off-delay-ms=11000",
+                            true);
+
+    configure(qts);
+    gpe_take(qts);
+    qtest_qmp_device_del_send(qts, "d0");
+    qtest_clock_step(qts, SEC(10.9));
+    g_assert_true(nhi_alive(qts));
+    qtest_clock_step(qts, SEC(0.2));
+    g_assert_false(nhi_alive(qts));
+    g_assert_true(root_visible(qts));
+    qtest_clock_step(qts, SEC(4.2));       /* 15.3 s */
+    g_assert_true(root_visible(qts));
+    g_assert_false(gpe_take(qts));
+    qtest_clock_step(qts, SEC(0.2));       /* 15.5 s */
+    g_assert_true(gpe_take(qts));
+    g_assert_cmphex(pcihp_rd(qts, PCIHP_UP) & SLOT_BIT, ==, SLOT_BIT);
+
+    /* re-plug: powered up, the tree arrives fresh */
+    qtest_qmp_device_add(qts, "usb4-device", "d0",
+                         "{'bus': 'u4.0', 'port': 1, 'dialect': 'tb3', "
+                         "'drive': 'disk0'}");
+    qtest_clock_step(qts, SEC(0.01));
+    g_assert_true(root_visible(qts));
+    g_assert_true(gpe_take(qts));
+    g_assert_cmphex(cfg_rd(qts, 1, 0x08, 0x18), ==, 0);
+    configure(qts);
+    qtest_quit(qts);
+}
+
+/*
+ * Generation check: a plug between the power-off and the removal
+ * notification brings the tree back; the stale notification must not
+ * remove it afterwards.
+ */
+static void test_r32_replug_before_removal(void)
+{
+    QTestState *qts = start(",root-hotplug=acpi,removal-notify-ms=4400",
+                            ",bios-assist=on,power-off-delay-ms=11000",
+                            true);
+
+    configure(qts);
+    qtest_qmp_device_del_send(qts, "d0");
+    qtest_clock_step(qts, SEC(12));
+    g_assert_false(nhi_alive(qts));
+    qtest_qmp_device_add(qts, "usb4-device", "d0",
+                         "{'bus': 'u4.0', 'port': 1, 'dialect': 'tb3', "
+                         "'drive': 'disk0'}");
+    qtest_clock_step(qts, SEC(0.01));
+    gpe_take(qts);
+    qtest_clock_step(qts, SEC(10));
+    g_assert_true(root_visible(qts));
+    g_assert_false(gpe_take(qts));
