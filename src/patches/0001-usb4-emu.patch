+/*
+ * The guest ejects the slot (_EJ0 writes B0EJ): the tree leaves without
+ * being unrealized, the slot reads empty, and the tree comes back with
+ * qom-set present true, the root bridge from reset too.
+ */
+static void test_guest_eject(void)
+{
+    QTestState *qts = start(",root-hotplug=acpi", "", true);
+    QDict *rsp;
+
+    configure(qts);
+    qtest_outl(qts, PCIHP_SEL, 0);
+    qtest_outl(qts, PCIHP_EJ, SLOT_BIT);
+    g_assert_false(nhi_alive(qts));
+    g_assert_false(root_visible(qts));
