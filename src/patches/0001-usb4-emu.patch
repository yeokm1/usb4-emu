@@ -0,0 +1,21 @@
+#!/bin/sh
+# Real device conformance check of the asm2464 device model
+# (docs/captures/ORICO-ASM2464.md): replay domain 1 of the Framework 13 +
+# ORICO AAGM2-U4 capture (tests/captures/framework13-12th/linux-orico/
+# *.tar.gz in the outer repository, extracted, passed as $1 or in
+# ASM_CAPTURE), host router (intel-adl, domain 1) and device router
+# (route 3), and compare every answer. The device router's figures are
+# reported separately. ADL_VERBOSE / ADL_TOP as for
+# run-adl-conformance.sh; ASM_MIN_MATCH=pct fails when the device
+# router's share of matching dwords is below pct.
+#   scripts/msys2-shell.sh ".../tests/usb4/run-asm2464-conformance.sh <dir>"
+# Copyright (c) 2026 usb4-emu contributors. SPDX-License-Identifier: GPL-2.0-only
+set -e
+here="$(cd "$(dirname "$0")" && pwd)"
+cap="${1:-$ASM_CAPTURE}"
+if [ -z "$cap" ]; then
+    echo "usage: $0 <extracted capture dir>" >&2
+    exit 2
+fi
+exec "$here/run-adl-conformance.sh" "$cap" --routes 0,3 --domains 1 \
+    --device-model asm2464
diff --git a/tests/usb4/run-chain-conformance.sh b/tests/usb4/run-chain-conformance.sh
new file mode 100644
index 0000000000000000000000000000000000000000..022a30cdace80d3d1b9fa28e9f0404b994f0441d
--- /dev/null
+++ b/tests/usb4/run-chain-conformance.sh
@@ -0,0 +1,21 @@
+#!/bin/sh
+# Daisy chain conformance check (docs/USB4-HOSTS.md 8): replay domain 1 of
+# the Framework 13 + CalDigit TS3 Plus + ORICO AAGM2-U4 capture
+# (tests/captures/framework13-12th/linux-ts3plus-orico/*.tar.gz in the
+# outer repository, extracted, passed as $1 or in CHAIN_CAPTURE): the
+# host router (intel-adl, route 0), the TB3 dock (dialect=tb3, route 3)
+# and the ASM2464 chained behind it (asm2464, route 303, depth 2), and
+# compare every answer and every hot plug event, per router. ADL_VERBOSE
+# / ADL_TOP as for run-adl-conformance.sh; ASM_MIN_MATCH=pct fails when
+# the device routers' share of matching dwords is below pct.
+#   scripts/msys2-shell.sh ".../tests/usb4/run-chain-conformance.sh <dir>"
+# Copyright (c) 2026 usb4-emu contributors. SPDX-License-Identifier: GPL-2.0-only
+set -e
+here="$(cd "$(dirname "$0")" && pwd)"
+cap="${1:-$CHAIN_CAPTURE}"
+if [ -z "$cap" ]; then
+    echo "usage: $0 <extracted capture dir>" >&2
+    exit 2
+fi
+exec "$here/run-adl-conformance.sh" "$cap" --routes 0,3,303 --domains 1 \
+    --device-model tb3 --chain 303:asm2464
