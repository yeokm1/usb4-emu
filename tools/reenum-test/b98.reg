REGEDIT4

; Mechanism B on Windows 98 SE, installed by hand (no INF needed):
; reenum.sys becomes the WDM function driver of the usb4-host devnode
; (stand-in for a CM driver) and drives CONFIGMG (ReenumMode 2).
[HKEY_LOCAL_MACHINE\Enum\PCI\VEN_1B36&DEV_00F4&SUBSYS_11001AF4&REV_01\BUS_00&DEV_04&FUNC_00]
"Class"="System"
"ClassGUID"="{4d36e97d-e325-11ce-bfc1-08002be10318}"
"Driver"="System\\0099"
"Mfg"="usb4-emu experiment"
"DeviceDesc"="USB4 host (reenum experiment)"
"ConfigFlags"=hex:00,00,00,00
"ReenumMode"=dword:00000002
"BridgeBus"=dword:00000000
"BridgeDev"=dword:00000005

[HKEY_LOCAL_MACHINE\System\CurrentControlSet\Services\Class\System\0099]
"DevLoader"="*ntkern"
"NTMPDriver"="reenum.sys"
"DriverDesc"="USB4 host (reenum experiment)"
